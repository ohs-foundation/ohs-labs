+package com.example.ancapp
+
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import java.net.HttpURLConnection
+import java.net.URL
+import java.time.LocalDate
+import java.time.Period
+import java.time.temporal.ChronoUnit
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonElement
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.buildJsonArray
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.contentOrNull
+import kotlinx.serialization.json.doubleOrNull
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.put
+import kotlinx.serialization.json.putJsonArray
+import kotlinx.serialization.json.putJsonObject
+
+// 10.0.2.2 is the Android emulator's alias for the host machine's localhost.
+private const val BASE = "http://10.0.2.2:8080/fhir"
+private const val LOINC = "http://loinc.org"
+private const val UCUM = "http://unitsofmeasure.org"
+private const val ANC_SYSTEM = "urn:example:anc"
+private const val PREGNANCY_DAYS = 280L
+
+private const val CODE_DUE_DATE = "11778-8"
+private const val CODE_WEIGHT = "29463-7"
+private const val CODE_BP_PANEL = "85354-9"
+private const val CODE_SYSTOLIC = "8480-6"
+private const val CODE_DIASTOLIC = "8462-4"
+private const val CODE_HB = "718-7"
+private const val CODE_GA = "18185-9"
+private const val CODE_DANGER = "danger-sign"
+private const val CODE_NOTES = "notes"
+
+data class PregnantPatient(
+  val id: String,
+  val name: String,
+  val age: Int?,
+  val dueDate: LocalDate,
+  val weeks: Int,
+)
+
+data class Visit(
+  val date: LocalDate,
+  val weeks: Int?,
+  val weight: Double?,
+  val systolic: Int?,
+  val diastolic: Int?,
+  val hb: Double?,
+  val dangerSigns: List<String>,
+  val notes: String?,
+)
+
+suspend fun fetchPregnantPatients(today: LocalDate = LocalDate.now()): List<PregnantPatient> {
+  val dueByPatient = search("$BASE/Observation?code=$CODE_DUE_DATE&_count=500").associate {
+    it.obj("subject")!!.str("reference")!!.substringAfter('/') to LocalDate.parse(it.str("valueDateTime")!!)
+  }
+  // ponytail: single page (_count=500); follow Bundle.link "next" if the register outgrows it.
+  return search("$BASE/Patient?_count=500")
+    .mapNotNull { p ->
+      val id = p.str("id")!!
+      val due = dueByPatient[id] ?: return@mapNotNull null
+      val weeks = weeksAt(due, today)
+      if (weeks !in 0..42) return@mapNotNull null
+      val age = p.str("birthDate")?.let { Period.between(LocalDate.parse(it), today).years }
+      PregnantPatient(id, humanName(p), age, due, weeks)
+    }
+    .sortedBy { it.dueDate }
+}
+
+suspend fun fetchVisits(patientId: String): List<Visit> {
+  val encounters = search("$BASE/Encounter?subject=Patient/$patientId&_count=500")
+  val observations = search("$BASE/Observation?subject=Patient/$patientId&_count=500")
+  val byEncounter = observations.groupBy { it.obj("encounter")?.str("reference") }
+  return encounters.map { enc ->
+    val obs = byEncounter["Encounter/${enc.str("id")}"].orEmpty()
+    val bp = obs.firstOrNull { it.hasCode(CODE_BP_PANEL) }
+    val components = bp?.arr("component")?.map { it.jsonObject }.orEmpty()
+    Visit(
+      date = LocalDate.parse(enc.obj("period")!!.str("start")!!.take(10)),
+      weeks = obs.valueOf(CODE_GA)?.toInt(),
+      weight = obs.valueOf(CODE_WEIGHT),
+      systolic = components.valueOf(CODE_SYSTOLIC)?.toInt(),
+      diastolic = components.valueOf(CODE_DIASTOLIC)?.toInt(),
+      hb = obs.valueOf(CODE_HB),
+      dangerSigns = obs.filter { it.hasCode(CODE_DANGER) }.mapNotNull {
+        it.obj("valueCodeableConcept")?.arr("coding")?.firstOrNull()?.jsonObject?.str("display")
+      },
+      notes = obs.firstOrNull { it.hasCode(CODE_NOTES) }?.str("valueString"),
+    )
+  }.sortedByDescending { it.date }
+}
+
+suspend fun fetchQuestionnaire(): String = http("$BASE/Questionnaire/anc-contact")
+
+// Posts the visit as one transaction Bundle: the Encounter and its Observations succeed or fail together.
+suspend fun saveVisit(patientId: String, response: QuestionnaireResponse) {
+  val json = Json.encodeToJsonElement(QuestionnaireResponse.serializer(), response)
+  val answers = answersByLinkId(json.jsonObject["item"] as? JsonArray ?: JsonArray(emptyList()))
+  fun one(linkId: String) = answers[linkId]?.firstOrNull()
+  val date = checkNotNull(one("visit-date")?.str("valueDate")) { "Visit date is required" }
+  val patient = "Patient/$patientId"
+  val encRef = "urn:uuid:visit-encounter"
+
+  val encounter = buildJsonObject {
+    put("resourceType", "Encounter")
+    put("status", "finished")
+    putJsonObject("class") {
+      put("system", "http://terminology.hl7.org/CodeSystem/v3-ActCode")
+      put("code", "AMB")
+    }
+    putJsonObject("subject") { put("reference", patient) }
+    putJsonObject("period") {
+      put("start", date)
+      put("end", date)
+    }
+  }
+
+  val observations = buildList<JsonObject> {
+    one("gestational-age")?.str("valueInteger")?.let {
+      add(observation(coding(LOINC, CODE_GA, "Gestational age"), date, patient, encRef, "valueQuantity" to quantity(it.toDouble(), "wk")))
+    }
+    one("weight")?.str("valueDecimal")?.let {
+      add(observation(coding(LOINC, CODE_WEIGHT, "Body weight"), date, patient, encRef, "valueQuantity" to quantity(it.toDouble(), "kg")))
+    }
+    val systolic = one("bp-systolic")?.str("valueInteger")
+    val diastolic = one("bp-diastolic")?.str("valueInteger")
+    if (systolic != null && diastolic != null) {
+      val components = buildJsonArray {
+        add(component(CODE_SYSTOLIC, "Systolic blood pressure", systolic))
+        add(component(CODE_DIASTOLIC, "Diastolic blood pressure", diastolic))
+      }
+      add(observation(coding(LOINC, CODE_BP_PANEL, "Blood pressure"), date, patient, encRef, components = components))
+    }
+    answers["danger-signs"].orEmpty().mapNotNull { it.obj("valueCoding") }.forEach { sign ->
+      add(observation(coding(ANC_SYSTEM, CODE_DANGER, "Danger sign"), date, patient, encRef,
+        "valueCodeableConcept" to buildJsonObject { putJsonArray("coding") { add(sign) } }))
+    }
+    one("notes")?.str("valueString")?.takeIf { it.isNotBlank() }?.let {
+      add(observation(coding(ANC_SYSTEM, CODE_NOTES, "Visit notes"), date, patient, encRef, "valueString" to JsonPrimitive(it)))
+    }
+  }
+
+  val bundle = buildJsonObject {
+    put("resourceType", "Bundle")
+    put("type", "transaction")
+    putJsonArray("entry") {
+      add(buildJsonObject {
+        put("fullUrl", encRef)
+        put("resource", encounter)
+        putJsonObject("request") {
+          put("method", "POST")
+          put("url", "Encounter")
+        }
+      })
+      observations.forEach { obs ->
+        add(buildJsonObject {
+          put("resource", obs)
+          putJsonObject("request") {
+            put("method", "POST")
+            put("url", "Observation")
+          }
+        })
+      }
+    }
+  }
+  http(BASE, method = "POST", body = bundle.toString())
+}
+
+private fun weeksAt(due: LocalDate, today: LocalDate): Int {
+  val days = ChronoUnit.DAYS.between(due.minusDays(PREGNANCY_DAYS), today)
+  return Math.floorDiv(days, 7L).toInt()
+}
+
+private fun humanName(patient: JsonObject): String {
+  val name = patient.arr("name")?.firstOrNull()?.jsonObject ?: return ""
+  val given = name.arr("given")?.firstOrNull().str()
+  return listOfNotNull(given, name.str("family")).joinToString(" ")
+}
+
+private fun answersByLinkId(items: JsonArray): Map<String, List<JsonObject>> {
+  val out = mutableMapOf<String, List<JsonObject>>()
+  fun walk(list: JsonArray) {
+    list.forEach { el ->
+      val item = el.jsonObject
+      out[item.str("linkId")!!] = item.arr("answer")?.map { it.jsonObject }.orEmpty()
+      item.arr("item")?.let { walk(it) }
+    }
+  }
+  walk(items)
+  return out
+}
+
+private fun coding(system: String, code: String, display: String) = buildJsonObject {
+  put("system", system)
+  put("code", code)
+  put("display", display)
+}
+
+private fun quantity(value: Double, unit: String) = buildJsonObject {
+  put("value", value)
+  put("unit", unit)
+  put("system", UCUM)
+  put("code", unit)
+}
+
+private fun component(code: String, display: String, value: String) = buildJsonObject {
+  putJsonObject("code") { putJsonArray("coding") { add(coding(LOINC, code, display)) } }
+  put("valueQuantity", quantity(value.toDouble(), "mm[Hg]"))
+}
+
+private fun observation(
+  code: JsonObject,
+  date: String,
+  patient: String,
+  encRef: String,
+  value: Pair<String, JsonElement>? = null,
+  components: JsonElement? = null,
+) = buildJsonObject {
+  put("resourceType", "Observation")
+  put("status", "final")
+  putJsonObject("code") { putJsonArray("coding") { add(code) } }
+  putJsonObject("subject") { put("reference", patient) }
+  putJsonObject("encounter") { put("reference", encRef) }
+  put("effectiveDateTime", date)
+  value?.let { put(it.first, it.second) }
+  components?.let { put("component", it) }
+}
+
+private fun JsonObject.hasCode(code: String) =
+  obj("code")?.arr("coding")?.any { it.jsonObject.str("code") == code } == true
+
+private fun List<JsonObject>.valueOf(code: String): Double? =
+  firstOrNull { it.hasCode(code) }?.obj("valueQuantity")?.get("value")?.jsonPrimitive?.doubleOrNull
+
+private fun JsonElement?.str(): String? = (this as? JsonPrimitive)?.contentOrNull
+private fun JsonObject.str(key: String): String? = this[key].str()
+private fun JsonObject.obj(key: String): JsonObject? = this[key] as? JsonObject
+private fun JsonObject.arr(key: String): JsonArray? = this[key] as? JsonArray
+
+private suspend fun search(url: String): List<JsonObject> {
+  val bundle = Json.parseToJsonElement(http(url)).jsonObject
+  return bundle.arr("entry")?.mapNotNull { it.jsonObject.obj("resource") }.orEmpty()
+}
+
+private suspend fun http(url: String, method: String = "GET", body: String? = null): String =
+  withContext(Dispatchers.IO) {
+    val conn = URL(url).openConnection() as HttpURLConnection
+    try {
+      conn.requestMethod = method
+      conn.setRequestProperty("Accept", "application/fhir+json")
+      if (body != null) {
+        conn.doOutput = true
+        conn.setRequestProperty("Content-Type", "application/fhir+json")
+        conn.outputStream.use { it.write(body.toByteArray()) }
+      }
+      val code = conn.responseCode
+      val text = (if (code < 400) conn.inputStream else conn.errorStream)
+        ?.bufferedReader()?.use { it.readText() }.orEmpty()
+      check(code < 400) { "HTTP $code from $url: ${text.take(200)}" }
+      text
+    } finally {
+      conn.disconnect()
+    }
+  }
