+package com.example.ancapp.ui
+
+import android.app.Application
+import androidx.lifecycle.AndroidViewModel
+import androidx.lifecycle.viewModelScope
+import com.example.ancapp.data.AncRepository
+import com.example.ancapp.model.AncVisit
+import com.example.ancapp.model.Patient
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.SharingStarted
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.combine
+import kotlinx.coroutines.flow.stateIn
+import java.util.UUID
+
+sealed interface Screen {
+    object Register : Screen
+    data class PatientDetail(val patientId: String) : Screen
+    data class RecordVisit(val patientId: String) : Screen
+}
+
+class AncViewModel(application: Application) : AndroidViewModel(application) {
+
+    private val repository = AncRepository(application.applicationContext)
+
+    private val _currentScreen = MutableStateFlow<Screen>(Screen.Register)
+    val currentScreen: StateFlow<Screen> = _currentScreen.asStateFlow()
+
+    // Sorted by due date (soonest first)
+    val patients: StateFlow<List<Patient>> = repository.patients
+        .combine(MutableStateFlow(Unit)) { patients, _ ->
+            patients.sortedWith { p1, p2 ->
+                p1.estimatedDueDate.compareTo(p2.estimatedDueDate)
+            }
+        }.stateIn(
+            scope = viewModelScope,
+            started = SharingStarted.WhileSubscribed(5000),
+            initialValue = repository.getPatientsSortedByDueDate()
+        )
+
+    val visits: StateFlow<List<AncVisit>> = repository.visits
+
+    fun navigateToRegister() {
+        _currentScreen.value = Screen.Register
+    }
+
+    fun navigateToPatientDetail(patientId: String) {
+        _currentScreen.value = Screen.PatientDetail(patientId)
+    }
+
+    fun navigateToRecordVisit(patientId: String) {
+        _currentScreen.value = Screen.RecordVisit(patientId)
+    }
+
+    fun getPatient(patientId: String): Patient? {
+        return repository.getPatientById(patientId)
+    }
+
+    fun getVisitsForPatient(patientId: String): List<AncVisit> {
+        return repository.getVisitsForPatient(patientId)
+    }
+
+    fun recordVisit(
+        patientId: String,
+        date: String,
+        gestationalAgeWeeks: Int,
+        weightKg: Double,
+        systolicBp: Int,
+        diastolicBp: Int,
+        hemoglobin: Double?,
+        dangerSigns: List<String>,
+        notes: String
+    ): AncVisit {
+        val newVisit = AncVisit(
+            id = "visit-${UUID.randomUUID()}",
+            patientId = patientId,
+            date = date,
+            gestationalAgeWeeks = gestationalAgeWeeks,
+            weightKg = weightKg,
+            systolicBp = systolicBp,
+            diastolicBp = diastolicBp,
+            hemoglobin = hemoglobin,
+            dangerSigns = dangerSigns,
+            notes = notes
+        )
+        repository.addVisit(newVisit)
+        return newVisit
+    }
+
+    fun addPatient(name: String, dateOfBirth: String, estimatedDueDate: String): Patient {
+        val newPatient = Patient(
+            id = "patient-${UUID.randomUUID()}",
+            name = name,
+            dateOfBirth = dateOfBirth,
+            estimatedDueDate = estimatedDueDate
+        )
+        repository.addPatient(newPatient)
+        return newPatient
+    }
+}
