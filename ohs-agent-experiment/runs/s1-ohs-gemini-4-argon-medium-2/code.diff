+            }
+          },
+          modifier = Modifier.weight(1f).testTag(linkId),
+        )
+        Spacer(modifier = Modifier.width(8.dp))
+        AssistChip(
+          onClick = {
+            focusManager.clearFocus()
+            applyDateInput(LocalDate.now().toString())
+          },
+          label = { Text("Today") },
+        )
+      }
+    }
+
+    if (showDatePicker) {
+      val initialMillis =
+        remember(textValue) {
+          val parsed = parseFlexibleDateToIso(textValue.trim())
