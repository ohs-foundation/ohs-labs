+import com.example.ancapp.model.PatientWithVisits
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun RegisterScreen(
+  patients: List<PatientWithVisits>,
+  onPatientClick: (Long) -> Unit,
+) {
+  Scaffold(
+    topBar = {
+      TopAppBar(
+        title = {
+          Column {
+            Text(
+              text = "ANC Clinic Register",
+              style = MaterialTheme.typography.titleLarge,
+              fontWeight = FontWeight.Bold,
+            )
+            Text(
+              text = "Currently pregnant patients • Sorted by due date (soonest first)",
+              style = MaterialTheme.typography.labelMedium,
+              color = MaterialTheme.colorScheme.onPrimary.copy(alpha = 0.85f),
+            )
+          }
+        },
+        colors =
+          TopAppBarDefaults.topAppBarColors(
+            containerColor = MaterialTheme.colorScheme.primary,
+            titleContentColor = MaterialTheme.colorScheme.onPrimary,
+          ),
+      )
+    },
+    containerColor = MaterialTheme.colorScheme.background,
+  ) { innerPadding ->
+    LazyColumn(
+      modifier =
+        Modifier.fillMaxSize()
+          .padding(innerPadding)
+          .testTag("register_patient_list"),
+      contentPadding = PaddingValues(horizontal = 16.dp, vertical = 14.dp),
+      verticalArrangement = Arrangement.spacedBy(12.dp),
+    ) {
+      item {
+        SummaryBanner(
+          patientCount = patients.size,
+          totalVisits = patients.sumOf { it.visits.size },
+        )
+      }
+
+      itemsIndexed(
+        items = patients,
+        key = { _, item -> item.patient.id },
+      ) { index, patientWithVisits ->
+        PatientRegisterCard(
+          rank = index + 1,
+          patientWithVisits = patientWithVisits,
+          onClick = { onPatientClick(patientWithVisits.patient.id) },
+        )
+      }
+    }
+  }
+}
+
+@Composable
+private fun SummaryBanner(patientCount: Int, totalVisits: Int) {
+  Surface(
+    shape = RoundedCornerShape(14.dp),
+    color = MaterialTheme.colorScheme.primaryContainer.copy(alpha = 0.7f),
+    modifier = Modifier.fillMaxWidth(),
+  ) {
+    Row(
+      modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 12.dp),
+      horizontalArrangement = Arrangement.SpaceBetween,
+      verticalAlignment = Alignment.CenterVertically,
+    ) {
+      Row(verticalAlignment = Alignment.CenterVertically) {
+        Icon(
+          imageVector = Icons.Default.PregnantWoman,
+          contentDescription = null,
+          tint = MaterialTheme.colorScheme.primary,
+          modifier = Modifier.size(24.dp),
+        )
+        Spacer(modifier = Modifier.width(10.dp))
+        Column {
+          Text(
+            text = "$patientCount Active Pregnant Patients",
+            style = MaterialTheme.typography.titleSmall,
+            fontWeight = FontWeight.SemiBold,
+            color = MaterialTheme.colorScheme.onPrimaryContainer,
+          )
+          Text(
+            text = "Tap a patient to view past ANC visits or record a new visit",
+            style = MaterialTheme.typography.bodySmall,
+            color = MaterialTheme.colorScheme.onPrimaryContainer.copy(alpha = 0.8f),
+          )
+        }
+      }
+      Surface(
+        shape = RoundedCornerShape(20.dp),
+        color = MaterialTheme.colorScheme.primary,
+      ) {
+        Text(
+          text = "$totalVisits visits",
+          style = MaterialTheme.typography.labelMedium,
+          color = MaterialTheme.colorScheme.onPrimary,
+          modifier = Modifier.padding(horizontal = 10.dp, vertical = 4.dp),
+        )
+      }
+    }
+  }
+}
+
+@Composable
+private fun PatientRegisterCard(
+  rank: Int,
+  patientWithVisits: PatientWithVisits,
+  onClick: () -> Unit,
+) {
+  val patient = patientWithVisits.patient
+  val ageYears = patient.ageInYears()
+  val currentWeeks = patientWithVisits.currentWeeksOfPregnancy()
+  val latestVisit = patientWithVisits.latestVisit
+
+  Card(
+    modifier =
+      Modifier.fillMaxWidth()
+        .clickable(onClick = onClick)
+        .testTag("patient_card_${patient.id}"),
+    shape = RoundedCornerShape(16.dp),
+    colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),
+    elevation = CardDefaults.cardElevation(defaultElevation = 2.dp),
+  ) {
+    Column(modifier = Modifier.fillMaxWidth().padding(16.dp)) {
+      Row(
+        modifier = Modifier.fillMaxWidth(),
+        horizontalArrangement = Arrangement.SpaceBetween,
+        verticalAlignment = Alignment.CenterVertically,
+      ) {
+        Row(
+          verticalAlignment = Alignment.CenterVertically,
+          modifier = Modifier.weight(1f),
+        ) {
+          Box(
+            modifier =
+              Modifier.size(40.dp)
+                .clip(CircleShape)
+                .background(MaterialTheme.colorScheme.primaryContainer),
+            contentAlignment = Alignment.Center,
+          ) {
+            Text(
+              text = "#$rank",
+              style = MaterialTheme.typography.labelLarge,
+              fontWeight = FontWeight.Bold,
+              color = MaterialTheme.colorScheme.primary,
+            )
+          }
+          Spacer(modifier = Modifier.width(12.dp))
+          Column {
+            Text(
+              text = patient.name,
+              style = MaterialTheme.typography.titleMedium,
+              fontWeight = FontWeight.Bold,
+              color = MaterialTheme.colorScheme.onSurface,
+            )
+            Row(verticalAlignment = Alignment.CenterVertically) {
+              Icon(
+                imageVector = Icons.Default.Person,
+                contentDescription = null,
+                modifier = Modifier.size(14.dp),
+                tint = MaterialTheme.colorScheme.onSurfaceVariant,
+              )
+              Spacer(modifier = Modifier.width(4.dp))
+              Text(
+                text = "Age $ageYears yrs (DOB: ${patient.dateOfBirth})",
+                style = MaterialTheme.typography.bodySmall,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+              )
+            }
+          }
+        }
+
+        // Current weeks of pregnancy badge
+        Surface(
+          shape = RoundedCornerShape(12.dp),
+          color = MaterialTheme.colorScheme.secondaryContainer,
+        ) {
+          Column(
+            horizontalAlignment = Alignment.CenterHorizontally,
+            modifier = Modifier.padding(horizontal = 12.dp, vertical = 6.dp),
+          ) {
+            Text(
+              text = "$currentWeeks weeks",
+              style = MaterialTheme.typography.titleSmall,
+              fontWeight = FontWeight.Bold,
+              color = MaterialTheme.colorScheme.onSecondaryContainer,
+            )
+            Text(
+              text = "Gestation",
+              style = MaterialTheme.typography.labelSmall,
+              color = MaterialTheme.colorScheme.onSecondaryContainer.copy(alpha = 0.8f),
+            )
+          }
+        }
+
+        Spacer(modifier = Modifier.width(4.dp))
+        Icon(
+          imageVector = Icons.AutoMirrored.Filled.KeyboardArrowRight,
+          contentDescription = "Open patient details",
+          tint = MaterialTheme.colorScheme.onSurfaceVariant,
+        )
+      }
+
+      Spacer(modifier = Modifier.height(12.dp))
+      HorizontalDivider(color = MaterialTheme.colorScheme.surfaceVariant)
+      Spacer(modifier = Modifier.height(10.dp))
+
+      Row(
+        modifier = Modifier.fillMaxWidth(),
+        horizontalArrangement = Arrangement.SpaceBetween,
+        verticalAlignment = Alignment.CenterVertically,
+      ) {
+        Row(verticalAlignment = Alignment.CenterVertically) {
+          Icon(
+            imageVector = Icons.Default.CalendarMonth,
+            contentDescription = null,
+            modifier = Modifier.size(16.dp),
+            tint = MaterialTheme.colorScheme.primary,
+          )
+          Spacer(modifier = Modifier.width(6.dp))
+          Text(
+            text = "Est. Due Date: ",
+            style = MaterialTheme.typography.bodySmall,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+          )
+          Text(
+            text = patient.estimatedDueDate,
+            style = MaterialTheme.typography.bodyMedium,
+            fontWeight = FontWeight.SemiBold,
+            color = MaterialTheme.colorScheme.primary,
+          )
+        }
+
+        if (latestVisit != null) {
+          Row(verticalAlignment = Alignment.CenterVertically) {
+            Icon(
+              imageVector = Icons.Default.FavoriteBorder,
+              contentDescription = null,
+              modifier = Modifier.size(15.dp),
+              tint = Color(0xFF64748B),
+            )
+            Spacer(modifier = Modifier.width(4.dp))
+            Text(
+              text = "Last visit: ${latestVisit.visitDate}",
+              style = MaterialTheme.typography.labelMedium,
+              color = Color(0xFF475569),
+            )
+          }
+        }
+      }
+    }
+  }
+}
