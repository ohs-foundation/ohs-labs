@@ -0,0 +1,236 @@
+package com.example.ancapp
+
+import androidx.activity.compose.BackHandler
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.PaddingValues
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.lazy.LazyColumn
+import androidx.compose.foundation.lazy.items
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.text.KeyboardOptions
+import androidx.compose.foundation.verticalScroll
+import androidx.compose.material3.Button
+import androidx.compose.material3.Card
+import androidx.compose.material3.Checkbox
+import androidx.compose.material3.CircularProgressIndicator
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.OutlinedTextField
+import androidx.compose.material3.Scaffold
+import androidx.compose.material3.Text
+import androidx.compose.material3.TextButton
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateMapOf
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.produceState
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.text.input.KeyboardType
+import androidx.compose.ui.unit.dp
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import org.json.JSONArray
+import org.json.JSONObject
+import java.time.LocalDate
+
+sealed interface Screen {
+  data object Register : Screen
+  data class Detail(val patient: PatientRow) : Screen
+  data class NewVisit(val patient: PatientRow) : Screen
+}
+
+@Composable
+fun AncApp() {
+  var screen by remember { mutableStateOf<Screen>(Screen.Register) }
+  when (val s = screen) {
+    Screen.Register -> RegisterScreen(onOpen = { screen = Screen.Detail(it) })
+    is Screen.Detail -> PatientScreen(
+      patient = s.patient,
+      onBack = { screen = Screen.Register },
+      onRecordVisit = { screen = Screen.NewVisit(s.patient) },
+    )
+    is Screen.NewVisit -> VisitFormScreen(
+      patient = s.patient,
+      onDone = { screen = Screen.Detail(s.patient) },
+    )
+  }
+}
+
+@Composable
+fun RegisterScreen(onOpen: (PatientRow) -> Unit) {
+  val result by produceState<Result<List<PatientRow>>?>(null) {
+    value = runCatching { withContext(Dispatchers.IO) { fetchRegister() } }
+  }
+  Scaffold { padding ->
+    LazyColumn(
+      Modifier.padding(padding),
+      contentPadding = PaddingValues(16.dp),
+      verticalArrangement = Arrangement.spacedBy(8.dp),
+    ) {
+      item { Text("Pregnant patients", style = MaterialTheme.typography.headlineSmall) }
+      val r = result
+      when {
+        r == null -> item { CircularProgressIndicator() }
+        r.isFailure -> item { Text("Could not load patients: ${r.exceptionOrNull()?.message}") }
+        else -> items(r.getOrThrow()) { p ->
+          Card(onClick = { onOpen(p) }, modifier = Modifier.fillMaxWidth()) {
+            Column(Modifier.padding(16.dp)) {
+              Text(p.name, style = MaterialTheme.typography.titleMedium)
+              Text("Age ${p.age() ?: "-"} · Due ${p.dueDate} · ${gestationalAge(p.dueDate)}")
+            }
+          }
+        }
+      }
+    }
+  }
+}
+
+@Composable
+fun PatientScreen(patient: PatientRow, onBack: () -> Unit, onRecordVisit: () -> Unit) {
+  BackHandler(onBack = onBack)
+  val result by produceState<Result<List<Visit>>?>(null) {
+    value = runCatching { withContext(Dispatchers.IO) { fetchVisits(patient.id) } }
+  }
+  Scaffold { padding ->
+    LazyColumn(
+      Modifier.padding(padding),
+      contentPadding = PaddingValues(16.dp),
+      verticalArrangement = Arrangement.spacedBy(8.dp),
+    ) {
+      item { TextButton(onClick = onBack) { Text("Back") } }
+      item {
+        Column {
+          Text(patient.name, style = MaterialTheme.typography.headlineSmall)
+          Text("Age ${patient.age() ?: "-"} · Due ${patient.dueDate} · ${gestationalAge(patient.dueDate)}")
+        }
+      }
+      item { Button(onClick = onRecordVisit, modifier = Modifier.fillMaxWidth()) { Text("Record ANC visit") } }
+      item { Text("Past visits", style = MaterialTheme.typography.titleMedium) }
+      val r = result
+      when {
+        r == null -> item { CircularProgressIndicator() }
+        r.isFailure -> item { Text("Could not load visits: ${r.exceptionOrNull()?.message}") }
+        r.getOrThrow().isEmpty() -> item { Text("No visits yet") }
+        else -> items(r.getOrThrow()) { visit ->
+          Card(modifier = Modifier.fillMaxWidth()) {
+            Column(Modifier.padding(16.dp)) {
+              Text(visit.date.toString(), style = MaterialTheme.typography.titleSmall)
+              Text("Weight: ${visit.weightKg?.let { "$it kg" } ?: "-"}")
+              Text("BP: ${visit.systolic?.let { s -> visit.diastolic?.let { d -> "$s/$d mmHg" } } ?: "-"}")
+              Text("Hb: ${visit.hb?.let { "$it g/dL" } ?: "-"}")
+            }
+          }
+        }
+      }
+    }
+  }
+}
+
+@Composable
+fun VisitFormScreen(patient: PatientRow, onDone: () -> Unit) {
+  BackHandler(onBack = onDone)
+  val questionnaire by produceState<Result<JSONObject>?>(null) {
+    value = runCatching { withContext(Dispatchers.IO) { fetchQuestionnaire() } }
+  }
+  val answers = remember { mutableStateMapOf("visit-date" to LocalDate.now().toString()) }
+  var attempted by remember { mutableStateOf(false) }
+  var saving by remember { mutableStateOf(false) }
+  var saveError by remember { mutableStateOf<String?>(null) }
+  val scope = rememberCoroutineScope()
+
+  Scaffold { padding ->
+    Column(
+      Modifier.padding(padding).padding(16.dp).verticalScroll(rememberScrollState()),
+      verticalArrangement = Arrangement.spacedBy(12.dp),
+    ) {
+      TextButton(onClick = onDone) { Text("Cancel") }
+      Text("ANC visit: ${patient.name}", style = MaterialTheme.typography.headlineSmall)
+      val q = questionnaire
+      when {
+        q == null -> CircularProgressIndicator()
+        q.isFailure -> Text("Could not load form: ${q.exceptionOrNull()?.message}")
+        else -> {
+          val form = q.getOrThrow()
+          val items = form.getJSONArray("item")
+          QuestionnaireItems(items, answers)
+          val problems = problems(items, answers)
+          if (attempted) problems.forEach { Text(it, color = MaterialTheme.colorScheme.error) }
+          saveError?.let { Text(it, color = MaterialTheme.colorScheme.error) }
+          Button(
+            enabled = !saving,
+            onClick = {
+              attempted = true
+              if (problems.isEmpty()) {
+                saving = true
+                val snapshot = answers.toMap()
+                scope.launch {
+                  runCatching { withContext(Dispatchers.IO) { saveVisit(patient.id, form, snapshot) } }
+                    .onSuccess { onDone() }
+                    .onFailure {
+                      saveError = it.message ?: "Save failed"
+                      saving = false
+                    }
+                }
+              }
+            },
+          ) { Text(if (saving) "Saving…" else "Save visit") }
+        }
+      }
+    }
+  }
+}
+
+// Renders the Questionnaire items generically: groups, dates, numbers, text, and multi-select choices
+@Composable
+private fun QuestionnaireItems(items: JSONArray, answers: MutableMap<String, String>) {
+  for (i in 0 until items.length()) {
+    val item = items.getJSONObject(i)
+    val id = item.getString("linkId")
+    val type = item.getString("type")
+    val label = item.getString("text") + if (item.optBoolean("required")) " *" else ""
+    when (type) {
+      "group" -> {
+        Text(label, style = MaterialTheme.typography.titleSmall)
+        QuestionnaireItems(item.getJSONArray("item"), answers)
+      }
+      "choice" -> {
+        Text(label)
+        val picked = answers[id].orEmpty().split(",").filter { it.isNotBlank() }
+        val options = item.getJSONArray("answerOption")
+        for (j in 0 until options.length()) {
+          val coding = options.getJSONObject(j).getJSONObject("valueCoding")
+          val code = coding.getString("code")
+          Row(verticalAlignment = Alignment.CenterVertically) {
+            Checkbox(
+              checked = code in picked,
+              onCheckedChange = { on -> answers[id] = (if (on) picked + code else picked - code).joinToString(",") },
+            )
+            Text(coding.getString("display"))
+          }
+        }
+      }
+      else -> OutlinedTextField(
+        value = answers[id].orEmpty(),
+        onValueChange = { answers[id] = it },
+        label = { Text(label) },
+        supportingText = if (type == "date") ({ Text("Format: yyyy-mm-dd") }) else null,
+        keyboardOptions = KeyboardOptions(
+          keyboardType = when (type) {
+            "integer" -> KeyboardType.Number
+            "decimal" -> KeyboardType.Decimal
+            else -> KeyboardType.Text
+          },
+        ),
+        minLines = if (type == "text") 3 else 1,
+        modifier = Modifier.fillMaxWidth(),
+      )
+    }
+  }
+}
diff --git a/app/src/main/java/com/example/ancapp/Fhir.kt b/app/src/main/java/com/example/ancapp/Fhir.kt
new file mode 100644
index 0000000..0f18cbe
--- /dev/null
+++ b/app/src/main/java/com/example/ancapp/Fhir.kt
@@ -0,0 +1,246 @@
+package com.example.ancapp
+
+import org.json.JSONArray
+import org.json.JSONObject
+import java.net.HttpURLConnection
+import java.net.URL
+import java.time.LocalDate
+import java.time.OffsetDateTime
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+
+// 10.0.2.2 is the Android emulator's alias for the host machine
+private const val FHIR_BASE = "http://10.0.2.2:8080/fhir"
+private const val ANC_QUESTIONNAIRE = "anc-contact"
+private const val LOINC_DUE = "11778-8"
+private const val LOINC_WEIGHT = "29463-7"
+private const val LOINC_BP = "85354-9"
+private const val LOINC_SYSTOLIC = "8480-6"
+private const val LOINC_DIASTOLIC = "8462-4"
+private const val LOINC_HB = "718-7"
+
+data class PatientRow(val id: String, val name: String, val birthDate: LocalDate?, val dueDate: LocalDate)
+
+data class Visit(val date: LocalDate, val weightKg: Double?, val systolic: Int?, val diastolic: Int?, val hb: Double?)
+
+fun PatientRow.age(): Int? = birthDate?.let { java.time.Period.between(it, LocalDate.now()).years }
+
+// Naegele's rule: LMP = EDD - 280 days
+fun gestationalAge(due: LocalDate): String {
+  val days = ChronoUnit.DAYS.between(due.minusDays(280), LocalDate.now())
+  return "${days / 7}w ${days % 7}d"
+}
+
+fun fetchRegister(): List<PatientRow> {
+  // ponytail: no paging, add _getpages when the clinic has more than 200 patients
+  val patients = search("/Patient?_count=200").associateBy { it.getString("id") }
+  return search("/Observation?code=$LOINC_DUE&_count=200")
+    .sortedByDescending { it.optString("effectiveDateTime") }
+    .distinctBy { refId(it.getJSONObject("subject")) }
+    .mapNotNull { due ->
+      val p = patients[refId(due.getJSONObject("subject"))] ?: return@mapNotNull null
+      PatientRow(
+        id = p.getString("id"),
+        name = displayName(p),
+        birthDate = p.optString("birthDate").takeIf { it.isNotEmpty() }?.let { LocalDate.parse(it) },
+        dueDate = LocalDate.parse(due.getString("valueDateTime").take(10)),
+      )
+    }
+    .sortedBy { it.dueDate }
+}
+
+fun fetchVisits(patientId: String): List<Visit> {
+  // Bare id: HAPI's "Patient/<id>" subject search misses resources written via transaction
+  val observations = search("/Observation?patient=$patientId&_count=200")
+    .groupBy { it.optJSONObject("encounter")?.optString("reference") }
+  return search("/Encounter?patient=$patientId&_count=200").map { enc ->
+    val mine = observations["Encounter/${enc.getString("id")}"].orEmpty()
+    fun find(loinc: String) = mine.firstOrNull { codeOf(it) == loinc }
+    val bp = find(LOINC_BP)
+    Visit(
+      date = LocalDate.parse(enc.getJSONObject("period").getString("start").take(10)),
+      weightKg = find(LOINC_WEIGHT)?.let { quantity(it) },
+      systolic = bp?.let { component(it, LOINC_SYSTOLIC) },
+      diastolic = bp?.let { component(it, LOINC_DIASTOLIC) },
+      hb = find(LOINC_HB)?.let { quantity(it) },
+    )
+  }.sortedByDescending { it.date }
+}
+
+fun fetchQuestionnaire(): JSONObject = fhir("GET", "/Questionnaire/$ANC_QUESTIONNAIRE")
+
+// Form problems shown to the nurse; empty list means the answers can be saved
+fun problems(items: JSONArray, answers: Map<String, String>): List<String> = leaves(items).mapNotNull { item ->
+  val id = item.getString("linkId")
+  val label = item.getString("text")
+  val raw = answers[id].orEmpty().trim()
+  when {
+    raw.isEmpty() -> if (item.optBoolean("required")) "$label is required" else null
+    item.getString("type") == "date" && runCatching { LocalDate.parse(raw) }.isFailure -> "$label must be a date (yyyy-mm-dd)"
+    item.getString("type") == "integer" && raw.toIntOrNull() == null -> "$label must be a whole number"
+    item.getString("type") == "decimal" && raw.toDoubleOrNull() == null -> "$label must be a number"
+    else -> null
+  }
+}
+
+// Writes the Encounter, vital-sign Observations and the QuestionnaireResponse in one transaction
+fun saveVisit(patientId: String, questionnaire: JSONObject, answers: Map<String, String>) {
+  val date = answers.getValue("visit-date")
+  val subject = JSONObject().put("reference", "Patient/$patientId")
+  val encounterUrl = newUrn()
+  val encounterRef = JSONObject().put("reference", encounterUrl)
+  val encounter = JSONObject()
+    .put("resourceType", "Encounter")
+    .put("status", "finished")
+    .put("class", coding("http://terminology.hl7.org/CodeSystem/v3-ActCode", "AMB", "ambulatory"))
+    .put("type", JSONArray().put(JSONObject().put("text", "Antenatal care contact")))
+    .put("subject", subject)
+    .put("period", JSONObject().put("start", date).put("end", date))
+  val entries = JSONArray().put(entry(encounterUrl, encounter))
+
+  val vitalsCategory = JSONArray().put(
+    JSONObject().put("coding", JSONArray().put(
+      coding("http://terminology.hl7.org/CodeSystem/observation-category", "vital-signs", "Vital Signs"),
+    )),
+  )
+  fun observation(loinc: String, display: String) = JSONObject()
+    .put("resourceType", "Observation")
+    .put("status", "final")
+    .put("category", vitalsCategory)
+    .put("code", JSONObject().put("coding", JSONArray().put(coding("http://loinc.org", loinc, display))))
+    .put("subject", subject)
+    .put("encounter", encounterRef)
+    .put("effectiveDateTime", date)
+
+  answers["weight"]?.toDoubleOrNull()?.let { kg ->
+    val obs = observation(LOINC_WEIGHT, "Body weight")
+      .put("valueQuantity", JSONObject().put("value", kg).put("unit", "kg").put("system", "http://unitsofmeasure.org").put("code", "kg"))
+    entries.put(entry(newUrn(), obs))
+  }
+
+  val systolic = answers["bp-systolic"]?.toIntOrNull()
+  val diastolic = answers["bp-diastolic"]?.toIntOrNull()
+  if (systolic != null || diastolic != null) {
+    val components = JSONArray()
+    fun addComponent(loinc: String, display: String, value: Int?) {
+      if (value == null) return
+      components.put(JSONObject()
+        .put("code", JSONObject().put("coding", JSONArray().put(coding("http://loinc.org", loinc, display))))
+        .put("valueQuantity", mmHg(value)))
+    }
+    addComponent(LOINC_SYSTOLIC, "Systolic blood pressure", systolic)
+    addComponent(LOINC_DIASTOLIC, "Diastolic blood pressure", diastolic)
+    val obs = observation(LOINC_BP, "Blood pressure").put("component", components)
+    entries.put(entry(newUrn(), obs))
+  }
+
+  val response = JSONObject()
+    .put("resourceType", "QuestionnaireResponse")
+    .put("questionnaire", questionnaire.getString("url"))
+    .put("status", "completed")
+    .put("subject", subject)
+    .put("encounter", encounterRef)
+    .put("authored", OffsetDateTime.now().toString())
+    .put("item", responseItems(questionnaire.getJSONArray("item"), answers))
+  entries.put(entry(newUrn(), response))
+
+  fhir("POST", "", JSONObject().put("resourceType", "Bundle").put("type", "transaction").put("entry", entries))
+}
+
+private fun search(path: String): List<JSONObject> {
+  val entries = fhir("GET", path).optJSONArray("entry") ?: return emptyList()
+  return (0 until entries.length()).map { entries.getJSONObject(it).getJSONObject("resource") }
+}
+
+private fun fhir(method: String, path: String, body: JSONObject? = null): JSONObject {
+  val conn = URL(FHIR_BASE + path).openConnection() as HttpURLConnection
+  try {
+    conn.requestMethod = method
+    conn.connectTimeout = 10_000
+    conn.readTimeout = 15_000
+    conn.setRequestProperty("Accept", "application/fhir+json")
+    if (body != null) {
+      conn.doOutput = true
+      conn.setRequestProperty("Content-Type", "application/fhir+json")
+      conn.outputStream.use { it.write(body.toString().toByteArray()) }
+    }
+    val code = conn.responseCode
+    val text = (if (code < 400) conn.inputStream else conn.errorStream).bufferedReader().use { it.readText() }
+    if (code >= 400) error("FHIR $method $path failed with HTTP $code: ${text.take(200)}")
+    return JSONObject(text)
+  } finally {
+    conn.disconnect()
+  }
+}
+
+private fun responseItems(items: JSONArray, answers: Map<String, String>): JSONArray {
+  val out = JSONArray()
+  for (i in 0 until items.length()) {
+    val item = items.getJSONObject(i)
+    val qr = JSONObject().put("linkId", item.getString("linkId"))
+    if (item.getString("type") == "group") {
+      qr.put("item", responseItems(item.getJSONArray("item"), answers))
+    } else {
+      val raw = answers[item.getString("linkId")].orEmpty().trim()
+      if (raw.isEmpty()) continue
+      qr.put("answer", JSONArray(answerValues(item, raw)))
+    }
+    out.put(qr)
+  }
+  return out
+}
+
+private fun answerValues(item: JSONObject, raw: String): List<JSONObject> = when (item.getString("type")) {
+  "date" -> listOf(JSONObject().put("valueDate", raw))
+  "integer" -> listOf(JSONObject().put("valueInteger", raw.toInt()))
+  "decimal" -> listOf(JSONObject().put("valueDecimal", raw.toDouble()))
+  "choice" -> raw.split(",").map { code -> JSONObject().put("valueCoding", option(item, code)) }
+  else -> listOf(JSONObject().put("valueString", raw))
+}
+
+private fun option(item: JSONObject, code: String): JSONObject {
+  val options = item.getJSONArray("answerOption")
+  return (0 until options.length())
+    .map { options.getJSONObject(it).getJSONObject("valueCoding") }
+    .first { it.getString("code") == code }
+}
+
+// Leaf questions only; groups are containers
+private fun leaves(items: JSONArray): List<JSONObject> = (0 until items.length()).flatMap { i ->
+  val item = items.getJSONObject(i)
+  if (item.getString("type") == "group") leaves(item.getJSONArray("item")) else listOf(item)
+}
+
+private fun entry(fullUrl: String, resource: JSONObject) = JSONObject()
+  .put("fullUrl", fullUrl)
+  .put("resource", resource)
+  .put("request", JSONObject().put("method", "POST").put("url", resource.getString("resourceType")))
+
+private fun newUrn() = "urn:uuid:${UUID.randomUUID()}"
+
+private fun refId(ref: JSONObject) = ref.getString("reference").substringAfter("/")
+
+private fun displayName(p: JSONObject): String {
+  val name = p.getJSONArray("name").getJSONObject(0)
+  return "${name.optJSONArray("given")?.optString(0).orEmpty()} ${name.optString("family")}".trim()
+}
+
+private fun codeOf(obs: JSONObject): String =
+  obs.getJSONObject("code").getJSONArray("coding").getJSONObject(0).getString("code")
+
+private fun quantity(obs: JSONObject): Double? =
+  obs.optJSONObject("valueQuantity")?.optDouble("value")?.takeUnless { it.isNaN() }
+
+private fun component(obs: JSONObject, loinc: String): Int? {
+  val components = obs.optJSONArray("component") ?: return null
+  return (0 until components.length())
+    .map { components.getJSONObject(it) }
+    .firstOrNull { codeOf(it) == loinc }
+    ?.let { quantity(it)?.toInt() }
+}
+
+private fun mmHg(value: Int) = JSONObject().put("value", value).put("unit", "mmHg")
+  .put("system", "http://unitsofmeasure.org").put("code", "mm[Hg]")
+
+private fun coding(system: String, code: String, display: String) = JSONObject()
+  .put("system", system).put("code", code).put("display", display)
