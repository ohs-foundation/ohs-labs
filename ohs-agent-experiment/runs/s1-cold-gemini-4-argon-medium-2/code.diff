+package com.example.ancapp.ui
+
+import android.app.Application
+import androidx.lifecycle.AndroidViewModel
+import com.example.ancapp.data.AncDatabaseHelper
+import com.example.ancapp.model.AncVisit
+import com.example.ancapp.model.DangerSign
+import com.example.ancapp.model.PatientWithVisits
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+class AncViewModel(application: Application) : AndroidViewModel(application) {
+  private val dbHelper = AncDatabaseHelper.getInstance(application)
+
+  private val _patients = MutableStateFlow<List<PatientWithVisits>>(emptyList())
+  val patients: StateFlow<List<PatientWithVisits>> = _patients.asStateFlow()
+
+  private val _selectedPatientId = MutableStateFlow<Long?>(null)
+  val selectedPatientId: StateFlow<Long?> = _selectedPatientId.asStateFlow()
+
+  private val _isRecordingVisit = MutableStateFlow(false)
+  val isRecordingVisit: StateFlow<Boolean> = _isRecordingVisit.asStateFlow()
+
+  init {
+    refreshPatients()
+  }
+
+  fun refreshPatients() {
+    _patients.value = dbHelper.getAllPatientsSortedByDueDate()
+  }
+
+  fun selectPatient(patientId: Long) {
+    _selectedPatientId.value = patientId
+    _isRecordingVisit.value = false
+  }
+
+  fun navigateBackToRegister() {
+    _isRecordingVisit.value = false
+    _selectedPatientId.value = null
+  }
+
+  fun openRecordVisitForm() {
+    if (_selectedPatientId.value != null) {
+      _isRecordingVisit.value = true
+    }
+  }
+
+  fun closeRecordVisitForm() {
+    _isRecordingVisit.value = false
+  }
+
+  fun saveNewVisit(
+    patientId: Long,
+    visitDate: String,
+    gestationalAgeWeeks: Int,
+    weightKg: Double,
+    systolicBp: Int,
+    diastolicBp: Int,
+    hemoglobinGdL: Double?,
+    dangerSigns: List<DangerSign>,
+    notes: String,
+  ) {
+    val visit =
+      AncVisit(
+        patientId = patientId,
+        visitDate = visitDate.trim(),
+        gestationalAgeWeeks = gestationalAgeWeeks,
+        weightKg = weightKg,
+        systolicBp = systolicBp,
+        diastolicBp = diastolicBp,
+        hemoglobinGdL = hemoglobinGdL,
+        dangerSigns = dangerSigns,
+        notes = notes.trim(),
+      )
+    dbHelper.insertVisit(visit)
+    refreshPatients()
+    _isRecordingVisit.value = false
+  }
+}
