+package com.example.ancapp
+
+import com.ionspin.kotlin.bignum.decimal.BigDecimal
+import dev.ohs.fhir.model.r4.Bundle
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.CodeableConcept
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.DateTime
+import dev.ohs.fhir.model.r4.Decimal
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Enumeration
+import dev.ohs.fhir.model.r4.FhirDateTime
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Patient
+import dev.ohs.fhir.model.r4.Period
+import dev.ohs.fhir.model.r4.Quantity
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import dev.ohs.fhir.model.r4.Reference
+import dev.ohs.fhir.model.r4.Resource
+import dev.ohs.fhir.model.r4.String as FhirString
+import dev.ohs.fhir.model.r4.Uri
+import kotlinx.serialization.json.Json
+import java.net.HttpURLConnection
+import java.net.URL
+import java.time.LocalDate
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+
+// The HAPI server is the source of truth: every read and write goes straight to it.
+// ponytail: no local cache or FHIR engine sync, add them when the clinic needs offline use.
+object Hapi {
+  private const val BASE = "http://10.0.2.2:8080/fhir"
+  private const val EDD = "11778-8"
+  private const val WEIGHT = "29463-7"
+  private const val BP_PANEL = "85354-9"
+  private const val SYSTOLIC = "8480-6"
+  private const val DIASTOLIC = "8462-4"
+  private const val HB = "718-7"
+  private const val ANC_SYSTEM = "urn:example:anc"
+
+  private val json = Json {
+    explicitNulls = false
+    encodeDefaults = false
+    ignoreUnknownKeys = true
+  }
+
+  // Patients with an estimated due date on file, soonest due first.
+  // Due dates are not closed out by delivery, so overdue patients (e.g. past 40 weeks) still show.
+  fun pregnancies(): List<Pregnancy> {
+    val due = search<Observation>("Observation?code=$EDD&_count=100").mapNotNull { obs ->
+      val id = obs.subject?.reference?.value?.substringAfter("/") ?: return@mapNotNull null
+      val date = obs.value?.asDateTime()?.value?.value?.toString() ?: return@mapNotNull null
+      id to LocalDate.parse(date.substringBefore("T"))
+    }.toMap()
+    val today = LocalDate.now()
+    return search<Patient>("Patient?_count=100").mapNotNull { p ->
+      val id = p.id ?: return@mapNotNull null
+      val edd = due[id] ?: return@mapNotNull null
+      val dob = LocalDate.parse(p.birthDate?.value?.toString() ?: return@mapNotNull null)
+      val n = p.name.firstOrNull()
+      val name = listOfNotNull(n?.given?.firstOrNull()?.value, n?.family?.value).joinToString(" ")
+      Pregnancy(id, name, ChronoUnit.YEARS.between(dob, today).toInt(), edd)
+    }.sortedBy { it.due }
+  }
+
+  // Visits (encounters) for one patient, newest first. Observations are joined by their encounter reference.
+  fun visits(patientId: String): List<Visit> {
+    val obsByEncounter = search<Observation>("Observation?patient=Patient/$patientId&_count=200")
+      .groupBy { it.encounter?.reference?.value?.substringAfter("/") }
+    return search<Encounter>("Encounter?subject=Patient/$patientId&_count=200").map { enc ->
+      val obs = obsByEncounter[enc.id].orEmpty()
+      val sys = obs.firstOrNull { it.hasCode(BP_PANEL) }?.componentValue(SYSTOLIC)
+      val dia = obs.firstOrNull { it.hasCode(BP_PANEL) }?.componentValue(DIASTOLIC)
+      Visit(
+        date = enc.period?.start?.value?.toString() ?: "",
+        weight = obs.firstOrNull { it.hasCode(WEIGHT) }?.quantity()?.let { "$it kg" },
+        bp = if (sys != null && dia != null) "$sys/$dia" else null,
+        hb = obs.firstOrNull { it.hasCode(HB) }?.quantity()?.let { "$it g/dL" },
+      )
+    }.sortedByDescending { it.date }
+  }
+
+  // The Questionnaire JSON, passed straight to the form.
+  fun questionnaire(): String = request("GET", "Questionnaire/anc-contact")
+
+  // Writes one visit: an Encounter plus Observations referencing it. Client-assigned ids use PUT (create-as-update).
+  fun saveVisit(patientId: String, response: QuestionnaireResponse) {
+    val answers = answers(response)
+    val date = answers["visit-date"]?.firstOrNull()?.value?.asDate()?.value?.value?.toString()
+      ?: error("Visit date is missing")
+    val encId = UUID.randomUUID().toString()
+    val effective = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(date)))
+    val subject = Reference(reference = FhirString(value = "Patient/$patientId"))
+    val encounter = Reference(reference = FhirString(value = "Encounter/$encId"))
+
+    fun obs(code: CodeableConcept, value: Observation.Value?, components: List<Observation.Component> = emptyList()) =
+      Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        code = code,
+        subject = subject,
+        encounter = encounter,
+        effective = effective,
+        value = value,
+        component = components,
+      )
+
+    val observations = mutableListOf<Observation>()
+    answers["weight"]?.firstOrNull()?.value?.asDecimal()?.value?.value?.let { kg ->
+      observations += obs(
+        loinc(WEIGHT, "Body weight"),
+        Observation.Value.Quantity(
+          Quantity(value = Decimal(value = kg), unit = FhirString(value = "kg"), system = Uri(value = "http://unitsofmeasure.org"), code = Code(value = "kg")),
+        ),
+      )
+    }
+    val systolic = answers["bp-systolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+    val diastolic = answers["bp-diastolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+    if (systolic != null && diastolic != null) {
+      observations += obs(
+        loinc(BP_PANEL, "Blood pressure"),
+        value = null,
+        components = listOf(
+          mmHgComponent(SYSTOLIC, "Systolic blood pressure", systolic),
+          mmHgComponent(DIASTOLIC, "Diastolic blood pressure", diastolic),
+        ),
+      )
+    }
+    answers["gestational-age"]?.firstOrNull()?.value?.asInteger()?.value?.value?.let { weeks ->
+      observations += obs(
+        ancConcept("gestational-age", "Gestational age (weeks)"),
+        Observation.Value.Quantity(
+          Quantity(value = Decimal(value = BigDecimal.fromInt(weeks)), unit = FhirString(value = "wk"), system = Uri(value = "http://unitsofmeasure.org"), code = Code(value = "wk")),
+        ),
+      )
+    }
+    val dangers = answers["danger-signs"].orEmpty().mapNotNull { it.value?.asCoding()?.value }
+    if (dangers.isNotEmpty()) {
+      observations += obs(ancConcept("danger-signs", "Danger signs"), Observation.Value.CodeableConcept(CodeableConcept(coding = dangers)))
+    }
+    answers["notes"]?.firstOrNull()?.value?.asString()?.value?.value?.takeIf { it.isNotBlank() }?.let { text ->
+      observations += obs(ancConcept("visit-notes", "Visit notes"), Observation.Value.String(FhirString(value = text)))
+    }
+
+    val enc = Encounter(
+      id = encId,
+      status = Enumeration(value = Encounter.EncounterStatus.Finished),
+      `class` = Coding(system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"), code = Code(value = "AMB"), display = FhirString(value = "ambulatory")),
+      type = listOf(CodeableConcept(text = FhirString(value = "Antenatal care contact"))),
+      subject = subject,
+      period = Period(start = DateTime(value = FhirDateTime.fromString(date))),
+    )
+    request("PUT", "Encounter/$encId", json.encodeToString(enc))
+    observations.forEach { request("PUT", "Observation/${it.id}", json.encodeToString(it)) }
+  }
+
+  private inline fun <reified T : Resource> search(query: String): List<T> =
+    json.decodeFromString<Bundle>(request("GET", query)).entry.mapNotNull { it.resource as? T }
+
+  private fun request(method: String, path: String, body: String? = null): String {
+    val conn = URL("$BASE/$path").openConnection() as HttpURLConnection
+    conn.requestMethod = method
+    conn.setRequestProperty("Accept", "application/fhir+json")
+    if (body != null) {
+      conn.doOutput = true
+      conn.setRequestProperty("Content-Type", "application/fhir+json")
+      conn.outputStream.use { it.write(body.toByteArray()) }
+    }
+    val code = conn.responseCode
+    val text = (if (code in 200..299) conn.inputStream else conn.errorStream).bufferedReader().use { it.readText() }
+    if (code !in 200..299) error("HTTP $code from $method $path: $text")
+    return text
+  }
+
+  // Flattens answers by linkId, descending into groups and nested answer items.
+  private fun answers(response: QuestionnaireResponse): Map<String, List<QuestionnaireResponse.Item.Answer>> {
+    val out = mutableMapOf<String, MutableList<QuestionnaireResponse.Item.Answer>>()
+    fun walk(items: List<QuestionnaireResponse.Item>) {
+      items.forEach { item ->
+        item.linkId.value?.let { out.getOrPut(it) { mutableListOf() }.addAll(item.answer) }
+        walk(item.item)
+        item.answer.forEach { walk(it.item) }
+      }
+    }
+    walk(response.item)
+    return out
+  }
+
+  private fun Observation.hasCode(code: String) = this.code.coding.any { it.code?.value == code }
+
+  private fun CodeableConcept.hasCode(code: String) = coding.any { it.code?.value == code }
+
+  private fun Observation.quantity(): String? = value?.asQuantity()?.value?.value?.value?.toPlainString()
+
+  private fun Observation.componentValue(code: String): String? =
+    component.firstOrNull { it.code.hasCode(code) }?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+
+  private fun loinc(code: String, display: String) = CodeableConcept(
+    coding = listOf(Coding(system = Uri(value = "http://loinc.org"), code = Code(value = code), display = FhirString(value = display))),
+    text = FhirString(value = display),
+  )
+
+  private fun ancConcept(code: String, text: String) = CodeableConcept(
+    coding = listOf(Coding(system = Uri(value = ANC_SYSTEM), code = Code(value = code), display = FhirString(value = text))),
+    text = FhirString(value = text),
+  )
+
+  private fun mmHgComponent(code: String, display: String, mmHg: Int) = Observation.Component(
+    code = loinc(code, display),
+    value = Observation.Component.Value.Quantity(
+      Quantity(value = Decimal(value = BigDecimal.fromInt(mmHg)), unit = FhirString(value = "mmHg"), system = Uri(value = "http://unitsofmeasure.org"), code = Code(value = "mm[Hg]")),
+    ),
+  )
+}
+
+data class Pregnancy(val id: String, val name: String, val age: Int, val due: LocalDate) {
+  // 280 days = 40 weeks; negative remaining days past the due date show as weeks over 40.
+  fun weeks(today: LocalDate = LocalDate.now()): Int = ((280 - ChronoUnit.DAYS.between(today, due)) / 7).toInt()
+}
+
+data class Visit(val date: String, val weight: String?, val bp: String?, val hb: String?)
