+/** Runs [block] off the main thread; result is null while loading, error text on failure. */
+@Composable
+private fun <T> load(key: Any?, block: () -> T): Pair<T?, String?> {
+  var state by remember(key) { mutableStateOf<Pair<T?, String?>>(null to null) }
+  LaunchedEffect(key) {
+    state = try { withContext(Dispatchers.IO) { block() } to null } catch (e: Exception) { null to (e.message ?: e.toString()) }
+  }
+  return state
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+private fun App() {
+  var patient by remember { mutableStateOf<PatientRow?>(null) }
+  var form by remember { mutableStateOf(false) }
+  var reload by remember { mutableIntStateOf(0) }
+  BackHandler(patient != null) { if (form) form = false else patient = null }
+  Scaffold(topBar = { TopAppBar(title = { Text(patient?.name ?: "ANC Register") }) }) { pad ->
+    Box(Modifier.padding(pad).fillMaxSize()) {
+      val p = patient
+      when {
+        p == null -> Register { patient = it }
+        form -> VisitForm(p) { form = false; if (it) reload++ }
+        else -> Detail(p, reload) { form = true }
+      }
+    }
+  }
+}
+
+@Composable
+private fun Status(error: String?) =
+  Text(error ?: "Loading…", Modifier.padding(16.dp), color = if (error != null) MaterialTheme.colorScheme.error else MaterialTheme.colorScheme.onSurface)
+
+@Composable
+private fun Register(onOpen: (PatientRow) -> Unit) {
+  val (rows, err) = load(Unit) { fetchRegister() }
+  if (rows == null) return Status(err)
+  LazyColumn(Modifier.fillMaxSize(), contentPadding = androidx.compose.foundation.layout.PaddingValues(12.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+    items(rows) { r ->
+      Card(Modifier.fillMaxWidth().clickable { onOpen(r) }) {
+        Column(Modifier.padding(16.dp)) {
+          Text(r.name, style = MaterialTheme.typography.titleMedium)
+          Text("Age ${r.age} · Due ${r.edd ?: "unknown"} · ${r.weeks?.let { "$it weeks" } ?: "weeks unknown"}")
+        }
+      }
+    }
+  }
+}
+
+@Composable
+private fun Detail(p: PatientRow, reload: Int, onNewVisit: () -> Unit) {
+  val (visits, err) = load(p.id to reload) { fetchVisits(p.id) }
+  Column(Modifier.fillMaxSize().padding(12.dp)) {
+    Text("Age ${p.age} · Due ${p.edd ?: "unknown"} · ${p.weeks?.let { "$it weeks" } ?: ""}")
+    Button(onNewVisit, Modifier.padding(vertical = 8.dp)) { Text("Record new ANC visit") }
+    if (visits == null) return@Column Status(err)
+    if (visits.isEmpty()) Text("No visits recorded")
+    LazyColumn(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+      items(visits) { v ->
+        Card(Modifier.fillMaxWidth()) {
+          Column(Modifier.padding(16.dp)) {
+            Text(v.date, style = MaterialTheme.typography.titleMedium)
+            Text("Weight: ${v.weight?.let { "$it kg" } ?: "—"}")
+            Text("BP: ${v.bp?.let { "$it mmHg" } ?: "—"}")
+            v.hb?.let { Text("Hemoglobin: $it g/dL") }
+            if (v.dangerSigns.isNotEmpty()) Text("Danger signs: ${v.dangerSigns.joinToString()}", color = MaterialTheme.colorScheme.error)
+            v.notes?.let { Text("Notes: $it") }
+          }
+        }
+      }
+    }
+  }
+}
+
+@Composable
+private fun VisitForm(p: PatientRow, onDone: (saved: Boolean) -> Unit) {
+  val (q, err) = load(Unit) { fetchQuestionnaire() }
+  val scope = rememberCoroutineScope()
+  var saveErr by remember { mutableStateOf<String?>(null) }
+  if (q == null) return Status(err)
+  // fresh ViewModel store per open, otherwise Data Capture reuses the previous form's answers
+  val owner = remember { object : ViewModelStoreOwner { override val viewModelStore = ViewModelStore() } }
+  DisposableEffect(owner) { onDispose { owner.viewModelStore.clear() } }
+  CompositionLocalProvider(LocalViewModelStoreOwner provides owner) {
+  Column(Modifier.fillMaxSize()) {
+    saveErr?.let { Text("Save failed: $it", Modifier.padding(8.dp), color = MaterialTheme.colorScheme.error) }
+    Questionnaire(
+      questionnaireJson = q,
+      questionnaireResponseJson = null,
+      questionnaireLaunchContextMap = null,
+      onSubmit = { getResponse ->
+        scope.launch {
+          try {
+            val json = Json.encodeToString(QuestionnaireResponse.serializer(), getResponse())
+            withContext(Dispatchers.IO) { saveVisit(p.id, json) }
+            onDone(true)
+          } catch (e: Exception) {
+            saveErr = e.message ?: e.toString()
+          }
+        }
+      },
+      onCancel = { onDone(false) },
+    )
+  }
   }
 }
