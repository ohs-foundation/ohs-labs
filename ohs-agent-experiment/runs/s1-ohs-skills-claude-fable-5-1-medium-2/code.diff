@@ -0,0 +1,144 @@
+package com.example.ancapp
+
+import com.ionspin.kotlin.bignum.decimal.BigDecimal
+import dev.ohs.fhir.engine.FhirEngine
+import dev.ohs.fhir.engine.get
+import dev.ohs.fhir.engine.search.ReferenceClientParam
+import dev.ohs.fhir.engine.search.Search
+import dev.ohs.fhir.model.r4.Canonical
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.CodeableConcept
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.DateTime
+import dev.ohs.fhir.model.r4.Decimal
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Enumeration
+import dev.ohs.fhir.model.r4.FhirDateTime
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Patient
+import dev.ohs.fhir.model.r4.Period
+import dev.ohs.fhir.model.r4.Quantity
+import dev.ohs.fhir.model.r4.Questionnaire
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import dev.ohs.fhir.model.r4.Reference
+import dev.ohs.fhir.model.r4.Uri
+import dev.ohs.fhir.model.r4.String as FhirString
+import dev.ohs.fhir.model.r4.terminologies.ResourceType
+import java.time.LocalDate
+import java.time.Period as JPeriod
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+
+const val LOINC = "http://loinc.org"
+const val EDD = "11778-8"; const val WEIGHT = "29463-7"; const val BP = "85354-9"
+const val SYS = "8480-6"; const val DIA = "8462-4"; const val HB = "718-7"
+
+data class PatientRow(val id: String, val name: String, val age: Int, val edd: LocalDate?) {
+  // ponytail: weeks derived from EDD - 280 days (Naegele), no LMP observation on server
+  val weeks: Long? get() = edd?.let { ChronoUnit.WEEKS.between(it.minusDays(280), LocalDate.now()) }
+}
+
+data class Visit(val date: LocalDate, val weight: String?, val bp: String?, val hb: String?)
+
+private fun fhirDate(s: String?) = s?.let { LocalDate.parse(it.substringBefore("T")) }
+private fun Observation.loinc() = code.coding.firstOrNull { it.system?.value == LOINC }?.code?.value
+private fun Observation.qty() = value?.asQuantity()?.value?.value?.value?.toPlainString()
+private fun Observation.comp(code: String) =
+  component.firstOrNull { c -> c.code.coding.any { it.code?.value == code } }
+    ?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+
+suspend fun FhirEngine.obsFor(patientId: String) =
+  search<Observation>(Search(ResourceType.Observation).apply {
+    filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+  }).map { it.resource }
+
+suspend fun FhirEngine.loadPatients(): List<PatientRow> =
+  search<Patient>(Search(ResourceType.Patient)).map { it.resource }.mapNotNull { p ->
+    val id = p.id ?: return@mapNotNull null
+    val name = p.name.firstOrNull()
+    val edd = obsFor(id).filter { it.loinc() == EDD }
+      .mapNotNull { fhirDate(it.value?.asDateTime()?.value?.value?.toString()) }.maxOrNull()
+    val dob = fhirDate(p.birthDate?.value?.toString())
+    PatientRow(
+      id = id,
+      name = listOfNotNull(name?.given?.mapNotNull { it.value }?.joinToString(" "), name?.family?.value).joinToString(" "),
+      age = dob?.let { JPeriod.between(it, LocalDate.now()).years } ?: 0,
+      edd = edd,
+    )
+  }.sortedWith(compareBy(nullsLast()) { it.edd })
+
+suspend fun FhirEngine.loadVisits(patientId: String): List<Visit> {
+  val obs = obsFor(patientId).groupBy { it.encounter?.reference?.value?.substringAfter("/") }
+  return search<Encounter>(Search(ResourceType.Encounter).apply {
+    filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+  }).map { it.resource }.mapNotNull { e ->
+    val o = obs[e.id].orEmpty()
+    val bp = o.firstOrNull { it.loinc() == BP }
+    Visit(
+      date = fhirDate(e.period?.start?.value?.toString()) ?: return@mapNotNull null,
+      weight = o.firstOrNull { it.loinc() == WEIGHT }?.qty(),
+      bp = bp?.let { "${it.comp(SYS)}/${it.comp(DIA)}" },
+      hb = o.firstOrNull { it.loinc() == HB }?.qty(),
+    )
+  }.sortedByDescending { it.date }
+}
+
+suspend fun FhirEngine.saveVisit(patientId: String, q: Questionnaire, qr: QuestionnaireResponse) {
+  val answers = mutableMapOf<String, MutableList<QuestionnaireResponse.Item.Answer>>()
+  fun collect(items: List<QuestionnaireResponse.Item>): Unit = items.forEach { i ->
+    i.linkId.value?.let { answers.getOrPut(it) { mutableListOf() }.addAll(i.answer) }
+    collect(i.item); i.answer.forEach { collect(it.item) }
+  }
+  collect(qr.item)
+  val date = answers["visit-date"]?.firstOrNull()?.value?.asDate()?.value?.value?.toString()
+    ?: LocalDate.now().toString()
+  val weight = answers["weight"]?.firstOrNull()?.value?.asDecimal()?.value?.value?.toPlainString()
+  val sys = answers["bp-systolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+  val dia = answers["bp-diastolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+
+  val encId = UUID.randomUUID().toString()
+  val subject = Reference(reference = FhirString(value = "Patient/$patientId"))
+  val encRef = Reference(reference = FhirString(value = "Encounter/$encId"))
+  val dt = DateTime(value = FhirDateTime.fromString(date))
+  fun concept(code: String, display: String) = CodeableConcept(
+    coding = listOf(Coding(system = Uri(value = LOINC), code = Code(value = code), display = FhirString(value = display))),
+  )
+  fun qty(v: String, unit: String) = Quantity(
+    value = Decimal(value = BigDecimal.parseString(v)), unit = FhirString(value = unit),
+    system = Uri(value = "http://unitsofmeasure.org"), code = Code(value = unit),
+  )
+  fun obs(code: CodeableConcept, value: Observation.Value? = null, comps: List<Observation.Component> = emptyList()) =
+    Observation(
+      id = UUID.randomUUID().toString(),
+      status = Enumeration(value = Observation.ObservationStatus.Final),
+      code = code, subject = subject, encounter = encRef,
+      effective = Observation.Effective.DateTime(dt), value = value, component = comps,
+    )
+
+  val encounter = Encounter(
+    id = encId,
+    status = Enumeration(value = Encounter.EncounterStatus.Finished),
+    `class` = Coding(system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"), code = Code(value = "AMB")),
+    type = listOf(CodeableConcept(text = FhirString(value = "Antenatal care contact"))),
+    subject = subject,
+    period = Period(start = dt, end = dt),
+  )
+  val resources = buildList {
+    add(encounter)
+    weight?.let { add(obs(concept(WEIGHT, "Body weight"), Observation.Value.Quantity(qty(it, "kg")))) }
+    if (sys != null && dia != null) add(obs(concept(BP, "Blood pressure"), comps = listOf(
+      Observation.Component(code = concept(SYS, "Systolic blood pressure"), value = Observation.Component.Value.Quantity(qty(sys.toString(), "mm[Hg]"))),
+      Observation.Component(code = concept(DIA, "Diastolic blood pressure"), value = Observation.Component.Value.Quantity(qty(dia.toString(), "mm[Hg]"))),
+    )))
+    add(qr.toBuilder().apply {
+      id = UUID.randomUUID().toString()
+      status = Enumeration(value = QuestionnaireResponse.QuestionnaireResponseStatus.Completed)
+      this.subject = subject.toBuilder()
+      this.encounter = encRef.toBuilder()
+      q.url?.value?.let { questionnaire = Canonical(value = it).toBuilder() }
+    }.build())
+  }
+  create(*resources.toTypedArray())
+}
+
+suspend fun FhirEngine.questionnaire(): Questionnaire = get<Questionnaire>("anc-contact")
