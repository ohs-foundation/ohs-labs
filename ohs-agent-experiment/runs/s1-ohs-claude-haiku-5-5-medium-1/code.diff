+private sealed interface Route {
+  data object Register : Route
+  data class Detail(val patient: Patient) : Route
+  data class NewVisit(val patient: Patient) : Route
+}
+
+@Composable
+private fun AncApp() {
+  var route by remember { mutableStateOf<Route>(Route.Register) }
+  when (val r = route) {
+    Route.Register -> RegisterScreen(onOpen = { route = Route.Detail(it) })
+    is Route.Detail -> DetailScreen(
+      patient = r.patient,
+      onBack = { route = Route.Register },
+      onNewVisit = { route = Route.NewVisit(r.patient) },
+    )
+    is Route.NewVisit -> VisitFormScreen(
+      patient = r.patient,
+      onBack = { route = Route.Detail(r.patient) },
+      onSaved = { route = Route.Detail(r.patient) },
+    )
+  }
+}
