diff --git a/app/src/main/java/com/example/ancapp/data/AncRepository.kt b/app/src/main/java/com/example/ancapp/data/AncRepository.kt
new file mode 100644
index 0000000..b6d9681
--- /dev/null
+++ b/app/src/main/java/com/example/ancapp/data/AncRepository.kt
@@ -0,0 +1,519 @@
+package com.example.ancapp.data
+
+import com.ionspin.kotlin.bignum.decimal.BigDecimal
+import dev.ohs.fhir.engine.FhirEngine
+import dev.ohs.fhir.engine.get
+import dev.ohs.fhir.engine.search.ReferenceClientParam
+import dev.ohs.fhir.engine.search.Search
+import dev.ohs.fhir.model.r4.CodeableConcept
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.DateTime
+import dev.ohs.fhir.model.r4.Decimal
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Enumeration
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Patient
+import dev.ohs.fhir.model.r4.Period
+import dev.ohs.fhir.model.r4.Quantity
+import dev.ohs.fhir.model.r4.Questionnaire
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import dev.ohs.fhir.model.r4.Reference
+import dev.ohs.fhir.model.r4.String as FhirString
+import dev.ohs.fhir.model.r4.Canonical
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.FhirDateTime
+import dev.ohs.fhir.model.r4.Uri
+import dev.ohs.fhir.model.r4.terminologies.ResourceType
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import java.time.LocalDate
+import java.time.Period as JavaPeriod
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+
+class AncRepository(private val fhirEngine: FhirEngine) {
+
+  private val json = Json {
+    explicitNulls = false
+    encodeDefaults = false
+    ignoreUnknownKeys = true
+  }
+
+  suspend fun getPregnantPatients(): List<PatientItem> {
+    val searchResults = fhirEngine.search<Patient>(Search(ResourceType.Patient))
+    val patients = searchResults.map { it.resource }
+
+    val patientItems = patients.map { patient ->
+      val id = patient.id ?: ""
+      val nameObj = patient.name.firstOrNull()
+      val given = nameObj?.given?.mapNotNull { it.value }?.joinToString(" ")
+      val family = nameObj?.family?.value
+      val fullName = listOfNotNull(given, family).filter { it.isNotBlank() }.joinToString(" ")
+      val displayName = if (fullName.isNotBlank()) fullName else "Unknown Patient"
+
+      val dobStr = patient.birthDate?.value?.toString()
+      val age = dobStr?.let {
+        runCatching {
+          JavaPeriod.between(LocalDate.parse(it), LocalDate.now()).years
+        }.getOrNull()
+      }
+
+      // Find EDD observation for this patient
+      val obsList = fhirEngine.search<Observation>(
+        Search(ResourceType.Observation).apply {
+          filter(ReferenceClientParam("subject"), { value = "Patient/$id" })
+        }
+      ).map { it.resource }
+
+      val eddObs = obsList.firstOrNull { obs ->
+        obs.code.coding.any { it.code?.value == "11778-8" }
+      }
+
+      val eddStr = eddObs?.value?.asDateTime()?.value?.value?.toString()
+        ?: eddObs?.effective?.asDateTime()?.value?.value?.toString()
+
+      val eddDate = eddStr?.let {
+        runCatching { LocalDate.parse(it.substringBefore("T")) }.getOrNull()
+      }
+
+      val gestationalAgeWeeks = eddDate?.let { edd ->
+        val lmp = edd.minusDays(280)
+        val days = ChronoUnit.DAYS.between(lmp, LocalDate.now())
+        (days / 7).coerceAtLeast(0)
+      }
+
+      PatientItem(
+        id = id,
+        name = displayName,
+        birthDate = dobStr,
+        age = age,
+        edd = eddDate,
+        gestationalAgeWeeks = gestationalAgeWeeks,
+      )
+    }
+
+    // Sort by due date (soonest first). If EDD is null, place at the end.
+    return patientItems.sortedWith(compareBy(nullsLast()) { it.edd })
+  }
+
+  suspend fun getPatientDetail(patientId: String): PatientDetail {
+    val patient = fhirEngine.get<Patient>(patientId)
+    val nameObj = patient.name.firstOrNull()
+    val given = nameObj?.given?.mapNotNull { it.value }?.joinToString(" ")
+    val family = nameObj?.family?.value
+    val fullName = listOfNotNull(given, family).filter { it.isNotBlank() }.joinToString(" ")
+    val displayName = if (fullName.isNotBlank()) fullName else "Unknown Patient"
+
+    val dobStr = patient.birthDate?.value?.toString()
+    val age = dobStr?.let {
+      runCatching {
+        JavaPeriod.between(LocalDate.parse(it), LocalDate.now()).years
+      }.getOrNull()
+    }
+
+    // Patient's observations
+    val allPatientObs = fhirEngine.search<Observation>(
+      Search(ResourceType.Observation).apply {
+        filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+      }
+    ).map { it.resource }
+
+    val eddObs = allPatientObs.firstOrNull { obs ->
+      obs.code.coding.any { it.code?.value == "11778-8" }
+    }
+    val eddStr = eddObs?.value?.asDateTime()?.value?.value?.toString()
+      ?: eddObs?.effective?.asDateTime()?.value?.value?.toString()
+    val eddDate = eddStr?.let {
+      runCatching { LocalDate.parse(it.substringBefore("T")) }.getOrNull()
+    }
+
+    val gestationalAgeWeeks = eddDate?.let { edd ->
+      val lmp = edd.minusDays(280)
+      val days = ChronoUnit.DAYS.between(lmp, LocalDate.now())
+      (days / 7).coerceAtLeast(0)
+    }
+
+    val patientItem = PatientItem(
+      id = patientId,
+      name = displayName,
+      birthDate = dobStr,
+      age = age,
+      edd = eddDate,
+      gestationalAgeWeeks = gestationalAgeWeeks,
+    )
+
+    // Patient's encounters
+    val encounters = fhirEngine.search<Encounter>(
+      Search(ResourceType.Encounter).apply {
+        filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+      }
+    ).map { it.resource }
+
+    // Patient's questionnaire responses (if any)
+    val responses = fhirEngine.search<QuestionnaireResponse>(
+      Search(ResourceType.QuestionnaireResponse).apply {
+        filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+      }
+    ).map { it.resource }
+
+    val visitItems = encounters.map { encounter ->
+      val encId = encounter.id ?: ""
+      val dateStr = encounter.period?.start?.value?.toString()?.substringBefore("T")
+        ?: encounter.period?.end?.value?.toString()?.substringBefore("T")
+        ?: ""
+
+      val encObs = allPatientObs.filter { obs ->
+        obs.encounter?.reference?.value?.substringAfter("/") == encId
+      }
+
+      // Weight (LOINC 29463-7)
+      val weightObs = encObs.firstOrNull { obs ->
+        obs.code.coding.any { it.code?.value == "29463-7" }
+      }
+      val weightVal = weightObs?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+      val weightStr = weightVal?.let { "$it kg" }
+
+      // Blood pressure (LOINC 85354-9 or components 8480-6 / 8462-4)
+      val bpObs = encObs.firstOrNull { obs ->
+        obs.code.coding.any { it.code?.value == "85354-9" }
+      }
+      val sysComp = bpObs?.component?.firstOrNull { comp ->
+        comp.code.coding.any { it.code?.value == "8480-6" }
+      }
+      val diaComp = bpObs?.component?.firstOrNull { comp ->
+        comp.code.coding.any { it.code?.value == "8462-4" }
+      }
+      val sysVal = sysComp?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+      val diaVal = diaComp?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+      val bpStr = if (sysVal != null && diaVal != null) "$sysVal/$diaVal" else null
+
+      // Hemoglobin (LOINC 718-7)
+      val hbObs = encObs.firstOrNull { obs ->
+        obs.code.coding.any { it.code?.value == "718-7" }
+      }
+      val hbVal = hbObs?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+      val hbStr = hbVal?.let { "$it g/dL" }
+
+      // Also check QuestionnaireResponse for danger signs / notes / ga
+      val qr = responses.firstOrNull {
+        it.encounter?.reference?.value?.substringAfter("/") == encId
+      }
+      val answers = mutableMapOf<String, MutableList<QuestionnaireResponse.Item.Answer>>()
+      fun collect(items: List<QuestionnaireResponse.Item>) {
+        items.forEach { item ->
+          item.linkId.value?.let { answers.getOrPut(it) { mutableListOf() }.addAll(item.answer) }
+          collect(item.item)
+          item.answer.forEach { collect(it.item) }
+        }
+      }
+      if (qr != null) {
+        collect(qr.item)
+      }
+
+      val gaWeeks = answers["gestational-age"]?.firstOrNull()?.value?.asInteger()?.value?.value
+      val dangerSigns = answers["danger-signs"]?.mapNotNull { ans ->
+        ans.value?.asCoding()?.value?.display?.value ?: ans.value?.asCoding()?.value?.code?.value
+      } ?: emptyList()
+      val notes = answers["notes"]?.firstOrNull()?.value?.asString()?.value?.value
+
+      VisitItem(
+        encounterId = encId,
+        date = dateStr,
+        gestationalAgeWeeks = gaWeeks,
+        weightKg = weightStr,
+        bloodPressure = bpStr,
+        hemoglobin = hbStr,
+        dangerSigns = dangerSigns,
+        notes = notes,
+      )
+    }.sortedByDescending { it.date }
+
+    return PatientDetail(
+      patient = patientItem,
+      visits = visitItems,
+    )
+  }
+
+  suspend fun getQuestionnaireJson(): String {
+    return runCatching {
+      val q = fhirEngine.get<Questionnaire>("anc-contact")
+      json.encodeToString(q)
+    }.getOrElse {
+      FALLBACK_ANC_QUESTIONNAIRE_JSON
+    }
+  }
+
+  suspend fun saveVisit(patientId: String, response: QuestionnaireResponse) {
+    val answers = mutableMapOf<String, MutableList<QuestionnaireResponse.Item.Answer>>()
+    fun collect(items: List<QuestionnaireResponse.Item>) {
+      items.forEach { item ->
+        item.linkId.value?.let { answers.getOrPut(it) { mutableListOf() }.addAll(item.answer) }
+        collect(item.item)
+        item.answer.forEach { collect(it.item) }
+      }
+    }
+    collect(response.item)
+
+    val dateVal = answers["visit-date"]?.firstOrNull()?.value?.asDate()?.value?.value?.toString()
+    val visitDateStr = if (!dateVal.isNullOrBlank()) dateVal else LocalDate.now().toString()
+    val weightBigDecimal = answers["weight"]?.firstOrNull()?.value?.asDecimal()?.value?.value
+    val systolic = answers["bp-systolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+    val diastolic = answers["bp-diastolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+
+    val encounterId = UUID.randomUUID().toString()
+    val visitDateTime = FhirDateTime.fromString(visitDateStr)
+
+    val encounter = Encounter(
+      id = encounterId,
+      status = Enumeration(value = Encounter.EncounterStatus.Finished),
+      `class` = Coding(
+        system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"),
+        code = Code(value = "AMB"),
+        display = FhirString(value = "ambulatory"),
+      ),
+      type = listOf(
+        CodeableConcept(text = FhirString(value = "Antenatal care contact"))
+      ),
+      subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+      period = Period(
+        start = DateTime(value = visitDateTime),
+        end = DateTime(value = visitDateTime),
+      ),
+    )
+
+    val weightObs = weightBigDecimal?.let { w ->
+      Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        category = listOf(
+          CodeableConcept(
+            coding = listOf(
+              Coding(
+                system = Uri(value = "http://terminology.hl7.org/CodeSystem/observation-category"),
+                code = Code(value = "vital-signs"),
+                display = FhirString(value = "Vital Signs"),
+              )
+            )
+          )
+        ),
+        code = CodeableConcept(
+          coding = listOf(
+            Coding(
+              system = Uri(value = "http://loinc.org"),
+              code = Code(value = "29463-7"),
+              display = FhirString(value = "Body weight"),
+            )
+          ),
+          text = FhirString(value = "Body weight"),
+        ),
+        subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+        encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")),
+        effective = Observation.Effective.DateTime(value = DateTime(value = visitDateTime)),
+        value = Observation.Value.Quantity(
+          value = Quantity(
+            value = Decimal(value = w),
+            unit = FhirString(value = "kg"),
+            system = Uri(value = "http://unitsofmeasure.org"),
+            code = Code(value = "kg"),
+          )
+        ),
+      )
+    }
+
+    val bpObs = if (systolic != null && diastolic != null) {
+      Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        category = listOf(
+          CodeableConcept(
+            coding = listOf(
+              Coding(
+                system = Uri(value = "http://terminology.hl7.org/CodeSystem/observation-category"),
+                code = Code(value = "vital-signs"),
+                display = FhirString(value = "Vital Signs"),
+              )
+            )
+          )
+        ),
+        code = CodeableConcept(
+          coding = listOf(
+            Coding(
+              system = Uri(value = "http://loinc.org"),
+              code = Code(value = "85354-9"),
+              display = FhirString(value = "Blood pressure panel with all children optional"),
+            )
+          ),
+          text = FhirString(value = "Blood pressure"),
+        ),
+        subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+        encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")),
+        effective = Observation.Effective.DateTime(value = DateTime(value = visitDateTime)),
+        component = listOf(
+          Observation.Component(
+            code = CodeableConcept(
+              coding = listOf(
+                Coding(
+                  system = Uri(value = "http://loinc.org"),
+                  code = Code(value = "8480-6"),
+                  display = FhirString(value = "Systolic blood pressure"),
+                )
+              )
+            ),
+            value = Observation.Component.Value.Quantity(
+              value = Quantity(
+                value = Decimal(value = BigDecimal.fromInt(systolic)),
+                unit = FhirString(value = "mmHg"),
+                system = Uri(value = "http://unitsofmeasure.org"),
+                code = Code(value = "mm[Hg]"),
+              )
+            ),
+          ),
+          Observation.Component(
+            code = CodeableConcept(
+              coding = listOf(
+                Coding(
+                  system = Uri(value = "http://loinc.org"),
+                  code = Code(value = "8462-4"),
+                  display = FhirString(value = "Diastolic blood pressure"),
+                )
+              )
+            ),
+            value = Observation.Component.Value.Quantity(
+              value = Quantity(
+                value = Decimal(value = BigDecimal.fromInt(diastolic)),
+                unit = FhirString(value = "mmHg"),
+                system = Uri(value = "http://unitsofmeasure.org"),
+                code = Code(value = "mm[Hg]"),
+              )
+            ),
+          ),
+        ),
+      )
+    } else null
+
+    val completedResponse = response.toBuilder().apply {
+      id = UUID.randomUUID().toString()
+      status = Enumeration(value = QuestionnaireResponse.QuestionnaireResponseStatus.Completed)
+      subject = Reference(reference = FhirString(value = "Patient/$patientId")).toBuilder()
+      this.encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")).toBuilder()
+      questionnaire = Canonical(value = "http://example.org/fhir/Questionnaire/anc-contact").toBuilder()
+      authored = DateTime(value = visitDateTime).toBuilder()
+    }.build()
+
+    val resources = listOfNotNull(encounter, weightObs, bpObs, completedResponse)
+    fhirEngine.create(*resources.toTypedArray())
+  }
+
+  companion object {
+    val FALLBACK_ANC_QUESTIONNAIRE_JSON = """
+      {
+        "resourceType": "Questionnaire",
+        "id": "anc-contact",
+        "url": "http://example.org/fhir/Questionnaire/anc-contact",
+        "version": "0.1.0",
+        "name": "AncContact",
+        "title": "ANC Contact Visit",
+        "status": "active",
+        "subjectType": [ "Patient" ],
+        "item": [
+          {
+            "linkId": "visit-date",
+            "text": "Visit date",
+            "type": "date",
+            "required": true
+          },
+          {
+            "linkId": "gestational-age",
+            "text": "Gestational age (weeks)",
+            "type": "integer"
+          },
+          {
+            "linkId": "vitals",
+            "text": "Vital signs",
+            "type": "group",
+            "item": [
+              {
+                "linkId": "weight",
+                "code": [ {
+                  "system": "http://loinc.org",
+                  "code": "29463-7",
+                  "display": "Body weight"
+                } ],
+                "text": "Weight (kg)",
+                "type": "decimal"
+              },
+              {
+                "linkId": "bp-systolic",
+                "code": [ {
+                  "system": "http://loinc.org",
