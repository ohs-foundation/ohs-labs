+@Composable
+fun AncAppScreen(viewModel: AncViewModel = viewModel()) {
+    val screen = viewModel.screenState
+
+    BackHandler(enabled = screen !is ScreenState.Register) {
+        viewModel.navigateBack()
+    }
+
+    when (screen) {
+        is ScreenState.Register -> {
+            RegisterScreen(
+                patients = viewModel.patients,
+                isLoading = viewModel.isLoading,
+                errorMessage = viewModel.errorMessage,
+                onRefresh = { viewModel.refreshAll() },
+                onSelectPatient = { viewModel.openPatientDetail(it.id) }
+            )
+        }
+        is ScreenState.PatientDetail -> {
+            val patient = viewModel.patients.find { it.id == screen.patientId }
+            val visits = viewModel.visitsByPatient[screen.patientId].orEmpty()
+            if (patient != null) {
