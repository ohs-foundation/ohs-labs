+package com.example.ancapp.ui
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.example.ancapp.data.AncRepository
+import com.example.ancapp.data.Patient
+import com.example.ancapp.data.Visit
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.stateIn
+
+class PatientDetailViewModel(
+    private val repository: AncRepository,
+    private val patientId: Long
+) : ViewModel() {
+
+    val patient: StateFlow<Patient?> = kotlinx.coroutines.flow.flow {
+        val p = repository.getPatientById(patientId)
+        emit(p)
+    }.stateIn(viewModelScope, kotlinx.coroutines.flow.SharingStarted.Lazily, null)
+
+    val visits = repository.getVisitsByPatient(patientId)
+        .stateIn(viewModelScope, kotlinx.coroutines.flow.SharingStarted.Lazily, emptyList())
+}
