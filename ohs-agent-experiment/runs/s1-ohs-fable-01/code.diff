+
+enum class SyncUiState {
+  SYNCING,
+  SYNCED,
+  OFFLINE,
+}
+
+private val dateFormat: DateTimeFormatter = DateTimeFormatter.ofPattern("dd MMM yyyy")
+
+internal fun LocalDate?.display(): String = this?.format(dateFormat) ?: "—"
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun RegisterScreen(refreshKey: Int, syncState: SyncUiState, onPatientClick: (String) -> Unit) {
+  val context = LocalContext.current
+  val patients by
+    produceState<List<PatientRow>?>(initialValue = null, refreshKey) {
+      value = AncRepository.loadRegister(context)
+    }
+
+  Scaffold(topBar = { TopAppBar(title = { Text("ANC Register") }) }) { padding ->
+    Column(modifier = Modifier.padding(padding).fillMaxSize()) {
+      when (syncState) {
+        SyncUiState.SYNCING -> StatusBanner("Syncing with clinic server…")
+        SyncUiState.OFFLINE -> StatusBanner("Offline — showing locally stored data")
+        SyncUiState.SYNCED -> Unit
+      }
+
+      val list = patients
+      when {
+        list == null ->
+          Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
+            CircularProgressIndicator()
+          }
+        list.isEmpty() ->
+          Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
+            Text(
+              "No patients yet.\nCheck the connection to the clinic server.",
+              style = MaterialTheme.typography.bodyLarge,
+            )
+          }
+        else ->
+          LazyColumn(
+            contentPadding = PaddingValues(16.dp),
+            verticalArrangement = Arrangement.spacedBy(12.dp),
+          ) {
+            items(list, key = { it.id }) { patient ->
+              PatientCard(patient, onClick = { onPatientClick(patient.id) })
+            }
+          }
+      }
+    }
+  }
+}
+
+@Composable
+private fun StatusBanner(message: String) {
+  Text(
+    text = message,
+    style = MaterialTheme.typography.bodyMedium,
+    modifier =
+      Modifier.fillMaxWidth()
+        .background(MaterialTheme.colorScheme.secondaryContainer)
+        .padding(horizontal = 16.dp, vertical = 8.dp),
+    color = MaterialTheme.colorScheme.onSecondaryContainer,
+  )
+}
+
+@Composable
+private fun PatientCard(patient: PatientRow, onClick: () -> Unit) {
+  Card(modifier = Modifier.fillMaxWidth().clickable(onClick = onClick)) {
+    Column(Modifier.padding(16.dp)) {
+      Row(verticalAlignment = Alignment.CenterVertically) {
+        Text(
+          patient.name,
+          style = MaterialTheme.typography.titleMedium,
+          fontWeight = FontWeight.SemiBold,
+          modifier = Modifier.weight(1f),
+        )
+        patient.gestationalWeeks?.let {
+          Text(
+            "$it wk",
+            style = MaterialTheme.typography.titleMedium,
+            color = MaterialTheme.colorScheme.primary,
+          )
+        }
+      }
+      Spacer(Modifier.height(4.dp))
+      Text(
+        "Age ${patient.ageYears ?: "—"}   •   Due ${patient.dueDate.display()}",
+        style = MaterialTheme.typography.bodyMedium,
+        color = MaterialTheme.colorScheme.onSurfaceVariant,
+      )
+    }
+  }
+}
