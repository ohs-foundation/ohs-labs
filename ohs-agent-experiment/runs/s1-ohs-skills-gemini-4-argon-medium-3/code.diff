+@Composable
+fun AncApp(ancViewModel: AncViewModel = viewModel()) {
+  val navController = rememberNavController()
+  val uiState by ancViewModel.uiState.collectAsState()
+  val scope = rememberCoroutineScope()
+
+  NavHost(navController = navController, startDestination = "register") {
+    composable("register") {
+      RegisterScreen(
+        uiState = uiState,
+        onSyncClick = { ancViewModel.syncNow() },
+        onPatientClick = { patientId -> navController.navigate("patient/$patientId") },
+      )
+    }
+
+    composable(
+      route = "patient/{patientId}",
+      arguments = listOf(navArgument("patientId") { type = NavType.StringType }),
+    ) { backStackEntry ->
+      val patientId = backStackEntry.arguments?.getString("patientId").orEmpty()
+      val patient = uiState.patients.find { it.id == patientId }
+      val visits = uiState.visitsByPatient[patientId].orEmpty()
+
+      PatientDetailScreen(
+        patient = patient,
+        visits = visits,
+        onBackClick = { navController.popBackStack() },
+        onNewVisitClick = { navController.navigate("newVisit/$patientId") },
+      )
+    }
+
+    composable(
+      route = "newVisit/{patientId}",
+      arguments = listOf(navArgument("patientId") { type = NavType.StringType }),
+    ) { backStackEntry ->
+      val patientId = backStackEntry.arguments?.getString("patientId").orEmpty()
+      val patient = uiState.patients.find { it.id == patientId }
+
+      NewVisitScreen(
+        patientName = patient?.name ?: "Patient",
+        questionnaireJson = uiState.questionnaireJson,
+        onBackClick = { navController.popBackStack() },
+        onSubmitResponse = { getResponse ->
+          scope.launch {
+            try {
+              val response = getResponse()
+              ancViewModel.saveVisit(patientId, response)
+              navController.popBackStack()
+            } catch (_: CancellationException) {
+              // Questionnaire validation failed; errors are displayed inline by DataCapture
+            }
+          }
+        },
+      )
+    }
+  }
+}
