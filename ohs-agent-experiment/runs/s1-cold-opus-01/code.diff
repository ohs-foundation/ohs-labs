+package com.example.ancapp.ui.visit
+
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.example.ancapp.data.AncRepository
+import com.example.ancapp.data.AncVisit
+import com.example.ancapp.data.DangerSign
+import com.example.ancapp.data.Patient
+import com.example.ancapp.domain.Gestation
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.launch
+import java.time.LocalDate
+
+data class VisitForm(
+  val visitDate: LocalDate = LocalDate.now(),
+  val gestationalAgeWeeks: String = "",
+  val weightKg: String = "",
+  val systolic: String = "",
+  val diastolic: String = "",
+  val dangerSigns: Set<DangerSign> = emptySet(),
+  val notes: String = "",
+)
+
+data class VisitFormErrors(
+  val visitDate: String? = null,
+  val gestationalAgeWeeks: String? = null,
+  val weightKg: String? = null,
+  val systolic: String? = null,
+  val diastolic: String? = null,
+) {
+  val isEmpty: Boolean
+    get() = visitDate == null && gestationalAgeWeeks == null && weightKg == null &&
+      systolic == null && diastolic == null
+}
+
+class RecordVisitViewModel(
+  private val repository: AncRepository,
+  private val patientId: Long,
+) : ViewModel() {
+
+  var patient by mutableStateOf<Patient?>(null)
+    private set
+
+  var form by mutableStateOf(VisitForm())
+    private set
+
+  /** Populated on the first save attempt, then kept live as the nurse corrects fields. */
+  var errors by mutableStateOf(VisitFormErrors())
+    private set
+
+  var isSaving by mutableStateOf(false)
+    private set
+
+  var savedVisitId by mutableStateOf<Long?>(null)
+    private set
+
+  private var validateEagerly = false
+
+  /** Once the nurse types a gestational age herself, we stop overwriting it. */
+  private var gestationEdited = false
+
+  init {
+    viewModelScope.launch {
+      val loaded = repository.observePatient(patientId).first()
+      patient = loaded
+      if (loaded != null) prefillGestation(loaded, form.visitDate)
+    }
+  }
+
+  fun onVisitDateChange(date: LocalDate) {
+    form = form.copy(visitDate = date)
+    patient?.let { prefillGestation(it, date) }
+    revalidate()
+  }
+
+  fun onGestationalAgeChange(value: String) {
+    gestationEdited = true
+    form = form.copy(gestationalAgeWeeks = value.filter(Char::isDigit).take(2))
+    revalidate()
+  }
+
+  fun onWeightChange(value: String) {
+    form = form.copy(weightKg = value.filterDecimal(maxIntegerDigits = 3))
+    revalidate()
+  }
+
+  fun onSystolicChange(value: String) {
+    form = form.copy(systolic = value.filter(Char::isDigit).take(3))
+    revalidate()
+  }
+
+  fun onDiastolicChange(value: String) {
+    form = form.copy(diastolic = value.filter(Char::isDigit).take(3))
+    revalidate()
+  }
+
+  fun onNotesChange(value: String) {
+    form = form.copy(notes = value)
+  }
+
+  /** Toggles one sign on or off. */
+  fun onDangerSignToggle(sign: DangerSign) {
+    val signs = form.dangerSigns
+    form = form.copy(
+      dangerSigns = if (sign in signs) signs - sign else signs + sign,
+    )
+  }
+
+  /** "None" is the absence of every other sign, so selecting it clears the lot. */
+  fun onNoDangerSigns() {
+    form = form.copy(dangerSigns = emptySet())
+  }
+
+  fun save() {
+    validateEagerly = true
+    val validated = validate(form)
+    errors = validated
+    if (!validated.isEmpty || isSaving) return
+
+    isSaving = true
+    viewModelScope.launch {
+      val id = repository.recordVisit(
+        AncVisit(
+          patientId = patientId,
+          visitDate = form.visitDate,
+          gestationalAgeWeeks = form.gestationalAgeWeeks.toInt(),
+          weightKg = form.weightKg.normalizeDecimal().toDouble(),
+          systolic = form.systolic.toInt(),
+          diastolic = form.diastolic.toInt(),
+          // Haemoglobin is not part of this form; it stays unrecorded for new visits.
+          hemoglobin = null,
+          dangerSigns = form.dangerSigns,
+          notes = form.notes.trim(),
+        )
+      )
+      isSaving = false
+      savedVisitId = id
+    }
+  }
+
+  private fun prefillGestation(patient: Patient, visitDate: LocalDate) {
+    if (gestationEdited) return
+    val weeks = Gestation.weeksOn(patient.estimatedDueDate, visitDate)
+    form = form.copy(gestationalAgeWeeks = weeks.toString())
+  }
+
+  private fun revalidate() {
+    if (validateEagerly) errors = validate(form)
+  }
+
+  private fun validate(form: VisitForm): VisitFormErrors {
+    val weeks = form.gestationalAgeWeeks.toIntOrNull()
+    val weight = form.weightKg.normalizeDecimal().toDoubleOrNull()
+    val systolic = form.systolic.toIntOrNull()
+    val diastolic = form.diastolic.toIntOrNull()
+
+    return VisitFormErrors(
+      visitDate = if (form.visitDate.isAfter(LocalDate.now())) "Visit date cannot be in the future" else null,
+      gestationalAgeWeeks = when {
+        form.gestationalAgeWeeks.isBlank() -> "Required"
+        weeks == null || weeks !in 1..45 -> "Enter 1–45 weeks"
+        else -> null
+      },
+      weightKg = when {
+        form.weightKg.isBlank() -> "Required"
+        weight == null || weight < 25.0 || weight > 250.0 -> "Enter 25–250 kg"
+        else -> null
+      },
+      systolic = when {
+        form.systolic.isBlank() -> "Required"
+        systolic == null || systolic !in 60..260 -> "Enter 60–260 mmHg"
+        else -> null
+      },
+      diastolic = when {
+        form.diastolic.isBlank() -> "Required"
+        diastolic == null || diastolic !in 30..200 -> "Enter 30–200 mmHg"
+        systolic != null && systolic in 60..260 && diastolic >= systolic ->
+          "Must be below systolic"
+        else -> null
+      },
+    )
+  }
+}
+
+/** Keeps digits and at most one decimal separator. */
+private fun String.filterDecimal(maxIntegerDigits: Int): String {
+  val normalized = normalizeDecimal()
+  val builder = StringBuilder()
+  var seenDot = false
+  var integerDigits = 0
+  var decimalDigits = 0
+  for (char in normalized) {
+    when {
+      char == '.' && !seenDot && builder.isNotEmpty() -> {
+        seenDot = true
+        builder.append(char)
+      }
+      char.isDigit() && !seenDot && integerDigits < maxIntegerDigits -> {
+        integerDigits++
+        builder.append(char)
+      }
+      char.isDigit() && seenDot && decimalDigits < 1 -> {
+        decimalDigits++
+        builder.append(char)
+      }
+    }
+  }
+  return builder.toString()
+}
+
+private fun String.normalizeDecimal(): String = replace(',', '.')
