+@Composable
+fun App() {
+  var patient by remember { mutableStateOf<Patient?>(null) }
+  var formOpen by remember { mutableStateOf(false) }
+  BackHandler(enabled = patient != null) {
+    if (formOpen) formOpen = false else patient = null
+  }
+  val p = patient
+  when {
+    p == null -> RegisterScreen(onOpen = { patient = it })
+    formOpen -> VisitFormScreen(p, onDone = { formOpen = false })
+    else -> DetailScreen(p, onBack = { patient = null }, onNewVisit = { formOpen = true })
+  }
+}
+
+@Composable
+fun RegisterScreen(onOpen: (Patient) -> Unit) {
+  var result by remember { mutableStateOf<Result<List<Patient>>?>(null) }
+  LaunchedEffect(Unit) { result = runCatching { withContext(Dispatchers.IO) { loadRegister() } } }
+  val today = LocalDate.now()
+  Scaffold(topBar = { TopAppBar(title = { Text("Pregnant patients") }) }) { pad ->
+    val modifier = Modifier.padding(pad).fillMaxSize()
+    when (val r = result) {
+      null -> Box(modifier, contentAlignment = Alignment.Center) { CircularProgressIndicator() }
+      else -> r.fold(
+        onSuccess = { patients ->
+          LazyColumn(modifier) {
+            items(patients) { p -> PatientRow(p, today, onClick = { onOpen(p) }) }
+          }
+        },
+        onFailure = { Text("Could not load patients: ${it.message}", color = MaterialTheme.colorScheme.error, modifier = modifier.padding(16.dp)) },
+      )
+    }
+  }
+}
+
+@Composable
+fun DetailScreen(p: Patient, onBack: () -> Unit, onNewVisit: () -> Unit) {
+  var result by remember { mutableStateOf<Result<List<Visit>>?>(null) }
+  LaunchedEffect(p.id) { result = runCatching { withContext(Dispatchers.IO) { loadVisits(p.id) } } }
+  val today = LocalDate.now()
+  Scaffold(
+    topBar = {
+      TopAppBar(
+        title = { Text(p.name) },
+        navigationIcon = { TextButton(onClick = onBack) { Text("Back") } },
+      )
+    },
+  ) { pad ->
+    LazyColumn(
+      Modifier.padding(pad).fillMaxSize(),
+      contentPadding = PaddingValues(16.dp),
+      verticalArrangement = Arrangement.spacedBy(8.dp),
+    ) {
+      item { Text("Age ${Period.between(p.birthDate, today).years} · Due ${p.dueDate} · ${gestation(p.dueDate, today)}") }
+      item { Button(onClick = onNewVisit, modifier = Modifier.fillMaxWidth()) { Text("New ANC visit") } }
+      item { Text("ANC visits", style = MaterialTheme.typography.titleMedium) }
+      when (val r = result) {
+        null -> item { CircularProgressIndicator() }
+        else -> r.fold(
+          onSuccess = { visits ->
+            if (visits.isEmpty()) item { Text("No visits recorded yet.") }
+            items(visits) { v -> VisitCard(v) }
+          },
+          onFailure = { item { Text("Could not load visits: ${it.message}", color = MaterialTheme.colorScheme.error) } },
+        )
+      }
+    }
+  }
+}
