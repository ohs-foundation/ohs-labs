+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun RegisterScreen(patients: List<Patient>, onOpen: (Patient) -> Unit) {
+  val today = LocalDate.now()
+  Scaffold(topBar = { TopAppBar(title = { Text("Pregnant patients") }) }) { padding ->
+    if (patients.isEmpty()) {
+      Text("No pregnant patients on file.", Modifier.padding(padding).padding(16.dp))
+    } else {
+      LazyColumn(Modifier.padding(padding)) {
+        items(patients, key = { it.id }) { p ->
+          ListItem(
+            headlineContent = { Text(p.name) },
+            supportingContent = {
+              Text("Age ${p.ageOn(today)} · Due ${p.dueDate} · ${p.gestationalWeeksOn(today)} weeks")
+            },
+            modifier = Modifier.clickable { onOpen(p) },
+          )
+          HorizontalDivider()
+        }
+      }
+    }
+  }
+}
