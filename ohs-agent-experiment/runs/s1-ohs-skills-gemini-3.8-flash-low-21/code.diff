+package com.example.ancapp
+
+import java.time.LocalDate
+import java.time.temporal.ChronoUnit
+
+data class PatientItem(
+  val id: String,
+  val name: String,
+  val birthDate: LocalDate?,
+  val age: Int?,
+  val estimatedDueDate: LocalDate?,
+  val currentWeeks: Int?
+)
+
+data class VisitItem(
+  val encounterId: String,
+  val date: LocalDate?,
+  val weightKg: String?,
+  val bloodPressure: String?,
+  val hemoglobin: String?,
+  val dangerSigns: List<String> = emptyList(),
+  val notes: String? = null
+)
+
+fun calculateGestationalAgeWeeks(edd: LocalDate, today: LocalDate = LocalDate.now()): Int {
+  val daysUntilDue = ChronoUnit.DAYS.between(today, edd)
+  val totalDays = 280 - daysUntilDue
+  return (totalDays / 7).toInt().coerceAtLeast(0)
+}
+
+fun calculateAge(birthDate: LocalDate, today: LocalDate = LocalDate.now()): Int {
+  return ChronoUnit.YEARS.between(birthDate, today).toInt()
+}
