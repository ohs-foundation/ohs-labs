+}
+
+@Composable
+fun App() {
+  val vm: AncViewModel = viewModel()
+  val nav = rememberNavController()
+  NavHost(nav, "register") {
+    composable("register") { Register(vm) { nav.navigate("patient/$it") } }
+    composable("patient/{id}") { e ->
+      val id = e.arguments!!.getString("id")!!
+      Detail(vm, id, onAdd = { nav.navigate("visit/$id") }, onBack = { nav.popBackStack() })
+    }
+    // Own destination = fresh ViewModelStoreOwner per open, so the form starts blank.
+    composable("visit/{id}") { e ->
+      val id = e.arguments!!.getString("id")!!
+      VisitForm(vm, id) { nav.popBackStack() }
+    }
+  }
+}
+
+@Composable
+fun Register(vm: AncViewModel, open: (String) -> Unit) {
+  val patients by vm.patients.collectAsState()
+  val sync by vm.syncState.collectAsState()
+  LaunchedEffect(Unit) { vm.refresh() }
+  Column(Modifier.statusBarsPadding().padding(16.dp)) {
+    Text("ANC Register", style = MaterialTheme.typography.headlineSmall)
+    Text(sync, style = MaterialTheme.typography.bodySmall)
+    if (patients.isEmpty()) Text("No patients yet", Modifier.padding(top = 16.dp))
+    LazyColumn {
+      items(patients) { p ->
+        Column(Modifier.fillMaxWidth().clickable { open(p.id) }.padding(vertical = 12.dp)) {
+          Text(p.name, style = MaterialTheme.typography.titleMedium)
+          Text("Age ${p.age ?: "?"} · Due ${p.edd ?: "?"} · ${p.weeks?.let { "$it weeks" } ?: "? weeks"}")
+        }
+        HorizontalDivider()
+      }
+    }
+  }
+}
+
+@Composable
+fun Detail(vm: AncViewModel, id: String, onAdd: () -> Unit, onBack: () -> Unit) {
+  val visits by vm.visits.collectAsState()
+  val name = vm.patients.collectAsState().value.firstOrNull { it.id == id }?.name.orEmpty()
+  LaunchedEffect(id) { vm.visits.value = emptyList(); vm.loadVisits(id) }
+  Column(Modifier.statusBarsPadding().padding(16.dp)) {
+    TextButton(onBack) { Text("← Back") }
+    Text(name, style = MaterialTheme.typography.headlineSmall)
+    Button(onAdd, Modifier.padding(vertical = 8.dp)) { Text("Record ANC visit") }
+    if (visits.isEmpty()) Text("No visits recorded")
+    LazyColumn {
+      items(visits) { v ->
+        Column(Modifier.fillMaxWidth().padding(vertical = 8.dp)) {
+          Text(v.date, style = MaterialTheme.typography.titleMedium)
+          Text(listOfNotNull(v.weight?.let { "Weight $it kg" }, v.bp?.let { "BP $it mmHg" }, v.hb?.let { "Hb $it g/dL" }).joinToString(" · "))
+        }
+        HorizontalDivider()
+      }
+    }
+  }
+}
+
+@Composable
+fun VisitForm(vm: AncViewModel, patientId: String, close: () -> Unit) {
+  val json by vm.questionnaireJson.collectAsState()
+  val scope = rememberCoroutineScope()
+  val q = json
+  if (q == null) {
+    Column(Modifier.statusBarsPadding().padding(16.dp)) {
+      Text("Visit form not downloaded yet. Connect to the server and try again.")
+      TextButton(close) { Text("Back") }
+    }
+    return
+  }
+  Box(Modifier.statusBarsPadding()) {
+    Questionnaire(
+      questionnaireJson = q,
+      onSubmit = { getResponse ->
+        scope.launch {
+          try {
+            vm.saveVisit(patientId, getResponse())
+            close()
+          } catch (e: CancellationException) {
+            // validation failed; form shows errors
+          }
+        }
+      },
+      onCancel = close,
+    )
   }
 }
