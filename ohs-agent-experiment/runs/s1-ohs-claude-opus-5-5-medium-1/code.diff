+
+/** Re-runs [load] whenever local data changes (save or sync). Null while loading. */
+@Composable
+private fun <T> localData(vararg keys: Any, load: suspend () -> T): T? {
+  val version by Anc.dataVersion.collectAsState()
+  return produceState<T?>(null, version, *keys) {
+    value = runCatching { load() }.onFailure { Log.e("Anc", "load failed", it) }.getOrNull()
+  }.value
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+private fun Screen(
+  title: String,
+  nav: NavController?,
+  actions: @Composable () -> Unit = {},
+  fab: @Composable () -> Unit = {},
+  content: @Composable (Modifier) -> Unit,
+) {
+  val error by Anc.syncError.collectAsState()
+  Scaffold(
+    topBar = {
+      TopAppBar(
+        title = { Text(title) },
+        navigationIcon = {
+          nav?.let {
+            IconButton(onClick = { it.popBackStack() }) { Icon(Icons.AutoMirrored.Filled.ArrowBack, "Back") }
+          }
+        },
+        actions = { actions() },
+      )
+    },
+    floatingActionButton = fab,
+  ) { pad ->
+    Column(Modifier.padding(pad).fillMaxSize()) {
+      error?.let { Text(it, color = MaterialTheme.colorScheme.error, modifier = Modifier.padding(horizontal = 16.dp)) }
+      content(Modifier.fillMaxSize())
+    }
+  }
+}
+
+@Composable
+private fun Loading() = Box(Modifier.fillMaxSize(), Alignment.Center) { CircularProgressIndicator() }
+
+private val dateFmt = DateTimeFormatter.ofPattern("d MMM yyyy")
+
+@Composable
+private fun RegisterScreen(nav: NavController) {
+  val patients = localData { Anc.patients() }
+  Screen(
+    "ANC register",
+    nav = null,
+    actions = { IconButton(onClick = { Anc.sync() }) { Icon(Icons.Default.Refresh, "Sync") } },
+  ) { mod ->
+    when {
+      patients == null -> Loading()
+      patients.isEmpty() -> Box(mod, Alignment.Center) { Text("No pregnant patients yet. Tap sync.") }
+      else ->
+        LazyColumn(mod) {
+          items(patients, key = { it.id }) { p ->
+            ListItem(
+              headlineContent = { Text(p.name) },
+              supportingContent = { Text("Age ${p.age} · Due ${p.edd.format(dateFmt)}") },
+              trailingContent = { Text("${p.gaDays / 7}w ${p.gaDays % 7}d", style = MaterialTheme.typography.titleMedium) },
+              modifier = Modifier.clickable { nav.navigate("patient/${p.id}") },
+            )
+            HorizontalDivider()
+          }
+        }
+    }
+  }
+}
+
+@Composable
+private fun PatientScreen(nav: NavController, id: String) {
+  val name = localData(id) { Anc.patientName(id) }
+  val visits = localData(id) { Anc.visits(id) }
+  Screen(
+    name ?: "",
+    nav,
+    fab = {
+      ExtendedFloatingActionButton(
+        text = { Text("Record visit") },
+        icon = { Icon(Icons.Default.Add, null) },
+        onClick = { nav.navigate("visit/$id") },
+      )
+    },
+  ) { mod ->
+    when {
+      visits == null -> Loading()
+      visits.isEmpty() -> Box(mod, Alignment.Center) { Text("No ANC visits recorded") }
+      else ->
+        LazyColumn(mod) {
+          items(visits) { v ->
+            ListItem(
+              headlineContent = { Text(v.date) },
+              supportingContent = {
+                Column {
+                  Text(
+                    listOfNotNull(
+                      v.gaWeeks?.let { "GA $it wk" },
+                      v.weightKg?.let { "Weight $it" },
+                      v.bp?.let { "BP $it" },
+                      v.hb?.let { "Hb $it" },
+                    ).joinToString(" · ")
+                  )
+                  if (v.dangerSigns.isNotEmpty()) Text("Danger signs: ${v.dangerSigns.joinToString()}", color = Color(0xFFB00020))
+                  v.notes?.let { Text(it, style = MaterialTheme.typography.bodySmall) }
+                }
+              },
+            )
+            HorizontalDivider()
+          }
+        }
+    }
+  }
+}
+
+@Composable
+private fun VisitFormScreen(nav: NavController, id: String) {
+  val questionnaire = localData { Anc.questionnaireJson() }
+  val scope = rememberCoroutineScope()
+  Screen("Record ANC visit", nav) { mod ->
+    if (questionnaire == null) {
+      Box(mod, Alignment.Center) { Text("Form not downloaded yet — sync with the server first.") }
+      return@Screen
+    }
+    Box(mod) {
+      Questionnaire(
+        questionnaireJson = questionnaire,
+        onSubmit = { getResponse ->
+          scope.launch {
+            Anc.saveVisit(id, getResponse())
+            nav.popBackStack()
+          }
+        },
+        onCancel = { nav.popBackStack() },
+      )
+    }
   }
 }
