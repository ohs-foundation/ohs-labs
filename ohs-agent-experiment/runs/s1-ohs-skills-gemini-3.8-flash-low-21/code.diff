@@ -0,0 +1,503 @@
+package com.example.ancapp
+
+import android.app.Application
+import android.util.Log
+import androidx.lifecycle.AndroidViewModel
+import androidx.lifecycle.viewModelScope
+import dev.ohs.fhir.engine.FhirEngine
+import dev.ohs.fhir.engine.FhirEngineProvider
+import dev.ohs.fhir.engine.get
+import dev.ohs.fhir.engine.search.ReferenceClientParam
+import dev.ohs.fhir.engine.search.Search
+import dev.ohs.fhir.engine.sync.CurrentSyncJobStatus
+import dev.ohs.fhir.engine.sync.Sync
+import dev.ohs.fhir.model.r4.Canonical
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.CodeableConcept
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.Date
+import dev.ohs.fhir.model.r4.DateTime
+import dev.ohs.fhir.model.r4.Decimal
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Enumeration
+import dev.ohs.fhir.model.r4.FhirDate
+import dev.ohs.fhir.model.r4.FhirDateTime
+import dev.ohs.fhir.model.r4.Integer
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Patient
+import dev.ohs.fhir.model.r4.Period
+import dev.ohs.fhir.model.r4.Quantity
+import dev.ohs.fhir.model.r4.Questionnaire
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import dev.ohs.fhir.model.r4.Reference
+import dev.ohs.fhir.model.r4.Resource
+import dev.ohs.fhir.model.r4.String as FhirString
+import dev.ohs.fhir.model.r4.Uri
+import dev.ohs.fhir.model.r4.terminologies.ResourceType
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.catch
+import kotlinx.coroutines.flow.transformWhile
+import kotlinx.coroutines.launch
+import kotlinx.serialization.json.Json
+import java.time.LocalDate
+import java.util.UUID
+import com.ionspin.kotlin.bignum.decimal.BigDecimal
+
+private fun CurrentSyncJobStatus.isFinal() =
+  this is CurrentSyncJobStatus.Succeeded ||
+    this is CurrentSyncJobStatus.Failed ||
+    this is CurrentSyncJobStatus.Cancelled
+
+class AncViewModel(app: Application) : AndroidViewModel(app) {
+  private val fhirEngine: FhirEngine = FhirEngineProvider.getInstance(app)
+
+  private val _patients = MutableStateFlow<List<PatientItem>>(emptyList())
+  val patients = _patients.asStateFlow()
+
+  private val _patientVisits = MutableStateFlow<List<VisitItem>>(emptyList())
+  val patientVisits = _patientVisits.asStateFlow()
+
+  private val _selectedPatient = MutableStateFlow<PatientItem?>(null)
+  val selectedPatient = _selectedPatient.asStateFlow()
+
+  private val _questionnaireJson = MutableStateFlow<String?>(null)
+  val questionnaireJson = _questionnaireJson.asStateFlow()
+
+  private val _syncStatus = MutableStateFlow<String?>("Not synced")
+  val syncStatus = _syncStatus.asStateFlow()
+
+  private val _isLoading = MutableStateFlow(false)
+  val isLoading = _isLoading.asStateFlow()
+
+  private var syncJob: Job? = null
+
+  private val json = Json {
+    explicitNulls = false
+    encodeDefaults = false
+    ignoreUnknownKeys = true
+  }
+
+  init {
+    loadLocalPatients()
+    syncNow()
+  }
+
+  fun syncNow() {
+    if (syncJob?.isActive == true) return
+    syncJob = viewModelScope.launch {
+      var ran = false
+      _isLoading.value = true
+      Sync.oneTimeSync<AncSyncWorker>(getApplication())
+        .transformWhile { emit(it); !it.isFinal() }
+        .catch { e ->
+          Log.e("AncViewModel", "Sync status error", e)
+          _syncStatus.value = "Sync status unknown"
+          _isLoading.value = false
+        }
+        .collect { status ->
+          _syncStatus.value = when (status) {
+            is CurrentSyncJobStatus.Enqueued ->
+              if (ran) "Waiting to retry" else "Waiting to sync"
+            is CurrentSyncJobStatus.Running -> {
+              ran = true
+              "Syncing…"
+            }
+            is CurrentSyncJobStatus.Succeeded -> {
+              _isLoading.value = false
+              loadLocalPatients()
+              _selectedPatient.value?.let { loadVisitsForPatient(it.id) }
+              "Synced"
+            }
+            is CurrentSyncJobStatus.Failed -> {
+              _isLoading.value = false
+              "Sync failed, offline mode"
+            }
+            else -> _syncStatus.value
+          }
+        }
+    }
+  }
+
+  fun loadLocalPatients() {
+    viewModelScope.launch {
+      try {
+        val patientResults = fhirEngine.search<Patient>(Search(ResourceType.Patient))
+        val eddResults = fhirEngine.search<Observation>(Search(ResourceType.Observation))
+
+        // Map EDD by patient id
+        val eddMap = mutableMapOf<String, LocalDate>()
+        eddResults.forEach { res ->
+          val obs = res.resource
+          val code = obs.code.coding.firstOrNull()?.code?.value
+          if (code == "11778-8") { // Delivery date Estimated
+            val pId = obs.subject?.reference?.value?.substringAfter("Patient/")
+            val eddString = obs.value?.asDateTime()?.value?.value?.toString()?.substringBefore("T")
+            if (pId != null && eddString != null) {
+              runCatching { LocalDate.parse(eddString) }.getOrNull()?.let {
+                eddMap[pId] = it
+              }
+            }
+          }
+        }
+
+        val items = patientResults.map { searchResult ->
+          val patient = searchResult.resource
+          val id = patient.id ?: ""
+          val name = patient.name.firstOrNull()
+          val fullName = listOfNotNull(
+            name?.given?.mapNotNull { it.value }?.joinToString(" "),
+            name?.family?.value
+          ).filter { it.isNotBlank() }.joinToString(" ")
+
+          val dobString = patient.birthDate?.value?.toString()
+          val dob = dobString?.let { runCatching { LocalDate.parse(it) }.getOrNull() }
+          val age = dob?.let { calculateAge(it) }
+
+          val edd = eddMap[id]
+          val weeks = edd?.let { calculateGestationalAgeWeeks(it) }
+
+          PatientItem(
+            id = id,
+            name = if (fullName.isNotBlank()) fullName else "Unknown",
+            birthDate = dob,
+            age = age,
+            estimatedDueDate = edd,
+            currentWeeks = weeks
+          )
+        }.sortedWith(compareBy(nullsLast()) { it.estimatedDueDate })
+
+        _patients.value = items
+      } catch (e: Exception) {
+        Log.e("AncViewModel", "Failed to load patients", e)
+      }
+    }
+  }
+
+  fun selectPatient(patient: PatientItem) {
+    _selectedPatient.value = patient
+    loadVisitsForPatient(patient.id)
+  }
+
+  fun loadVisitsForPatient(patientId: String) {
+    viewModelScope.launch {
+      try {
+        // Search Encounters for this patient
+        val encounters = fhirEngine.search<Encounter>(
+          Search(ResourceType.Encounter).apply {
+            filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+          }
+        ).map { it.resource }
+
+        // Search Observations for this patient
+        val observations = fhirEngine.search<Observation>(
+          Search(ResourceType.Observation).apply {
+            filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+          }
+        ).map { it.resource }
+
+        // Group observations by encounter reference
+        val obsByEncounter = observations.groupBy {
+          it.encounter?.reference?.value?.substringAfter("Encounter/") ?: ""
+        }
+
+        // Also search QuestionnaireResponses for this patient
+        val qrList = try {
+          fhirEngine.search<QuestionnaireResponse>(
+            Search(ResourceType.QuestionnaireResponse).apply {
+              filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+            }
+          ).map { it.resource }
+        } catch (e: Exception) {
+          emptyList<QuestionnaireResponse>()
+        }
+
+        val qrByEncounter = qrList.groupBy {
+          it.encounter?.reference?.value?.substringAfter("Encounter/") ?: ""
+        }
+
+        val visits = encounters.map { enc ->
+          val encId = enc.id ?: ""
+          val dateStr = enc.period?.start?.value?.toString()?.substringBefore("T")
+          val visitDate = dateStr?.let { runCatching { LocalDate.parse(it) }.getOrNull() }
+
+          val relatedObs = obsByEncounter[encId].orEmpty()
+          var weightStr: String? = null
+          var bpStr: String? = null
+          var hbStr: String? = null
+          val dangerSigns = mutableListOf<String>()
+          var notes: String? = null
+
+          for (obs in relatedObs) {
+            val code = obs.code.coding.firstOrNull()?.code?.value
+            when (code) {
+              "29463-7" -> { // Weight
+                val w = obs.value?.asQuantity()?.value?.value?.value?.toPlainString()
+                if (w != null) weightStr = "$w kg"
+              }
+              "85354-9" -> { // Blood pressure panel
+                val systolic = obs.component.firstOrNull { comp ->
+                  comp.code.coding.firstOrNull()?.code?.value == "8480-6"
+                }?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+
+                val diastolic = obs.component.firstOrNull { comp ->
+                  comp.code.coding.firstOrNull()?.code?.value == "8462-4"
+                }?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+
+                if (systolic != null && diastolic != null) {
+                  bpStr = "$systolic/$diastolic"
+                }
+              }
+              "718-7" -> { // Hemoglobin
+                val hb = obs.value?.asQuantity()?.value?.value?.value?.toPlainString()
+                if (hb != null) hbStr = "$hb g/dL"
+              }
+            }
+          }
+
+          // Check if QuestionnaireResponse has extra info (notes, danger signs)
+          val qr = qrByEncounter[encId]?.firstOrNull()
+          if (qr != null) {
+            val answers = mutableMapOf<String, MutableList<QuestionnaireResponse.Item.Answer>>()
+            fun collectAnswers(items: List<QuestionnaireResponse.Item>) {
+              items.forEach { item ->
+                item.linkId.value?.let { linkId ->
+                  answers.getOrPut(linkId) { mutableListOf() }.addAll(item.answer)
+                }
+                collectAnswers(item.item)
+                item.answer.forEach { collectAnswers(it.item) }
+              }
+            }
+            collectAnswers(qr.item)
+
+            notes = answers["notes"]?.firstOrNull()?.value?.asString()?.value?.value
+            val signs = answers["danger-signs"].orEmpty().mapNotNull {
+              it.value?.asCoding()?.value?.display?.value ?: it.value?.asCoding()?.value?.code?.value
+            }
+            dangerSigns.addAll(signs)
+          }
+
+          VisitItem(
+            encounterId = encId,
+            date = visitDate,
+            weightKg = weightStr,
+            bloodPressure = bpStr,
+            hemoglobin = hbStr,
+            dangerSigns = dangerSigns,
+            notes = notes
+          )
+        }.sortedWith(compareByDescending(nullsLast()) { it.date })
+
+        _patientVisits.value = visits
+      } catch (e: Exception) {
+        Log.e("AncViewModel", "Failed to load visits", e)
+      }
+    }
+  }
+
+  fun loadQuestionnaire() {
+    viewModelScope.launch {
+      try {
+        val questionnaire = try {
+          fhirEngine.get<Questionnaire>("anc-contact")
+        } catch (e: Exception) {
+          null
+        }
+
+        if (questionnaire != null) {
+          _questionnaireJson.value = json.encodeToString(questionnaire)
+        } else {
+          // If not in local db yet, try to search or wait for sync
+          val list = fhirEngine.search<Questionnaire>(Search(ResourceType.Questionnaire)).map { it.resource }
+          val q = list.firstOrNull { it.id == "anc-contact" } ?: list.firstOrNull()
+          if (q != null) {
+            _questionnaireJson.value = json.encodeToString(q)
+          }
+        }
+      } catch (e: Exception) {
+        Log.e("AncViewModel", "Failed to load questionnaire", e)
+      }
+    }
+  }
+
+  suspend fun saveAncVisit(patientId: String, response: QuestionnaireResponse) {
+    try {
+      val answers = mutableMapOf<String, MutableList<QuestionnaireResponse.Item.Answer>>()
+      fun collect(items: List<QuestionnaireResponse.Item>) {
+        items.forEach { item ->
+          item.linkId.value?.let { answers.getOrPut(it) { mutableListOf() }.addAll(item.answer) }
+          collect(item.item)
+          item.answer.forEach { collect(it.item) }
+        }
+      }
+      collect(response.item)
+
+      val visitDateStr = answers["visit-date"]?.firstOrNull()?.value?.asDate()?.value?.value?.toString()
+        ?: LocalDate.now().toString()
+      val weightVal = answers["weight"]?.firstOrNull()?.value?.asDecimal()?.value?.value
+      val bpSysVal = answers["bp-systolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+      val bpDiaVal = answers["bp-diastolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+
+      val encounterId = UUID.randomUUID().toString()
+      val encounterRef = Reference(reference = FhirString(value = "Encounter/$encounterId"))
+      val patientRef = Reference(reference = FhirString(value = "Patient/$patientId"))
+
+      val newResources = mutableListOf<Resource>()
+
+      val encounter = Encounter(
+        id = encounterId,
+        status = Enumeration(value = Encounter.EncounterStatus.Finished),
+        `class` = Coding(
+          system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"),
+          code = Code(value = "AMB"),
+          display = FhirString(value = "ambulatory")
+        ),
+        type = listOf(
+          CodeableConcept(
+            text = FhirString(value = "Antenatal care contact")
+          )
+        ),
+        subject = patientRef,
+        period = Period(
+          start = DateTime(value = FhirDateTime.fromString(visitDateStr)),
+          end = DateTime(value = FhirDateTime.fromString(visitDateStr))
+        )
+      )
+      newResources.add(encounter)
+
+      if (weightVal != null) {
+        val weightObs = Observation(
+          id = UUID.randomUUID().toString(),
+          status = Enumeration(value = Observation.ObservationStatus.Final),
+          category = listOf(
+            CodeableConcept(
+              coding = listOf(
+                Coding(
+                  system = Uri(value = "http://terminology.hl7.org/CodeSystem/observation-category"),
+                  code = Code(value = "vital-signs"),
+                  display = FhirString(value = "Vital Signs")
+                )
+              )
+            )
+          ),
+          code = CodeableConcept(
+            coding = listOf(
+              Coding(
+                system = Uri(value = "http://loinc.org"),
+                code = Code(value = "29463-7"),
+                display = FhirString(value = "Body weight")
+              )
+            ),
+            text = FhirString(value = "Body weight")
+          ),
+          subject = patientRef,
+          encounter = encounterRef,
+          effective = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(visitDateStr))),
+          value = Observation.Value.Quantity(
+            Quantity(
+              value = Decimal(value = weightVal),
+              unit = FhirString(value = "kg"),
+              system = Uri(value = "http://unitsofmeasure.org"),
+              code = Code(value = "kg")
+            )
+          )
+        )
+        newResources.add(weightObs)
+      }
+
+      if (bpSysVal != null && bpDiaVal != null) {
+        val bpObs = Observation(
+          id = UUID.randomUUID().toString(),
+          status = Enumeration(value = Observation.ObservationStatus.Final),
+          category = listOf(
+            CodeableConcept(
+              coding = listOf(
+                Coding(
+                  system = Uri(value = "http://terminology.hl7.org/CodeSystem/observation-category"),
+                  code = Code(value = "vital-signs"),
+                  display = FhirString(value = "Vital Signs")
+                )
+              )
+            )
+          ),
+          code = CodeableConcept(
+            coding = listOf(
+              Coding(
+                system = Uri(value = "http://loinc.org"),
+                code = Code(value = "85354-9"),
+                display = FhirString(value = "Blood pressure panel with all children optional")
+              )
+            ),
+            text = FhirString(value = "Blood pressure")
+          ),
+          subject = patientRef,
+          encounter = encounterRef,
+          effective = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(visitDateStr))),
+          component = listOf(
+            Observation.Component(
+              code = CodeableConcept(
+                coding = listOf(
+                  Coding(
+                    system = Uri(value = "http://loinc.org"),
+                    code = Code(value = "8480-6"),
+                    display = FhirString(value = "Systolic blood pressure")
+                  )
+                )
+              ),
+              value = Observation.Component.Value.Quantity(
+                Quantity(
+                  value = Decimal(value = BigDecimal.fromInt(bpSysVal)),
+                  unit = FhirString(value = "mmHg"),
+                  system = Uri(value = "http://unitsofmeasure.org"),
+                  code = Code(value = "mm[Hg]")
+                )
+              )
+            ),
+            Observation.Component(
+              code = CodeableConcept(
+                coding = listOf(
+                  Coding(
+                    system = Uri(value = "http://loinc.org"),
+                    code = Code(value = "8462-4"),
+                    display = FhirString(value = "Diastolic blood pressure")
+                  )
+                )
+              ),
+              value = Observation.Component.Value.Quantity(
+                Quantity(
+                  value = Decimal(value = BigDecimal.fromInt(bpDiaVal)),
+                  unit = FhirString(value = "mmHg"),
+                  system = Uri(value = "http://unitsofmeasure.org"),
+                  code = Code(value = "mm[Hg]")
+                )
+              )
+            )
+          )
+        )
+        newResources.add(bpObs)
+      }
+
+      val completedResponse = response.copy(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = QuestionnaireResponse.QuestionnaireResponseStatus.Completed),
+        subject = patientRef,
+        encounter = encounterRef,
+        questionnaire = Canonical(value = "http://example.org/fhir/Questionnaire/anc-contact")
+      )
+      newResources.add(completedResponse)
+
+      // Save all resources locally
+      fhirEngine.create(*newResources.toTypedArray())
+
+      // Refresh visits locally
+      loadVisitsForPatient(patientId)
+
+      // Trigger sync in background
+      syncNow()
+    } catch (e: Exception) {
+      Log.e("AncViewModel", "Failed to save ANC visit", e)
+      throw e
+    }
+  }
+}
