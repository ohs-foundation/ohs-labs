+package com.example.ancapp.data
+
+import android.content.Context
+import android.util.Log
+import com.example.ancapp.model.AncCalculations
+import com.example.ancapp.model.AncVisit
+import com.example.ancapp.model.PatientItem
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import org.json.JSONArray
+import org.json.JSONObject
+import java.time.LocalDate
+import java.util.UUID
+import java.util.concurrent.TimeUnit
+
+class FhirRepository(private val context: Context) {
+
+  private val client = OkHttpClient.Builder()
+    .connectTimeout(10, TimeUnit.SECONDS)
+    .readTimeout(10, TimeUnit.SECONDS)
+    .writeTimeout(10, TimeUnit.SECONDS)
+    .build()
+
+  private val baseUrl = "http://10.0.2.2:8080/fhir"
+  private val jsonMediaType = "application/fhir+json".toMediaType()
+
+  private val prefs = context.getSharedPreferences("anc_local_cache", Context.MODE_PRIVATE)
+
+  suspend fun getQuestionnaireJson(): String = withContext(Dispatchers.IO) {
+    try {
+      val request = Request.Builder()
+        .url("$baseUrl/Questionnaire/anc-contact")
+        .addHeader("Accept", "application/fhir+json")
+        .build()
+      val response = client.newCall(request).execute()
+      if (response.isSuccessful) {
+        val body = response.body?.string()
+        if (!body.isNullOrBlank()) {
+          // Cache to prefs
+          prefs.edit().putString("cached_questionnaire", body).apply()
+          return@withContext body
+        }
+      }
+    } catch (e: Exception) {
+      Log.w("FhirRepository", "Failed to fetch questionnaire from server, using fallback", e)
+    }
+
+    val cached = prefs.getString("cached_questionnaire", null)
+    if (!cached.isNullOrBlank()) {
+      return@withContext cached
+    }
+
+    // Fallback to asset
+    context.assets.open("anc-contact.json").bufferedReader().use { it.readText() }
+  }
+
+  suspend fun getPatients(): List<PatientItem> = withContext(Dispatchers.IO) {
+    try {
+      // 1. Fetch Patients
+      val patientRequest = Request.Builder()
+        .url("$baseUrl/Patient")
+        .addHeader("Accept", "application/fhir+json")
+        .build()
+      val patientResponse = client.newCall(patientRequest).execute()
+      val patientJsonStr = patientResponse.body?.string() ?: ""
+      val patientBundle = JSONObject(patientJsonStr)
+
+      // 2. Fetch Observations to extract EDD
+      val obsRequest = Request.Builder()
+        .url("$baseUrl/Observation?_count=200")
+        .addHeader("Accept", "application/fhir+json")
+        .build()
+      val obsResponse = client.newCall(obsRequest).execute()
+      val obsJsonStr = obsResponse.body?.string() ?: ""
+      val obsBundle = JSONObject(obsJsonStr)
+
+      val eddByPatient = mutableMapOf<String, String>()
+      val obsEntries = obsBundle.optJSONArray("entry") ?: JSONArray()
+      for (i in 0 until obsEntries.length()) {
+        val entry = obsEntries.optJSONObject(i)?.optJSONObject("resource") ?: continue
+        val codeCodings = entry.optJSONObject("code")?.optJSONArray("coding") ?: JSONArray()
+        var isEdd = false
+        for (j in 0 until codeCodings.length()) {
+          val coding = codeCodings.optJSONObject(j) ?: continue
+          if (coding.optString("code") == "11778-8") {
+            isEdd = true
+            break
+          }
+        }
+        val text = entry.optJSONObject("code")?.optString("text") ?: ""
+        if (text.contains("due date", ignoreCase = true) || text.contains("Estimated", ignoreCase = true)) {
+          isEdd = true
+        }
+
+        if (isEdd) {
+          val subjectRef = entry.optJSONObject("subject")?.optString("reference") ?: ""
+          val patId = subjectRef.removePrefix("Patient/")
+          val eddDate = entry.optString("valueDateTime", "")
+          if (patId.isNotBlank() && eddDate.isNotBlank()) {
+            eddByPatient[patId] = eddDate
+          }
+        }
+      }
+
+      val patientList = mutableListOf<PatientItem>()
+      val patientEntries = patientBundle.optJSONArray("entry") ?: JSONArray()
+      val today = LocalDate.now()
+
+      for (i in 0 until patientEntries.length()) {
+        val resource = patientEntries.optJSONObject(i)?.optJSONObject("resource") ?: continue
+        val id = resource.optString("id")
+        val names = resource.optJSONArray("name") ?: JSONArray()
+        var fullName = "Patient"
+        if (names.length() > 0) {
+          val nameObj = names.optJSONObject(0)
+          val givenArr = nameObj?.optJSONArray("given") ?: JSONArray()
+          val givenNames = (0 until givenArr.length()).map { givenArr.optString(it) }
+          val family = nameObj?.optString("family") ?: ""
+          fullName = (givenNames + family).filter { it.isNotBlank() }.joinToString(" ")
+        }
+
+        val birthDate = resource.optString("birthDate", "")
+        val edd = eddByPatient[id] ?: prefs.getString("edd_$id", "2026-12-31") ?: "2026-12-31"
+
+        // Cache edd for patient
+        prefs.edit().putString("edd_$id", edd).apply()
+
+        val age = AncCalculations.calculateAge(birthDate, today)
+        val weeks = AncCalculations.calculateGestationalWeeks(edd, today)
+
+        patientList.add(
+          PatientItem(
+            id = id,
+            name = fullName,
+            birthDate = birthDate,
+            age = age,
+            estimatedDueDate = edd,
+            weeksOfPregnancy = weeks
+          )
+        )
+      }
+
+      // Sort by due date (soonest first)
+      val sorted = patientList.sortedBy { it.estimatedDueDate }
+      // Cache patients
+      saveCachedPatients(sorted)
+      return@withContext sorted
+    } catch (e: Exception) {
+      Log.e("FhirRepository", "Error fetching patients from server", e)
+      val cached = getCachedPatients()
+      if (cached.isNotEmpty()) return@withContext cached
+
+      // Default baseline fallback if server is not reached yet
+      val defaultPatients = listOf(
+        PatientItem(
+          id = "anc-patient-3",
+          name = "Grace Thompson",
+          birthDate = "2001-07-30",
+          age = AncCalculations.calculateAge("2001-07-30"),
+          estimatedDueDate = "2026-10-15",
+          weeksOfPregnancy = AncCalculations.calculateGestationalWeeks("2026-10-15")
+        ),
+        PatientItem(
+          id = "anc-patient-1",
+          name = "Emily Carter",
+          birthDate = "1996-04-12",
+          age = AncCalculations.calculateAge("1996-04-12"),
+          estimatedDueDate = "2026-12-05",
+          weeksOfPregnancy = AncCalculations.calculateGestationalWeeks("2026-12-05")
+        ),
+        PatientItem(
+          id = "anc-patient-2",
+          name = "Sarah Mitchell",
+          birthDate = "1990-11-02",
+          age = AncCalculations.calculateAge("1990-11-02"),
+          estimatedDueDate = "2027-01-20",
+          weeksOfPregnancy = AncCalculations.calculateGestationalWeeks("2027-01-20")
+        )
+      ).sortedBy { it.estimatedDueDate }
+      return@withContext defaultPatients
+    }
+  }
+
+  suspend fun getVisitsForPatient(patientId: String): List<AncVisit> = withContext(Dispatchers.IO) {
+    val visitList = mutableListOf<AncVisit>()
+    try {
+      // 1. Fetch Encounters for patient
+      val encRequest = Request.Builder()
+        .url("$baseUrl/Encounter?subject=Patient/$patientId")
+        .addHeader("Accept", "application/fhir+json")
+        .build()
+      val encResponse = client.newCall(encRequest).execute()
+      val encBundle = JSONObject(encResponse.body?.string() ?: "")
+
+      // 2. Fetch Observations for patient
+      val obsRequest = Request.Builder()
+        .url("$baseUrl/Observation?subject=Patient/$patientId&_count=200")
+        .addHeader("Accept", "application/fhir+json")
+        .build()
+      val obsResponse = client.newCall(obsRequest).execute()
+      val obsBundle = JSONObject(obsResponse.body?.string() ?: "")
+
+      // 3. Fetch QuestionnaireResponses for patient
+      val qrRequest = Request.Builder()
+        .url("$baseUrl/QuestionnaireResponse?subject=Patient/$patientId&_count=200")
+        .addHeader("Accept", "application/fhir+json")
+        .build()
+      val qrResponse = client.newCall(qrRequest).execute()
+      val qrBundle = JSONObject(qrResponse.body?.string() ?: "")
+
+      val encEntries = encBundle.optJSONArray("entry") ?: JSONArray()
+      val obsEntries = obsBundle.optJSONArray("entry") ?: JSONArray()
+      val qrEntries = qrBundle.optJSONArray("entry") ?: JSONArray()
+
+      // Map observations by encounter ID
+      val obsByEncounter = mutableMapOf<String, MutableList<JSONObject>>()
+      for (i in 0 until obsEntries.length()) {
+        val obs = obsEntries.optJSONObject(i)?.optJSONObject("resource") ?: continue
+        val encRef = obs.optJSONObject("encounter")?.optString("reference") ?: ""
+        val encId = encRef.removePrefix("Encounter/")
+        if (encId.isNotBlank()) {
+          obsByEncounter.getOrPut(encId) { mutableListOf() }.add(obs)
+        }
+      }
+
+      // Map QuestionnaireResponses by encounter ID
+      val qrByEncounter = mutableMapOf<String, JSONObject>()
+      for (i in 0 until qrEntries.length()) {
+        val qr = qrEntries.optJSONObject(i)?.optJSONObject("resource") ?: continue
+        val encRef = qr.optJSONObject("encounter")?.optString("reference") ?: ""
+        val encId = encRef.removePrefix("Encounter/")
+        if (encId.isNotBlank()) {
+          qrByEncounter[encId] = qr
+        }
+      }
+
+      for (i in 0 until encEntries.length()) {
+        val enc = encEntries.optJSONObject(i)?.optJSONObject("resource") ?: continue
+        val encId = enc.optString("id")
+        val period = enc.optJSONObject("period")
+        val date = period?.optString("start") ?: enc.optString("actualPeriod", "2026-08-10")
+
+        val obsList = obsByEncounter[encId] ?: emptyList()
+        var weight: Double? = null
+        var systolic: Int? = null
+        var diastolic: Int? = null
+        var hemoglobin: Double? = null
+
+        for (obs in obsList) {
+          val code = obs.optJSONObject("code")?.optJSONArray("coding")?.optJSONObject(0)?.optString("code") ?: ""
+          when (code) {
+            "29463-7" -> { // Weight
+              val value = obs.optJSONObject("valueQuantity")?.optDouble("value")
+              if (value != null && !value.isNaN()) weight = value
+            }
+            "85354-9" -> { // BP panel
+              val components = obs.optJSONArray("component") ?: JSONArray()
+              for (c in 0 until components.length()) {
+                val comp = components.optJSONObject(c) ?: continue
+                val compCode = comp.optJSONObject("code")?.optJSONArray("coding")?.optJSONObject(0)?.optString("code")
+                val compVal = comp.optJSONObject("valueQuantity")?.optInt("value")
+                if (compCode == "8480-6") systolic = compVal
+                if (compCode == "8462-4") diastolic = compVal
+              }
+            }
+            "718-7" -> { // Hemoglobin
+              val value = obs.optJSONObject("valueQuantity")?.optDouble("value")
+              if (value != null && !value.isNaN()) hemoglobin = value
+            }
+          }
+        }
+
+        val qr = qrByEncounter[encId]
+        var gestAge: Int? = null
+        var dangerSigns: List<String> = emptyList()
+        var notes: String? = null
+
+        if (qr != null) {
+          val extracted = extractAnswersFromQr(qr)
+          gestAge = extracted["gestational-age"]?.firstOrNull()?.toString()?.toIntOrNull()
+          dangerSigns = extracted["danger-signs"]?.map { it.toString() } ?: emptyList()
+          notes = extracted["notes"]?.firstOrNull()?.toString()
+          if (weight == null) {
+            weight = extracted["weight"]?.firstOrNull()?.toString()?.toDoubleOrNull()
+          }
+          if (systolic == null) {
+            systolic = extracted["bp-systolic"]?.firstOrNull()?.toString()?.toIntOrNull()
+          }
+          if (diastolic == null) {
+            diastolic = extracted["bp-diastolic"]?.firstOrNull()?.toString()?.toIntOrNull()
+          }
+        }
+
+        visitList.add(
+          AncVisit(
+            id = encId,
+            encounterId = encId,
+            patientId = patientId,
+            date = date,
+            weightKg = weight,
+            systolicBp = systolic,
+            diastolicBp = diastolic,
+            hemoglobinGdl = hemoglobin,
+            gestationalAgeWeeks = gestAge,
+            dangerSigns = dangerSigns,
+            notes = notes
+          )
+        )
+      }
+    } catch (e: Exception) {
+      Log.e("FhirRepository", "Error fetching visits from server for $patientId", e)
+    }
+
+    // Merge with local visits
+    val localVisits = getLocalVisits(patientId)
+    val existingIds = visitList.map { it.id }.toSet()
+    for (local in localVisits) {
+      if (local.id !in existingIds && local.encounterId !in existingIds) {
+        visitList.add(local)
+      }
+    }
+
+    // Return visits sorted by date (newest first)
+    visitList.sortedByDescending { it.date }
+  }
+
+  suspend fun saveNewVisit(patientId: String, qr: dev.ohs.fhir.model.r4.QuestionnaireResponse): Result<AncVisit> = withContext(Dispatchers.IO) {
+    try {
+      var visitDate = LocalDate.now().toString()
+      var gestationalAge: Int? = null
+      var weight: Double? = null
+      var systolic: Int? = null
+      var diastolic: Int? = null
+      val dangerSigns = mutableListOf<String>()
+      var notes: String? = null
+
+      fun traverse(items: List<dev.ohs.fhir.model.r4.QuestionnaireResponse.Item>?) {
+        if (items == null) return
+        for (item in items) {
+          val linkId = item.linkId?.value ?: ""
+          for (ans in item.answer ?: emptyList()) {
+            val value = ans.value
+            when (linkId) {
+              "visit-date" -> {
+                val d = value?.asDate()?.value?.value?.toString()
+                if (!d.isNullOrBlank()) visitDate = d
+              }
+              "gestational-age" -> {
+                gestationalAge = value?.asInteger()?.value?.value
+              }
+              "weight" -> {
+                val dec = value?.asDecimal()?.value?.value
+                if (dec != null) {
+                  weight = dec.toString().toDoubleOrNull()
+                }
+              }
+              "bp-systolic" -> {
+                systolic = value?.asInteger()?.value?.value
+              }
+              "bp-diastolic" -> {
+                diastolic = value?.asInteger()?.value?.value
+              }
+              "danger-signs" -> {
+                val coding = value?.asCoding()?.value
+                val name = coding?.display?.value ?: coding?.code?.value
+                if (name != null) dangerSigns.add(name)
+              }
+              "notes" -> {
+                notes = value?.asString()?.value?.value
+              }
+            }
+            traverse(ans.item)
+          }
+          traverse(item.item)
+        }
+      }
+      traverse(qr.item)
+
+      var encId = "enc-${UUID.randomUUID().toString().take(8)}"
+
+      // 1. Create Encounter on server
+      try {
+        val encPayload = JSONObject().apply {
+          put("resourceType", "Encounter")
+          put("status", "finished")
+          put("class", JSONObject().apply {
+            put("system", "http://terminology.hl7.org/CodeSystem/v3-ActCode")
+            put("code", "AMB")
+            put("display", "ambulatory")
+          })
+          put("type", JSONArray().apply {
+            put(JSONObject().apply {
+              put("text", "Antenatal care contact")
+            })
+          })
+          put("subject", JSONObject().apply {
+            put("reference", "Patient/$patientId")
+          })
+          put("period", JSONObject().apply {
+            put("start", visitDate)
+            put("end", visitDate)
+          })
+        }
+
+        val encReq = Request.Builder()
+          .url("$baseUrl/Encounter")
+          .post(encPayload.toString().toRequestBody(jsonMediaType))
+          .addHeader("Content-Type", "application/fhir+json")
+          .addHeader("Accept", "application/fhir+json")
+          .build()
+
+        val encResp = client.newCall(encReq).execute()
+        if (encResp.isSuccessful) {
+          val respJson = JSONObject(encResp.body?.string() ?: "")
+          val serverEncId = respJson.optString("id")
+          if (serverEncId.isNotBlank()) {
+            encId = serverEncId
+          }
+        }
+      } catch (e: Exception) {
+        Log.e("FhirRepository", "Error posting Encounter to server", e)
+      }
+
+      // 2. Post Weight Observation if present
+      if (weight != null) {
+        try {
+          val weightPayload = JSONObject().apply {
+            put("resourceType", "Observation")
+            put("status", "final")
+            put("category", JSONArray().apply {
+              put(JSONObject().apply {
+                put("coding", JSONArray().apply {
+                  put(JSONObject().apply {
+                    put("system", "http://terminology.hl7.org/CodeSystem/observation-category")
+                    put("code", "vital-signs")
+                    put("display", "Vital Signs")
+                  })
+                })
+              })
+            })
+            put("code", JSONObject().apply {
+              put("coding", JSONArray().apply {
+                put(JSONObject().apply {
+                  put("system", "http://loinc.org")
+                  put("code", "29463-7")
+                  put("display", "Body weight")
+                })
+              })
+              put("text", "Body weight")
+            })
+            put("subject", JSONObject().apply { put("reference", "Patient/$patientId") })
+            put("encounter", JSONObject().apply { put("reference", "Encounter/$encId") })
+            put("effectiveDateTime", visitDate)
+            put("valueQuantity", JSONObject().apply {
+              put("value", weight)
+              put("unit", "kg")
+              put("system", "http://unitsofmeasure.org")
+              put("code", "kg")
+            })
+          }
+
+          val weightReq = Request.Builder()
+            .url("$baseUrl/Observation")
+            .post(weightPayload.toString().toRequestBody(jsonMediaType))
+            .addHeader("Content-Type", "application/fhir+json")
+            .build()
+          client.newCall(weightReq).execute()
+        } catch (e: Exception) {
+          Log.e("FhirRepository", "Error posting Weight Observation", e)
+        }
+      }
+
+      // 3. Post BP Observation if systolic or diastolic present
+      if (systolic != null || diastolic != null) {
+        try {
+          val bpPayload = JSONObject().apply {
+            put("resourceType", "Observation")
+            put("status", "final")
+            put("category", JSONArray().apply {
+              put(JSONObject().apply {
+                put("coding", JSONArray().apply {
+                  put(JSONObject().apply {
+                    put("system", "http://terminology.hl7.org/CodeSystem/observation-category")
+                    put("code", "vital-signs")
+                    put("display", "Vital Signs")
+                  })
+                })
+              })
+            })
+            put("code", JSONObject().apply {
+              put("coding", JSONArray().apply {
+                put(JSONObject().apply {
+                  put("system", "http://loinc.org")
+                  put("code", "85354-9")
+                  put("display", "Blood pressure panel with all children optional")
+                })
+              })
+              put("text", "Blood pressure")
+            })
+            put("subject", JSONObject().apply { put("reference", "Patient/$patientId") })
+            put("encounter", JSONObject().apply { put("reference", "Encounter/$encId") })
+            put("effectiveDateTime", visitDate)
+            put("component", JSONArray().apply {
+              if (systolic != null) {
+                put(JSONObject().apply {
+                  put("code", JSONObject().apply {
+                    put("coding", JSONArray().apply {
+                      put(JSONObject().apply {
+                        put("system", "http://loinc.org")
+                        put("code", "8480-6")
+                        put("display", "Systolic blood pressure")
+                      })
+                    })
+                  })
+                  put("valueQuantity", JSONObject().apply {
+                    put("value", systolic)
+                    put("unit", "mmHg")
+                    put("system", "http://unitsofmeasure.org")
+                    put("code", "mm[Hg]")
+                  })
+                })
+              }
+              if (diastolic != null) {
+                put(JSONObject().apply {
+                  put("code", JSONObject().apply {
+                    put("coding", JSONArray().apply {
+                      put(JSONObject().apply {
+                        put("system", "http://loinc.org")
+                        put("code", "8462-4")
+                        put("display", "Diastolic blood pressure")
+                      })
+                    })
+                  })
+                  put("valueQuantity", JSONObject().apply {
+                    put("value", diastolic)
+                    put("unit", "mmHg")
+                    put("system", "http://unitsofmeasure.org")
+                    put("code", "mm[Hg]")
+                  })
+                })
+              }
+            })
+          }
+
+          val bpReq = Request.Builder()
+            .url("$baseUrl/Observation")
+            .post(bpPayload.toString().toRequestBody(jsonMediaType))
+            .addHeader("Content-Type", "application/fhir+json")
+            .build()
+          client.newCall(bpReq).execute()
+        } catch (e: Exception) {
+          Log.e("FhirRepository", "Error posting BP Observation", e)
+        }
+      }
+
+      // 4. Construct and post QuestionnaireResponse
+      try {
+        val qrObj = JSONObject().apply {
+          put("resourceType", "QuestionnaireResponse")
+          put("status", "completed")
+          put("questionnaire", "http://example.org/fhir/Questionnaire/anc-contact")
+          put("subject", JSONObject().apply { put("reference", "Patient/$patientId") })
+          put("encounter", JSONObject().apply { put("reference", "Encounter/$encId") })
+          put("authored", visitDate)
+
+          val itemArr = JSONArray()
+          // visit-date
+          itemArr.put(JSONObject().apply {
+            put("linkId", "visit-date")
+            put("text", "Visit date")
+            put("answer", JSONArray().apply {
+              put(JSONObject().apply { put("valueDate", visitDate) })
+            })
+          })
+
+          // gestational-age
+          if (gestationalAge != null) {
+            itemArr.put(JSONObject().apply {
+              put("linkId", "gestational-age")
+              put("text", "Gestational age (weeks)")
+              put("answer", JSONArray().apply {
+                put(JSONObject().apply { put("valueInteger", gestationalAge) })
+              })
+            })
+          }
+
+          // vitals group
+          val vitalsItems = JSONArray()
+          if (weight != null) {
+            vitalsItems.put(JSONObject().apply {
+              put("linkId", "weight")
+              put("text", "Weight (kg)")
+              put("answer", JSONArray().apply {
+                put(JSONObject().apply { put("valueDecimal", weight) })
+              })
+            })
+          }
+          if (systolic != null) {
+            vitalsItems.put(JSONObject().apply {
+              put("linkId", "bp-systolic")
+              put("text", "Systolic blood pressure (mmHg)")
+              put("answer", JSONArray().apply {
+                put(JSONObject().apply { put("valueInteger", systolic) })
+              })
+            })
+          }
+          if (diastolic != null) {
+            vitalsItems.put(JSONObject().apply {
+              put("linkId", "bp-diastolic")
+              put("text", "Diastolic blood pressure (mmHg)")
+              put("answer", JSONArray().apply {
+                put(JSONObject().apply { put("valueInteger", diastolic) })
+              })
+            })
+          }
+          if (vitalsItems.length() > 0) {
+            itemArr.put(JSONObject().apply {
+              put("linkId", "vitals")
+              put("text", "Vital signs")
+              put("item", vitalsItems)
+            })
+          }
+
+          // danger-signs
+          if (dangerSigns.isNotEmpty()) {
+            val dsAns = JSONArray()
+            for (ds in dangerSigns) {
+              dsAns.put(JSONObject().apply {
+                put("valueCoding", JSONObject().apply {
+                  put("system", "urn:example:anc-danger-signs")
+                  put("code", ds.lowercase().replace(" ", "-"))
+                  put("display", ds)
+                })
+              })
+            }
+            itemArr.put(JSONObject().apply {
+              put("linkId", "danger-signs")
+              put("text", "Danger signs present")
+              put("answer", dsAns)
+            })
+          }
+
+          // notes
+          if (!notes.isNullOrBlank()) {
+            itemArr.put(JSONObject().apply {
+              put("linkId", "notes")
+              put("text", "Notes")
+              put("answer", JSONArray().apply {
+                put(JSONObject().apply { put("valueString", notes) })
+              })
+            })
+          }
+
+          put("item", itemArr)
+        }
+
+        val qrReq = Request.Builder()
+          .url("$baseUrl/QuestionnaireResponse")
+          .post(qrObj.toString().toRequestBody(jsonMediaType))
+          .addHeader("Content-Type", "application/fhir+json")
+          .build()
+        client.newCall(qrReq).execute()
+      } catch (e: Exception) {
+        Log.e("FhirRepository", "Error posting QuestionnaireResponse", e)
+      }
+
+      // 5. Construct and save AncVisit locally
+      val newVisit = AncVisit(
+        id = encId,
+        encounterId = encId,
+        patientId = patientId,
+        date = visitDate,
+        weightKg = weight,
+        systolicBp = systolic,
+        diastolicBp = diastolic,
+        hemoglobinGdl = null,
+        gestationalAgeWeeks = gestationalAge,
+        dangerSigns = dangerSigns,
+        notes = notes
+      )
+
+      saveLocalVisit(newVisit)
+      Result.success(newVisit)
+    } catch (e: Exception) {
+      Log.e("FhirRepository", "Failed to save visit", e)
+      Result.failure(e)
+    }
+  }
+
+  private fun extractAnswersFromQr(qrObj: JSONObject): Map<String, List<Any>> {
+    val result = mutableMapOf<String, MutableList<Any>>()
+
+    fun parseItem(item: JSONObject) {
+      val linkId = item.optString("linkId")
+      val answers = item.optJSONArray("answer")
+      if (answers != null && answers.length() > 0) {
+        val list = result.getOrPut(linkId) { mutableListOf() }
+        for (i in 0 until answers.length()) {
+          val ans = answers.optJSONObject(i) ?: continue
+          when {
+            ans.has("valueDate") -> list.add(ans.getString("valueDate"))
+            ans.has("valueInteger") -> list.add(ans.getInt("valueInteger"))
+            ans.has("valueDecimal") -> list.add(ans.getDouble("valueDecimal"))
+            ans.has("valueString") -> list.add(ans.getString("valueString"))
+            ans.has("valueCoding") -> {
+              val coding = ans.getJSONObject("valueCoding")
+              val display = coding.optString("display")
+              val code = coding.optString("code")
+              list.add(if (display.isNotBlank()) display else code)
+            }
+          }
+          // Check nested item in answer
+          val nestedInAns = ans.optJSONArray("item")
+          if (nestedInAns != null) {
+            for (j in 0 until nestedInAns.length()) {
+              nestedInAns.optJSONObject(j)?.let { parseItem(it) }
+            }
+          }
+        }
+      }
+
+      val nestedItems = item.optJSONArray("item")
+      if (nestedItems != null) {
+        for (k in 0 until nestedItems.length()) {
+          nestedItems.optJSONObject(k)?.let { parseItem(it) }
+        }
+      }
+    }
+
+    val items = qrObj.optJSONArray("item") ?: JSONArray()
+    for (i in 0 until items.length()) {
+      items.optJSONObject(i)?.let { parseItem(it) }
+    }
+
+    return result
+  }
+
+  private fun saveCachedPatients(patients: List<PatientItem>) {
+    val arr = JSONArray()
+    for (p in patients) {
+      val obj = JSONObject().apply {
+        put("id", p.id)
+        put("name", p.name)
+        put("birthDate", p.birthDate)
+        put("age", p.age)
+        put("estimatedDueDate", p.estimatedDueDate)
+        put("weeksOfPregnancy", p.weeksOfPregnancy)
+      }
+      arr.put(obj)
+    }
+    prefs.edit().putString("cached_patients", arr.toString()).apply()
+  }
+
+  private fun getCachedPatients(): List<PatientItem> {
+    val str = prefs.getString("cached_patients", null) ?: return emptyList()
+    return try {
+      val arr = JSONArray(str)
+      val list = mutableListOf<PatientItem>()
+      for (i in 0 until arr.length()) {
+        val o = arr.getJSONObject(i)
+        list.add(
+          PatientItem(
+            id = o.getString("id"),
+            name = o.getString("name"),
+            birthDate = o.optString("birthDate", ""),
+            age = o.getInt("age"),
+            estimatedDueDate = o.getString("estimatedDueDate"),
+            weeksOfPregnancy = o.getInt("weeksOfPregnancy")
+          )
+        )
+      }
+      list.sortedBy { it.estimatedDueDate }
+    } catch (e: Exception) {
+      emptyList()
+    }
+  }
+
+  private fun saveLocalVisit(visit: AncVisit) {
+    val key = "local_visits_${visit.patientId}"
+    val current = getLocalVisits(visit.patientId).toMutableList()
+    current.removeAll { it.id == visit.id }
+    current.add(0, visit)
+
+    val arr = JSONArray()
+    for (v in current) {
+      val o = JSONObject().apply {
+        put("id", v.id)
+        put("encounterId", v.encounterId)
+        put("patientId", v.patientId)
+        put("date", v.date)
+        v.weightKg?.let { put("weightKg", it) }
+        v.systolicBp?.let { put("systolicBp", it) }
+        v.diastolicBp?.let { put("diastolicBp", it) }
+        v.hemoglobinGdl?.let { put("hemoglobinGdl", it) }
+        v.gestationalAgeWeeks?.let { put("gestationalAgeWeeks", it) }
+        put("dangerSigns", JSONArray(v.dangerSigns))
+        v.notes?.let { put("notes", it) }
+      }
+      arr.put(o)
+    }
+    prefs.edit().putString(key, arr.toString()).apply()
+  }
+
+  private fun getLocalVisits(patientId: String): List<AncVisit> {
+    val key = "local_visits_$patientId"
+    val str = prefs.getString(key, null) ?: return emptyList()
+    return try {
+      val arr = JSONArray(str)
+      val list = mutableListOf<AncVisit>()
+      for (i in 0 until arr.length()) {
+        val o = arr.getJSONObject(i)
+        val dsArr = o.optJSONArray("dangerSigns") ?: JSONArray()
+        val dsList = (0 until dsArr.length()).map { dsArr.getString(it) }
+        list.add(
+          AncVisit(
+            id = o.getString("id"),
+            encounterId = o.optString("encounterId", o.getString("id")),
+            patientId = o.getString("patientId"),
+            date = o.getString("date"),
+            weightKg = if (o.has("weightKg")) o.getDouble("weightKg") else null,
+            systolicBp = if (o.has("systolicBp")) o.getInt("systolicBp") else null,
+            diastolicBp = if (o.has("diastolicBp")) o.getInt("diastolicBp") else null,
+            hemoglobinGdl = if (o.has("hemoglobinGdl")) o.getDouble("hemoglobinGdl") else null,
+            gestationalAgeWeeks = if (o.has("gestationalAgeWeeks")) o.getInt("gestationalAgeWeeks") else null,
+            dangerSigns = dsList,
+            notes = if (o.has("notes")) o.getString("notes") else null
+          )
+        )
+      }
+      list
+    } catch (e: Exception) {
+      emptyList()
+    }
+  }
+}
