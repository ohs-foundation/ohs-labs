+data class Row(val patient: Patient, val due: LocalDate?) {
+  val name get() = patient.name.firstOrNull()?.let { n -> (n.given.mapNotNull { it.value } + listOfNotNull(n.family?.value)).joinToString(" ") } ?: "?"
+  val age get() = patient.birthDate?.value?.toString()?.let { Period.between(LocalDate.parse(it), LocalDate.now()).years }
+  // weeks of pregnancy = 40 - weeks remaining until due date
+  val weeks get() = due?.let { 40 - ChronoUnit.WEEKS.between(LocalDate.now(), it).toInt() }
+}
+
+data class Visit(val date: String, val weight: String?, val bp: String?, val hb: String?)
+
+suspend fun FhirEngine.observationsOf(patientId: String) =
+  search<Observation>(Search(ResourceType.Observation).apply {
+    filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+  }).map { it.resource }
+
+fun Observation.loinc() = code.coding.firstOrNull { it.system?.value == "http://loinc.org" }?.code?.value
+fun Observation.qty() = value?.asQuantity()?.value?.value?.value?.toPlainString()
+
+suspend fun FhirEngine.loadRegister(): List<Row> =
+  search<Patient>(Search(ResourceType.Patient)).map { it.resource }.map { p ->
+    val edd = observationsOf(p.id!!).firstOrNull { it.loinc() == "11778-8" }
+      ?.value?.asDateTime()?.value?.value?.toString()?.substringBefore("T")
+    Row(p, edd?.let(LocalDate::parse))
+  }.sortedWith(compareBy(nullsLast()) { it.due })
+
+suspend fun FhirEngine.loadVisits(patientId: String): List<Visit> {
+  val obs = observationsOf(patientId)
+  val encounters = search<Encounter>(Search(ResourceType.Encounter).apply {
+    filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+  }).map { it.resource }
+  return encounters.map { e ->
+    val mine = obs.filter { it.encounter?.reference?.value == "Encounter/${e.id}" }
+    val bp = mine.firstOrNull { it.loinc() == "85354-9" }
+    fun comp(code: String) = bp?.component?.firstOrNull { c -> c.code.coding.any { it.code?.value == code } }?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+    Visit(
+      date = e.period?.start?.value?.toString()?.substringBefore("T") ?: "?",
+      weight = mine.firstOrNull { it.loinc() == "29463-7" }?.qty(),
+      bp = comp("8480-6")?.let { s -> "$s/${comp("8462-4") ?: "?"}" },
+      hb = mine.firstOrNull { it.loinc() == "718-7" }?.qty(),
+    )
+  }.sortedByDescending { it.date }
+}
 
 class MainActivity : ComponentActivity() {
   override fun onCreate(savedInstanceState: Bundle?) {
     super.onCreate(savedInstanceState)
-    setContent { MaterialTheme { Surface { Text("Hello") } } }
+    val engine = FhirEngineProvider.getInstance(applicationContext)
+    setContent { MaterialTheme { App(engine) } }
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun App(engine: FhirEngine) {
+  val nav = rememberNavController()
+  val scope = rememberCoroutineScope()
+  var syncTick by remember { mutableStateOf(0) }
+  var syncStatus by remember { mutableStateOf("Syncing…") }
+  fun sync() = scope.launch {
+    Sync.oneTimeSync<AppSyncWorker>(nav.context.applicationContext)
+      .catch { syncStatus = "Sync status unknown" }
+      .collect { s ->
+        syncStatus = s::class.simpleName ?: ""
+        syncTick++
+      }
+  }
+  LaunchedEffect(Unit) { sync() }
+
+  NavHost(nav, startDestination = "register") {
+    composable("register") {
+      var rows by remember { mutableStateOf<List<Row>>(emptyList()) }
+      LaunchedEffect(syncTick) { rows = engine.loadRegister() }
+      Scaffold(topBar = { TopAppBar(title = { Text("ANC Register") }) }) { pad ->
+        Column(Modifier.padding(pad).fillMaxSize()) {
+          Text("Sync: $syncStatus", Modifier.padding(16.dp, 4.dp), style = MaterialTheme.typography.labelSmall)
+          LazyColumn {
+            items(rows, key = { it.patient.id!! }) { r ->
+              Column(Modifier.fillMaxWidth().clickable { nav.navigate("patient/${r.patient.id}") }.padding(16.dp)) {
+                Text(r.name, style = MaterialTheme.typography.titleMedium)
+                Text("Age ${r.age ?: "?"} · Due ${r.due ?: "?"} · ${r.weeks?.let { "$it weeks" } ?: "? weeks"}")
+              }
+              HorizontalDivider()
+            }
+          }
+        }
+      }
+    }
+    composable("patient/{id}") { entry ->
+      val id = entry.arguments!!.getString("id")!!
+      var row by remember { mutableStateOf<Row?>(null) }
+      var visits by remember { mutableStateOf<List<Visit>>(emptyList()) }
+      LaunchedEffect(syncTick) {
+        row = engine.loadRegister().firstOrNull { it.patient.id == id }
+        visits = engine.loadVisits(id)
+      }
+      Scaffold(topBar = { TopAppBar(title = { Text(row?.name ?: "") }) }) { pad ->
+        Column(Modifier.padding(pad).fillMaxSize()) {
+          Button({ nav.navigate("visit/$id") }, Modifier.padding(16.dp)) { Text("Record ANC visit") }
+          LazyColumn {
+            items(visits) { v ->
+              Column(Modifier.fillMaxWidth().padding(16.dp)) {
+                Text(v.date, style = MaterialTheme.typography.titleMedium)
+                Text(listOfNotNull(v.weight?.let { "$it kg" }, v.bp?.let { "BP $it" }, v.hb?.let { "Hb $it g/dL" }).joinToString(" · "))
+              }
+              HorizontalDivider()
+            }
+          }
+        }
+      }
+    }
+    composable("visit/{id}") { entry ->
+      val id = entry.arguments!!.getString("id")!!
+      var json by remember { mutableStateOf<String?>(null) }
+      LaunchedEffect(Unit) {
+        json = runCatching { fhirJson.encodeToString(engine.get<Questionnaire>("anc-contact")) }.getOrNull() ?: ""
+      }
+      when (val j = json) {
+        null -> Text("Loading form…", Modifier.padding(16.dp))
+        "" -> Text("Visit form not downloaded yet. Check the server and retry.", Modifier.padding(16.dp))
+        else -> QuestionnaireForm(
+          questionnaireJson = j,
+          onSubmit = { getResponse ->
+            scope.launch {
+              try {
+                val r: QuestionnaireResponse = getResponse()
+                engine.saveVisit(id, r)
+                nav.popBackStack()
+                sync()
+              } catch (_: CancellationException) {}
+            }
+          },
+          onCancel = { nav.popBackStack() },
+        )
+      }
+    }
   }
 }
