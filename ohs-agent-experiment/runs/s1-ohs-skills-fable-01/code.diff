+
+private val dateFormat = DateTimeFormatter.ofPattern("d MMM yyyy")
+
+private fun LocalDate?.display(): String = this?.format(dateFormat) ?: "—"
+
+private sealed interface Screen {
+  data object Register : Screen
+  data class Detail(val patientId: String) : Screen
+  data class Form(val patientId: String) : Screen
+}
 
 class MainActivity : ComponentActivity() {
   override fun onCreate(savedInstanceState: Bundle?) {
     super.onCreate(savedInstanceState)
-    setContent { MaterialTheme { Surface { Text("Hello") } } }
+    setContent {
+      MaterialTheme {
+        Surface(modifier = Modifier.fillMaxSize()) { AncApp() }
+      }
+    }
+  }
+}
+
+@Composable
+private fun AncApp() {
+  val context = LocalContext.current
+  val repo = remember { AncRepository(context.applicationContext) }
+  var screen by remember { mutableStateOf<Screen>(Screen.Register) }
+  var initialSyncDone by remember { mutableStateOf(false) }
+
+  LaunchedEffect(Unit) {
+    repo.syncOnce()
+    initialSyncDone = true
+  }
+
+  when (val s = screen) {
+    is Screen.Register ->
+      RegisterScreen(repo, initialSyncDone, onOpenPatient = { screen = Screen.Detail(it) })
+    is Screen.Detail ->
+      PatientDetailScreen(
+        repo,
+        s.patientId,
+        onBack = { screen = Screen.Register },
+        onRecordVisit = { screen = Screen.Form(s.patientId) },
+      )
+    is Screen.Form ->
+      VisitFormScreen(repo, s.patientId, onClose = { screen = Screen.Detail(s.patientId) })
+  }
+}
+
+@Composable
+private fun RegisterScreen(
+  repo: AncRepository,
+  initialSyncDone: Boolean,
+  onOpenPatient: (String) -> Unit,
+) {
+  var patients by remember { mutableStateOf<List<RegisterPatient>?>(null) }
+
+  LaunchedEffect(initialSyncDone) {
+    val loaded = repo.loadRegister()
+    // Before the first sync finishes the local store may be empty; only show
+    // results early if something is already there.
+    if (initialSyncDone || loaded.isNotEmpty()) patients = loaded
+  }
+
+  Column(modifier = Modifier.fillMaxSize().padding(16.dp)) {
+    Text("ANC Register", style = MaterialTheme.typography.headlineSmall)
+    Text(
+      "Pregnant patients by due date",
+      style = MaterialTheme.typography.bodyMedium,
+      color = MaterialTheme.colorScheme.onSurfaceVariant,
+    )
+    Spacer(Modifier.height(16.dp))
+    when {
+      patients == null -> LoadingBox("Syncing with clinic server…")
+      patients!!.isEmpty() -> LoadingBox("No patients found.", showSpinner = false)
+      else ->
+        LazyColumn(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+          items(patients!!, key = { it.id }) { p ->
+            Card(modifier = Modifier.fillMaxWidth().clickable { onOpenPatient(p.id) }) {
+              Column(Modifier.padding(16.dp)) {
+                Text(p.name, style = MaterialTheme.typography.titleMedium)
+                Spacer(Modifier.height(4.dp))
+                Text(
+                  "Age ${p.ageYears?.toString() ?: "—"} · " +
+                    "${p.gestationWeeks?.let { "$it weeks pregnant" } ?: "GA unknown"}",
+                  style = MaterialTheme.typography.bodyMedium,
+                )
+                Text(
+                  "Due ${p.dueDate.display()}",
+                  style = MaterialTheme.typography.bodyMedium,
+                  color = MaterialTheme.colorScheme.primary,
+                )
+              }
+            }
+          }
+        }
+    }
+  }
+}
+
+@Composable
+private fun PatientDetailScreen(
+  repo: AncRepository,
+  patientId: String,
+  onBack: () -> Unit,
+  onRecordVisit: () -> Unit,
+) {
+  var patient by remember { mutableStateOf<RegisterPatient?>(null) }
+  var visits by remember { mutableStateOf<List<Visit>?>(null) }
+
+  BackHandler(onBack = onBack)
+  LaunchedEffect(patientId) {
+    patient = repo.loadPatient(patientId)
+    visits = repo.loadVisits(patientId)
+  }
+
+  Column(modifier = Modifier.fillMaxSize().padding(16.dp)) {
+    TextButton(onClick = onBack) { Text("← Register") }
+    Text(patient?.name ?: "Loading…", style = MaterialTheme.typography.headlineSmall)
+    patient?.let { p ->
+      Text(
+        "Age ${p.ageYears?.toString() ?: "—"} · Due ${p.dueDate.display()} · " +
+          "${p.gestationWeeks?.let { "$it weeks" } ?: "GA unknown"}",
+        style = MaterialTheme.typography.bodyMedium,
+        color = MaterialTheme.colorScheme.onSurfaceVariant,
+      )
+    }
+    Spacer(Modifier.height(12.dp))
+    Button(onClick = onRecordVisit, modifier = Modifier.fillMaxWidth()) {
+      Text("Record new ANC visit")
+    }
+    Spacer(Modifier.height(16.dp))
+    Text("Past visits", style = MaterialTheme.typography.titleMedium)
+    Spacer(Modifier.height(8.dp))
+    when {
+      visits == null -> LoadingBox("Loading visits…")
+      visits!!.isEmpty() -> LoadingBox("No visits recorded yet.", showSpinner = false)
+      else ->
+        LazyColumn(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+          items(visits!!, key = { it.encounterId }) { v -> VisitCard(v) }
+        }
+    }
+  }
+}
+
+@Composable
+private fun VisitCard(v: Visit) {
+  Card(modifier = Modifier.fillMaxWidth()) {
+    Column(Modifier.padding(16.dp)) {
+      Row(
+        modifier = Modifier.fillMaxWidth(),
+        horizontalArrangement = Arrangement.SpaceBetween,
+        verticalAlignment = Alignment.CenterVertically,
+      ) {
+        Text(v.date.display(), style = MaterialTheme.typography.titleSmall)
+        v.gestationalAgeWeeks?.let {
+          Text(
+            "$it wks GA",
+            style = MaterialTheme.typography.bodySmall,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+          )
+        }
+      }
+      HorizontalDivider(Modifier.padding(vertical = 8.dp))
+      VisitFact("Weight", v.weightKg?.let { "$it kg" })
+      VisitFact(
+        "Blood pressure",
+        if (v.systolic != null || v.diastolic != null)
+          "${v.systolic ?: "—"}/${v.diastolic ?: "—"} mmHg"
+        else null,
+      )
+      VisitFact("Hemoglobin", v.hemoglobin?.let { "$it g/dL" })
+      if (v.dangerSigns.isNotEmpty()) VisitFact("Danger signs", v.dangerSigns.joinToString(", "))
+      v.notes?.let { VisitFact("Notes", it) }
+    }
+  }
+}
+
+@Composable
+private fun VisitFact(label: String, value: String?) {
+  Row(modifier = Modifier.fillMaxWidth().padding(vertical = 2.dp)) {
+    Text(
+      label,
+      style = MaterialTheme.typography.bodyMedium,
+      color = MaterialTheme.colorScheme.onSurfaceVariant,
+      modifier = Modifier.fillMaxWidth(0.45f),
+    )
+    Text(value ?: "not recorded", style = MaterialTheme.typography.bodyMedium)
+  }
+}
+
+@Composable
+private fun VisitFormScreen(repo: AncRepository, patientId: String, onClose: () -> Unit) {
+  val scope = rememberCoroutineScope()
+  var questionnaireJson by remember { mutableStateOf<String?>(null) }
+  var loadFailed by remember { mutableStateOf(false) }
+  var saving by remember { mutableStateOf(false) }
+
+  BackHandler(onBack = onClose)
+  LaunchedEffect(Unit) {
+    val q = repo.questionnaireJson()
+    if (q == null) loadFailed = true else questionnaireJson = q
+  }
+
+  when {
+    saving -> LoadingBox("Saving visit…")
+    loadFailed ->
+      Column(Modifier.fillMaxSize().padding(16.dp)) {
+        Text("Visit form is not available yet — sync with the server and try again.")
+        Spacer(Modifier.height(8.dp))
+        TextButton(onClick = onClose) { Text("Back") }
+      }
+    questionnaireJson == null -> LoadingBox("Loading form…")
+    else ->
+      Questionnaire(
+        questionnaireJson = questionnaireJson!!,
+        onSubmit = { getResponse ->
+          scope.launch {
+            try {
+              val response = getResponse()
+              saving = true
+              repo.saveVisit(patientId, response)
+              onClose()
+            } catch (e: CancellationException) {
+              // Validation failed; the form is already showing per-question errors.
+              saving = false
+            }
+          }
+        },
+        onCancel = onClose,
+      )
+  }
+}
+
+@Composable
+private fun LoadingBox(message: String, showSpinner: Boolean = true) {
+  Box(modifier = Modifier.fillMaxSize().padding(24.dp), contentAlignment = Alignment.Center) {
+    Column(horizontalAlignment = Alignment.CenterHorizontally) {
+      if (showSpinner) {
+        CircularProgressIndicator()
+        Spacer(Modifier.height(12.dp))
+      }
+      Text(message, style = MaterialTheme.typography.bodyMedium)
+    }
   }
 }
