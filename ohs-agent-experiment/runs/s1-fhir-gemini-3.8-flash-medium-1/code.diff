+package com.example.ancapp.data.model
+
+data class AncVisit(
+    val id: String,
+    val encounterId: String?,
+    val date: String,
+    val gestationalAgeWeeks: Int?,
+    val weightKg: Double?,
+    val systolicBp: Int?,
+    val diastolicBp: Int?,
+    val hemoglobin: Double?,
+    val dangerSigns: List<String> = emptyList(),
+    val notes: String? = null
+) {
+    val bpString: String?
+        get() = if (systolicBp != null && diastolicBp != null) {
+            "$systolicBp/$diastolicBp"
+        } else if (systolicBp != null) {
+            "$systolicBp"
+        } else {
+            null
+        }
+
+    val weightString: String?
+        get() = weightKg?.let { "%.1f kg".format(it) }
+
+    val hemoglobinString: String?
+        get() = hemoglobin?.let { "%.1f g/dL".format(it) }
+}
+
+data class AncVisitInput(
+    val visitDate: String,
+    val gestationalAgeWeeks: Int?,
+    val weightKg: Double?,
+    val systolicBp: Int?,
+    val diastolicBp: Int?,
+    val dangerSigns: List<DangerSignOption>,
+    val notes: String?
+)
+
+data class DangerSignOption(
+    val code: String,
+    val display: String,
+    val system: String = "urn:example:anc-danger-signs"
+)
