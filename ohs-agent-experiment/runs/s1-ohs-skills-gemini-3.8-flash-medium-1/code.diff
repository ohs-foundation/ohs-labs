@@ -0,0 +1,67 @@
+package com.example.ancapp
+
+import android.app.Application
+import androidx.lifecycle.AndroidViewModel
+import androidx.lifecycle.viewModelScope
+import dev.ohs.fhir.engine.sync.CurrentSyncJobStatus
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.launch
+
+data class MainUiState(
+  val patients: List<PatientItem> = emptyList(),
+  val isLoading: Boolean = false,
+  val isSyncing: Boolean = false,
+  val syncMessage: String? = null,
+)
+
+class MainViewModel(application: Application) : AndroidViewModel(application) {
+  val repository = AncRepository(application)
+
+  private val _uiState = MutableStateFlow(MainUiState())
+  val uiState = _uiState.asStateFlow()
+
+  init {
+    loadPatients()
+    syncData()
+  }
+
+  fun loadPatients() {
+    viewModelScope.launch {
+      _uiState.value = _uiState.value.copy(isLoading = true)
+      try {
+        val list = repository.getPregnantPatients()
+        _uiState.value = _uiState.value.copy(patients = list, isLoading = false)
+      } catch (_: Exception) {
+        _uiState.value = _uiState.value.copy(isLoading = false)
+      }
+    }
+  }
+
+  fun syncData() {
+    viewModelScope.launch {
+      _uiState.value = _uiState.value.copy(isSyncing = true, syncMessage = "Syncing with server...")
+      try {
+        val terminal = repository.sync().first {
+          it is CurrentSyncJobStatus.Succeeded ||
+            it is CurrentSyncJobStatus.Failed ||
+            it is CurrentSyncJobStatus.Cancelled
+        }
+        val isSuccess = terminal is CurrentSyncJobStatus.Succeeded
+        val msg = if (isSuccess) "Synced with server" else "Sync failed"
+        _uiState.value = _uiState.value.copy(
+          isSyncing = false,
+          syncMessage = msg,
+        )
+        loadPatients()
+      } catch (e: Exception) {
+        _uiState.value = _uiState.value.copy(
+          isSyncing = false,
+          syncMessage = "Sync error: ${e.localizedMessage ?: "Unknown"}",
+        )
+        loadPatients()
+      }
+    }
+  }
+}
