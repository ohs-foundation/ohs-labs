+import com.example.ancapp.data.AncRepository
+import com.example.ancapp.data.PatientRow
+import com.example.ancapp.data.VisitRow
+import com.example.ancapp.ui.PatientDetailScreen
+import com.example.ancapp.ui.RecordVisitScreen
+import com.example.ancapp.ui.RegisterScreen
+import kotlinx.coroutines.launch
+
+private sealed interface Screen {
+  data object Register : Screen
+
+  data class PatientDetail(val patientId: String, val patientName: String) : Screen
+
+  data class RecordVisit(val patientId: String, val patientName: String) : Screen
+}
 
 class MainActivity : ComponentActivity() {
   override fun onCreate(savedInstanceState: Bundle?) {
     super.onCreate(savedInstanceState)
-    setContent { MaterialTheme { Surface { Text("Hello") } } }
+    val repository = AncRepository(applicationContext)
+    setContent { MaterialTheme { Surface { AncApp(repository) } } }
+  }
+}
+
+@Composable
+private fun AncApp(repository: AncRepository) {
+  val backStack = remember { mutableStateListOf<Screen>(Screen.Register) }
+  BackHandler(enabled = backStack.size > 1) { backStack.removeAt(backStack.lastIndex) }
+
+  var patients by remember { mutableStateOf<List<PatientRow>>(emptyList()) }
+  var patientsLoading by remember { mutableStateOf(true) }
+  var patientsRefreshKey by remember { mutableIntStateOf(0) }
+
+  var visits by remember { mutableStateOf<List<VisitRow>>(emptyList()) }
+  var visitsLoading by remember { mutableStateOf(true) }
+  var visitsRefreshKey by remember { mutableIntStateOf(0) }
+
+  val scope = rememberCoroutineScope()
+
+  LaunchedEffect(Unit) {
+    repository.syncNow()
+    patientsLoading = true
+    patients = repository.loadPatients()
+    patientsLoading = false
+  }
+
+  LaunchedEffect(patientsRefreshKey) {
+    if (patientsRefreshKey == 0) return@LaunchedEffect
+    patients = repository.loadPatients()
+  }
+
+  when (val current = backStack.last()) {
+    is Screen.Register -> {
+      RegisterScreen(
+        patients = patients,
+        isLoading = patientsLoading,
+        onPatientClick = { patient -> backStack.add(Screen.PatientDetail(patient.id, patient.name)) },
+      )
+    }
+    is Screen.PatientDetail -> {
+      LaunchedEffect(current.patientId, visitsRefreshKey) {
+        visitsLoading = true
+        visits = repository.loadVisits(current.patientId)
+        visitsLoading = false
+      }
+      PatientDetailScreen(
+        patientName = current.patientName,
+        visits = visits,
+        isLoading = visitsLoading,
+        onBack = { backStack.removeAt(backStack.lastIndex) },
+        onRecordVisit = { backStack.add(Screen.RecordVisit(current.patientId, current.patientName)) },
+      )
+    }
+    is Screen.RecordVisit -> {
+      RecordVisitScreen(
+        patientName = current.patientName,
+        loadQuestionnaireJson = { repository.loadQuestionnaireJson() },
+        onSaved = { response ->
+          scope.launch {
+            repository.saveVisit(current.patientId, response)
+            visitsRefreshKey++
+            patientsRefreshKey++
+            backStack.removeAt(backStack.lastIndex)
+          }
+        },
+        onCancel = { backStack.removeAt(backStack.lastIndex) },
+      )
+    }
   }
 }
diff --git a/app/src/main/java/com/example/ancapp/data/AncRepository.kt b/app/src/main/java/com/example/ancapp/data/AncRepository.kt
new file mode 100644
index 0000000..7b558d2
--- /dev/null
+++ b/app/src/main/java/com/example/ancapp/data/AncRepository.kt
@@ -0,0 +1,332 @@
+package com.example.ancapp.data
+
+import android.content.Context
+import android.util.Log
+import androidx.work.ExistingWorkPolicy
+import com.example.ancapp.sync.AncSyncWorker
+import com.ionspin.kotlin.bignum.decimal.BigDecimal
+import dev.ohs.fhir.engine.FhirEngine
+import dev.ohs.fhir.engine.FhirEngineProvider
+import dev.ohs.fhir.engine.get
+import dev.ohs.fhir.engine.search.DateClientParam
+import dev.ohs.fhir.engine.search.Order
+import dev.ohs.fhir.engine.search.ReferenceClientParam
+import dev.ohs.fhir.engine.search.search
+import dev.ohs.fhir.engine.sync.CurrentSyncJobStatus
+import dev.ohs.fhir.engine.sync.Sync
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.DateTime
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Enumeration
+import dev.ohs.fhir.model.r4.FhirDateTime
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Patient
+import dev.ohs.fhir.model.r4.Period
+import dev.ohs.fhir.model.r4.Questionnaire
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import dev.ohs.fhir.model.r4.Resource
+import dev.ohs.fhir.model.r4.Uri
+import java.util.UUID
+import kotlin.coroutines.cancellation.CancellationException
+import kotlin.time.Clock
+import kotlin.time.ExperimentalTime
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.launch
+import kotlinx.datetime.LocalDate
+import kotlinx.datetime.TimeZone
+import kotlinx.datetime.daysUntil
+import kotlinx.datetime.number
+import kotlinx.datetime.todayIn
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+
+private val fhirJson = Json {
+  explicitNulls = false
+  encodeDefaults = false
+  ignoreUnknownKeys = true
+}
+
+/**
+ * Reads/writes ANC data through the on-device FHIR engine, which is kept in sync with the
+ * clinic's HAPI server (the source of truth). Server sync failures (e.g. offline) still leave the
+ * engine's local copy readable and writable.
+ */
+class AncRepository(private val appContext: Context) {
+
+  private val backgroundScope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+
+  private val engine: FhirEngine
+    get() = FhirEngineProvider.getInstance(appContext)
+
+  @OptIn(ExperimentalTime::class)
+  private fun today(): LocalDate = Clock.System.todayIn(TimeZone.currentSystemDefault())
+
+  /**
+   * Pulls the latest Patients/Encounters/Observations/Questionnaires from the server. Sync is
+   * best-effort: if the server is unreachable (or the engine's sync-status tracking hiccups) the
+   * on-device engine still has whatever it last downloaded, so callers keep working offline.
+   */
+  suspend fun syncNow(): Boolean {
+    val terminal =
+      try {
+        Sync.oneTimeSync<AncSyncWorker>(appContext).first {
+          it is CurrentSyncJobStatus.Succeeded ||
+            it is CurrentSyncJobStatus.Failed ||
+            it is CurrentSyncJobStatus.Cancelled
+        }
+      } catch (e: CancellationException) {
+        throw e
+      } catch (e: Exception) {
+        Log.w("AncRepository", "syncNow failed", e)
+        null
+      }
+    return terminal is CurrentSyncJobStatus.Succeeded
+  }
+
+  private fun syncInBackground() {
+    backgroundScope.launch {
+      try {
+        Sync.oneTimeSync<AncSyncWorker>(
+            appContext,
+            existingWorkPolicy = ExistingWorkPolicy.APPEND_OR_REPLACE,
+          )
+          .first {
+            it is CurrentSyncJobStatus.Succeeded ||
+              it is CurrentSyncJobStatus.Failed ||
+              it is CurrentSyncJobStatus.Cancelled
+          }
+      } catch (e: CancellationException) {
+        throw e
+      } catch (e: Exception) {
+        // Uploaded resources stay queued locally; a later sync (e.g. next app start) retries.
+      }
+    }
+  }
+
+  suspend fun loadPatients(): List<PatientRow> {
+    val today = today()
+    return engine
+      .search<Patient> {}
+      .mapNotNull { result ->
+        val id = result.resource.id ?: return@mapNotNull null
+        val dueDate = findDueDate(id)
+        PatientRow(
+          id = id,
+          name = displayName(result.resource),
+          age = result.resource.birthDate.toLocalDate()?.let { ageInYears(it, today) },
+          dueDate = dueDate,
+          gestationalWeeks = dueDate?.let { gestationalWeeksFromDueDate(it, today) },
+        )
+      }
+      .sortedWith(compareBy(nullsLast()) { it.dueDate })
+  }
+
+  private suspend fun findDueDate(patientId: String): LocalDate? {
+    val observations =
+      engine
+        .search<Observation> { filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" }) }
+        .map { it.resource }
+    return observations.firstOrNull { it.hasLoinc("11778-8") }?.value?.asDateTime()?.value.toLocalDate()
+  }
+
+  suspend fun loadVisits(patientId: String): List<VisitRow> {
+    val encounters =
+      engine
+        .search<Encounter> {
+          filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+          sort(DateClientParam("date"), Order.DESCENDING)
+        }
+        .mapNotNull { result -> result.resource.id?.let { id -> result.resource to id } }
+
+    return encounters.map { (encounter, encId) ->
+      val observations =
+        engine
+          .search<Observation> { filter(ReferenceClientParam("encounter"), { value = "Encounter/$encId" }) }
+          .map { it.resource }
+
+      val bpObs = observations.firstOrNull { it.hasLoinc("85354-9") }
+      val systolic = bpObs?.component?.firstOrNull { loincCode(it.code) == "8480-6" }?.quantityValue()
+      val diastolic = bpObs?.component?.firstOrNull { loincCode(it.code) == "8462-4" }?.quantityValue()
+
+      val responses =
+        engine
+          .search<QuestionnaireResponse> {
+            filter(ReferenceClientParam("encounter"), { value = "Encounter/$encId" })
+          }
+          .map { it.resource }
+      val (dangerSigns, notes) = extractDangerSignsAndNotes(responses.firstOrNull())
+
+      VisitRow(
+        encounterId = encId,
+        date = encounter.period?.start.toLocalDate(),
+        gestationalAgeWeeks = observations.firstOrNull { it.hasLoinc("11884-4") }?.quantityValue()?.toPlainString(),
+        weightKg = observations.firstOrNull { it.hasLoinc("29463-7") }?.quantityValue()?.toPlainString(),
+        systolicMmHg = systolic?.toPlainString(),
+        diastolicMmHg = diastolic?.toPlainString(),
+        hemoglobinGdl = observations.firstOrNull { it.hasLoinc("718-7") }?.quantityValue()?.toPlainString(),
+        dangerSigns = dangerSigns,
+        notes = notes,
+      )
+    }
+  }
+
+  suspend fun loadQuestionnaireJson(): String {
+    val questionnaire = engine.get<Questionnaire>("anc-contact")
+    return fhirJson.encodeToString(questionnaire)
+  }
+
+  /** Persists a filled-in ANC visit form as an Encounter + vitals Observations + QuestionnaireResponse. */
+  suspend fun saveVisit(patientId: String, response: QuestionnaireResponse) {
+    val answers = flattenAnswers(response.item)
+    val visitDate = answers["visit-date"]?.firstOrNull()?.value?.asDate()?.value.toLocalDate() ?: today()
+    val gestationalAge = answers["gestational-age"]?.firstOrNull()?.value?.asInteger()?.value?.value
+    val weight = answers["weight"]?.firstOrNull()?.value?.asDecimal()?.value?.value
+    val systolic = answers["bp-systolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+    val diastolic = answers["bp-diastolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+
+    val encounterId = UUID.randomUUID().toString()
+    val patientRef = reference("Patient", patientId)
+    val encounterRef = reference("Encounter", encounterId)
+    val visitDateTime = DateTime(value = FhirDateTime.fromString(visitDate.toString()))
+
+    val encounterResource =
+      Encounter(
+        id = encounterId,
+        status = Enumeration(value = Encounter.EncounterStatus.Finished),
+        `class` =
+          Coding(
+            system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"),
+            code = Code(value = "AMB"),
+          ),
+        subject = patientRef,
+        period = Period(start = visitDateTime),
+      )
+
+    val resources = mutableListOf<Resource>(encounterResource)
+
+    if (weight != null) {
+      resources +=
+        Observation(
+          id = UUID.randomUUID().toString(),
+          status = Enumeration(value = Observation.ObservationStatus.Final),
+          code = loincConcept("29463-7", "Body weight"),
+          subject = patientRef,
+          encounter = encounterRef,
+          effective = Observation.Effective.DateTime(visitDateTime),
+          value = Observation.Value.Quantity(quantity(weight, "kg", "kg")),
+        )
+    }
+
+    if (systolic != null || diastolic != null) {
+      val components = mutableListOf<Observation.Component>()
+      if (systolic != null) {
+        components +=
+          Observation.Component(
+            code = loincConcept("8480-6", "Systolic blood pressure"),
+            value = Observation.Component.Value.Quantity(quantity(BigDecimal.fromInt(systolic), "mmHg", "mm[Hg]")),
+          )
+      }
+      if (diastolic != null) {
+        components +=
+          Observation.Component(
+            code = loincConcept("8462-4", "Diastolic blood pressure"),
+            value = Observation.Component.Value.Quantity(quantity(BigDecimal.fromInt(diastolic), "mmHg", "mm[Hg]")),
+          )
+      }
+      resources +=
+        Observation(
+          id = UUID.randomUUID().toString(),
+          status = Enumeration(value = Observation.ObservationStatus.Final),
+          code = loincConcept("85354-9", "Blood pressure panel with all children optional", "Blood pressure"),
+          subject = patientRef,
+          encounter = encounterRef,
+          effective = Observation.Effective.DateTime(visitDateTime),
+          component = components,
+        )
+    }
+
+    if (gestationalAge != null) {
+      resources +=
+        Observation(
+          id = UUID.randomUUID().toString(),
+          status = Enumeration(value = Observation.ObservationStatus.Final),
+          code = loincConcept("11884-4", "Gestational age Estimated", "Gestational age"),
+          subject = patientRef,
+          encounter = encounterRef,
+          effective = Observation.Effective.DateTime(visitDateTime),
+          value = Observation.Value.Quantity(quantity(BigDecimal.fromInt(gestationalAge), "weeks", "wk")),
+        )
+    }
+
+    val completedResponse =
+      response
+        .toBuilder()
+        .apply {
+          id = UUID.randomUUID().toString()
+          status = Enumeration(value = QuestionnaireResponse.QuestionnaireResponseStatus.Completed)
+          subject = patientRef.toBuilder()
+          encounter = encounterRef.toBuilder()
+        }
+        .build()
+    resources += completedResponse
+
+    engine.create(*resources.toTypedArray())
+    syncInBackground()
+  }
+}
+
+private fun displayName(patient: Patient): String {
+  val name = patient.name.firstOrNull() ?: return "Unknown"
+  val given = name.given.mapNotNull { it.value }.joinToString(" ")
+  val family = name.family?.value.orEmpty()
+  return listOf(given, family).filter { it.isNotBlank() }.joinToString(" ").ifBlank { "Unknown" }
+}
+
+private fun ageInYears(birthDate: LocalDate, today: LocalDate): Int {
+  var age = today.year - birthDate.year
+  if (
+    today.month.number < birthDate.month.number ||
+      (today.month.number == birthDate.month.number && today.day < birthDate.day)
+  ) {
+    age--
+  }
+  return age
+}
+
+private fun gestationalWeeksFromDueDate(dueDate: LocalDate, today: LocalDate): Int {
+  val gestationDays = 280 - today.daysUntil(dueDate)
+  return (gestationDays / 7).coerceIn(0, 42)
+}
+
+private fun extractDangerSignsAndNotes(response: QuestionnaireResponse?): Pair<List<String>, String?> {
+  if (response == null) return emptyList<String>() to null
+  val answers = flattenAnswers(response.item)
+  val dangerSigns =
+    answers["danger-signs"]
+      .orEmpty()
+      .mapNotNull { it.value?.asCoding()?.value }
+      .filter { it.code?.value != "none" }
+      .map { it.display?.value ?: it.code?.value ?: "" }
+      .filter { it.isNotBlank() }
+  val notes = answers["notes"]?.firstOrNull()?.value?.asString()?.value?.value
+  return dangerSigns to notes
+}
+
+private fun flattenAnswers(
+  items: List<QuestionnaireResponse.Item>
+): Map<String, List<QuestionnaireResponse.Item.Answer>> {
+  val result = mutableMapOf<String, MutableList<QuestionnaireResponse.Item.Answer>>()
+  fun collect(items: List<QuestionnaireResponse.Item>) {
+    items.forEach { item ->
+      item.linkId.value?.let { linkId -> result.getOrPut(linkId) { mutableListOf() }.addAll(item.answer) }
+      collect(item.item)
+      item.answer.forEach { collect(it.item) }
+    }
+  }
+  collect(items)
+  return result
+}
