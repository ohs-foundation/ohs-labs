+        verticalAlignment = Alignment.CenterVertically,
+      ) {
+        Row(verticalAlignment = Alignment.CenterVertically) {
+          Icon(
+            imageVector = Icons.Default.CalendarToday,
+            contentDescription = null,
+            tint = MaterialTheme.colorScheme.primary,
+            modifier = Modifier.size(18.dp),
+          )
+          Spacer(modifier = Modifier.width(8.dp))
+          Column {
+            Text(
+              text = visit.visitDate,
+              style = MaterialTheme.typography.titleMedium,
+              fontWeight = FontWeight.Bold,
+              color = MaterialTheme.colorScheme.onSurface,
+            )
+            Text(
+              text = "Visit Date",
+              style = MaterialTheme.typography.labelSmall,
+              color = MaterialTheme.colorScheme.onSurfaceVariant,
+            )
+          }
+        }
+
+        Surface(
+          shape = RoundedCornerShape(10.dp),
+          color = MaterialTheme.colorScheme.secondaryContainer,
+        ) {
+          Text(
+            text = "${visit.gestationalAgeWeeks} weeks GA",
+            style = MaterialTheme.typography.labelLarge,
+            fontWeight = FontWeight.SemiBold,
+            color = MaterialTheme.colorScheme.onSecondaryContainer,
+            modifier = Modifier.padding(horizontal = 10.dp, vertical = 5.dp),
+          )
+        }
+      }
+
+      Spacer(modifier = Modifier.height(12.dp))
+      HorizontalDivider(color = MaterialTheme.colorScheme.surfaceVariant)
+      Spacer(modifier = Modifier.height(12.dp))
+
+      // Vitals Grid: Weight, Blood Pressure, and Hemoglobin (if recorded)
+      Row(
+        modifier = Modifier.fillMaxWidth(),
+        horizontalArrangement = Arrangement.spacedBy(10.dp),
+      ) {
+        VitalMetricBox(
+          icon = Icons.Default.MonitorWeight,
+          label = "Weight",
+          value = visit.formattedWeight,
+          modifier = Modifier.weight(1f),
+        )
+
+        VitalMetricBox(
+          icon = Icons.Default.Favorite,
+          label = "BP (mmHg)",
+          value = visit.formattedBp,
+          isHighlightedWarning = visit.hasElevatedBp,
+          modifier = Modifier.weight(1f),
+        )
+
+        val formattedHb = visit.formattedHemoglobin
+        if (formattedHb != null) {
+          VitalMetricBox(
+            icon = Icons.Default.Opacity,
+            label = "Hemoglobin",
+            value = formattedHb,
+            isHighlightedWarning = visit.hasLowHemoglobin,
+            modifier = Modifier.weight(1f),
+          )
+        }
+      }
+
+      Spacer(modifier = Modifier.height(12.dp))
+
+      // Danger signs row
+      Row(
+        modifier = Modifier.fillMaxWidth(),
+        verticalAlignment = Alignment.CenterVertically,
+      ) {
+        if (visit.dangerSigns.isEmpty()) {
+          Surface(
+            shape = RoundedCornerShape(8.dp),
+            color = ClinicSuccessContainer,
+          ) {
+            Row(
+              modifier = Modifier.padding(horizontal = 10.dp, vertical = 5.dp),
+              verticalAlignment = Alignment.CenterVertically,
+            ) {
+              Icon(
+                imageVector = Icons.Default.CheckCircle,
+                contentDescription = null,
+                tint = ClinicSuccessGreen,
+                modifier = Modifier.size(15.dp),
+              )
+              Spacer(modifier = Modifier.width(6.dp))
+              Text(
+                text = "Danger signs: None",
+                style = MaterialTheme.typography.labelMedium,
+                fontWeight = FontWeight.Medium,
+                color = ClinicSuccessGreen,
+              )
+            }
+          }
+        } else {
+          Column(modifier = Modifier.fillMaxWidth()) {
+            Row(verticalAlignment = Alignment.CenterVertically) {
+              Icon(
+                imageVector = Icons.Default.Warning,
+                contentDescription = null,
+                tint = ClinicDangerRed,
+                modifier = Modifier.size(16.dp),
+              )
+              Spacer(modifier = Modifier.width(6.dp))
+              Text(
+                text = "Danger Signs Reported:",
+                style = MaterialTheme.typography.labelMedium,
+                fontWeight = FontWeight.Bold,
+                color = ClinicDangerRed,
+              )
+            }
+            Spacer(modifier = Modifier.height(6.dp))
+            FlowRow(
+              horizontalArrangement = Arrangement.spacedBy(6.dp),
+              verticalArrangement = Arrangement.spacedBy(6.dp),
+            ) {
+              visit.dangerSigns.forEach { sign ->
+                Surface(
+                  shape = RoundedCornerShape(8.dp),
+                  color = ClinicDangerContainer,
+                ) {
+                  Text(
+                    text = sign.displayName,
+                    style = MaterialTheme.typography.labelMedium,
+                    fontWeight = FontWeight.SemiBold,
+                    color = ClinicDangerRed,
+                    modifier = Modifier.padding(horizontal = 10.dp, vertical = 4.dp),
+                  )
+                }
+              }
+            }
+          }
+        }
+      }
+
+      // Free-text notes if present
+      if (visit.notes.isNotBlank()) {
+        Spacer(modifier = Modifier.height(10.dp))
+        Surface(
+          shape = RoundedCornerShape(10.dp),
+          color = MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.7f),
+          modifier = Modifier.fillMaxWidth(),
+        ) {
+          Row(
+            modifier = Modifier.padding(10.dp),
+            verticalAlignment = Alignment.Top,
+          ) {
+            Icon(
+              imageVector = Icons.Default.Description,
+              contentDescription = null,
+              tint = MaterialTheme.colorScheme.onSurfaceVariant,
+              modifier = Modifier.size(16.dp).padding(top = 2.dp),
+            )
+            Spacer(modifier = Modifier.width(8.dp))
+            Column {
+              Text(
+                text = "Clinical Notes",
+                style = MaterialTheme.typography.labelSmall,
+                fontWeight = FontWeight.SemiBold,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+              )
+              Text(
+                text = visit.notes,
+                style = MaterialTheme.typography.bodyMedium,
+                color = MaterialTheme.colorScheme.onSurface,
+              )
+            }
+          }
+        }
+      }
+    }
+  }
+}
