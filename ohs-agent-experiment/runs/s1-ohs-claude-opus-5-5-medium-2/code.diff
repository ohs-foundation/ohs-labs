+package com.example.ancapp
+
+import android.app.Application
+import dev.ohs.fhir.datacapture.DataCapture
+import dev.ohs.fhir.engine.FhirEngine
+import dev.ohs.fhir.engine.FhirEngineConfiguration
+import dev.ohs.fhir.engine.FhirEngineProvider
+import dev.ohs.fhir.engine.ServerConfiguration
+import dev.ohs.fhir.engine.search.ReferenceClientParam
+import dev.ohs.fhir.engine.search.search
+import dev.ohs.fhir.engine.sync.AcceptRemoteConflictResolver
+import dev.ohs.fhir.engine.sync.FhirSyncTask
+import dev.ohs.fhir.engine.sync.SyncJobStatus
+import dev.ohs.fhir.engine.sync.download.ResourceParamsBasedDownloadWorkManager
+import dev.ohs.fhir.engine.sync.runSync
+import dev.ohs.fhir.engine.sync.upload.HttpCreateMethod
+import dev.ohs.fhir.engine.sync.upload.HttpUpdateMethod
+import dev.ohs.fhir.engine.sync.upload.UploadStrategy
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Patient
+import dev.ohs.fhir.model.r4.Questionnaire
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import dev.ohs.fhir.model.r4.Resource
+import dev.ohs.fhir.model.r4.terminologies.ResourceType
+import java.time.LocalDate
+import java.time.Period
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonElement
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.encodeToJsonElement
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.put
+import kotlinx.serialization.json.putJsonArray
+import kotlinx.serialization.json.putJsonObject
+
+const val SERVER_URL = "http://10.0.2.2:8080/fhir/"
+const val QUESTIONNAIRE_ID = "anc-contact"
+private const val LOINC = "http://loinc.org"
+private const val EDD = "11778-8"
+private const val WEIGHT = "29463-7"
+private const val BP = "85354-9"
+private const val SYSTOLIC = "8480-6"
+private const val DIASTOLIC = "8462-4"
+private const val HB = "718-7"
+private const val GEST_AGE = "18185-9"
+
+val json = Json {
+  explicitNulls = false
+  encodeDefaults = false
+}
+
+class AncApplication : Application() {
+  override fun onCreate() {
+    super.onCreate()
+    FhirEngineProvider.init(
+      FhirEngineConfiguration(serverConfiguration = ServerConfiguration(SERVER_URL)),
+      this,
+    )
+    DataCapture.initialize(this)
+  }
+}
+
+val engine: FhirEngine
+  get() = FhirEngineProvider.getInstance()
+
+/** Server is the source of truth: push local visits, then pull everything ANC-related. */
+object AncSync : FhirSyncTask {
+  override fun getFhirEngine() = engine
+
+  // ponytail: no last-updated tracking, full re-download each sync; fine for a small clinic.
+  override fun getDownloadWorkManager() =
+    ResourceParamsBasedDownloadWorkManager(
+      mapOf(
+        ResourceType.Patient to mapOf("_count" to "100"),
+        ResourceType.Encounter to mapOf("_count" to "100"),
+        ResourceType.Observation to mapOf("_count" to "100"),
+        ResourceType.Questionnaire to mapOf("_id" to QUESTIONNAIRE_ID),
+      ),
+      object : ResourceParamsBasedDownloadWorkManager.TimestampContext {
+        override suspend fun saveLastUpdatedTimestamp(resourceType: ResourceType, timestamp: String?) {}
+
+        override suspend fun getLasUpdateTimestamp(resourceType: ResourceType): String? = null
+      },
+    )
+
+  override fun getConflictResolver() = AcceptRemoteConflictResolver
+
+  // Individual PUTs with client-assigned ids keep Observation -> Encounter references intact.
+  // (Bundle upload emits relative fullUrls, which this server's validator rejects.)
+  override fun getUploadStrategy() =
+    UploadStrategy.forIndividualRequest(HttpCreateMethod.PUT, HttpUpdateMethod.PATCH, true)
+
+  suspend fun sync(): Boolean = runSync("anc-sync") {} is SyncJobStatus.Succeeded
+}
+
+data class PatientRow(val id: String, val name: String, val age: Int, val edd: LocalDate, val weeks: Int)
+
+data class Visit(val date: String, val weight: String?, val bp: String?, val hb: String?)
+
+private fun Observation.isCode(code: String) = this.code.coding.any { it.code?.value == code }
+
+private fun Observation.quantity() =
+  value?.asQuantity()?.value?.let { q -> "${q.value?.value?.toStringExpanded()} ${q.unit?.value ?: ""}".trim() }
+
+private fun Observation.component(code: String) =
+  component.firstOrNull { c -> c.code.coding.any { it.code?.value == code } }
+    ?.value?.asQuantity()?.value?.value?.value?.intValue(false)
+
+private suspend fun observationsOf(patientId: String) =
+  engine.search<Observation> {
+    filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+  }.map { it.resource }
+
+/** Currently pregnant = has an EDD that is not more than 2 weeks overdue. Soonest due first. */
+suspend fun loadRegister(today: LocalDate = LocalDate.now()): List<PatientRow> =
+  engine.search<Patient> {}
+    .mapNotNull { r ->
+      val p = r.resource
+      val id = p.id ?: return@mapNotNull null
+      val edd =
+        observationsOf(id)
+          .filter { it.isCode(EDD) }
+          .maxByOrNull { it.effective?.asDateTime()?.value?.value.toString() }
+          ?.value?.asDateTime()?.value?.value
+          ?.let { LocalDate.parse(it.toString().take(10)) } ?: return@mapNotNull null
+      if (today.isAfter(edd.plusWeeks(2))) return@mapNotNull null
+      val name = p.name.firstOrNull()
+      PatientRow(
+        id = id,
+        name = listOfNotNull(name?.given?.joinToString(" ") { it.value.orEmpty() }, name?.family?.value).joinToString(" "),
+        age = p.birthDate?.value?.let { Period.between(LocalDate.parse(it.toString()), today).years } ?: 0,
+        edd = edd,
+        weeks = ((280 - ChronoUnit.DAYS.between(today, edd)) / 7).toInt(),
+      )
+    }
+    .sortedBy { it.edd }
+
+suspend fun loadVisits(patientId: String): List<Visit> {
+  val obs = observationsOf(patientId).groupBy { it.encounter?.reference?.value }
+  return engine.search<Encounter> {
+    filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+  }
+    .map { it.resource }
+    .map { enc ->
+      val o = obs["Encounter/${enc.id}"].orEmpty()
+      val bp = o.firstOrNull { it.isCode(BP) }
+      Visit(
+        date = enc.period?.start?.value?.toString()?.take(10) ?: "?",
+        weight = o.firstOrNull { it.isCode(WEIGHT) }?.quantity(),
+        bp = bp?.let { "${it.component(SYSTOLIC) ?: "?"}/${it.component(DIASTOLIC) ?: "?"} mmHg" },
+        hb = o.firstOrNull { it.isCode(HB) }?.quantity(),
+      )
+    }
+    .sortedByDescending { it.date }
+}
+
+suspend fun loadQuestionnaireJson(): String? =
+  runCatching { engine.get(ResourceType.Questionnaire, QUESTIONNAIRE_ID) as Questionnaire }
+    .getOrNull()
+    ?.let { json.encodeToString<Resource>(it) }
+
+/** Maps the anc-contact response to an Encounter + Observations shaped like the server's data. */
+suspend fun saveVisit(patientId: String, response: QuestionnaireResponse) {
+  val answers = mutableMapOf<String, List<JsonObject>>()
+  fun walk(items: JsonElement?) {
+    items?.jsonArray?.forEach { item ->
+      val o = item.jsonObject
+      val linkId = o["linkId"]!!.jsonPrimitive.content
+      o["answer"]?.jsonArray?.let { a -> answers[linkId] = a.map { it.jsonObject } }
+      walk(o["item"])
+    }
+  }
+  val qr = json.encodeToJsonElement<Resource>(response).jsonObject
+  walk(qr["item"])
+  fun first(linkId: String, key: String) = answers[linkId]?.firstOrNull()?.get(key)?.jsonPrimitive
+
+  val date = first("visit-date", "valueDate")?.content ?: LocalDate.now().toString()
+  val subject = buildJsonObject { put("reference", "Patient/$patientId") }
+  val encId = UUID.randomUUID().toString()
+  val encRef = buildJsonObject { put("reference", "Encounter/$encId") }
+
+  fun coding(code: String, display: String) = buildJsonObject {
+    putJsonArray("coding") { add(buildJsonObject { put("system", LOINC); put("code", code); put("display", display) }) }
+    put("text", display)
+  }
+  fun quantity(v: JsonPrimitive, unit: String, ucum: String) = buildJsonObject {
+    put("value", v); put("unit", unit); put("system", "http://unitsofmeasure.org"); put("code", ucum)
+  }
+  fun observation(code: String, display: String, body: kotlinx.serialization.json.JsonObjectBuilder.() -> Unit) =
+    buildJsonObject {
+      put("resourceType", "Observation")
+      put("id", UUID.randomUUID().toString())
+      put("status", "final")
+      put("code", coding(code, display))
+      put("subject", subject)
+      put("encounter", encRef)
+      put("effectiveDateTime", date)
+      body()
+    }
+
+  val resources = mutableListOf<JsonObject>()
+  resources += buildJsonObject {
+    put("resourceType", "Encounter")
+    put("id", encId)
+    put("status", "finished")
+    putJsonObject("class") {
+      put("system", "http://terminology.hl7.org/CodeSystem/v3-ActCode"); put("code", "AMB"); put("display", "ambulatory")
+    }
+    putJsonArray("type") { add(buildJsonObject { put("text", "Antenatal care contact") }) }
+    put("subject", subject)
+    putJsonObject("period") { put("start", date); put("end", date) }
+  }
+  first("weight", "valueDecimal")?.let { w ->
+    resources += observation(WEIGHT, "Body weight") { put("valueQuantity", quantity(w, "kg", "kg")) }
+  }
+  val sys = first("bp-systolic", "valueInteger")
+  val dia = first("bp-diastolic", "valueInteger")
+  if (sys != null || dia != null) {
+    resources += observation(BP, "Blood pressure") {
+      putJsonArray("component") {
+        listOf(SYSTOLIC to sys, DIASTOLIC to dia).forEach { (code, v) ->
+          if (v != null) add(buildJsonObject {
+            put("code", coding(code, if (code == SYSTOLIC) "Systolic blood pressure" else "Diastolic blood pressure"))
+            put("valueQuantity", quantity(v, "mmHg", "mm[Hg]"))
+          })
+        }
+      }
+    }
+  }
+  first("gestational-age", "valueInteger")?.let { ga ->
+    resources += observation(GEST_AGE, "Gestational age") { put("valueQuantity", quantity(ga, "wk", "wk")) }
+  }
+  // Danger signs and notes live in the QuestionnaireResponse itself, linked to the encounter.
+  resources += JsonObject(
+    qr + mapOf(
+      "id" to JsonPrimitive(UUID.randomUUID().toString()),
+      "questionnaire" to JsonPrimitive("http://example.org/fhir/Questionnaire/$QUESTIONNAIRE_ID"),
+      "status" to JsonPrimitive("completed"),
+      "subject" to subject,
+      "encounter" to encRef,
+      "authored" to JsonPrimitive(date),
+    )
+  )
+  engine.create(*resources.map { json.decodeFromString<Resource>(it.toString()) }.toTypedArray())
+}
