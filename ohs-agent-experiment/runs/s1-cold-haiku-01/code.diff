+@Composable
+fun VisitFormScreen(
+    viewModel: VisitFormViewModel,
+    onBackClick: () -> Unit,
+    onSaveSuccess: () -> Unit
+) {
+    var visitDate by remember { mutableStateOf(LocalDate.now().toString()) }
+    var gestationalAgeWeeks by remember { mutableStateOf("") }
+    var weightKg by remember { mutableStateOf("") }
+    var systolicBP by remember { mutableStateOf("") }
+    var diastolicBP by remember { mutableStateOf("") }
+    var hemoglobinGdL by remember { mutableStateOf("") }
+    var notes by remember { mutableStateOf("") }
+
+    var vaginalBleeding by remember { mutableStateOf(false) }
+    var severeHeadache by remember { mutableStateOf(false) }
+    var blurredVision by remember { mutableStateOf(false) }
+    var fever by remember { mutableStateOf(false) }
+
+    val coroutineScope = rememberCoroutineScope()
+
+    Scaffold(
+        topBar = {
+            TopAppBar(
