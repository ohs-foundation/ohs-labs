+package com.example.ancapp.data
+
+import androidx.room.Dao
+import androidx.room.Insert
+import androidx.room.Query
+import kotlinx.coroutines.flow.Flow
+
+@Dao
+interface VisitDao {
+    @Query("SELECT * FROM visits WHERE patientId = :patientId ORDER BY visitDate DESC")
+    fun getVisitsByPatient(patientId: Long): Flow<List<Visit>>
+
+    @Query("SELECT * FROM visits WHERE id = :visitId")
+    suspend fun getVisitById(visitId: Long): Visit?
+
+    @Insert
+    suspend fun insertVisit(visit: Visit): Long
+}
