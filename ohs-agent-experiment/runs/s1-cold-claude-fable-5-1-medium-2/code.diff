+import java.time.format.DateTimeParseException
 
 class MainActivity : ComponentActivity() {
   override fun onCreate(savedInstanceState: Bundle?) {
     super.onCreate(savedInstanceState)
-    setContent { MaterialTheme { Surface { Text("Hello") } } }
+    val db = Db(this)
+    setContent { MaterialTheme { Surface { App(db) } } }
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun App(db: Db) {
+  // ponytail: in-memory nav state; swap for Navigation Compose if deep links/process death restore are needed
+  var patient by remember { mutableStateOf<Patient?>(null) }
+  var adding by remember { mutableStateOf(false) }
+  var visits by remember { mutableStateOf(emptyList<Visit>()) }
+  val patients = remember { db.patients() }
+  val p = patient
+
+  BackHandler(enabled = p != null) { if (adding) adding = false else patient = null }
+  LaunchedEffect(p) { visits = if (p == null) emptyList() else db.visits(p.id) }
+
+  Scaffold(topBar = {
+    TopAppBar(
+      title = { Text(if (p == null) "ANC Register" else if (adding) "New visit" else p.name) },
+      navigationIcon = {
+        if (p != null) IconButton(onClick = { if (adding) adding = false else patient = null }) {
+          Icon(Icons.AutoMirrored.Filled.ArrowBack, "Back")
+        }
+      },
+    )
+  }, floatingActionButton = {
+    if (p != null && !adding) ExtendedFloatingActionButton(onClick = { adding = true }) { Text("Record visit") }
+  }) { pad ->
+    Box(Modifier.padding(pad)) {
+      when {
+        p == null -> Register(patients) { patient = it }
+        adding -> VisitForm(p) { v -> db.insert(v); visits = db.visits(p.id); adding = false }
+        else -> Detail(p, visits)
+      }
+    }
+  }
+}
+
+@Composable
+fun Register(patients: List<Patient>, onClick: (Patient) -> Unit) {
+  LazyColumn {
+    items(patients) { p ->
+      ListItem(
+        headlineContent = { Text(p.name) },
+        supportingContent = { Text("Age ${p.age} · Due ${p.dueDate} · ${p.weeksOn()} weeks") },
+        modifier = Modifier.clickable { onClick(p) },
+      )
+      HorizontalDivider()
+    }
+  }
+}
+
+@Composable
+fun Detail(p: Patient, visits: List<Visit>) {
+  LazyColumn(contentPadding = PaddingValues(bottom = 88.dp)) {
+    item {
+      Text(
+        "Age ${p.age} · Due ${p.dueDate} · ${p.weeksOn()} weeks pregnant",
+        Modifier.padding(16.dp), style = MaterialTheme.typography.bodyLarge,
+      )
+      HorizontalDivider()
+    }
+    if (visits.isEmpty()) item { Text("No visits recorded", Modifier.padding(16.dp)) }
+    items(visits) { v ->
+      ListItem(
+        headlineContent = { Text("${v.date} · ${v.gaWeeks} wk") },
+        supportingContent = {
+          Column {
+            Text("Weight ${v.weightKg} kg · BP ${v.systolic}/${v.diastolic}" + (v.hb?.let { " · Hb $it g/dL" } ?: ""))
+            if (v.dangerSigns.isNotEmpty()) Text("Danger signs: ${v.dangerSigns.joinToString()}", color = MaterialTheme.colorScheme.error)
+            if (v.notes.isNotBlank()) Text(v.notes)
+          }
+        },
+      )
+      HorizontalDivider()
+    }
+  }
+}
+
+@Composable
+fun VisitForm(p: Patient, onSave: (Visit) -> Unit) {
+  var date by remember { mutableStateOf(LocalDate.now().toString()) }
+  var ga by remember { mutableStateOf(p.weeksOn().toString()) }
+  var weight by remember { mutableStateOf("") }
+  var sys by remember { mutableStateOf("") }
+  var dia by remember { mutableStateOf("") }
+  var hb by remember { mutableStateOf("") }
+  var signs by remember { mutableStateOf(setOf<String>()) }
+  var notes by remember { mutableStateOf("") }
+  var error by remember { mutableStateOf<String?>(null) }
+
+  @Composable
+  fun Field(label: String, value: String, type: KeyboardType = KeyboardType.Number, onChange: (String) -> Unit) =
+    OutlinedTextField(
+      value, onChange, Modifier.fillMaxWidth(), label = { Text(label) }, singleLine = true,
+      keyboardOptions = KeyboardOptions(keyboardType = type, imeAction = ImeAction.Next),
+    )
+
+  Column(Modifier.padding(16.dp).verticalScroll(rememberScrollState()), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+    Field("Visit date (YYYY-MM-DD)", date, KeyboardType.Text) { date = it }
+    Field("Gestational age (weeks)", ga) { ga = it }
+    Field("Weight (kg)", weight, KeyboardType.Decimal) { weight = it }
+    Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+      Box(Modifier.weight(1f)) { Field("Systolic (mmHg)", sys) { sys = it } }
+      Box(Modifier.weight(1f)) { Field("Diastolic (mmHg)", dia) { dia = it } }
+    }
+    Field("Hemoglobin (g/dL, optional)", hb, KeyboardType.Decimal) { hb = it }
+    Text("Danger signs", style = MaterialTheme.typography.titleSmall)
+    Row(Modifier.fillMaxWidth()) {
+      Checkbox(signs.isEmpty(), onCheckedChange = { signs = emptySet() }); Text("None", Modifier.align(androidx.compose.ui.Alignment.CenterVertically))
+    }
+    DANGER_SIGNS.forEach { s ->
+      Row(Modifier.fillMaxWidth()) {
+        Checkbox(s in signs, onCheckedChange = { signs = if (it) signs + s else signs - s })
+        Text(s, Modifier.align(androidx.compose.ui.Alignment.CenterVertically))
+      }
+    }
+    OutlinedTextField(notes, { notes = it }, Modifier.fillMaxWidth(), label = { Text("Notes") }, minLines = 3)
+    error?.let { Text(it, color = MaterialTheme.colorScheme.error) }
+    Button(onClick = {
+      val d = try { LocalDate.parse(date.trim()) } catch (e: DateTimeParseException) { null }
+      val g = ga.toIntOrNull(); val w = weight.toDoubleOrNull()
+      val s = sys.toIntOrNull(); val di = dia.toIntOrNull()
+      val h = hb.trim().let { if (it.isEmpty()) null else it.toDoubleOrNull() ?: Double.NaN }
+      error = when {
+        d == null -> "Enter the date as YYYY-MM-DD"
+        g == null || g !in 1..45 -> "Gestational age must be 1–45 weeks"
+        w == null || w <= 0 -> "Enter a valid weight"
+        s == null || di == null || s <= 0 || di <= 0 -> "Enter valid blood pressure"
+        h != null && h.isNaN() -> "Enter a valid hemoglobin or leave blank"
+        else -> null
+      }
+      if (error == null) onSave(Visit(0, p.id, d!!, g!!, w!!, s!!, di!!, h, DANGER_SIGNS.filter { it in signs }, notes.trim()))
+    }, Modifier.fillMaxWidth()) { Text("Save visit") }
   }
 }
