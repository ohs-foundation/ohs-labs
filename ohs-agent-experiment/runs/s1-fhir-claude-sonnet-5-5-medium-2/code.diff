+package com.example.ancapp
+
+import java.net.HttpURLConnection
+import java.net.URL
+import java.time.LocalDate
+import java.time.temporal.ChronoUnit
+import org.json.JSONArray
+import org.json.JSONObject
+
+const val BASE = "http://10.0.2.2:8080/fhir"
+const val LOINC = "http://loinc.org"
+const val EDD = "11778-8"
+const val WEIGHT = "29463-7"
+const val BP = "85354-9"
+const val SYS = "8480-6"
+const val DIA = "8462-4"
+const val HB = "718-7"
+
+data class Patient(val id: String, val name: String, val birth: LocalDate, val edd: LocalDate?) {
+  val age get() = ChronoUnit.YEARS.between(birth, LocalDate.now()).toInt()
+  // 40 weeks of pregnancy ends at the due date
+  val weeks get() = edd?.let { ((280 - ChronoUnit.DAYS.between(LocalDate.now(), it)) / 7).toInt() }
+}
+
+data class Visit(
+  val date: String,
+  val weight: String?,
+  val bp: String?,
+  val hb: String?,
+  val weeks: Int?,
+  val dangerSigns: String?,
+  val notes: String?,
+)
+
+private fun call(method: String, url: String, body: JSONObject? = null): JSONObject {
+  val c = URL(url).openConnection() as HttpURLConnection
+  try {
+    c.requestMethod = method
+    c.connectTimeout = 10_000
+    c.readTimeout = 20_000
+    c.setRequestProperty("Accept", "application/fhir+json")
+    c.setRequestProperty("Cache-Control", "no-cache") // HAPI otherwise reuses cached searches for ~60s
+    if (body != null) {
+      c.doOutput = true
+      c.setRequestProperty("Content-Type", "application/fhir+json")
+      c.outputStream.use { it.write(body.toString().toByteArray()) }
+    }
+    val stream = if (c.responseCode < 400) c.inputStream else c.errorStream
+    val text = stream.bufferedReader().use { it.readText() }
+    if (c.responseCode >= 400) error("Server error ${c.responseCode}: " + runCatching {
+      JSONObject(text).getJSONArray("issue").let { a -> (0 until a.length()).joinToString("; ") { a.getJSONObject(it).optString("diagnostics") } }
+    }.getOrDefault(text.take(200)))
+    return JSONObject(text)
+  } finally {
+    c.disconnect()
+  }
+}
+
+fun get(path: String) = call("GET", "$BASE/$path")
+
+/** All resources matching a search, following paging links. */
+fun search(path: String): List<JSONObject> {
+  val out = mutableListOf<JSONObject>()
+  var url: String? = "$BASE/$path"
+  while (url != null) {
+    val bundle = call("GET", url)
+    bundle.optJSONArray("entry")?.let { for (i in 0 until it.length()) out += it.getJSONObject(i).getJSONObject("resource") }
+    val links = bundle.optJSONArray("link") ?: JSONArray()
+    url = (0 until links.length()).map { links.getJSONObject(it) }.firstOrNull { it.getString("relation") == "next" }?.getString("url")
+  }
+  return out
+}
+
+private fun JSONObject.codeOf() = optJSONObject("code")?.optJSONArray("coding")?.optJSONObject(0)?.optString("code")
+private fun JSONObject.refId(key: String) = optJSONObject(key)?.optString("reference")?.substringAfterLast('/')
+private fun JSONObject.qty(): Double? = optJSONObject("valueQuantity")?.optDouble("value")?.takeIf { !it.isNaN() }
+private fun fmt(d: Double) = if (d % 1.0 == 0.0) d.toInt().toString() else d.toString()
+
+fun loadPatients(): List<Patient> {
+  val edds = search("Observation?code=$LOINC|$EDD&_count=200")
+    .groupBy { it.refId("subject") }
+    .mapValues { (_, obs) -> obs.maxByOrNull { it.optString("effectiveDateTime") }?.optString("valueDateTime")?.take(10)?.let(LocalDate::parse) }
+  return search("Patient?_count=200").mapNotNull { p ->
+    val n = p.optJSONArray("name")?.optJSONObject(0) ?: return@mapNotNull null
+    val given = n.optJSONArray("given")?.optString(0).orEmpty()
+    Patient(p.getString("id"), "$given ${n.optString("family")}".trim(), LocalDate.parse(p.getString("birthDate")), edds[p.getString("id")])
+  }.sortedWith(compareBy(nullsLast()) { it.edd })
+}
+
+fun loadVisits(patientId: String): List<Visit> {
+  val ref = "Patient/$patientId"
+  val obs = search("Observation?subject=$ref&_count=200").groupBy { it.refId("encounter") }
+  val qrs = search("QuestionnaireResponse?subject=$ref&_count=200").associateBy { it.refId("encounter") }
+  return search("Encounter?subject=$ref&_count=200").map { e ->
+    val o = obs[e.getString("id")].orEmpty()
+    fun byCode(c: String) = o.firstOrNull { it.codeOf() == c }
+    val comps = byCode(BP)?.optJSONArray("component")?.let { a -> (0 until a.length()).map { a.getJSONObject(it) } }.orEmpty()
+    fun comp(c: String) = comps.firstOrNull { it.codeOf() == c }?.qty()?.let(::fmt)
+    val answers = mutableMapOf<String, List<JSONObject>>()
+    fun walk(items: JSONArray?) {
+      if (items == null) return
+      for (i in 0 until items.length()) items.getJSONObject(i).let { answers[it.getString("linkId")] = it.optJSONArray("answer")?.let { a -> (0 until a.length()).map(a::getJSONObject) }.orEmpty(); walk(it.optJSONArray("item")) }
+    }
+    walk(qrs[e.getString("id")]?.optJSONArray("item"))
+    Visit(
+      date = e.optJSONObject("period")?.optString("start").orEmpty().take(10),
+      weight = byCode(WEIGHT)?.qty()?.let { "${fmt(it)} kg" },
+      bp = comp(SYS)?.let { s -> comp(DIA)?.let { d -> "$s/$d mmHg" } },
+      hb = byCode(HB)?.qty()?.let { "${fmt(it)} g/dL" },
+      weeks = answers["gestational-age"]?.firstOrNull()?.optInt("valueInteger"),
+      dangerSigns = answers["danger-signs"]?.joinToString { it.getJSONObject("valueCoding").optString("display") }?.ifBlank { null },
+      notes = answers["notes"]?.firstOrNull()?.optString("valueString")?.ifBlank { null },
+    )
+  }.sortedByDescending { it.date }
+}
+
+// ---- Questionnaire ----
+
+class Q(val linkId: String, val text: String, val type: String, val required: Boolean, val repeats: Boolean,
+        val options: List<Pair<JSONObject, String>>, val children: List<Q>)
+
+fun parseItems(a: JSONArray?): List<Q> = (0 until (a?.length() ?: 0)).map { i ->
+  val o = a!!.getJSONObject(i)
+  val opts = o.optJSONArray("answerOption")?.let { ao -> (0 until ao.length()).map { ao.getJSONObject(it).getJSONObject("valueCoding").let { c -> c to c.optString("display") } } }.orEmpty()
+  Q(o.getString("linkId"), o.optString("text"), o.getString("type"), o.optBoolean("required"), o.optBoolean("repeats"), opts, parseItems(o.optJSONArray("item")))
+}
+
+/** Form answers: text per linkId, plus chosen option codes per choice linkId. */
+fun saveVisit(patientId: String, questionnaire: List<Q>, text: Map<String, String>, choices: Map<String, Set<String>>) {
+  fun v(id: String) = text[id]?.trim().orEmpty()
+  fun answers(q: Q): JSONArray? {
+    val a = JSONArray()
+    when (q.type) {
+      "date" -> v(q.linkId).takeIf { it.isNotEmpty() }?.let { a.put(JSONObject().put("valueDate", it)) }
+      "integer" -> v(q.linkId).takeIf { it.isNotEmpty() }?.let { a.put(JSONObject().put("valueInteger", it.toInt())) }
+      "decimal" -> v(q.linkId).takeIf { it.isNotEmpty() }?.let { a.put(JSONObject().put("valueDecimal", it.toDouble())) }
+      "text", "string" -> v(q.linkId).takeIf { it.isNotEmpty() }?.let { a.put(JSONObject().put("valueString", it)) }
+      "choice" -> q.options.filter { it.first.getString("code") in choices[q.linkId].orEmpty() }.forEach { a.put(JSONObject().put("valueCoding", it.first)) }
+    }
+    return if (a.length() > 0) a else null
+  }
+  fun toItems(qs: List<Q>): JSONArray = JSONArray().also { out ->
+    for (q in qs) {
+      if (q.type == "group") out.put(JSONObject().put("linkId", q.linkId).put("item", toItems(q.children)))
+      else answers(q)?.let { out.put(JSONObject().put("linkId", q.linkId).put("answer", it)) }
+    }
+  }
+
+  val subject = JSONObject().put("reference", "Patient/$patientId")
+  val date = v("visit-date")
+  val enc = "urn:uuid:${java.util.UUID.randomUUID()}"
+  fun obs(code: String, display: String) = JSONObject().put("resourceType", "Observation").put("status", "final")
+    .put("category", JSONArray().put(JSONObject().put("coding", JSONArray().put(JSONObject().put("system", "http://terminology.hl7.org/CodeSystem/observation-category").put("code", "vital-signs")))))
+    .put("code", JSONObject().put("coding", JSONArray().put(JSONObject().put("system", LOINC).put("code", code).put("display", display))))
+    .put("subject", subject).put("encounter", JSONObject().put("reference", enc)).put("effectiveDateTime", date)
+  fun quantity(v: Double, unit: String, ucum: String) = JSONObject().put("value", v).put("unit", unit).put("system", "http://unitsofmeasure.org").put("code", ucum)
+  fun comp(code: String, display: String, v: Double) = JSONObject()
+    .put("code", JSONObject().put("coding", JSONArray().put(JSONObject().put("system", LOINC).put("code", code).put("display", display))))
+    .put("valueQuantity", quantity(v, "mmHg", "mm[Hg]"))
+
+  val resources = mutableListOf<JSONObject>()
+  resources += JSONObject().put("resourceType", "Encounter").put("status", "finished")
+    .put("class", JSONObject().put("system", "http://terminology.hl7.org/CodeSystem/v3-ActCode").put("code", "AMB"))
+    .put("type", JSONArray().put(JSONObject().put("text", "Antenatal care contact")))
+    .put("subject", subject).put("period", JSONObject().put("start", date).put("end", date))
+  v("weight").takeIf { it.isNotEmpty() }?.let { resources += obs(WEIGHT, "Body weight").put("valueQuantity", quantity(it.toDouble(), "kg", "kg")) }
+  if (v("bp-systolic").isNotEmpty() && v("bp-diastolic").isNotEmpty())
+    resources += obs(BP, "Blood pressure panel with all children optional").put("component", JSONArray()
+      .put(comp(SYS, "Systolic blood pressure", v("bp-systolic").toDouble()))
+      .put(comp(DIA, "Diastolic blood pressure", v("bp-diastolic").toDouble())))
+  resources += JSONObject().put("resourceType", "QuestionnaireResponse").put("status", "completed")
+    .put("questionnaire", "http://example.org/fhir/Questionnaire/anc-contact").put("subject", subject)
+    .put("encounter", JSONObject().put("reference", enc)).put("authored", date).put("item", toItems(questionnaire))
+
+  val bundle = JSONObject().put("resourceType", "Bundle").put("type", "transaction").put("entry", JSONArray().also { entries ->
+    resources.forEachIndexed { i, r ->
+      // the server enforces dom-6 (narrative required)
+      r.put("text", JSONObject().put("status", "generated").put("div", "<div xmlns=\"http://www.w3.org/1999/xhtml\">ANC visit $date: ${r.getString("resourceType")}</div>"))
+      entries.put(JSONObject().put("fullUrl", if (i == 0) enc else "urn:uuid:${java.util.UUID.randomUUID()}").put("resource", r)
+        .put("request", JSONObject().put("method", "POST").put("url", r.getString("resourceType"))))
+    }
+  })
+  call("POST", BASE, bundle)
+}
