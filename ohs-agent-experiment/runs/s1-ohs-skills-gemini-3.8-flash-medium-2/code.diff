+package com.example.ancapp.ui
+
+import android.app.Application
+import androidx.lifecycle.AndroidViewModel
+import androidx.lifecycle.viewModelScope
+import com.example.ancapp.data.AncRepository
+import com.example.ancapp.data.AncVisitItem
+import com.example.ancapp.data.PatientItem
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+
+class AncViewModel(application: Application) : AndroidViewModel(application) {
+
+    private val repository = AncRepository(application)
+
+    private val _patients = MutableStateFlow<List<PatientItem>>(emptyList())
+    val patients: StateFlow<List<PatientItem>> = _patients.asStateFlow()
+
+    private val _isSyncing = MutableStateFlow(false)
+    val isSyncing: StateFlow<Boolean> = _isSyncing.asStateFlow()
+
+    private val _syncMessage = MutableStateFlow<String?>(null)
+    val syncMessage: StateFlow<String?> = _syncMessage.asStateFlow()
+
+    private val _selectedPatient = MutableStateFlow<PatientItem?>(null)
+    val selectedPatient: StateFlow<PatientItem?> = _selectedPatient.asStateFlow()
+
+    private val _visits = MutableStateFlow<List<AncVisitItem>>(emptyList())
+    val visits: StateFlow<List<AncVisitItem>> = _visits.asStateFlow()
+
+    private val _isLoadingVisits = MutableStateFlow(false)
+    val isLoadingVisits: StateFlow<Boolean> = _isLoadingVisits.asStateFlow()
+
+    init {
+        // Initial sync and load
+        viewModelScope.launch {
+            loadPatients()
+            syncData()
+        }
+    }
+
+    fun syncData() {
+        viewModelScope.launch {
+            _isSyncing.value = true
+            _syncMessage.value = "Syncing with server..."
+            val success = repository.sync()
+            if (success) {
+                _syncMessage.value = null
+            } else {
+                _syncMessage.value = "Sync completed with issues"
+            }
+            loadPatients()
+            _selectedPatient.value?.let { loadVisits(it.id) }
+            _isSyncing.value = false
+        }
+    }
+
+    fun loadPatients() {
+        viewModelScope.launch {
+            val list = repository.getPatients()
+            _patients.value = list
+        }
+    }
+
+    fun selectPatient(patientId: String) {
+        viewModelScope.launch {
+            val patient = repository.getPatient(patientId)
+            _selectedPatient.value = patient
+            loadVisits(patientId)
+        }
+    }
+
+    private suspend fun loadVisits(patientId: String) {
+        _isLoadingVisits.value = true
+        val list = repository.getVisits(patientId)
+        _visits.value = list
+        _isLoadingVisits.value = false
+    }
+
+    suspend fun getQuestionnaireJson(): String {
+        return repository.getQuestionnaireJson()
+    }
+
+    suspend fun saveVisit(patientId: String, response: QuestionnaireResponse) {
+        repository.saveVisit(patientId, response)
+        loadVisits(patientId)
+        loadPatients()
+    }
+}
