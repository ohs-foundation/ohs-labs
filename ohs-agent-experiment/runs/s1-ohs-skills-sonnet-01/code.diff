@@ -0,0 +1,65 @@
+package com.example.ancapp.data
+
+import com.ionspin.kotlin.bignum.decimal.BigDecimal
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.CodeableConcept
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.Date
+import dev.ohs.fhir.model.r4.DateTime
+import dev.ohs.fhir.model.r4.Decimal
+import dev.ohs.fhir.model.r4.FhirDate
+import dev.ohs.fhir.model.r4.FhirDateTime
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Quantity
+import dev.ohs.fhir.model.r4.Reference
+import dev.ohs.fhir.model.r4.Uri
+import dev.ohs.fhir.model.r4.String as FhirString
+import kotlinx.datetime.LocalDate
+
+private const val LOINC_SYSTEM = "http://loinc.org"
+private const val UCUM_SYSTEM = "http://unitsofmeasure.org"
+
+/** Unwraps a FHIR `date` element to a [LocalDate], dropping partial (year/year-month) precision. */
+fun Date?.toLocalDate(): LocalDate? = (this?.value as? FhirDate.Date)?.date
+
+/** Unwraps a FHIR `dateTime` element to a [LocalDate], dropping partial precision and time-of-day. */
+fun DateTime?.toLocalDate(): LocalDate? =
+  when (val value = this?.value) {
+    is FhirDateTime.Date -> value.date
+    is FhirDateTime.DateTime -> value.dateTime.date
+    else -> null
+  }
+
+/** The LOINC code of a [CodeableConcept], if one of its codings uses the LOINC system. */
+fun loincCode(concept: CodeableConcept?): String? =
+  concept?.coding?.firstOrNull { it.system?.value == LOINC_SYSTEM }?.code?.value
+
+fun Observation.hasLoinc(code: String): Boolean = loincCode(this.code) == code
+
+fun Observation.quantityValue(): BigDecimal? = value?.asQuantity()?.value?.value?.value
+
+fun Observation.Component.quantityValue(): BigDecimal? = value?.asQuantity()?.value?.value?.value
+
+fun reference(resourceType: String, id: String): Reference =
+  Reference(reference = FhirString(value = "$resourceType/$id"))
+
+fun quantity(value: BigDecimal, unit: String, ucumCode: String): Quantity =
+  Quantity(
+    value = Decimal(value = value),
+    unit = FhirString(value = unit),
+    system = Uri(value = UCUM_SYSTEM),
+    code = Code(value = ucumCode),
+  )
+
+fun loincConcept(code: String, display: String, text: String = display): CodeableConcept =
+  CodeableConcept(
+    coding =
+      listOf(
+        Coding(
+          system = Uri(value = LOINC_SYSTEM),
+          code = Code(value = code),
+          display = FhirString(value = display),
+        )
+      ),
+    text = FhirString(value = text),
+  )
