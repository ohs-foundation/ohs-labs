+package com.example.ancapp
+
+import android.content.Context
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+import java.time.LocalDate
+import java.time.temporal.ChronoUnit
+
+data class Patient(val id: Int, val name: String, val dob: LocalDate, val edd: LocalDate) {
+  val age: Int get() = ChronoUnit.YEARS.between(dob, LocalDate.now()).toInt()
+  // ponytail: GA derived from EDD (40w rule); add LMP/ultrasound dating if clinic needs it
+  val weeksPregnant: Int get() = (40 - ChronoUnit.DAYS.between(LocalDate.now(), edd) / 7).toInt()
+}
+
+data class Visit(
+  val patientId: Int,
+  val date: LocalDate,
+  val gaWeeks: Int,
+  val weightKg: Double,
+  val systolic: Int,
+  val diastolic: Int,
+  val hb: Double?,
+  val dangerSigns: List<String>,
+  val notes: String,
+)
+
+val DANGER_SIGNS = listOf("Vaginal bleeding", "Severe headache", "Blurred vision", "Fever")
+
+/** JSON file store. ponytail: whole-file rewrite per save, fine for a small clinic; move to Room if thousands of visits. */
+class Store(context: Context) {
+  private val file = File(context.filesDir, "anc.json")
+  val patients: List<Patient>
+  var visits: List<Visit> private set
+
+  init {
+    if (!file.exists()) file.writeText(SEED)
+    val root = JSONObject(file.readText())
+    patients = root.getJSONArray("patients").objects {
+      Patient(it.getInt("id"), it.getString("name"), LocalDate.parse(it.getString("dob")), LocalDate.parse(it.getString("edd")))
+    }
+    visits = root.getJSONArray("visits").objects {
+      Visit(
+        it.getInt("patientId"), LocalDate.parse(it.getString("date")), it.getInt("gaWeeks"), it.getDouble("weightKg"),
+        it.getInt("systolic"), it.getInt("diastolic"), if (it.isNull("hb")) null else it.getDouble("hb"),
+        it.getJSONArray("dangerSigns").strings(), it.optString("notes"),
+      )
+    }
+  }
+
+  fun addVisit(v: Visit) {
+    visits = visits + v
+    val root = JSONObject(file.readText())
+    root.put("visits", JSONArray(visits.map {
+      JSONObject().put("patientId", it.patientId).put("date", it.date.toString()).put("gaWeeks", it.gaWeeks)
+        .put("weightKg", it.weightKg).put("systolic", it.systolic).put("diastolic", it.diastolic)
+        .put("hb", it.hb ?: JSONObject.NULL).put("dangerSigns", JSONArray(it.dangerSigns)).put("notes", it.notes)
+    }))
+    file.writeText(root.toString())
+  }
+
+  private fun <T> JSONArray.objects(f: (JSONObject) -> T) = (0 until length()).map { f(getJSONObject(it)) }
+  private fun JSONArray.strings() = (0 until length()).map { getString(it) }
+}
+
+private val SEED = """
+{"patients":[
+ {"id":1,"name":"Emily Carter","dob":"1996-04-12","edd":"2026-12-05"},
+ {"id":2,"name":"Sarah Mitchell","dob":"1990-11-02","edd":"2027-01-20"},
+ {"id":3,"name":"Grace Thompson","dob":"2001-07-30","edd":"2026-10-15"}],
+ "visits":[
+ {"patientId":1,"date":"2026-08-10","gaWeeks":23,"weightKg":68.5,"systolic":118,"diastolic":76,"hb":11.8,"dangerSigns":[],"notes":""},
+ {"patientId":2,"date":"2026-08-12","gaWeeks":17,"weightKg":61.2,"systolic":110,"diastolic":70,"hb":12.4,"dangerSigns":[],"notes":""},
+ {"patientId":3,"date":"2026-08-05","gaWeeks":30,"weightKg":72.0,"systolic":128,"diastolic":84,"hb":10.2,"dangerSigns":[],"notes":""}]}
+""".trimIndent()
