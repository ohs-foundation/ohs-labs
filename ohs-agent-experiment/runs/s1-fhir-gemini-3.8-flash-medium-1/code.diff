+package com.example.ancapp.ui
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.example.ancapp.data.model.AncVisit
+import com.example.ancapp.data.model.AncVisitInput
+import com.example.ancapp.data.model.DangerSignOption
+import com.example.ancapp.data.model.PatientItem
+import com.example.ancapp.data.model.QuestionnaireModel
+import com.example.ancapp.data.network.FhirService
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+
+sealed interface UiScreen {
+    data object Register : UiScreen
+    data class PatientDetail(val patientId: String) : UiScreen
+    data class NewVisit(val patientId: String) : UiScreen
+}
+
+class AncViewModel(
+    private val fhirService: FhirService = FhirService()
+) : ViewModel() {
+
+    private val _screen = MutableStateFlow<UiScreen>(UiScreen.Register)
+    val screen: StateFlow<UiScreen> = _screen.asStateFlow()
+
+    private val _patients = MutableStateFlow<List<PatientItem>>(emptyList())
+    val patients: StateFlow<List<PatientItem>> = _patients.asStateFlow()
+
+    private val _isLoadingPatients = MutableStateFlow(false)
+    val isLoadingPatients: StateFlow<Boolean> = _isLoadingPatients.asStateFlow()
+
+    private val _patientsError = MutableStateFlow<String?>(null)
+    val patientsError: StateFlow<String?> = _patientsError.asStateFlow()
+
+    private val _visits = MutableStateFlow<List<AncVisit>>(emptyList())
+    val visits: StateFlow<List<AncVisit>> = _visits.asStateFlow()
+
+    private val _isLoadingVisits = MutableStateFlow(false)
+    val isLoadingVisits: StateFlow<Boolean> = _isLoadingVisits.asStateFlow()
+
+    private val _visitsError = MutableStateFlow<String?>(null)
+    val visitsError: StateFlow<String?> = _visitsError.asStateFlow()
+
+    private val _questionnaire = MutableStateFlow<QuestionnaireModel?>(null)
+    val questionnaire: StateFlow<QuestionnaireModel?> = _questionnaire.asStateFlow()
+
+    private val _isSavingVisit = MutableStateFlow(false)
+    val isSavingVisit: StateFlow<Boolean> = _isSavingVisit.asStateFlow()
+
+    private val _saveError = MutableStateFlow<String?>(null)
+    val saveError: StateFlow<String?> = _saveError.asStateFlow()
+
+    init {
+        loadPatients()
+        loadQuestionnaire()
+    }
+
+    fun navigateTo(screen: UiScreen) {
+        _screen.value = screen
+        when (screen) {
+            is UiScreen.PatientDetail -> loadVisits(screen.patientId)
+            is UiScreen.NewVisit -> {
+                if (_questionnaire.value == null) {
+                    loadQuestionnaire()
+                }
+            }
+            UiScreen.Register -> {
+                // optionally reload patients
+            }
+        }
+    }
+
+    fun loadPatients() {
+        viewModelScope.launch {
+            _isLoadingPatients.value = true
+            _patientsError.value = null
+            fhirService.getPatients()
+                .onSuccess { list ->
+                    _patients.value = list
+                    _isLoadingPatients.value = false
+                }
+                .onFailure { err ->
+                    _patientsError.value = err.message ?: "Failed to load patients"
+                    _isLoadingPatients.value = false
+                }
+        }
+    }
+
+    fun loadVisits(patientId: String) {
+        viewModelScope.launch {
+            _isLoadingVisits.value = true
+            _visitsError.value = null
+            fhirService.getPatientVisits(patientId)
+                .onSuccess { list ->
+                    _visits.value = list
+                    _isLoadingVisits.value = false
+                }
+                .onFailure { err ->
+                    _visitsError.value = err.message ?: "Failed to load visits"
+                    _isLoadingVisits.value = false
+                }
+        }
+    }
+
+    fun loadQuestionnaire() {
+        viewModelScope.launch {
+            fhirService.getQuestionnaire("anc-contact")
+                .onSuccess { q ->
+                    _questionnaire.value = q
+                }
+                .onFailure {
+                    // Fallback default if network was slow
+                }
+        }
+    }
+
+    fun saveVisit(patientId: String, input: AncVisitInput, onSuccess: () -> Unit) {
+        viewModelScope.launch {
+            _isSavingVisit.value = true
+            _saveError.value = null
+            fhirService.recordVisit(patientId, input)
+                .onSuccess { newVisit ->
+                    _isSavingVisit.value = false
+                    // Update visits list immediately
+                    _visits.value = listOf(newVisit) + _visits.value.filter { it.id != newVisit.id }
+                    // Reload visits from server to ensure full sync
+                    loadVisits(patientId)
+                    onSuccess()
+                }
+                .onFailure { err ->
+                    _isSavingVisit.value = false
+                    _saveError.value = err.message ?: "Failed to save visit"
+                }
+        }
+    }
+}
diff --git a/app/src/main/java/com/example/ancapp/ui/NewVisitScreen.kt b/app/src/main/java/com/example/ancapp/ui/NewVisitScreen.kt
