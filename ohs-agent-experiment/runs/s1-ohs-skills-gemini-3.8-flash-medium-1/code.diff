+package com.example.ancapp
+
+import android.app.Application
+import dev.ohs.fhir.datacapture.DataCapture
+import dev.ohs.fhir.engine.FhirEngineConfiguration
+import dev.ohs.fhir.engine.FhirEngineProvider
+import dev.ohs.fhir.engine.ServerConfiguration
+
+class AncApplication : Application() {
+  override fun onCreate() {
+    super.onCreate()
+    DataCapture.initialize(this)
+    FhirEngineProvider.init(
+      FhirEngineConfiguration(
+        serverConfiguration = ServerConfiguration(baseUrl = "http://10.0.2.2:8080/fhir/"),
+      ),
+      this,
+    )
+  }
+}
diff --git a/app/src/main/java/com/example/ancapp/AncRepository.kt b/app/src/main/java/com/example/ancapp/AncRepository.kt
new file mode 100644
index 0000000..b2f41e6
--- /dev/null
+++ b/app/src/main/java/com/example/ancapp/AncRepository.kt
@@ -0,0 +1,514 @@
+package com.example.ancapp
+
+import android.content.Context
+import androidx.work.ExistingWorkPolicy
+import com.ionspin.kotlin.bignum.decimal.BigDecimal
+import dev.ohs.fhir.engine.FhirEngineProvider
+import dev.ohs.fhir.engine.get
+import dev.ohs.fhir.engine.search.ReferenceClientParam
+import dev.ohs.fhir.engine.search.Search
+import dev.ohs.fhir.engine.sync.CurrentSyncJobStatus
+import dev.ohs.fhir.engine.sync.Sync
+import dev.ohs.fhir.model.r4.Canonical
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.CodeableConcept
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.DateTime
+import dev.ohs.fhir.model.r4.Decimal
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Enumeration
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Patient
+import dev.ohs.fhir.model.r4.Period
+import dev.ohs.fhir.model.r4.Quantity
+import dev.ohs.fhir.model.r4.Questionnaire
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import dev.ohs.fhir.model.r4.Reference
+import dev.ohs.fhir.model.r4.Resource
+import dev.ohs.fhir.model.r4.String as FhirString
+import dev.ohs.fhir.model.r4.Uri
+import dev.ohs.fhir.model.r4.FhirDate
+import dev.ohs.fhir.model.r4.FhirDateTime
+import dev.ohs.fhir.model.r4.terminologies.ResourceType
+import java.time.LocalDate
+import java.time.temporal.ChronoUnit
+import java.time.Period as JavaPeriod
+import java.util.UUID
+import kotlinx.coroutines.flow.Flow
+import kotlinx.serialization.json.Json
+
+data class PatientItem(
+  val id: String,
+  val name: String,
+  val birthDate: String?,
+  val age: Int?,
+  val dueDate: LocalDate?,
+  val gestationalWeeks: Int?,
+)
+
+data class VisitItem(
+  val encounterId: String,
+  val date: String,
+  val weight: String?,
+  val bloodPressure: String?,
+  val hemoglobin: String?,
+  val gestationalAgeWeeks: Int? = null,
+  val dangerSigns: List<String> = emptyList(),
+  val notes: String? = null,
+)
+
+data class PatientDetail(
+  val patient: PatientItem,
+  val visits: List<VisitItem>,
+)
+
+class AncRepository(private val context: Context) {
+  private val engine = FhirEngineProvider.getInstance(context.applicationContext)
+
+  private val jsonSerializer = Json {
+    explicitNulls = false
+    encodeDefaults = false
+    ignoreUnknownKeys = true
+  }
+
+  suspend fun sync(): Flow<CurrentSyncJobStatus> {
+    return Sync.oneTimeSync<AppSyncWorker>(context.applicationContext)
+  }
+
+  suspend fun getPregnantPatients(): List<PatientItem> {
+    val patients = engine.search<Patient>(Search(ResourceType.Patient)).map { it.resource }
+    val observations = engine.search<Observation>(Search(ResourceType.Observation)).map { it.resource }
+
+    val items = patients.map { patient ->
+      val patientId = patient.id ?: ""
+      val nameElem = patient.name.firstOrNull()
+      val fullName = listOfNotNull(
+        nameElem?.given?.mapNotNull { it.value }?.joinToString(" ")?.takeIf { it.isNotBlank() },
+        nameElem?.family?.value?.takeIf { it.isNotBlank() },
+      ).joinToString(" ").ifBlank { "Patient $patientId" }
+
+      val dobStr = patient.birthDate?.value?.toString()
+      val age = dobStr?.let {
+        try {
+          val dob = LocalDate.parse(it.substringBefore("T"))
+          JavaPeriod.between(dob, LocalDate.now()).years
+        } catch (_: Exception) {
+          null
+        }
+      }
+
+      // LOINC 11778-8 is Estimated due date
+      val eddObs = observations.firstOrNull { obs ->
+        val subId = obs.subject?.reference?.value?.substringAfter("Patient/")
+        subId == patientId && obs.code.coding.any { it.code?.value == "11778-8" }
+      }
+      val eddStr = eddObs?.value?.asDateTime()?.value?.value?.toString()?.substringBefore("T")
+      val dueDate = eddStr?.let {
+        try {
+          LocalDate.parse(it)
+        } catch (_: Exception) {
+          null
+        }
+      }
+
+      val gestationalWeeks = dueDate?.let { edd ->
+        val daysUntilDue = ChronoUnit.DAYS.between(LocalDate.now(), edd)
+        val gestationalDays = (40 * 7) - daysUntilDue
+        maxOf(0, (gestationalDays / 7).toInt())
+      }
+
+      PatientItem(
+        id = patientId,
+        name = fullName,
+        birthDate = dobStr,
+        age = age,
+        dueDate = dueDate,
+        gestationalWeeks = gestationalWeeks,
+      )
+    }
+
+    return items.sortedWith(compareBy(nullsLast()) { it.dueDate })
+  }
+
+  suspend fun getPatientDetail(patientId: String): PatientDetail {
+    val patient = engine.get<Patient>(patientId)
+    val nameElem = patient.name.firstOrNull()
+    val fullName = listOfNotNull(
+      nameElem?.given?.mapNotNull { it.value }?.joinToString(" ")?.takeIf { it.isNotBlank() },
+      nameElem?.family?.value?.takeIf { it.isNotBlank() },
+    ).joinToString(" ").ifBlank { "Patient $patientId" }
+
+    val dobStr = patient.birthDate?.value?.toString()
+    val age = dobStr?.let {
+      try {
+        val dob = LocalDate.parse(it.substringBefore("T"))
+        JavaPeriod.between(dob, LocalDate.now()).years
+      } catch (_: Exception) {
+        null
+      }
+    }
+
+    val encounters = engine.search<Encounter>(
+      Search(ResourceType.Encounter).apply {
+        filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+      }
+    ).map { it.resource }
+
+    val observations = engine.search<Observation>(
+      Search(ResourceType.Observation).apply {
+        filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+      }
+    ).map { it.resource }
+
+    // EDD for patient
+    val eddObs = observations.firstOrNull { obs ->
+      obs.code.coding.any { it.code?.value == "11778-8" }
+    }
+    val eddStr = eddObs?.value?.asDateTime()?.value?.value?.toString()?.substringBefore("T")
+    val dueDate = eddStr?.let {
+      try {
+        LocalDate.parse(it)
+      } catch (_: Exception) {
+        null
+      }
+    }
+
+    val gestationalWeeks = dueDate?.let { edd ->
+      val daysUntilDue = ChronoUnit.DAYS.between(LocalDate.now(), edd)
+      val gestationalDays = (40 * 7) - daysUntilDue
+      maxOf(0, (gestationalDays / 7).toInt())
+    }
+
+    val patientItem = PatientItem(
+      id = patientId,
+      name = fullName,
+      birthDate = dobStr,
+      age = age,
+      dueDate = dueDate,
+      gestationalWeeks = gestationalWeeks,
+    )
+
+    val visits = encounters.map { enc ->
+      val encId = enc.id ?: ""
+      val encDate = enc.period?.start?.value?.toString()?.substringBefore("T") ?: ""
+
+      // Find observations linked to this encounter (by reference or date)
+      val linkedObs = observations.filter { obs ->
+        val obsEnc = obs.encounter?.reference?.value?.substringAfter("Encounter/")
+        obsEnc == encId || (obsEnc == null && obs.effective?.asDateTime()?.value?.value?.toString()?.substringBefore("T") == encDate)
+      }
+
+      // Weight: LOINC 29463-7
+      val weightObs = linkedObs.firstOrNull { it.code.coding.any { c -> c.code?.value == "29463-7" } }
+      val weightVal = weightObs?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+      val weightUnit = weightObs?.value?.asQuantity()?.value?.unit?.value ?: "kg"
+      val weightStr = weightVal?.let { "$it $weightUnit" }
+
+      // Blood Pressure: LOINC 85354-9
+      val bpObs = linkedObs.firstOrNull { it.code.coding.any { c -> c.code?.value == "85354-9" } }
+      val sys = bpObs?.component?.firstOrNull {
+        it.code.coding.any { c -> c.code?.value == "8480-6" }
+      }?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+      val dia = bpObs?.component?.firstOrNull {
+        it.code.coding.any { c -> c.code?.value == "8462-4" }
+      }?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+      val bpStr = if (sys != null && dia != null) "$sys/$dia mmHg" else null
+
+      // Hemoglobin: LOINC 718-7
+      val hbObs = linkedObs.firstOrNull { it.code.coding.any { c -> c.code?.value == "718-7" } }
+      val hbVal = hbObs?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+      val hbUnit = hbObs?.value?.asQuantity()?.value?.unit?.value ?: "g/dL"
+      val hbStr = hbVal?.let { "$it $hbUnit" }
+
+      // Gestational age: LOINC 49052-4
+      val gaObs = linkedObs.firstOrNull { it.code.coding.any { c -> c.code?.value == "49052-4" } }
+      val gaWeeks = gaObs?.value?.asQuantity()?.value?.value?.value?.toPlainString()?.toIntOrNull()
+
+      // Danger signs: code "danger-signs"
+      val dsObs = linkedObs.firstOrNull { it.code.coding.any { c -> c.code?.value == "danger-signs" } }
+      val dangerSigns = dsObs?.value?.asString()?.value?.value?.split(", ")?.filter { it.isNotBlank() } ?: emptyList()
+
+      // Notes
+      val notesObs = linkedObs.firstOrNull { it.code.text?.value == "Visit notes" }
+      val notes = notesObs?.value?.asString()?.value?.value
+
+      VisitItem(
+        encounterId = encId,
+        date = encDate,
+        weight = weightStr,
+        bloodPressure = bpStr,
+        hemoglobin = hbStr,
+        gestationalAgeWeeks = gaWeeks,
+        dangerSigns = dangerSigns,
+        notes = notes,
+      )
+    }.sortedByDescending { it.date }
+
+    return PatientDetail(
+      patient = patientItem,
+      visits = visits,
+    )
+  }
+
+  suspend fun getQuestionnaireJson(): String {
+    return try {
+      val q = engine.get<Questionnaire>("anc-contact")
+      jsonSerializer.encodeToString(q)
+    } catch (_: Exception) {
+      context.assets.open("anc-contact.json").bufferedReader().use { it.readText() }
+    }
+  }
+
+  suspend fun saveVisit(patientId: String, response: QuestionnaireResponse) {
+    val answers = mutableMapOf<String, MutableList<QuestionnaireResponse.Item.Answer>>()
+    fun collect(items: List<QuestionnaireResponse.Item>) {
+      items.forEach { item ->
+        item.linkId.value?.let { linkId ->
+          answers.getOrPut(linkId) { mutableListOf() }.addAll(item.answer)
+        }
+        collect(item.item)
+        item.answer.forEach { collect(it.item) }
+      }
+    }
+    collect(response.item)
+
+    val visitDateStr = answers["visit-date"]?.firstOrNull()?.value?.asDate()?.value?.value?.toString()
+      ?: LocalDate.now().toString()
+    val gaWeeks = answers["gestational-age"]?.firstOrNull()?.value?.asInteger()?.value?.value
+    val weightDecimal = answers["weight"]?.firstOrNull()?.value?.asDecimal()?.value?.value
+    val bpSystolic = answers["bp-systolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+    val bpDiastolic = answers["bp-diastolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+    val dangerSigns = answers["danger-signs"].orEmpty().mapNotNull {
+      it.value?.asCoding()?.value?.display?.value ?: it.value?.asCoding()?.value?.code?.value
+    }
+    val notesStr = answers["notes"]?.firstOrNull()?.value?.asString()?.value?.value
+
+    val encounterId = UUID.randomUUID().toString()
+    val resourcesToCreate = mutableListOf<Resource>()
+
+    val encounter = Encounter(
+      id = encounterId,
+      status = Enumeration(value = Encounter.EncounterStatus.Finished),
+      `class` = Coding(
+        system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"),
+        code = Code(value = "AMB"),
+        display = FhirString(value = "ambulatory"),
+      ),
+      type = listOf(
+        CodeableConcept(
+          text = FhirString(value = "Antenatal care contact"),
+        )
+      ),
+      subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+      period = Period(
+        start = DateTime(value = FhirDateTime.fromString(visitDateStr)),
+        end = DateTime(value = FhirDateTime.fromString(visitDateStr)),
+      ),
+    )
+    resourcesToCreate.add(encounter)
+
+    if (weightDecimal != null) {
+      val weightObs = Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        category = listOf(
+          CodeableConcept(
+            coding = listOf(
+              Coding(
+                system = Uri(value = "http://terminology.hl7.org/CodeSystem/observation-category"),
+                code = Code(value = "vital-signs"),
+                display = FhirString(value = "Vital Signs"),
+              )
+            )
+          )
+        ),
+        code = CodeableConcept(
+          coding = listOf(
+            Coding(
+              system = Uri(value = "http://loinc.org"),
+              code = Code(value = "29463-7"),
+              display = FhirString(value = "Body weight"),
+            )
+          ),
+          text = FhirString(value = "Body weight"),
+        ),
+        subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+        encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")),
+        effective = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(visitDateStr))),
+        value = Observation.Value.Quantity(
+          Quantity(
+            value = Decimal(value = weightDecimal),
+            unit = FhirString(value = "kg"),
+            system = Uri(value = "http://unitsofmeasure.org"),
+            code = Code(value = "kg"),
+          )
+        ),
+      )
+      resourcesToCreate.add(weightObs)
+    }
+
+    if (bpSystolic != null || bpDiastolic != null) {
+      val bpComponents = mutableListOf<Observation.Component>()
+      if (bpSystolic != null) {
+        bpComponents.add(
+          Observation.Component(
+            code = CodeableConcept(
+              coding = listOf(
+                Coding(
+                  system = Uri(value = "http://loinc.org"),
+                  code = Code(value = "8480-6"),
+                  display = FhirString(value = "Systolic blood pressure"),
+                )
+              )
+            ),
+            value = Observation.Component.Value.Quantity(
+              Quantity(
+                value = Decimal(value = BigDecimal.fromInt(bpSystolic)),
+                unit = FhirString(value = "mmHg"),
+                system = Uri(value = "http://unitsofmeasure.org"),
+                code = Code(value = "mm[Hg]"),
+              )
+            ),
+          )
+        )
+      }
+      if (bpDiastolic != null) {
+        bpComponents.add(
+          Observation.Component(
+            code = CodeableConcept(
+              coding = listOf(
+                Coding(
+                  system = Uri(value = "http://loinc.org"),
+                  code = Code(value = "8462-4"),
+                  display = FhirString(value = "Diastolic blood pressure"),
+                )
+              )
+            ),
+            value = Observation.Component.Value.Quantity(
+              Quantity(
+                value = Decimal(value = BigDecimal.fromInt(bpDiastolic)),
+                unit = FhirString(value = "mmHg"),
+                system = Uri(value = "http://unitsofmeasure.org"),
+                code = Code(value = "mm[Hg]"),
+              )
+            ),
+          )
+        )
+      }
+
+      val bpObs = Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        category = listOf(
+          CodeableConcept(
+            coding = listOf(
+              Coding(
+                system = Uri(value = "http://terminology.hl7.org/CodeSystem/observation-category"),
+                code = Code(value = "vital-signs"),
+                display = FhirString(value = "Vital Signs"),
+              )
+            )
+          )
+        ),
+        code = CodeableConcept(
+          coding = listOf(
+            Coding(
+              system = Uri(value = "http://loinc.org"),
+              code = Code(value = "85354-9"),
+              display = FhirString(value = "Blood pressure panel with all children optional"),
+            )
+          ),
+          text = FhirString(value = "Blood pressure"),
+        ),
+        subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+        encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")),
+        effective = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(visitDateStr))),
+        component = bpComponents,
+      )
+      resourcesToCreate.add(bpObs)
+    }
+
+    if (gaWeeks != null) {
+      val gaObs = Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        code = CodeableConcept(
+          coding = listOf(
+            Coding(
+              system = Uri(value = "http://loinc.org"),
+              code = Code(value = "49052-4"),
+              display = FhirString(value = "Gestational age in weeks"),
+            )
+          ),
+          text = FhirString(value = "Gestational age in weeks"),
+        ),
+        subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+        encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")),
+        effective = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(visitDateStr))),
+        value = Observation.Value.Quantity(
+          Quantity(
+            value = Decimal(value = BigDecimal.fromInt(gaWeeks)),
+            unit = FhirString(value = "weeks"),
+            system = Uri(value = "http://unitsofmeasure.org"),
+            code = Code(value = "wk"),
+          )
+        ),
+      )
+      resourcesToCreate.add(gaObs)
+    }
+
+    if (dangerSigns.isNotEmpty()) {
+      val dsObs = Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        code = CodeableConcept(
+          coding = listOf(
+            Coding(
+              system = Uri(value = "urn:example:anc-danger-signs"),
+              code = Code(value = "danger-signs"),
+              display = FhirString(value = "Danger signs"),
+            )
+          ),
+          text = FhirString(value = "Danger signs"),
+        ),
+        subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+        encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")),
+        effective = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(visitDateStr))),
+        value = Observation.Value.String(FhirString(value = dangerSigns.joinToString(", "))),
+      )
+      resourcesToCreate.add(dsObs)
+    }
+
+    if (!notesStr.isNullOrBlank()) {
+      val notesObs = Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        code = CodeableConcept(
+          text = FhirString(value = "Visit notes"),
+        ),
+        subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+        encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")),
+        effective = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(visitDateStr))),
+        value = Observation.Value.String(FhirString(value = notesStr)),
+      )
+      resourcesToCreate.add(notesObs)
+    }
+
+    val completedResponse = response.toBuilder().apply {
+      id = UUID.randomUUID().toString()
+      status = Enumeration(value = QuestionnaireResponse.QuestionnaireResponseStatus.Completed)
+      subject = Reference(reference = FhirString(value = "Patient/$patientId")).toBuilder()
+      questionnaire = Canonical(value = "http://example.org/fhir/Questionnaire/anc-contact").toBuilder()
+    }.build()
+    resourcesToCreate.add(completedResponse)
+
+    // Save locally to SQLite / Room via FHIR Engine
+    engine.create(*resourcesToCreate.toTypedArray())
+
+    // Queue one-time sync to push local changes to server
+    Sync.oneTimeSync<AppSyncWorker>(
+      context.applicationContext,
+      existingWorkPolicy = ExistingWorkPolicy.APPEND_OR_REPLACE,
+    )
+  }
+}
