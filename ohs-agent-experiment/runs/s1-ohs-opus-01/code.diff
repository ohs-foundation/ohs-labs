+package com.example.ancapp.ui
+
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.padding
+import androidx.compose.material3.ExperimentalMaterial3Api
+import androidx.compose.material3.Scaffold
+import androidx.compose.material3.Text
+import androidx.compose.material3.TextButton
+import androidx.compose.material3.TopAppBar
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.CompositionLocalProvider
+import androidx.compose.runtime.DisposableEffect
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.ui.Modifier
+import androidx.lifecycle.ViewModelStore
+import androidx.lifecycle.ViewModelStoreOwner
+import androidx.lifecycle.viewmodel.compose.LocalViewModelStoreOwner
+import dev.ohs.fhir.datacapture.Questionnaire
+import dev.ohs.fhir.datacapture.QuestionnaireConfig
+import dev.ohs.fhir.datacapture.theme.QuestionnaireTheme
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import kotlinx.coroutines.launch
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun NewVisitScreen(
+  patientName: String,
+  questionnaireJson: String?,
+  onCancel: () -> Unit,
+  onSubmit: (QuestionnaireResponse) -> Unit,
+) {
+  Scaffold(
+    topBar = {
+      TopAppBar(
+        title = { Text("ANC visit — $patientName") },
+        navigationIcon = { TextButton(onClick = onCancel) { Text("Cancel") } },
+      )
+    },
+  ) { padding ->
+    Box(Modifier.padding(padding).fillMaxSize()) {
+      if (questionnaireJson == null) {
+        CenteredProgress()
+      } else {
+        FormViewModelStore {
+          val scope = rememberCoroutineScope()
+          QuestionnaireTheme {
+            Questionnaire(
+              questionnaireJson = questionnaireJson,
+              config =
+                QuestionnaireConfig(
+                  showCancelButton = false,
+                  submitButtonText = "Save visit",
+                  // A visit without a date cannot be filed, so the required question must be answered.
+                  showSubmitAnywayWhenValidationFails = false,
+                ),
+              // The library hands back a suspending accessor that validates before answering.
+              onSubmit = { readResponse -> scope.launch { onSubmit(readResponse()) } },
+              onCancel = onCancel,
+            )
+          }
+        }
+      }
+    }
+  }
+}
+
+/**
+ * The Data Capture library keeps the answers in a [androidx.lifecycle.ViewModel]. Scoping it to a
+ * store of its own means each visit starts from a blank form rather than the previous one.
+ */
+@Composable
+private fun FormViewModelStore(content: @Composable () -> Unit) {
+  val owner = remember {
+    object : ViewModelStoreOwner {
+      override val viewModelStore = ViewModelStore()
+    }
+  }
+  DisposableEffect(owner) { onDispose { owner.viewModelStore.clear() } }
+  CompositionLocalProvider(LocalViewModelStoreOwner provides owner, content = content)
+}
