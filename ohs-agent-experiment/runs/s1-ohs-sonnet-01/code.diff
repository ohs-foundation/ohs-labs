+import com.example.ancapp.data.AncRepository
+import com.example.ancapp.data.VisitSummary
+import java.time.format.DateTimeFormatter
+
+private val dateFormatter = DateTimeFormatter.ofPattern("d MMM yyyy")
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun PatientDetailScreen(patientId: String, onBack: () -> Unit, onAddVisit: () -> Unit) {
+  val context = LocalContext.current
+  var patientName by remember { mutableStateOf("") }
+  var visits by remember { mutableStateOf<List<VisitSummary>>(emptyList()) }
+  var loading by remember { mutableStateOf(true) }
+
+  LaunchedEffect(patientId) {
+    loading = true
+    patientName = AncRepository.patientName(context, patientId)
+    visits = AncRepository.loadVisits(context, patientId)
+    loading = false
+  }
+
+  Scaffold(
+    topBar = {
+      TopAppBar(
+        title = { Text(patientName.ifBlank { "Patient" }) },
+        navigationIcon = {
+          IconButton(onClick = onBack) {
+            Icon(Icons.Filled.ArrowBack, contentDescription = "Back")
+          }
+        },
+      )
+    },
+    floatingActionButton = {
+      FloatingActionButton(onClick = onAddVisit) {
+        Icon(Icons.Filled.Add, contentDescription = "Record new ANC visit")
+      }
+    },
+  ) { padding ->
+    Box(modifier = Modifier.fillMaxSize().padding(padding)) {
+      if (loading) {
+        CircularProgressIndicator(modifier = Modifier.align(Alignment.Center))
+      } else if (visits.isEmpty()) {
+        Text(
+          "No ANC visits recorded yet.",
+          modifier = Modifier.align(Alignment.Center).padding(24.dp),
+        )
+      } else {
+        LazyColumn(modifier = Modifier.fillMaxSize().padding(12.dp)) {
+          items(visits, key = { it.encounterId }) { visit -> VisitRow(visit) }
+        }
+      }
+    }
+  }
+}
+
+@Composable
+private fun VisitRow(visit: VisitSummary) {
+  Card(modifier = Modifier.fillMaxWidth().padding(vertical = 6.dp)) {
+    Column(modifier = Modifier.padding(16.dp)) {
+      Text(dateFormatter.format(visit.date), style = MaterialTheme.typography.titleMedium)
+
+      Row(
+        modifier = Modifier.fillMaxWidth().padding(top = 8.dp),
+        horizontalArrangement = Arrangement.SpaceBetween,
+      ) {
+        Text(visit.weightKg?.let { "Weight: $it kg" } ?: "Weight: -")
+        Text(
+          if (visit.systolic != null && visit.diastolic != null) {
+            "BP: ${visit.systolic}/${visit.diastolic} mmHg"
+          } else {
+            "BP: -"
+          },
+        )
+      }
+
+      Text(
+        visit.hemoglobin?.let { "Hemoglobin: $it g/dL" } ?: "Hemoglobin: not recorded",
+        modifier = Modifier.padding(top = 4.dp),
+      )
+
+      visit.gestationalAgeWeeks?.let {
+        Text("Gestational age: $it weeks", modifier = Modifier.padding(top = 4.dp))
+      }
+
+      if (visit.dangerSigns.isNotEmpty()) {
+        Text(
+          "Danger signs: ${visit.dangerSigns.joinToString(", ")}",
+          modifier = Modifier.padding(top = 4.dp),
+          color = MaterialTheme.colorScheme.error,
+        )
+      }
+
+      visit.notes?.takeIf { it.isNotBlank() }?.let {
+        Text("Notes: $it", modifier = Modifier.padding(top = 4.dp))
+      }
+    }
+  }
+}
