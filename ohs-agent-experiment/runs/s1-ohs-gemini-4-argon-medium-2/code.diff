+package com.example.ancapp
+
+import android.app.Application
+import androidx.lifecycle.AndroidViewModel
+import androidx.lifecycle.viewModelScope
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+
+sealed interface Screen {
+  data object Register : Screen
+
+  data class PatientDetail(val patientId: String) : Screen
+
+  data class NewVisit(val patientId: String) : Screen
+}
+
+data class AncUiState(
+  val currentScreen: Screen = Screen.Register,
+  val patients: List<PatientSummary> = emptyList(),
+  val selectedPatientDetail: PatientDetail? = null,
+  val questionnaireJson: String? = null,
+  val isLoading: Boolean = true,
+  val isSyncing: Boolean = false,
+  val isSaving: Boolean = false,
+  val errorMessage: String? = null,
+)
+
+class AncViewModel(application: Application) : AndroidViewModel(application) {
+
+  private val repository = AncRepository.getInstance(application)
+
+  private val _uiState = MutableStateFlow(AncUiState())
+  val uiState: StateFlow<AncUiState> = _uiState.asStateFlow()
+
+  init {
+    initialLoadAndSync()
+  }
+
+  private fun initialLoadAndSync() {
+    viewModelScope.launch {
+      // Load local database state first (for instant display on restart)
+      val localPatients = repository.getPregnantPatients()
+      val localQuestionnaire = repository.getAncContactQuestionnaireJson()
+      _uiState.update {
+        it.copy(
+          patients = localPatients,
+          questionnaireJson = localQuestionnaire,
+          isLoading = localPatients.isEmpty(),
+          isSyncing = true,
+        )
+      }
+
+      // Sync with FHIR server and refresh
+      repository.syncWithServer()
+      val syncedPatients = repository.getPregnantPatients()
+      val syncedQuestionnaire = repository.getAncContactQuestionnaireJson()
+      val currentScreen = _uiState.value.currentScreen
+      val updatedDetail =
+        when (currentScreen) {
+          is Screen.PatientDetail -> repository.getPatientDetail(currentScreen.patientId)
+          is Screen.NewVisit -> repository.getPatientDetail(currentScreen.patientId)
+          Screen.Register -> _uiState.value.selectedPatientDetail
+        }
+
+      _uiState.update {
+        it.copy(
+          patients = syncedPatients,
+          selectedPatientDetail = updatedDetail,
+          questionnaireJson = syncedQuestionnaire,
+          isLoading = false,
+          isSyncing = false,
+          errorMessage =
+            if (syncedPatients.isEmpty()) "Unable to load patients from FHIR server." else null,
+        )
+      }
+    }
+  }
+
+  fun refresh() {
+    viewModelScope.launch {
+      _uiState.update { it.copy(isSyncing = true, errorMessage = null) }
+      repository.syncWithServer()
+      val patients = repository.getPregnantPatients()
+      val currentScreen = _uiState.value.currentScreen
+      val detail =
+        when (currentScreen) {
+          is Screen.PatientDetail -> repository.getPatientDetail(currentScreen.patientId)
+          is Screen.NewVisit -> repository.getPatientDetail(currentScreen.patientId)
+          Screen.Register -> null
+        }
+      _uiState.update {
+        it.copy(
+          patients = patients,
+          selectedPatientDetail = detail ?: it.selectedPatientDetail,
+          isLoading = false,
+          isSyncing = false,
+        )
+      }
+    }
+  }
+
+  fun openPatientDetail(patientId: String) {
+    viewModelScope.launch {
+      val detail = repository.getPatientDetail(patientId)
+      _uiState.update {
+        it.copy(
+          currentScreen = Screen.PatientDetail(patientId),
+          selectedPatientDetail = detail,
+        )
+      }
+    }
+  }
+
+  fun openNewVisitForm(patientId: String) {
+    viewModelScope.launch {
+      val qJson = _uiState.value.questionnaireJson ?: repository.getAncContactQuestionnaireJson()
+      _uiState.update {
+        it.copy(
+          currentScreen = Screen.NewVisit(patientId),
+          questionnaireJson = qJson,
+        )
+      }
+    }
+  }
+
+  fun saveVisit(patientId: String, response: QuestionnaireResponse) {
+    if (_uiState.value.isSaving) return
+    viewModelScope.launch {
+      _uiState.update { it.copy(isSaving = true) }
+      try {
+        repository.saveAncVisit(patientId, response)
+        val updatedPatients = repository.getPregnantPatients()
+        val updatedDetail = repository.getPatientDetail(patientId)
+        _uiState.update {
+          it.copy(
+            currentScreen = Screen.PatientDetail(patientId),
+            patients = updatedPatients,
+            selectedPatientDetail = updatedDetail,
+            isSaving = false,
+          )
+        }
+        // Upload local changes to the FHIR server in the background
+        launch { repository.syncWithServer() }
+      } catch (e: Exception) {
+        _uiState.update {
+          it.copy(
+            isSaving = false,
+            errorMessage = "Failed to save visit: ${e.message}",
+          )
+        }
+      }
+    }
+  }
+
+  fun navigateBack(): Boolean {
+    return when (val screen = _uiState.value.currentScreen) {
+      is Screen.NewVisit -> {
+        openPatientDetail(screen.patientId)
+        true
+      }
+      is Screen.PatientDetail -> {
+        _uiState.update { it.copy(currentScreen = Screen.Register) }
+        true
+      }
+      Screen.Register -> false
+    }
+  }
+}
