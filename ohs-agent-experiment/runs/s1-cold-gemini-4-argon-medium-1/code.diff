+@OptIn(ExperimentalMaterial3Api::class, ExperimentalLayoutApi::class)
+@Composable
+fun RecordVisitScreen(
+  patientWithVisits: PatientWithVisits,
+  onCancelClick: () -> Unit,
+  onSaveVisit: (AncVisit) -> Unit
+) {
+  val patient = patientWithVisits.patient
+  val context = LocalContext.current
+  val today = remember { LocalDate.now() }
+  val suggestedWeeks = remember(patient) { patient.currentPregnancyWeeks(today) }
+
+  var visitDateText by rememberSaveable { mutableStateOf(today.toString()) }
+  var gestationalWeeksText by rememberSaveable { mutableStateOf("") }
+  var weightKgText by rememberSaveable { mutableStateOf("") }
+  var systolicBpText by rememberSaveable { mutableStateOf("") }
+  var diastolicBpText by rememberSaveable { mutableStateOf("") }
+  var hemoglobinText by rememberSaveable { mutableStateOf("") }
+  var notesText by rememberSaveable { mutableStateOf("") }
+
+  val selectedDangerSigns = remember {
+    mutableStateListOf(DangerSign.NONE)
+  }
+
+  var errorMessage by rememberSaveable { mutableStateOf<String?>(null) }
+
+  fun toggleDangerSign(sign: DangerSign) {
+    if (sign == DangerSign.NONE) {
+      selectedDangerSigns.clear()
+      selectedDangerSigns.add(DangerSign.NONE)
+    } else {
+      selectedDangerSigns.remove(DangerSign.NONE)
+      if (selectedDangerSigns.contains(sign)) {
+        selectedDangerSigns.remove(sign)
+        if (selectedDangerSigns.isEmpty()) {
+          selectedDangerSigns.add(DangerSign.NONE)
+        }
+      } else {
+        selectedDangerSigns.add(sign)
+      }
+    }
+  }
+
+  fun openDatePicker() {
+    val initialDate = parseFlexibleDate(visitDateText) ?: today
+    DatePickerDialog(
+      context,
+      { _, year, month, dayOfMonth ->
+        visitDateText = LocalDate.of(year, month + 1, dayOfMonth).toString()
+      },
+      initialDate.year,
+      initialDate.monthValue - 1,
+      initialDate.dayOfMonth
+    ).show()
+  }
+
+  fun handleSave() {
+    val parsedDate = if (visitDateText.isBlank()) {
+      today
+    } else {
+      parseFlexibleDate(visitDateText)
+    }
+    if (parsedDate == null) {
+      errorMessage = "Please enter a valid visit date (YYYY-MM-DD)."
+      return
+    }
+
+    val gaWeeks = if (gestationalWeeksText.isBlank()) {
+      Patient.calculateGestationalWeeks(patient.estimatedDueDate, parsedDate)
+    } else {
+      gestationalWeeksText.trim().toIntOrNull()
+    }
+    if (gaWeeks == null || gaWeeks !in 1..48) {
+      errorMessage = "Please enter a valid gestational age in weeks (1-48)."
+      return
+    }
+
+    val weight = weightKgText.trim().toDoubleOrNull()
+    if (weight == null || weight <= 0.0) {
+      errorMessage = "Please enter a valid weight in kg."
+      return
+    }
+
+    val systolic = systolicBpText.trim().toIntOrNull()
+    val diastolic = diastolicBpText.trim().toIntOrNull()
+    if (systolic == null || systolic <= 0 || diastolic == null || diastolic <= 0) {
+      errorMessage = "Please enter valid systolic and diastolic blood pressure (mmHg)."
+      return
+    }
+
+    val hb: Double? = if (hemoglobinText.isBlank()) {
+      null
+    } else {
+      val parsedHb = hemoglobinText.trim().toDoubleOrNull()
+      if (parsedHb == null || parsedHb <= 0.0) {
+        errorMessage = "Please enter a valid hemoglobin value (g/dL) or leave blank."
+        return
+      }
+      parsedHb
+    }
+
+    errorMessage = null
+    onSaveVisit(
+      AncVisit(
+        patientId = patient.id,
+        visitDate = parsedDate,
+        gestationalAgeWeeks = gaWeeks,
+        weightKg = weight,
+        systolicBp = systolic,
+        diastolicBp = diastolic,
+        hemoglobinGdl = hb,
+        dangerSigns = selectedDangerSigns.toList(),
+        notes = notesText.trim()
+      )
+    )
+  }
+
+  Scaffold(
+    topBar = {
+      TopAppBar(
+        title = {
+          Column {
+            Text(
+              text = "Record ANC Visit",
+              style = MaterialTheme.typography.titleLarge,
+              fontWeight = FontWeight.Bold
+            )
+            Text(
+              text = "${patient.name} • Due ${patient.estimatedDueDate}",
+              style = MaterialTheme.typography.labelMedium,
+              color = MaterialTheme.colorScheme.onPrimary.copy(alpha = 0.85f)
+            )
+          }
+        },
+        navigationIcon = {
+          IconButton(
+            onClick = onCancelClick,
+            modifier = Modifier.testTag("cancel_visit_button")
+          ) {
+            Icon(
+              imageVector = Icons.AutoMirrored.Filled.ArrowBack,
+              contentDescription = "Back",
+              tint = MaterialTheme.colorScheme.onPrimary
+            )
+          }
+        },
+        colors = TopAppBarDefaults.topAppBarColors(
+          containerColor = MaterialTheme.colorScheme.primary,
+          titleContentColor = MaterialTheme.colorScheme.onPrimary
+        )
+      )
+    },
+    bottomBar = {
+      Surface(
+        tonalElevation = 4.dp,
+        shadowElevation = 6.dp,
+        color = MaterialTheme.colorScheme.surface
+      ) {
+        Row(
+          modifier = Modifier
+            .fillMaxWidth()
+            .padding(horizontal = 16.dp, vertical = 10.dp),
+          horizontalArrangement = Arrangement.spacedBy(12.dp)
+        ) {
+          OutlinedButton(
+            onClick = onCancelClick,
+            modifier = Modifier.weight(1f),
+            shape = RoundedCornerShape(10.dp)
+          ) {
+            Text("Cancel")
+          }
+          Button(
+            onClick = { handleSave() },
+            modifier = Modifier
+              .weight(2f)
+              .testTag("save_visit_button"),
+            shape = RoundedCornerShape(10.dp)
+          ) {
+            Text(
+              text = "Save Visit",
+              fontWeight = FontWeight.Bold
+            )
+          }
+        }
+      }
+    }
+  ) { innerPadding ->
+    Column(
+      modifier = Modifier
+        .fillMaxSize()
+        .padding(innerPadding)
+        .verticalScroll(rememberScrollState())
+        .padding(horizontal = 16.dp, vertical = 12.dp),
+      verticalArrangement = Arrangement.spacedBy(10.dp)
+    ) {
+      if (errorMessage != null) {
+        Surface(
