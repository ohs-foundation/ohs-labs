+package com.example.ancapp
+
+import org.json.JSONArray
+import org.json.JSONObject
+import java.net.HttpURLConnection
+import java.net.URL
+import java.time.LocalDate
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+
+const val BASE = "http://10.0.2.2:8080/fhir"
+
+data class Patient(val id: String, val name: String, val birthDate: LocalDate?, val edd: LocalDate?) {
+  val age get() = birthDate?.let { ChronoUnit.YEARS.between(it, LocalDate.now()) }
+  // Gestational weeks = weeks since LMP, LMP = EDD - 280 days (Naegele)
+  val weeks get() = edd?.let { ChronoUnit.DAYS.between(it.minusDays(280), LocalDate.now()) / 7 }
+}
+
+data class Visit(val date: String, val weight: Double?, val systolic: Double?, val diastolic: Double?, val hb: Double?)
+
+fun http(method: String, path: String, body: String? = null): JSONObject {
+  val c = URL("$BASE/$path").openConnection() as HttpURLConnection
+  c.requestMethod = method
+  c.setRequestProperty("Accept", "application/fhir+json")
+  if (body != null) {
+    c.setRequestProperty("Content-Type", "application/fhir+json")
+    c.doOutput = true
+    c.outputStream.use { it.write(body.toByteArray()) }
+  }
+  val text = (if (c.responseCode < 400) c.inputStream else c.errorStream).bufferedReader().readText()
+  if (c.responseCode >= 400) error("HTTP ${c.responseCode}: $text")
+  return JSONObject(text)
+}
+
+fun JSONObject.entries(): List<JSONObject> =
+  optJSONArray("entry")?.let { a -> List(a.length()) { a.getJSONObject(it).getJSONObject("resource") } } ?: emptyList()
+
+fun JSONArray.objs() = List(length()) { getJSONObject(it) }
+
+private fun JSONObject.loinc(): String? =
+  optJSONObject("code")?.optJSONArray("coding")?.objs()?.firstOrNull()?.optString("code")
+
+private fun JSONObject.qty(): Double? = optJSONObject("valueQuantity")?.optDouble("value")
+
+fun loadPatients(): List<Patient> {
+  val edds = http("GET", "Observation?code=http://loinc.org|11778-8&_count=200").entries()
+    .associate { it.getJSONObject("subject").getString("reference") to it.optString("valueDateTime") }
+  return http("GET", "Patient?_count=200").entries().map { p ->
+    val n = p.optJSONArray("name")?.objs()?.firstOrNull()
+    val given = n?.optJSONArray("given")?.let { g -> List(g.length()) { g.getString(it) } }?.joinToString(" ") ?: ""
+    Patient(
+      id = p.getString("id"),
+      name = "$given ${n?.optString("family") ?: ""}".trim(),
+      birthDate = p.optString("birthDate").takeIf { it.isNotEmpty() }?.let(LocalDate::parse),
+      edd = edds["Patient/${p.getString("id")}"]?.takeIf { it.isNotEmpty() }?.let { LocalDate.parse(it.take(10)) },
+    )
+  }.sortedWith(compareBy(nullsLast()) { it.edd })
+}
+
+fun loadVisits(patientId: String): List<Visit> {
+  val encounters = http("GET", "Encounter?subject=Patient/$patientId&_count=200").entries()
+  val obsByEnc = http("GET", "Observation?subject=Patient/$patientId&_count=500").entries()
+    .groupBy { it.optJSONObject("encounter")?.optString("reference") }
+  return encounters.map { e ->
+    val obs = obsByEnc["Encounter/${e.getString("id")}"] ?: emptyList()
+    val bp = obs.firstOrNull { it.loinc() == "85354-9" }?.optJSONArray("component")?.objs() ?: emptyList()
+    Visit(
+      date = e.optJSONObject("period")?.optString("start")?.take(10) ?: "",
+      weight = obs.firstOrNull { it.loinc() == "29463-7" }?.qty(),
+      systolic = bp.firstOrNull { it.loinc() == "8480-6" }?.qty(),
+      diastolic = bp.firstOrNull { it.loinc() == "8462-4" }?.qty(),
+      hb = obs.firstOrNull { it.loinc() == "718-7" }?.qty(),
+    )
+  }.sortedByDescending { it.date }
+}
+
+fun loadQuestionnaire(): JSONObject = http("GET", "Questionnaire/anc-contact")
+
+/** answers: linkId -> text for simple items, linkId -> Set<code> for choice items. */
+fun saveVisit(patientId: String, questionnaire: JSONObject, answers: Map<String, Any>) {
+  val date = answers["visit-date"] as String
+  val encUrl = "urn:uuid:${UUID.randomUUID()}"
+  val subject = JSONObject().put("reference", "Patient/$patientId")
+  val encounterRef = JSONObject().put("reference", encUrl)
+
+  fun obs(code: String, display: String, value: Double, unit: String, ucum: String) = JSONObject()
+    .put("resourceType", "Observation").put("status", "final")
+    .put("category", JSONArray().put(JSONObject().put("coding", JSONArray().put(JSONObject()
+      .put("system", "http://terminology.hl7.org/CodeSystem/observation-category").put("code", "vital-signs")))))
+    .put("code", JSONObject().put("coding", JSONArray().put(JSONObject().put("system", "http://loinc.org").put("code", code).put("display", display))))
+    .put("subject", subject).put("encounter", encounterRef).put("effectiveDateTime", date)
+    .put("valueQuantity", JSONObject().put("value", value).put("unit", unit).put("system", "http://unitsofmeasure.org").put("code", ucum))
+
+  val resources = mutableListOf<Pair<String, JSONObject>>()
+  resources += encUrl to JSONObject().put("resourceType", "Encounter").put("status", "finished")
+    .put("class", JSONObject().put("system", "http://terminology.hl7.org/CodeSystem/v3-ActCode").put("code", "AMB"))
+    .put("type", JSONArray().put(JSONObject().put("text", "Antenatal care contact")))
+    .put("subject", subject).put("period", JSONObject().put("start", date).put("end", date))
+
+  (answers["weight"] as? String)?.toDoubleOrNull()?.let {
+    resources += "urn:uuid:${UUID.randomUUID()}" to obs("29463-7", "Body weight", it, "kg", "kg")
+  }
+  val sys = (answers["bp-systolic"] as? String)?.toDoubleOrNull()
+  val dia = (answers["bp-diastolic"] as? String)?.toDoubleOrNull()
+  if (sys != null || dia != null) {
+    val comps = JSONArray()
+    sys?.let { comps.put(obs("8480-6", "Systolic blood pressure", it, "mmHg", "mm[Hg]").let { o -> JSONObject().put("code", o.get("code")).put("valueQuantity", o.get("valueQuantity")) }) }
+    dia?.let { comps.put(obs("8462-4", "Diastolic blood pressure", it, "mmHg", "mm[Hg]").let { o -> JSONObject().put("code", o.get("code")).put("valueQuantity", o.get("valueQuantity")) }) }
+    resources += "urn:uuid:${UUID.randomUUID()}" to obs("85354-9", "Blood pressure panel", 0.0, "", "")
+      .apply { remove("valueQuantity"); put("component", comps) }
+  }
+
+  // QuestionnaireResponse mirrors the Questionnaire tree
+  fun qrItems(items: JSONArray): JSONArray {
+    val out = JSONArray()
+    for (q in items.objs()) {
+      val id = q.getString("linkId")
+      val item = JSONObject().put("linkId", id).put("text", q.optString("text"))
+      when (q.getString("type")) {
+        "group" -> { val kids = qrItems(q.getJSONArray("item")); if (kids.length() > 0) out.put(item.put("item", kids)) }
+        "choice" -> {
+          val codes = answers[id] as? Set<*> ?: emptySet<Any>()
+          val opts = q.getJSONArray("answerOption").objs().map { it.getJSONObject("valueCoding") }
+          val ans = JSONArray()
+          opts.filter { it.getString("code") in codes }.forEach { ans.put(JSONObject().put("valueCoding", it)) }
+          if (ans.length() > 0) out.put(item.put("answer", ans))
+        }
+        else -> {
+          val v = (answers[id] as? String)?.trim().orEmpty()
+          if (v.isEmpty()) continue
+          val a = when (q.getString("type")) {
+            "date" -> JSONObject().put("valueDate", v)
+            "integer" -> v.toIntOrNull()?.let { JSONObject().put("valueInteger", it) }
+            "decimal" -> v.toDoubleOrNull()?.let { JSONObject().put("valueDecimal", it) }
+            else -> JSONObject().put("valueString", v)
+          } ?: continue
+          out.put(item.put("answer", JSONArray().put(a)))
+        }
+      }
+    }
+    return out
+  }
+  resources += "urn:uuid:${UUID.randomUUID()}" to JSONObject().put("resourceType", "QuestionnaireResponse")
+    .put("questionnaire", questionnaire.optString("url")).put("status", "completed")
+    .put("subject", subject).put("encounter", encounterRef).put("authored", date)
+    .put("item", qrItems(questionnaire.getJSONArray("item")))
+
+  val bundle = JSONObject().put("resourceType", "Bundle").put("type", "transaction").put("entry", JSONArray().apply {
+    resources.forEach { (url, r) ->
+      put(JSONObject().put("fullUrl", url).put("resource", r)
+        .put("request", JSONObject().put("method", "POST").put("url", r.getString("resourceType"))))
+    }
+  })
+  http("POST", "", bundle.toString())
+}
