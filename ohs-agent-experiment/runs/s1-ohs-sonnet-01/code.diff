+++ b/app/src/main/java/com/example/ancapp/data/FhirBuilders.kt
@@ -0,0 +1,60 @@
+package com.example.ancapp.data
+
+import com.ionspin.kotlin.bignum.decimal.BigDecimal as IonBigDecimal
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.CodeableConcept
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.Decimal
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Quantity
+import dev.ohs.fhir.model.r4.Uri
+import dev.ohs.fhir.model.r4.String as FhirString
+
+const val LOINC = "http://loinc.org"
+const val UCUM = "http://unitsofmeasure.org"
+
+const val LOINC_EDD = "11778-8"
+const val LOINC_WEIGHT = "29463-7"
+const val LOINC_BP_PANEL = "85354-9"
+const val LOINC_SYSTOLIC = "8480-6"
+const val LOINC_DIASTOLIC = "8462-4"
+const val LOINC_HB = "718-7"
+
+const val TEXT_GESTATIONAL_AGE = "Gestational age"
+const val TEXT_DANGER_SIGN = "Danger sign"
+const val TEXT_NOTES = "Notes"
+
+fun loincConcept(code: String, display: String): CodeableConcept =
+  CodeableConcept(
+    coding = listOf(Coding(system = Uri(value = LOINC), code = Code(value = code), display = FhirString(value = display))),
+    text = FhirString(value = display),
+  )
+
+fun textOnlyConcept(text: String): CodeableConcept = CodeableConcept(text = FhirString(value = text))
+
+fun vitalSignsCategory(): CodeableConcept =
+  CodeableConcept(
+    coding = listOf(
+      Coding(
+        system = Uri(value = "http://terminology.hl7.org/CodeSystem/observation-category"),
+        code = Code(value = "vital-signs"),
+        display = FhirString(value = "Vital Signs"),
+      ),
+    ),
+  )
+
+fun quantityOf(value: IonBigDecimal, unit: String, ucumCode: String): Quantity =
+  Quantity(
+    value = Decimal(value = value),
+    unit = FhirString(value = unit),
+    system = Uri(value = UCUM),
+    code = Code(value = ucumCode),
+  )
+
+fun Observation.hasLoincCode(code: String): Boolean =
+  this.code.coding.any { it.system?.value == LOINC && it.code?.value == code }
+
+fun Observation.hasText(text: String): Boolean = this.code.text?.value == text
+
+fun Observation.Component.hasLoincCode(code: String): Boolean =
+  this.code?.coding.orEmpty().any { it.system?.value == LOINC && it.code?.value == code }
