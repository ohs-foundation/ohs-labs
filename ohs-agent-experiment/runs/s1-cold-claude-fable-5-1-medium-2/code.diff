+package com.example.ancapp
+
+import android.content.ContentValues
+import android.content.Context
+import android.database.sqlite.SQLiteDatabase
+import android.database.sqlite.SQLiteOpenHelper
+import java.time.LocalDate
+import java.time.temporal.ChronoUnit
+
+data class Patient(val id: Long, val name: String, val dob: LocalDate, val dueDate: LocalDate) {
+  val age get() = ChronoUnit.YEARS.between(dob, LocalDate.now()).toInt()
+  /** Gestational weeks on [on], from a 280-day term. */
+  fun weeksOn(on: LocalDate = LocalDate.now()) =
+    ChronoUnit.DAYS.between(dueDate.minusDays(280), on).toInt() / 7
+}
+
+data class Visit(
+  val id: Long = 0,
+  val patientId: Long,
+  val date: LocalDate,
+  val gaWeeks: Int,
+  val weightKg: Double,
+  val systolic: Int,
+  val diastolic: Int,
+  val hb: Double?,
+  val dangerSigns: List<String>,
+  val notes: String,
+)
+
+val DANGER_SIGNS = listOf("Vaginal bleeding", "Severe headache", "Blurred vision", "Fever")
+
+class Db(ctx: Context) : SQLiteOpenHelper(ctx, "anc.db", null, 1) {
+  override fun onCreate(db: SQLiteDatabase) {
+    db.execSQL("CREATE TABLE patient(id INTEGER PRIMARY KEY, name TEXT, dob TEXT, due TEXT)")
+    db.execSQL(
+      "CREATE TABLE visit(id INTEGER PRIMARY KEY, patient_id INTEGER REFERENCES patient(id), " +
+        "date TEXT, ga INTEGER, weight REAL, sys INTEGER, dia INTEGER, hb REAL, signs TEXT, notes TEXT)"
+    )
+    // Seed: name, dob, due, last visit date, weight, sys, dia, hb
+    listOf(
+      listOf("Emily Carter", "1996-04-12", "2026-12-05", "2026-08-10", 68.5, 118, 76, 11.8),
+      listOf("Sarah Mitchell", "1990-11-02", "2027-01-20", "2026-08-12", 61.2, 110, 70, 12.4),
+      listOf("Grace Thompson", "2001-07-30", "2026-10-15", "2026-08-05", 72.0, 128, 84, 10.2),
+    ).forEach { r ->
+      val p = Patient(0, r[0] as String, LocalDate.parse(r[1] as String), LocalDate.parse(r[2] as String))
+      val id = db.insert("patient", null, ContentValues().apply {
+        put("name", p.name); put("dob", p.dob.toString()); put("due", p.dueDate.toString())
+      })
+      val d = LocalDate.parse(r[3] as String)
+      insert(db, Visit(0, id, d, p.weeksOn(d), r[4] as Double, r[5] as Int, r[6] as Int, r[7] as Double, emptyList(), ""))
+    }
+  }
+
+  override fun onUpgrade(db: SQLiteDatabase, old: Int, new: Int) {}
+
+  fun patients(): List<Patient> = readableDatabase.query("patient", null, null, null, null, null, "due").use { c ->
+    buildList {
+      while (c.moveToNext()) add(
+        Patient(c.getLong(0), c.getString(1), LocalDate.parse(c.getString(2)), LocalDate.parse(c.getString(3)))
+      )
+    }
+  }
+
+  fun visits(patientId: Long): List<Visit> = readableDatabase.query(
+    "visit", null, "patient_id=?", arrayOf(patientId.toString()), null, null, "date DESC"
+  ).use { c ->
+    buildList {
+      while (c.moveToNext()) add(
+        Visit(
+          c.getLong(0), c.getLong(1), LocalDate.parse(c.getString(2)), c.getInt(3), c.getDouble(4),
+          c.getInt(5), c.getInt(6), if (c.isNull(7)) null else c.getDouble(7),
+          c.getString(8).split(",").filter { it.isNotEmpty() }, c.getString(9)
+        )
+      )
+    }
+  }
+
+  fun insert(v: Visit) = insert(writableDatabase, v)
+
+  private fun insert(db: SQLiteDatabase, v: Visit) = db.insert("visit", null, ContentValues().apply {
+    put("patient_id", v.patientId); put("date", v.date.toString()); put("ga", v.gaWeeks)
+    put("weight", v.weightKg); put("sys", v.systolic); put("dia", v.diastolic)
+    if (v.hb == null) putNull("hb") else put("hb", v.hb)
+    put("signs", v.dangerSigns.joinToString(",")); put("notes", v.notes)
+  })
+}
