+package com.example.ancapp.data
+
+import androidx.room.Dao
+import androidx.room.Insert
+import androidx.room.Query
+import kotlinx.coroutines.flow.Flow
+
+@Dao
+interface AncDao {
+
+  /** The register: everyone currently pregnant, soonest due date first. */
+  @Query("SELECT * FROM patients WHERE isPregnant = 1 ORDER BY estimatedDueDate ASC, name ASC")
+  fun observeRegister(): Flow<List<Patient>>
+
+  @Query("SELECT * FROM patients WHERE id = :patientId")
+  fun observePatient(patientId: Long): Flow<Patient?>
+
+  @Query("SELECT * FROM visits WHERE patientId = :patientId ORDER BY visitDate DESC, id DESC")
+  fun observeVisits(patientId: Long): Flow<List<AncVisit>>
+
+  @Insert
+  suspend fun insertVisit(visit: AncVisit): Long
+
+  @Insert
+  suspend fun insertPatient(patient: Patient): Long
+
+  @Query("SELECT COUNT(*) FROM patients")
+  suspend fun patientCount(): Int
+}
