+package com.example.ancapp
+
+import java.io.IOException
+import java.net.HttpURLConnection
+import java.net.URL
+import java.time.LocalDate
+import java.util.UUID
+import org.json.JSONArray
+import org.json.JSONObject
+
+// 10.0.2.2 is the Android emulator's alias for the host machine
+private const val BASE = "http://10.0.2.2:8080/fhir"
+private const val QUESTIONNAIRE_ID = "anc-contact"
+private const val LOINC = "http://loinc.org"
+private const val EDD_CODE = "11778-8"
+private const val WEIGHT_CODE = "29463-7"
+private const val BP_CODE = "85354-9"
+private const val SYS_CODE = "8480-6"
+private const val DIA_CODE = "8462-4"
+private const val HB_CODE = "718-7"
+
+data class Patient(val id: String, val name: String, val birthDate: LocalDate, val dueDate: LocalDate)
+
+data class Visit(
+  val date: LocalDate,
+  val weight: Double?,
+  val systolic: Double?,
+  val diastolic: Double?,
+  val hb: Double?,
+)
+
+data class Coding(val system: String, val code: String, val display: String)
+
+// One Questionnaire item. Groups have children; leaves have a type.
+data class QItem(
+  val linkId: String,
+  val text: String,
+  val type: String,
+  val required: Boolean,
+  val options: List<Coding>,
+  val children: List<QItem>,
+)
+
+// Pregnant = has an estimated due date Observation. Sorted soonest first.
+// ponytail: first page only (200 patients); follow link[next] when the clinic grows.
+fun loadRegister(): List<Patient> {
+  val patients = search("/Patient?_count=200").associateBy { it.getString("id") }
+  return search("/Observation?code=$LOINC|$EDD_CODE&_count=200").mapNotNull { obs ->
+    val id = obs.getJSONObject("subject").getString("reference").substringAfter("Patient/")
+    val p = patients[id] ?: return@mapNotNull null
+    Patient(
+      id = id,
+      name = humanName(p),
+      birthDate = LocalDate.parse(p.getString("birthDate")),
+      dueDate = LocalDate.parse(obs.getString("valueDateTime").take(10)),
+    )
+  }.sortedBy { it.dueDate }
+}
+
+// A visit is an Encounter; its vitals are Observations that reference it.
+fun loadVisits(patientId: String): List<Visit> {
+  val obs = search("/Observation?subject=Patient/$patientId&_count=500")
+  val byEncounter = obs.filter { it.has("encounter") }
+    .groupBy { it.getJSONObject("encounter").getString("reference") }
+  return search("/Encounter?subject=Patient/$patientId&_count=200").map { enc ->
+    val mine = byEncounter["Encounter/${enc.getString("id")}"].orEmpty()
+    val bp = mine.firstOrNull { codeOf(it) == BP_CODE }
+    Visit(
+      date = LocalDate.parse(enc.getJSONObject("period").getString("start").take(10)),
+      weight = valueOf(mine, WEIGHT_CODE),
+      systolic = bp?.let { component(it, SYS_CODE) },
+      diastolic = bp?.let { component(it, DIA_CODE) },
+      hb = valueOf(mine, HB_CODE),
+    )
+  }.sortedByDescending { it.date }
+}
+
+fun loadQuestionnaire(): List<QItem> =
+  call("GET", "$BASE/Questionnaire/$QUESTIONNAIRE_ID").optJSONArray("item").objects().map(::parseItem)
+
+// Writes Encounter + QuestionnaireResponse + vitals Observations in one transaction.
+// values is keyed by Questionnaire linkId; choice values are comma-joined codes.
+fun saveVisit(patientId: String, items: List<QItem>, values: Map<String, String>) {
+  val visitDate = values.getValue("visit-date").trim()
+  val encUrl = newUrl()
+  val subject = ref("Patient/$patientId")
+
+  val encounter = JSONObject()
+    .put("resourceType", "Encounter")
+    .put("status", "finished")
+    .put("class", coding("http://terminology.hl7.org/CodeSystem/v3-ActCode", "AMB", "ambulatory"))
+    .put("type", JSONArray().put(JSONObject().put("text", "Antenatal care contact")))
+    .put("subject", subject)
+    .put("period", JSONObject().put("start", visitDate).put("end", visitDate))
+
+  val observations = mutableListOf<JSONObject>()
+  fun vitalObs(code: JSONObject) = JSONObject()
+    .put("resourceType", "Observation")
+    .put("status", "final")
+    .put("category", JSONArray().put(concept(coding("http://terminology.hl7.org/CodeSystem/observation-category", "vital-signs", "Vital Signs"))))
+    .put("code", concept(code))
+    .put("subject", subject)
+    .put("encounter", ref(encUrl))
+    .put("effectiveDateTime", visitDate)
+
+  values["weight"]?.trim()?.takeIf { it.isNotEmpty() }?.let { w ->
+    observations += vitalObs(coding(LOINC, WEIGHT_CODE, "Body weight"))
+      .put("valueQuantity", quantity(w.toDouble(), "kg"))
+  }
+  val comps = JSONArray()
+  values["bp-systolic"]?.trim()?.takeIf { it.isNotEmpty() }?.let {
+    comps.put(bpComponent(coding(LOINC, SYS_CODE, "Systolic blood pressure"), it))
+  }
+  values["bp-diastolic"]?.trim()?.takeIf { it.isNotEmpty() }?.let {
+    comps.put(bpComponent(coding(LOINC, DIA_CODE, "Diastolic blood pressure"), it))
+  }
+  if (comps.length() > 0) {
+    observations += vitalObs(coding(LOINC, BP_CODE, "Blood pressure panel with all children optional"))
+      .put("component", comps)
+  }
+
+  val questionnaireResponse = JSONObject()
+    .put("resourceType", "QuestionnaireResponse")
+    .put("questionnaire", "Questionnaire/$QUESTIONNAIRE_ID")
+    .put("status", "completed")
+    .put("subject", subject)
+    .put("encounter", ref(encUrl))
+    .put("authored", visitDate)
+    .put("item", responseItems(items, values))
+
+  val entries = JSONArray()
+  fun add(url: String, resource: JSONObject) {
+    entries.put(
+      JSONObject()
+        .put("fullUrl", url)
+        .put("resource", resource)
+        .put("request", JSONObject().put("method", "POST").put("url", resource.getString("resourceType"))),
+    )
+  }
+  add(encUrl, encounter)
+  add(newUrl(), questionnaireResponse)
+  observations.forEach { add(newUrl(), it) }
+
+  call(
+    "POST",
+    BASE,
+    JSONObject().put("resourceType", "Bundle").put("type", "transaction").put("entry", entries),
+  )
+}
+
+// Returns human-readable problems; empty means the form can be saved.
+fun problems(items: List<QItem>, values: Map<String, String>): List<String> = items.flatMap { item ->
+  if (item.children.isNotEmpty()) return@flatMap problems(item.children, values)
+  val v = values[item.linkId].orEmpty().trim()
+  when {
+    v.isEmpty() -> if (item.required) listOf("${item.text} is required") else emptyList()
+    item.type == "integer" && v.toIntOrNull() == null -> listOf("${item.text} must be a whole number")
+    item.type == "decimal" && v.toDoubleOrNull() == null -> listOf("${item.text} must be a number")
+    item.type == "date" && runCatching { LocalDate.parse(v) }.isFailure -> listOf("${item.text} must be YYYY-MM-DD")
+    else -> emptyList()
+  }
+}
+
+private fun search(path: String): List<JSONObject> =
+  call("GET", BASE + path).optJSONArray("entry").objects().map { it.getJSONObject("resource") }
+
+private fun call(method: String, url: String, body: JSONObject? = null): JSONObject {
+  val conn = URL(url).openConnection() as HttpURLConnection
+  try {
+    conn.requestMethod = method
+    conn.connectTimeout = 10_000
+    conn.readTimeout = 15_000
+    conn.setRequestProperty("Accept", "application/fhir+json")
+    if (body != null) {
+      conn.doOutput = true
+      conn.setRequestProperty("Content-Type", "application/fhir+json")
+      conn.outputStream.use { it.write(body.toString().toByteArray()) }
+    }
+    val code = conn.responseCode
+    val stream = if (code in 200..299) conn.inputStream else conn.errorStream
+    val text = stream?.bufferedReader()?.use { it.readText() }.orEmpty()
+    if (code !in 200..299) throw IOException("FHIR server returned HTTP $code: ${text.take(200)}")
+    return JSONObject(text)
+  } finally {
+    conn.disconnect()
+  }
+}
+
+private fun JSONArray?.objects(): List<JSONObject> =
+  this?.let { arr -> (0 until arr.length()).map { arr.getJSONObject(it) } }.orEmpty()
+
+private fun humanName(p: JSONObject): String {
+  val n = p.getJSONArray("name").getJSONObject(0)
+  val given = n.optJSONArray("given")?.optString(0).orEmpty()
+  return "$given ${n.optString("family")}".trim()
+}
+
+private fun codeOf(o: JSONObject): String =
+  o.getJSONObject("code").getJSONArray("coding").getJSONObject(0).getString("code")
+
+private fun valueOf(obs: List<JSONObject>, code: String): Double? =
+  obs.firstOrNull { codeOf(it) == code }?.optJSONObject("valueQuantity")?.getDouble("value")
+
+private fun component(bp: JSONObject, code: String): Double? =
+  bp.optJSONArray("component").objects().firstOrNull { codeOf(it) == code }
+    ?.optJSONObject("valueQuantity")?.getDouble("value")
+
+private fun parseItem(q: JSONObject): QItem = QItem(
+  linkId = q.getString("linkId"),
+  text = q.optString("text"),
+  type = q.getString("type"),
+  required = q.optBoolean("required"),
+  options = q.optJSONArray("answerOption").objects().map { o ->
+    val c = o.getJSONObject("valueCoding")
+    Coding(c.getString("system"), c.getString("code"), c.optString("display", c.getString("code")))
+  },
+  children = q.optJSONArray("item").objects().map(::parseItem),
+)
+
+private fun responseItems(items: List<QItem>, values: Map<String, String>): JSONArray {
+  val out = JSONArray()
+  items.forEach { item ->
+    if (item.children.isNotEmpty()) {
+      out.put(JSONObject().put("linkId", item.linkId).put("item", responseItems(item.children, values)))
+    } else {
+      val raw = values[item.linkId].orEmpty().trim()
+      if (raw.isNotEmpty()) out.put(JSONObject().put("linkId", item.linkId).put("answer", answers(item, raw)))
+    }
+  }
+  return out
+}
+
+private fun answers(item: QItem, raw: String): JSONArray {
+  val out = JSONArray()
+  when (item.type) {
+    "integer" -> out.put(JSONObject().put("valueInteger", raw.toInt()))
+    "decimal" -> out.put(JSONObject().put("valueDecimal", raw.toDouble()))
+    "date" -> out.put(JSONObject().put("valueDate", raw))
+    "choice" -> raw.split(",").forEach { code ->
+      val c = item.options.first { it.code == code }
+      out.put(JSONObject().put("valueCoding", coding(c.system, c.code, c.display)))
+    }
+    else -> out.put(JSONObject().put("valueString", raw))
+  }
+  return out
+}
+
+private fun coding(system: String, code: String, display: String): JSONObject =
+  JSONObject().put("system", system).put("code", code).put("display", display)
+
+private fun concept(coding: JSONObject): JSONObject = JSONObject().put("coding", JSONArray().put(coding))
+
+private fun ref(reference: String): JSONObject = JSONObject().put("reference", reference)
+
+private fun newUrl(): String = "urn:uuid:${UUID.randomUUID()}"
+
+private fun quantity(value: Double, unit: String): JSONObject =
+  JSONObject().put("value", value).put("unit", unit).put("system", "http://unitsofmeasure.org").put("code", unit)
+
+private fun bpComponent(coding: JSONObject, value: String): JSONObject =
+  JSONObject().put("code", concept(coding)).put("valueQuantity", quantity(value.trim().toDouble(), "mmHg"))
