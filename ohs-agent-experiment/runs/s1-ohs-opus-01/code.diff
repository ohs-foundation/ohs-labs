@@ -0,0 +1,109 @@
+package com.example.ancapp.ui
+
+import android.app.Application
+import androidx.lifecycle.AndroidViewModel
+import androidx.lifecycle.viewModelScope
+import com.example.ancapp.data.AncRepository
+import com.example.ancapp.data.AncVisit
+import com.example.ancapp.data.PatientSummary
+import com.example.ancapp.data.syncWithServer
+import dev.ohs.fhir.engine.FhirEngineProvider
+import dev.ohs.fhir.engine.sync.SyncJobStatus
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+
+data class RegisterState(
+  val patients: List<PatientSummary> = emptyList(),
+  val loading: Boolean = true,
+  val syncing: Boolean = false,
+  val message: String? = null,
+)
+
+data class PatientDetailState(
+  val patient: PatientSummary? = null,
+  val visits: List<AncVisit> = emptyList(),
+  val loading: Boolean = true,
+)
+
+class AncViewModel(application: Application) : AndroidViewModel(application) {
+
+  private val repository = AncRepository(FhirEngineProvider.getInstance(application))
+
+  private val _register = MutableStateFlow(RegisterState())
+  val register: StateFlow<RegisterState> = _register.asStateFlow()
+
+  private val _detail = MutableStateFlow(PatientDetailState())
+  val detail: StateFlow<PatientDetailState> = _detail.asStateFlow()
+
+  private val _questionnaire = MutableStateFlow<String?>(null)
+  val questionnaire: StateFlow<String?> = _questionnaire.asStateFlow()
+
+  init {
+    viewModelScope.launch {
+      loadRegister()
+      sync()
+    }
+  }
+
+  /** Pulls the latest data from the server and refreshes whatever is on screen. */
+  fun sync() {
+    if (_register.value.syncing) return
+    viewModelScope.launch {
+      _register.update { it.copy(syncing = true, message = null) }
+      val status = runCatching { syncWithServer(getApplication()) }
+      val message =
+        status.fold(
+          onSuccess = { if (it is SyncJobStatus.Failed) it.describe() else null },
+          onFailure = { "Could not reach the FHIR server: ${it.message ?: it::class.simpleName}" },
+        )
+      _register.update { it.copy(syncing = false, message = message) }
+      loadRegister()
+      _detail.value.patient?.let { openPatient(it.id) }
+    }
+  }
+
+  fun openPatient(patientId: String) {
+    viewModelScope.launch {
+      _detail.update { it.copy(loading = true) }
+      val patient = repository.loadPatient(patientId)
+      val visits = repository.loadVisits(patientId)
+      _detail.value = PatientDetailState(patient = patient, visits = visits, loading = false)
+    }
+  }
+
+  fun clearDetail() {
+    _detail.value = PatientDetailState()
+  }
+
+  /** Loads the ANC contact form so it can be handed to the Data Capture library. */
+  fun loadQuestionnaire() {
+    if (_questionnaire.value != null) return
+    viewModelScope.launch {
+      _questionnaire.value = runCatching { repository.loadQuestionnaireJson() }.getOrNull()
+    }
+  }
+
+  /** Saves a completed visit form, then pushes it to the server. */
+  fun saveVisit(patientId: String, response: QuestionnaireResponse, onSaved: () -> Unit) {
+    viewModelScope.launch {
+      repository.saveVisit(patientId, response)
+      openPatient(patientId)
+      onSaved()
+      sync()
+    }
+  }
+
+  private suspend fun loadRegister() {
+    val patients = runCatching { repository.loadRegister() }.getOrDefault(emptyList())
+    _register.update { it.copy(patients = patients, loading = false) }
+  }
+
+  private fun SyncJobStatus.Failed.describe(): String {
+    val reason = exceptions.firstOrNull()?.exceptionMessage
+    return "Sync failed" + if (reason.isNullOrBlank()) "" else ": $reason"
+  }
+}
