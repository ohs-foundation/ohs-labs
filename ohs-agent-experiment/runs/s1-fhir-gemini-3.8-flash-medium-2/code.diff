+                        Icon(
+                            imageVector = Icons.Default.CalendarMonth,
+                            contentDescription = "Pick date"
+                        )
+                    }
+                }
+            )
+
+            // 2. Gestational Age (weeks)
+            OutlinedTextField(
+                value = gestationalAgeText,
+                onValueChange = { gestationalAgeText = it.filter { ch -> ch.isDigit() } },
+                label = { Text("Gestational Age (weeks)") },
+                modifier = Modifier.fillMaxWidth(),
+                singleLine = true,
+                keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+                supportingText = { Text("Weeks of pregnancy at visit") }
+            )
+
+            HorizontalDivider()
+
+            // 3. Vital Signs Section
+            Text(
+                text = "Vital Signs",
+                style = MaterialTheme.typography.titleMedium,
+                fontWeight = FontWeight.Bold
+            )
+
+            // Weight (kg)
+            OutlinedTextField(
+                value = weightText,
+                onValueChange = { weightText = it },
+                label = { Text("Weight (kg)") },
+                modifier = Modifier.fillMaxWidth(),
+                singleLine = true,
+                keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Decimal),
+                suffix = { Text("kg") }
+            )
+
+            // Blood pressure: Systolic / Diastolic
+            Row(
+                modifier = Modifier.fillMaxWidth(),
+                horizontalArrangement = Arrangement.spacedBy(12.dp)
+            ) {
+                OutlinedTextField(
+                    value = systolicBpText,
+                    onValueChange = { systolicBpText = it.filter { ch -> ch.isDigit() } },
+                    label = { Text("Systolic BP") },
+                    modifier = Modifier.weight(1f),
+                    singleLine = true,
+                    keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+                    suffix = { Text("mmHg") }
+                )
+                OutlinedTextField(
+                    value = diastolicBpText,
+                    onValueChange = { diastolicBpText = it.filter { ch -> ch.isDigit() } },
+                    label = { Text("Diastolic BP") },
+                    modifier = Modifier.weight(1f),
+                    singleLine = true,
+                    keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+                    suffix = { Text("mmHg") }
+                )
+            }
+
+            HorizontalDivider()
+
+            // 4. Danger Signs Present (multiple allowed)
+            Text(
+                text = "Danger Signs Present",
+                style = MaterialTheme.typography.titleMedium,
+                fontWeight = FontWeight.Bold
+            )
+            Text(
+                text = "Select all danger signs observed, or 'None'.",
+                style = MaterialTheme.typography.bodySmall,
+                color = MaterialTheme.colorScheme.onSurfaceVariant
+            )
+
+            FlowRow(
+                modifier = Modifier.fillMaxWidth(),
+                horizontalArrangement = Arrangement.spacedBy(8.dp),
+                verticalArrangement = Arrangement.spacedBy(8.dp)
+            ) {
+                for (option in dangerSignOptions) {
+                    val isSelected = selectedDangerCodes.contains(option.code)
+                    FilterChip(
+                        selected = isSelected,
+                        onClick = {
+                            if (option.code == "none") {
+                                selectedDangerCodes = if (isSelected) emptySet() else setOf("none")
+                            } else {
+                                val current = selectedDangerCodes.toMutableSet()
+                                current.remove("none")
+                                if (isSelected) {
+                                    current.remove(option.code)
+                                    if (current.isEmpty()) current.add("none")
+                                } else {
+                                    current.add(option.code)
+                                }
+                                selectedDangerCodes = current
+                            }
+                        },
+                        label = { Text(option.display) },
+                        leadingIcon = if (isSelected) {
+                            {
+                                Icon(
+                                    imageVector = Icons.Default.Check,
+                                    contentDescription = null,
+                                    modifier = Modifier.size(FilterChipDefaults.IconSize)
+                                )
+                            }
+                        } else null,
+                        colors = if (option.code != "none" && isSelected) {
+                            FilterChipDefaults.filterChipColors(
+                                selectedContainerColor = MaterialTheme.colorScheme.errorContainer,
+                                selectedLabelColor = MaterialTheme.colorScheme.onErrorContainer
+                            )
+                        } else {
+                            FilterChipDefaults.filterChipColors()
+                        }
+                    )
+                }
+            }
+
+            HorizontalDivider()
+
+            // 5. Free-text notes
+            Text(
+                text = "Clinical Notes",
+                style = MaterialTheme.typography.titleMedium,
+                fontWeight = FontWeight.Bold
+            )
+
+            OutlinedTextField(
+                value = notesText,
+                onValueChange = { notesText = it },
+                label = { Text("Free-text notes") },
+                placeholder = { Text("Add any notes, complaints, or instructions...") },
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .height(120.dp),
+                maxLines = 5
+            )
+
+            Spacer(modifier = Modifier.height(8.dp))
+
+            // Action Buttons
+            Row(
+                modifier = Modifier.fillMaxWidth(),
+                horizontalArrangement = Arrangement.spacedBy(12.dp)
+            ) {
+                OutlinedButton(
+                    onClick = onBack,
+                    modifier = Modifier.weight(1f),
+                    enabled = !isSaving
+                ) {
+                    Text("Cancel")
+                }
+
+                Button(
+                    onClick = {
+                        validationError = null
+                        val vDate = visitDate.trim()
+                        if (vDate.isBlank()) {
+                            validationError = "Please enter a valid visit date (YYYY-MM-DD)."
+                            return@Button
+                        }
+                        try {
+                            LocalDate.parse(vDate.substring(0, 10))
+                        } catch (e: Exception) {
+                            validationError = "Invalid date format. Expected YYYY-MM-DD."
+                            return@Button
+                        }
+
+                        val ga = gestationalAgeText.trim().toIntOrNull()
+                        val weight = weightText.trim().toDoubleOrNull()
+                        val sys = systolicBpText.trim().toIntOrNull()
+                        val dia = diastolicBpText.trim().toIntOrNull()
+
+                        if (weightText.isNotBlank() && weight == null) {
+                            validationError = "Please enter a valid decimal for weight."
+                            return@Button
+                        }
+                        if (systolicBpText.isNotBlank() && sys == null) {
+                            validationError = "Please enter a valid number for systolic BP."
+                            return@Button
+                        }
+                        if (diastolicBpText.isNotBlank() && dia == null) {
+                            validationError = "Please enter a valid number for diastolic BP."
+                            return@Button
+                        }
+
+                        val selectedOptions = dangerSignOptions.filter {
+                            selectedDangerCodes.contains(it.code)
+                        }
+
+                        onSaveVisit(
+                            vDate,
+                            ga,
+                            weight,
+                            sys,
+                            dia,
+                            selectedOptions,
+                            notesText.ifBlank { null }
+                        )
+                    },
+                    modifier = Modifier.weight(1f),
+                    enabled = !isSaving
+                ) {
+                    if (isSaving) {
+                        CircularProgressIndicator(
+                            modifier = Modifier.size(20.dp),
+                            color = MaterialTheme.colorScheme.onPrimary,
+                            strokeWidth = 2.dp
+                        )
+                        Spacer(modifier = Modifier.width(8.dp))
+                        Text("Saving...")
+                    } else {
+                        Icon(Icons.Default.Save, contentDescription = null)
+                        Spacer(modifier = Modifier.width(6.dp))
+                        Text("Save Visit")
+                    }
+                }
+            }
+
+            Spacer(modifier = Modifier.height(24.dp))
+        }
+    }
+}
diff --git a/app/src/main/java/com/example/ancapp/ui/RegisterScreen.kt b/app/src/main/java/com/example/ancapp/ui/RegisterScreen.kt
