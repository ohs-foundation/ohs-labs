+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setContent {
+            AncTheme {
+                Surface(
+                    modifier = Modifier.fillMaxSize(),
+                    color = MaterialTheme.colorScheme.background
+                ) {
+                    val viewModel: AncViewModel = viewModel()
+                    AncApp(viewModel)
+                }
+            }
+        }
+    }
+}
+
+@Composable
+fun AncApp(viewModel: AncViewModel) {
+    val context = LocalContext.current
+    val currentScreen by viewModel.currentScreen.collectAsState()
+    val patients by viewModel.patients.collectAsState()
+    val visits by viewModel.visits.collectAsState()
+    val formState by viewModel.formState.collectAsState()
+
+    Crossfade(targetState = currentScreen, label = "ScreenTransition") { screen ->
+        when (screen) {
+            is Screen.Register -> {
+                RegisterScreen(
+                    patients = patients,
+                    onPatientClick = { patientId ->
+                        viewModel.navigateToPatientDetail(patientId)
+                    }
+                )
+            }
+
+            is Screen.PatientDetail -> {
+                BackHandler {
+                    viewModel.navigateToRegister()
+                }
+                val patient = patients.find { it.id == screen.patientId }
+                val patientVisits = visits.filter { it.patientId == screen.patientId }
+                    .sortedByDescending { it.visitDate }
+
+                PatientDetailScreen(
+                    patient = patient,
+                    visits = patientVisits,
+                    onBackClick = { viewModel.navigateToRegister() },
+                    onRecordVisitClick = { viewModel.navigateToRecordVisit(screen.patientId) }
+                )
+            }
+
+            is Screen.RecordVisit -> {
+                BackHandler {
+                    viewModel.navigateToPatientDetail(screen.patientId)
+                }
+                val patient = patients.find { it.id == screen.patientId }
+
+                RecordVisitScreen(
+                    patient = patient,
+                    formState = formState,
+                    onVisitDateChange = { date -> viewModel.updateVisitDate(date, screen.patientId) },
+                    onGestationalAgeChange = { viewModel.updateGestationalAge(it) },
+                    onWeightChange = { viewModel.updateWeight(it) },
+                    onSystolicBpChange = { viewModel.updateSystolicBp(it) },
+                    onDiastolicBpChange = { viewModel.updateDiastolicBp(it) },
+                    onHemoglobinChange = { viewModel.updateHemoglobin(it) },
+                    onToggleDangerSign = { viewModel.toggleDangerSign(it) },
+                    onNotesChange = { viewModel.updateNotes(it) },
+                    onSaveClick = {
+                        viewModel.saveVisit(screen.patientId) {
+                            Toast.makeText(context, "Visit recorded successfully", Toast.LENGTH_SHORT).show()
+                        }
+                    },
+                    onBackClick = {
+                        viewModel.navigateToPatientDetail(screen.patientId)
+                    }
+                )
+            }
+        }
+    }
 }
