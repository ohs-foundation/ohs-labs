+package com.example.ancapp.model
+
+import java.time.LocalDate
+import java.time.temporal.ChronoUnit
+
+data class PatientItem(
+  val id: String,
+  val name: String,
+  val birthDate: String,
+  val age: Int,
+  val estimatedDueDate: String,
+  val weeksOfPregnancy: Int,
+  val identifier: String? = null,
+  val phone: String? = null
+)
+
+data class AncVisit(
+  val id: String,
+  val encounterId: String,
+  val patientId: String,
+  val date: String,
+  val weightKg: Double?,
+  val systolicBp: Int?,
+  val diastolicBp: Int?,
+  val hemoglobinGdl: Double?,
+  val gestationalAgeWeeks: Int? = null,
+  val dangerSigns: List<String> = emptyList(),
+  val notes: String? = null
+) {
+  val bloodPressureDisplay: String?
+    get() {
+      return if (systolicBp != null && diastolicBp != null) {
+        "$systolicBp/$diastolicBp mmHg"
+      } else if (systolicBp != null) {
+        "$systolicBp mmHg (systolic)"
+      } else if (diastolicBp != null) {
+        "$diastolicBp mmHg (diastolic)"
+      } else {
+        null
+      }
+    }
+}
+
+object AncCalculations {
+  fun calculateAge(birthDateString: String?, today: LocalDate = LocalDate.now()): Int {
+    if (birthDateString.isNullOrBlank()) return 0
+    return try {
+      val dob = LocalDate.parse(birthDateString.take(10))
+      ChronoUnit.YEARS.between(dob, today).toInt().coerceAtLeast(0)
+    } catch (e: Exception) {
+      0
+    }
+  }
+
+  fun calculateGestationalWeeks(eddString: String?, today: LocalDate = LocalDate.now()): Int {
+    if (eddString.isNullOrBlank()) return 0
+    return try {
+      val edd = LocalDate.parse(eddString.take(10))
+      val daysUntilEdd = ChronoUnit.DAYS.between(today, edd)
+      val gestationDays = 280 - daysUntilEdd
+      (gestationDays / 7).coerceAtLeast(0).toInt()
+    } catch (e: Exception) {
+      0
+    }
+  }
+}
