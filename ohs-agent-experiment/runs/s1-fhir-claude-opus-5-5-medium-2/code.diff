@@ -0,0 +1,297 @@
+package com.example.ancapp
+
+import java.net.HttpURLConnection
+import java.net.URL
+import java.time.LocalDate
+import java.time.Period
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+import org.json.JSONArray
+import org.json.JSONObject
+
+const val FHIR_BASE = "http://10.0.2.2:8080/fhir"
+
+private const val LOINC = "http://loinc.org"
+private const val EDD = "11778-8"
+private const val WEIGHT = "29463-7"
+private const val BP_PANEL = "85354-9"
+private const val SYSTOLIC = "8480-6"
+private const val DIASTOLIC = "8462-4"
+private const val HB = "718-7"
+private const val GEST_AGE = "18185-9"
+
+data class Patient(val id: String, val name: String, val birthDate: LocalDate?, val edd: LocalDate) {
+  fun age(today: LocalDate = LocalDate.now()) = birthDate?.let { Period.between(it, today).years }
+  /** Gestational age in days, derived from the EDD (EDD = 280 days). */
+  fun gaDays(today: LocalDate = LocalDate.now()) = 280 - ChronoUnit.DAYS.between(today, edd).toInt()
+}
+
+data class Visit(
+  val date: String,
+  val gaWeeks: Int? = null,
+  val weight: Double? = null,
+  val systolic: Int? = null,
+  val diastolic: Int? = null,
+  val hb: Double? = null,
+  val dangerSigns: List<String> = emptyList(),
+  val notes: String? = null,
+)
+
+// ---- HTTP ----
+
+private fun request(path: String, body: JSONObject? = null): JSONObject {
+  val conn = URL(if (path.isEmpty()) FHIR_BASE else "$FHIR_BASE/$path").openConnection() as HttpURLConnection
+  conn.connectTimeout = 10_000
+  conn.readTimeout = 20_000
+  conn.setRequestProperty("Accept", "application/fhir+json")
+  conn.setRequestProperty("Cache-Control", "no-cache") // HAPI otherwise reuses search results for ~60s
+  if (body != null) {
+    conn.requestMethod = "POST"
+    conn.doOutput = true
+    conn.setRequestProperty("Content-Type", "application/fhir+json")
+    conn.outputStream.use { it.write(body.toString().toByteArray()) }
+  }
+  try {
+    val code = conn.responseCode
+    val text = (if (code < 400) conn.inputStream else conn.errorStream)?.bufferedReader()?.use { it.readText() }.orEmpty()
+    if (code >= 400) error("Server returned HTTP $code ${text.take(300)}")
+    return JSONObject(text)
+  } finally {
+    conn.disconnect()
+  }
+}
+
+private fun JSONObject.resources(): List<JSONObject> =
+  optJSONArray("entry")?.objects()?.mapNotNull { it.optJSONObject("resource") }.orEmpty()
+
+private fun JSONArray.objects() = (0 until length()).map { getJSONObject(it) }
+
+private fun JSONObject.str(key: String): String? = if (has(key) && !isNull(key)) getString(key) else null
+
+private fun JSONObject.hasCode(code: String) =
+  optJSONObject("code")?.optJSONArray("coding")?.objects()?.any { it.str("code") == code } == true
+
+private fun JSONObject.quantity(): Double? = optJSONObject("valueQuantity")?.takeIf { it.has("value") }?.getDouble("value")
+
+// ---- Reads ----
+
+/** Patients with a recorded EDD (i.e. currently on the ANC register), soonest due first. */
+fun loadRegister(): List<Patient> {
+  // ponytail: single page of 500; add paging if the register outgrows it
+  val bundle = request("Observation?code=$LOINC|$EDD&_include=Observation:subject&_sort=-date&_count=500")
+  return parseRegister(bundle)
+}
+
+fun parseRegister(bundle: JSONObject): List<Patient> {
+  val all = bundle.resources()
+  val patients = all.filter { it.str("resourceType") == "Patient" }.associateBy { "Patient/" + it.getString("id") }
+  val edds = LinkedHashMap<String, LocalDate>()
+  // Sorted newest first, so the first EDD seen per patient is the latest one.
+  for (obs in all.filter { it.str("resourceType") == "Observation" }) {
+    val ref = obs.optJSONObject("subject")?.str("reference") ?: continue
+    val edd = obs.str("valueDateTime")?.take(10)?.let(LocalDate::parse) ?: continue
+    edds.putIfAbsent(ref, edd)
+  }
+  return edds.mapNotNull { (ref, edd) ->
+    val p = patients[ref] ?: return@mapNotNull null
+    val n = p.optJSONArray("name")?.optJSONObject(0)
+    val name = n?.str("text") ?: listOfNotNull(
+      n?.optJSONArray("given")?.let { g -> (0 until g.length()).joinToString(" ") { g.getString(it) } },
+      n?.str("family"),
+    ).joinToString(" ")
+    Patient(p.getString("id"), name.ifBlank { "(no name)" }, p.str("birthDate")?.let(LocalDate::parse), edd)
+  }.sortedBy { it.edd }
+}
+
+fun loadVisits(patientId: String): List<Visit> = parseVisits(
+  request(
+    "Encounter?subject=Patient/$patientId&_sort=-date&_count=200" +
+      "&_revinclude=Observation:encounter&_revinclude=QuestionnaireResponse:encounter"
+  )
+)
+
+/** Groups Observations / QuestionnaireResponses by the Encounter they reference, newest visit first. */
+fun parseVisits(bundle: JSONObject): List<Visit> {
+  val entries = bundle.optJSONArray("entry")?.objects().orEmpty()
+  fun key(e: JSONObject) = e.getJSONObject("resource").let { r ->
+    r.str("id")?.let { r.getString("resourceType") + "/" + it } ?: e.str("fullUrl")
+  }
+  val byType = entries.groupBy { it.getJSONObject("resource").getString("resourceType") }
+  val linked = (byType["Observation"].orEmpty() + byType["QuestionnaireResponse"].orEmpty())
+    .map { it.getJSONObject("resource") }
+    .groupBy { it.optJSONObject("encounter")?.str("reference") }
+
+  return byType["Encounter"].orEmpty().map { e ->
+    val enc = e.getJSONObject("resource")
+    val related = linked[key(e)].orEmpty()
+    val obs = related.filter { it.str("resourceType") == "Observation" }
+    val qr = related.firstOrNull { it.str("resourceType") == "QuestionnaireResponse" }
+    val bp = obs.firstOrNull { it.hasCode(BP_PANEL) }?.optJSONArray("component")?.objects().orEmpty()
+    Visit(
+      date = enc.optJSONObject("period")?.str("start")?.take(10)
+        ?: obs.firstNotNullOfOrNull { it.str("effectiveDateTime") }?.take(10) ?: "?",
+      gaWeeks = obs.firstOrNull { it.hasCode(GEST_AGE) }?.quantity()?.toInt(),
+      weight = obs.firstOrNull { it.hasCode(WEIGHT) }?.quantity(),
+      systolic = bp.firstOrNull { it.hasCode(SYSTOLIC) }?.quantity()?.toInt(),
+      diastolic = bp.firstOrNull { it.hasCode(DIASTOLIC) }?.quantity()?.toInt(),
+      hb = obs.firstOrNull { it.hasCode(HB) }?.quantity(),
+      dangerSigns = qr?.let { answers(it, "danger-signs") }.orEmpty()
+        .mapNotNull { it.optJSONObject("valueCoding")?.let { c -> c.str("display") ?: c.str("code") } },
+      notes = qr?.let { answers(it, "notes") }?.firstOrNull()?.str("valueString"),
+    )
+  }.sortedByDescending { it.date }
+}
+
+private fun answers(node: JSONObject, linkId: String): List<JSONObject>? {
+  for (item in node.optJSONArray("item")?.objects().orEmpty()) {
+    if (item.str("linkId") == linkId) return item.optJSONArray("answer")?.objects()
+    answers(item, linkId)?.let { return it }
+  }
+  return null
+}
+
+fun loadQuestionnaire(): JSONObject = request("Questionnaire/anc-contact")
+
+// ---- Form validation ----
+
+/** Flattened list of non-group items in the questionnaire. */
+fun leafItems(items: JSONArray?): List<JSONObject> = items?.objects().orEmpty().flatMap {
+  if (it.str("type") == "group") leafItems(it.optJSONArray("item")) else listOf(it)
+}
+
+private val plausible = mapOf(
+  "gestational-age" to 1.0..45.0,
+  "weight" to 20.0..250.0,
+  "bp-systolic" to 50.0..260.0,
+  "bp-diastolic" to 30.0..160.0,
+)
+
+/**
+ * Turns raw form input (String for text fields, Set<String> of codes for choices) into typed answers.
+ * Returns (typed answers by linkId, error messages by linkId).
+ */
+fun validate(q: JSONObject, raw: Map<String, Any>, today: LocalDate = LocalDate.now()): Pair<Map<String, Any>, Map<String, String>> {
+  val typed = mutableMapOf<String, Any>()
+  val errors = mutableMapOf<String, String>()
+  for (item in leafItems(q.optJSONArray("item"))) {
+    val id = item.getString("linkId")
+    val type = item.getString("type")
+    val v = raw[id]
+    if (type == "choice") {
+      val codes = (v as? Set<*>).orEmpty()
+      val chosen = item.optJSONArray("answerOption")?.objects().orEmpty()
+        .map { it.getJSONObject("valueCoding") }.filter { it.str("code") in codes }
+      if (chosen.isNotEmpty()) typed[id] = chosen
+      else if (item.optBoolean("required")) errors[id] = "Required"
+      continue
+    }
+    val s = (v as? String)?.trim().orEmpty()
+    if (s.isEmpty()) {
+      if (item.optBoolean("required")) errors[id] = "Required"
+      continue
+    }
+    val value: Any? = when (type) {
+      "integer" -> s.toIntOrNull()
+      "decimal" -> s.toDoubleOrNull()
+      "date" -> runCatching { LocalDate.parse(s) }.getOrNull()
+      else -> s
+    }
+    when {
+      value == null -> errors[id] = if (type == "date") "Use YYYY-MM-DD" else "Enter a number"
+      value is LocalDate && value.isAfter(today) -> errors[id] = "Cannot be in the future"
+      value is Number && plausible[id]?.contains(value.toDouble()) == false ->
+        errors[id] = "Must be between ${plausible[id]!!.start.toInt()} and ${plausible[id]!!.endInclusive.toInt()}"
+      else -> typed[id] = if (value is LocalDate) value.toString() else value
+    }
+  }
+  val sys = typed["bp-systolic"] as? Int
+  val dia = typed["bp-diastolic"] as? Int
+  if ((sys == null) != (dia == null) && "bp-systolic" !in errors && "bp-diastolic" !in errors) {
+    errors[if (sys == null) "bp-systolic" else "bp-diastolic"] = "Enter both systolic and diastolic"
+  }
+  if (sys != null && dia != null && sys <= dia) errors["bp-diastolic"] = "Must be lower than systolic"
+  return typed to errors
+}
+
+// ---- Write ----
+
+/**
+ * Transaction bundle: Encounter + QuestionnaireResponse + extracted Observations
+ * (shaped like the clinic's existing data so register/detail screens read them the same way).
+ */
+fun buildVisitBundle(patientId: String, q: JSONObject, answers: Map<String, Any>): JSONObject {
+  val subject = mapOf("reference" to "Patient/$patientId")
+  val encUrl = "urn:uuid:" + UUID.randomUUID()
+  val encRef = mapOf("reference" to encUrl)
+  val date = answers.getValue("visit-date") as String
+  fun loinc(code: String, display: String) = mapOf("coding" to listOf(mapOf("system" to LOINC, "code" to code, "display" to display)), "text" to display)
+  fun qty(v: Number, unit: String, code: String) =
+    mapOf("value" to v, "unit" to unit, "system" to "http://unitsofmeasure.org", "code" to code)
+  val vitals = listOf(mapOf("coding" to listOf(mapOf(
+    "system" to "http://terminology.hl7.org/CodeSystem/observation-category", "code" to "vital-signs", "display" to "Vital Signs",
+  ))))
+  fun obs(code: Map<String, Any>, extra: Map<String, Any>, vital: Boolean = true) = mapOf(
+    "resourceType" to "Observation", "status" to "final", "code" to code,
+    "subject" to subject, "encounter" to encRef, "effectiveDateTime" to date,
+  ) + (if (vital) mapOf("category" to vitals) else emptyMap()) + extra
+
+  val resources = mutableListOf<Map<String, Any>>()
+  resources += mapOf(
+    "resourceType" to "Encounter", "status" to "finished",
+    "class" to mapOf("system" to "http://terminology.hl7.org/CodeSystem/v3-ActCode", "code" to "AMB", "display" to "ambulatory"),
+    "type" to listOf(mapOf("text" to "Antenatal care contact")),
+    "subject" to subject, "period" to mapOf("start" to date, "end" to date),
+  )
+  fun qrItems(items: JSONArray?): List<Map<String, Any>> = items?.objects().orEmpty().mapNotNull { item ->
+    val id = item.getString("linkId")
+    if (item.str("type") == "group") {
+      qrItems(item.optJSONArray("item")).takeIf { it.isNotEmpty() }?.let { mapOf("linkId" to id, "item" to it) }
+    } else {
+      val a = answers[id] ?: return@mapNotNull null
+      val list = when (item.getString("type")) {
+        "choice" -> (a as List<*>).map { mapOf("valueCoding" to it) }
+        "integer" -> listOf(mapOf("valueInteger" to a))
+        "decimal" -> listOf(mapOf("valueDecimal" to a))
+        "date" -> listOf(mapOf("valueDate" to a))
+        else -> listOf(mapOf("valueString" to a))
+      }
+      mapOf("linkId" to id, "text" to item.optString("text"), "answer" to list)
+    }
+  }
+  resources += mapOf(
+    "resourceType" to "QuestionnaireResponse", "status" to "completed",
+    "questionnaire" to q.optString("url").ifEmpty { "Questionnaire/anc-contact" },
+    "subject" to subject, "encounter" to encRef, "authored" to java.time.OffsetDateTime.now().toString(),
+    "item" to qrItems(q.optJSONArray("item")),
+  )
+  (answers["gestational-age"] as? Int)?.let {
+    resources += obs(loinc(GEST_AGE, "Gestational age"), mapOf("valueQuantity" to qty(it, "wk", "wk")), vital = false)
+  }
+  (answers["weight"] as? Double)?.let {
+    resources += obs(loinc(WEIGHT, "Body weight"), mapOf("valueQuantity" to qty(it, "kg", "kg")))
+  }
+  val sys = answers["bp-systolic"] as? Int
+  val dia = answers["bp-diastolic"] as? Int
+  if (sys != null && dia != null) {
+    resources += obs(
+      loinc(BP_PANEL, "Blood pressure panel with all children optional") + ("text" to "Blood pressure"),
+      mapOf("component" to listOf(
+        mapOf("code" to loinc(SYSTOLIC, "Systolic blood pressure"), "valueQuantity" to qty(sys, "mmHg", "mm[Hg]")),
+        mapOf("code" to loinc(DIASTOLIC, "Diastolic blood pressure"), "valueQuantity" to qty(dia, "mmHg", "mm[Hg]")),
+      )),
+    )
+  }
+  val entries = resources.mapIndexed { i, r ->
+    val type = r.getValue("resourceType")
+    mapOf(
+      "fullUrl" to if (i == 0) encUrl else "urn:uuid:" + UUID.randomUUID(),
+      "resource" to r,
+      "request" to mapOf("method" to "POST", "url" to type),
+    )
+  }
+  return JSONObject(mapOf("resourceType" to "Bundle", "type" to "transaction", "entry" to entries))
+}
+
+fun saveVisit(patientId: String, q: JSONObject, answers: Map<String, Any>) {
+  request("", buildVisitBundle(patientId, q, answers))
+}
