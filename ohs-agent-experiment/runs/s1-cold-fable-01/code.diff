+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun VisitFormScreen(
+  viewModel: AncViewModel,
+  patientId: Long,
+  onBack: () -> Unit,
+) {
+  val patient by remember(patientId) { viewModel.patient(patientId) }
+    .collectAsState(initial = null)
+
+  var date by rememberSaveable { mutableStateOf(LocalDate.now().toString()) }
+  var weeks by rememberSaveable { mutableStateOf("") }
+  var weight by rememberSaveable { mutableStateOf("") }
+  var systolic by rememberSaveable { mutableStateOf("") }
+  var diastolic by rememberSaveable { mutableStateOf("") }
+  var hemoglobin by rememberSaveable { mutableStateOf("") }
+  var signs by rememberSaveable { mutableStateOf(setOf<String>()) }
+  var notes by rememberSaveable { mutableStateOf("") }
+  var weeksTouched by rememberSaveable { mutableStateOf(false) }
+  var error by remember { mutableStateOf<String?>(null) }
+  var showDatePicker by remember { mutableStateOf(false) }
+
+  // Prefill gestational age from the patient's due date until the nurse edits it.
+  val weeksValue =
+    if (weeksTouched) weeks
+    else patient?.gestationalWeeks()?.toString() ?: weeks
+
+  Scaffold(
