+++ b/app/src/main/java/com/example/ancapp/FhirRepository.kt
@@ -0,0 +1,768 @@
+package com.example.ancapp
+
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.BufferedReader
+import java.io.InputStreamReader
+import java.io.OutputStreamWriter
+import java.net.HttpURLConnection
+import java.net.URL
+import java.time.LocalDate
+import java.time.Period
+import java.time.temporal.ChronoUnit
+
+class FhirRepository(
+    private val baseUrl: String = "http://10.0.2.2:8080/fhir"
+) {
+
+    suspend fun fetchPatientsAndVisits(): Pair<List<PatientSummary>, Map<String, List<AncVisit>>> =
+        withContext(Dispatchers.IO) {
+            val patientsJson = getJson("$baseUrl/Patient?_count=100")
+            val encountersJson = getJson("$baseUrl/Encounter?_count=200")
+            val observationsJson = getJson("$baseUrl/Observation?_count=500")
+            val qrJson = try {
+                getJson("$baseUrl/QuestionnaireResponse?_count=200")
+            } catch (_: Exception) {
+                JSONObject()
+            }
+
+            val patientEntries = extractEntries(patientsJson)
+            val encounterEntries = extractEntries(encountersJson)
+            val observationEntries = extractEntries(observationsJson)
+            val qrEntries = extractEntries(qrJson)
+
+            // Group observations by patient and by encounter
+            val obsByPatient = mutableMapOf<String, MutableList<JSONObject>>()
+            val obsByEncounter = mutableMapOf<String, MutableList<JSONObject>>()
+
+            for (obs in observationEntries) {
+                val subjectRef = obs.optJSONObject("subject")?.optString("reference") ?: continue
+                val patientId = subjectRef.removePrefix("Patient/")
+                obsByPatient.getOrPut(patientId) { mutableListOf() }.add(obs)
+
+                val encRef = obs.optJSONObject("encounter")?.optString("reference")
+                if (!encRef.isNullOrBlank()) {
+                    val encId = encRef.removePrefix("Encounter/")
+                    obsByEncounter.getOrPut(encId) { mutableListOf() }.add(obs)
+                }
+            }
+
+            // Group QuestionnaireResponses by encounter or patient+date
+            val qrByEncounter = mutableMapOf<String, JSONObject>()
+            val qrByPatient = mutableMapOf<String, MutableList<JSONObject>>()
+            for (qr in qrEntries) {
+                val subjectRef = qr.optJSONObject("subject")?.optString("reference") ?: continue
+                val patientId = subjectRef.removePrefix("Patient/")
+                qrByPatient.getOrPut(patientId) { mutableListOf() }.add(qr)
+
+                val encRef = qr.optJSONObject("encounter")?.optString("reference")
+                if (!encRef.isNullOrBlank()) {
+                    qrByEncounter[encRef.removePrefix("Encounter/")] = qr
+                }
+            }
+
+            // Group encounters by patient
+            val encountersByPatient = mutableMapOf<String, MutableList<JSONObject>>()
+            for (enc in encounterEntries) {
+                val subjectRef = enc.optJSONObject("subject")?.optString("reference") ?: continue
+                val patientId = subjectRef.removePrefix("Patient/")
+                encountersByPatient.getOrPut(patientId) { mutableListOf() }.add(enc)
+            }
+
+            val summaries = mutableListOf<PatientSummary>()
+            val visitsByPatient = mutableMapOf<String, List<AncVisit>>()
+
+            val today = LocalDate.now()
+
+            for (pt in patientEntries) {
+                val id = pt.optString("id")
+                val name = parsePatientName(pt)
+                val birthDateStr = pt.optString("birthDate", "")
+                val age = calculateAge(birthDateStr, today)
+                val identifier = pt.optJSONArray("identifier")
+                    ?.optJSONObject(0)
+                    ?.optString("value")
+                val phone = pt.optJSONArray("telecom")
+                    ?.optJSONObject(0)
+                    ?.optString("value")
+
+                val ptObs = obsByPatient[id].orEmpty()
+                val eddStr = findEdd(ptObs)
+
+                val ptEncounters = encountersByPatient[id].orEmpty()
+                val visits = buildVisitsForPatient(
+                    patientId = id,
+                    encounters = ptEncounters,
+                    obsByEncounter = obsByEncounter,
+                    allPatientObs = ptObs,
+                    qrByEncounter = qrByEncounter,
+                    patientQrs = qrByPatient[id].orEmpty()
+                ).sortedByDescending { it.date }
+
+                visitsByPatient[id] = visits
+
+                val latestVisit = visits.firstOrNull()
+                val currentGaWeeks = calculateCurrentGestationalWeeks(
+                    eddStr = eddStr,
+                    latestVisit = latestVisit,
+                    today = today
+                )
+
+                summaries.add(
+                    PatientSummary(
+                        id = id,
+                        identifier = identifier,
+                        name = name,
+                        birthDate = birthDateStr,
+                        age = age,
+                        estimatedDueDate = eddStr,
+                        currentGestationalWeeks = currentGaWeeks,
+                        phone = phone,
+                        lastVisitDate = latestVisit?.date,
+                        lastWeightKg = latestVisit?.weightKg,
+                        lastBpSystolic = latestVisit?.bpSystolic,
+                        lastBpDiastolic = latestVisit?.bpDiastolic,
+                        lastHbGdL = latestVisit?.hemoglobinGdL
+                    )
+                )
+            }
+
+            // Sort by due date (soonest first)
+            val sortedSummaries = summaries.sortedWith(
+                compareBy<PatientSummary> {
+                    try {
+                        LocalDate.parse(it.estimatedDueDate)
+                    } catch (_: Exception) {
+                        LocalDate.MAX
+                    }
+                }.thenBy { it.name }
+            )
+
+            sortedSummaries to visitsByPatient
+        }
+
+    suspend fun fetchQuestionnaire(questionnaireId: String = "anc-contact"): AncQuestionnaire =
+        withContext(Dispatchers.IO) {
+            val json = getJson("$baseUrl/Questionnaire/$questionnaireId")
+            parseQuestionnaire(json)
+        }
+
+    suspend fun submitAncVisit(
+        patientId: String,
+        questionnaire: AncQuestionnaire,
+        input: NewVisitInput
+    ) = withContext(Dispatchers.IO) {
+        // 1. Create Encounter
+        val encounterPayload = JSONObject().apply {
+            put("resourceType", "Encounter")
+            put("status", "finished")
+            put("class", JSONObject().apply {
+                put("system", "http://terminology.hl7.org/CodeSystem/v3-ActCode")
+                put("code", "AMB")
+                put("display", "ambulatory")
+            })
+            put("type", JSONArray().put(JSONObject().apply {
+                put("text", "Antenatal care contact")
+            }))
+            put("subject", JSONObject().apply {
+                put("reference", "Patient/$patientId")
+            })
+            put("period", JSONObject().apply {
+                put("start", input.visitDate)
+                put("end", input.visitDate)
+            })
+        }
+        val createdEncounter = postJson("$baseUrl/Encounter", encounterPayload)
+        val encounterId = createdEncounter.optString("id")
+
+        // 2. Create QuestionnaireResponse referencing Questionnaire/anc-contact
+        val qrItems = JSONArray()
+
+        // visit-date
+        qrItems.put(JSONObject().apply {
+            put("linkId", "visit-date")
+            put("text", "Visit date")
+            put("answer", JSONArray().put(JSONObject().put("valueDate", input.visitDate)))
+        })
+
+        // gestational-age
+        if (input.gestationalAgeWeeks != null) {
+            qrItems.put(JSONObject().apply {
+                put("linkId", "gestational-age")
+                put("text", "Gestational age (weeks)")
+                put("answer", JSONArray().put(JSONObject().put("valueInteger", input.gestationalAgeWeeks)))
+            })
+        }
+
+        // vitals group
+        val vitalsSubItems = JSONArray()
+        if (input.weightKg != null) {
+            vitalsSubItems.put(JSONObject().apply {
+                put("linkId", "weight")
+                put("text", "Weight (kg)")
+                put("answer", JSONArray().put(JSONObject().put("valueDecimal", input.weightKg)))
+            })
+        }
+        if (input.bpSystolic != null) {
+            vitalsSubItems.put(JSONObject().apply {
+                put("linkId", "bp-systolic")
+                put("text", "Systolic blood pressure (mmHg)")
+                put("answer", JSONArray().put(JSONObject().put("valueInteger", input.bpSystolic)))
+            })
+        }
+        if (input.bpDiastolic != null) {
+            vitalsSubItems.put(JSONObject().apply {
+                put("linkId", "bp-diastolic")
+                put("text", "Diastolic blood pressure (mmHg)")
+                put("answer", JSONArray().put(JSONObject().put("valueInteger", input.bpDiastolic)))
+            })
+        }
+        if (vitalsSubItems.length() > 0) {
+            qrItems.put(JSONObject().apply {
+                put("linkId", "vitals")
+                put("text", "Vital signs")
+                put("item", vitalsSubItems)
+            })
+        }
+
+        // danger-signs
+        if (input.selectedDangerSigns.isNotEmpty()) {
+            val answers = JSONArray()
+            for (opt in input.selectedDangerSigns) {
+                answers.put(JSONObject().apply {
+                    put("valueCoding", JSONObject().apply {
+                        put("system", opt.system)
+                        put("code", opt.code)
+                        put("display", opt.display)
+                    })
+                })
+            }
+            qrItems.put(JSONObject().apply {
+                put("linkId", "danger-signs")
+                put("text", "Danger signs present")
+                put("answer", answers)
+            })
+        }
+
+        // notes
+        if (!input.notes.isNullOrBlank()) {
+            qrItems.put(JSONObject().apply {
+                put("linkId", "notes")
+                put("text", "Notes")
+                put("answer", JSONArray().put(JSONObject().put("valueString", input.notes.trim())))
+            })
+        }
+
+        val qrPayload = JSONObject().apply {
+            put("resourceType", "QuestionnaireResponse")
+            put("questionnaire", questionnaire.url.ifBlank { "Questionnaire/${questionnaire.id}" })
+            put("status", "completed")
+            put("subject", JSONObject().put("reference", "Patient/$patientId"))
+            if (encounterId.isNotBlank()) {
+                put("encounter", JSONObject().put("reference", "Encounter/$encounterId"))
+            }
+            put("authored", input.visitDate)
+            put("item", qrItems)
+        }
+        postJson("$baseUrl/QuestionnaireResponse", qrPayload)
+
+        // 3. Create Observations linked to the Encounter & Patient
+        // Weight Observation (LOINC 29463-7)
+        if (input.weightKg != null) {
+            val weightObs = JSONObject().apply {
+                put("resourceType", "Observation")
+                put("status", "final")
+                put("category", JSONArray().put(JSONObject().apply {
+                    put("coding", JSONArray().put(JSONObject().apply {
+                        put("system", "http://terminology.hl7.org/CodeSystem/observation-category")
+                        put("code", "vital-signs")
+                        put("display", "Vital Signs")
+                    }))
+                }))
+                put("code", JSONObject().apply {
+                    put("coding", JSONArray().put(JSONObject().apply {
+                        put("system", "http://loinc.org")
+                        put("code", "29463-7")
+                        put("display", "Body weight")
+                    }))
+                    put("text", "Body weight")
+                })
+                put("subject", JSONObject().put("reference", "Patient/$patientId"))
+                if (encounterId.isNotBlank()) {
+                    put("encounter", JSONObject().put("reference", "Encounter/$encounterId"))
+                }
+                put("effectiveDateTime", input.visitDate)
+                put("valueQuantity", JSONObject().apply {
+                    put("value", input.weightKg)
+                    put("unit", "kg")
+                    put("system", "http://unitsofmeasure.org")
+                    put("code", "kg")
+                })
+            }
+            postJson("$baseUrl/Observation", weightObs)
+        }
+
+        // Blood Pressure Observation (LOINC 85354-9 with 8480-6 and 8462-4 components)
+        if (input.bpSystolic != null || input.bpDiastolic != null) {
+            val components = JSONArray()
+            if (input.bpSystolic != null) {
+                components.put(JSONObject().apply {
+                    put("code", JSONObject().apply {
+                        put("coding", JSONArray().put(JSONObject().apply {
+                            put("system", "http://loinc.org")
+                            put("code", "8480-6")
+                            put("display", "Systolic blood pressure")
+                        }))
+                    })
+                    put("valueQuantity", JSONObject().apply {
+                        put("value", input.bpSystolic)
+                        put("unit", "mmHg")
+                        put("system", "http://unitsofmeasure.org")
+                        put("code", "mm[Hg]")
+                    })
+                })
+            }
+            if (input.bpDiastolic != null) {
+                components.put(JSONObject().apply {
+                    put("code", JSONObject().apply {
+                        put("coding", JSONArray().put(JSONObject().apply {
+                            put("system", "http://loinc.org")
+                            put("code", "8462-4")
+                            put("display", "Diastolic blood pressure")
+                        }))
+                    })
+                    put("valueQuantity", JSONObject().apply {
+                        put("value", input.bpDiastolic)
+                        put("unit", "mmHg")
+                        put("system", "http://unitsofmeasure.org")
+                        put("code", "mm[Hg]")
+                    })
+                })
+            }
+            val bpObs = JSONObject().apply {
+                put("resourceType", "Observation")
+                put("status", "final")
+                put("category", JSONArray().put(JSONObject().apply {
+                    put("coding", JSONArray().put(JSONObject().apply {
+                        put("system", "http://terminology.hl7.org/CodeSystem/observation-category")
+                        put("code", "vital-signs")
+                        put("display", "Vital Signs")
+                    }))
+                }))
+                put("code", JSONObject().apply {
+                    put("coding", JSONArray().put(JSONObject().apply {
+                        put("system", "http://loinc.org")
+                        put("code", "85354-9")
+                        put("display", "Blood pressure panel with all children optional")
+                    }))
+                    put("text", "Blood pressure")
+                })
+                put("subject", JSONObject().put("reference", "Patient/$patientId"))
+                if (encounterId.isNotBlank()) {
+                    put("encounter", JSONObject().put("reference", "Encounter/$encounterId"))
+                }
+                put("effectiveDateTime", input.visitDate)
+                put("component", components)
+            }
+            postJson("$baseUrl/Observation", bpObs)
+        }
+
+        // Gestational Age Observation (LOINC 11884-4)
+        if (input.gestationalAgeWeeks != null) {
+            val gaObs = JSONObject().apply {
+                put("resourceType", "Observation")
+                put("status", "final")
+                put("code", JSONObject().apply {
+                    put("coding", JSONArray().put(JSONObject().apply {
+                        put("system", "http://loinc.org")
+                        put("code", "11884-4")
+                        put("display", "Gestational age Estimated")
+                    }))
+                    put("text", "Gestational age (weeks)")
+                })
+                put("subject", JSONObject().put("reference", "Patient/$patientId"))
+                if (encounterId.isNotBlank()) {
+                    put("encounter", JSONObject().put("reference", "Encounter/$encounterId"))
+                }
+                put("effectiveDateTime", input.visitDate)
+                put("valueQuantity", JSONObject().apply {
+                    put("value", input.gestationalAgeWeeks)
+                    put("unit", "wk")
+                    put("system", "http://unitsofmeasure.org")
+                    put("code", "wk")
+                })
+            }
+            postJson("$baseUrl/Observation", gaObs)
+        }
+    }
+
+    private fun buildVisitsForPatient(
+        patientId: String,
+        encounters: List<JSONObject>,
+        obsByEncounter: Map<String, List<JSONObject>>,
+        allPatientObs: List<JSONObject>,
+        qrByEncounter: Map<String, JSONObject>,
+        patientQrs: List<JSONObject>
+    ): List<AncVisit> {
+        val visits = mutableListOf<AncVisit>()
+        val handledQrIds = mutableSetOf<String>()
+
+        for (enc in encounters) {
+            val encId = enc.optString("id")
+            val date = enc.optJSONObject("period")?.optString("start")?.take(10) ?: ""
+            val encObs = obsByEncounter[encId].orEmpty()
+            val qr = qrByEncounter[encId]
+            if (qr != null) {
+                handledQrIds.add(qr.optString("id"))
+            }
+
+            var weightKg: Double? = null
+            var bpSystolic: Int? = null
+            var bpDiastolic: Int? = null
+            var hbGdL: Double? = null
+            var gaWeeks: Int? = null
+            val dangerSigns = mutableListOf<String>()
+            var notes: String? = null
+
+            for (obs in encObs) {
+                val code = getPrimaryCodingCode(obs)
+                when (code) {
+                    "29463-7" -> {
+                        weightKg = obs.optJSONObject("valueQuantity")?.optDouble("value")
+                    }
+                    "85354-9" -> {
+                        val comps = obs.optJSONArray("component")
+                        if (comps != null) {
+                            for (i in 0 until comps.length()) {
+                                val comp = comps.optJSONObject(i) ?: continue
+                                val compCode = getPrimaryCodingCode(comp)
+                                val value = comp.optJSONObject("valueQuantity")?.optInt("value")
+                                if (compCode == "8480-6") bpSystolic = value
+                                if (compCode == "8462-4") bpDiastolic = value
+                            }
+                        }
+                    }
+                    "8480-6" -> {
+                        bpSystolic = obs.optJSONObject("valueQuantity")?.optInt("value")
+                    }
+                    "8462-4" -> {
+                        bpDiastolic = obs.optJSONObject("valueQuantity")?.optInt("value")
+                    }
+                    "718-7" -> {
+                        hbGdL = obs.optJSONObject("valueQuantity")?.optDouble("value")
+                    }
+                    "11884-4" -> {
+                        gaWeeks = obs.optJSONObject("valueQuantity")?.optInt("value")
+                    }
+                }
+            }
+
+            if (qr != null) {
+                val parsedQr = extractVisitDetailsFromQr(qr)
+                if (gaWeeks == null) gaWeeks = parsedQr.gestationalAgeWeeks
+                if (weightKg == null) weightKg = parsedQr.weightKg
+                if (bpSystolic == null) bpSystolic = parsedQr.bpSystolic
+                if (bpDiastolic == null) bpDiastolic = parsedQr.bpDiastolic
+                if ( parsedQr.dangerSigns.isNotEmpty()) {
+                    dangerSigns.addAll(parsedQr.dangerSigns)
+                }
+                if (!parsedQr.notes.isNullOrBlank()) {
+                    notes = parsedQr.notes
+                }
+            }
+
+            visits.add(
+                AncVisit(
+                    id = encId.ifBlank { "visit-${visits.size}" },
+                    date = date,
+                    gestationalAgeWeeks = gaWeeks,
+                    weightKg = weightKg,
+                    bpSystolic = bpSystolic,
+                    bpDiastolic = bpDiastolic,
+                    hemoglobinGdL = hbGdL,
+                    dangerSigns = dangerSigns,
+                    notes = notes
+                )
+            )
+        }
+
+        // Also include any standalone QuestionnaireResponses not linked to an Encounter
+        for (qr in patientQrs) {
+            val qrId = qr.optString("id")
+            if (qrId in handledQrIds) continue
+            val parsedQr = extractVisitDetailsFromQr(qr)
+            visits.add(parsedQr)
+        }
+
+        return visits
+    }
+
+    private fun extractVisitDetailsFromQr(qr: JSONObject): AncVisit {
+        val qrId = qr.optString("id", "qr")
+        var visitDate = qr.optString("authored", "").take(10)
+        var gaWeeks: Int? = null
+        var weightKg: Double? = null
+        var bpSystolic: Int? = null
+        var bpDiastolic: Int? = null
+        val dangerSigns = mutableListOf<String>()
+        var notes: String? = null
+
+        fun parseItems(items: JSONArray?) {
+            if (items == null) return
+            for (i in 0 until items.length()) {
+                val item = items.optJSONObject(i) ?: continue
+                val linkId = item.optString("linkId")
+                val answers = item.optJSONArray("answer")
+                val firstAns = answers?.optJSONObject(0)
+
+                when (linkId) {
+                    "visit-date" -> {
+                        val d = firstAns?.optString("valueDate")
+                        if (!d.isNullOrBlank()) visitDate = d
+                    }
+                    "gestational-age" -> {
+                        if (firstAns?.has("valueInteger") == true) {
+                            gaWeeks = firstAns.optInt("valueInteger")
+                        }
+                    }
+                    "weight" -> {
+                        if (firstAns?.has("valueDecimal") == true) {
+                            weightKg = firstAns.optDouble("valueDecimal")
+                        } else if (firstAns?.has("valueInteger") == true) {
+                            weightKg = firstAns.optInt("valueInteger").toDouble()
+                        }
+                    }
+                    "bp-systolic" -> {
+                        if (firstAns?.has("valueInteger") == true) {
+                            bpSystolic = firstAns.optInt("valueInteger")
+                        }
+                    }
+                    "bp-diastolic" -> {
+                        if (firstAns?.has("valueInteger") == true) {
+                            bpDiastolic = firstAns.optInt("valueInteger")
+                        }
+                    }
+                    "danger-signs" -> {
+                        if (answers != null) {
+                            for (j in 0 until answers.length()) {
+                                val ans = answers.optJSONObject(j) ?: continue
+                                val coding = ans.optJSONObject("valueCoding")
+                                val display = coding?.optString("display")
+                                    ?: coding?.optString("code")
+                                    ?: ans.optString("valueString")
+                                if (!display.isNullOrBlank()) {
+                                    dangerSigns.add(display)
+                                }
+                            }
+                        }
+                    }
+                    "notes" -> {
+                        val n = firstAns?.optString("valueString")
+                        if (!n.isNullOrBlank()) notes = n
+                    }
+                }
+                parseItems(item.optJSONArray("item"))
+            }
+        }
+
+        parseItems(qr.optJSONArray("item"))
+
+        return AncVisit(
+            id = qrId,
+            date = visitDate,
+            gestationalAgeWeeks = gaWeeks,
+            weightKg = weightKg,
+            bpSystolic = bpSystolic,
+            bpDiastolic = bpDiastolic,
+            hemoglobinGdL = null,
+            dangerSigns = dangerSigns,
+            notes = notes
+        )
+    }
+
+    private fun parseQuestionnaire(json: JSONObject): AncQuestionnaire {
+        val id = json.optString("id", "anc-contact")
+        val url = json.optString("url", "http://example.org/fhir/Questionnaire/anc-contact")
+        val title = json.optString("title", "ANC Contact Visit")
+
+        fun parseItems(itemsArray: JSONArray?): List<QuestionnaireItemSpec> {
+            if (itemsArray == null) return emptyList()
+            val list = mutableListOf<QuestionnaireItemSpec>()
+            for (i in 0 until itemsArray.length()) {
+                val obj = itemsArray.optJSONObject(i) ?: continue
+                val linkId = obj.optString("linkId")
+                val text = obj.optString("text", linkId)
+                val type = obj.optString("type", "string")
+                val required = obj.optBoolean("required", false)
+                val repeats = obj.optBoolean("repeats", false)
+
+                val options = mutableListOf<QuestionnaireOption>()
+                val answerOptions = obj.optJSONArray("answerOption")
+                if (answerOptions != null) {
+                    for (j in 0 until answerOptions.length()) {
+                        val optObj = answerOptions.optJSONObject(j) ?: continue
+                        val coding = optObj.optJSONObject("valueCoding")
+                        if (coding != null) {
+                            options.add(
+                                QuestionnaireOption(
+                                    system = coding.optString("system", "urn:example:anc-danger-signs"),
+                                    code = coding.optString("code"),
+                                    display = coding.optString("display", coding.optString("code"))
+                                )
+                            )
+                        }
+                    }
+                }
+
+                val children = parseItems(obj.optJSONArray("item"))
+                list.add(
+                    QuestionnaireItemSpec(
+                        linkId = linkId,
+                        text = text,
+                        type = type,
+                        required = required,
+                        repeats = repeats,
+                        options = options,
+                        children = children
+                    )
+                )
+            }
+            return list
+        }
+
+        return AncQuestionnaire(
+            id = id,
+            url = url,
+            title = title,
+            items = parseItems(json.optJSONArray("item"))
+        )
+    }
+
+    private fun parsePatientName(pt: JSONObject): String {
+        val names = pt.optJSONArray("name")
+        if (names == null || names.length() == 0) return "Unknown Patient"
+        val nameObj = names.optJSONObject(0) ?: return "Unknown Patient"
+        val text = nameObj.optString("text")
+        if (text.isNotBlank()) return text
+
+        val givenArr = nameObj.optJSONArray("given")
+        val givenParts = mutableListOf<String>()
+        if (givenArr != null) {
+            for (i in 0 until givenArr.length()) {
+                val g = givenArr.optString(i)
+                if (g.isNotBlank()) givenParts.add(g)
+            }
+        }
+        val family = nameObj.optString("family")
+        if (family.isNotBlank()) givenParts.add(family)
+        return givenParts.joinToString(" ").ifBlank { "Unknown Patient" }
+    }
+
+    private fun findEdd(observations: List<JSONObject>): String {
+        for (obs in observations) {
+            val code = getPrimaryCodingCode(obs)
+            if (code == "11778-8") {
+                val valDt = obs.optString("valueDateTime")
+                if (valDt.isNotBlank()) return valDt.take(10)
+            }
+        }
+        return ""
+    }
+
+    private fun getPrimaryCodingCode(obj: JSONObject): String {
+        val codeObj = obj.optJSONObject("code") ?: return ""
+        val codings = codeObj.optJSONArray("coding") ?: return ""
+        return codings.optJSONObject(0)?.optString("code") ?: ""
+    }
+
+    private fun calculateAge(birthDateStr: String, today: LocalDate): Int {
+        return try {
+            val dob = LocalDate.parse(birthDateStr.take(10))
+            Period.between(dob, today).years
+        } catch (_: Exception) {
+            0
+        }
+    }
+
+    private fun calculateCurrentGestationalWeeks(
+        eddStr: String,
+        latestVisit: AncVisit?,
+        today: LocalDate
+    ): Int {
+        // If latest visit explicitly recorded gestational age on today's date, use it
+        if (latestVisit?.gestationalAgeWeeks != null && latestVisit.date == today.toString()) {
+            return latestVisit.gestationalAgeWeeks
+        }
+        return try {
+            val edd = LocalDate.parse(eddStr.take(10))
+            // Standard 40-week (280-day) pregnancy duration:
+            // LMP = EDD - 280 days; Gestational age in weeks = days since LMP / 7
+            val lmp = edd.minusDays(280)
+            val daysPregnant = ChronoUnit.DAYS.between(lmp, today)
+            (daysPregnant / 7).toInt().coerceAtLeast(0)
+        } catch (_: Exception) {
+            latestVisit?.gestationalAgeWeeks ?: 0
+        }
+    }
+
+    private fun extractEntries(bundle: JSONObject): List<JSONObject> {
+        val entries = bundle.optJSONArray("entry") ?: return emptyList()
+        val list = mutableListOf<JSONObject>()
+        for (i in 0 until entries.length()) {
+            val resource = entries.optJSONObject(i)?.optJSONObject("resource")
+            if (resource != null) {
+                list.add(resource)
+            }
+        }
+        return list
+    }
+
+    private fun getJson(urlStr: String): JSONObject {
+        val url = URL(urlStr)
+        val conn = (url.openConnection() as HttpURLConnection).apply {
+            requestMethod = "GET"
+            setRequestProperty("Accept", "application/fhir+json, application/json")
+            connectTimeout = 10000
+            readTimeout = 10000
+        }
+        try {
+            val code = conn.responseCode
+            val stream = if (code in 200..299) conn.inputStream else conn.errorStream
+            val text = BufferedReader(InputStreamReader(stream)).use { it.readText() }
+            if (code !in 200..299) {
+                throw RuntimeException("HTTP GET $urlStr failed ($code): $text")
+            }
+            return JSONObject(text)
+        } finally {
+            conn.disconnect()
+        }
+    }
+
+    private fun postJson(urlStr: String, payload: JSONObject): JSONObject {
+        val url = URL(urlStr)
+        val conn = (url.openConnection() as HttpURLConnection).apply {
+            requestMethod = "POST"
+            doOutput = true
+            setRequestProperty("Content-Type", "application/fhir+json")
+            setRequestProperty("Accept", "application/fhir+json, application/json")
+            connectTimeout = 10000
+            readTimeout = 10000
+        }
+        try {
+            OutputStreamWriter(conn.outputStream, Charsets.UTF_8).use { writer ->
+                writer.write(payload.toString())
+            }
+            val code = conn.responseCode
+            val stream = if (code in 200..299) conn.inputStream else conn.errorStream
+            val text = BufferedReader(InputStreamReader(stream)).use { it.readText() }
+            if (code !in 200..299) {
+                throw RuntimeException("HTTP POST $urlStr failed ($code): $text")
+            }
+            return if (text.isNotBlank()) JSONObject(text) else JSONObject()
+        } finally {
+            conn.disconnect()
+        }
+    }
+}
