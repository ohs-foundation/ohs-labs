+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun NewVisitFormScreen(
+  patientId: String,
+  patientName: String,
+  onBackClick: () -> Unit,
+  onSaveVisit: (
+    LocalDate, Int, Double, Int, Int, Double?, String, List<String>
+  ) -> Unit,
+  modifier: Modifier = Modifier
+) {
+  var visitDate by remember { mutableStateOf(LocalDate.now().toString()) }
+  var gestationalAge by remember { mutableStateOf("") }
+  var weight by remember { mutableStateOf("") }
+  var systolic by remember { mutableStateOf("") }
+  var diastolic by remember { mutableStateOf("") }
+  var hemoglobin by remember { mutableStateOf("") }
+  var notes by remember { mutableStateOf("") }
+
+  var vaginalBleeding by remember { mutableStateOf(false) }
+  var severeHeadache by remember { mutableStateOf(false) }
+  var blurredVision by remember { mutableStateOf(false) }
+  var fever by remember { mutableStateOf(false) }
+
+  Scaffold(
