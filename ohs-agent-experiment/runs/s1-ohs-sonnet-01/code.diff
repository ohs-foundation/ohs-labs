diff --git a/app/src/main/java/com/example/ancapp/data/AncRepository.kt b/app/src/main/java/com/example/ancapp/data/AncRepository.kt
new file mode 100644
index 0000000..2e9f0b2
--- /dev/null
+++ b/app/src/main/java/com/example/ancapp/data/AncRepository.kt
@@ -0,0 +1,294 @@
+package com.example.ancapp.data
+
+import android.content.Context
+import androidx.work.ExistingWorkPolicy
+import androidx.work.WorkInfo
+import androidx.work.WorkManager
+import com.example.ancapp.sync.AncSyncWorker
+import com.ionspin.kotlin.bignum.decimal.BigDecimal as IonBigDecimal
+import dev.ohs.fhir.engine.FhirEngineProvider
+import dev.ohs.fhir.engine.get
+import dev.ohs.fhir.engine.search.Search
+import dev.ohs.fhir.engine.sync.Sync
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.CodeableConcept
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Enumeration
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Patient
+import dev.ohs.fhir.model.r4.Period
+import dev.ohs.fhir.model.r4.Questionnaire
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import dev.ohs.fhir.model.r4.Reference
+import dev.ohs.fhir.model.r4.Resource
+import dev.ohs.fhir.model.r4.Uri
+import dev.ohs.fhir.model.r4.String as FhirString
+import dev.ohs.fhir.model.r4.terminologies.ResourceType
+import java.math.BigDecimal
+import java.time.LocalDate
+import java.time.Period as JavaPeriod
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+import kotlinx.coroutines.delay
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+
+private val fhirJson = Json {
+  explicitNulls = false
+  encodeDefaults = false
+}
+
+object AncRepository {
+
+  private fun engine(context: Context) = FhirEngineProvider.getInstance(context.applicationContext)
+
+  /** Downloads the latest patients/encounters/observations/questionnaire from the server. */
+  suspend fun sync(context: Context): Boolean {
+    val appContext = context.applicationContext
+    try {
+      Sync.oneTimeSync<AncSyncWorker>(appContext, existingWorkPolicy = ExistingWorkPolicy.APPEND_OR_REPLACE)
+    } catch (e: Exception) {
+      return false
+    }
+    return awaitSyncCompletion(appContext) == WorkInfo.State.SUCCEEDED
+  }
+
+  /** Pushes local changes (e.g. a just-recorded visit) up to the server; best-effort. */
+  suspend fun pushLocalChanges(context: Context) {
+    val appContext = context.applicationContext
+    try {
+      Sync.oneTimeSync<AncSyncWorker>(appContext, existingWorkPolicy = ExistingWorkPolicy.APPEND_OR_REPLACE)
+    } catch (e: Exception) {
+      return
+    }
+    awaitSyncCompletion(appContext)
+  }
+
+  /**
+   * The library's own sync-status flow (Sync.oneTimeSync().first { ... }) throws
+   * IllegalStateException("Inconsistent terminal syncJobStatus") on this server's responses,
+   * so completion is observed by polling WorkManager directly instead. The most recently
+   * enqueued run for this worker is the last entry returned for its tag.
+   */
+  private suspend fun awaitSyncCompletion(appContext: Context): WorkInfo.State? {
+    val workManager = WorkManager.getInstance(appContext)
+    repeat(150) {
+      val info = workManager.getWorkInfosByTag(AncSyncWorker::class.java.name).get().lastOrNull()
+      if (info != null && info.state.isFinished) return info.state
+      delay(200)
+    }
+    return null
+  }
+
+  suspend fun loadRegister(context: Context): List<PatientSummary> {
+    val eng = engine(context)
+    val patients = eng.search<Patient>(Search(ResourceType.Patient)).map { it.resource }
+    val observations = eng.search<Observation>(Search(ResourceType.Observation)).map { it.resource }
+    val today = LocalDate.now()
+
+    return patients.map { patient ->
+      val patientRef = "Patient/${patient.id}"
+      val dueDate = observations.firstOrNull {
+        it.subject?.reference?.value == patientRef && it.hasLoincCode(LOINC_EDD)
+      }?.value?.asDateTime()?.value.toJavaLocalDate()
+
+      PatientSummary(
+        id = patient.id.orEmpty(),
+        name = patient.displayName(),
+        age = ageYears(patient.birthDate.toJavaLocalDate(), today),
+        dueDate = dueDate,
+        gestationalAgeWeeks = dueDate?.let { gestationalAgeWeeks(it, today) },
+      )
+    }.sortedWith(compareBy(nullsLast<LocalDate>()) { it.dueDate })
+  }
+
+  suspend fun loadVisits(context: Context, patientId: String): List<VisitSummary> {
+    val eng = engine(context)
+    val patientRef = "Patient/$patientId"
+
+    val encounters = eng.search<Encounter>(Search(ResourceType.Encounter)).map { it.resource }
+      .filter { it.subject?.reference?.value == patientRef }
+    val observations = eng.search<Observation>(Search(ResourceType.Observation)).map { it.resource }
+      .filter { it.subject?.reference?.value == patientRef }
+    val obsByEncounter = observations.groupBy { it.encounter?.reference?.value }
+
+    return encounters.mapNotNull { enc ->
+      val date = enc.period?.start.toJavaLocalDate() ?: return@mapNotNull null
+      val obs = obsByEncounter["Encounter/${enc.id}"].orEmpty()
+
+      val weight = obs.firstOrNull { it.hasLoincCode(LOINC_WEIGHT) }
+        ?.value?.asQuantity()?.value?.value?.value?.toJavaDecimal()
+      val bp = obs.firstOrNull { it.hasLoincCode(LOINC_BP_PANEL) }
+      val systolic = bp?.component.orEmpty().firstOrNull { it.hasLoincCode(LOINC_SYSTOLIC) }
+        ?.value?.asQuantity()?.value?.value?.value?.toJavaDecimal()?.toInt()
+      val diastolic = bp?.component.orEmpty().firstOrNull { it.hasLoincCode(LOINC_DIASTOLIC) }
+        ?.value?.asQuantity()?.value?.value?.value?.toJavaDecimal()?.toInt()
+      val hemoglobin = obs.firstOrNull { it.hasLoincCode(LOINC_HB) }
+        ?.value?.asQuantity()?.value?.value?.value?.toJavaDecimal()
+      val gestationalAge = obs.firstOrNull { it.hasText(TEXT_GESTATIONAL_AGE) }
+        ?.value?.asQuantity()?.value?.value?.value?.toJavaDecimal()?.toInt()
+      val dangerSigns = obs.filter { it.hasText(TEXT_DANGER_SIGN) }
+        .mapNotNull { it.value?.asCodeableConcept()?.value?.coding?.firstOrNull()?.display?.value }
+      val notes = obs.firstOrNull { it.hasText(TEXT_NOTES) }?.value?.asString()?.value?.value
+
+      VisitSummary(
+        encounterId = enc.id.orEmpty(),
+        date = date,
+        gestationalAgeWeeks = gestationalAge,
+        weightKg = weight,
+        systolic = systolic,
+        diastolic = diastolic,
+        hemoglobin = hemoglobin,
+        dangerSigns = dangerSigns,
+        notes = notes,
+      )
+    }.sortedByDescending { it.date }
+  }
+
+  suspend fun patientName(context: Context, patientId: String): String =
+    engine(context).get<Patient>(patientId).displayName()
+
+  suspend fun loadVisitQuestionnaireJson(context: Context): String {
+    val questionnaire = engine(context).get<Questionnaire>("anc-contact")
+    return fhirJson.encodeToString(questionnaire)
+  }
+
+  suspend fun saveVisit(context: Context, patientId: String, response: QuestionnaireResponse) {
+    val answers = mutableMapOf<String, MutableList<QuestionnaireResponse.Item.Answer>>()
+    fun collect(items: List<QuestionnaireResponse.Item>) {
+      items.forEach { item ->
+        item.linkId.value?.let { answers.getOrPut(it) { mutableListOf() }.addAll(item.answer) }
+        collect(item.item)
+        item.answer.forEach { collect(it.item) }
+      }
+    }
+    collect(response.item)
+
+    val visitDate = answers["visit-date"]?.firstOrNull()?.value?.asDate()?.value.toJavaLocalDate() ?: LocalDate.now()
+    val gestationalAge = answers["gestational-age"]?.firstOrNull()?.value?.asInteger()?.value?.value
+    val weight = answers["weight"]?.firstOrNull()?.value?.asDecimal()?.value?.value
+    val systolic = answers["bp-systolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+    val diastolic = answers["bp-diastolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+    val dangerSignCodings = answers["danger-signs"].orEmpty().mapNotNull { it.value?.asCoding()?.value }
+      .filter { it.code?.value != DangerSign.NONE.code }
+    val notes = answers["notes"]?.firstOrNull()?.value?.asString()?.value?.value
+
+    val encounterId = UUID.randomUUID().toString()
+    val patientRef = Reference(reference = FhirString(value = "Patient/$patientId"))
+    val encounterRef = Reference(reference = FhirString(value = "Encounter/$encounterId"))
+    val effective = Observation.Effective.DateTime(visitDate.toFhirDateTime())
+
+    val encounter = Encounter(
+      id = encounterId,
+      status = Enumeration(value = Encounter.EncounterStatus.Finished),
+      `class` = Coding(
+        system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"),
+        code = Code(value = "AMB"),
+        display = FhirString(value = "ambulatory"),
+      ),
+      type = listOf(CodeableConcept(text = FhirString(value = "Antenatal care contact"))),
+      subject = patientRef,
+      period = Period(start = visitDate.toFhirDateTime(), end = visitDate.toFhirDateTime()),
+    )
+
+    val resources = mutableListOf<Resource>(encounter)
+
+    weight?.let {
+      resources += Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        category = listOf(vitalSignsCategory()),
+        code = loincConcept(LOINC_WEIGHT, "Body weight"),
+        subject = patientRef,
+        encounter = encounterRef,
+        effective = effective,
+        value = Observation.Value.Quantity(quantityOf(it, "kg", "kg")),
+      )
+    }
+
+    if (systolic != null || diastolic != null) {
+      val components = mutableListOf<Observation.Component>()
+      systolic?.let {
+        components += Observation.Component(
+          code = loincConcept(LOINC_SYSTOLIC, "Systolic blood pressure"),
+          value = Observation.Component.Value.Quantity(quantityOf(IonBigDecimal.fromInt(it), "mmHg", "mm[Hg]")),
+        )
+      }
+      diastolic?.let {
+        components += Observation.Component(
+          code = loincConcept(LOINC_DIASTOLIC, "Diastolic blood pressure"),
+          value = Observation.Component.Value.Quantity(quantityOf(IonBigDecimal.fromInt(it), "mmHg", "mm[Hg]")),
+        )
+      }
+      resources += Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        category = listOf(vitalSignsCategory()),
+        code = loincConcept(LOINC_BP_PANEL, "Blood pressure panel with all children optional"),
+        subject = patientRef,
+        encounter = encounterRef,
+        effective = effective,
+        component = components,
+      )
+    }
+
+    gestationalAge?.let {
+      resources += Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        code = textOnlyConcept(TEXT_GESTATIONAL_AGE),
+        subject = patientRef,
+        encounter = encounterRef,
+        effective = effective,
+        value = Observation.Value.Quantity(quantityOf(IonBigDecimal.fromInt(it), "weeks", "wk")),
+      )
+    }
+
+    dangerSignCodings.forEach { coding ->
+      resources += Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        code = textOnlyConcept(TEXT_DANGER_SIGN),
+        subject = patientRef,
+        encounter = encounterRef,
+        effective = effective,
+        value = Observation.Value.CodeableConcept(
+          CodeableConcept(coding = listOf(coding), text = coding.display),
+        ),
+      )
+    }
+
+    notes?.takeIf { it.isNotBlank() }?.let {
+      resources += Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        code = textOnlyConcept(TEXT_NOTES),
+        subject = patientRef,
+        encounter = encounterRef,
+        effective = effective,
+        value = Observation.Value.String(FhirString(value = it)),
+      )
+    }
+
+    engine(context).create(*resources.toTypedArray())
+  }
+}
+
+private fun Patient.displayName(): String {
+  val n = name.firstOrNull()
+  val given = n?.given.orEmpty().joinToString(" ") { it.value.orEmpty() }
+  val family = n?.family?.value.orEmpty()
+  return "$given $family".trim().ifBlank { "Unknown" }
+}
+
+private fun ageYears(birthDate: LocalDate?, today: LocalDate): Int =
+  birthDate?.let { JavaPeriod.between(it, today).years } ?: 0
+
+private fun gestationalAgeWeeks(dueDate: LocalDate, today: LocalDate): Int {
+  val daysUntilDue = ChronoUnit.DAYS.between(today, dueDate)
+  val weeks = Math.round((280.0 - daysUntilDue) / 7.0).toInt()
+  return weeks.coerceIn(0, 45)
+}
+
+private fun IonBigDecimal.toJavaDecimal(): BigDecimal = BigDecimal(this.toPlainString())
diff --git a/app/src/main/java/com/example/ancapp/data/FhirBuilders.kt b/app/src/main/java/com/example/ancapp/data/FhirBuilders.kt
