diff --git a/app/src/main/java/com/example/ancapp/AncViewModel.kt b/app/src/main/java/com/example/ancapp/AncViewModel.kt
new file mode 100644
index 0000000..c7ef2ec
--- /dev/null
+++ b/app/src/main/java/com/example/ancapp/AncViewModel.kt
@@ -0,0 +1,120 @@
+package com.example.ancapp
+
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import kotlinx.coroutines.launch
+
+sealed class ScreenState {
+    object Register : ScreenState()
+    data class PatientDetail(val patientId: String) : ScreenState()
+    data class NewVisitForm(val patientId: String) : ScreenState()
+}
+
+class AncViewModel : ViewModel() {
+    private val repository = FhirRepository()
+
+    var screenState by mutableStateOf<ScreenState>(ScreenState.Register)
+        private set
+
+    var patients by mutableStateOf<List<PatientSummary>>(emptyList())
+        private set
+
+    var visitsByPatient by mutableStateOf<Map<String, List<AncVisit>>>(emptyMap())
+        private set
+
+    var questionnaire by mutableStateOf<AncQuestionnaire?>(null)
+        private set
+
+    var isLoading by mutableStateOf(false)
+        private set
+
+    var isSaving by mutableStateOf(false)
+        private set
+
+    var errorMessage by mutableStateOf<String?>(null)
+        private set
+
+    init {
+        refreshAll()
+    }
+
+    fun refreshAll() {
+        viewModelScope.launch {
+            isLoading = true
+            errorMessage = null
+            try {
+                val (loadedPatients, loadedVisits) = repository.fetchPatientsAndVisits()
+                patients = loadedPatients
+                visitsByPatient = loadedVisits
+                if (questionnaire == null) {
+                    questionnaire = repository.fetchQuestionnaire("anc-contact")
+                }
+            } catch (e: Exception) {
+                errorMessage = e.message ?: "Failed to load data from FHIR server"
+            } finally {
+                isLoading = false
+            }
+        }
+    }
+
+    fun openPatientDetail(patientId: String) {
+        errorMessage = null
+        screenState = ScreenState.PatientDetail(patientId)
+    }
+
+    fun openNewVisitForm(patientId: String) {
+        errorMessage = null
+        viewModelScope.launch {
+            if (questionnaire == null) {
+                try {
+                    questionnaire = repository.fetchQuestionnaire("anc-contact")
+                } catch (_: Exception) {
+                    // Use fallback default questionnaire structure if fetch fails temporarily
+                }
+            }
+            screenState = ScreenState.NewVisitForm(patientId)
+        }
+    }
+
+    fun navigateBack() {
+        errorMessage = null
+        screenState = when (val current = screenState) {
+            is ScreenState.NewVisitForm -> ScreenState.PatientDetail(current.patientId)
+            is ScreenState.PatientDetail -> ScreenState.Register
+            ScreenState.Register -> ScreenState.Register
+        }
+    }
+
+    fun saveVisit(
+        patientId: String,
+        input: NewVisitInput,
+        onSuccess: () -> Unit
+    ) {
+        viewModelScope.launch {
+            isSaving = true
+            errorMessage = null
+            try {
+                val q = questionnaire ?: repository.fetchQuestionnaire("anc-contact").also {
+                    questionnaire = it
+                }
+                repository.submitAncVisit(
+                    patientId = patientId,
+                    questionnaire = q,
+                    input = input
+                )
+                val (loadedPatients, loadedVisits) = repository.fetchPatientsAndVisits()
+                patients = loadedPatients
+                visitsByPatient = loadedVisits
+                screenState = ScreenState.PatientDetail(patientId)
+                onSuccess()
+            } catch (e: Exception) {
+                errorMessage = e.message ?: "Failed to save ANC visit"
+            } finally {
+                isSaving = false
+            }
+        }
+    }
+}
diff --git a/app/src/main/java/com/example/ancapp/FhirRepository.kt b/app/src/main/java/com/example/ancapp/FhirRepository.kt
new file mode 100644
index 0000000..098e913
