+        .padding(16.dp),
+      verticalArrangement = Arrangement.spacedBy(12.dp),
+    ) {
+      OutlinedTextField(
+        value = date,
+        onValueChange = {},
+        readOnly = true,
+        label = { Text("Visit date") },
+        trailingIcon = {
+          TextButton(onClick = { showDatePicker = true }) { Text("Change") }
+        },
+        modifier = Modifier.fillMaxWidth(),
+      )
+      OutlinedTextField(
+        value = weeksValue,
+        onValueChange = { weeksTouched = true; weeks = it },
+        label = { Text("Gestational age (weeks)") },
+        modifier = Modifier.fillMaxWidth(),
+      )
+      OutlinedTextField(
+        value = weight,
+        onValueChange = { weight = it },
+        label = { Text("Weight (kg)") },
+        modifier = Modifier.fillMaxWidth(),
+      )
+      Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
+        OutlinedTextField(
+          value = systolic,
+          onValueChange = { systolic = it },
+          label = { Text("Systolic (mmHg)") },
+          modifier = Modifier.weight(1f),
+        )
+        OutlinedTextField(
+          value = diastolic,
+          onValueChange = { diastolic = it },
+          label = { Text("Diastolic (mmHg)") },
+          modifier = Modifier.weight(1f),
+        )
+      }
+      OutlinedTextField(
+        value = hemoglobin,
+        onValueChange = { hemoglobin = it },
+        label = { Text("Hemoglobin (g/dL, optional)") },
+        modifier = Modifier.fillMaxWidth(),
+      )
+
+      Text("Danger signs", style = MaterialTheme.typography.titleSmall)
+      FlowRow(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+        FilterChip(
+          selected = signs.isEmpty(),
+          onClick = { signs = emptySet() },
+          label = { Text("None") },
+        )
+        DangerSign.entries.forEach { sign ->
+          FilterChip(
+            selected = sign.name in signs,
+            onClick = {
+              signs = if (sign.name in signs) signs - sign.name else signs + sign.name
+            },
+            label = { Text(sign.label) },
+          )
+        }
+      }
+
+      OutlinedTextField(
+        value = notes,
+        onValueChange = { notes = it },
+        label = { Text("Notes") },
+        minLines = 3,
+        modifier = Modifier.fillMaxWidth(),
+      )
+
+      error?.let {
+        Text(it, color = MaterialTheme.colorScheme.error, style = MaterialTheme.typography.bodyMedium)
+      }
+
+      Button(
+        onClick = {
+          val weeksInt = weeksValue.trim().toIntOrNull()
+          val weightVal = weight.trim().toDoubleOrNull()
+          val sysInt = systolic.trim().toIntOrNull()
+          val diaInt = diastolic.trim().toIntOrNull()
+          val hbTrimmed = hemoglobin.trim()
+          val hbVal = if (hbTrimmed.isEmpty()) null else hbTrimmed.toDoubleOrNull()
+          error = when {
+            weeksInt == null || weeksInt !in 1..45 ->
+              "Enter a gestational age between 1 and 45 weeks."
+            weightVal == null || weightVal <= 0 -> "Enter a valid weight in kg."
+            sysInt == null || sysInt !in 50..260 -> "Enter a valid systolic pressure."
+            diaInt == null || diaInt !in 30..200 -> "Enter a valid diastolic pressure."
+            hbTrimmed.isNotEmpty() && hbVal == null -> "Hemoglobin must be a number."
+            else -> null
+          }
+          if (error == null) {
+            viewModel.addVisit(
+              Visit(
+                patientId = patientId,
+                date = LocalDate.parse(date),
+                gestationalWeeks = weeksInt!!,
+                weightKg = weightVal!!,
+                systolic = sysInt!!,
+                diastolic = diaInt!!,
+                hemoglobin = hbVal,
+                dangerSigns = signs.map(DangerSign::valueOf).toSet(),
+                notes = notes.trim(),
+              ),
+              onSaved = onBack,
+            )
+          }
+        },
+        modifier = Modifier.fillMaxWidth(),
+      ) {
+        Text("Save visit")
+      }
+    }
+  }
+
+  if (showDatePicker) {
+    val pickerState = rememberDatePickerState(
+      initialSelectedDateMillis = LocalDate.parse(date)
+        .atStartOfDay(ZoneOffset.UTC).toInstant().toEpochMilli()
+    )
+    DatePickerDialog(
+      onDismissRequest = { showDatePicker = false },
+      confirmButton = {
+        TextButton(onClick = {
+          pickerState.selectedDateMillis?.let { millis ->
+            date = Instant.ofEpochMilli(millis).atZone(ZoneOffset.UTC).toLocalDate().toString()
+          }
+          showDatePicker = false
+        }) { Text("OK") }
+      },
+      dismissButton = {
+        TextButton(onClick = { showDatePicker = false }) { Text("Cancel") }
+      },
+    ) {
+      DatePicker(state = pickerState)
+    }
+  }
+}
