+// Runs a blocking FHIR call off the main thread; null while it is in flight.
+@Composable
+private fun <T> loadAsync(key: Any, block: () -> T) = produceState<Result<T>?>(null, key) {
+  value = withContext(Dispatchers.IO) { runCatching(block) }
+}
+
+@Composable
+private fun <T> Loaded(state: Result<T>?, modifier: Modifier, content: @Composable (T) -> Unit) {
+  Box(modifier, contentAlignment = Alignment.Center) {
+    when {
+      state == null -> CircularProgressIndicator()
+      state.isFailure -> Text(
+        "Could not load from the FHIR server: ${state.exceptionOrNull()?.message}",
+        color = MaterialTheme.colorScheme.error,
+        modifier = Modifier.padding(16.dp),
+      )
+      else -> content(state.getOrThrow())
+    }
+  }
+}
+
+@Composable
+private fun RegisterScreen(onOpen: (Patient) -> Unit) {
+  val state by loadAsync(Unit) { loadPregnantPatients() }
+  Scaffold(topBar = { TopAppBar(title = { Text("Pregnant patients") }) }) { pad ->
+    Loaded(state, Modifier.padding(pad).fillMaxSize()) { patients ->
+      if (patients.isEmpty()) {
+        Text("No pregnant patients on file.", modifier = Modifier.padding(16.dp))
+      } else {
+        LazyColumn(
+          contentPadding = PaddingValues(16.dp),
+          verticalArrangement = Arrangement.spacedBy(8.dp),
+          modifier = Modifier.fillMaxSize(),
+        ) {
+          items(patients, key = { it.id }) { p ->
+            Card(onClick = { onOpen(p) }, modifier = Modifier.fillMaxWidth()) {
+              Column(Modifier.padding(16.dp)) {
+                Text(p.name, style = MaterialTheme.typography.titleMedium, fontWeight = FontWeight.Bold)
+                Text("Age ${p.age} · Due ${p.dueDate} · ${p.weeks} weeks")
+              }
+            }
+          }
+        }
+      }
+    }
+  }
+}
