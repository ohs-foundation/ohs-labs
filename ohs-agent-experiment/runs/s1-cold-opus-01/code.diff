+package com.example.ancapp.domain
+
+import java.time.LocalDate
+import java.time.Period
+import java.time.temporal.ChronoUnit
+
+/**
+ * Gestational-age maths.
+ *
+ * A pregnancy is dated from the last menstrual period (LMP) and a term pregnancy is
+ * conventionally 280 days (40 weeks) long, so `LMP = EDD - 280 days`. Gestational age on any
+ * given day is therefore the number of days since that notional LMP.
+ */
+object Gestation {
+
+  /** Length of a term pregnancy, in days. */
+  const val TERM_DAYS: Long = 280
+
+  /** Gestational age in whole days on [on] for a pregnancy due on [estimatedDueDate]. */
+  fun daysOn(estimatedDueDate: LocalDate, on: LocalDate): Long =
+    (TERM_DAYS - ChronoUnit.DAYS.between(on, estimatedDueDate)).coerceAtLeast(0)
+
+  /** Gestational age in completed weeks on [on]. */
+  fun weeksOn(estimatedDueDate: LocalDate, on: LocalDate): Int =
+    (daysOn(estimatedDueDate, on) / 7).toInt()
+
+  /** Gestational age rendered the way clinicians write it, e.g. `25w 4d`. */
+  fun format(estimatedDueDate: LocalDate, on: LocalDate): String {
+    val days = daysOn(estimatedDueDate, on)
+    return "${days / 7}w ${days % 7}d"
+  }
+
+  /** Fraction of the pregnancy elapsed on [on], in `0f..1f`. */
+  fun progressOn(estimatedDueDate: LocalDate, on: LocalDate): Float =
+    (daysOn(estimatedDueDate, on).toFloat() / TERM_DAYS).coerceIn(0f, 1f)
+}
+
+/** Age in completed years on [on]. */
+fun ageOn(dateOfBirth: LocalDate, on: LocalDate): Int =
+  Period.between(dateOfBirth, on).years
