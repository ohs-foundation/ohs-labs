+private sealed interface Screen {
+  data object Register : Screen
+  data class Detail(val patient: PatientRow) : Screen
+  data class NewVisit(val patient: PatientRow) : Screen
+}
 
 class MainActivity : ComponentActivity() {
   override fun onCreate(savedInstanceState: Bundle?) {
     super.onCreate(savedInstanceState)
-    setContent { MaterialTheme { Surface { Text("Hello") } } }
+    setContent { MaterialTheme { App() } }
+  }
+}
+
+@Composable
+private fun App() {
+  var screen by remember { mutableStateOf<Screen>(Screen.Register) }
+  var syncing by remember { mutableStateOf(false) }
+  var version by remember { mutableIntStateOf(0) } // bump to reload from local DB
+  val scope = rememberCoroutineScope()
+  val context = LocalContext.current
+
+  fun sync() {
+    if (syncing) return
+    syncing = true
+    scope.launch {
+      val ok = runCatching { AncSync.sync() }.getOrDefault(false)
+      if (!ok) Toast.makeText(context, "Sync failed, showing local data", Toast.LENGTH_SHORT).show()
+      syncing = false
+      version++
+    }
+  }
+  LaunchedEffect(Unit) { sync() }
+
+  when (val s = screen) {
+    Screen.Register -> RegisterScreen(version, syncing, ::sync) { screen = Screen.Detail(it) }
+    is Screen.Detail -> {
+      BackHandler { screen = Screen.Register }
+      DetailScreen(s.patient, version, onBack = { screen = Screen.Register }) { screen = Screen.NewVisit(s.patient) }
+    }
+    is Screen.NewVisit -> {
+      val back = { screen = Screen.Detail(s.patient) }
+      BackHandler(onBack = back)
+      VisitFormScreen(
+        s.patient,
+        onBack = back,
+        onSaved = {
+          version++
+          back()
+          sync()
+        },
+      )
+    }
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+private fun Page(
+  title: String,
+  onBack: (() -> Unit)? = null,
+  actions: @Composable () -> Unit = {},
+  fab: @Composable () -> Unit = {},
+  content: @Composable () -> Unit,
+) {
+  Scaffold(
+    topBar = {
+      TopAppBar(
+        title = { Text(title) },
+        navigationIcon = {
+          if (onBack != null) IconButton(onClick = onBack) { Icon(Icons.AutoMirrored.Filled.ArrowBack, "Back") }
+        },
+        actions = { actions() },
+      )
+    },
+    floatingActionButton = fab,
+  ) { padding -> Box(Modifier.padding(padding).fillMaxSize()) { content() } }
+}
+
+@Composable
+private fun RegisterScreen(version: Int, syncing: Boolean, onSync: () -> Unit, onOpen: (PatientRow) -> Unit) {
+  var patients by remember { mutableStateOf<List<PatientRow>?>(null) }
+  LaunchedEffect(version) { patients = loadRegister() }
+  Page(
+    "ANC Register",
+    actions = { IconButton(onClick = onSync, enabled = !syncing) { Icon(Icons.Default.Refresh, "Sync") } },
+  ) {
+    Column {
+      if (syncing) LinearProgressIndicator(Modifier.padding(horizontal = 0.dp))
+      val list = patients
+      when {
+        list == null -> Unit
+        list.isEmpty() -> Text("No pregnant patients on file.", Modifier.padding(16.dp))
+        else -> LazyColumn {
+          items(list, key = { it.id }) { p ->
+            ListItem(
+              headlineContent = { Text(p.name) },
+              supportingContent = { Text("Age ${p.age} · Due ${p.edd} · ${p.weeks} weeks") },
+              modifier = Modifier.clickable { onOpen(p) },
+            )
+            HorizontalDivider()
+          }
+        }
+      }
+    }
+  }
+}
+
+@Composable
+private fun DetailScreen(patient: PatientRow, version: Int, onBack: () -> Unit, onNewVisit: () -> Unit) {
+  var visits by remember { mutableStateOf<List<Visit>?>(null) }
+  LaunchedEffect(patient.id, version) { visits = loadVisits(patient.id) }
+  Page(
+    patient.name,
+    onBack = onBack,
+    fab = { ExtendedFloatingActionButton(onClick = onNewVisit, icon = { Icon(Icons.Default.Add, null) }, text = { Text("Record visit") }) },
+  ) {
+    LazyColumn {
+      item {
+        Text(
+          "Age ${patient.age} · Due ${patient.edd} · ${patient.weeks} weeks",
+          Modifier.padding(16.dp),
+          style = MaterialTheme.typography.bodyLarge,
+        )
+        Text("ANC visits", Modifier.padding(horizontal = 16.dp), style = MaterialTheme.typography.titleMedium)
+      }
+      val list = visits.orEmpty()
+      if (visits != null && list.isEmpty()) item { Text("No visits recorded.", Modifier.padding(16.dp)) }
+      items(list) { v ->
+        ListItem(
+          headlineContent = { Text(v.date) },
+          supportingContent = {
+            Text(
+              listOfNotNull(
+                v.weight?.let { "Weight $it" },
+                v.bp?.let { "BP $it" },
+                v.hb?.let { "Hb $it" },
+              ).joinToString(" · ").ifEmpty { "No measurements" }
+            )
+          },
+        )
+        HorizontalDivider()
+      }
+    }
+  }
+}
+
+@Composable
+private fun VisitFormScreen(patient: PatientRow, onBack: () -> Unit, onSaved: () -> Unit) {
+  var questionnaire by remember { mutableStateOf<String?>(null) }
+  var loaded by remember { mutableStateOf(false) }
+  val scope = rememberCoroutineScope()
+  val context = LocalContext.current
+  val formStore = remember { object : ViewModelStoreOwner { override val viewModelStore = ViewModelStore() } }
+  DisposableEffect(Unit) { onDispose { formStore.viewModelStore.clear() } }
+  LaunchedEffect(Unit) {
+    questionnaire = loadQuestionnaireJson()
+    loaded = true
+  }
+  Page("New visit · ${patient.name}", onBack = onBack) {
+    val q = questionnaire
+    when {
+      // Fresh ViewModelStore per form so answers from a previous visit don't leak in.
+      q != null -> CompositionLocalProvider(LocalViewModelStoreOwner provides formStore) { Questionnaire(
+        questionnaireJson = q,
+        onSubmit = { getResponse ->
+          scope.launch {
+            val response =
+              try {
+                getResponse()
+              } catch (_: CancellationException) {
+                return@launch // validation failed; the form shows the errors
+              }
+            saveVisit(patient.id, response)
+            Toast.makeText(context, "Visit saved", Toast.LENGTH_SHORT).show()
+            onSaved()
+          }
+        },
+        onCancel = onBack,
+      ) }
+      loaded -> Text("Visit form not available yet. Sync with the server first.", Modifier.padding(16.dp))
+    }
   }
 }
