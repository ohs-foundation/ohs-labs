@@ -0,0 +1,93 @@
+package com.example.ancapp
+
+import com.ionspin.kotlin.bignum.decimal.BigDecimal
+import dev.ohs.fhir.engine.FhirEngine
+import dev.ohs.fhir.model.r4.Annotation
+import dev.ohs.fhir.model.r4.Canonical
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.CodeableConcept
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.DateTime
+import dev.ohs.fhir.model.r4.Decimal
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Enumeration
+import dev.ohs.fhir.model.r4.FhirDateTime
+import dev.ohs.fhir.model.r4.Markdown
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Period
+import dev.ohs.fhir.model.r4.Quantity
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import dev.ohs.fhir.model.r4.Reference
+import dev.ohs.fhir.model.r4.String as FhirString
+import dev.ohs.fhir.model.r4.Uri
+import java.util.UUID
+import kotlinx.serialization.json.Json
+
+val fhirJson = Json { explicitNulls = false; encodeDefaults = false }
+
+private fun flatten(items: List<QuestionnaireResponse.Item>, out: MutableMap<String, List<QuestionnaireResponse.Item.Answer>>) {
+  items.forEach { i ->
+    i.linkId.value?.let { out[it] = i.answer }
+    flatten(i.item, out)
+    i.answer.forEach { flatten(it.item, out) }
+  }
+}
+
+private fun loinc(code: String, display: String) = CodeableConcept(
+  coding = listOf(Coding(system = Uri(value = "http://loinc.org"), code = Code(value = code), display = FhirString(value = display))),
+  text = FhirString(value = display),
+)
+
+private fun qty(v: String, unit: String, ucum: String) = Quantity(
+  value = Decimal(value = BigDecimal.parseString(v)), unit = FhirString(value = unit),
+  system = Uri(value = "http://unitsofmeasure.org"), code = Code(value = ucum),
+)
+
+suspend fun FhirEngine.saveVisit(patientId: String, response: QuestionnaireResponse) {
+  val a = mutableMapOf<String, List<QuestionnaireResponse.Item.Answer>>().also { flatten(response.item, it) }
+  val date = a["visit-date"]?.firstOrNull()?.value?.asDate()?.value?.value?.toString() ?: error("visit date required")
+  val weight = a["weight"]?.firstOrNull()?.value?.asDecimal()?.value?.value?.toPlainString()
+  val sys = a["bp-systolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+  val dia = a["bp-diastolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+  val ga = a["gestational-age"]?.firstOrNull()?.value?.asInteger()?.value?.value
+  val signs = a["danger-signs"].orEmpty().mapNotNull { it.value?.asCoding()?.value }
+  val notes = a["notes"]?.firstOrNull()?.value?.asString()?.value?.value
+
+  val encId = UUID.randomUUID().toString()
+  val subject = Reference(reference = FhirString(value = "Patient/$patientId"))
+  val encRef = Reference(reference = FhirString(value = "Encounter/$encId"))
+  val when_ = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(date)))
+  fun obs(code: CodeableConcept, value: Observation.Value? = null, components: List<Observation.Component> = emptyList()) = Observation(
+    id = UUID.randomUUID().toString(),
+    status = Enumeration(value = Observation.ObservationStatus.Final),
+    category = listOf(CodeableConcept(coding = listOf(Coding(system = Uri(value = "http://terminology.hl7.org/CodeSystem/observation-category"), code = Code(value = "vital-signs"))))),
+    code = code, subject = subject, encounter = encRef, effective = when_, value = value, component = components,
+  )
+
+  val encounter = Encounter(
+    id = encId,
+    status = Enumeration(value = Encounter.EncounterStatus.Finished),
+    `class` = Coding(system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"), code = Code(value = "AMB"), display = FhirString(value = "ambulatory")),
+    type = listOf(CodeableConcept(text = FhirString(value = "Antenatal care contact"))),
+    subject = subject,
+    period = Period(start = DateTime(value = FhirDateTime.fromString(date)), end = DateTime(value = FhirDateTime.fromString(date))),
+    reasonCode = signs.map { CodeableConcept(coding = listOf(it), text = it.display) },
+  )
+  val observations = buildList {
+    weight?.let { add(obs(loinc("29463-7", "Body weight"), Observation.Value.Quantity(qty(it, "kg", "kg")))) }
+    if (sys != null && dia != null) add(obs(loinc("85354-9", "Blood pressure panel with all children optional"), components = listOf(
+      Observation.Component(code = loinc("8480-6", "Systolic blood pressure"), value = Observation.Component.Value.Quantity(qty("$sys", "mmHg", "mm[Hg]"))),
+      Observation.Component(code = loinc("8462-4", "Diastolic blood pressure"), value = Observation.Component.Value.Quantity(qty("$dia", "mmHg", "mm[Hg]"))),
+    )))
+    ga?.let { add(obs(loinc("11884-4", "Gestational age Estimated"), Observation.Value.Quantity(qty("$it", "weeks", "wk")))) }
+    notes?.takeIf { it.isNotBlank() }?.let { add(obs(CodeableConcept(text = FhirString(value = "ANC visit notes")), Observation.Value.String(FhirString(value = it)))) }
+  }
+  val qr = response.toBuilder().apply {
+    id = UUID.randomUUID().toString()
+    status = Enumeration(value = QuestionnaireResponse.QuestionnaireResponseStatus.Completed)
+    this.subject = subject.toBuilder()
+    this.encounter = encRef.toBuilder()
+    questionnaire = Canonical(value = "http://example.org/fhir/Questionnaire/anc-contact").toBuilder()
+  }.build()
+  withTransaction { create(encounter, *observations.toTypedArray(), qr) }
+}
