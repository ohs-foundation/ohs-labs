+package com.example.ancapp.data
+
+import java.time.LocalDate
+
+/** A row on the ANC register: one currently pregnant patient. */
+data class RegisterEntry(
+  val patientId: String,
+  val name: String,
+  val age: Int?,
+  val dueDate: LocalDate,
+  val gestationalWeeks: Int?,
+)
+
+/** One recorded ANC contact, assembled from an Encounter and its Observations. */
+data class AncVisit(
+  val encounterId: String,
+  val date: LocalDate?,
+  val gestationalWeeks: Int?,
+  val weightKg: String?,
+  val systolic: String?,
+  val diastolic: String?,
+  val hemoglobin: String?,
+  val dangerSigns: List<String>,
+  val notes: String?,
+) {
+  val bloodPressure: String?
+    get() = if (systolic != null || diastolic != null) "${systolic ?: "?"}/${diastolic ?: "?"}" else null
+}
+
+data class PatientDetail(
+  val patientId: String,
+  val name: String,
+  val age: Int?,
+  val dueDate: LocalDate?,
+  val gestationalWeeks: Int?,
+  val visits: List<AncVisit>,
+)
