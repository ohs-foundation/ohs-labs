+package com.example.ancapp.ui.viewmodels
+
+import android.app.Application
+import androidx.lifecycle.AndroidViewModel
+import androidx.lifecycle.viewModelScope
+import com.example.ancapp.data.FhirRepository
+import com.example.ancapp.data.PatientItem
+import com.example.ancapp.data.VisitItem
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+
+class MainViewModel(application: Application) : AndroidViewModel(application) {
+  val repository = FhirRepository(application)
+
+  private val _patients = MutableStateFlow<List<PatientItem>>(emptyList())
+  val patients: StateFlow<List<PatientItem>> = _patients.asStateFlow()
+
+  private val _selectedPatient = MutableStateFlow<PatientItem?>(null)
+  val selectedPatient: StateFlow<PatientItem?> = _selectedPatient.asStateFlow()
+
+  private val _visits = MutableStateFlow<List<VisitItem>>(emptyList())
+  val visits: StateFlow<List<VisitItem>> = _visits.asStateFlow()
+
+  private val _questionnaireJson = MutableStateFlow<String?>(null)
+  val questionnaireJson: StateFlow<String?> = _questionnaireJson.asStateFlow()
+
+  private val _isLoading = MutableStateFlow(false)
+  val isLoading: StateFlow<Boolean> = _isLoading.asStateFlow()
+
+  fun loadPatients() {
+    viewModelScope.launch {
+      _isLoading.value = true
+      try {
+        _patients.value = repository.getPatients()
+      } catch (e: Exception) {
+        e.printStackTrace()
+      } finally {
+        _isLoading.value = false
+      }
+    }
+  }
+
+  fun loadPatientDetails(patientId: String) {
+    viewModelScope.launch {
+      _isLoading.value = true
+      try {
+        _selectedPatient.value = repository.getPatient(patientId)
+        _visits.value = repository.getVisits(patientId)
+      } catch (e: Exception) {
+        e.printStackTrace()
+      } finally {
+        _isLoading.value = false
+      }
+    }
+  }
+
+  fun loadQuestionnaire() {
+    viewModelScope.launch {
+      try {
+        _questionnaireJson.value = repository.getQuestionnaireJson()
+      } catch (e: Exception) {
+        e.printStackTrace()
+      }
+    }
+  }
+
+  fun saveVisit(
+    patientId: String,
+    response: QuestionnaireResponse,
+    onSaved: () -> Unit,
+  ) {
+    viewModelScope.launch {
+      _isLoading.value = true
+      try {
+        repository.saveVisit(patientId, response)
+        // Refresh patient details and visits
+        _visits.value = repository.getVisits(patientId)
+        _selectedPatient.value = repository.getPatient(patientId)
+        onSaved()
+      } catch (e: Exception) {
+        e.printStackTrace()
+      } finally {
+        _isLoading.value = false
+      }
+    }
+  }
+}
diff --git a/app/src/main/java/com/example/ancapp/ui/viewmodels/SyncViewModel.kt b/app/src/main/java/com/example/ancapp/ui/viewmodels/SyncViewModel.kt
new file mode 100644
