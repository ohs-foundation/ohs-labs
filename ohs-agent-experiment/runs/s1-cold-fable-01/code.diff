+package com.example.ancapp
+
+import android.app.Application
+import androidx.lifecycle.AndroidViewModel
+import androidx.lifecycle.viewModelScope
+import com.example.ancapp.data.AncDatabase
+import com.example.ancapp.data.Patient
+import com.example.ancapp.data.Visit
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.launch
+
+class AncViewModel(app: Application) : AndroidViewModel(app) {
+  private val dao = AncDatabase.get(app).dao()
+
+  val patients: Flow<List<Patient>> = dao.patientsByDueDate()
+
+  fun patient(id: Long): Flow<Patient?> = dao.patient(id)
+
+  fun visits(patientId: Long): Flow<List<Visit>> = dao.visitsForPatient(patientId)
+
+  fun addVisit(visit: Visit, onSaved: () -> Unit) {
+    viewModelScope.launch {
+      dao.insertVisit(visit)
+      onSaved()
+    }
+  }
+}
