+package com.example.ancapp.data
+
+import java.time.LocalDate
+import java.time.Period
+
+data class PatientInfo(
+  val id: String,
+  val name: String,
+  val age: Int,
+  val estimatedDueDate: LocalDate?,
+  val weeksOfPregnancy: Int?,
+)
+
+data class AncVisit(
+  val encounterId: String,
+  val date: LocalDate,
+  val gestationalAgeWeeks: Int?,
+  val weight: Double?,
+  val systolicBp: Int?,
+  val diastolicBp: Int?,
+  val dangerSigns: List<String>,
+  val notes: String?,
+)
+
+fun calculateWeeksOfPregnancy(estimatedDueDate: LocalDate?): Int? {
+  if (estimatedDueDate == null) return null
+  val today = LocalDate.now()
+  val pregnancy = Period.between(estimatedDueDate.minusWeeks(40), today)
+  return pregnancy.days / 7 + pregnancy.months * 4 + pregnancy.years * 52
+}
+
+fun formatBp(systolic: Int?, diastolic: Int?): String {
+  return when {
+    systolic != null && diastolic != null -> "$systolic/$diastolic"
+    else -> "-"
+  }
+}
