+package com.example.ancapp.model
+
+import java.time.LocalDate
+import java.time.Period
+import java.time.temporal.ChronoUnit
+import java.util.Locale
+
+enum class DangerSign(val dbKey: String, val displayName: String) {
+  VAGINAL_BLEEDING("VAGINAL_BLEEDING", "Vaginal bleeding"),
+  SEVERE_HEADACHE("SEVERE_HEADACHE", "Severe headache"),
+  BLURRED_VISION("BLURRED_VISION", "Blurred vision"),
+  FEVER("FEVER", "Fever");
+
+  companion object {
+    fun fromDbString(raw: String?): List<DangerSign> {
+      if (raw.isNullOrBlank() || raw.equals("NONE", ignoreCase = true)) {
+        return emptyList()
+      }
+      return raw
+        .split(",")
+        .mapNotNull { token ->
+          val trimmed = token.trim()
+          entries.find {
+            it.dbKey.equals(trimmed, ignoreCase = true) ||
+              it.displayName.equals(trimmed, ignoreCase = true)
+          }
+        }
+        .distinct()
+    }
+
+    fun toDbString(signs: Collection<DangerSign>): String {
+      if (signs.isEmpty()) return "NONE"
+      return signs.joinToString(",") { it.dbKey }
+    }
+  }
+}
+
+data class Patient(
+  val id: Long,
+  val name: String,
+  val dateOfBirth: String,
+  val estimatedDueDate: String,
+) {
+  fun ageInYears(referenceDate: LocalDate = LocalDate.now()): Int {
+    return try {
+      val dob = LocalDate.parse(dateOfBirth)
+      Period.between(dob, referenceDate).years.coerceAtLeast(0)
+    } catch (_: Exception) {
+      0
+    }
+  }
+
+  fun eddGestationalWeeks(referenceDate: LocalDate = LocalDate.now()): Int {
+    return try {
+      val edd = LocalDate.parse(estimatedDueDate)
+      val lmp = edd.minusDays(280)
+      val daysPregnant = ChronoUnit.DAYS.between(lmp, referenceDate)
+      Math.floorDiv(daysPregnant, 7).toInt().coerceAtLeast(0)
+    } catch (_: Exception) {
+      0
+    }
+  }
+}
+
+data class AncVisit(
+  val id: Long = 0L,
+  val patientId: Long,
+  val visitDate: String,
+  val gestationalAgeWeeks: Int,
+  val weightKg: Double,
+  val systolicBp: Int,
+  val diastolicBp: Int,
+  val hemoglobinGdL: Double? = null,
+  val dangerSigns: List<DangerSign> = emptyList(),
+  val notes: String = "",
+) {
+  val formattedWeight: String
+    get() = String.format(Locale.US, "%.1f kg", weightKg)
+
+  val formattedBp: String
+    get() = "$systolicBp/$diastolicBp"
+
+  val formattedHemoglobin: String?
+    get() = hemoglobinGdL?.let { String.format(Locale.US, "%.1f g/dL", it) }
+
+  val formattedDangerSigns: String
+    get() =
+      if (dangerSigns.isEmpty()) {
+        "None"
+      } else {
+        dangerSigns.joinToString(", ") { it.displayName }
+      }
+
+  val hasElevatedBp: Boolean
+    get() = systolicBp >= 140 || diastolicBp >= 90
+
+  val hasLowHemoglobin: Boolean
+    get() = hemoglobinGdL != null && hemoglobinGdL < 11.0
+}
+
+data class PatientWithVisits(
+  val patient: Patient,
+  val visits: List<AncVisit>,
+) {
+  val latestVisit: AncVisit?
+    get() = visits.firstOrNull()
+
+  fun currentWeeksOfPregnancy(referenceDate: LocalDate = LocalDate.now()): Int {
+    // If more than the initial visit exists, or a visit was recorded recently,
+    // compute from the latest recorded visit if possible; otherwise from EDD.
+    if (visits.size > 1) {
+      val latest = visits.first()
+      try {
+        val visitLocalDate = LocalDate.parse(latest.visitDate)
+        return if (!visitLocalDate.isAfter(referenceDate)) {
+          val elapsedWeeks =
+            Math.floorDiv(ChronoUnit.DAYS.between(visitLocalDate, referenceDate), 7).toInt()
+          (latest.gestationalAgeWeeks + elapsedWeeks).coerceAtLeast(0)
+        } else {
+          latest.gestationalAgeWeeks.coerceAtLeast(0)
+        }
+      } catch (_: Exception) {
+        return latest.gestationalAgeWeeks.coerceAtLeast(0)
+      }
+    }
+    return patient.eddGestationalWeeks(referenceDate)
+  }
+}
