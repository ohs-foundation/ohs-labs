+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun RecordVisitScreen(patient: PregnantPatient, onDone: () -> Unit) {
+  val questionnaire by produceState<Result<String>?>(null) {
+    value = runCatching { fetchQuestionnaire() }
+  }
+  val scope = rememberCoroutineScope()
+  val snackbar = remember { SnackbarHostState() }
+  BackHandler(onBack = onDone)
+  Scaffold(
+    topBar = {
+      TopAppBar(
+        title = { Text("ANC visit · ${patient.name}") },
+        navigationIcon = {
+          IconButton(onClick = onDone) { Icon(Icons.AutoMirrored.Filled.ArrowBack, "Back") }
+        },
+      )
+    },
+    snackbarHost = { SnackbarHost(snackbar) },
+  ) { pad ->
+    val result = questionnaire
+    when {
+      result == null -> CenteredBox(pad) { CircularProgressIndicator() }
+      result.isFailure -> CenteredBox(pad) {
+        Text("Could not load the visit form: ${result.exceptionOrNull()?.message}")
+      }
+      else -> Box(Modifier.padding(pad).fillMaxSize()) {
+        Questionnaire(
+          questionnaireJson = result.getOrThrow(),
+          config = QuestionnaireConfig().copy(submitButtonText = "Save visit"),
+          onSubmit = { getResponse ->
+            scope.launch {
+              runCatching { saveVisit(patient.id, getResponse()) }
+                .onSuccess { onDone() }
+                .onFailure { snackbar.showSnackbar("Save failed: ${it.message}") }
+            }
+          },
+          onCancel = onDone,
+        )
+      }
+    }
+  }
+}
+
+@Composable
+private fun CenteredBox(pad: PaddingValues, content: @Composable () -> Unit) {
+  Box(Modifier.padding(pad).fillMaxSize(), contentAlignment = Alignment.Center) { content() }
+}
