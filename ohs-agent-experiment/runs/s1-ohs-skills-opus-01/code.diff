+package com.example.ancapp.ui
+
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.PaddingValues
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.lazy.LazyColumn
+import androidx.compose.foundation.lazy.items
+import androidx.compose.material3.Card
+import androidx.compose.material3.ExperimentalMaterial3Api
+import androidx.compose.material3.ExtendedFloatingActionButton
+import androidx.compose.material3.HorizontalDivider
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.Scaffold
+import androidx.compose.material3.Text
+import androidx.compose.material3.TextButton
+import androidx.compose.material3.TopAppBar
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+import com.example.ancapp.data.AncVisit
+import com.example.ancapp.data.PatientDetail
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun PatientDetailScreen(state: DetailUiState, onBack: () -> Unit, onRecordVisit: () -> Unit) {
+  val patient = (state as? DetailUiState.Ready)?.patient
+  Scaffold(
+    topBar = {
+      TopAppBar(
+        title = { Text(patient?.name ?: "Patient") },
+        navigationIcon = { TextButton(onClick = onBack) { Text("Back") } },
+      )
+    },
+    floatingActionButton = {
+      if (patient != null) {
+        ExtendedFloatingActionButton(
+          onClick = onRecordVisit,
+          text = { Text("Record ANC visit") },
+          icon = {},
+        )
+      }
+    },
+  ) { padding ->
+    Column(Modifier.padding(padding).fillMaxSize()) {
+      when (state) {
+        is DetailUiState.Loading -> Loading("Loading patient…")
+        is DetailUiState.Error -> ErrorMessage(state.message)
+        is DetailUiState.Ready -> PatientBody(state.patient)
+      }
+    }
+  }
+}
+
+@Composable
+private fun PatientBody(patient: PatientDetail) {
+  LazyColumn(
+    contentPadding = PaddingValues(16.dp),
+    verticalArrangement = Arrangement.spacedBy(12.dp),
+  ) {
+    item { PatientSummaryCard(patient) }
+    item {
+      Text(
+        "ANC visits (${patient.visits.size})",
+        style = MaterialTheme.typography.titleMedium,
+        modifier = Modifier.padding(top = 8.dp),
+      )
+    }
+    if (patient.visits.isEmpty()) {
+      item {
+        Text("No visits recorded yet.", style = MaterialTheme.typography.bodyMedium)
+      }
+    } else {
+      items(patient.visits, key = { it.encounterId }) { VisitCard(it) }
+    }
+    // Room to scroll clear of the floating action button.
+    item { Text("", Modifier.padding(bottom = 56.dp)) }
+  }
+}
+
+@Composable
+private fun PatientSummaryCard(patient: PatientDetail) {
+  Card(Modifier.fillMaxWidth()) {
+    Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(4.dp)) {
+      Text(patient.name, style = MaterialTheme.typography.titleLarge)
+      LabelledValue("Age", patient.age?.let { "$it years" })
+      LabelledValue("Estimated due date", patient.dueDate?.display())
+      LabelledValue("Gestational age", patient.gestationalWeeks?.let { "$it weeks" })
+    }
+  }
+}
+
+@Composable
+private fun VisitCard(visit: AncVisit) {
+  Card(Modifier.fillMaxWidth()) {
+    Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(4.dp)) {
+      Text(
+        visit.date?.display() ?: "Date not recorded",
+        style = MaterialTheme.typography.titleMedium,
+      )
+      HorizontalDivider(Modifier.padding(vertical = 4.dp))
+      LabelledValue("Gestational age", visit.gestationalWeeks?.let { "$it weeks" })
+      LabelledValue("Weight", visit.weightKg?.let { "$it kg" })
+      LabelledValue("Blood pressure", visit.bloodPressure?.let { "$it mmHg" })
+      LabelledValue("Hemoglobin", visit.hemoglobin?.let { "$it g/dL" })
+      if (visit.dangerSigns.isNotEmpty()) {
+        LabelledValue("Danger signs", visit.dangerSigns.joinToString(", "))
+      }
+      visit.notes?.let { LabelledValue("Notes", it) }
+    }
+  }
+}
+
+/** Renders one field; omitted entirely when the value was never recorded. */
+@Composable
+private fun LabelledValue(label: String, value: String?) {
+  if (value.isNullOrBlank()) return
+  Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+    Text(
+      "$label:",
+      style = MaterialTheme.typography.bodyMedium,
+      color = MaterialTheme.colorScheme.onSurfaceVariant,
+    )
+    Text(value, style = MaterialTheme.typography.bodyMedium)
+  }
+}
