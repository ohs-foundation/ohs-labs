+import androidx.compose.foundation.clickable
+import androidx.compose.foundation.layout.*
+import androidx.compose.foundation.lazy.LazyColumn
+import androidx.compose.foundation.lazy.items
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.text.KeyboardOptions
+import androidx.compose.foundation.verticalScroll
+import androidx.compose.material3.*
+import androidx.compose.runtime.*
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.text.input.KeyboardType
+import androidx.compose.ui.unit.dp
+import java.time.LocalDate
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import org.json.JSONArray
+import org.json.JSONObject
 
 class MainActivity : ComponentActivity() {
   override fun onCreate(savedInstanceState: Bundle?) {
     super.onCreate(savedInstanceState)
-    setContent { MaterialTheme { Surface { Text("Hello") } } }
+    setContent { MaterialTheme { Surface(Modifier.fillMaxSize()) { App() } } }
+  }
+}
+
+/** Runs [block] on IO; result is Result so UI can show errors instead of crashing. */
+private suspend fun <T> io(block: () -> T) = withContext(Dispatchers.IO) { runCatching(block) }
+
+@Composable
+fun App() {
+  var patient by remember { mutableStateOf<Patient?>(null) }
+  var form by remember { mutableStateOf(false) }
+  var refresh by remember { mutableIntStateOf(0) }
+  BackHandler(patient != null) { if (form) form = false else patient = null }
+  val p = patient
+  when {
+    p == null -> Register { patient = it }
+    form -> VisitForm(p, onDone = { saved -> form = false; if (saved) refresh++ })
+    else -> Detail(p, refresh, onBack = { patient = null }, onAdd = { form = true })
+  }
+}
+
+@Composable
+fun Loading(what: String, result: Result<*>?, content: @Composable () -> Unit) {
+  Box(Modifier.fillMaxSize().padding(16.dp)) {
+    when {
+      result == null -> CircularProgressIndicator(Modifier.align(androidx.compose.ui.Alignment.Center))
+      result.isFailure -> Text("Could not load $what: ${result.exceptionOrNull()?.message}", color = MaterialTheme.colorScheme.error)
+      else -> content()
+    }
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun Register(onOpen: (Patient) -> Unit) {
+  var res by remember { mutableStateOf<Result<List<Patient>>?>(null) }
+  LaunchedEffect(Unit) { res = io { loadPatients() } }
+  Scaffold(topBar = { TopAppBar(title = { Text("ANC Register") }) }) { pad ->
+    Box(Modifier.padding(pad)) {
+      Loading("patients", res) {
+        LazyColumn(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+          items(res!!.getOrThrow()) { p ->
+            Card(Modifier.fillMaxWidth().clickable { onOpen(p) }) {
+              Column(Modifier.padding(16.dp)) {
+                Text(p.name, style = MaterialTheme.typography.titleMedium)
+                Text("Age ${p.age} · Due ${p.edd ?: "unknown"} · ${p.weeks?.let { "$it weeks" } ?: "weeks unknown"}")
+              }
+            }
+          }
+        }
+      }
+    }
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun Detail(p: Patient, refresh: Int, onBack: () -> Unit, onAdd: () -> Unit) {
+  var res by remember { mutableStateOf<Result<List<Visit>>?>(null) }
+  LaunchedEffect(refresh) { res = io { loadVisits(p.id) } }
+  Scaffold(
+    topBar = { TopAppBar(title = { Text(p.name) }, navigationIcon = { TextButton(onBack) { Text("Back") } }) },
+    floatingActionButton = { ExtendedFloatingActionButton(onClick = onAdd) { Text("Record visit") } },
+  ) { pad ->
+    Column(Modifier.padding(pad).padding(horizontal = 16.dp)) {
+      Text("Age ${p.age} · Due ${p.edd ?: "unknown"} · ${p.weeks?.let { "$it weeks" } ?: ""}")
+      Spacer(Modifier.height(8.dp))
+      Text("Past ANC visits", style = MaterialTheme.typography.titleMedium)
+      Loading("visits", res) {
+        val visits = res!!.getOrThrow()
+        if (visits.isEmpty()) Text("No visits recorded yet.")
+        LazyColumn(verticalArrangement = Arrangement.spacedBy(8.dp), contentPadding = PaddingValues(top = 8.dp, bottom = 80.dp)) {
+          items(visits) { v ->
+            Card(Modifier.fillMaxWidth()) {
+              Column(Modifier.padding(16.dp)) {
+                Text(v.date, style = MaterialTheme.typography.titleSmall)
+                Text("Weight: ${v.weight ?: "—"}")
+                Text("BP: ${v.bp?.let { "$it mmHg" } ?: "—"}")
+                v.hb?.let { Text("Hb: $it") }
+              }
+            }
+          }
+        }
+      }
+    }
+  }
+}
+
+private fun JSONArray.objs() = (0 until length()).map { getJSONObject(it) }
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun VisitForm(p: Patient, onDone: (saved: Boolean) -> Unit) {
+  var q by remember { mutableStateOf<Result<JSONObject>?>(null) }
+  LaunchedEffect(Unit) { q = io { loadQuestionnaire() } }
+  // scalar answers by linkId; choice answers as comma-joined codes
+  val answers = remember { mutableStateMapOf("visit-date" to LocalDate.now().toString()) }
+  var error by remember { mutableStateOf<String?>(null) }
+  var saving by remember { mutableStateOf(false) }
+  val scope = rememberCoroutineScope()
+
+  fun validate(items: JSONArray): String? {
+    for (it in items.objs()) {
+      if (it.getString("type") == "group") validate(it.getJSONArray("item"))?.let { e -> return e }
+      val id = it.getString("linkId")
+      val v = answers[id].orEmpty().trim()
+      if (it.optBoolean("required") && v.isEmpty()) return "${it.getString("text")} is required"
+      if (v.isEmpty()) continue
+      val ok = when (it.getString("type")) {
+        "date" -> runCatching { LocalDate.parse(v) }.isSuccess
+        "integer" -> v.toIntOrNull() != null
+        "decimal" -> v.toDoubleOrNull() != null
+        else -> true
+      }
+      if (!ok) return "${it.getString("text")} is invalid"
+    }
+    return null
+  }
+
+  Scaffold(topBar = { TopAppBar(title = { Text("New visit · ${p.name}") }) }) { pad ->
+    Box(Modifier.padding(pad)) {
+      Loading("form", q) {
+        val qj = q!!.getOrThrow()
+        Column(Modifier.verticalScroll(rememberScrollState()), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+          Items(qj.getJSONArray("item"), answers)
+          error?.let { Text(it, color = MaterialTheme.colorScheme.error) }
+          Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+            Button(enabled = !saving, onClick = {
+              error = validate(qj.getJSONArray("item"))
+              if (error == null) {
+                saving = true
+                scope.launch {
+                  io { saveVisit(qj, p.id, answers.mapValues { it.value.trim() }) }
+                    .onSuccess { onDone(true) }
+                    .onFailure { error = "Save failed: ${it.message}"; saving = false }
+                }
+              }
+            }) { Text(if (saving) "Saving…" else "Save visit") }
+            OutlinedButton(onClick = { onDone(false) }) { Text("Cancel") }
+          }
+        }
+      }
+    }
+  }
+}
+
+/** Renders Questionnaire items; supports the types the ANC form uses. */
+@Composable
+fun Items(items: JSONArray, answers: MutableMap<String, String>) {
+  for (it in items.objs()) {
+    val id = it.getString("linkId")
+    val label = it.getString("text") + if (it.optBoolean("required")) " *" else ""
+    when (it.getString("type")) {
+      "group" -> {
+        Text(it.getString("text"), style = MaterialTheme.typography.titleMedium)
+        Items(it.getJSONArray("item"), answers)
+      }
+      "choice" -> {
+        Text(label, style = MaterialTheme.typography.titleSmall)
+        val selected = answers[id].orEmpty().split(',').filter { s -> s.isNotEmpty() }.toSet()
+        for (o in it.getJSONArray("answerOption").objs()) {
+          val c = o.getJSONObject("valueCoding")
+          val code = c.getString("code")
+          Row(Modifier.clickable { }, verticalAlignment = androidx.compose.ui.Alignment.CenterVertically) {
+            Checkbox(code in selected, onCheckedChange = { on ->
+              // "none" excludes every other sign and vice versa
+              val next = when {
+                !on -> selected - code
+                code == "none" -> setOf(code)
+                else -> selected - "none" + code
+              }
+              answers[id] = next.joinToString(",")
+            })
+            Text(c.getString("display"))
+          }
+        }
+      }
+      else -> {
+        val type = it.getString("type")
+        OutlinedTextField(
+          value = answers[id].orEmpty(), onValueChange = { v -> answers[id] = v },
+          label = { Text(label + if (type == "date") " (yyyy-mm-dd)" else "") },
+          modifier = Modifier.fillMaxWidth(), singleLine = type != "text", minLines = if (type == "text") 3 else 1,
+          keyboardOptions = KeyboardOptions(keyboardType = when (type) {
+            "integer" -> KeyboardType.Number
+            "decimal" -> KeyboardType.Decimal
+            else -> KeyboardType.Text
+          }),
+        )
+      }
+    }
   }
 }
