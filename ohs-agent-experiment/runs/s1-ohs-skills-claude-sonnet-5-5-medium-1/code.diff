index 0000000..88d19b2
--- /dev/null
+++ b/app/src/main/java/com/example/ancapp/Data.kt
@@ -0,0 +1,205 @@
+package com.example.ancapp
+
+import android.content.Context
+import androidx.work.ExistingWorkPolicy
+import com.ionspin.kotlin.bignum.decimal.BigDecimal
+import dev.ohs.fhir.engine.FhirEngine
+import dev.ohs.fhir.engine.FhirEngineProvider
+import dev.ohs.fhir.engine.get
+import dev.ohs.fhir.engine.search.Order
+import dev.ohs.fhir.engine.search.ReferenceClientParam
+import dev.ohs.fhir.engine.search.Search
+import dev.ohs.fhir.engine.sync.CurrentSyncJobStatus
+import dev.ohs.fhir.engine.sync.Sync
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.CodeableConcept
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.Decimal
+import dev.ohs.fhir.model.r4.DateTime
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Enumeration
+import dev.ohs.fhir.model.r4.FhirDateTime
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Patient
+import dev.ohs.fhir.model.r4.Period
+import dev.ohs.fhir.model.r4.Quantity
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import dev.ohs.fhir.model.r4.Reference
+import dev.ohs.fhir.model.r4.Uri
+import dev.ohs.fhir.model.r4.String as FhirString
+import dev.ohs.fhir.model.r4.terminologies.ResourceType
+import java.time.LocalDate
+import java.time.Period as JPeriod
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+import kotlinx.coroutines.flow.first
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+
+const val LOINC = "http://loinc.org"
+const val UCUM = "http://unitsofmeasure.org"
+const val DANGER = "urn:example:anc-danger-signs"
+
+data class PatientRow(val id: String, val name: String, val age: Int, val edd: LocalDate, val weeks: Int)
+
+data class Visit(
+  val date: String,
+  val weight: String?,
+  val bp: String?,
+  val hb: String?,
+)
+
+fun engine(c: Context): FhirEngine = FhirEngineProvider.getInstance(c.applicationContext)
+
+/** Pull from / push to the server. Failure is fine: the local store keeps working offline. */
+suspend fun sync(c: Context, policy: ExistingWorkPolicy = ExistingWorkPolicy.KEEP) {
+  Sync.oneTimeSync<AncSyncWorker>(c.applicationContext, existingWorkPolicy = policy).first {
+    it is CurrentSyncJobStatus.Succeeded ||
+      it is CurrentSyncJobStatus.Failed ||
+      it is CurrentSyncJobStatus.Cancelled
+  }
+}
+
+private fun Observation.loinc() = code.coding.firstOrNull()?.code?.value
+
+private fun Observation.qty() =
+  value?.asQuantity()?.value?.value?.value?.toPlainString()
+
+suspend fun loadPatients(c: Context): List<PatientRow> {
+  val e = engine(c)
+  val edds =
+    e.search<Observation>(Search(ResourceType.Observation)).map { it.resource }
+      .filter { it.loinc() == "11778-8" }
+      .associate {
+        it.subject?.reference?.value?.substringAfter("/") to
+          LocalDate.parse(it.value?.asDateTime()?.value?.value.toString().substringBefore("T"))
+      }
+  val today = LocalDate.now()
+  return e.search<Patient>(Search(ResourceType.Patient)).map { it.resource }
+    .mapNotNull { p ->
+      val edd = edds[p.id] ?: return@mapNotNull null
+      val n = p.name.firstOrNull()
+      PatientRow(
+        id = p.id!!,
+        name = (n?.given.orEmpty().mapNotNull { it.value } + listOfNotNull(n?.family?.value)).joinToString(" "),
+        age = p.birthDate?.value?.let { JPeriod.between(LocalDate.parse(it.toString()), today).years } ?: 0,
+        edd = edd,
+        weeks = (40 - ChronoUnit.DAYS.between(today, edd) / 7).toInt(),
+      )
+    }
+    .sortedBy { it.edd }
+}
+
+suspend fun loadVisits(c: Context, patientId: String): List<Visit> {
+  val e = engine(c)
+  val ref = "Patient/$patientId"
+  val encounters =
+    e.search<Encounter>(Search(ResourceType.Encounter).apply {
+      filter(ReferenceClientParam("subject"), { value = ref })
+    }).map { it.resource }
+  val obs =
+    e.search<Observation>(Search(ResourceType.Observation).apply {
+      filter(ReferenceClientParam("subject"), { value = ref })
+    }).map { it.resource }
+  return encounters.map { enc ->
+    val mine = obs.filter { it.encounter?.reference?.value == "Encounter/${enc.id}" }
+    val bp = mine.firstOrNull { it.loinc() == "85354-9" }?.component?.let { comps ->
+      fun part(code: String) =
+        comps.firstOrNull { it.code.coding.firstOrNull()?.code?.value == code }
+          ?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+      part("8480-6")?.let { s -> "$s/${part("8462-4")}" }
+    }
+    Visit(
+      date = enc.period?.start?.value.toString().substringBefore("T"),
+      weight = mine.firstOrNull { it.loinc() == "29463-7" }?.qty(),
+      bp = bp,
+      hb = mine.firstOrNull { it.loinc() == "718-7" }?.qty(),
+    )
+  }.sortedByDescending { it.date }
+}
+
+/** Map the Questionnaire answers to an Encounter plus one Observation per measurement. */
+suspend fun saveVisit(c: Context, patientId: String, response: QuestionnaireResponse) {
+  val answers = mutableMapOf<String, MutableList<QuestionnaireResponse.Item.Answer>>()
+  fun collect(items: List<QuestionnaireResponse.Item>) {
+   items.forEach { item ->
+    item.linkId.value?.let { answers.getOrPut(it) { mutableListOf() }.addAll(item.answer) }
+    collect(item.item)
+    item.answer.forEach { collect(it.item) }
+   }
+  }
+  collect(response.item)
+  fun first(id: String) = answers[id]?.firstOrNull()?.value
+
+  val date = first("visit-date")?.asDate()?.value?.value.toString()
+  val subject = Reference(reference = FhirString(value = "Patient/$patientId"))
+  val encId = UUID.randomUUID().toString()
+  val encounter =
+    Encounter(
+      id = encId,
+      status = Enumeration(value = Encounter.EncounterStatus.Finished),
+      `class` = Coding(code = Code(value = "AMB")),
+      type = listOf(CodeableConcept(text = FhirString(value = "Antenatal care contact"))),
+      subject = subject,
+      period = Period(start = DateTime(value = FhirDateTime.fromString(date))),
+    )
+
+  fun loincCode(code: String, text: String) =
+    CodeableConcept(
+      coding = listOf(Coding(system = Uri(value = LOINC), code = Code(value = code))),
+      text = FhirString(value = text),
+    )
+  fun qty(v: BigDecimal, unit: String, ucum: String) =
+    Quantity(
+      value = Decimal(value = v),
+      unit = FhirString(value = unit),
+      system = Uri(value = UCUM),
+      code = Code(value = ucum),
+    )
+  fun obs(code: CodeableConcept, value: Observation.Value? = null, comps: List<Observation.Component> = emptyList()) =
+    Observation(
+      id = UUID.randomUUID().toString(),
+      status = Enumeration(value = Observation.ObservationStatus.Final),
+      code = code,
+      subject = subject,
+      encounter = Reference(reference = FhirString(value = "Encounter/$encId")),
+      effective = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(date))),
+      value = value,
+      component = comps,
+    )
+
+  val out = mutableListOf<Observation>()
+  first("gestational-age")?.asInteger()?.value?.value?.let {
+    out += obs(loincCode("11884-4", "Gestational age"), Observation.Value.Quantity(qty(BigDecimal.fromInt(it), "weeks", "wk")))
+  }
+  first("weight")?.asDecimal()?.value?.value?.let {
+    out += obs(loincCode("29463-7", "Body weight"), Observation.Value.Quantity(qty(it, "kg", "kg")))
+  }
+  val sys = first("bp-systolic")?.asInteger()?.value?.value
+  val dia = first("bp-diastolic")?.asInteger()?.value?.value
+  if (sys != null && dia != null) {
+    fun comp(code: String, name: String, v: Int) =
+      Observation.Component(
+        code = loincCode(code, name),
+        value = Observation.Component.Value.Quantity(qty(BigDecimal.fromInt(v), "mmHg", "mm[Hg]")),
+      )
+    out += obs(loincCode("85354-9", "Blood pressure"), comps = listOf(comp("8480-6", "Systolic blood pressure", sys), comp("8462-4", "Diastolic blood pressure", dia)))
+  }
+  val signs = answers["danger-signs"].orEmpty().mapNotNull { it.value?.asCoding()?.value }.filter { it.code?.value != "none" }
+  signs.forEach {
+    out += obs(
+      CodeableConcept(coding = listOf(Coding(system = Uri(value = DANGER), code = it.code, display = it.display)), text = FhirString(value = "Danger sign")),
+      Observation.Value.CodeableConcept(CodeableConcept(coding = listOf(it))),
+    )
+  }
+  first("notes")?.asString()?.value?.value?.takeIf { it.isNotBlank() }?.let {
+    out += obs(loincCode("48767-8", "Annotation comment"), Observation.Value.String(FhirString(value = it)))
+  }
+
+  engine(c).create(encounter, *out.toTypedArray())
+  // fire-and-forget: queue the upload behind any in-flight sync
+  Sync.oneTimeSync<AncSyncWorker>(c.applicationContext, existingWorkPolicy = ExistingWorkPolicy.APPEND_OR_REPLACE)
+}
+
+suspend fun questionnaireJson(c: Context): String =
+  Json { explicitNulls = false }.encodeToString(engine(c).get<dev.ohs.fhir.model.r4.Questionnaire>("anc-contact"))
