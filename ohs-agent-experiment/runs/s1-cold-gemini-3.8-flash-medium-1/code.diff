+package com.example.ancapp.data
+
+import android.content.Context
+import com.example.ancapp.model.AncVisit
+import com.example.ancapp.model.DangerSigns
+import com.example.ancapp.model.Patient
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+import java.time.LocalDate
+
+class AncRepository(private val context: Context) {
+
+    private val dataFile: File by lazy {
+        File(context.filesDir, "anc_data.json")
+    }
+
+    private val _patients = MutableStateFlow<List<Patient>>(emptyList())
+    val patients: StateFlow<List<Patient>> = _patients.asStateFlow()
+
+    private val _visits = MutableStateFlow<List<AncVisit>>(emptyList())
+    val visits: StateFlow<List<AncVisit>> = _visits.asStateFlow()
+
+    init {
+        loadData()
+    }
+
+    @Synchronized
+    private fun loadData() {
+        if (!dataFile.exists()) {
+            val initialPatients = createSeedPatients()
+            val initialVisits = createSeedVisits()
+            _patients.value = initialPatients
+            _visits.value = initialVisits
+            persistToDisk(initialPatients, initialVisits)
+        } else {
+            try {
+                val jsonString = dataFile.readText()
+                val root = JSONObject(jsonString)
+
+                val loadedPatients = mutableListOf<Patient>()
+                val patientsArray = root.optJSONArray("patients") ?: JSONArray()
+                for (i in 0 until patientsArray.length()) {
+                    loadedPatients.add(Patient.fromJson(patientsArray.getJSONObject(i)))
+                }
+
+                val loadedVisits = mutableListOf<AncVisit>()
+                val visitsArray = root.optJSONArray("visits") ?: JSONArray()
+                for (i in 0 until visitsArray.length()) {
+                    loadedVisits.add(AncVisit.fromJson(visitsArray.getJSONObject(i)))
+                }
+
+                _patients.value = loadedPatients
+                _visits.value = loadedVisits
+            } catch (e: Exception) {
+                e.printStackTrace()
+                // Fallback to seed data if corrupted
+                val fallbackPatients = createSeedPatients()
+                val fallbackVisits = createSeedVisits()
+                _patients.value = fallbackPatients
+                _visits.value = fallbackVisits
+                persistToDisk(fallbackPatients, fallbackVisits)
+            }
+        }
+    }
+
+    @Synchronized
+    private fun persistToDisk(patientsList: List<Patient>, visitsList: List<AncVisit>) {
+        try {
+            val root = JSONObject()
+            val patientsArray = JSONArray()
+            patientsList.forEach { patientsArray.put(it.toJson()) }
+            root.put("patients", patientsArray)
+
+            val visitsArray = JSONArray()
+            visitsList.forEach { visitsArray.put(it.toJson()) }
+            root.put("visits", visitsArray)
+
+            val tempFile = File(context.filesDir, "anc_data.json.tmp")
+            tempFile.writeText(root.toString(2))
+            tempFile.renameTo(dataFile)
+        } catch (e: Exception) {
+            e.printStackTrace()
+        }
+    }
+
+    fun getPatientsSortedByDueDate(): List<Patient> {
+        return _patients.value.sortedWith(Comparator { p1, p2 ->
+            try {
+                val d1 = LocalDate.parse(p1.estimatedDueDate)
+                val d2 = LocalDate.parse(p2.estimatedDueDate)
+                d1.compareTo(d2)
+            } catch (_: Exception) {
+                p1.estimatedDueDate.compareTo(p2.estimatedDueDate)
+            }
+        })
+    }
+
+    fun getPatientById(patientId: String): Patient? {
+        return _patients.value.find { it.id == patientId }
+    }
+
+    fun getVisitsForPatient(patientId: String): List<AncVisit> {
+        return _visits.value
+            .filter { it.patientId == patientId }
+            .sortedWith(Comparator { v1, v2 ->
+                try {
+                    val d1 = LocalDate.parse(v1.date)
+                    val d2 = LocalDate.parse(v2.date)
+                    // Newest visits first
+                    d2.compareTo(d1)
+                } catch (_: Exception) {
+                    v2.date.compareTo(v1.date)
+                }
+            })
+    }
+
+    @Synchronized
+    fun addVisit(visit: AncVisit) {
+        val updatedVisits = _visits.value + visit
+        _visits.value = updatedVisits
+        persistToDisk(_patients.value, updatedVisits)
+    }
+
+    @Synchronized
+    fun addPatient(patient: Patient) {
+        val updatedPatients = _patients.value + patient
+        _patients.value = updatedPatients
+        persistToDisk(updatedPatients, _visits.value)
+    }
+
+    companion object {
+        fun createSeedPatients(): List<Patient> {
+            return listOf(
+                Patient(
+                    id = "patient-emily-carter",
+                    name = "Emily Carter",
+                    dateOfBirth = "1996-04-12",
+                    estimatedDueDate = "2026-12-05"
+                ),
+                Patient(
+                    id = "patient-sarah-mitchell",
+                    name = "Sarah Mitchell",
+                    dateOfBirth = "1990-11-02",
+                    estimatedDueDate = "2027-01-20"
+                ),
+                Patient(
+                    id = "patient-grace-thompson",
+                    name = "Grace Thompson",
+                    dateOfBirth = "2001-07-30",
+                    estimatedDueDate = "2026-10-15"
+                )
+            )
+        }
+
+        fun createSeedVisits(): List<AncVisit> {
+            return listOf(
+                AncVisit(
+                    id = "visit-emily-1",
+                    patientId = "patient-emily-carter",
+                    date = "2026-08-10",
+                    gestationalAgeWeeks = 23,
+                    weightKg = 68.5,
+                    systolicBp = 118,
+                    diastolicBp = 76,
+                    hemoglobin = 11.8,
+                    dangerSigns = listOf(DangerSigns.NONE),
+                    notes = "Routine antenatal checkup. Fetal heartbeat detected, normal progression."
+                ),
+                AncVisit(
+                    id = "visit-sarah-1",
+                    patientId = "patient-sarah-mitchell",
+                    date = "2026-08-12",
+                    gestationalAgeWeeks = 17,
+                    weightKg = 61.2,
+                    systolicBp = 110,
+                    diastolicBp = 70,
+                    hemoglobin = 12.4,
+                    dangerSigns = listOf(DangerSigns.NONE),
+                    notes = "Initial second trimester assessment. Prenatal vitamins continued."
+                ),
+                AncVisit(
+                    id = "visit-grace-1",
+                    patientId = "patient-grace-thompson",
+                    date = "2026-08-05",
+                    gestationalAgeWeeks = 29,
+                    weightKg = 72.0,
+                    systolicBp = 128,
+                    diastolicBp = 84,
+                    hemoglobin = 10.2,
+                    dangerSigns = listOf(DangerSigns.NONE),
+                    notes = "Mild anemia observed. Prescribed oral iron and folic acid supplements."
+                )
+            )
+        }
+    }
+}
