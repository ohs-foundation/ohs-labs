+
+const val LOINC = "http://loinc.org"
+const val EDD_CODE = "11778-8"
+const val WEIGHT_CODE = "29463-7"
+const val BP_CODE = "85354-9"
+const val SYSTOLIC_CODE = "8480-6"
+const val DIASTOLIC_CODE = "8462-4"
+const val HB_CODE = "718-7"
+
+fun fhirEngine(ctx: Context): FhirEngine {
+  val app = ctx.applicationContext
+  if (FhirEngineProvider.isNotInitialized()) {
+    FhirEngineProvider.init(
+      FhirEngineConfiguration(serverConfiguration = ServerConfiguration(BASE_URL)),
+      app,
+    )
+  }
+  return FhirEngineProvider.getInstance(app)
+}
+
+const val BASE_URL = "http://10.0.2.2:8080/fhir/"
+private val http by lazy { HttpClient() }
+private val json get() = Sync.json
+
+private suspend fun fetchAll(path: String): List<Resource> {
+  val text = http.get(BASE_URL + path) { header("Accept", "application/fhir+json") }.bodyAsText()
+  return (json.decodeFromString(Resource.serializer(), text) as? Bundle)?.entry?.mapNotNull { it.resource } ?: emptyList()
+}
+
+/** PUTs every locally created resource the server doesn't have yet. Pending changes are cleared by the next download (remote wins). */
+private suspend fun pushPending(engine: FhirEngine) {
+  for (type in listOf(ResourceType.Encounter, ResourceType.Observation, ResourceType.QuestionnaireResponse)) {
+    for (r in engine.search<Resource>(Search(type)).map { it.resource }) {
+      val id = r.id ?: continue
+      if (engine.getLocalChanges(type, id).isEmpty()) continue
+      val resp = http.put("$BASE_URL${type.name}/$id") {
+        contentType(ContentType.parse("application/fhir+json"))
+        setBody(json.encodeToString(Resource.serializer(), r))
+      }
+      Log.d("ANC", "PUT ${type.name}/$id -> ${resp.status}")
+    }
+  }
+}
+
+/**
+ * Pushes local changes, then pulls everything the clinic has.
+ * ponytail: the SDK's bundle uploader is rejected by HAPI (relative fullUrls) and its individual-request mode
+ * is unimplemented, so we talk HTTP directly. No paging: _count=500 is plenty for a small clinic.
+ */
+suspend fun syncOnce(engine: FhirEngine) {
+  runCatching { pushPending(engine) }.onFailure { Log.w("ANC", "push failed", it) }
+  engine.syncDownload(AcceptRemoteConflictResolver) {
+    flow {
+      for (t in listOf("Patient", "Encounter", "Observation", "QuestionnaireResponse", "Questionnaire")) emit(fetchAll("$t?_count=500"))
+    }
+  }
+}
+
+// ---- Read models ----
+
+data class RegisterRow(val id: String, val name: String, val age: Int?, val edd: LocalDate?) {
+  val weeks: Int? get() = edd?.let { 40 - (it.toEpochDay() - LocalDate.now().toEpochDay()).toInt() / 7 }
+}
+
+data class Visit(val date: LocalDate?, val weightKg: String?, val bp: String?, val hb: String?)
+
+val Patient.displayName: String
+  get() = name.firstOrNull()?.let { n -> (n.given.mapNotNull { it.value } + listOfNotNull(n.family?.value)).joinToString(" ") } ?: id ?: "?"
+
+private fun FhirDate?.toLocalDate(): LocalDate? = (this as? FhirDate.Date)?.date?.toJavaLocalDate()
+private fun FhirDateTime?.toLocalDate(): LocalDate? = when (this) {
+  is FhirDateTime.Date -> date.toJavaLocalDate()
+  is FhirDateTime.DateTime -> dateTime.date.toJavaLocalDate()
+  else -> null
+}
+private fun Observation.effectiveDate() = effective?.asDateTime()?.value?.value.toLocalDate()
+private fun Observation.hasCode(code: String) = this.code?.coding?.any { it.code?.value == code } == true
+private fun Quantity?.text(): String? = this?.value?.value?.toPlainString()
+
+suspend fun loadRegister(engine: FhirEngine): List<RegisterRow> {
+  val edds = engine.search("Observation?code=$EDD_CODE").map { it.resource as Observation }
+    .associate { it.subject?.reference?.value to it.value?.asDateTime()?.value?.value.toLocalDate() }
+  val today = LocalDate.now()
+  return engine.search<Patient> {}.map { it.resource }.map { p ->
+    val birth = p.birthDate?.value.toLocalDate()
+    RegisterRow(
+      id = p.id!!,
+      name = p.displayName,
+      age = birth?.let { java.time.Period.between(it, today).years },
+      edd = edds["Patient/${p.id}"],
+    )
+  }.sortedWith(compareBy(nullsLast()) { it.edd })
+}
+
+suspend fun loadVisits(engine: FhirEngine, patientId: String): List<Visit> {
+  val obs = engine.search("Observation?subject=Patient/$patientId").map { it.resource as Observation }
+    .filter { !it.hasCode(EDD_CODE) }
+  return obs.groupBy { it.encounter?.reference?.value ?: it.effectiveDate().toString() }.values.map { group ->
+    val bp = group.firstOrNull { it.hasCode(BP_CODE) }
+    fun comp(code: String) = bp?.component?.firstOrNull { c -> c.code?.coding?.any { it.code?.value == code } == true }?.value?.asQuantity()?.value.text()
+    Visit(
+      date = group.firstNotNullOfOrNull { it.effectiveDate() },
+      weightKg = group.firstOrNull { it.hasCode(WEIGHT_CODE) }?.value?.asQuantity()?.value.text(),
+      bp = comp(SYSTOLIC_CODE)?.let { s -> "$s/${comp(DIASTOLIC_CODE) ?: "?"}" },
+      hb = group.firstOrNull { it.hasCode(HB_CODE) }?.value?.asQuantity()?.value.text(),
+    )
+  }.sortedByDescending { it.date }
+}
+
+// ---- Write ----
+
+private fun QuestionnaireResponse.Item.flatten(): List<QuestionnaireResponse.Item> = listOf(this) + item.flatMap { it.flatten() }
+
+private fun loinc(code: String, display: String) =
+  CodeableConcept(coding = listOf(Coding(system = Uri(value = LOINC), code = Code(value = code), display = FhirString(value = display))))
+
+private fun qty(value: String, unit: String, ucum: String) =
+  Quantity(value = Decimal(value = BigDecimal.parseString(value)), unit = FhirString(value = unit), system = Uri(value = "http://unitsofmeasure.org"), code = Code(value = ucum))
+
+/** Persists the filled form as QuestionnaireResponse + Encounter + vital-sign Observations. */
+suspend fun saveVisit(engine: FhirEngine, patientId: String, qr: QuestionnaireResponse) {
+  val answers = qr.item.flatMap { it.flatten() }.associate { it.linkId.value to it.answer.firstOrNull()?.value }
+  val visitDate = answers["visit-date"]?.asDate()?.value?.value.toLocalDate() ?: LocalDate.now()
+  val fhirDate = FhirDateTime.Date(visitDate.toKotlinLocalDate())
+  val encId = UUID.randomUUID().toString()
+  val subject = Reference(reference = FhirString(value = "Patient/$patientId"))
+  val encRef = Reference(reference = FhirString(value = "Encounter/$encId"))
+
+  fun obs(code: CodeableConcept, value: Observation.Value?, components: List<Observation.Component> = emptyList()) = Observation(
+    id = UUID.randomUUID().toString(),
+    status = Enumeration(value = Observation.ObservationStatus.Final),
+    category = listOf(CodeableConcept(coding = listOf(Coding(system = Uri(value = "http://terminology.hl7.org/CodeSystem/observation-category"), code = Code(value = "vital-signs"))))),
+    code = code,
+    subject = subject,
+    encounter = encRef,
+    effective = Observation.Effective.DateTime(DateTime(value = fhirDate)),
+    value = value,
+    component = components,
+  )
+  fun num(linkId: String) = answers[linkId]?.let { it.asDecimal()?.value?.value?.toPlainString() ?: it.asInteger()?.value?.value?.toString() }
+
+  val resources = mutableListOf<Resource>(
+    Encounter(
+      id = encId,
+      status = Enumeration(value = Encounter.EncounterStatus.Finished),
+      `class` = Coding(system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"), code = Code(value = "AMB"), display = FhirString(value = "ambulatory")),
+      type = listOf(CodeableConcept(text = FhirString(value = "Antenatal care contact"))),
+      subject = subject,
+      period = Period(start = DateTime(value = fhirDate), end = DateTime(value = fhirDate)),
+    ),
+    qr.copy(
+      id = qr.id ?: UUID.randomUUID().toString(),
+      questionnaire = Canonical(value = "http://example.org/fhir/Questionnaire/anc-contact"),
+      status = Enumeration(value = QuestionnaireResponse.QuestionnaireResponseStatus.Completed),
+      subject = subject,
+      encounter = encRef,
+      authored = DateTime(value = fhirDate),
+    ),
+  )
+  num("weight")?.let { resources += obs(loinc(WEIGHT_CODE, "Body weight"), Observation.Value.Quantity(qty(it, "kg", "kg"))) }
+  val sys = num("bp-systolic"); val dia = num("bp-diastolic")
+  if (sys != null || dia != null) {
+    fun comp(code: String, display: String, v: String?) = v?.let {
+      Observation.Component(code = loinc(code, display), value = Observation.Component.Value.Quantity(qty(it, "mmHg", "mm[Hg]")))
+    }
+    resources += obs(
+      loinc(BP_CODE, "Blood pressure panel with all children optional"), null,
+      listOfNotNull(comp(SYSTOLIC_CODE, "Systolic blood pressure", sys), comp(DIASTOLIC_CODE, "Diastolic blood pressure", dia)),
+    )
+  }
+  engine.create(*resources.toTypedArray())
+}
