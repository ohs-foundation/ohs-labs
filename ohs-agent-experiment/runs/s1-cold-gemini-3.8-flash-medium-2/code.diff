+package com.example.ancapp.data
+
+import android.content.Context
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.withContext
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+import java.time.LocalDate
+
+class PatientRepository(private val context: Context) {
+
+    private val storageFile: File
+        get() = File(context.filesDir, "anc_database.json")
+
+    private val _patients = MutableStateFlow<List<Patient>>(emptyList())
+    val patients: StateFlow<List<Patient>> = _patients.asStateFlow()
+
+    private val _visits = MutableStateFlow<List<AncVisit>>(emptyList())
+    val visits: StateFlow<List<AncVisit>> = _visits.asStateFlow()
+
+    init {
+        loadData()
+    }
+
+    private fun loadData() {
+        val file = storageFile
+        if (!file.exists() || file.length() == 0L) {
+            seedInitialData()
+        } else {
+            try {
+                val jsonString = file.readText()
+                val rootJson = JSONObject(jsonString)
+
+                val patientsArray = rootJson.getJSONArray("patients")
+                val loadedPatients = mutableListOf<Patient>()
+                for (i in 0 until patientsArray.length()) {
+                    val obj = patientsArray.getJSONObject(i)
+                    loadedPatients.add(
+                        Patient(
+                            id = obj.getString("id"),
+                            name = obj.getString("name"),
+                            dateOfBirth = LocalDate.parse(obj.getString("dateOfBirth")),
+                            estimatedDueDate = LocalDate.parse(obj.getString("estimatedDueDate"))
+                        )
+                    )
+                }
+
+                val visitsArray = rootJson.getJSONArray("visits")
+                val loadedVisits = mutableListOf<AncVisit>()
+                for (i in 0 until visitsArray.length()) {
+                    val obj = visitsArray.getJSONObject(i)
+                    val dangerSignsArray = obj.optJSONArray("dangerSigns")
+                    val dangerSignsList = mutableListOf<String>()
+                    if (dangerSignsArray != null) {
+                        for (j in 0 until dangerSignsArray.length()) {
+                            dangerSignsList.add(dangerSignsArray.getString(j))
+                        }
+                    } else {
+                        dangerSignsList.add(DangerSigns.NONE)
+                    }
+
+                    val hemoglobinVal = if (obj.has("hemoglobin") && !obj.isNull("hemoglobin")) {
+                        obj.getDouble("hemoglobin")
+                    } else null
+
+                    loadedVisits.add(
+                        AncVisit(
+                            id = obj.getString("id"),
+                            patientId = obj.getString("patientId"),
+                            visitDate = LocalDate.parse(obj.getString("visitDate")),
+                            gestationalAgeWeeks = obj.getInt("gestationalAgeWeeks"),
+                            weightKg = obj.getDouble("weightKg"),
+                            systolicBp = obj.getInt("systolicBp"),
+                            diastolicBp = obj.getInt("diastolicBp"),
+                            hemoglobin = hemoglobinVal,
+                            dangerSigns = dangerSignsList,
+                            notes = obj.optString("notes", "")
+                        )
+                    )
+                }
+
+                _patients.value = loadedPatients
+                _visits.value = loadedVisits
+            } catch (e: Exception) {
+                e.printStackTrace()
+                seedInitialData()
+            }
+        }
+    }
+
+    private fun seedInitialData() {
+        val emily = Patient(
+            id = "patient-emily-carter",
+            name = "Emily Carter",
+            dateOfBirth = LocalDate.parse("1996-04-12"),
+            estimatedDueDate = LocalDate.parse("2026-12-05")
+        )
+        val sarah = Patient(
+            id = "patient-sarah-mitchell",
+            name = "Sarah Mitchell",
+            dateOfBirth = LocalDate.parse("1990-11-02"),
+            estimatedDueDate = LocalDate.parse("2027-01-20")
+        )
+        val grace = Patient(
+            id = "patient-grace-thompson",
+            name = "Grace Thompson",
+            dateOfBirth = LocalDate.parse("2001-07-30"),
+            estimatedDueDate = LocalDate.parse("2026-10-15")
+        )
+
+        val emilyVisit = AncVisit(
+            id = "visit-emily-1",
+            patientId = emily.id,
+            visitDate = LocalDate.parse("2026-08-10"),
+            gestationalAgeWeeks = 23,
+            weightKg = 68.5,
+            systolicBp = 118,
+            diastolicBp = 76,
+            hemoglobin = 11.8,
+            dangerSigns = listOf(DangerSigns.NONE),
+            notes = "Routine initial ANC visit. Fetal movement noted."
+        )
+
+        val sarahVisit = AncVisit(
+            id = "visit-sarah-1",
+            patientId = sarah.id,
+            visitDate = LocalDate.parse("2026-08-12"),
+            gestationalAgeWeeks = 17,
+            weightKg = 61.2,
+            systolicBp = 110,
+            diastolicBp = 70,
+            hemoglobin = 12.4,
+            dangerSigns = listOf(DangerSigns.NONE),
+            notes = "Initial ANC evaluation. Blood pressure and vitals stable."
+        )
+
+        val graceVisit = AncVisit(
+            id = "visit-grace-1",
+            patientId = grace.id,
+            visitDate = LocalDate.parse("2026-08-05"),
+            gestationalAgeWeeks = 30,
+            weightKg = 72.0,
+            systolicBp = 128,
+            diastolicBp = 84,
+            hemoglobin = 10.2,
+            dangerSigns = listOf(DangerSigns.NONE),
+            notes = "Routine ANC checkup. Mild anemia (Hb 10.2), iron supplementation prescribed."
+        )
+
+        val seededPatients = listOf(emily, sarah, grace)
+        val seededVisits = listOf(emilyVisit, sarahVisit, graceVisit)
+
+        _patients.value = seededPatients
+        _visits.value = seededVisits
+        persistData(seededPatients, seededVisits)
+    }
+
+    private fun persistData(patients: List<Patient>, visits: List<AncVisit>) {
+        try {
+            val root = JSONObject()
+
+            val patientsArray = JSONArray()
+            for (p in patients) {
+                val pObj = JSONObject().apply {
+                    put("id", p.id)
+                    put("name", p.name)
+                    put("dateOfBirth", p.dateOfBirth.toString())
+                    put("estimatedDueDate", p.estimatedDueDate.toString())
+                }
+                patientsArray.put(pObj)
+            }
+            root.put("patients", patientsArray)
+
+            val visitsArray = JSONArray()
+            for (v in visits) {
+                val vObj = JSONObject().apply {
+                    put("id", v.id)
+                    put("patientId", v.patientId)
+                    put("visitDate", v.visitDate.toString())
+                    put("gestationalAgeWeeks", v.gestationalAgeWeeks)
+                    put("weightKg", v.weightKg)
+                    put("systolicBp", v.systolicBp)
+                    put("diastolicBp", v.diastolicBp)
+                    if (v.hemoglobin != null) {
+                        put("hemoglobin", v.hemoglobin)
+                    } else {
+                        put("hemoglobin", JSONObject.NULL)
+                    }
+                    val dsArray = JSONArray()
+                    v.dangerSigns.forEach { dsArray.put(it) }
+                    put("dangerSigns", dsArray)
+                    put("notes", v.notes)
+                }
+                visitsArray.put(vObj)
+            }
+            root.put("visits", visitsArray)
+
+            // Write atomically to temp file, then rename
+            val tempFile = File(context.filesDir, "anc_database.json.tmp")
+            tempFile.writeText(root.toString(2))
+            if (tempFile.renameTo(storageFile)) {
+                // renamed successfully
+            } else {
+                storageFile.writeText(root.toString(2))
+                tempFile.delete()
+            }
+        } catch (e: Exception) {
+            e.printStackTrace()
+        }
+    }
+
+    suspend fun addVisit(visit: AncVisit) = withContext(Dispatchers.IO) {
+        val updated = _visits.value + visit
+        _visits.value = updated
+        persistData(_patients.value, updated)
+    }
+
+    suspend fun addPatient(patient: Patient) = withContext(Dispatchers.IO) {
+        val updated = _patients.value + patient
+        _patients.value = updated
+        persistData(updated, _visits.value)
+    }
+
+    fun getPatient(id: String): Patient? {
+        return _patients.value.find { it.id == id }
+    }
+
+    fun getVisitsForPatient(patientId: String): List<AncVisit> {
+        return _visits.value.filter { it.patientId == patientId }
+            .sortedByDescending { it.visitDate }
+    }
+}
