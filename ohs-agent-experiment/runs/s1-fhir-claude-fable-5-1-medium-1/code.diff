 class MainActivity : ComponentActivity() {
   override fun onCreate(savedInstanceState: Bundle?) {
     super.onCreate(savedInstanceState)
-    setContent { MaterialTheme { Surface { Text("Hello") } } }
+    setContent { MaterialTheme { Surface { App() } } }
+  }
+}
+
+sealed interface Screen {
+  data object Register : Screen
+  data class Detail(val patient: PatientRow) : Screen
+  data class NewVisit(val patient: PatientRow) : Screen
+}
+
+@Composable
+fun App() {
+  var screen by remember { mutableStateOf<Screen>(Screen.Register) }
+  when (val s = screen) {
+    Screen.Register -> RegisterScreen { screen = Screen.Detail(it) }
+    is Screen.Detail -> { BackHandler { screen = Screen.Register }; DetailScreen(s.patient, onBack = { screen = Screen.Register }, onAdd = { screen = Screen.NewVisit(s.patient) }) }
+    is Screen.NewVisit -> { BackHandler { screen = Screen.Detail(s.patient) }; VisitFormScreen(s.patient, onDone = { screen = Screen.Detail(s.patient) }) }
+  }
+}
+
+/** Runs [load] off the main thread; returns (result, error, retry). */
+@Composable
+fun <T> rememberLoad(vararg keys: Any?, load: () -> T): Triple<T?, String?, () -> Unit> {
+  var result by remember(*keys) { mutableStateOf<T?>(null) }
+  var error by remember(*keys) { mutableStateOf<String?>(null) }
+  var attempt by remember(*keys) { mutableIntStateOf(0) }
+  LaunchedEffect(attempt, *keys) {
+    error = null
+    runCatching { withContext(Dispatchers.IO) { load() } }.onSuccess { result = it }.onFailure { error = it.message ?: it.toString() }
+  }
+  return Triple(result, error, { attempt++ })
+}
+
+@Composable
+fun <T> Loading(result: T?, error: String?, retry: () -> Unit, content: @Composable (T) -> Unit) {
+  when {
+    error != null -> Column(Modifier.fillMaxSize().padding(24.dp), horizontalAlignment = Alignment.CenterHorizontally) {
+      Text(error, color = MaterialTheme.colorScheme.error); Spacer(Modifier.height(8.dp)); Button(onClick = retry) { Text("Retry") }
+    }
+    result == null -> Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) { CircularProgressIndicator() }
+    else -> content(result)
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun RegisterScreen(onOpen: (PatientRow) -> Unit) {
+  val (rows, err, retry) = rememberLoad { Fhir.loadRegister() }
+  Scaffold(topBar = { TopAppBar(title = { Text("ANC Register") }) }) { pad ->
+    Box(Modifier.padding(pad)) {
+      Loading(rows, err, retry) { list ->
+        LazyColumn {
+          items(list, key = { it.id }) { p ->
+            ListItem(
+              modifier = Modifier.clickable { onOpen(p) },
+              headlineContent = { Text(p.name) },
+              supportingContent = { Text("Age ${p.age} · EDD ${p.edd} · ${p.weeks} weeks") },
+            )
+            HorizontalDivider()
+          }
+        }
+      }
+    }
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun DetailScreen(p: PatientRow, onBack: () -> Unit, onAdd: () -> Unit) {
+  val (visits, err, retry) = rememberLoad(p.id) { Fhir.loadVisits(p.id) }
+  Scaffold(
+    topBar = { TopAppBar(title = { Text(p.name) }, navigationIcon = { TextButton(onClick = onBack) { Text("Back") } }) },
+    floatingActionButton = { ExtendedFloatingActionButton(onClick = onAdd) { Text("+ Record visit") } },
+  ) { pad ->
+    Box(Modifier.padding(pad)) {
+      Loading(visits, err, retry) { list ->
+        if (list.isEmpty()) Text("No visits yet", Modifier.padding(16.dp))
+        LazyColumn {
+          items(list) { v ->
+            ListItem(
+              headlineContent = { Text(v.date) },
+              supportingContent = {
+                Text(listOfNotNull(
+                  v.weight?.let { "Weight $it kg" },
+                  if (v.systolic != null && v.diastolic != null) "BP ${v.systolic}/${v.diastolic} mmHg" else null,
+                  v.hb?.let { "Hb $it g/dL" },
+                ).joinToString(" · ").ifEmpty { "No measurements" })
+              },
+            )
+            HorizontalDivider()
+          }
+        }
+      }
+    }
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun VisitFormScreen(p: PatientRow, onDone: () -> Unit) {
+  val (q, err, retry) = rememberLoad { Fhir.loadQuestionnaire() }
+  val answers = remember { mutableStateMapOf("visit-date" to LocalDate.now().toString()) }
+  val signs = remember { mutableStateListOf<String>() }
+  var saving by remember { mutableStateOf(false) }
+  var saveError by remember { mutableStateOf<String?>(null) }
+  val scope = rememberCoroutineScope()
+
+  Scaffold(topBar = { TopAppBar(title = { Text("New ANC visit") }, navigationIcon = { TextButton(onClick = onDone) { Text("Back") } }) }) { pad ->
+    Box(Modifier.padding(pad)) {
+      Loading(q, err, retry) { questionnaire ->
+        Column(Modifier.fillMaxSize().verticalScroll(rememberScrollState()).padding(16.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+          QuestionnaireItems(questionnaire.optJSONArray("item"), answers, signs)
+          saveError?.let { Text(it, color = MaterialTheme.colorScheme.error) }
+          Button(enabled = !saving, modifier = Modifier.fillMaxWidth(), onClick = {
+            saveError = validate(questionnaire.optJSONArray("item"), answers)
+            if (saveError != null) return@Button
+            saving = true
+            scope.launch {
+              runCatching { withContext(Dispatchers.IO) { Fhir.saveVisit(p.id, questionnaire, answers.toMap(), signs.toList()) } }
+                .onSuccess { onDone() }.onFailure { saveError = it.message; saving = false }
+            }
+          }) { Text(if (saving) "Saving…" else "Save visit") }
+          Spacer(Modifier.height(32.dp))
+        }
+      }
+    }
+  }
+}
+
+private fun JSONArray?.objects() = this?.let { a -> (0 until a.length()).map { a.getJSONObject(it) } }.orEmpty()
+
+fun validate(items: JSONArray?, answers: Map<String, String>): String? {
+  for (item in items.objects()) {
+    val v = answers[item.getString("linkId")].orEmpty().trim()
+    val label = item.optString("text")
+    when (item.getString("type")) {
+      "group" -> validate(item.optJSONArray("item"), answers)?.let { return it }
+      "date" -> if (v.isEmpty() && item.optBoolean("required")) return "$label is required"
+        else if (v.isNotEmpty() && runCatching { LocalDate.parse(v) }.isFailure) return "$label must be YYYY-MM-DD"
+      "integer" -> if (v.isNotEmpty() && v.toIntOrNull() == null) return "$label must be a whole number"
+      "decimal" -> if (v.isNotEmpty() && v.toDoubleOrNull() == null) return "$label must be a number"
+      else -> if (v.isEmpty() && item.optBoolean("required")) return "$label is required"
+    }
+  }
+  return null
+}
+
+@Composable
+fun QuestionnaireItems(items: JSONArray?, answers: MutableMap<String, String>, signs: MutableList<String>) {
+  for (item in items.objects()) {
+    val linkId = item.getString("linkId")
+    val label = item.optString("text") + if (item.optBoolean("required")) " *" else ""
+    when (val type = item.getString("type")) {
+      "group" -> {
+        Text(item.optString("text"), style = MaterialTheme.typography.titleMedium, modifier = Modifier.padding(top = 8.dp))
+        QuestionnaireItems(item.optJSONArray("item"), answers, signs)
+      }
+      "choice" -> {
+        Text(item.optString("text"), style = MaterialTheme.typography.titleMedium, modifier = Modifier.padding(top = 8.dp))
+        for (opt in item.optJSONArray("answerOption").objects()) {
+          val c = opt.getJSONObject("valueCoding"); val code = c.getString("code")
+          Row(verticalAlignment = Alignment.CenterVertically) {
+            Checkbox(checked = code in signs, onCheckedChange = { on ->
+              if (!on) signs.remove(code)
+              else { if (code == "none" || !item.optBoolean("repeats")) signs.clear() else signs.remove("none"); signs.add(code) }
+            })
+            Text(c.optString("display", code))
+          }
+        }
+      }
+      else -> OutlinedTextField(
+        value = answers[linkId] ?: "",
+        onValueChange = { answers[linkId] = it },
+        label = { Text(label) },
+        placeholder = { if (type == "date") Text("YYYY-MM-DD") },
+        singleLine = type != "text",
+        minLines = if (type == "text") 3 else 1,
+        keyboardOptions = KeyboardOptions(keyboardType = when (type) { "integer" -> KeyboardType.Number; "decimal" -> KeyboardType.Decimal; else -> KeyboardType.Text }),
+        modifier = Modifier.fillMaxWidth(),
+      )
+    }
   }
 }
