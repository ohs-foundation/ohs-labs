+package com.example.ancapp.ui
+
+import android.content.Context
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.example.ancapp.data.AncVisit
+import com.example.ancapp.data.FhirExtractor
+import com.example.ancapp.data.FhirRepository
+import com.example.ancapp.data.PatientInfo
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+
+class PatientDetailViewModel(context: Context) : ViewModel() {
+  private val repository = FhirRepository(context)
+
+  private val _patient = MutableStateFlow<PatientInfo?>(null)
+  val patient = _patient.asStateFlow()
+
+  private val _visits = MutableStateFlow<List<AncVisit>>(emptyList())
+  val visits = _visits.asStateFlow()
+
+  private val _isLoading = MutableStateFlow(false)
+  val isLoading = _isLoading.asStateFlow()
+
+  fun loadPatient(patientId: String) {
+    viewModelScope.launch {
+      _isLoading.value = true
+      try {
+        val fhirPatient = repository.getPatient(patientId)
+        val dueDate = FhirExtractor.extractEstimatedDueDate(fhirPatient)
+        _patient.value = FhirExtractor.extractPatientInfo(fhirPatient, dueDate)
+
+        val encounters = repository.getPatientEncounters(patientId)
+        val ancVisits = encounters.mapNotNull { encounter ->
+          val observations = repository.getEncounterObservations(encounter.id ?: return@mapNotNull null)
+          FhirExtractor.extractAncVisit(encounter, observations)
+        }
+        _visits.value = ancVisits
+      } catch (e: Exception) {
+        e.printStackTrace()
+      } finally {
+        _isLoading.value = false
+      }
+    }
+  }
+}
