@@ -0,0 +1,28 @@
+package com.example.ancapp
+
+import android.app.Application
+import dev.ohs.fhir.datacapture.DataCapture
+import dev.ohs.fhir.engine.DatabaseErrorStrategy
+import dev.ohs.fhir.engine.FhirEngineConfiguration
+import dev.ohs.fhir.engine.FhirEngineProvider
+import dev.ohs.fhir.engine.ServerConfiguration
+import dev.ohs.fhir.engine.sync.remote.HttpLogger
+
+class AncApplication : Application() {
+  override fun onCreate() {
+    super.onCreate()
+    DataCapture.initialize(this)
+    FhirEngineProvider.init(
+      FhirEngineConfiguration(
+        databaseErrorStrategy = DatabaseErrorStrategy.RECREATE_AT_OPEN,
+        serverConfiguration = ServerConfiguration(
+          baseUrl = "http://10.0.2.2:8080/fhir/",
+          httpLogger = HttpLogger(level = HttpLogger.Level.BASIC),
+        ),
+      ),
+      this,
+    )
+    // Create the FhirEngine instance immediately so sync workers always see the ServerConfiguration
+    FhirEngineProvider.getInstance(this)
+  }
+}
diff --git a/app/src/main/java/com/example/ancapp/AncViewModel.kt b/app/src/main/java/com/example/ancapp/AncViewModel.kt
new file mode 100644
index 0000000..f9be50f
--- /dev/null
+++ b/app/src/main/java/com/example/ancapp/AncViewModel.kt
@@ -0,0 +1,834 @@
+package com.example.ancapp
+
+import android.app.Application
+import androidx.lifecycle.AndroidViewModel
+import androidx.lifecycle.viewModelScope
+import com.ionspin.kotlin.bignum.decimal.BigDecimal
+import dev.ohs.fhir.engine.FhirEngine
+import dev.ohs.fhir.engine.FhirEngineProvider
+import dev.ohs.fhir.engine.get
+import dev.ohs.fhir.engine.search.ReferenceClientParam
+import dev.ohs.fhir.engine.search.Search
+import dev.ohs.fhir.engine.sync.CurrentSyncJobStatus
+import dev.ohs.fhir.engine.sync.PeriodicSyncConfiguration
+import dev.ohs.fhir.engine.sync.RepeatInterval
+import dev.ohs.fhir.engine.sync.Sync
+import dev.ohs.fhir.model.r4.Canonical
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.CodeableConcept
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.DateTime
+import dev.ohs.fhir.model.r4.Decimal
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Enumeration
+import dev.ohs.fhir.model.r4.FhirDateTime
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Patient
+import dev.ohs.fhir.model.r4.Period
+import dev.ohs.fhir.model.r4.Quantity
+import dev.ohs.fhir.model.r4.Questionnaire
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import dev.ohs.fhir.model.r4.Reference
+import dev.ohs.fhir.model.r4.Resource
+import dev.ohs.fhir.model.r4.String as FhirString
+import dev.ohs.fhir.model.r4.Uri
+import dev.ohs.fhir.model.r4.terminologies.ResourceType
+import java.time.LocalDate
+import java.time.Period as JavaPeriod
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+import kotlin.time.Duration.Companion.minutes
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.catch
+import kotlinx.coroutines.flow.transformWhile
+import kotlinx.coroutines.launch
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+
+data class PatientSummary(
+  val id: String,
+  val name: String,
+  val birthDate: LocalDate?,
+  val ageYears: Int?,
+  val dueDate: LocalDate?,
+  val currentWeeksPregnant: Int?,
+)
+
+data class AncVisitItem(
+  val id: String,
+  val date: LocalDate?,
+  val dateText: String,
+  val weightText: String?,
+  val bpText: String?,
+  val hbText: String?,
+  val gestationalAgeWeeks: Int?,
+  val dangerSignsText: String?,
+  val notesText: String?,
+)
+
+data class PatientDetailState(
+  val patient: PatientSummary?,
+  val visits: List<AncVisitItem>,
+)
+
+private fun CurrentSyncJobStatus.isFinal(): Boolean =
+  this is CurrentSyncJobStatus.Succeeded ||
+    this is CurrentSyncJobStatus.Failed ||
+    this is CurrentSyncJobStatus.Cancelled
+
+class AncViewModel(app: Application) : AndroidViewModel(app) {
+  private val fhirEngine: FhirEngine = FhirEngineProvider.getInstance(app.applicationContext)
+
+  private val json = Json {
+    explicitNulls = false
+    encodeDefaults = false
+  }
+
+  private val _patients = MutableStateFlow<List<PatientSummary>>(emptyList())
+  val patients: StateFlow<List<PatientSummary>> = _patients.asStateFlow()
+
+  private val _patientDetails = MutableStateFlow<Map<String, PatientDetailState>>(emptyMap())
+  val patientDetails: StateFlow<Map<String, PatientDetailState>> = _patientDetails.asStateFlow()
+
+  private val _questionnaireJson = MutableStateFlow<String>(FALLBACK_ANC_QUESTIONNAIRE_JSON)
+  val questionnaireJson: StateFlow<String> = _questionnaireJson.asStateFlow()
+
+  private val _syncState = MutableStateFlow<String?>(null)
+  val syncState: StateFlow<String?> = _syncState.asStateFlow()
+
+  private var syncJob: Job? = null
+
+  init {
+    refreshLocalData()
+    syncNow()
+    startPeriodicSync()
+  }
+
+  fun syncNow() {
+    if (syncJob?.isActive == true) return
+    syncJob = viewModelScope.launch {
+      var ran = false
+      Sync.oneTimeSync<AppSyncWorker>(getApplication())
+        .transformWhile {
+          emit(it)
+          !it.isFinal()
+        }
+        .catch { _syncState.value = "Sync status unknown" }
+        .collect { status ->
+          _syncState.value =
+            when (status) {
+              is CurrentSyncJobStatus.Enqueued ->
+                if (ran) "Waiting to retry" else "Waiting to sync"
+              is CurrentSyncJobStatus.Running -> {
+                ran = true
+                "Syncing…"
+              }
+              is CurrentSyncJobStatus.Succeeded -> {
+                refreshLocalData()
+                "Synced"
+              }
+              is CurrentSyncJobStatus.Failed -> {
+                refreshLocalData()
+                "Sync failed, will try again later"
+              }
+              else -> _syncState.value
+            }
+        }
+      refreshLocalData()
+    }
+  }
+
+  private fun startPeriodicSync() {
+    viewModelScope.launch {
+      Sync.periodicSync<AppSyncWorker>(
+          getApplication(),
+          PeriodicSyncConfiguration(
+            repeat = RepeatInterval(interval = 15.minutes),
+          ),
+        )
+        .catch {}
+        .collect {
+          refreshLocalData()
+        }
+    }
+  }
+
+  fun refreshLocalData() {
+    viewModelScope.launch {
+      loadFromEngine()
+    }
+  }
+
+  private suspend fun loadFromEngine() {
+    // Load Questionnaire if available in local database
+    val localQuestionnaire =
+      runCatching { fhirEngine.get<Questionnaire>("anc-contact") }.getOrNull()
+        ?: runCatching {
+            fhirEngine
+              .search<Questionnaire>(Search(ResourceType.Questionnaire))
+              .map { it.resource }
+              .firstOrNull {
+                it.id == "anc-contact" ||
+                  it.name?.value == "AncContact" ||
+                  it.url?.value?.endsWith("anc-contact") == true
+              }
+          }
+          .getOrNull()
+
+    if (localQuestionnaire != null) {
+      runCatching { json.encodeToString(localQuestionnaire) }
+        .getOrNull()
+        ?.let { _questionnaireJson.value = it }
+    }
+
+    val allPatients =
+      runCatching { fhirEngine.search<Patient>(Search(ResourceType.Patient)).map { it.resource } }
+        .getOrDefault(emptyList())
+
+    val allEncounters =
+      runCatching {
+          fhirEngine.search<Encounter>(Search(ResourceType.Encounter)).map { it.resource }
+        }
+        .getOrDefault(emptyList())
+
+    val allObservations =
+      runCatching {
+          fhirEngine.search<Observation>(Search(ResourceType.Observation)).map { it.resource }
+        }
+        .getOrDefault(emptyList())
+
+    val today = LocalDate.now()
+    val summaries = mutableListOf<PatientSummary>()
+    val detailsMap = mutableMapOf<String, PatientDetailState>()
+
+    for (patient in allPatients) {
+      val patientId = patient.id ?: continue
+      val humanName = patient.name.firstOrNull()
+      val fullName =
+        listOfNotNull(
+            humanName?.given?.mapNotNull { it.value }?.joinToString(" ")?.takeIf { it.isNotBlank() },
+            humanName?.family?.value?.takeIf { it.isNotBlank() },
+          )
+          .joinToString(" ")
+          .ifBlank { humanName?.text?.value ?: patientId }
+
+      val birthDate =
+        patient.birthDate?.value?.toString()?.let {
+          runCatching { LocalDate.parse(it.substringBefore("T")) }.getOrNull()
+        }
+      val ageYears = birthDate?.let { JavaPeriod.between(it, today).years }
+
+      val patientObservations =
+        allObservations.filter { obs ->
+          obs.subject?.reference?.value?.substringAfter("/") == patientId
+        }
+      val patientEncounters =
+        allEncounters.filter { enc ->
+          enc.subject?.reference?.value?.substringAfter("/") == patientId
+        }
+
+      // Find Estimated Due Date (LOINC 11778-8)
+      val eddObservation =
+        patientObservations.firstOrNull { obs ->
+          obs.hasCode("11778-8")
+        }
+      val dueDateStr =
+        eddObservation?.value?.asDateTime()?.value?.value?.toString()?.substringBefore("T")
+          ?: eddObservation?.value?.asString()?.value?.value?.substringBefore("T")
+      val dueDate =
+        dueDateStr?.let { runCatching { LocalDate.parse(it) }.getOrNull() }
+
+      // Compute current weeks of pregnancy from due date (standard 40-week / 280-day gestation)
+      val currentWeeks =
+        dueDate?.let { edd ->
+          val lmp = edd.minusWeeks(40)
+          ChronoUnit.WEEKS.between(lmp, today).toInt().coerceAtLeast(0)
+        }
+
+      val summary =
+        PatientSummary(
+          id = patientId,
+          name = fullName,
+          birthDate = birthDate,
+          ageYears = ageYears,
+          dueDate = dueDate,
+          currentWeeksPregnant = currentWeeks,
+        )
+      summaries.add(summary)
+
+      // Build visit items for this patient
+      val obsByEncounterId =
+        patientObservations.groupBy { obs ->
+          obs.encounter?.reference?.value?.substringAfter("/")
+        }
+
+      val visitItems =
+        patientEncounters
+          .map { encounter ->
+            val encId = encounter.id ?: UUID.randomUUID().toString()
+            val encObs = obsByEncounterId[encounter.id].orEmpty()
+            val dateStr =
+              encounter.period?.start?.value?.toString()?.substringBefore("T")
+                ?: encObs
+                  .firstNotNullOfOrNull {
+                    it.effective?.asDateTime()?.value?.value?.toString()?.substringBefore("T")
+                  }
+                ?: "Unknown date"
+            val parsedDate = runCatching { LocalDate.parse(dateStr) }.getOrNull()
+
+            // Weight (LOINC 29463-7)
+            val weightObs = encObs.firstOrNull { it.hasCode("29463-7") }
+            val weightBd = weightObs?.value?.asQuantity()?.value?.value?.value
+            val weightText = weightBd?.let { "${formatDecimal(it)} kg" }
+
+            // Blood pressure (LOINC 85354-9 panel or standalone 8480-6 / 8462-4)
+            val bpPanelObs = encObs.firstOrNull { it.hasCode("85354-9") }
+            val sysFromPanel =
+              bpPanelObs
+                ?.component
+                ?.firstOrNull { comp ->
+                  comp.code.coding.any { it.code?.value == "8480-6" }
+                }
+                ?.value
+                ?.asQuantity()
+                ?.value
+                ?.value
+                ?.value
+                ?.intValue(exactRequired = false)
+            val diaFromPanel =
+              bpPanelObs
+                ?.component
+                ?.firstOrNull { comp ->
+                  comp.code.coding.any { it.code?.value == "8462-4" }
+                }
+                ?.value
+                ?.asQuantity()
+                ?.value
+                ?.value
+                ?.value
+                ?.intValue(exactRequired = false)
+
+            val sysStandalone =
+              encObs
+                .firstOrNull { it.hasCode("8480-6") }
+                ?.value
+                ?.asQuantity()
+                ?.value
+                ?.value
+                ?.value
+                ?.intValue(exactRequired = false)
+            val diaStandalone =
+              encObs
+                .firstOrNull { it.hasCode("8462-4") }
+                ?.value
+                ?.asQuantity()
+                ?.value
+                ?.value
+                ?.value
+                ?.intValue(exactRequired = false)
+
+            val systolic = sysFromPanel ?: sysStandalone
+            val diastolic = diaFromPanel ?: diaStandalone
+            val bpText =
+              if (systolic != null && diastolic != null) {
+                "$systolic/$diastolic mmHg"
+              } else if (systolic != null || diastolic != null) {
+                "${systolic ?: "--"}/${diastolic ?: "--"} mmHg"
+              } else {
+                null
+              }
+
+            // Hemoglobin (LOINC 718-7)
+            val hbObs = encObs.firstOrNull { it.hasCode("718-7") }
+            val hbBd = hbObs?.value?.asQuantity()?.value?.value?.value
+            val hbText = hbBd?.let { "${formatDecimal(it)} g/dL" }
+
+            // Gestational age (LOINC 18185-9)
+            val gaObs = encObs.firstOrNull { it.hasCode("18185-9") }
+            val gaWeeks =
+              gaObs?.value?.asQuantity()?.value?.value?.value?.intValue(exactRequired = false)
+
+            // Danger signs
+            val dangerObs =
+              encObs.firstOrNull { obs ->
+                obs.code.coding.any {
+                  it.system?.value == "urn:example:anc-danger-signs" ||
+                    it.code?.value == "danger-signs"
+                }
+              }
+            val dangerSignsText =
+              dangerObs?.value?.asCodeableConcept()?.value?.let { cc ->
+                cc.coding
+                  .mapNotNull { it.display?.value ?: it.code?.value }
+                  .joinToString(", ")
+                  .ifBlank { cc.text?.value.orEmpty() }
+                  .takeIf { it.isNotBlank() }
+              }
+
+            // Notes (LOINC 48767-8)
+            val notesObs =
+              encObs.firstOrNull { obs ->
+                obs.hasCode("48767-8") || obs.code.text?.value == "Notes"
+              }
+            val notesText =
+              notesObs?.value?.asString()?.value?.value?.takeIf { it.isNotBlank() }
+
+            AncVisitItem(
+              id = encId,
+              date = parsedDate,
+              dateText = dateStr,
+              weightText = weightText,
+              bpText = bpText,
+              hbText = hbText,
+              gestationalAgeWeeks = gaWeeks,
+              dangerSignsText = dangerSignsText,
+              notesText = notesText,
+            )
+          }
+          .sortedWith(compareByDescending<AncVisitItem, LocalDate?>(nullsLast()) { it.date })
+
+      detailsMap[patientId] =
+        PatientDetailState(
+          patient = summary,
+          visits = visitItems,
+        )
+    }
+
+    // Sort patients by due date (soonest first)
+    _patients.value = summaries.sortedWith(compareBy(nullsLast()) { it.dueDate })
+    _patientDetails.value = detailsMap
+  }
+
+  fun saveVisit(
+    patientId: String,
+    response: QuestionnaireResponse,
+    onSaved: () -> Unit,
+  ) {
+    viewModelScope.launch {
+      val answers = mutableMapOf<String, MutableList<QuestionnaireResponse.Item.Answer>>()
+      fun collect(items: List<QuestionnaireResponse.Item>) {
+        items.forEach { item ->
+          item.linkId.value?.let { linkId ->
+            answers.getOrPut(linkId) { mutableListOf() }.addAll(item.answer)
+          }
+          collect(item.item)
+          item.answer.forEach { collect(it.item) }
+        }
+      }
+      collect(response.item)
+
+      val visitDateStr =
+        answers["visit-date"]?.firstOrNull()?.value?.asDate()?.value?.value?.toString()
+          ?: LocalDate.now().toString()
+      val gestationalAgeWeeks: Int? =
+        answers["gestational-age"]?.firstOrNull()?.value?.asInteger()?.value?.value
+      val weightBd: BigDecimal? =
+        answers["weight"]?.firstOrNull()?.value?.asDecimal()?.value?.value
+      val bpSystolic: Int? =
+        answers["bp-systolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+      val bpDiastolic: Int? =
+        answers["bp-diastolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+      val dangerSignCodings: List<Coding> =
+        answers["danger-signs"].orEmpty().mapNotNull { it.value?.asCoding()?.value }
+      val notes: String? =
+        answers["notes"]
+          ?.firstOrNull()
+          ?.value
+          ?.asString()
+          ?.value
+          ?.value
+          ?.takeIf { it.isNotBlank() }
+
+      val encounterId = UUID.randomUUID().toString()
+      val patientRef = Reference(reference = FhirString(value = "Patient/$patientId"))
+      val encounterRef = Reference(reference = FhirString(value = "Encounter/$encounterId"))
+      val visitDateTime = DateTime(value = FhirDateTime.fromString(visitDateStr))
+      val effectiveDateTime = Observation.Effective.DateTime(visitDateTime)
+
+      val vitalSignsCategory =
+        CodeableConcept(
+          coding =
+            listOf(
+              Coding(
+                system = Uri(value = "http://terminology.hl7.org/CodeSystem/observation-category"),
+                code = Code(value = "vital-signs"),
+                display = FhirString(value = "Vital Signs"),
+              )
+            )
+        )
+
+      val encounter =
+        Encounter(
+          id = encounterId,
+          status = Enumeration(value = Encounter.EncounterStatus.Finished),
+          `class` =
+            Coding(
+              system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"),
+              code = Code(value = "AMB"),
+              display = FhirString(value = "ambulatory"),
+            ),
+          type =
+            listOf(
+              CodeableConcept(
+                text = FhirString(value = "Antenatal care contact"),
+              )
+            ),
+          subject = patientRef,
+          period =
+            Period(
+              start = visitDateTime,
+              end = visitDateTime,
+            ),
+        )
+
+      val resourcesToCreate = mutableListOf<Resource>(encounter)
+
+      if (weightBd != null) {
+        resourcesToCreate.add(
+          Observation(
+            id = UUID.randomUUID().toString(),
+            status = Enumeration(value = Observation.ObservationStatus.Final),
+            category = listOf(vitalSignsCategory),
+            code =
+              CodeableConcept(
+                coding =
+                  listOf(
+                    Coding(
+                      system = Uri(value = "http://loinc.org"),
+                      code = Code(value = "29463-7"),
+                      display = FhirString(value = "Body weight"),
+                    )
+                  ),
+                text = FhirString(value = "Body weight"),
+              ),
+            subject = patientRef,
+            encounter = encounterRef,
+            effective = effectiveDateTime,
+            value =
+              Observation.Value.Quantity(
+                Quantity(
+                  value = Decimal(value = weightBd),
+                  unit = FhirString(value = "kg"),
+                  system = Uri(value = "http://unitsofmeasure.org"),
+                  code = Code(value = "kg"),
+                )
+              ),
+          )
+        )
+      }
+
+      if (bpSystolic != null || bpDiastolic != null) {
+        val components = buildList {
+          if (bpSystolic != null) {
+            add(
+              Observation.Component(
+                code =
+                  CodeableConcept(
+                    coding =
+                      listOf(
+                        Coding(
+                          system = Uri(value = "http://loinc.org"),
+                          code = Code(value = "8480-6"),
+                          display = FhirString(value = "Systolic blood pressure"),
+                        )
+                      )
+                  ),
+                value =
+                  Observation.Component.Value.Quantity(
+                    Quantity(
+                      value = Decimal(value = BigDecimal.fromInt(bpSystolic)),
+                      unit = FhirString(value = "mmHg"),
+                      system = Uri(value = "http://unitsofmeasure.org"),
+                      code = Code(value = "mm[Hg]"),
+                    )
+                  ),
+              )
+            )
+          }
+          if (bpDiastolic != null) {
+            add(
+              Observation.Component(
+                code =
+                  CodeableConcept(
+                    coding =
+                      listOf(
+                        Coding(
+                          system = Uri(value = "http://loinc.org"),
+                          code = Code(value = "8462-4"),
+                          display = FhirString(value = "Diastolic blood pressure"),
+                        )
+                      )
+                  ),
+                value =
+                  Observation.Component.Value.Quantity(
+                    Quantity(
+                      value = Decimal(value = BigDecimal.fromInt(bpDiastolic)),
+                      unit = FhirString(value = "mmHg"),
+                      system = Uri(value = "http://unitsofmeasure.org"),
+                      code = Code(value = "mm[Hg]"),
+                    )
+                  ),
+              )
+            )
+          }
+        }
+
+        resourcesToCreate.add(
+          Observation(
+            id = UUID.randomUUID().toString(),
+            status = Enumeration(value = Observation.ObservationStatus.Final),
+            category = listOf(vitalSignsCategory),
+            code =
+              CodeableConcept(
+                coding =
+                  listOf(
+                    Coding(
+                      system = Uri(value = "http://loinc.org"),
+                      code = Code(value = "85354-9"),
+                      display =
