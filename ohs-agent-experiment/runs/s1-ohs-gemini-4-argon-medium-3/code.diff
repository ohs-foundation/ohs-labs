+package com.example.ancapp
+
+import android.app.Application
+import androidx.lifecycle.AndroidViewModel
+import androidx.lifecycle.viewModelScope
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+
+data class AncUiState(
+  val isLoading: Boolean = true,
+  val isSyncing: Boolean = false,
+  val isSavingVisit: Boolean = false,
+  val errorMessage: String? = null,
+  val patients: List<PatientSummary> = emptyList(),
+  val selectedPatient: PatientSummary? = null,
+  val selectedPatientVisits: List<AncVisitRecord> = emptyList(),
+  val questionnaireJson: String? = null,
+)
+
+class AncViewModel(application: Application) : AndroidViewModel(application) {
+
+  private val repository =
+    AncRepository((application as AncApplication).fhirEngine)
+
+  private val _uiState = MutableStateFlow(AncUiState())
+  val uiState: StateFlow<AncUiState> = _uiState.asStateFlow()
+
+  init {
+    initialLoadAndSync()
+  }
+
+  private fun initialLoadAndSync() {
+    viewModelScope.launch {
+      _uiState.update { it.copy(isLoading = true, errorMessage = null) }
+      // Load local patients first if already synced
+      refreshLocalState()
+      val hadLocalPatients = _uiState.value.patients.isNotEmpty()
+      if (hadLocalPatients) {
+        _uiState.update { it.copy(isLoading = false) }
+      }
+
+      // Sync with FHIR server
+      _uiState.update { it.copy(isSyncing = true) }
+      try {
+        repository.syncWithServer()
+      } catch (e: Exception) {
+        if (!hadLocalPatients) {
+          _uiState.update {
+            it.copy(errorMessage = "Could not reach FHIR server: ${e.message ?: "Network error"}")
+          }
+        }
+      } finally {
+        refreshLocalState()
+        _uiState.update { it.copy(isLoading = false, isSyncing = false) }
+      }
+    }
+  }
+
+  fun refreshAndSync() {
+    viewModelScope.launch {
+      _uiState.update { it.copy(isSyncing = true, errorMessage = null) }
+      try {
+        repository.syncWithServer()
+      } catch (e: Exception) {
+        _uiState.update {
+          it.copy(errorMessage = "Sync failed: ${e.message ?: "Network error"}")
+        }
+      } finally {
+        refreshLocalState()
+        _uiState.update { it.copy(isSyncing = false, isLoading = false) }
+      }
+    }
+  }
+
+  fun selectPatient(patientId: String) {
+    viewModelScope.launch {
+      val (summary, visits) = repository.getPatientDetail(patientId)
+      val qJson = _uiState.value.questionnaireJson ?: repository.getAncQuestionnaireJson()
+      _uiState.update {
+        it.copy(
+          selectedPatient = summary,
+          selectedPatientVisits = visits,
+          questionnaireJson = qJson,
+        )
+      }
+    }
+  }
+
+  fun saveQuestionnaireVisit(
+    patientId: String,
+    responseProvider: suspend () -> QuestionnaireResponse,
+    onSaved: () -> Unit,
+  ) {
+    viewModelScope.launch {
+      _uiState.update { it.copy(isSavingVisit = true, errorMessage = null) }
+      try {
+        val qr = responseProvider()
+        val input = repository.parseQuestionnaireResponse(qr)
+        repository.saveAncVisit(patientId, input)
+        refreshLocalState(selectedPatientId = patientId)
+        _uiState.update { it.copy(isSavingVisit = false) }
+        onSaved()
+      } catch (e: kotlin.coroutines.cancellation.CancellationException) {
+        // Validation dialog triggered in DataCapture Questionnaire composable
+        _uiState.update { it.copy(isSavingVisit = false) }
+      } catch (e: Exception) {
+        _uiState.update {
+          it.copy(
+            isSavingVisit = false,
+            errorMessage = "Failed to save visit: ${e.message}",
+          )
+        }
+      }
+    }
+  }
+
+  fun clearError() {
+    _uiState.update { it.copy(errorMessage = null) }
+  }
+
+  private suspend fun refreshLocalState(selectedPatientId: String? = _uiState.value.selectedPatient?.id) {
+    val patients = repository.getPatientSummaries()
+    val qJson = runCatching { repository.getAncQuestionnaireJson() }.getOrNull()
+    if (selectedPatientId != null) {
+      val (summary, visits) = repository.getPatientDetail(selectedPatientId)
+      _uiState.update {
+        it.copy(
+          patients = patients,
+          selectedPatient = summary,
+          selectedPatientVisits = visits,
+          questionnaireJson = qJson ?: it.questionnaireJson,
+        )
+      }
+    } else {
+      _uiState.update {
+        it.copy(
+          patients = patients,
+          questionnaireJson = qJson ?: it.questionnaireJson,
+        )
+      }
+    }
+  }
+}
