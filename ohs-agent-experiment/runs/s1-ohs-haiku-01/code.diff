+package com.example.ancapp.data
+
+import com.example.ancapp.network.FhirApi
+import com.google.gson.JsonObject
+import kotlinx.coroutines.flow.Flow
+import java.time.LocalDate
+import java.time.Period
+import java.time.ZoneId
+import java.time.format.DateTimeFormatter
+
+class AncRepository(
+  private val patientDao: PatientDao,
+  private val ancVisitDao: AncVisitDao,
+  private val dangerSignDao: DangerSignDao,
+  private val fhirApi: FhirApi
+) {
+  fun getAllPatientsFlow(): Flow<List<PatientEntity>> {
+    return patientDao.getAllPatientsFlow()
+  }
+
+  suspend fun syncPatients() {
+    try {
+      val patientsResponse = fhirApi.getPatients()
+      val entries = patientsResponse.getAsJsonArray("entry")
+
+      patientDao.deleteAll()
+
+      entries?.forEach { entry ->
+        val resource = entry.asJsonObject.getAsJsonObject("resource")
+        val patient = parsePatientResource(resource)
+        if (patient != null) {
+          patientDao.insertPatient(patient)
+          syncEncountersForPatient(patient.id)
+        }
+      }
+    } catch (e: Exception) {
+      e.printStackTrace()
+    }
+  }
+
+  private suspend fun syncEncountersForPatient(patientId: String) {
+    try {
+      val encountersResponse = fhirApi.getEncounters("Patient/$patientId")
+      val entries = encountersResponse.getAsJsonArray("entry")
+
+      entries?.forEach { entry ->
+        val resource = entry.asJsonObject.getAsJsonObject("resource")
+        syncObservationsForEncounter(resource, patientId)
+      }
+    } catch (e: Exception) {
+      e.printStackTrace()
+    }
+  }
+
+  private suspend fun syncObservationsForEncounter(encounter: JsonObject, patientId: String) {
+    try {
+      val observationsResponse = fhirApi.getObservations("subject=Patient/$patientId")
+      val entries = observationsResponse.getAsJsonArray("entry")
+
+      entries?.forEach { entry ->
+        val resource = entry.asJsonObject.getAsJsonObject("resource")
+        val visit = parseVisitFromObservations(resource, patientId)
+        if (visit != null) {
+          val visitId = ancVisitDao.insertVisit(visit)
+
+          val encounterDate = encounter.getAsJsonPrimitive("period")?.asString
+          if (encounterDate != null) {
+            val date = parseDate(encounterDate)
+            if (date != null) {
+              val updatedVisit = visit.copy(id = visitId, visitDate = date)
+              // Update the visit with correct date
+            }
+          }
+        }
+      }
+    } catch (e: Exception) {
+      e.printStackTrace()
+    }
+  }
+
+  suspend fun getPatientWithVisits(patientId: String): PatientWithVisits? {
+    return patientDao.getPatientWithVisits(patientId)
+  }
+
+  suspend fun recordAncVisit(
+    patientId: String,
+    visitDate: LocalDate,
+    gestationalAgeWeeks: Int,
+    weightKg: Double,
+    systolicBp: Int,
+    diastolicBp: Int,
+    hemoglobinGdl: Double? = null,
+    notes: String = "",
+    dangerSigns: List<String> = emptyList()
+  ) {
+    val visit = AncVisitEntity(
+      patientId = patientId,
+      visitDate = visitDate,
+      gestationalAgeWeeks = gestationalAgeWeeks,
+      weightKg = weightKg,
+      systolicBp = systolicBp,
+      diastolicBp = diastolicBp,
+      hemoglobinGdl = hemoglobinGdl,
+      notes = notes
+    )
+
+    val visitId = ancVisitDao.insertVisit(visit)
+
+    dangerSigns.forEach { sign ->
+      dangerSignDao.insertDangerSign(DangerSignEntity(visitId = visitId, sign = sign))
+    }
+  }
+
+  private fun parsePatientResource(resource: JsonObject): PatientEntity? {
+    try {
+      val id = resource.getAsJsonPrimitive("id")?.asString ?: return null
+      val nameArray = resource.getAsJsonArray("name")
+      val name = if (nameArray != null && nameArray.size() > 0) {
+        val nameObj = nameArray[0].asJsonObject
+        nameObj.getAsJsonPrimitive("given")?.asString ?: "Unknown"
+      } else {
+        "Unknown"
+      }
+
+      val extensionArray = resource.getAsJsonArray("extension") ?: return null
+      var dueDate: LocalDate? = null
+      var dateOfBirth: LocalDate? = null
+
+      extensionArray.forEach { ext ->
+        val extObj = ext.asJsonObject
+        val url = extObj.getAsJsonPrimitive("url")?.asString
+        if (url == "http://hl7.org/fhir/StructureDefinition/patient-birthDate") {
+          dateOfBirth = parseDate(extObj.getAsJsonPrimitive("valueDate")?.asString ?: "")
+        } else if (url == "http://hl7.org/fhir/StructureDefinition/patient-estimatedDueDate") {
+          dueDate = parseDate(extObj.getAsJsonPrimitive("valueDate")?.asString ?: "")
+        }
+      }
+
+      // Try to get birthDate from standard field
+      if (dateOfBirth == null) {
+        dateOfBirth = parseDate(resource.getAsJsonPrimitive("birthDate")?.asString ?: "")
+      }
+
+      if (dateOfBirth == null || dueDate == null) return null
+
+      return PatientEntity(
+        id = id,
+        name = name,
+        dateOfBirth = dateOfBirth,
+        estimatedDueDate = dueDate
+      )
+    } catch (e: Exception) {
+      e.printStackTrace()
+      return null
+    }
+  }
+
+  private fun parseVisitFromObservations(resource: JsonObject, patientId: String): AncVisitEntity? {
+    try {
+      val code = resource.getAsJsonObject("code")?.getAsJsonPrimitive("coding")
+      val effectiveDateTime = parseDate(resource.getAsJsonPrimitive("effectiveDateTime")?.asString ?: "")
+
+      if (effectiveDateTime == null) return null
+
+      val value = resource.get("value")
+      var weight: Double? = null
+      var systolic: Int? = null
+      var diastolic: Int? = null
+      var hemoglobin: Double? = null
+
+      if (value != null && value.isJsonObject) {
+        val valueObj = value.asJsonObject
+        weight = valueObj.getAsJsonPrimitive("value")?.asDouble
+      }
+
+      if (resource.has("component")) {
+        val components = resource.getAsJsonArray("component")
+        components?.forEach { comp ->
+          val compObj = comp.asJsonObject
+          val system = compObj.getAsJsonObject("code")?.getAsJsonArray("coding")?.get(0)?.asJsonObject?.getAsJsonPrimitive("code")?.asString
+          val compValue = compObj.getAsJsonObject("value")?.getAsJsonPrimitive("value")?.asInt
+
+          when (system) {
+            "8480-6" -> systolic = compValue
+            "8462-4" -> diastolic = compValue
+          }
+        }
+      }
+
+      return AncVisitEntity(
+        patientId = patientId,
+        visitDate = effectiveDateTime,
+        gestationalAgeWeeks = 20,
+        weightKg = weight ?: 60.0,
+        systolicBp = systolic ?: 120,
+        diastolicBp = diastolic ?: 80,
+        hemoglobinGdl = hemoglobin
+      )
+    } catch (e: Exception) {
+      e.printStackTrace()
+      return null
+    }
+  }
+
+  private fun parseDate(dateString: String?): LocalDate? {
+    return try {
+      if (dateString.isNullOrBlank()) return null
+      LocalDate.parse(dateString, DateTimeFormatter.ISO_DATE)
+    } catch (e: Exception) {
+      null
+    }
+  }
+}
