+@Composable
+private fun FormItems(items: List<QItem>, values: MutableMap<String, String>) {
+  items.forEach { item ->
+    when {
+      item.children.isNotEmpty() -> {
+        Text(item.text, style = MaterialTheme.typography.titleMedium)
+        FormItems(item.children, values)
+      }
+      item.type == "choice" -> ChoiceField(item, values)
+      else -> {
+        val hint = if (item.type == "date") " (YYYY-MM-DD)" else ""
+        OutlinedTextField(
+          value = values[item.linkId].orEmpty(),
+          onValueChange = { values[item.linkId] = it },
+          label = { Text(item.text + hint + if (item.required) " *" else "") },
+          keyboardOptions = KeyboardOptions(
+            keyboardType = when (item.type) {
+              "integer" -> KeyboardType.Number
+              "decimal" -> KeyboardType.Decimal
+              else -> KeyboardType.Text
+            },
+          ),
+          singleLine = item.type != "text",
+          modifier = Modifier.fillMaxWidth(),
+        )
+      }
+    }
+  }
+}
+
+@Composable
+private fun ChoiceField(item: QItem, values: MutableMap<String, String>) {
+  val selected = values[item.linkId].orEmpty().split(",").filter { it.isNotBlank() }
+  Text(item.text, style = MaterialTheme.typography.labelLarge)
+  item.options.forEach { opt ->
+    Row(
+      Modifier.fillMaxWidth().clickable { values[item.linkId] = toggle(selected, opt.code).joinToString(",") },
+      verticalAlignment = Alignment.CenterVertically,
+    ) {
+      Checkbox(checked = opt.code in selected, onCheckedChange = null)
+      Text(opt.display)
+    }
+  }
+}
+
+// "none" cannot be combined with a real danger sign
+private fun toggle(selected: List<String>, code: String): List<String> = when {
+  code in selected -> selected - code
+  code == "none" -> listOf(code)
+  else -> selected - "none" + code
+}
+
+// Gestation counts 280 days back from the due date
+private fun gestation(due: LocalDate, today: LocalDate): String {
+  val days = 280 - ChronoUnit.DAYS.between(today, due)
+  return "${days / 7}w ${days % 7}d"
+}
+
+private fun fmt(d: Double): String = d.toString().removeSuffix(".0")
