+internal fun parseFlexibleDateToIso(input: String): String? {
+  if (input.isBlank()) return null
+  // Direct ISO yyyy-MM-dd
+  try {
+    return LocalDate.parse(input, DateTimeFormatter.ISO_LOCAL_DATE).toString()
+  } catch (_: Exception) {}
+
+  // yyyy-M-d or yyyy/M/d
+  val dashOrSlashParts = input.split('-', '/')
+  if (dashOrSlashParts.size == 3) {
+    val p0 = dashOrSlashParts[0].toIntOrNull()
+    val p1 = dashOrSlashParts[1].toIntOrNull()
+    val p2 = dashOrSlashParts[2].toIntOrNull()
+    if (p0 != null && p1 != null && p2 != null) {
+      try {
+        if (p0 > 1900) {
+          return LocalDate.of(p0, p1, p2).toString()
+        } else if (p2 > 1900) {
+          // MM/dd/yyyy or dd/MM/yyyy
+          return if (p0 > 12) {
+            LocalDate.of(p2, p1, p0).toString()
+          } else {
+            LocalDate.of(p2, p0, p1).toString()
+          }
+        }
+      } catch (_: Exception) {}
+    }
+  }
+  return null
+}
