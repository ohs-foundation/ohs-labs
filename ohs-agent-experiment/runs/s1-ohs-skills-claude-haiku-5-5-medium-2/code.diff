@@ -0,0 +1,248 @@
+package com.example.ancapp
+
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import java.net.HttpURLConnection
+import java.net.URL
+import java.time.LocalDate
+import java.util.UUID
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonElement
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.contentOrNull
+import kotlinx.serialization.json.doubleOrNull
+import kotlinx.serialization.json.encodeToJsonElement
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.put
+import kotlinx.serialization.json.putJsonArray
+import kotlinx.serialization.json.putJsonObject
+
+// Android emulator's alias for the host machine (cleartext allowed in the manifest).
+private const val FHIR_BASE = "http://10.0.2.2:8080/fhir"
+private const val LOINC = "http://loinc.org"
+private const val ANC_SYSTEM = "urn:example:anc"
+private const val PREGNANCY_DAYS = 280L
+
+private val fhirJson = Json { explicitNulls = false; encodeDefaults = false }
+
+data class Patient(val id: String, val name: String, val birthDate: LocalDate?)
+
+data class Pregnancy(val patient: Patient, val dueDate: LocalDate)
+
+data class Visit(
+  val date: LocalDate,
+  val weightKg: Double?,
+  val systolic: Double?,
+  val diastolic: Double?,
+  val hemoglobin: Double?,
+  val gestationalWeeks: Double?,
+  val dangerSigns: List<String>,
+  val notes: String?,
+)
+
+/** Gestational age in days, from the estimated due date (EDD = 280 days after LMP). */
+fun Pregnancy.gestationDays(today: LocalDate): Long = PREGNANCY_DAYS - (dueDate.toEpochDay() - today.toEpochDay())
+
+fun fetchQuestionnaire(): String = call("GET", "/Questionnaire/anc-contact").toString()
+
+/** Patients whose estimated due date (LOINC 11778-8) is today or later, soonest first. */
+fun fetchRegister(today: LocalDate): List<Pregnancy> {
+  val resources = call("GET", "/Observation?code=11778-8&_include=Observation:subject&_count=500").resources()
+  val patients = resources.filter { it.text("resourceType") == "Patient" }
+    .associate { it.text("id")!! to it.toPatient() }
+  val dueByPatient = resources.filter { it.text("resourceType") == "Observation" }
+    .sortedBy { it.text("effectiveDateTime") } // later EDD observations override earlier ones
+    .associate { obs -> obs.refId("subject").orEmpty() to LocalDate.parse(obs.text("valueDateTime")!!.take(10)) }
+  return dueByPatient.mapNotNull { (id, due) ->
+    patients[id]?.takeIf { due >= today }?.let { Pregnancy(it, due) }
+  }.sortedBy { it.dueDate }
+}
+
+fun fetchVisits(patientId: String): List<Visit> {
+  val resources = call("GET", "/Encounter?subject=Patient/$patientId&_revinclude=Observation:encounter&_count=500").resources()
+  val obsByEncounter = resources.filter { it.text("resourceType") == "Observation" }.groupBy { it.refId("encounter") }
+  return resources.filter { it.text("resourceType") == "Encounter" }.map { enc ->
+    val obs = obsByEncounter[enc.text("id")].orEmpty()
+    fun value(code: String) = obs.firstOrNull { code in it.codes() }
+    fun bpComponent(code: String) = value(BP_CODE)?.get("component").arr()
+      .firstOrNull { code in it.codes() }.obj()?.quantity()
+    Visit(
+      date = LocalDate.parse(enc["period"].obj()!!["start"].text()!!.take(10)),
+      weightKg = value(WEIGHT_CODE)?.quantity(),
+      systolic = bpComponent(SYSTOLIC_CODE),
+      diastolic = bpComponent(DIASTOLIC_CODE),
+      hemoglobin = value(HB_CODE)?.quantity(),
+      gestationalWeeks = value(GA_CODE)?.quantity(),
+      dangerSigns = value("danger-signs")?.get("valueCodeableConcept").obj()?.get("coding")
+        .arr().mapNotNull { it.obj()?.get("display").text() },
+      notes = value("notes")?.get("valueString").text(),
+    )
+  }.sortedByDescending { it.date }
+}
+
+/**
+ * Saves one ANC visit as an atomic transaction: an Encounter plus one Observation per
+ * recorded measurement, all linked to the Encounter via its urn:uuid.
+ */
+fun saveVisit(patientId: String, response: QuestionnaireResponse) {
+  val answers = mutableMapOf<String, List<JsonObject>>()
+  collectAnswers(fhirJson.encodeToJsonElement(response).obj()!!["item"].arr(), answers)
+  fun answer(linkId: String) = answers[linkId]?.firstOrNull()
+
+  val date = answer("visit-date")?.get("valueDate").text() ?: error("Visit date is missing")
+  val subject = "Patient/$patientId"
+  val encounterUrn = "urn:uuid:${UUID.randomUUID()}"
+  fun obs(codes: List<JsonObject>, field: Pair<String, JsonElement>) = entry(
+    "Observation",
+    buildJsonObject {
+      put("resourceType", "Observation")
+      put("status", "final")
+      put("code", codeable(codes))
+      put("subject", reference(subject))
+      put("encounter", reference(encounterUrn))
+      put("effectiveDateTime", date)
+      put(field.first, field.second)
+    },
+  )
+
+  val entries = mutableListOf<JsonObject>(
+    entry(
+      "Encounter",
+      buildJsonObject {
+        put("resourceType", "Encounter")
+        put("status", "finished")
+        put("class", coding("http://terminology.hl7.org/CodeSystem/v3-ActCode", "AMB", "ambulatory"))
+        putJsonArray("type") { add(buildJsonObject { put("text", "Antenatal care contact") }) }
+        put("subject", reference(subject))
+        put("period", buildJsonObject { put("start", date); put("end", date) })
+      },
+      fullUrl = encounterUrn,
+    ),
+  )
+  answer("weight")?.get("valueDecimal").num()?.let {
+    entries += obs(listOf(coding(LOINC, WEIGHT_CODE, "Body weight")), "valueQuantity" to quantity(it, "kg", "kg"))
+  }
+  val systolic = answer("bp-systolic")?.get("valueInteger").num()
+  val diastolic = answer("bp-diastolic")?.get("valueInteger").num()
+  if (systolic != null && diastolic != null) {
+    entries += obs(
+      listOf(coding(LOINC, BP_CODE, "Blood pressure panel")),
+      "component" to JsonArray(
+        listOf(
+          component(SYSTOLIC_CODE, "Systolic blood pressure", systolic),
+          component(DIASTOLIC_CODE, "Diastolic blood pressure", diastolic),
+        ),
+      ),
+    )
+  }
+  answer("gestational-age")?.get("valueInteger").num()?.let {
+    entries += obs(listOf(coding(LOINC, GA_CODE, "Gestational age")), "valueQuantity" to quantity(it, "wk", "wk"))
+  }
+  val dangerSigns = answers["danger-signs"].orEmpty().mapNotNull { it["valueCoding"].obj() }
+  if (dangerSigns.isNotEmpty()) {
+    entries += obs(listOf(coding(ANC_SYSTEM, "danger-signs", "Danger signs")), "valueCodeableConcept" to codeable(dangerSigns))
+  }
+  answer("notes")?.get("valueString").text()?.takeIf { it.isNotBlank() }?.let {
+    entries += obs(listOf(coding(ANC_SYSTEM, "notes", "Clinical notes")), "valueString" to JsonPrimitive(it))
+  }
+
+  call("POST", "", buildJsonObject {
+    put("resourceType", "Bundle")
+    put("type", "transaction")
+    put("entry", JsonArray(entries))
+  })
+}
+
+private const val WEIGHT_CODE = "29463-7"
+private const val BP_CODE = "85354-9"
+private const val SYSTOLIC_CODE = "8480-6"
+private const val DIASTOLIC_CODE = "8462-4"
+private const val HB_CODE = "718-7"
+private const val GA_CODE = "18185-9"
+
+private fun call(method: String, path: String, body: JsonObject? = null): JsonObject {
+  val conn = URL(FHIR_BASE + path).openConnection() as HttpURLConnection
+  conn.requestMethod = method
+  conn.setRequestProperty("Accept", "application/fhir+json")
+  if (body != null) {
+    conn.doOutput = true
+    conn.setRequestProperty("Content-Type", "application/fhir+json")
+    conn.outputStream.use { it.write(body.toString().toByteArray()) }
+  }
+  val code = conn.responseCode
+  val text = (if (code < 400) conn.inputStream else conn.errorStream).bufferedReader().use { it.readText() }
+  check(code < 400) { "FHIR $method $path failed (HTTP $code): ${text.take(300)}" }
+  return fhirJson.parseToJsonElement(text).jsonObject
+}
+
+private fun collectAnswers(items: List<JsonElement>, out: MutableMap<String, List<JsonObject>>) {
+  for (item in items) {
+    val o = item.obj() ?: continue
+    val answers = o["answer"].arr().mapNotNull { it.obj() }
+    o["linkId"].text()?.let { out[it] = answers }
+    collectAnswers(o["item"].arr(), out)
+    answers.forEach { collectAnswers(it["item"].arr(), out) }
+  }
+}
+
+private fun JsonObject.resources(): List<JsonObject> = this["entry"].arr().mapNotNull { it.obj()?.get("resource").obj() }
+
+private fun JsonObject.toPatient(): Patient {
+  val name = this["name"].arr().firstOrNull().obj()
+  return Patient(
+    id = text("id")!!,
+    name = listOfNotNull(name?.get("given").arr().joinToString(" ") { it.text().orEmpty() }, name?.get("family").text())
+      .joinToString(" ").trim(),
+    birthDate = text("birthDate")?.let { LocalDate.parse(it) },
+  )
+}
+
+private fun JsonObject.refId(key: String): String? = this[key].obj()?.get("reference").text()?.substringAfter("/")
+
+private fun JsonObject.quantity(key: String = "valueQuantity"): Double? = this[key].obj()?.get("value").num()
+
+private fun JsonObject.text(key: String): String? = this[key].text()
+
+/** Coding codes of a CodeableConcept-bearing element (an Observation or a component). */
+private fun JsonElement?.codes(): List<String> = this.obj()?.get("code").obj()?.get("coding").arr()
+  .mapNotNull { it.obj()?.get("code").text() }
+
+private fun JsonElement?.obj(): JsonObject? = this as? JsonObject
+
+private fun JsonElement?.arr(): List<JsonElement> = (this as? JsonArray).orEmpty()
+
+private fun JsonElement?.text(): String? = (this as? JsonPrimitive)?.contentOrNull
+
+private fun JsonElement?.num(): Double? = (this as? JsonPrimitive)?.doubleOrNull
+
+private fun entry(type: String, resource: JsonObject, fullUrl: String = "urn:uuid:${UUID.randomUUID()}") = buildJsonObject {
+  put("fullUrl", fullUrl)
+  put("resource", resource)
+  putJsonObject("request") { put("method", "POST"); put("url", type) }
+}
+
+private fun coding(system: String, code: String, display: String) = buildJsonObject {
+  put("system", system)
+  put("code", code)
+  put("display", display)
+}
+
+private fun codeable(codings: List<JsonObject>) = buildJsonObject {
+  putJsonArray("coding") { codings.forEach { add(it) } }
+}
+
+private fun quantity(value: Double, unit: String, code: String) = buildJsonObject {
+  put("value", value)
+  put("unit", unit)
+  put("system", "http://unitsofmeasure.org")
+  put("code", code)
+}
+
+private fun component(code: String, display: String, value: Double) = buildJsonObject {
+  put("code", codeable(listOf(coding(LOINC, code, display))))
+  put("valueQuantity", quantity(value, "mmHg", "mm[Hg]"))
+}
+
+private fun reference(ref: String) = buildJsonObject { put("reference", ref) }
