+@Composable
+private fun DangerSignOptionChip(
+  sign: DangerSign,
+  selected: Boolean,
+  onClick: () -> Unit
+) {
+  val isWarningSign = sign != DangerSign.NONE && selected
+  Surface(
+    shape = RoundedCornerShape(8.dp),
+    color = when {
+      isWarningSign -> MaterialTheme.colorScheme.errorContainer
+      selected -> MaterialTheme.colorScheme.primaryContainer
+      else -> MaterialTheme.colorScheme.background
+    },
+    border = BorderStroke(
+      width = 1.dp,
+      color = when {
+        isWarningSign -> MaterialTheme.colorScheme.error
+        selected -> MaterialTheme.colorScheme.primary
+        else -> MaterialTheme.colorScheme.surfaceVariant
+      }
+    ),
+    modifier = Modifier
+      .clickable(role = Role.Checkbox, onClick = onClick)
+      .testTag("danger_sign_${sign.name.lowercase()}")
+  ) {
+    Row(
+      modifier = Modifier.padding(horizontal = 10.dp, vertical = 6.dp),
+      verticalAlignment = Alignment.CenterVertically
+    ) {
+      Checkbox(
+        checked = selected,
+        onCheckedChange = null,
+        modifier = Modifier.size(20.dp)
+      )
+      Spacer(modifier = Modifier.width(6.dp))
+      Text(
+        text = sign.label,
+        style = MaterialTheme.typography.bodyMedium,
+        fontWeight = if (selected) FontWeight.SemiBold else FontWeight.Normal,
+        color = when {
+          isWarningSign -> MaterialTheme.colorScheme.onErrorContainer
+          selected -> MaterialTheme.colorScheme.onPrimaryContainer
+          else -> MaterialTheme.colorScheme.onSurface
+        }
+      )
+    }
+  }
+}
+
+private fun parseFlexibleDate(rawInput: String): LocalDate? {
+  val trimmed = rawInput.trim()
+  if (trimmed.isEmpty()) return null
+
+  // If user appended onto existing ISO date (e.g. "2026-11-022026-09-15" from automated text input without clearing)
+  val isoRegex = Regex("""\d{4}-\d{2}-\d{2}""")
+  val allIsoMatches = isoRegex.findAll(trimmed).toList()
+  if (allIsoMatches.isNotEmpty()) {
+    val lastIso = allIsoMatches.last().value
+    runCatching { return LocalDate.parse(lastIso) }
+  }
+
+  val formats = listOf(
+    DateTimeFormatter.ISO_LOCAL_DATE,
+    DateTimeFormatter.ofPattern("yyyy/M/d"),
+    DateTimeFormatter.ofPattern("M/d/yyyy"),
+    DateTimeFormatter.ofPattern("d/M/yyyy")
+  )
+  for (formatter in formats) {
+    runCatching { return LocalDate.parse(trimmed, formatter) }
+  }
+  return null
+}
