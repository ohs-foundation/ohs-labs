index 0000000..2fe2fa3
--- /dev/null
+++ b/app/src/main/java/com/example/ancapp/Fhir.kt
@@ -0,0 +1,159 @@
+package com.example.ancapp
+
+import java.net.HttpURLConnection
+import java.net.URL
+import java.time.LocalDate
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+import org.json.JSONArray
+import org.json.JSONObject
+
+const val BASE = "http://10.0.2.2:8080/fhir"
+
+data class Patient(val id: String, val name: String, val birth: LocalDate, val edd: LocalDate?) {
+  val age get() = ChronoUnit.YEARS.between(birth, LocalDate.now())
+  // 40 weeks at EDD; ponytail: assumes a 280-day term, no dating-scan adjustments
+  val weeks get() = edd?.let { (280 - ChronoUnit.DAYS.between(LocalDate.now(), it)) / 7 }
+}
+
+data class Visit(val date: String, val weight: String?, val bp: String?, val hb: String?)
+
+private fun call(method: String, url: String, body: String? = null): JSONObject {
+  val c = URL(url).openConnection() as HttpURLConnection
+  c.requestMethod = method
+  c.connectTimeout = 8000
+  c.readTimeout = 15000
+  c.setRequestProperty("Accept", "application/fhir+json")
+  if (body != null) {
+    c.doOutput = true
+    c.setRequestProperty("Content-Type", "application/fhir+json")
+    c.outputStream.use { it.write(body.toByteArray()) }
+  }
+  val stream = if (c.responseCode in 200..299) c.inputStream else c.errorStream
+  val text = stream.bufferedReader().use { it.readText() }
+  if (c.responseCode !in 200..299) error("HTTP ${c.responseCode}: ${text.take(300)}")
+  return JSONObject(text)
+}
+
+/** All entries of a search, following `next` links. */
+private fun search(query: String): List<JSONObject> {
+  val out = mutableListOf<JSONObject>()
+  var url: String? = "$BASE/$query"
+  while (url != null) {
+    val b = call("GET", url)
+    val es = b.optJSONArray("entry") ?: JSONArray()
+    for (i in 0 until es.length()) out += es.getJSONObject(i).getJSONObject("resource")
+    val links = b.optJSONArray("link") ?: JSONArray()
+    url = (0 until links.length()).map { links.getJSONObject(it) }
+      .firstOrNull { it.getString("relation") == "next" }?.getString("url")
+      ?.replace(Regex("^https?://[^/]+(/fhir)?"), BASE.removeSuffix("/fhir")+"/fhir")
+  }
+  return out
+}
+
+private fun JSONObject.coding() = optJSONObject("code")?.optJSONArray("coding")?.optJSONObject(0)?.optString("code")
+private fun JSONObject.qty() = optJSONObject("valueQuantity")?.optDouble("value")
+private fun fmt(d: Double) = d.toString().removeSuffix(".0")
+
+fun loadPatients(): List<Patient> {
+  val edds = search("Observation?code=11778-8&_count=100").associate {
+    it.getJSONObject("subject").getString("reference").substringAfter('/') to
+      LocalDate.parse(it.getString("valueDateTime").take(10))
+  }
+  return search("Patient?_count=100").map {
+    val n = it.getJSONArray("name").getJSONObject(0)
+    val id = it.getString("id")
+    Patient(id, n.getJSONArray("given").getString(0) + " " + n.getString("family"),
+      LocalDate.parse(it.getString("birthDate")), edds[id])
+  }.sortedBy { it.edd ?: LocalDate.MAX }
+}
+
+fun loadVisits(patientId: String): List<Visit> {
+  val obs = search("Observation?subject=Patient/$patientId&_count=100")
+  val encs = search("Encounter?subject=Patient/$patientId&_count=100")
+  return encs.map { e ->
+    val mine = obs.filter { it.optJSONObject("encounter")?.getString("reference")?.substringAfter('/') == e.getString("id") }
+    fun byCode(c: String) = mine.firstOrNull { it.coding() == c }
+    val comps = byCode("85354-9")?.getJSONArray("component")?.let { a -> (0 until a.length()).map { a.getJSONObject(it) } }
+    fun comp(c: String) = comps?.firstOrNull { it.coding() == c }?.qty()?.let(::fmt)
+    Visit(
+      e.getJSONObject("period").getString("start").take(10),
+      byCode("29463-7")?.qty()?.let { "${fmt(it)} kg" },
+      if (comp("8480-6") != null) "${comp("8480-6")}/${comp("8462-4")}" else null,
+      byCode("718-7")?.qty()?.let { "${fmt(it)} g/dL" },
+    )
+  }.sortedByDescending { it.date }
+}
+
+fun loadQuestionnaire(): JSONObject = call("GET", "$BASE/Questionnaire/anc-contact")
+
+/** Form answers keyed by linkId: scalar text, or selected choice codes joined by ','. */
+fun saveVisit(q: JSONObject, patientId: String, a: Map<String, String>) {
+  val subject = JSONObject().put("reference", "Patient/$patientId")
+  val date = a.getValue("visit-date")
+  val encRef = "urn:uuid:${UUID.randomUUID()}"
+  fun entry(res: JSONObject, ref: String? = null) = JSONObject()
+    .put("fullUrl", ref ?: "urn:uuid:${UUID.randomUUID()}").put("resource", res)
+    .put("request", JSONObject().put("method", "POST").put("url", res.getString("resourceType")))
+  fun obs(loinc: String, text: String) = JSONObject().put("resourceType", "Observation").put("status", "final")
+    .put("code", JSONObject().put("coding", JSONArray().put(JSONObject().put("system", "http://loinc.org").put("code", loinc))).put("text", text))
+    .put("subject", subject).put("encounter", JSONObject().put("reference", encRef)).put("effectiveDateTime", date)
+  fun quantity(v: String, unit: String) = JSONObject().put("value", v.toDouble()).put("unit", unit)
+    .put("system", "http://unitsofmeasure.org").put("code", unit)
+
+  val enc = JSONObject().put("resourceType", "Encounter").put("status", "finished")
+    .put("class", JSONObject().put("system", "http://terminology.hl7.org/CodeSystem/v3-ActCode").put("code", "AMB"))
+    .put("type", JSONArray().put(JSONObject().put("text", "Antenatal care contact")))
+    .put("subject", subject).put("period", JSONObject().put("start", date).put("end", date))
+  val entries = JSONArray().put(entry(enc, encRef))
+  a["weight"]?.takeIf { it.isNotBlank() }?.let {
+    entries.put(entry(obs("29463-7", "Body weight").put("valueQuantity", quantity(it, "kg"))))
+  }
+  val sys = a["bp-systolic"]?.takeIf { it.isNotBlank() }
+  val dia = a["bp-diastolic"]?.takeIf { it.isNotBlank() }
+  if (sys != null && dia != null) {
+    fun comp(c: String, v: String) = JSONObject()
+      .put("code", JSONObject().put("coding", JSONArray().put(JSONObject().put("system", "http://loinc.org").put("code", c))))
+      .put("valueQuantity", quantity(v, "mm[Hg]"))
+    entries.put(entry(obs("85354-9", "Blood pressure")
+      .put("component", JSONArray().put(comp("8480-6", sys)).put(comp("8462-4", dia)))))
+  }
+
+  // QuestionnaireResponse mirrors the Questionnaire's item tree.
+  fun answers(items: JSONArray): JSONArray {
+    val out = JSONArray()
+    for (i in 0 until items.length()) {
+      val it = items.getJSONObject(i)
+      val id = it.getString("linkId")
+      val r = JSONObject().put("linkId", id).put("text", it.optString("text"))
+      when (it.getString("type")) {
+        "group" -> r.put("item", answers(it.getJSONArray("item")))
+        else -> {
+          val v = a[id]?.takeIf { s -> s.isNotBlank() } ?: continue
+          val ans = JSONArray()
+          when (it.getString("type")) {
+            "date" -> ans.put(JSONObject().put("valueDate", v))
+            "integer" -> ans.put(JSONObject().put("valueInteger", v.toInt()))
+            "decimal" -> ans.put(JSONObject().put("valueDecimal", v.toDouble()))
+            "choice" -> {
+              val opts = it.getJSONArray("answerOption")
+              val coding = (0 until opts.length()).map { k -> opts.getJSONObject(k).getJSONObject("valueCoding") }
+              v.split(',').forEach { c -> ans.put(JSONObject().put("valueCoding", coding.first { x -> x.getString("code") == c })) }
+            }
+            else -> ans.put(JSONObject().put("valueString", v))
+          }
+          r.put("answer", ans)
+        }
+      }
+      out.put(r)
+    }
+    return out
+  }
+  val qr = JSONObject().put("resourceType", "QuestionnaireResponse").put("status", "completed")
+    .put("questionnaire", q.optString("url", "Questionnaire/anc-contact"))
+    .put("subject", subject).put("encounter", JSONObject().put("reference", encRef))
+    .put("authored", date).put("item", answers(q.getJSONArray("item")))
+  entries.put(entry(qr))
+
+  call("POST", BASE, JSONObject().put("resourceType", "Bundle").put("type", "transaction").put("entry", entries).toString())
+}
