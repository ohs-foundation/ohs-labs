@@ -0,0 +1,207 @@
+package com.example.ancapp
+
+import android.app.Application
+import androidx.lifecycle.AndroidViewModel
+import androidx.lifecycle.viewModelScope
+import com.ionspin.kotlin.bignum.decimal.BigDecimal
+import dev.ohs.fhir.engine.FhirEngineProvider
+import dev.ohs.fhir.engine.get
+import dev.ohs.fhir.engine.search.ReferenceClientParam
+import dev.ohs.fhir.engine.search.Search
+import dev.ohs.fhir.engine.sync.CurrentSyncJobStatus
+import dev.ohs.fhir.engine.sync.Sync
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.CodeableConcept
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.Decimal
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Enumeration
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Patient
+import dev.ohs.fhir.model.r4.Period
+import dev.ohs.fhir.model.r4.Quantity
+import dev.ohs.fhir.model.r4.Questionnaire
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import dev.ohs.fhir.model.r4.Reference
+import dev.ohs.fhir.model.r4.Uri
+import dev.ohs.fhir.model.r4.Annotation
+import dev.ohs.fhir.model.r4.Markdown
+import dev.ohs.fhir.model.r4.terminologies.ResourceType
+import java.time.LocalDate
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.catch
+import kotlinx.coroutines.flow.transformWhile
+import kotlinx.coroutines.launch
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import dev.ohs.fhir.model.r4.DateTime as FhirDateTimeEl
+import dev.ohs.fhir.model.r4.FhirDateTime
+import dev.ohs.fhir.model.r4.String as FhirString
+
+data class PatientRow(val id: String, val name: String, val age: Int?, val edd: LocalDate?, val weeks: Int?)
+
+data class VisitRow(val date: String, val weight: String?, val bp: String?, val hb: String?)
+
+private const val LOINC = "http://loinc.org"
+private const val EDD = "11778-8"
+private const val HB = "718-7"
+private const val WEIGHT = "29463-7"
+private const val BP_PANEL = "85354-9"
+private const val SYS = "8480-6"
+private const val DIA = "8462-4"
+private const val GA = "11884-4"
+private const val DANGER = "danger-signs"
+
+private val json = Json { explicitNulls = false; encodeDefaults = false }
+
+private fun Observation.has(code: String) = this.code.coding.any { it.code?.value == code }
+private fun Observation.qty() = value?.asQuantity()?.value?.value?.value?.toPlainString()
+private fun Observation.encounterId() = encounter?.reference?.value?.substringAfter("/")
+private fun Observation.date() = effective?.asDateTime()?.value?.value?.toString()?.substringBefore("T")
+
+class AncViewModel(app: Application) : AndroidViewModel(app) {
+  private val engine = FhirEngineProvider.getInstance(app)
+  val patients = MutableStateFlow<List<PatientRow>>(emptyList())
+  val visits = MutableStateFlow<List<VisitRow>>(emptyList())
+  val syncState = MutableStateFlow("")
+  val questionnaireJson = MutableStateFlow<String?>(null)
+  private var syncJob: Job? = null
+
+  init {
+    refresh()
+    syncNow()
+  }
+
+  private fun CurrentSyncJobStatus.isFinal() =
+    this is CurrentSyncJobStatus.Succeeded || this is CurrentSyncJobStatus.Failed || this is CurrentSyncJobStatus.Cancelled
+
+  fun syncNow() {
+    if (syncJob?.isActive == true) return
+    syncJob = viewModelScope.launch {
+      Sync.oneTimeSync<AppSyncWorker>(getApplication())
+        .transformWhile { emit(it); !it.isFinal() }
+        .catch { syncState.value = "Sync status unknown" }
+        .collect {
+          syncState.value = when (it) {
+            is CurrentSyncJobStatus.Succeeded -> "Synced"
+            is CurrentSyncJobStatus.Failed -> "Sync failed, will retry later"
+            is CurrentSyncJobStatus.Running -> "Syncing…"
+            else -> syncState.value
+          }
+          if (it is CurrentSyncJobStatus.Succeeded) refresh()
+        }
+    }
+  }
+
+  fun refresh() {
+    viewModelScope.launch {
+      val edds = engine.search<Observation>(Search(ResourceType.Observation)).map { it.resource }
+        .filter { it.has(EDD) }
+        .associate { it.subject?.reference?.value?.substringAfter("/") to it.value?.asDateTime()?.value?.value?.toString()?.substringBefore("T") }
+      val today = LocalDate.now()
+      patients.value = engine.search<Patient>(Search(ResourceType.Patient)).map { it.resource }.map { p ->
+        val name = p.name.firstOrNull()
+        val edd = edds[p.id]?.let { runCatching { LocalDate.parse(it) }.getOrNull() }
+        PatientRow(
+          p.id.orEmpty(),
+          listOfNotNull(name?.given?.mapNotNull { it.value }?.joinToString(" "), name?.family?.value).joinToString(" "),
+          p.birthDate?.value?.toString()?.let { runCatching { ChronoUnit.YEARS.between(LocalDate.parse(it), today).toInt() }.getOrNull() },
+          edd,
+          edd?.let { 40 - (ChronoUnit.DAYS.between(today, it) / 7).toInt() },
+        )
+      }.sortedBy { it.edd ?: LocalDate.MAX }
+      engine.runCatching { get<Questionnaire>("anc-contact") }.getOrNull()?.let {
+        questionnaireJson.value = json.encodeToString(it)
+      }
+    }
+  }
+
+  fun loadVisits(patientId: String) {
+    viewModelScope.launch {
+      val subject = "Patient/$patientId"
+      val encounters = engine.search<Encounter>(Search(ResourceType.Encounter).apply {
+        filter(ReferenceClientParam("subject"), { value = subject })
+      }).map { it.resource }
+      val obs = engine.search<Observation>(Search(ResourceType.Observation).apply {
+        filter(ReferenceClientParam("subject"), { value = subject })
+      }).map { it.resource }.groupBy { it.encounterId() }
+      visits.value = encounters.map { e ->
+        val o = obs[e.id].orEmpty()
+        val bp = o.firstOrNull { it.has(BP_PANEL) }?.component?.associate { c ->
+          c.code.coding.firstOrNull()?.code?.value to c.value?.asQuantity()?.value?.value?.value?.toPlainString()
+        }
+        VisitRow(
+          e.period?.start?.value?.toString()?.substringBefore("T").orEmpty(),
+          o.firstOrNull { it.has(WEIGHT) }?.qty(),
+          bp?.let { "${it[SYS]}/${it[DIA]}" },
+          o.firstOrNull { it.has(HB) }?.qty(),
+        )
+      }.sortedByDescending { it.date }
+    }
+  }
+
+  /** Maps the submitted QuestionnaireResponse to an Encounter + Observations and saves locally. */
+  suspend fun saveVisit(patientId: String, response: QuestionnaireResponse) {
+    val a = mutableMapOf<String, MutableList<QuestionnaireResponse.Item.Answer>>()
+    fun walk(items: List<QuestionnaireResponse.Item>): Unit = items.forEach { i ->
+      i.linkId.value?.let { a.getOrPut(it) { mutableListOf() }.addAll(i.answer) }
+      walk(i.item)
+      i.answer.forEach { walk(it.item) }
+    }
+    walk(response.item)
+    val date = a["visit-date"]?.firstOrNull()?.value?.asDate()?.value?.value?.toString() ?: LocalDate.now().toString()
+    val ga = a["gestational-age"]?.firstOrNull()?.value?.asInteger()?.value?.value
+    val weight = a["weight"]?.firstOrNull()?.value?.asDecimal()?.value?.value
+    val sys = a["bp-systolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+    val dia = a["bp-diastolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+    val signs = a["danger-signs"].orEmpty().mapNotNull { it.value?.asCoding()?.value }
+    val notes = a["notes"]?.firstOrNull()?.value?.asString()?.value?.value
+
+    val subject = Reference(reference = FhirString(value = "Patient/$patientId"))
+    val encId = UUID.randomUUID().toString()
+    val encRef = Reference(reference = FhirString(value = "Encounter/$encId"))
+    val when_ = Observation.Effective.DateTime(FhirDateTimeEl(value = FhirDateTime.fromString(date)))
+    fun loinc(code: String, display: String) =
+      CodeableConcept(coding = listOf(Coding(system = Uri(value = LOINC), code = Code(value = code), display = FhirString(value = display))))
+    fun obs(code: CodeableConcept, block: Observation.Builder.() -> Unit = {}) = Observation(
+      id = UUID.randomUUID().toString(),
+      status = Enumeration(value = Observation.ObservationStatus.Final),
+      code = code, subject = subject, encounter = encRef, effective = when_,
+    ).toBuilder().apply(block).build()
+    fun qty(v: BigDecimal, unit: String, ucum: String) = Quantity(
+      value = Decimal(value = v), unit = FhirString(value = unit),
+      system = Uri(value = "http://unitsofmeasure.org"), code = Code(value = ucum),
+    )
+
+    val list = mutableListOf<Observation>()
+    weight?.let { list += obs(loinc(WEIGHT, "Body weight")) { value = Observation.Value.Quantity(qty(it, "kg", "kg")) } }
+    if (sys != null && dia != null) list += obs(loinc(BP_PANEL, "Blood pressure panel")) {
+      component = mutableListOf(
+        Observation.Component(code = loinc(SYS, "Systolic blood pressure"),
+          value = Observation.Component.Value.Quantity(qty(BigDecimal.fromInt(sys), "mmHg", "mm[Hg]"))),
+        Observation.Component(code = loinc(DIA, "Diastolic blood pressure"),
+          value = Observation.Component.Value.Quantity(qty(BigDecimal.fromInt(dia), "mmHg", "mm[Hg]"))),
+      ).map { it.toBuilder() }.toMutableList()
+    }
+    ga?.let { list += obs(loinc(GA, "Gestational age")) { value = Observation.Value.Integer(dev.ohs.fhir.model.r4.Integer(value = it)) } }
+    if (signs.isNotEmpty() || !notes.isNullOrBlank()) list += obs(CodeableConcept(text = FhirString(value = "Danger signs"),
+      coding = listOf(Coding(code = Code(value = DANGER))))) {
+      if (signs.isNotEmpty()) value = Observation.Value.CodeableConcept(CodeableConcept(coding = signs))
+      if (!notes.isNullOrBlank()) note = mutableListOf(Annotation(text = Markdown(value = notes)).toBuilder())
+    }
+
+    val encounter = Encounter(
+      id = encId,
+      status = Enumeration(value = Encounter.EncounterStatus.Finished),
+      `class` = Coding(system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"), code = Code(value = "AMB")),
+      subject = subject,
+      period = Period(start = FhirDateTimeEl(value = FhirDateTime.fromString(date)), end = FhirDateTimeEl(value = FhirDateTime.fromString(date))),
+    )
+    engine.create(encounter, *list.toTypedArray())
+    syncNow()
+    loadVisits(patientId)
+  }
+}
