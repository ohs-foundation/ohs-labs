+package com.example.ancapp.ui
+
+import java.time.LocalDate
+import java.time.format.DateTimeFormatter
+import java.util.Locale
+
+private val dayMonthYear: DateTimeFormatter
+  get() = DateTimeFormatter.ofPattern("d MMM yyyy", Locale.getDefault())
+
+/** e.g. `5 Dec 2026`. */
+fun LocalDate.formatLong(): String = format(dayMonthYear)
+
+/** Trims the pointless decimal: `72.0` -> `72`, `68.5` -> `68.5`. */
+fun Double.trimDecimal(): String =
+  if (this == this.toLong().toDouble()) this.toLong().toString()
+  else String.format(Locale.getDefault(), "%.1f", this)
