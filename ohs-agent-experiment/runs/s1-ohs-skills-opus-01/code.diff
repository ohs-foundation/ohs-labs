+package com.example.ancapp.data
+
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.CodeableConcept
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.Uri
+import dev.ohs.fhir.model.r4.String as FhirString
+
+const val LOINC = "http://loinc.org"
+const val UCUM = "http://unitsofmeasure.org"
+const val OBSERVATION_CATEGORY = "http://terminology.hl7.org/CodeSystem/observation-category"
+
+/** Codes the register and the visit list key off. */
+object AncCodes {
+  const val ESTIMATED_DUE_DATE = "11778-8"
+  const val BODY_WEIGHT = "29463-7"
+  const val BP_PANEL = "85354-9"
+  const val BP_SYSTOLIC = "8480-6"
+  const val BP_DIASTOLIC = "8462-4"
+  const val HEMOGLOBIN = "718-7"
+  const val GESTATIONAL_AGE = "49051-6"
+
+  /** Local codes for the parts of the ANC form with no obvious LOINC equivalent. */
+  const val LOCAL_SYSTEM = "urn:example:anc-observations"
+  const val DANGER_SIGN = "danger-sign"
+  const val VISIT_NOTE = "visit-note"
+}
+
+const val QUESTIONNAIRE_ID = "anc-contact"
+const val QUESTIONNAIRE_URL = "http://example.org/fhir/Questionnaire/anc-contact"
+
+fun loinc(code: String, display: String) =
+  CodeableConcept(
+    coding =
+      listOf(
+        Coding(
+          system = Uri(value = LOINC),
+          code = Code(value = code),
+          display = FhirString(value = display),
+        )
+      ),
+    text = FhirString(value = display),
+  )
+
+fun localCode(code: String, display: String) =
+  CodeableConcept(
+    coding =
+      listOf(
+        Coding(
+          system = Uri(value = AncCodes.LOCAL_SYSTEM),
+          code = Code(value = code),
+          display = FhirString(value = display),
+        )
+      ),
+    text = FhirString(value = display),
+  )
+
+fun category(code: String, display: String) =
+  CodeableConcept(
+    coding =
+      listOf(
+        Coding(
+          system = Uri(value = OBSERVATION_CATEGORY),
+          code = Code(value = code),
+          display = FhirString(value = display),
+        )
+      )
+  )
