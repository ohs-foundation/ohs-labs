+@Composable
+fun RegisterScreen(onOpen: (Patient) -> Unit) {
+  val (patients, error, retry) = rememberLoad(Unit) { Fhir.patients() }
+  val today = LocalDate.now()
+  Screen("ANC register") { padding ->
+    if (patients == null) return@Screen LoadState(error, retry, padding)
+    LazyColumn(contentPadding = padding) {
+      if (patients.isEmpty()) item { Text("No pregnant patients on file.", Modifier.padding(16.dp)) }
+      items(patients, key = { it.id }) { p ->
+        ListItem(
+          headlineContent = { Text(p.name) },
+          supportingContent = { Text("Age ${p.age(today) ?: "?"} · Due ${p.edd}") },
+          trailingContent = { Text(p.gaDays(today)?.let { "${it / 7}w ${it % 7}d" } ?: "") },
+          modifier = Modifier.clickable { onOpen(p) },
+        )
+        HorizontalDivider()
+      }
