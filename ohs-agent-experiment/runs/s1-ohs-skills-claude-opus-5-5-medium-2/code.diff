+package com.example.ancapp
+
+import com.ionspin.kotlin.bignum.decimal.BigDecimal
+import dev.ohs.fhir.engine.FhirEngine
+import dev.ohs.fhir.engine.get
+import dev.ohs.fhir.engine.search.ReferenceClientParam
+import dev.ohs.fhir.engine.search.Search
+import dev.ohs.fhir.engine.search.search
+import dev.ohs.fhir.model.r4.Canonical
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.CodeableConcept
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.DateTime
+import dev.ohs.fhir.model.r4.Decimal
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Enumeration
+import dev.ohs.fhir.model.r4.FhirDateTime
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Patient
+import dev.ohs.fhir.model.r4.Period
+import dev.ohs.fhir.model.r4.Quantity
+import dev.ohs.fhir.model.r4.Questionnaire
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import dev.ohs.fhir.model.r4.Reference
+import dev.ohs.fhir.model.r4.Uri
+import dev.ohs.fhir.model.r4.terminologies.ResourceType
+import java.time.LocalDate
+import java.time.Period as JPeriod
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+import kotlinx.serialization.json.Json
+import dev.ohs.fhir.model.r4.String as FhirString
+
+const val LOINC = "http://loinc.org"
+const val EDD = "11778-8"
+const val WEIGHT = "29463-7"
+const val BP = "85354-9"
+const val SYS = "8480-6"
+const val DIA = "8462-4"
+const val HB = "718-7"
+const val GA = "49051-6"
+
+val json = Json {
+  explicitNulls = false
+  encodeDefaults = false
+}
+
+data class PatientRow(val id: String, val name: String, val age: Int?, val edd: LocalDate?, val weeks: Long?)
+
+data class Visit(val date: String, val weight: String?, val bp: String?, val hb: String?)
+
+private fun Observation.loinc() = code.coding.firstOrNull { it.system?.value == LOINC }?.code?.value
+
+private fun Observation.Value?.qty() = this?.asQuantity()?.value?.value?.value?.toPlainString()
+
+private fun Observation.componentQty(code: String) =
+  component.firstOrNull { c -> c.code.coding.any { it.code?.value == code } }?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+
+private fun String.toLocalDate() = LocalDate.parse(substringBefore("T"))
+
+fun Patient.displayName() = name.firstOrNull().let { n ->
+  listOfNotNull(n?.given?.mapNotNull { it.value }?.joinToString(" "), n?.family?.value).joinToString(" ")
+}
+
+suspend fun FhirEngine.register(today: LocalDate = LocalDate.now()): List<PatientRow> {
+  // Latest EDD per patient; ponytail: loads all observations, filter by code if the DB grows large.
+  val edds =
+    search<Observation>(Search(ResourceType.Observation))
+      .map { it.resource }
+      .filter { it.loinc() == EDD }
+      .sortedBy { it.effective?.asDateTime()?.value?.value?.toString() }
+      .associate { it.subject?.reference?.value?.substringAfter("/") to it.value?.asDateTime()?.value?.value?.toString()?.toLocalDate() }
+  return search<Patient>(Search(ResourceType.Patient))
+    .map { it.resource }
+    .mapNotNull { p ->
+      val edd = edds[p.id] ?: return@mapNotNull null // only currently pregnant (has an EDD)
+      val dob = p.birthDate?.value?.toString()?.toLocalDate()
+      PatientRow(
+        id = p.id!!,
+        name = p.displayName(),
+        age = dob?.let { JPeriod.between(it, today).years },
+        edd = edd,
+        weeks = 40 - ChronoUnit.DAYS.between(today, edd).let { Math.floorDiv(it + 6, 7) },
+      )
+    }
+    .sortedBy { it.edd }
+}
+
+suspend fun FhirEngine.visits(patientId: String): List<Visit> {
+  val byPatient = Search(ResourceType.Observation).apply {
+    filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+  }
+  val obs = search<Observation>(byPatient).map { it.resource }.groupBy { it.encounter?.reference?.value?.substringAfter("/") }
+  val encounters =
+    search<Encounter>(
+      Search(ResourceType.Encounter).apply { filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" }) }
+    )
+  return encounters
+    .map { it.resource }
+    .map { e ->
+      val o = obs[e.id].orEmpty()
+      val bp = o.firstOrNull { it.loinc() == BP }
+      Visit(
+        date = e.period?.start?.value?.toString()?.substringBefore("T") ?: "?",
+        weight = o.firstOrNull { it.loinc() == WEIGHT }?.value.qty(),
+        bp = bp?.let { "${it.componentQty(SYS) ?: "?"}/${it.componentQty(DIA) ?: "?"}" },
+        hb = o.firstOrNull { it.loinc() == HB }?.value.qty(),
+      )
+    }
+    .sortedByDescending { it.date }
+}
+
+suspend fun FhirEngine.questionnaireJson(): String? =
+  runCatching { json.encodeToString(get<Questionnaire>("anc-contact")) }.getOrNull()
+
+/** Maps the anc-contact response to an Encounter + Observations and stores them with the response. */
+suspend fun FhirEngine.saveVisit(patientId: String, response: QuestionnaireResponse) {
+  val answers = mutableMapOf<String, MutableList<QuestionnaireResponse.Item.Answer>>()
+  fun collect(items: List<QuestionnaireResponse.Item>) {
+    items.forEach { item ->
+      item.linkId.value?.let { answers.getOrPut(it) { mutableListOf() }.addAll(item.answer) }
+      collect(item.item)
+      item.answer.forEach { collect(it.item) }
+    }
+  }
+  collect(response.item)
+  fun first(id: String) = answers[id]?.firstOrNull()?.value
+
+  val date = first("visit-date")?.asDate()?.value?.value?.toString() ?: LocalDate.now().toString()
+  val weight = first("weight")?.asDecimal()?.value?.value
+  val sys = first("bp-systolic")?.asInteger()?.value?.value
+  val dia = first("bp-diastolic")?.asInteger()?.value?.value
+  val ga = first("gestational-age")?.asInteger()?.value?.value
+
+  val subject = Reference(reference = FhirString(value = "Patient/$patientId"))
+  val encId = UUID.randomUUID().toString()
+  val encRef = Reference(reference = FhirString(value = "Encounter/$encId"))
+  val effective = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(date)))
+  fun concept(code: String, display: String) =
+    CodeableConcept(
+      coding = listOf(Coding(system = Uri(value = LOINC), code = Code(value = code), display = FhirString(value = display))),
+      text = FhirString(value = display),
+    )
+  fun qty(v: BigDecimal, unit: String, ucum: String) =
+    Quantity(
+      value = Decimal(value = v),
+      unit = FhirString(value = unit),
+      system = Uri(value = "http://unitsofmeasure.org"),
+      code = Code(value = ucum),
+    )
+  fun obs(code: CodeableConcept, value: Observation.Value? = null, component: List<Observation.Component> = emptyList()) =
+    Observation(
+      id = UUID.randomUUID().toString(),
+      status = Enumeration(value = Observation.ObservationStatus.Final),
+      code = code,
+      subject = subject,
+      encounter = encRef,
+      effective = effective,
+      value = value,
+      component = component,
+    )
+
+  val encounter =
+    Encounter(
+      id = encId,
+      status = Enumeration(value = Encounter.EncounterStatus.Finished),
+      `class` =
+        Coding(
+          system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"),
+          code = Code(value = "AMB"),
+          display = FhirString(value = "ambulatory"),
+        ),
+      type = listOf(CodeableConcept(text = FhirString(value = "Antenatal care contact"))),
+      subject = subject,
+      period = Period(start = DateTime(value = FhirDateTime.fromString(date)), end = DateTime(value = FhirDateTime.fromString(date))),
+    )
+  val observations = buildList {
+    weight?.let { add(obs(concept(WEIGHT, "Body weight"), Observation.Value.Quantity(qty(it, "kg", "kg")))) }
+    ga?.let { add(obs(concept(GA, "Gestational age in weeks"), Observation.Value.Quantity(qty(BigDecimal.fromInt(it), "wk", "wk")))) }
+    if (sys != null || dia != null) {
+      val parts =
+        listOfNotNull(sys?.let { SYS to it }, dia?.let { DIA to it }).map { (code, v) ->
+          Observation.Component(
+            code = concept(code, if (code == SYS) "Systolic blood pressure" else "Diastolic blood pressure"),
+            value = Observation.Component.Value.Quantity(qty(BigDecimal.fromInt(v), "mmHg", "mm[Hg]")),
+          )
+        }
+      add(obs(concept(BP, "Blood pressure panel with all children optional"), component = parts))
+    }
+  }
+  // Danger signs and notes stay in the stored QuestionnaireResponse.
+  val qr =
+    response.toBuilder().apply {
+      id = UUID.randomUUID().toString()
+      status = Enumeration(value = QuestionnaireResponse.QuestionnaireResponseStatus.Completed)
+      this.subject = subject.toBuilder()
+      this.encounter = encRef.toBuilder()
+      questionnaire = Canonical(value = "http://example.org/fhir/Questionnaire/anc-contact").toBuilder()
+    }.build()
+  create(encounter, *observations.toTypedArray(), qr)
+}
