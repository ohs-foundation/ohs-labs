+import kotlinx.coroutines.flow.stateIn
+
+data class PatientDetailUiState(
+  val patient: Patient? = null,
+  val visits: List<Visit> = emptyList(),
+)
+
+class PatientDetailViewModel(repository: AncRepository, patientId: Long) : ViewModel() {
+  val uiState: StateFlow<PatientDetailUiState> =
+    combine(repository.patient(patientId), repository.visitsForPatient(patientId)) { patient, visits ->
+      PatientDetailUiState(patient, visits)
+    }.stateIn(viewModelScope, SharingStarted.WhileSubscribed(5_000), PatientDetailUiState())
+
+  companion object {
+    fun factory(patientId: Long) = viewModelFactory {
+      initializer {
+        PatientDetailViewModel((this[APPLICATION_KEY] as AncApplication).repository, patientId)
+      }
+    }
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun PatientDetailScreen(
+  patientId: Long,
+  onBack: () -> Unit,
+  onRecordVisit: () -> Unit,
+  viewModel: PatientDetailViewModel = viewModel(
+    key = "patient-$patientId",
+    factory = PatientDetailViewModel.factory(patientId),
+  ),
+) {
+  val uiState by viewModel.uiState.collectAsState()
+  val patient = uiState.patient ?: return
+
+  Scaffold(
+    topBar = {
+      TopAppBar(
+        title = { Text(patient.name) },
+        navigationIcon = {
+          IconButton(onClick = onBack) {
+            Icon(Icons.AutoMirrored.Filled.ArrowBack, contentDescription = "Back")
+          }
+        },
+      )
+    },
+    floatingActionButton = {
+      ExtendedFloatingActionButton(
+        onClick = onRecordVisit,
+        icon = { Icon(Icons.Default.Add, contentDescription = null) },
+        text = { Text("New visit") },
+      )
+    },
+  ) { innerPadding ->
+    LazyColumn(
+      modifier = Modifier.fillMaxSize().padding(innerPadding),
+      contentPadding = PaddingValues(start = 16.dp, end = 16.dp, top = 16.dp, bottom = 88.dp),
+      verticalArrangement = Arrangement.spacedBy(12.dp),
+    ) {
+      item { PatientSummaryCard(patient) }
+      item {
+        Text(
+          "ANC visits",
+          style = MaterialTheme.typography.titleMedium,
+          modifier = Modifier.padding(top = 8.dp),
+        )
+      }
+      if (uiState.visits.isEmpty()) {
+        item {
+          Text(
+            "No visits recorded yet.",
+            style = MaterialTheme.typography.bodyMedium,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+          )
+        }
+      }
+      items(uiState.visits, key = { it.id }) { visit -> VisitCard(visit) }
+    }
+  }
+}
+
+@Composable
+private fun PatientSummaryCard(patient: Patient) {
+  Card(Modifier.fillMaxWidth()) {
+    Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+      InfoRow("Age", "${ageInYears(patient.dateOfBirth)} years (born ${patient.dateOfBirth.display()})")
+      InfoRow("Due date", patient.dueDate.display())
+      InfoRow("Pregnancy", "${gestationalWeeks(patient.dueDate)} weeks")
+    }
+  }
+}
+
+@Composable
+private fun VisitCard(visit: Visit) {
+  Card(
+    modifier = Modifier.fillMaxWidth(),
+    colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceContainerLow),
+  ) {
+    Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+      Row(
+        Modifier.fillMaxWidth(),
+        horizontalArrangement = Arrangement.SpaceBetween,
+      ) {
+        Text(visit.date.display(), style = MaterialTheme.typography.titleSmall)
+        Text(
+          "${visit.gestationalWeeks} wks",
+          style = MaterialTheme.typography.titleSmall,
+          color = MaterialTheme.colorScheme.primary,
+        )
+      }
+      InfoRow("Weight", "%.1f kg".format(visit.weightKg))
+      InfoRow("Blood pressure", "${visit.systolic}/${visit.diastolic} mmHg")
+      visit.hemoglobin?.let { InfoRow("Hemoglobin", "%.1f g/dL".format(it)) }
+      if (visit.dangerSigns.isNotEmpty()) {
+        InfoRow(
+          "Danger signs",
+          visit.dangerSigns.joinToString(", ") { it.label },
+          valueColor = MaterialTheme.colorScheme.error,
+        )
+      }
+      if (visit.notes.isNotBlank()) {
+        InfoRow("Notes", visit.notes)
+      }
+    }
+  }
+}
+
+@Composable
+private fun InfoRow(
+  label: String,
+  value: String,
+  valueColor: androidx.compose.ui.graphics.Color = androidx.compose.ui.graphics.Color.Unspecified,
+) {
+  Row(Modifier.fillMaxWidth()) {
+    Text(
+      label,
+      style = MaterialTheme.typography.bodyMedium,
+      color = MaterialTheme.colorScheme.onSurfaceVariant,
+      modifier = Modifier.padding(end = 12.dp).fillMaxWidth(0.4f),
+    )
+    Text(value, style = MaterialTheme.typography.bodyMedium, color = valueColor)
+  }
+}
