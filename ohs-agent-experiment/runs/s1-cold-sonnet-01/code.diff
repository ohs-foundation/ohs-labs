+package com.example.ancapp.data
+
+import android.content.Context
+import java.io.File
+import java.util.UUID
+import kotlinx.serialization.json.Json
+
+class AncRepository(context: Context) {
+
+    private val json = Json { prettyPrint = true; ignoreUnknownKeys = true }
+    private val file = File(context.filesDir, "anc_data.json")
+
+    fun loadPatients(): List<Patient> {
+        if (!file.exists()) {
+            val seeded = AppData(seedPatients())
+            file.writeText(json.encodeToString(AppData.serializer(), seeded))
+            return seeded.patients
+        }
+        return json.decodeFromString(AppData.serializer(), file.readText()).patients
+    }
+
+    fun savePatients(patients: List<Patient>) {
+        file.writeText(json.encodeToString(AppData.serializer(), AppData(patients)))
+    }
+
+    private fun seedPatients(): List<Patient> = listOf(
+        Patient(
+            id = UUID.randomUUID().toString(),
+            name = "Emily Carter",
+            dateOfBirth = "1996-04-12",
+            estimatedDueDate = "2026-12-05",
