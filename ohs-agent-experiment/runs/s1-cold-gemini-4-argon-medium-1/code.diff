+    viewModel.navigateBack()
+  }
+
+  when (val screen = uiState.currentScreen) {
+    Screen.Register -> {
+      RegisterScreen(
+        patients = uiState.patients,
+        onPatientClick = { patientId -> viewModel.openPatientDetail(patientId) }
+      )
+    }
+
+    is Screen.PatientDetail -> {
+      val patientWithVisits = uiState.selectedPatient(screen.patientId)
+      if (patientWithVisits != null) {
+        PatientDetailScreen(
+          patientWithVisits = patientWithVisits,
+          savedMessage = uiState.lastSavedMessage,
+          onBackClick = { viewModel.navigateBack() },
+          onRecordNewVisitClick = { viewModel.openRecordVisit(screen.patientId) }
+        )
+      } else {
+        viewModel.navigateBack()
+      }
+    }
+
+    is Screen.RecordVisit -> {
+      val patientWithVisits = uiState.selectedPatient(screen.patientId)
+      if (patientWithVisits != null) {
+        RecordVisitScreen(
+          patientWithVisits = patientWithVisits,
+          onCancelClick = { viewModel.navigateBack() },
+          onSaveVisit = { visit -> viewModel.saveVisit(visit) }
+        )
+      } else {
+        viewModel.navigateBack()
+      }
+    }
+  }
+}
