diff --git a/app/src/main/java/com/example/ancapp/AncRepository.kt b/app/src/main/java/com/example/ancapp/AncRepository.kt
new file mode 100644
index 0000000..5aef5b5
--- /dev/null
+++ b/app/src/main/java/com/example/ancapp/AncRepository.kt
@@ -0,0 +1,390 @@
+package com.example.ancapp
+
+import android.content.Context
+import androidx.work.ExistingWorkPolicy
+import com.ionspin.kotlin.bignum.decimal.BigDecimal
+import dev.ohs.fhir.engine.FhirEngineProvider
+import dev.ohs.fhir.engine.get
+import dev.ohs.fhir.engine.search.ReferenceClientParam
+import dev.ohs.fhir.engine.search.Search
+import dev.ohs.fhir.engine.sync.CurrentSyncJobStatus
+import dev.ohs.fhir.engine.sync.Sync
+import dev.ohs.fhir.model.r4.Canonical
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.CodeableConcept
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.DateTime
+import dev.ohs.fhir.model.r4.Decimal
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Enumeration
+import dev.ohs.fhir.model.r4.FhirDateTime
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Patient
+import dev.ohs.fhir.model.r4.Period
+import dev.ohs.fhir.model.r4.Quantity
+import dev.ohs.fhir.model.r4.Questionnaire
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import dev.ohs.fhir.model.r4.Reference
+import dev.ohs.fhir.model.r4.Resource
+import dev.ohs.fhir.model.r4.Uri
+import dev.ohs.fhir.model.r4.String as FhirString
+import dev.ohs.fhir.model.r4.terminologies.ResourceType
+import java.time.LocalDate
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.launch
+import kotlinx.serialization.json.Json
+
+data class RegisterPatient(
+  val id: String,
+  val name: String,
+  val ageYears: Int?,
+  val dueDate: LocalDate?,
+  val gestationWeeks: Int?,
+)
+
+data class Visit(
+  val encounterId: String,
+  val date: LocalDate?,
+  val weightKg: String?,
+  val systolic: String?,
+  val diastolic: String?,
+  val hemoglobin: String?,
+  val gestationalAgeWeeks: String?,
+  val dangerSigns: List<String>,
+  val notes: String?,
+)
+
+private const val LOINC = "http://loinc.org"
+private const val UCUM = "http://unitsofmeasure.org"
+private const val EDD_CODE = "11778-8"
+private const val WEIGHT_CODE = "29463-7"
+private const val BP_PANEL_CODE = "85354-9"
+private const val BP_SYS_CODE = "8480-6"
+private const val BP_DIA_CODE = "8462-4"
+private const val HB_CODE = "718-7"
+private const val GA_CODE = "11884-4"
+private const val NOTES_CODE = "48767-8"
+private const val DANGER_SIGN_SYSTEM = "urn:example:anc-danger-signs"
+private const val QUESTIONNAIRE_ID = "anc-contact"
+private const val QUESTIONNAIRE_URL = "http://example.org/fhir/Questionnaire/anc-contact"
+
+class AncRepository(private val context: Context) {
+
+  private val engine get() = FhirEngineProvider.getInstance(context.applicationContext)
+  private val json = Json {
+    explicitNulls = false
+    encodeDefaults = false
+  }
+  private val backgroundScope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+
+  /** Runs one sync and waits for a terminal state. Returns true on success. */
+  suspend fun syncOnce(): Boolean =
+    try {
+      val terminal = Sync.oneTimeSync<AppSyncWorker>(context.applicationContext).first {
+        it is CurrentSyncJobStatus.Succeeded ||
+          it is CurrentSyncJobStatus.Failed ||
+          it is CurrentSyncJobStatus.Cancelled
+      }
+      terminal is CurrentSyncJobStatus.Succeeded
+    } catch (e: Exception) {
+      false
+    }
+
+  private fun requestSync() {
+    backgroundScope.launch {
+      try {
+        Sync.oneTimeSync<AppSyncWorker>(
+          context.applicationContext,
+          existingWorkPolicy = ExistingWorkPolicy.APPEND_OR_REPLACE,
+        ).first {
+          it is CurrentSyncJobStatus.Succeeded ||
+            it is CurrentSyncJobStatus.Failed ||
+            it is CurrentSyncJobStatus.Cancelled
+        }
+      } catch (_: Exception) {
+      }
+    }
+  }
+
+  suspend fun loadRegister(): List<RegisterPatient> {
+    val patients = engine.search<Patient>(Search(ResourceType.Patient)).map { it.resource }
+    val eddByPatient =
+      engine.search<Observation>(Search(ResourceType.Observation))
+        .map { it.resource }
+        .filter { obs -> obs.code.coding.any { it.code?.value == EDD_CODE } }
+        .groupBy { it.subject?.reference?.value?.substringAfter("Patient/") }
+        .mapValues { (_, list) ->
+          list
+            .maxByOrNull { it.effective?.asDateTime()?.value?.value?.toString().orEmpty() }
+            ?.value?.asDateTime()?.value?.value?.toString()
+            ?.let(::parseDate)
+        }
+    val today = LocalDate.now()
+    return patients
+      .mapNotNull { p ->
+        val id = p.id ?: return@mapNotNull null
+        val due = eddByPatient[id]
+        RegisterPatient(
+          id = id,
+          name = p.displayName(),
+          ageYears =
+            parseDate(p.birthDate?.value?.toString())?.let {
+              java.time.Period.between(it, today).years
+            },
+          dueDate = due,
+          gestationWeeks =
+            due?.let { ((280 - ChronoUnit.DAYS.between(today, it)) / 7).toInt() }
+              ?.coerceIn(0, 45),
+        )
+      }
+      .sortedWith(compareBy(nullsLast()) { it.dueDate })
+  }
+
+  suspend fun loadPatient(patientId: String): RegisterPatient? =
+    loadRegister().firstOrNull { it.id == patientId }
+
+  suspend fun loadVisits(patientId: String): List<Visit> {
+    val subject = "Patient/$patientId"
+    val encounters =
+      engine.search<Encounter>(
+        Search(ResourceType.Encounter).apply {
+          filter(ReferenceClientParam("subject"), { value = subject })
+        }
+      ).map { it.resource }
+    val observations =
+      engine.search<Observation>(
+        Search(ResourceType.Observation).apply {
+          filter(ReferenceClientParam("subject"), { value = subject })
+        }
+      ).map { it.resource }
+    val obsByEncounter =
+      observations.groupBy { it.encounter?.reference?.value?.substringAfter("Encounter/") }
+
+    return encounters
+      .mapNotNull { enc ->
+        val encId = enc.id ?: return@mapNotNull null
+        val obs = obsByEncounter[encId].orEmpty()
+        val bp = obs.firstOrNull { it.hasCode(BP_PANEL_CODE) || it.componentCode(BP_SYS_CODE) != null }
+        Visit(
+          encounterId = encId,
+          date = parseDate(enc.period?.start?.value?.toString()),
+          weightKg = obs.firstOrNull { it.hasCode(WEIGHT_CODE) }?.quantityString(),
+          systolic = bp?.componentCode(BP_SYS_CODE),
+          diastolic = bp?.componentCode(BP_DIA_CODE),
+          hemoglobin = obs.firstOrNull { it.hasCode(HB_CODE) }?.quantityString(),
+          gestationalAgeWeeks = obs.firstOrNull { it.hasCode(GA_CODE) }?.quantityString(),
+          dangerSigns =
+            obs
+              .filter { o ->
+                o.value?.asCodeableConcept()?.value?.coding?.any {
+                  it.system?.value == DANGER_SIGN_SYSTEM
+                } == true
+              }
+              .mapNotNull { o ->
+                val cc = o.value?.asCodeableConcept()?.value
+                cc?.coding?.firstOrNull()?.display?.value ?: cc?.text?.value
+              },
+          notes = obs.firstOrNull { it.hasCode(NOTES_CODE) }?.value?.asString()?.value?.value,
+        )
+      }
+      .sortedWith(compareByDescending(nullsLast()) { it.date })
+  }
+
+  suspend fun questionnaireJson(): String? =
+    try {
+      json.encodeToString(engine.get<Questionnaire>(QUESTIONNAIRE_ID))
+    } catch (e: Exception) {
+      null
+    }
+
+  /**
+   * Persists a completed ANC visit form: an Encounter, Observations extracted from
+   * the answers, and the QuestionnaireResponse itself — then queues an upload sync.
+   */
+  suspend fun saveVisit(patientId: String, response: QuestionnaireResponse) {
+    val answers = mutableMapOf<String, MutableList<QuestionnaireResponse.Item.Answer>>()
+    collectAnswers(response.item, answers)
+
+    val visitDate =
+      answers["visit-date"]?.firstOrNull()?.value?.asDate()?.value?.value?.toString()
+        ?: LocalDate.now().toString()
+    val encounterId = UUID.randomUUID().toString()
+    val patientRef = Reference(reference = FhirString(value = "Patient/$patientId"))
+    val encounterRef = Reference(reference = FhirString(value = "Encounter/$encounterId"))
+    val effective =
+      Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(visitDate)))
+
+    fun observation(coding: Coding?, text: String, value: Observation.Value) =
+      Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        code = CodeableConcept(
+          coding = listOfNotNull(coding),
+          text = FhirString(value = text),
+        ),
+        subject = patientRef,
+        encounter = encounterRef,
+        effective = effective,
+        value = value,
+      )
+
+    fun loinc(code: String, display: String) =
+      Coding(
+        system = Uri(value = LOINC),
+        code = Code(value = code),
+        display = FhirString(value = display),
+      )
+
+    fun quantity(value: BigDecimal, unit: String, ucumCode: String) =
+      Quantity(
+        value = Decimal(value = value),
+        unit = FhirString(value = unit),
+        system = Uri(value = UCUM),
+        code = Code(value = ucumCode),
+      )
+
+    val resources = mutableListOf<Resource>()
+
+    resources +=
+      Encounter(
+        id = encounterId,
+        status = Enumeration(value = Encounter.EncounterStatus.Finished),
+        `class` = Coding(
+          system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"),
+          code = Code(value = "AMB"),
+          display = FhirString(value = "ambulatory"),
+        ),
+        type = listOf(CodeableConcept(text = FhirString(value = "Antenatal care contact"))),
+        subject = patientRef,
+        period = Period(
+          start = DateTime(value = FhirDateTime.fromString(visitDate)),
+          end = DateTime(value = FhirDateTime.fromString(visitDate)),
+        ),
+      )
+
+    answers["weight"]?.firstOrNull()?.value?.asDecimal()?.value?.value?.let { weight ->
+      resources +=
+        observation(
+          loinc(WEIGHT_CODE, "Body weight"),
+          "Body weight",
+          Observation.Value.Quantity(quantity(weight, "kg", "kg")),
+        )
+    }
+
+    val systolic = answers["bp-systolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+    val diastolic = answers["bp-diastolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+    if (systolic != null || diastolic != null) {
+      resources +=
+        Observation(
+          id = UUID.randomUUID().toString(),
+          status = Enumeration(value = Observation.ObservationStatus.Final),
+          code = CodeableConcept(
+            coding = listOf(loinc(BP_PANEL_CODE, "Blood pressure panel with all children optional")),
+            text = FhirString(value = "Blood pressure"),
+          ),
+          subject = patientRef,
+          encounter = encounterRef,
+          effective = effective,
+          component = listOfNotNull(
+            systolic?.let {
+              Observation.Component(
+                code = CodeableConcept(coding = listOf(loinc(BP_SYS_CODE, "Systolic blood pressure"))),
+                value = Observation.Component.Value.Quantity(
+                  quantity(BigDecimal.fromInt(it), "mmHg", "mm[Hg]")
+                ),
+              )
+            },
+            diastolic?.let {
+              Observation.Component(
+                code = CodeableConcept(coding = listOf(loinc(BP_DIA_CODE, "Diastolic blood pressure"))),
+                value = Observation.Component.Value.Quantity(
+                  quantity(BigDecimal.fromInt(it), "mmHg", "mm[Hg]")
+                ),
+              )
+            },
+          ),
+        )
+    }
+
+    answers["gestational-age"]?.firstOrNull()?.value?.asInteger()?.value?.value?.let { weeks ->
+      resources +=
+        observation(
+          loinc(GA_CODE, "Gestational age Estimated"),
+          "Gestational age",
+          Observation.Value.Quantity(quantity(BigDecimal.fromInt(weeks), "weeks", "wk")),
+        )
+    }
+
+    answers["danger-signs"].orEmpty()
+      .mapNotNull { it.value?.asCoding()?.value }
+      .forEach { coding ->
+        resources +=
+          observation(
+            null,
+            "Danger sign",
+            Observation.Value.CodeableConcept(
+              CodeableConcept(coding = listOf(coding), text = coding.display)
+            ),
+          )
+      }
+
+    answers["notes"]?.firstOrNull()?.value?.asString()?.value?.value
+      ?.takeIf { it.isNotBlank() }
+      ?.let { text ->
+        resources +=
+          observation(
+            loinc(NOTES_CODE, "Annotation comment"),
+            "Notes",
+            Observation.Value.String(FhirString(value = text)),
+          )
+      }
+
+    resources +=
+      response.toBuilder().apply {
+        id = UUID.randomUUID().toString()
+        status = Enumeration(value = QuestionnaireResponse.QuestionnaireResponseStatus.Completed)
+        subject = patientRef.toBuilder()
+        encounter = encounterRef.toBuilder()
+        questionnaire = Canonical(value = QUESTIONNAIRE_URL).toBuilder()
+        authored = DateTime(value = FhirDateTime.fromString(visitDate)).toBuilder()
+      }.build()
+
+    engine.create(*resources.toTypedArray())
+    requestSync()
+  }
+
+  private fun collectAnswers(
+    items: List<QuestionnaireResponse.Item>,
+    into: MutableMap<String, MutableList<QuestionnaireResponse.Item.Answer>>,
+  ) {
+    items.forEach { item ->
+      item.linkId.value?.let { into.getOrPut(it) { mutableListOf() }.addAll(item.answer) }
+      collectAnswers(item.item, into)
+      item.answer.forEach { collectAnswers(it.item, into) }
+    }
+  }
+}
+
+private fun parseDate(raw: kotlin.String?): LocalDate? =
+  raw?.take(10)?.let { runCatching { LocalDate.parse(it) }.getOrNull() }
+
+private fun Patient.displayName(): kotlin.String {
+  val n = name.firstOrNull() ?: return "Unknown"
+  val parts = n.given.mapNotNull { it.value } + listOfNotNull(n.family?.value)
+  return parts.joinToString(" ").ifBlank { "Unknown" }
+}
+
+private fun Observation.hasCode(code: kotlin.String): Boolean =
+  this.code.coding.any { it.code?.value == code }
+
+private fun Observation.quantityString(): kotlin.String? =
+  value?.asQuantity()?.value?.value?.value?.toPlainString()
+
+private fun Observation.componentCode(code: kotlin.String): kotlin.String? =
+  component.firstOrNull { c -> c.code.coding.any { it.code?.value == code } }
+    ?.value?.asQuantity()?.value?.value?.value?.toPlainString()
