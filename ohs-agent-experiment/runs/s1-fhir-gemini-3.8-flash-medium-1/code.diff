+@Composable
+fun AncApp(viewModel: AncViewModel) {
+    val currentScreen by viewModel.screen.collectAsState()
+    val patients by viewModel.patients.collectAsState()
+    val isLoadingPatients by viewModel.isLoadingPatients.collectAsState()
+    val patientsError by viewModel.patientsError.collectAsState()
+
+    val visits by viewModel.visits.collectAsState()
+    val isLoadingVisits by viewModel.isLoadingVisits.collectAsState()
+    val visitsError by viewModel.visitsError.collectAsState()
+
+    val questionnaire by viewModel.questionnaire.collectAsState()
+    val isSavingVisit by viewModel.isSavingVisit.collectAsState()
+    val saveError by viewModel.saveError.collectAsState()
+
+    when (val screen = currentScreen) {
+        UiScreen.Register -> {
+            RegisterScreen(
+                patients = patients,
+                isLoading = isLoadingPatients,
+                error = patientsError,
+                onRefresh = { viewModel.loadPatients() },
+                onPatientClick = { patient ->
+                    viewModel.navigateTo(UiScreen.PatientDetail(patient.id))
+                }
+            )
+        }
+
+        is UiScreen.PatientDetail -> {
+            BackHandler {
+                viewModel.navigateTo(UiScreen.Register)
+            }
+            val patient = patients.firstOrNull { it.id == screen.patientId }
+            PatientDetailScreen(
+                patient = patient,
+                visits = visits,
+                isLoading = isLoadingVisits,
+                error = visitsError,
+                onBackClick = { viewModel.navigateTo(UiScreen.Register) },
+                onRefresh = { viewModel.loadVisits(screen.patientId) },
+                onRecordNewVisitClick = {
+                    viewModel.navigateTo(UiScreen.NewVisit(screen.patientId))
+                }
+            )
+        }
+
+        is UiScreen.NewVisit -> {
+            BackHandler {
+                viewModel.navigateTo(UiScreen.PatientDetail(screen.patientId))
+            }
+            val patient = patients.firstOrNull { it.id == screen.patientId }
+            NewVisitScreen(
+                patient = patient,
+                questionnaire = questionnaire,
+                isSaving = isSavingVisit,
+                saveError = saveError,
+                onBackClick = {
+                    viewModel.navigateTo(UiScreen.PatientDetail(screen.patientId))
+                },
+                onSaveVisit = { input ->
+                    viewModel.saveVisit(screen.patientId, input) {
+                        viewModel.navigateTo(UiScreen.PatientDetail(screen.patientId))
+                    }
+                }
+            )
+        }
+    }
 }
