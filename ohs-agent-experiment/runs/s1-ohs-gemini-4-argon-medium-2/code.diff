+
+  BackHandler(enabled = uiState.currentScreen != Screen.Register) {
+    ancViewModel.navigateBack()
+  }
+
+  when (val screen = uiState.currentScreen) {
+    Screen.Register -> {
+      RegisterScreen(
+        patients = uiState.patients,
+        isLoading = uiState.isLoading,
+        isSyncing = uiState.isSyncing,
+        errorMessage = uiState.errorMessage,
+        onRefresh = { ancViewModel.refresh() },
+        onPatientClick = { patientId -> ancViewModel.openPatientDetail(patientId) },
+      )
+    }
