+package com.example.ancapp.data
+
+import kotlinx.coroutines.flow.Flow
+
+class AncRepository(
+    private val patientDao: PatientDao,
+    private val visitDao: VisitDao
+) {
+    fun getAllPatients(): Flow<List<Patient>> = patientDao.getAllPatients()
+
+    fun getVisitsByPatient(patientId: Long): Flow<List<Visit>> =
+        visitDao.getVisitsByPatient(patientId)
+
+    suspend fun getPatientById(patientId: Long): Patient? =
+        patientDao.getPatientById(patientId)
+
+    suspend fun insertPatient(patient: Patient): Long =
+        patientDao.insertPatient(patient)
+
+    suspend fun insertVisit(visit: Visit): Long =
+        visitDao.insertVisit(visit)
+}
