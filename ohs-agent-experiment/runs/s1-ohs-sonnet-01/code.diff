+import java.time.format.DateTimeFormatter
+import kotlinx.coroutines.launch
+
+private val dateFormatter = DateTimeFormatter.ofPattern("d MMM yyyy")
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun RegisterScreen(onPatientClick: (String) -> Unit) {
+  val context = LocalContext.current
+  val scope = rememberCoroutineScope()
+  var patients by remember { mutableStateOf<List<PatientSummary>>(emptyList()) }
+  var loading by remember { mutableStateOf(true) }
+
+  suspend fun refresh() {
+    loading = true
+    AncRepository.sync(context)
+    patients = AncRepository.loadRegister(context)
+    loading = false
+  }
+
+  LaunchedEffect(Unit) { refresh() }
+
+  Scaffold(
+    topBar = {
+      TopAppBar(
+        title = { Text("ANC Register") },
+        actions = {
+          IconButton(onClick = { scope.launch { refresh() } }) {
+            Icon(Icons.Filled.Refresh, contentDescription = "Refresh")
+          }
+        },
+      )
+    },
+  ) { padding ->
+    Box(modifier = Modifier.fillMaxSize().padding(padding)) {
+      if (loading && patients.isEmpty()) {
+        CircularProgressIndicator(modifier = Modifier.align(Alignment.Center))
+      } else if (patients.isEmpty()) {
+        Text(
+          "No pregnant patients on file.",
+          modifier = Modifier.align(Alignment.Center).padding(24.dp),
+        )
+      } else {
+        LazyColumn(modifier = Modifier.fillMaxSize().padding(12.dp)) {
+          items(patients, key = { it.id }) { patient ->
+            PatientRow(patient, onClick = { onPatientClick(patient.id) })
+          }
+        }
+      }
+    }
+  }
+}
+
+@Composable
+private fun PatientRow(patient: PatientSummary, onClick: () -> Unit) {
+  Card(
+    modifier = Modifier
+      .fillMaxWidth()
+      .padding(vertical = 6.dp),
+    onClick = onClick,
+  ) {
+    Column(modifier = Modifier.padding(16.dp)) {
+      Text(patient.name, style = MaterialTheme.typography.titleMedium)
+      Row(
+        modifier = Modifier.fillMaxWidth().padding(top = 4.dp),
+        horizontalArrangement = Arrangement.SpaceBetween,
+      ) {
+        Text("Age ${patient.age}")
+        Text(patient.dueDate?.let { "EDD ${dateFormatter.format(it)}" } ?: "EDD unknown")
+      }
+      Text(
+        patient.gestationalAgeWeeks?.let { "$it weeks pregnant" } ?: "Gestational age unknown",
+        modifier = Modifier.padding(top = 4.dp),
+      )
+    }
+  }
+}
