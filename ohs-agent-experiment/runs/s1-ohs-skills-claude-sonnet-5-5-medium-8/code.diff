@@ -0,0 +1,182 @@
+package com.example.ancapp
+
+import com.ionspin.kotlin.bignum.decimal.BigDecimal
+import dev.ohs.fhir.engine.FhirEngine
+import dev.ohs.fhir.engine.get
+import dev.ohs.fhir.engine.search.Search
+import dev.ohs.fhir.model.r4.Annotation
+import dev.ohs.fhir.model.r4.CodeableConcept
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.DateTime
+import dev.ohs.fhir.model.r4.Decimal
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Enumeration
+import dev.ohs.fhir.model.r4.FhirDateTime
+import dev.ohs.fhir.model.r4.Markdown
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Patient
+import dev.ohs.fhir.model.r4.Period
+import dev.ohs.fhir.model.r4.Quantity
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import dev.ohs.fhir.model.r4.Reference
+import dev.ohs.fhir.model.r4.Uri
+import dev.ohs.fhir.model.r4.terminologies.ResourceType
+import java.time.LocalDate
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+import dev.ohs.fhir.model.r4.String as FhirString
+
+const val LOINC = "http://loinc.org"
+const val DANGER_SYSTEM = "urn:example:anc-danger-signs"
+const val WEIGHT = "29463-7"
+const val BP = "85354-9"
+const val SYS = "8480-6"
+const val DIA = "8462-4"
+const val HB = "718-7"
+const val EDD = "11778-8"
+const val GA = "11884-4"
+const val DANGER = "danger-signs"
+
+data class PatientRow(val id: String, val name: String, val age: Int?, val due: LocalDate, val weeks: Int)
+
+data class Visit(
+  val date: String,
+  val weight: String?,
+  val bp: String?,
+  val hb: String?,
+  val ga: String?,
+  val danger: String?,
+  val notes: String?,
+)
+
+private fun Observation.codeIs(c: String) = code.coding.any { it.code?.value == c }
+
+private fun Observation.dateStr() = effective?.asDateTime()?.value?.value?.toString()?.substringBefore("T")
+
+private fun Observation.qty() =
+  value?.asQuantity()?.value?.value?.value?.toStringExpanded()?.removeSuffix(".0")
+
+private fun Observation.subjectId() = subject?.reference?.value?.substringAfter("/")
+
+/** Local-store reads. ponytail: loads all observations and groups in memory, fine for a small clinic. */
+suspend fun loadRegister(engine: FhirEngine, today: LocalDate = LocalDate.now()): List<PatientRow> {
+  val patients = engine.search<Patient>(Search(ResourceType.Patient)).map { it.resource }
+  val edds =
+    engine.search<Observation>(Search(ResourceType.Observation)).map { it.resource }
+      .filter { it.codeIs(EDD) }
+      .associate { it.subjectId() to it.value?.asDateTime()?.value?.value?.toString()?.substringBefore("T") }
+  return patients
+    .mapNotNull { p ->
+      val due = edds[p.id]?.let(LocalDate::parse) ?: return@mapNotNull null
+      val n = p.name.firstOrNull()
+      val name = (n?.given.orEmpty().mapNotNull { it.value } + listOfNotNull(n?.family?.value)).joinToString(" ")
+      val age = p.birthDate?.value?.toString()?.let { ChronoUnit.YEARS.between(LocalDate.parse(it), today).toInt() }
+      PatientRow(p.id!!, name, age, due, ((280 - ChronoUnit.DAYS.between(today, due)) / 7).toInt())
+    }
+    .sortedBy { it.due }
+}
+
+suspend fun loadPatientName(engine: FhirEngine, id: String): String =
+  engine.get<Patient>(id).name.firstOrNull()?.let { n ->
+    (n.given.mapNotNull { it.value } + listOfNotNull(n.family?.value)).joinToString(" ")
+  } ?: id
+
+suspend fun loadVisits(engine: FhirEngine, patientId: String): List<Visit> {
+  val ref = "Patient/$patientId"
+  val encounters =
+    engine.search<Encounter>(Search(ResourceType.Encounter)).map { it.resource }
+      .filter { it.subject?.reference?.value == ref }
+  val obs =
+    engine.search<Observation>(Search(ResourceType.Observation)).map { it.resource }
+      .filter { it.subjectId() == patientId }
+  return encounters
+    .map { e ->
+      val mine = obs.filter { it.encounter?.reference?.value == "Encounter/${e.id}" }
+      fun q(c: String) = mine.firstOrNull { it.codeIs(c) }?.qty()
+      val bp = mine.firstOrNull { it.codeIs(BP) }
+      fun comp(c: String) =
+        bp?.component?.firstOrNull { k -> k.code.coding.any { it.code?.value == c } }
+          ?.value?.asQuantity()?.value?.value?.value?.toStringExpanded()?.removeSuffix(".0")
+      val dangerObs = mine.firstOrNull { it.codeIs(DANGER) }
+      Visit(
+        date = e.period?.start?.value?.toString()?.substringBefore("T") ?: "",
+        weight = q(WEIGHT),
+        bp = if (comp(SYS) != null && comp(DIA) != null) "${comp(SYS)}/${comp(DIA)}" else null,
+        hb = q(HB),
+        ga = q(GA),
+        danger = dangerObs?.value?.asCodeableConcept()?.value?.coding
+          ?.mapNotNull { it.display?.value }?.takeIf { it.isNotEmpty() }?.joinToString(", "),
+        notes = dangerObs?.note?.firstOrNull()?.text?.value,
+      )
+    }
+    .sortedByDescending { it.date }
+}
+
+/** Maps the filled anc-contact response to Encounter + Observations and stores them locally. */
+suspend fun saveVisit(engine: FhirEngine, patientId: String, response: QuestionnaireResponse) {
+  val answers = mutableMapOf<String, List<QuestionnaireResponse.Item.Answer>>()
+  fun walk(items: List<QuestionnaireResponse.Item>): Unit =
+    items.forEach { i ->
+      i.linkId.value?.let { answers[it] = i.answer }
+      walk(i.item)
+    }
+  walk(response.item)
+  fun first(id: String) = answers[id]?.firstOrNull()?.value
+
+  val date = first("visit-date")?.asDate()?.value?.value?.toString() ?: LocalDate.now().toString()
+  val subject = Reference(reference = FhirString(value = "Patient/$patientId"))
+  val encId = UUID.randomUUID().toString()
+  val dt = DateTime(value = FhirDateTime.fromString(date))
+  val encounter =
+    Encounter(
+      id = encId,
+      status = Enumeration(value = Encounter.EncounterStatus.Finished),
+      `class` = Coding(system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"), code = Code(value = "AMB")),
+      type = listOf(CodeableConcept(text = FhirString(value = "Antenatal care contact"))),
+      subject = subject,
+      period = Period(start = dt, end = dt),
+    )
+
+  fun obs(code: String, display: String, build: Observation.Builder.() -> Unit) =
+    Observation(
+      id = UUID.randomUUID().toString(),
+      status = Enumeration(value = Observation.ObservationStatus.Final),
+      code = CodeableConcept(coding = listOf(Coding(system = Uri(value = LOINC), code = Code(value = code), display = FhirString(value = display)))),
+      subject = subject,
+      encounter = Reference(reference = FhirString(value = "Encounter/$encId")),
+      effective = Observation.Effective.DateTime(dt),
+    ).toBuilder().apply(build).build()
+
+  fun qty(v: BigDecimal, unit: String, ucum: String = unit) =
+    Quantity(value = Decimal(value = v), unit = FhirString(value = unit), system = Uri(value = "http://unitsofmeasure.org"), code = Code(value = ucum))
+
+  val out = mutableListOf<dev.ohs.fhir.model.r4.Resource>(encounter)
+  first("weight")?.asDecimal()?.value?.value?.let { w ->
+    out += obs(WEIGHT, "Body weight") { value = Observation.Value.Quantity(qty(w, "kg")) }
+  }
+  first("gestational-age")?.asInteger()?.value?.value?.let { g ->
+    out += obs(GA, "Gestational age") { value = Observation.Value.Quantity(qty(BigDecimal.fromInt(g), "weeks", "wk")) }
+  }
+  val sys = first("bp-systolic")?.asInteger()?.value?.value
+  val dia = first("bp-diastolic")?.asInteger()?.value?.value
+  if (sys != null && dia != null) {
+    fun comp(c: String, d: String, v: Int) =
+      Observation.Component(
+        code = CodeableConcept(coding = listOf(Coding(system = Uri(value = LOINC), code = Code(value = c), display = FhirString(value = d)))),
+        value = Observation.Component.Value.Quantity(qty(BigDecimal.fromInt(v), "mmHg", "mm[Hg]")),
+      )
+    out += obs(BP, "Blood pressure panel") {
+      component = mutableListOf(comp(SYS, "Systolic blood pressure", sys).toBuilder(), comp(DIA, "Diastolic blood pressure", dia).toBuilder())
+    }
+  }
+  val signs = answers["danger-signs"].orEmpty().mapNotNull { it.value?.asCoding()?.value }
+  val notes = first("notes")?.asString()?.value?.value
+  if (signs.isNotEmpty() || !notes.isNullOrBlank()) {
+    out += obs(DANGER, "Danger signs") {
+      if (signs.isNotEmpty()) value = Observation.Value.CodeableConcept(CodeableConcept(coding = signs))
+      if (!notes.isNullOrBlank()) note = mutableListOf(Annotation(text = Markdown(value = notes)).toBuilder())
+    }
+  }
+  engine.create(*out.toTypedArray())
+}
