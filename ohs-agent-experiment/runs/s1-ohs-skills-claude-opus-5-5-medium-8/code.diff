@@ -0,0 +1,198 @@
+package com.example.ancapp
+
+import com.ionspin.kotlin.bignum.decimal.BigDecimal
+import dev.ohs.fhir.engine.FhirEngine
+import dev.ohs.fhir.engine.search.ReferenceClientParam
+import dev.ohs.fhir.engine.search.Search
+import dev.ohs.fhir.engine.search.search
+import dev.ohs.fhir.model.r4.Canonical
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.CodeableConcept
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.DateTime
+import dev.ohs.fhir.model.r4.Decimal
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Enumeration
+import dev.ohs.fhir.model.r4.FhirDateTime
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Patient
+import dev.ohs.fhir.model.r4.Period
+import dev.ohs.fhir.model.r4.Quantity
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import dev.ohs.fhir.model.r4.Reference
+import dev.ohs.fhir.model.r4.Uri
+import dev.ohs.fhir.model.r4.terminologies.ResourceType
+import java.time.LocalDate
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+import dev.ohs.fhir.model.r4.String as FhirString
+
+const val LOINC = "http://loinc.org"
+const val EDD = "11778-8"
+const val WEIGHT = "29463-7"
+const val BP_PANEL = "85354-9"
+const val SYSTOLIC = "8480-6"
+const val DIASTOLIC = "8462-4"
+const val HB = "718-7"
+const val QUESTIONNAIRE_URL = "http://example.org/fhir/Questionnaire/anc-contact"
+
+data class PatientRow(val id: String, val name: String, val age: Int?, val dueDate: LocalDate?, val weeks: Long?)
+
+data class Visit(val date: String, val weight: String?, val bp: String?, val hb: String?)
+
+private fun Observation.hasCode(code: String) = this.code.coding.any { it.code?.value == code }
+
+private fun Observation.quantity() = value?.asQuantity()?.value?.value?.value?.toPlainString()
+
+private fun Observation.component(code: String) =
+  component.firstOrNull { c -> c.code.coding.any { it.code?.value == code } }
+    ?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+
+private fun Reference?.targetId() = this?.reference?.value?.substringAfter("/")
+
+private fun Observation.effectiveDate() = effective?.asDateTime()?.value?.value?.toString().orEmpty()
+
+private fun String.toLocalDate() = runCatching { LocalDate.parse(substringBefore("T")) }.getOrNull()
+
+suspend fun loadRegister(engine: FhirEngine, today: LocalDate = LocalDate.now()): List<PatientRow> {
+  val dueDates = engine.search<Observation>(Search(ResourceType.Observation))
+    .map { it.resource }
+    .filter { it.hasCode(EDD) }
+    .groupBy { it.subject.targetId() }
+    .mapValues { (_, obs) ->
+      obs.maxByOrNull { it.effectiveDate() }?.value?.asDateTime()?.value?.value?.toString()?.toLocalDate()
+    }
+  return engine.search<Patient>(Search(ResourceType.Patient))
+    .map { it.resource }
+    .filter { it.active?.value != false }
+    .map { p ->
+      val name = p.name.firstOrNull()
+      val due = dueDates[p.id]
+      PatientRow(
+        id = p.id!!,
+        name = listOfNotNull(name?.given?.mapNotNull { it.value }?.joinToString(" "), name?.family?.value).joinToString(" "),
+        age = p.birthDate?.value?.toString()?.toLocalDate()?.let { ChronoUnit.YEARS.between(it, today).toInt() },
+        dueDate = due,
+        // Due date = 40 weeks gestation (Naegele).
+        weeks = due?.let { 40 - Math.ceilDiv(ChronoUnit.DAYS.between(today, it), 7L) },
+      )
+    }
+    .sortedWith(compareBy(nullsLast()) { it.dueDate })
+}
+
+suspend fun loadVisits(engine: FhirEngine, patientId: String): List<Visit> {
+  val obsByEncounter = engine.search<Observation>(
+    Search(ResourceType.Observation).apply { filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" }) }
+  ).map { it.resource }.groupBy { it.encounter.targetId() }
+  return engine.search<Encounter>(
+    Search(ResourceType.Encounter).apply { filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" }) }
+  ).map { it.resource }
+    .map { enc ->
+      val obs = obsByEncounter[enc.id].orEmpty()
+      val bp = obs.firstOrNull { it.hasCode(BP_PANEL) }
+      Visit(
+        date = enc.period?.start?.value?.toString()?.substringBefore("T").orEmpty(),
+        weight = obs.firstOrNull { it.hasCode(WEIGHT) }?.quantity(),
+        bp = bp?.let { "${it.component(SYSTOLIC) ?: "?"}/${it.component(DIASTOLIC) ?: "?"}" },
+        hb = obs.firstOrNull { it.hasCode(HB) }?.quantity(),
+      )
+    }
+    .sortedByDescending { it.date }
+}
+
+private fun answers(response: QuestionnaireResponse): Map<String, List<QuestionnaireResponse.Item.Answer>> {
+  val out = mutableMapOf<String, MutableList<QuestionnaireResponse.Item.Answer>>()
+  fun collect(items: List<QuestionnaireResponse.Item>) {
+    items.forEach { item ->
+      item.linkId.value?.let { out.getOrPut(it) { mutableListOf() }.addAll(item.answer) }
+      collect(item.item)
+      item.answer.forEach { collect(it.item) }
+    }
+  }
+  collect(response.item)
+  return out
+}
+
+private fun loinc(code: String, display: String) =
+  CodeableConcept(
+    coding = listOf(Coding(system = Uri(value = LOINC), code = Code(value = code), display = FhirString(value = display))),
+    text = FhirString(value = display),
+  )
+
+private fun quantity(v: BigDecimal, unit: String, ucum: String) =
+  Quantity(
+    value = Decimal(value = v),
+    unit = FhirString(value = unit),
+    system = Uri(value = "http://unitsofmeasure.org"),
+    code = Code(value = ucum),
+  )
+
+/** Saves the form as an Encounter + weight/BP Observations (same shape as the server data) plus the full response. */
+suspend fun saveVisit(engine: FhirEngine, patientId: String, response: QuestionnaireResponse) {
+  val a = answers(response)
+  val date = a["visit-date"]?.firstOrNull()?.value?.asDate()?.value?.value?.toString() ?: LocalDate.now().toString()
+  val weight = a["weight"]?.firstOrNull()?.value?.asDecimal()?.value?.value
+  val sys = a["bp-systolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+  val dia = a["bp-diastolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+
+  val patientRef = Reference(reference = FhirString(value = "Patient/$patientId"))
+  val encounterId = UUID.randomUUID().toString()
+  val encounterRef = Reference(reference = FhirString(value = "Encounter/$encounterId"))
+  val effective = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(date)))
+
+  fun observation(code: CodeableConcept, value: Quantity?, components: List<Observation.Component> = emptyList()) =
+    Observation(
+      id = UUID.randomUUID().toString(),
+      status = Enumeration(value = Observation.ObservationStatus.Final),
+      code = code,
+      subject = patientRef,
+      encounter = encounterRef,
+      effective = effective,
+      value = value?.let { Observation.Value.Quantity(it) },
+      component = components,
+    )
+
+  val resources = buildList {
+    add(
+      Encounter(
+        id = encounterId,
+        status = Enumeration(value = Encounter.EncounterStatus.Finished),
+        `class` = Coding(
+          system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"),
+          code = Code(value = "AMB"),
+          display = FhirString(value = "ambulatory"),
+        ),
+        type = listOf(CodeableConcept(text = FhirString(value = "Antenatal care contact"))),
+        subject = patientRef,
+        period = Period(
+          start = DateTime(value = FhirDateTime.fromString(date)),
+          end = DateTime(value = FhirDateTime.fromString(date)),
+        ),
+      )
+    )
+    if (weight != null) add(observation(loinc(WEIGHT, "Body weight"), quantity(weight, "kg", "kg")))
+    if (sys != null || dia != null) {
+      add(
+        observation(
+          loinc(BP_PANEL, "Blood pressure"),
+          null,
+          listOfNotNull(
+            sys?.let { Observation.Component(code = loinc(SYSTOLIC, "Systolic blood pressure"), value = Observation.Component.Value.Quantity(quantity(BigDecimal.fromInt(it), "mmHg", "mm[Hg]"))) },
+            dia?.let { Observation.Component(code = loinc(DIASTOLIC, "Diastolic blood pressure"), value = Observation.Component.Value.Quantity(quantity(BigDecimal.fromInt(it), "mmHg", "mm[Hg]"))) },
+          ),
+        )
+      )
+    }
+    // Gestational age, danger signs and notes live in the response itself.
+    add(
+      response.toBuilder().apply {
+        id = UUID.randomUUID().toString()
+        status = Enumeration(value = QuestionnaireResponse.QuestionnaireResponseStatus.Completed)
+        subject = patientRef.toBuilder()
+        encounter = encounterRef.toBuilder()
+        questionnaire = Canonical(value = QUESTIONNAIRE_URL).toBuilder()
+      }.build()
+    )
+  }
+  engine.create(*resources.toTypedArray())
+}
