+@Composable
+fun RegisterScreen(onOpen: (String) -> Unit) {
+  val context = LocalContext.current
+  var rows by remember { mutableStateOf<List<RegisterRow>?>(null) }
+  var status by remember { mutableStateOf("Syncing…") }
+  LaunchedEffect(Unit) {
+    rows = loadRegister(engine(context))
+    status = if (sync(context)) "" else "Sync failed — showing data stored on this device"
+    rows = loadRegister(engine(context))
+  }
+  Column(Modifier.padding(16.dp)) {
+    Text("ANC Register", style = MaterialTheme.typography.headlineSmall)
+    if (status.isNotEmpty()) Text(status, style = MaterialTheme.typography.bodySmall)
+    LazyColumn {
+      items(rows.orEmpty(), key = { it.id }) { r ->
+        Column(Modifier.fillMaxWidth().clickable { onOpen(r.id) }.padding(vertical = 12.dp)) {
+          Text(r.name, style = MaterialTheme.typography.titleMedium)
+          Text("Age ${r.age ?: "?"} · Due ${r.edd} · ${r.weeks} weeks")
+        }
+        HorizontalDivider()
+      }
+    }
+  }
+}
+
+@Composable
+fun PatientScreen(patientId: String, onNewVisit: () -> Unit) {
+  val context = LocalContext.current
+  var data by remember { mutableStateOf<Pair<String, List<Visit>>?>(null) }
+  LaunchedEffect(patientId) { data = loadVisits(engine(context), patientId) }
+  Column(Modifier.padding(16.dp)) {
+    Row {
+      Text(data?.first ?: "", style = MaterialTheme.typography.headlineSmall, modifier = Modifier.weight(1f))
+      Button(onClick = onNewVisit) { Text("New visit") }
+    }
+    Spacer(Modifier.padding(8.dp))
+    Text("ANC visits", style = MaterialTheme.typography.titleMedium)
+    LazyColumn {
+      items(data?.second.orEmpty()) { v ->
+        Column(Modifier.padding(vertical = 8.dp)) {
+          Text(v.date, style = MaterialTheme.typography.titleSmall)
+          Text(
+            listOfNotNull(
+              v.weight?.let { "Weight $it kg" },
+              v.bp?.let { "BP $it mmHg" },
+              v.hb?.let { "Hb $it g/dL" },
+            ).joinToString(" · ").ifEmpty { "No measurements" }
+          )
+        }
+        HorizontalDivider()
+      }
+    }
+  }
+}
+
+@Composable
+fun NewVisitScreen(patientId: String, onDone: () -> Unit) {
+  val context = LocalContext.current
+  val scope = rememberCoroutineScope()
+  var questionnaireJson by remember { mutableStateOf<String?>(null) }
+  var error by remember { mutableStateOf<String?>(null) }
+  LaunchedEffect(Unit) {
+    val e = engine(context)
+    val q = runCatching { e.get<FhirQuestionnaire>(QUESTIONNAIRE_ID) }.getOrNull()
+      ?: run { sync(context); runCatching { e.get<FhirQuestionnaire>(QUESTIONNAIRE_ID) }.getOrNull() }
+    if (q == null) error = "Visit form not available yet — connect to the server and try again." else questionnaireJson = json.encodeToString(q)
+  }
+  when {
+    error != null -> Text(error!!, Modifier.padding(16.dp))
+    questionnaireJson == null -> Text("Loading form…", Modifier.padding(16.dp))
+    else -> Questionnaire(
+      questionnaireJson = questionnaireJson!!,
+      onSubmit = { getResponse ->
+        scope.launch {
+          val response = try { getResponse() } catch (e: CancellationException) { return@launch }
+          saveVisit(engine(context), patientId, response)
+          // Upload in the background; the app scope outlives this screen.
+          kotlinx.coroutines.MainScope().launch { sync(context, ExistingWorkPolicy.APPEND_OR_REPLACE) }
+          onDone()
+        }
+      },
+      onCancel = onDone,
+    )
   }
 }
