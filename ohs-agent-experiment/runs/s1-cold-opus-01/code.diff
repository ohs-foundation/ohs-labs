+package com.example.ancapp.ui
+
+import androidx.compose.runtime.Composable
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewmodel.CreationExtras
+import androidx.lifecycle.viewmodel.compose.viewModel
+import androidx.lifecycle.viewmodel.initializer
+import androidx.lifecycle.viewmodel.viewModelFactory
+import androidx.navigation.NavType
+import androidx.navigation.compose.NavHost
+import androidx.navigation.compose.composable
+import androidx.navigation.compose.rememberNavController
+import androidx.navigation.navArgument
+import com.example.ancapp.data.AncRepository
+import com.example.ancapp.ui.detail.PatientDetailScreen
+import com.example.ancapp.ui.detail.PatientDetailViewModel
+import com.example.ancapp.ui.register.RegisterScreen
+import com.example.ancapp.ui.register.RegisterViewModel
+import com.example.ancapp.ui.visit.RecordVisitScreen
+import com.example.ancapp.ui.visit.RecordVisitViewModel
+
+private object Routes {
+  const val REGISTER = "register"
+  const val PATIENT = "patient/{patientId}"
+  const val NEW_VISIT = "patient/{patientId}/visits/new"
+
+  fun patient(patientId: Long) = "patient/$patientId"
+  fun newVisit(patientId: Long) = "patient/$patientId/visits/new"
+}
+
+private const val ARG_PATIENT_ID = "patientId"
+
+@Composable
+fun AncApp(repository: AncRepository) {
+  val navController = rememberNavController()
+
+  NavHost(navController = navController, startDestination = Routes.REGISTER) {
+
+    composable(Routes.REGISTER) {
+      RegisterScreen(
+        viewModel = viewModel(factory = factoryOf { RegisterViewModel(repository) }),
+        onPatientClick = { navController.navigate(Routes.patient(it)) },
+      )
+    }
+
+    composable(
+      route = Routes.PATIENT,
+      arguments = listOf(navArgument(ARG_PATIENT_ID) { type = NavType.LongType }),
+    ) { entry ->
+      val patientId = entry.arguments!!.getLong(ARG_PATIENT_ID)
+      PatientDetailScreen(
+        viewModel = viewModel(
+          factory = factoryOf { PatientDetailViewModel(repository, patientId) },
+        ),
+        onBack = navController::popBackStack,
+        onRecordVisit = { navController.navigate(Routes.newVisit(patientId)) },
+      )
+    }
+
+    composable(
+      route = Routes.NEW_VISIT,
+      arguments = listOf(navArgument(ARG_PATIENT_ID) { type = NavType.LongType }),
+    ) { entry ->
+      val patientId = entry.arguments!!.getLong(ARG_PATIENT_ID)
+      RecordVisitScreen(
+        viewModel = viewModel(
+          factory = factoryOf { RecordVisitViewModel(repository, patientId) },
+        ),
+        onBack = navController::popBackStack,
+        // Straight back to the patient's visit list, where the new visit is now showing.
+        onSaved = { navController.popBackStack() },
+      )
+    }
+  }
+}
+
+private inline fun <reified VM : ViewModel> factoryOf(
+  crossinline create: (CreationExtras) -> VM,
+) = viewModelFactory { initializer { create(this) } }
