+import androidx.room.PrimaryKey
+import java.time.LocalDate
+
+@Entity(
+  tableName = "visits",
+  foreignKeys = [
+    ForeignKey(
+      entity = Patient::class,
+      parentColumns = ["id"],
+      childColumns = ["patientId"],
+      onDelete = ForeignKey.CASCADE,
+    )
+  ],
+  indices = [Index("patientId")],
+)
+data class AncVisit(
+  @PrimaryKey(autoGenerate = true) val id: Long = 0,
+  val patientId: Long,
+  val visitDate: LocalDate,
+  val gestationalAgeWeeks: Int,
+  val weightKg: Double,
+  val systolic: Int,
+  val diastolic: Int,
+  /** Only measured at some visits, so absent rather than zero when not taken. */
+  val hemoglobin: Double? = null,
+  val dangerSigns: Set<DangerSign> = emptySet(),
+  val notes: String = "",
+)
