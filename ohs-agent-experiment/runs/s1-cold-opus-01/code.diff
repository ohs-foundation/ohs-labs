+package com.example.ancapp.data
+
+import com.example.ancapp.domain.Gestation
+import java.time.LocalDate
+
+/**
+ * The patients the clinic already has on file, plus each one's most recent ANC visit. Written
+ * to the database once, the first time the app is opened on a device.
+ */
+internal object SeedData {
+
+  private data class Row(
+    val name: String,
+    val dateOfBirth: LocalDate,
+    val estimatedDueDate: LocalDate,
+    val lastVisit: LocalDate,
+    val weightKg: Double,
+    val systolic: Int,
+    val diastolic: Int,
+    val hemoglobin: Double,
+  )
+
+  private val rows = listOf(
+    Row(
+      name = "Emily Carter",
+      dateOfBirth = LocalDate.of(1996, 4, 12),
+      estimatedDueDate = LocalDate.of(2026, 12, 5),
+      lastVisit = LocalDate.of(2026, 8, 10),
+      weightKg = 68.5,
+      systolic = 118,
+      diastolic = 76,
+      hemoglobin = 11.8,
+    ),
+    Row(
+      name = "Sarah Mitchell",
+      dateOfBirth = LocalDate.of(1990, 11, 2),
+      estimatedDueDate = LocalDate.of(2027, 1, 20),
+      lastVisit = LocalDate.of(2026, 8, 12),
+      weightKg = 61.2,
+      systolic = 110,
+      diastolic = 70,
+      hemoglobin = 12.4,
+    ),
+    Row(
+      name = "Grace Thompson",
+      dateOfBirth = LocalDate.of(2001, 7, 30),
+      estimatedDueDate = LocalDate.of(2026, 10, 15),
+      lastVisit = LocalDate.of(2026, 8, 5),
+      weightKg = 72.0,
+      systolic = 128,
+      diastolic = 84,
+      hemoglobin = 10.2,
+    ),
+  )
+
+  /** Each patient paired with the visit to file against her, once she has an id. */
+  fun patientsWithVisits(): List<Pair<Patient, (Long) -> AncVisit>> = rows.map { row ->
+    val patient = Patient(
+      name = row.name,
+      dateOfBirth = row.dateOfBirth,
+      estimatedDueDate = row.estimatedDueDate,
+    )
+    patient to { patientId: Long ->
+      AncVisit(
+        patientId = patientId,
+        visitDate = row.lastVisit,
+        // Derived from the due date so the record stays internally consistent.
+        gestationalAgeWeeks = Gestation.weeksOn(row.estimatedDueDate, row.lastVisit),
+        weightKg = row.weightKg,
+        systolic = row.systolic,
+        diastolic = row.diastolic,
+        hemoglobin = row.hemoglobin,
+      )
+    }
+  }
+}
