+package com.example.ancapp
+
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.IOException
+import java.net.HttpURLConnection
+import java.net.URL
+import java.time.LocalDate
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+
+// 10.0.2.2 is the Android emulator's alias for the host machine.
+private const val BASE = "http://10.0.2.2:8080/fhir"
+private const val LOINC = "http://loinc.org"
+private const val LOCAL = "urn:example:anc-form"
+private const val LOINC_EDD = "11778-8"
+private const val LOINC_WEIGHT = "29463-7"
+private const val LOINC_BP = "85354-9"
+private const val LOINC_SYSTOLIC = "8480-6"
+private const val LOINC_DIASTOLIC = "8462-4"
+private const val LOINC_HB = "718-7"
+private const val LOINC_GA = "18185-9"
+
+data class Coding(val system: String, val code: String, val display: String)
+
+data class Patient(
+  val id: String,
+  val name: String,
+  val birthDate: LocalDate,
+  val dueDate: LocalDate,
+) {
+  val age: Int get() = ChronoUnit.YEARS.between(birthDate, LocalDate.now()).toInt()
+
+  // Gestation is 280 days minus the days remaining until the estimated due date.
+  val weeks: Int get() = ((280 - ChronoUnit.DAYS.between(LocalDate.now(), dueDate)) / 7).toInt()
+}
+
+data class Visit(
+  val id: String,
+  val date: LocalDate,
+  val weight: Double?,
+  val systolic: Int?,
+  val diastolic: Int?,
+  val hb: Double?,
+  val dangerSigns: List<String>,
+  val notes: String?,
+)
+
+data class QuestionItem(
+  val linkId: String,
+  val text: String,
+  val type: String,
+  val required: Boolean,
+  val options: List<Coding>,
+)
+
+data class VisitInput(
+  val date: LocalDate,
+  val gestationalWeeks: Int,
+  val weightKg: Double,
+  val systolic: Int,
+  val diastolic: Int,
+  val dangerSigns: List<Coding>,
+  val notes: String,
+)
+
+// Patients with an estimated due date on or after today, soonest first.
+fun loadPregnantPatients(): List<Patient> {
+  val today = LocalDate.now()
+  val dueByPatient = get("Observation?code=$LOINC_EDD&_count=500").resources()
+    .groupBy { it.refId("subject") }
+    .mapValues { (_, obs) ->
+      LocalDate.parse(obs.maxBy { it.optString("effectiveDateTime") }.getString("valueDateTime"))
+    }
+  return get("Patient?_count=500").resources().mapNotNull { p ->
+    val due = dueByPatient[p.getString("id")] ?: return@mapNotNull null
+    if (due < today) null else p.toPatient(due)
+  }.sortedBy { it.dueDate }
+}
+
+fun loadVisits(patientId: String): List<Visit> {
+  val resources = get("Encounter?subject=Patient/$patientId&_revinclude=Observation:encounter&_count=200")
+    .resources()
+  val obsByEncounter = resources
+    .filter { it.getString("resourceType") == "Observation" }
+    .groupBy { it.refId("encounter") }
+  return resources
+    .filter { it.getString("resourceType") == "Encounter" }
+    .map { enc ->
+      val obs = obsByEncounter[enc.getString("id")].orEmpty()
+      val bp = obs.byCode(LOINC_BP)
+      val danger = obs.byCode("danger-signs")?.optJSONObject("valueCodeableConcept")?.optJSONArray("coding")
+      Visit(
+        id = enc.getString("id"),
+        date = LocalDate.parse(enc.getJSONObject("period").getString("start")),
+        weight = obs.byCode(LOINC_WEIGHT)?.quantity(),
+        systolic = bp?.component(LOINC_SYSTOLIC)?.toInt(),
+        diastolic = bp?.component(LOINC_DIASTOLIC)?.toInt(),
+        hb = obs.byCode(LOINC_HB)?.quantity(),
+        dangerSigns = danger.objects().map { it.optString("display") },
+        notes = obs.byCode("notes")?.optString("valueString")?.ifEmpty { null },
+      )
+    }
+    .sortedByDescending { it.date }
+}
+
+fun loadQuestionnaire(): List<QuestionItem> =
+  get("Questionnaire/anc-contact").optJSONArray("item").questionItems()
+
+// Saves one visit as an Encounter plus Observations in a single transaction.
+fun saveVisit(patientId: String, v: VisitInput) {
+  val entries = JSONArray()
+  val patientRef = ref("Patient/$patientId")
+  val encounter = entries.add(
+    JSONObject()
+      .put("resourceType", "Encounter")
+      .put("status", "finished")
+      .put(
+        "class",
+        JSONObject()
+          .put("system", "http://terminology.hl7.org/CodeSystem/v3-ActCode")
+          .put("code", "AMB")
+          .put("display", "ambulatory"),
+      )
+      .put("type", JSONArray().put(JSONObject().put("text", "Antenatal care contact")))
+      .put("subject", patientRef)
+      .put(
+        "period",
+        JSONObject().put("start", v.date.toString()).put("end", v.date.toString()),
+      ),
+  )
+
+  fun observation(code: JSONObject, body: JSONObject.() -> Unit) = entries.add(
+    JSONObject()
+      .put("resourceType", "Observation")
+      .put("status", "final")
+      .put("code", code)
+      .put("subject", patientRef)
+      .put("encounter", ref(encounter))
+      .put("effectiveDateTime", v.date.toString())
+      .apply(body),
+  )
+
+  observation(concept(LOINC, LOINC_GA, "Gestational age")) {
+    put("valueInteger", v.gestationalWeeks)
+  }
+  observation(concept(LOINC, LOINC_WEIGHT, "Body weight")) {
+    put("valueQuantity", quantity(v.weightKg, "kg", "kg"))
+  }
+  observation(concept(LOINC, LOINC_BP, "Blood pressure panel with all children optional")) {
+    put(
+      "component",
+      JSONArray()
+        .put(
+          JSONObject()
+            .put("code", concept(LOINC, LOINC_SYSTOLIC, "Systolic blood pressure"))
+            .put("valueQuantity", quantity(v.systolic, "mmHg", "mm[Hg]")),
+        )
+        .put(
+          JSONObject()
+            .put("code", concept(LOINC, LOINC_DIASTOLIC, "Diastolic blood pressure"))
+            .put("valueQuantity", quantity(v.diastolic, "mmHg", "mm[Hg]")),
+        ),
+    )
+  }
+  if (v.dangerSigns.isNotEmpty()) {
+    observation(concept(LOCAL, "danger-signs", "Danger signs present")) {
+      put(
+        "valueCodeableConcept",
+        JSONObject().put(
+          "coding",
+          JSONArray(v.dangerSigns.map {
+            JSONObject().put("system", it.system).put("code", it.code).put("display", it.display)
+          }),
+        ),
+      )
+    }
+  }
+  if (v.notes.isNotBlank()) {
+    observation(concept(LOCAL, "notes", "Notes")) { put("valueString", v.notes) }
+  }
+
+  request(
+    "POST",
+    "",
+    JSONObject().put("resourceType", "Bundle").put("type", "transaction").put("entry", entries),
+  )
+}
+
+private fun get(path: String) = request("GET", path)
+
+private fun request(method: String, path: String, body: JSONObject? = null): JSONObject {
+  val conn = (URL("$BASE/$path").openConnection() as HttpURLConnection).apply {
+    requestMethod = method
+    connectTimeout = 10_000
+    readTimeout = 10_000
+    setRequestProperty("Accept", "application/fhir+json")
+    if (body != null) {
+      doOutput = true
+      setRequestProperty("Content-Type", "application/fhir+json")
+      outputStream.use { it.write(body.toString().toByteArray()) }
+    }
+  }
+  try {
+    val code = conn.responseCode
+    val stream = if (code < 400) conn.inputStream else conn.errorStream
+    val text = stream?.bufferedReader()?.use { it.readText() }.orEmpty()
+    if (code >= 400) throw IOException("HTTP $code from $method $path: $text")
+    return JSONObject(text)
+  } finally {
+    conn.disconnect()
+  }
+}
+
+private fun JSONArray?.objects(): List<JSONObject> =
+  this?.let { arr -> List(arr.length()) { arr.getJSONObject(it) } }.orEmpty()
+
+private fun JSONObject.resources(): List<JSONObject> =
+  optJSONArray("entry").objects().map { it.getJSONObject("resource") }
+
+private fun JSONObject.refId(field: String): String =
+  optJSONObject(field)?.optString("reference").orEmpty().substringAfter("/")
+
+private fun ref(url: String) = JSONObject().put("reference", url)
+
+private fun List<JSONObject>.byCode(code: String): JSONObject? = firstOrNull { it.codeOf() == code }
+
+private fun JSONObject.codeOf(): String? =
+  optJSONObject("code")?.optJSONArray("coding")?.optJSONObject(0)?.optString("code")
+
+private fun JSONObject.quantity(): Double? =
+  optJSONObject("valueQuantity")?.optDouble("value")?.takeUnless { it.isNaN() }
+
+private fun JSONObject.component(code: String): Double? =
+  optJSONArray("component").objects().firstOrNull { it.codeOf() == code }?.quantity()
+
+private fun JSONObject.toPatient(due: LocalDate): Patient {
+  val name = optJSONArray("name")?.optJSONObject(0)
+  val given = name?.optJSONArray("given")?.optString(0).orEmpty()
+  return Patient(
+    id = getString("id"),
+    name = "$given ${name?.optString("family").orEmpty()}".trim(),
+    birthDate = LocalDate.parse(getString("birthDate")),
+    dueDate = due,
+  )
+}
+
+private fun JSONArray?.questionItems(): List<QuestionItem> = objects().flatMap { item ->
+  if (item.optString("type") == "group") {
+    item.optJSONArray("item").questionItems()
+  } else {
+    val options = item.optJSONArray("answerOption").objects().mapNotNull { opt ->
+      opt.optJSONObject("valueCoding")?.let {
+        Coding(it.getString("system"), it.getString("code"), it.getString("display"))
+      }
+    }
+    listOf(
+      QuestionItem(
+        linkId = item.getString("linkId"),
+        text = item.optString("text"),
+        type = item.getString("type"),
+        required = item.optBoolean("required"),
+        options = options,
+      ),
+    )
+  }
+}
+
+private fun JSONArray.add(resource: JSONObject): String {
+  val fullUrl = "urn:uuid:${UUID.randomUUID()}"
+  put(
+    JSONObject()
+      .put("fullUrl", fullUrl)
+      .put("resource", resource)
+      .put("request", JSONObject().put("method", "POST").put("url", resource.getString("resourceType"))),
+  )
+  return fullUrl
+}
+
+private fun concept(system: String, code: String, display: String) = JSONObject().put(
+  "coding",
+  JSONArray().put(JSONObject().put("system", system).put("code", code).put("display", display)),
+)
+
+private fun quantity(value: Number, unit: String, ucumCode: String) = JSONObject()
+  .put("value", value)
+  .put("unit", unit)
+  .put("system", "http://unitsofmeasure.org")
+  .put("code", ucumCode)
