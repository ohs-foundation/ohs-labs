+@Composable
+private fun VisitCard(v: Visit) {
+  Card(Modifier.fillMaxWidth()) {
+    Column(Modifier.padding(16.dp)) {
+      Text(v.date + (v.gaWeeks?.let { " · GA $it weeks" } ?: ""), style = MaterialTheme.typography.titleSmall)
+      Text("Weight: ${v.weight?.let { "$it kg" } ?: "—"}")
+      Text("BP: ${if (v.systolic != null && v.diastolic != null) "${v.systolic}/${v.diastolic} mmHg" else "—"}")
+      v.hb?.let { Text("Hb: $it g/dL") }
+      if (v.dangerSigns.isNotEmpty()) {
+        val none = v.dangerSigns.all { it.equals("None", true) }
+        Text(
+          "Danger signs: ${v.dangerSigns.joinToString()}",
+          color = if (none) MaterialTheme.colorScheme.onSurface else MaterialTheme.colorScheme.error,
+        )
+      }
+      v.notes?.let { Text("Notes: $it") }
+    }
+  }
+}
+
+@Composable
+fun VisitFormScreen(patient: Patient, onBack: () -> Unit) {
+  Screen("New visit · ${patient.name}", onBack = onBack) { modifier ->
+    Loading(Unit, modifier, ::loadQuestionnaire) { q -> QuestionnaireForm(q, patient, modifier, onBack) }
+  }
+}
+
+/** Renders the FHIR Questionnaire generically; raw values are String (text fields) or Set<String> (choice codes). */
+@Composable
+private fun QuestionnaireForm(q: JSONObject, patient: Patient, modifier: Modifier, onSaved: () -> Unit) {
+  val values = remember {
+    mutableStateMapOf<String, Any>(
+      "visit-date" to LocalDate.now().toString(),
+      "gestational-age" to (patient.gaDays() / 7).toString(),
+    )
+  }
+  var errors by remember { mutableStateOf(emptyMap<String, String>()) }
+  var saving by remember { mutableStateOf(false) }
+  var saveError by remember { mutableStateOf<String?>(null) }
+  val scope = rememberCoroutineScope()
+
+  Column(modifier.imePadding().verticalScroll(rememberScrollState()).padding(16.dp), Arrangement.spacedBy(8.dp)) {
+    q.optString("title").takeIf { it.isNotEmpty() }?.let { Text(it, style = MaterialTheme.typography.titleLarge) }
+    val items = q.getJSONArray("item")
+    for (i in 0 until items.length()) QItem(items.getJSONObject(i), values, errors)
+    saveError?.let { Text(it, color = MaterialTheme.colorScheme.error) }
+    Button(
+      enabled = !saving,
+      modifier = Modifier.fillMaxWidth(),
+      onClick = {
+        val (typed, errs) = validate(q, values)
+        errors = errs
+        if (errs.isNotEmpty()) return@Button
+        saving = true
+        saveError = null
+        scope.launch {
+          val r = withContext(Dispatchers.IO) { runCatching { saveVisit(patient.id, q, typed) } }
+          saving = false
+          if (r.isSuccess) onSaved() else saveError = "Not saved: ${r.exceptionOrNull()?.message}"
+        }
+      },
+    ) { Text(if (saving) "Saving…" else "Save visit") }
+    if (errors.isNotEmpty()) Text("Please fix the highlighted fields", color = MaterialTheme.colorScheme.error)
+  }
+}
+
+@Composable
+private fun QItem(item: JSONObject, values: SnapshotStateMap<String, Any>, errors: Map<String, String>) {
+  val id = item.getString("linkId")
+  val type = item.getString("type")
+  val label = item.optString("text", id) + if (item.optBoolean("required")) " *" else ""
+  val error = errors[id]
+  when (type) {
+    "group" -> {
+      Text(label, style = MaterialTheme.typography.titleMedium, modifier = Modifier.padding(top = 8.dp))
+      val children = item.getJSONArray("item")
+      for (i in 0 until children.length()) QItem(children.getJSONObject(i), values, errors)
+    }
+    "choice" -> {
+      Text(label, style = MaterialTheme.typography.titleMedium, modifier = Modifier.padding(top = 8.dp))
+      @Suppress("UNCHECKED_CAST") val selected = values[id] as? Set<String> ?: emptySet()
+      val options = item.optJSONArray("answerOption")
+      for (i in 0 until (options?.length() ?: 0)) {
+        val coding = options!!.getJSONObject(i).getJSONObject("valueCoding")
+        val code = coding.getString("code")
+        val checked = code in selected
+        Row(
+          Modifier.fillMaxWidth().toggleable(checked, role = Role.Checkbox) { on ->
+            values[id] = when {
+              !item.optBoolean("repeats") -> if (on) setOf(code) else emptySet()
+              // "None" is exclusive with the actual signs
+              on && code == "none" -> setOf(code)
+              on -> selected - "none" + code
+              else -> selected - code
+            }
+          },
+          verticalAlignment = Alignment.CenterVertically,
+        ) {
+          Checkbox(checked, onCheckedChange = null)
+          Text(coding.optString("display", code), Modifier.padding(start = 8.dp))
+        }
+      }
+      error?.let { Text(it, color = MaterialTheme.colorScheme.error) }
+    }
+    else -> OutlinedTextField(
+      value = values[id] as? String ?: "",
+      onValueChange = { values[id] = it },
+      label = { Text(label) },
+      placeholder = if (type == "date") ({ Text("YYYY-MM-DD") }) else null,
+      singleLine = type != "text",
+      minLines = if (type == "text") 3 else 1,
+      isError = error != null,
+      supportingText = error?.let { { Text(it) } },
+      keyboardOptions = KeyboardOptions(
+        keyboardType = when (type) {
+          "integer" -> KeyboardType.Number
+          "decimal" -> KeyboardType.Decimal
+          else -> KeyboardType.Text
+        }
+      ),
+      modifier = Modifier.fillMaxWidth(),
+    )
   }
 }
