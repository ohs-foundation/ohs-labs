 class MainActivity : ComponentActivity() {
   override fun onCreate(savedInstanceState: Bundle?) {
     super.onCreate(savedInstanceState)
-    setContent { MaterialTheme { Surface { Text("Hello") } } }
+    setContent { MaterialTheme { Surface(Modifier.fillMaxSize()) { AncNavigation() } } }
   }
 }
+
+private sealed interface Screen {
+  data object Register : Screen
+  data class Detail(val pregnancy: Pregnancy) : Screen
+  // Plain class on purpose: each visit gets its own instance (see NewVisitScreen).
+  class NewVisit(val pregnancy: Pregnancy) : Screen
+}
+
+@Composable
+private fun AncNavigation() {
+  var screen by remember { mutableStateOf<Screen>(Screen.Register) }
+  BackHandler(enabled = screen !is Screen.Register) {
+    screen = when (val s = screen) {
+      is Screen.NewVisit -> Screen.Detail(s.pregnancy)
+      else -> Screen.Register
+    }
+  }
+  when (val s = screen) {
+    Screen.Register -> RegisterScreen(onOpen = { screen = Screen.Detail(it) })
+    is Screen.Detail -> DetailScreen(s.pregnancy, onNewVisit = { screen = Screen.NewVisit(s.pregnancy) })
+    is Screen.NewVisit -> NewVisitScreen(s.pregnancy, onDone = { screen = Screen.Detail(s.pregnancy) })
+  }
+}
+
+/** Runs [load] off the main thread and exposes its Result (null while loading). */
+@Composable
+private fun <T> loadState(key: Any?, load: () -> T): State<Result<T>?> =
+  produceState<Result<T>?>(null, key) {
+    value = withContext(Dispatchers.IO) { runCatching(load) }
+  }
+
+@Composable
+private fun RegisterScreen(onOpen: (Pregnancy) -> Unit) {
+  val state by loadState(Unit) { fetchRegister(LocalDate.now()) }
+  val result = state
+  LazyColumn(
+    Modifier.fillMaxSize(),
+    contentPadding = PaddingValues(16.dp),
+    verticalArrangement = Arrangement.spacedBy(8.dp),
+  ) {
+    item { Text("Pregnant patients", style = MaterialTheme.typography.headlineSmall) }
+    when {
+      result == null -> item { CircularProgressIndicator() }
+      result.isFailure -> item { ErrorText(result.exceptionOrNull()) }
+      result.getOrThrow().isEmpty() -> item { Text("No patients currently pregnant.") }
+      else -> items(result.getOrThrow(), key = { it.patient.id }) { p ->
+        Card(onClick = { onOpen(p) }, modifier = Modifier.fillMaxWidth()) {
+          Column(Modifier.padding(16.dp)) {
+            Text(p.patient.name, style = MaterialTheme.typography.titleMedium)
+            Text("Age ${age(p.patient)} · Due ${p.dueDate} · ${gestation(p)}")
+          }
+        }
+      }
+    }
+  }
+}
+
+@Composable
+private fun DetailScreen(pregnancy: Pregnancy, onNewVisit: () -> Unit) {
+  val state by loadState(pregnancy.patient.id) { fetchVisits(pregnancy.patient.id) }
+  val result = state
+  LazyColumn(
+    Modifier.fillMaxSize(),
+    contentPadding = PaddingValues(16.dp),
+    verticalArrangement = Arrangement.spacedBy(8.dp),
+  ) {
+    item {
+      Text(pregnancy.patient.name, style = MaterialTheme.typography.headlineSmall)
+      Text("Age ${age(pregnancy.patient)} · Due ${pregnancy.dueDate} · ${gestation(pregnancy)}")
+    }
+    item { Button(onClick = onNewVisit) { Text("Record ANC visit") } }
+    item { Text("Past visits", style = MaterialTheme.typography.titleMedium) }
+    when {
+      result == null -> item { CircularProgressIndicator() }
+      result.isFailure -> item { ErrorText(result.exceptionOrNull()) }
+      result.getOrThrow().isEmpty() -> item { Text("No visits recorded yet.") }
+      else -> items(result.getOrThrow()) { VisitCard(it) }
+    }
+  }
+}
+
+@Composable
+private fun VisitCard(v: Visit) {
+  Card(Modifier.fillMaxWidth()) {
+    Column(Modifier.padding(16.dp)) {
+      Text(v.date.toString(), style = MaterialTheme.typography.titleMedium)
+      Text("Weight: ${v.weightKg?.let { "$it kg" } ?: "—"}")
+      val bp = if (v.systolic != null && v.diastolic != null) "${v.systolic.toInt()}/${v.diastolic.toInt()} mmHg" else "—"
+      Text("Blood pressure: $bp")
+      v.hemoglobin?.let { Text("Hemoglobin: $it g/dL") }
+      if (v.dangerSigns.isNotEmpty()) Text("Danger signs: ${v.dangerSigns.joinToString()}")
+      v.notes?.let { Text("Notes: $it") }
+    }
+  }
+}
+
+@Composable
+private fun NewVisitScreen(pregnancy: Pregnancy, onDone: () -> Unit) {
+  val questionnaire by loadState(Unit) { fetchQuestionnaire() }
+  val scope = rememberCoroutineScope()
+  var saveError by remember { mutableStateOf<String?>(null) }
+  // A fresh store per visit: DataCapture caches its view-model by questionnaire JSON in the
+  // current owner, so reusing the Activity's store would show the previous visit's answers.
+  val formOwner = remember { FormOwner() }
+  DisposableEffect(formOwner) { onDispose { formOwner.viewModelStore.clear() } }
+
+  Column(Modifier.fillMaxSize().padding(16.dp)) {
+    Text("New ANC visit: ${pregnancy.patient.name}", style = MaterialTheme.typography.headlineSmall)
+    saveError?.let { Text(it, color = MaterialTheme.colorScheme.error) }
+    val result = questionnaire
+    Box(Modifier.weight(1f)) {
+      when {
+        result == null -> CircularProgressIndicator()
+        result.isFailure -> ErrorText(result.exceptionOrNull())
+        else -> CompositionLocalProvider(LocalViewModelStoreOwner provides formOwner) {
+          Questionnaire(
+            questionnaireJson = result.getOrThrow(),
+            onSubmit = { getResponse ->
+              scope.launch {
+                val response = try {
+                  getResponse()
+                } catch (e: CancellationException) {
+                  return@launch // validation failed; the form already shows the errors
+                }
+                runCatching { withContext(Dispatchers.IO) { saveVisit(pregnancy.patient.id, response) } }
+                  .onSuccess { onDone() }
+                  .onFailure { saveError = "Could not save visit: ${it.message}" }
+              }
+            },
+            onCancel = onDone,
+          )
+        }
+      }
+    }
+  }
+}
+
+private class FormOwner : ViewModelStoreOwner {
+  override val viewModelStore = ViewModelStore()
+}
+
+@Composable
+private fun ErrorText(e: Throwable?) = Text("Error: ${e?.message}", color = MaterialTheme.colorScheme.error)
+
+private fun age(p: Patient): String = p.birthDate?.let { ChronoUnit.YEARS.between(it, LocalDate.now()).toString() } ?: "unknown"
+
+private fun gestation(p: Pregnancy): String {
+  val days = p.gestationDays(LocalDate.now())
+  return "${days / 7}w ${days % 7}d"
+}
