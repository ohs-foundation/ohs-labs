+
+private sealed interface Screen {
+  data object Register : Screen
+  data class Detail(val patient: Patient) : Screen
+  data class Form(val patient: Patient) : Screen
+}
+
+@Composable
+private fun App() {
+  var screen: Screen by remember { mutableStateOf(Screen.Register) }
+  var version by remember { mutableStateOf(0) } // bump to reload data after a save/sync
+  val context = LocalContext.current
+  LaunchedEffect(Unit) {
+    if (!Fhir.sync(context)) Toast.makeText(context, "Sync failed, showing local data", Toast.LENGTH_LONG).show()
+    version++
+  }
+  if (version == 0) return Loading()
+  when (val s = screen) {
+    Screen.Register -> RegisterScreen(version) { screen = Screen.Detail(it) }
+    is Screen.Detail -> {
+      BackHandler { screen = Screen.Register }
+      DetailScreen(s.patient, version) { screen = Screen.Form(s.patient) }
+    }
+    is Screen.Form -> {
+      BackHandler { screen = Screen.Detail(s.patient) }
+      FormScreen(s.patient, onDone = { saved ->
+        if (saved) version++
+        screen = Screen.Detail(s.patient)
+      })
+    }
+  }
+}
+
+private class RegisterRow(val patient: Patient, val edd: LocalDate?)
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+private fun RegisterScreen(version: Int, onOpen: (Patient) -> Unit) {
+  var rows by remember { mutableStateOf<List<RegisterRow>?>(null) }
+  LaunchedEffect(version) {
+    val eddByPatient = Fhir.observations().groupBy { it.subject?.reference?.value }.mapValues { it.value.dueDate() }
+    rows = Fhir.patients().map { RegisterRow(it, eddByPatient["Patient/${it.id}"]) }
+      .sortedWith(compareBy(nullsLast()) { it.edd })
+  }
+  Scaffold(topBar = { TopAppBar(title = { Text("ANC Register") }) }) { pad ->
+    val list = rows ?: return@Scaffold Loading(pad)
+    LazyColumn(Modifier.padding(pad).fillMaxSize()) {
+      items(list, key = { it.patient.id!! }) { row ->
+        Column(Modifier.fillMaxWidth().clickable { onOpen(row.patient) }.padding(16.dp)) {
+          Text(row.patient.displayName(), style = MaterialTheme.typography.titleMedium)
+          Text("Age ${row.patient.ageYears() ?: "?"} · EDD ${row.edd ?: "unknown"} · ${row.edd?.let { "${gestationalWeeks(it)} weeks" } ?: "? weeks"}")
+        }
+        HorizontalDivider()
+      }
+    }
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+private fun DetailScreen(patient: Patient, version: Int, onNewVisit: () -> Unit) {
+  var obs by remember { mutableStateOf<List<Observation>?>(null) }
+  LaunchedEffect(version) { obs = Fhir.observations(patient.id!!) }
+  Scaffold(topBar = { TopAppBar(title = { Text(patient.displayName()) }) }) { pad ->
+    val list = obs ?: return@Scaffold Loading(pad)
+    Column(Modifier.padding(pad).fillMaxSize()) {
+      val edd = list.dueDate()
+      Text("Age ${patient.ageYears() ?: "?"} · EDD ${edd ?: "unknown"} · ${edd?.let { "${gestationalWeeks(it)} weeks" } ?: ""}", Modifier.padding(16.dp))
+      Button(onClick = onNewVisit, Modifier.padding(horizontal = 16.dp)) { Text("Record ANC visit") }
+      Text("Past visits", style = MaterialTheme.typography.titleMedium, modifier = Modifier.padding(16.dp))
+      LazyColumn {
+        items(list.toVisits()) { v ->
+          Row(Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 8.dp)) {
+            Text(v.date, Modifier.weight(1f))
+            Text("${v.weightKg ?: "–"} kg", Modifier.weight(1f))
+            Text(v.bp ?: "–", Modifier.weight(1f))
+            Text(v.hb?.let { "Hb $it" } ?: "", Modifier.weight(1f))
+          }
+          HorizontalDivider()
+        }
+      }
+    }
+  }
+}
+
+@Composable
+private fun FormScreen(patient: Patient, onDone: (saved: Boolean) -> Unit) {
+  var json by remember { mutableStateOf<String?>(null) }
+  LaunchedEffect(Unit) { json = Fhir.questionnaireJson() }
+  val scope = rememberCoroutineScope()
+  val context = LocalContext.current
+  val q = json ?: return Loading()
+  Questionnaire(
+    questionnaireJson = q,
+    config = QuestionnaireConfig(showSubmitButton = true, showCancelButton = true),
+    onSubmit = { getResponse ->
+      scope.launch {
+        Fhir.saveVisit(patient.id!!, getResponse())
+        onDone(true)
+        if (!Fhir.sync(context)) Toast.makeText(context, "Saved locally; upload will retry on next launch", Toast.LENGTH_LONG).show()
+      }
+    },
+    onCancel = { onDone(false) },
+  )
+}
+
+@Composable
+private fun Loading(pad: androidx.compose.foundation.layout.PaddingValues = androidx.compose.foundation.layout.PaddingValues(0.dp)) {
+  Column(Modifier.padding(pad).fillMaxSize().padding(32.dp)) { CircularProgressIndicator() }
+}
