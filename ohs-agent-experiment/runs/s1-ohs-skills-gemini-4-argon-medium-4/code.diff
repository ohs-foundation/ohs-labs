+  private fun formatDecimal(bd: BigDecimal): String {
+    val plain = bd.toPlainString()
+    return if ('.' in plain) {
+      val trimmed = plain.trimEnd('0')
+      if (trimmed.endsWith('.')) "${trimmed}0" else trimmed
+    } else {
+      "$plain.0"
+    }
