+@Composable
+fun App() {
+  val nav = rememberNavController()
+  NavHost(nav, "register") {
+    composable("register") { RegisterScreen { nav.navigate("patient/$it") } }
+    composable("patient/{id}") { e ->
+      val id = e.arguments!!.getString("id")!!
+      DetailScreen(id, onNew = { nav.navigate("newVisit/$id") })
+    }
+    // own destination => fresh ViewModelStoreOwner per form session (avoids stale answers)
+    composable("newVisit/{id}") { e ->
+      VisitForm(e.arguments!!.getString("id")!!) { nav.popBackStack() }
+    }
+  }
+}
+
+@Composable
+fun RegisterScreen(onOpen: (String) -> Unit) {
+  val ctx = LocalContext.current
+  var rows by remember { mutableStateOf<List<PatientRow>?>(null) }
+  var msg by remember { mutableStateOf("Loading…") }
+  LaunchedEffect(Unit) {
+    rows = Repo.patients(ctx) // show whatever is local first
+    if (!Repo.sync(ctx)) msg = "Sync failed; showing local data"
+    rows = Repo.patients(ctx)
+  }
+  Column(Modifier.padding(16.dp).statusBarsPadding()) {
+    Text("ANC Register", style = MaterialTheme.typography.headlineSmall)
+    val list = rows
+    if (list.isNullOrEmpty()) Text(msg) else LazyColumn {
+      items(list) { p ->
+        Card(Modifier.fillMaxWidth().padding(vertical = 4.dp).clickable { onOpen(p.id) }) {
+          Column(Modifier.padding(12.dp)) {
+            Text(p.name, style = MaterialTheme.typography.titleMedium)
+            Text("Age ${p.age ?: "?"} · Due ${p.edd ?: "?"} · ${p.weeks?.let { "$it weeks" } ?: "? weeks"}")
+          }
+        }
+      }
+    }
+  }
+}
+
+@Composable
+fun DetailScreen(id: String, onNew: () -> Unit) {
+  val ctx = LocalContext.current
+  var visits by remember { mutableStateOf<List<Visit>>(emptyList()) }
+  var name by remember { mutableStateOf("") }
+  LaunchedEffect(id) {
+    name = Repo.patients(ctx).firstOrNull { it.id == id }?.name.orEmpty()
+    visits = Repo.visits(ctx, id)
+  }
+  Column(Modifier.padding(16.dp).statusBarsPadding()) {
+    Text(name, style = MaterialTheme.typography.headlineSmall)
+    Button(onNew, Modifier.padding(vertical = 8.dp)) { Text("Record new visit") }
+    if (visits.isEmpty()) Text("No visits recorded")
+    LazyColumn {
+      items(visits) { v ->
+        Card(Modifier.fillMaxWidth().padding(vertical = 4.dp)) {
+          Column(Modifier.padding(12.dp)) {
+            Text(v.date, style = MaterialTheme.typography.titleMedium)
+            v.gaWeeks?.let { Text("Gestational age: $it weeks") }
+            v.weight?.let { Text("Weight: $it kg") }
+            v.bp?.let { Text("BP: $it mmHg") }
+            v.hb?.let { Text("Hemoglobin: $it g/dL") }
+            if (v.dangerSigns.isNotEmpty()) Text("Danger signs: ${v.dangerSigns.joinToString()}")
+            v.notes?.let { Text("Notes: $it") }
+          }
+        }
+      }
+    }
+  }
+}
+
+@Composable
+fun VisitForm(patientId: String, close: () -> Unit) {
+  val ctx: Context = LocalContext.current
+  val scope = rememberCoroutineScope()
+  var json by remember { mutableStateOf<String?>(null) }
+  var loaded by remember { mutableStateOf(false) }
+  LaunchedEffect(Unit) { json = Repo.questionnaireJson(ctx); loaded = true }
+  Box(Modifier.statusBarsPadding()) {
+    val j = json
+    if (j != null) Questionnaire(
+      questionnaireJson = j,
+      onSubmit = { getResponse ->
+        scope.launch {
+          try {
+            Repo.saveVisit(ctx, patientId, getResponse())
+            close()
+          } catch (e: CancellationException) {
+            // validation failed; form shows the errors
+          }
+        }
+      },
+      onCancel = close,
+    ) else if (loaded) Column(Modifier.padding(16.dp)) {
+      Text("Visit form not available yet (not synced).")
+      Button(close) { Text("Back") }
+    }
   }
