@@ -0,0 +1,136 @@
+package com.example.ancapp
+
+import org.json.JSONArray
+import org.json.JSONObject
+import java.net.HttpURLConnection
+import java.net.URL
+import java.time.LocalDate
+import java.time.Period
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+
+data class PatientRow(val id: String, val name: String, val age: Int, val edd: LocalDate) {
+  val weeks: Long get() = 40 - ChronoUnit.DAYS.between(LocalDate.now(), edd) / 7
+}
+
+data class Visit(val date: String, val weight: Double?, val systolic: Int?, val diastolic: Int?, val hb: Double?)
+
+object Fhir {
+  const val BASE = "http://10.0.2.2:8080/fhir"
+
+  private fun request(method: String, url: String, body: JSONObject?): JSONObject {
+    val c = URL(url).openConnection() as HttpURLConnection
+    c.requestMethod = method
+    c.connectTimeout = 10_000
+    c.readTimeout = 20_000
+    c.setRequestProperty("Accept", "application/fhir+json")
+    if (body != null) {
+      c.doOutput = true
+      c.setRequestProperty("Content-Type", "application/fhir+json")
+      c.outputStream.use { it.write(body.toString().toByteArray()) }
+    }
+    val code = c.responseCode
+    val text = (if (code < 400) c.inputStream else c.errorStream).bufferedReader().readText()
+    if (code >= 400) error("HTTP $code: ${text.take(300)}")
+    return JSONObject(text)
+  }
+
+  fun get(path: String) = request("GET", "$BASE/$path", null)
+
+  private fun entries(bundle: JSONObject): List<JSONObject> =
+    bundle.optJSONArray("entry")?.let { a -> (0 until a.length()).map { a.getJSONObject(it).getJSONObject("resource") } } ?: emptyList()
+
+  private fun JSONArray.objects() = (0 until length()).map { getJSONObject(it) }
+  private fun JSONObject.loinc(): String? = optJSONObject("code")?.optJSONArray("coding")?.objects()?.firstOrNull()?.optString("code")
+  private fun JSONObject.value(): Double? = optJSONObject("valueQuantity")?.optDouble("value")?.takeIf { !it.isNaN() }
+
+  fun loadRegister(): List<PatientRow> {
+    val res = entries(get("Observation?code=http://loinc.org|11778-8&_include=Observation:patient&_count=200"))
+    val patients = res.filter { it.getString("resourceType") == "Patient" }.associateBy { it.getString("id") }
+    val today = LocalDate.now()
+    // ponytail: every patient with an EDD counts as "currently pregnant"; add a delivery/outcome check if the clinic records one
+    return res.filter { it.getString("resourceType") == "Observation" }
+      .sortedByDescending { it.optString("effectiveDateTime") }
+      .distinctBy { it.getJSONObject("subject").getString("reference") }
+      .mapNotNull { o ->
+        val p = patients[o.getJSONObject("subject").getString("reference").substringAfter("/")] ?: return@mapNotNull null
+        val n = p.optJSONArray("name")?.optJSONObject(0)
+        val given = n?.optJSONArray("given")?.let { g -> (0 until g.length()).joinToString(" ") { g.getString(it) } } ?: ""
+        PatientRow(
+          id = p.getString("id"),
+          name = "$given ${n?.optString("family") ?: ""}".trim(),
+          age = Period.between(LocalDate.parse(p.getString("birthDate")), today).years,
+          edd = LocalDate.parse(o.getString("valueDateTime").take(10)),
+        )
+      }.sortedBy { it.edd }
+  }
+
+  fun loadVisits(patientId: String): List<Visit> {
+    val encounters = entries(get("Encounter?patient=$patientId&_count=200"))
+    val obsByEnc = entries(get("Observation?patient=$patientId&_count=200"))
+      .groupBy { it.optJSONObject("encounter")?.optString("reference")?.substringAfter("/") }
+    return encounters.map { e ->
+      val os = obsByEnc[e.getString("id")].orEmpty()
+      fun q(code: String) = os.firstOrNull { it.loinc() == code }?.value()
+      val comps = os.firstOrNull { it.loinc() == "85354-9" }?.optJSONArray("component")?.objects().orEmpty()
+      fun comp(code: String) = comps.firstOrNull { it.loinc() == code }?.value()?.toInt()
+      Visit(
+        date = e.optJSONObject("period")?.optString("start")?.take(10) ?: "",
+        weight = q("29463-7"), systolic = comp("8480-6"), diastolic = comp("8462-4"), hb = q("718-7"),
+      )
+    }.sortedByDescending { it.date }
+  }
+
+  fun loadQuestionnaire(): JSONObject = get("Questionnaire/anc-contact")
+
+  /** Saves Encounter + Observations + QuestionnaireResponse in one transaction. [answers] keyed by linkId; danger signs are codes. */
+  fun saveVisit(patientId: String, q: JSONObject, answers: Map<String, String>, signs: List<String>) {
+    val encRef = "urn:uuid:${UUID.randomUUID()}"
+    val date = answers.getValue("visit-date")
+    fun ref(r: String) = JSONObject().put("reference", r)
+    fun coding(code: String, display: String) =
+      JSONObject().put("coding", JSONArray().put(JSONObject().put("system", "http://loinc.org").put("code", code).put("display", display)))
+    fun qty(v: Number, unit: String, ucum: String) =
+      JSONObject().put("value", v).put("unit", unit).put("system", "http://unitsofmeasure.org").put("code", ucum)
+    fun obs(code: String, display: String) = JSONObject().put("resourceType", "Observation").put("status", "final")
+      .put("code", coding(code, display)).put("subject", ref("Patient/$patientId")).put("encounter", ref(encRef)).put("effectiveDateTime", date)
+    fun entry(res: JSONObject, fullUrl: String = "urn:uuid:${UUID.randomUUID()}") = JSONObject().put("fullUrl", fullUrl).put("resource", res)
+      .put("request", JSONObject().put("method", "POST").put("url", res.getString("resourceType")))
+
+    val entries = JSONArray()
+    entries.put(entry(JSONObject().put("resourceType", "Encounter").put("status", "finished")
+      .put("class", JSONObject().put("system", "http://terminology.hl7.org/CodeSystem/v3-ActCode").put("code", "AMB").put("display", "ambulatory"))
+      .put("type", JSONArray().put(JSONObject().put("text", "Antenatal care contact")))
+      .put("subject", ref("Patient/$patientId"))
+      .put("period", JSONObject().put("start", date).put("end", date)), encRef))
+    answers["weight"]?.toDoubleOrNull()?.let { entries.put(entry(obs("29463-7", "Body weight").put("valueQuantity", qty(it, "kg", "kg")))) }
+    answers["gestational-age"]?.toIntOrNull()?.let { entries.put(entry(obs("11884-4", "Gestational age Estimated").put("valueQuantity", qty(it, "weeks", "wk")))) }
+    val sys = answers["bp-systolic"]?.toIntOrNull(); val dia = answers["bp-diastolic"]?.toIntOrNull()
+    if (sys != null && dia != null) entries.put(entry(obs("85354-9", "Blood pressure panel with all children optional").put("component", JSONArray()
+      .put(JSONObject().put("code", coding("8480-6", "Systolic blood pressure")).put("valueQuantity", qty(sys, "mmHg", "mm[Hg]")))
+      .put(JSONObject().put("code", coding("8462-4", "Diastolic blood pressure")).put("valueQuantity", qty(dia, "mmHg", "mm[Hg]"))))))
+
+    fun qrItems(items: JSONArray?): JSONArray = JSONArray().also { out ->
+      items?.objects()?.forEach { item ->
+        val linkId = item.getString("linkId")
+        val qi = JSONObject().put("linkId", linkId).put("text", item.optString("text"))
+        when (item.getString("type")) {
+          "group" -> qi.put("item", qrItems(item.optJSONArray("item")))
+          "choice" -> item.optJSONArray("answerOption")?.objects()?.map { it.getJSONObject("valueCoding") }
+            ?.filter { it.getString("code") in signs }?.takeIf { it.isNotEmpty() }
+            ?.let { cs -> qi.put("answer", JSONArray().also { a -> cs.forEach { a.put(JSONObject().put("valueCoding", it)) } }) }
+          else -> answers[linkId]?.takeIf { it.isNotBlank() }?.let { v ->
+            val key = when (item.getString("type")) { "date" -> "valueDate"; "integer" -> "valueInteger"; "decimal" -> "valueDecimal"; else -> "valueString" }
+            qi.put("answer", JSONArray().put(JSONObject().put(key, when (key) { "valueInteger" -> v.toInt(); "valueDecimal" -> v.toDouble(); else -> v })))
+          }
+        }
+        if (qi.has("answer") || qi.optJSONArray("item")?.length() ?: 0 > 0) out.put(qi)
+      }
+    }
+    entries.put(entry(JSONObject().put("resourceType", "QuestionnaireResponse").put("questionnaire", q.optString("url"))
+      .put("status", "completed").put("subject", ref("Patient/$patientId")).put("encounter", ref(encRef))
+      .put("authored", java.time.OffsetDateTime.now().toString()).put("item", qrItems(q.optJSONArray("item")))))
+
+    request("POST", BASE, JSONObject().put("resourceType", "Bundle").put("type", "transaction").put("entry", entries))
+  }
+}
