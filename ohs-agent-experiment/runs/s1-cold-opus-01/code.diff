+import com.example.ancapp.data.AncVisit
+import com.example.ancapp.data.DangerSign
+import com.example.ancapp.data.Patient
+import com.example.ancapp.ui.formatLong
+import com.example.ancapp.ui.trimDecimal
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun PatientDetailScreen(
+  viewModel: PatientDetailViewModel,
+  onBack: () -> Unit,
+  onRecordVisit: () -> Unit,
+) {
+  val uiState by viewModel.uiState.collectAsStateWithLifecycle()
+  val patient = uiState.patient
+
+  Scaffold(
+    topBar = {
+      TopAppBar(
+        title = { Text(patient?.name ?: "Patient") },
+        navigationIcon = {
+          IconButton(onClick = onBack) {
+            Icon(Icons.AutoMirrored.Filled.ArrowBack, contentDescription = "Back")
+          }
+        },
+      )
+    },
+    floatingActionButton = {
+      if (patient != null) {
+        ExtendedFloatingActionButton(
+          onClick = onRecordVisit,
+          icon = { Icon(Icons.Filled.Add, contentDescription = null) },
+          text = { Text("Record visit") },
+        )
+      }
+    },
+  ) { padding ->
+    when {
+      uiState.isLoading -> Box(
+        modifier = Modifier.fillMaxSize().padding(padding),
+        contentAlignment = Alignment.Center,
+      ) { CircularProgressIndicator() }
+
+      patient == null -> Box(
+        modifier = Modifier.fillMaxSize().padding(padding).padding(32.dp),
+        contentAlignment = Alignment.Center,
+      ) { Text("This patient is no longer on file.", textAlign = TextAlign.Center) }
+
+      else -> LazyColumn(
+        modifier = Modifier.fillMaxSize(),
+        contentPadding = PaddingValues(
+          top = padding.calculateTopPadding() + 8.dp,
+          // Clear of the FAB.
+          bottom = padding.calculateBottomPadding() + 96.dp,
+          start = 16.dp,
+          end = 16.dp,
+        ),
+        verticalArrangement = Arrangement.spacedBy(12.dp),
+      ) {
+        item {
+          PatientSummaryCard(
+            patient = patient,
+            age = uiState.age,
+            gestationLabel = uiState.gestationLabel,
+          )
+        }
+
+        item {
+          Text(
+            text = if (uiState.visits.isEmpty()) "ANC visits" else "ANC visits (${uiState.visits.size})",
+            style = MaterialTheme.typography.titleSmall,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+            modifier = Modifier.padding(top = 8.dp, start = 4.dp),
+          )
+        }
+
+        if (uiState.visits.isEmpty()) {
+          item {
+            Text(
+              text = "No visits recorded yet. Tap “Record visit” to add the first one.",
+              style = MaterialTheme.typography.bodyMedium,
+              color = MaterialTheme.colorScheme.onSurfaceVariant,
+              modifier = Modifier.padding(start = 4.dp, top = 4.dp),
+            )
+          }
+        } else {
+          items(uiState.visits, key = { it.id }) { visit -> VisitCard(visit) }
+        }
+      }
+    }
+  }
+}
+
+@Composable
+private fun PatientSummaryCard(patient: Patient, age: Int, gestationLabel: String) {
+  Card(
+    modifier = Modifier.fillMaxWidth(),
+    colors = CardDefaults.cardColors(
+      containerColor = MaterialTheme.colorScheme.primaryContainer,
+      contentColor = MaterialTheme.colorScheme.onPrimaryContainer,
+    ),
+  ) {
+    Column(modifier = Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(4.dp)) {
+      Text(text = patient.name, style = MaterialTheme.typography.headlineSmall)
+      Text(
+        text = "Age $age  ·  born ${patient.dateOfBirth.formatLong()}",
+        style = MaterialTheme.typography.bodyMedium,
+      )
+      Text(
+        text = "Due ${patient.estimatedDueDate.formatLong()}  ·  now $gestationLabel",
+        style = MaterialTheme.typography.bodyMedium,
+      )
+    }
+  }
+}
+
+@OptIn(ExperimentalLayoutApi::class)
+@Composable
+private fun VisitCard(visit: AncVisit) {
+  Card(
+    modifier = Modifier.fillMaxWidth(),
+    colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceContainerLow),
+  ) {
+    Column(modifier = Modifier.padding(16.dp)) {
+      Row(verticalAlignment = Alignment.CenterVertically) {
+        Text(
+          text = visit.visitDate.formatLong(),
+          style = MaterialTheme.typography.titleMedium,
+          modifier = Modifier.weight(1f),
+        )
+        Text(
+          text = "${visit.gestationalAgeWeeks} weeks",
+          style = MaterialTheme.typography.labelLarge,
+          color = MaterialTheme.colorScheme.primary,
+        )
+      }
+
+      HorizontalDivider(modifier = Modifier.padding(vertical = 12.dp))
+
+      FlowRow(
+        modifier = Modifier.fillMaxWidth(),
+        horizontalArrangement = Arrangement.spacedBy(24.dp),
+        verticalArrangement = Arrangement.spacedBy(12.dp),
+      ) {
+        Measurement("Weight", "${visit.weightKg.trimDecimal()} kg")
+        Measurement("Blood pressure", "${visit.systolic}/${visit.diastolic} mmHg")
+        // Haemoglobin is only taken at some visits.
+        visit.hemoglobin?.let { Measurement("Haemoglobin", "${it.trimDecimal()} g/dL") }
+      }
+
+      Text(
+        text = "Danger signs",
+        style = MaterialTheme.typography.labelMedium,
+        color = MaterialTheme.colorScheme.onSurfaceVariant,
+        modifier = Modifier.padding(top = 16.dp),
+      )
+      if (visit.dangerSigns.isEmpty()) {
+        Text(
+          text = "None reported",
+          style = MaterialTheme.typography.bodyMedium,
+          modifier = Modifier.padding(top = 4.dp),
+        )
+      } else {
+        FlowRow(
+          modifier = Modifier.fillMaxWidth().padding(top = 6.dp),
+          horizontalArrangement = Arrangement.spacedBy(8.dp),
+          verticalArrangement = Arrangement.spacedBy(8.dp),
+        ) {
+          DangerSign.entries.filter { it in visit.dangerSigns }.forEach { sign ->
+            DangerSignChip(sign.label)
+          }
+        }
+      }
+
+      if (visit.notes.isNotBlank()) {
+        Text(
+          text = "Notes",
+          style = MaterialTheme.typography.labelMedium,
+          color = MaterialTheme.colorScheme.onSurfaceVariant,
+          modifier = Modifier.padding(top = 16.dp),
+        )
+        Text(
+          text = visit.notes,
+          style = MaterialTheme.typography.bodyMedium,
+          modifier = Modifier.padding(top = 4.dp),
+        )
+      }
+    }
+  }
+}
+
+@Composable
+private fun Measurement(label: String, value: String) {
+  Column {
+    Text(
+      text = label,
+      style = MaterialTheme.typography.labelMedium,
+      color = MaterialTheme.colorScheme.onSurfaceVariant,
+    )
+    Text(
+      text = value,
+      style = MaterialTheme.typography.bodyLarge,
+      fontWeight = FontWeight.Medium,
+    )
+  }
+}
+
+@Composable
+private fun DangerSignChip(label: String) {
+  Surface(
+    color = MaterialTheme.colorScheme.errorContainer,
+    contentColor = MaterialTheme.colorScheme.onErrorContainer,
+    shape = MaterialTheme.shapes.small,
+  ) {
+    Text(
+      text = label,
+      style = MaterialTheme.typography.labelLarge,
+      modifier = Modifier.padding(horizontal = 10.dp, vertical = 6.dp),
+    )
+  }
+}
