@@ -0,0 +1,80 @@
+package com.example.ancapp
+
+import android.content.ContentValues
+import android.content.Context
+import android.database.sqlite.SQLiteDatabase
+import android.database.sqlite.SQLiteOpenHelper
+import java.time.LocalDate
+import java.time.Period
+import java.time.temporal.ChronoUnit
+
+data class Patient(val id: Long, val name: String, val dob: LocalDate, val edd: LocalDate)
+
+data class Visit(
+  val date: LocalDate,
+  val gaWeeks: Int,
+  val weightKg: Double,
+  val systolic: Int,
+  val diastolic: Int,
+  val hb: Double?,
+  val dangerSigns: List<String>,
+  val notes: String,
+)
+
+val DANGER_SIGNS = listOf("Vaginal bleeding", "Severe headache", "Blurred vision", "Fever")
+
+fun ageOn(dob: LocalDate, on: LocalDate) = Period.between(dob, on).years
+
+/** Gestational age in whole weeks on [on], counting back 280 days from the due date. */
+fun gaWeeksOn(edd: LocalDate, on: LocalDate) = ((280 - ChronoUnit.DAYS.between(on, edd)) / 7).toInt()
+
+class Db(context: Context) : SQLiteOpenHelper(context, "anc.db", null, 1) {
+  override fun onCreate(db: SQLiteDatabase) {
+    db.execSQL("CREATE TABLE patient(id INTEGER PRIMARY KEY, name TEXT NOT NULL, dob TEXT NOT NULL, edd TEXT NOT NULL)")
+    db.execSQL(
+      """CREATE TABLE visit(id INTEGER PRIMARY KEY, patient_id INTEGER NOT NULL REFERENCES patient(id),
+        date TEXT NOT NULL, ga_weeks INTEGER NOT NULL, weight_kg REAL NOT NULL, systolic INTEGER NOT NULL,
+        diastolic INTEGER NOT NULL, hb REAL, danger_signs TEXT NOT NULL, notes TEXT NOT NULL)"""
+    )
+    fun seed(name: String, dob: String, edd: String, visit: String, kg: Double, sys: Int, dia: Int, hb: Double) {
+      val id = db.insert("patient", null, ContentValues().apply { put("name", name); put("dob", dob); put("edd", edd) })
+      val date = LocalDate.parse(visit)
+      insertVisit(db, id, Visit(date, gaWeeksOn(LocalDate.parse(edd), date), kg, sys, dia, hb, emptyList(), ""))
+    }
+    seed("Emily Carter", "1996-04-12", "2026-12-05", "2026-08-10", 68.5, 118, 76, 11.8)
+    seed("Sarah Mitchell", "1990-11-02", "2027-01-20", "2026-08-12", 61.2, 110, 70, 12.4)
+    seed("Grace Thompson", "2001-07-30", "2026-10-15", "2026-08-05", 72.0, 128, 84, 10.2)
+  }
+
+  override fun onUpgrade(db: SQLiteDatabase, old: Int, new: Int) = Unit
+
+  fun patients(): List<Patient> =
+    readableDatabase.rawQuery("SELECT id, name, dob, edd FROM patient ORDER BY edd", null).use { c ->
+      generateSequence { if (c.moveToNext()) Patient(c.getLong(0), c.getString(1), LocalDate.parse(c.getString(2)), LocalDate.parse(c.getString(3))) else null }.toList()
+    }
+
+  fun visits(patientId: Long): List<Visit> =
+    readableDatabase.rawQuery(
+      "SELECT date, ga_weeks, weight_kg, systolic, diastolic, hb, danger_signs, notes FROM visit WHERE patient_id = ? ORDER BY date DESC, id DESC",
+      arrayOf(patientId.toString()),
+    ).use { c ->
+      generateSequence {
+        if (!c.moveToNext()) null
+        else Visit(
+          LocalDate.parse(c.getString(0)), c.getInt(1), c.getDouble(2), c.getInt(3), c.getInt(4),
+          if (c.isNull(5)) null else c.getDouble(5),
+          c.getString(6).split('|').filter { it.isNotEmpty() }, c.getString(7),
+        )
+      }.toList()
+    }
+
+  fun addVisit(patientId: Long, v: Visit) { insertVisit(writableDatabase, patientId, v) }
+
+  private fun insertVisit(db: SQLiteDatabase, patientId: Long, v: Visit) {
+    db.insertOrThrow("visit", null, ContentValues().apply {
+      put("patient_id", patientId); put("date", v.date.toString()); put("ga_weeks", v.gaWeeks)
+      put("weight_kg", v.weightKg); put("systolic", v.systolic); put("diastolic", v.diastolic)
+      put("hb", v.hb); put("danger_signs", v.dangerSigns.joinToString("|")); put("notes", v.notes)
+    })
+  }
+}
diff --git a/app/src/main/java/com/example/ancapp/MainActivity.kt b/app/src/main/java/com/example/ancapp/MainActivity.kt
