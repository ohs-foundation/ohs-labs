diff --git a/app/src/main/java/com/example/ancapp/data/FhirRepository.kt b/app/src/main/java/com/example/ancapp/data/FhirRepository.kt
new file mode 100644
index 0000000..f2a5224
--- /dev/null
+++ b/app/src/main/java/com/example/ancapp/data/FhirRepository.kt
@@ -0,0 +1,441 @@
+package com.example.ancapp.data
+
+import android.content.Context
+import com.ionspin.kotlin.bignum.decimal.BigDecimal
+import dev.ohs.fhir.engine.FhirEngine
+import dev.ohs.fhir.engine.FhirEngineProvider
+import dev.ohs.fhir.engine.get
+import dev.ohs.fhir.engine.search.ReferenceClientParam
+import dev.ohs.fhir.engine.search.Search
+import dev.ohs.fhir.model.r4.*
+import dev.ohs.fhir.model.r4.String as FhirString
+import dev.ohs.fhir.model.r4.terminologies.ResourceType
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import java.time.LocalDate
+import java.time.Period
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+
+data class PatientItem(
+  val id: String,
+  val name: String,
+  val age: Int?,
+  val birthDate: String?,
+  val estimatedDueDate: LocalDate?,
+  val gestationalAgeWeeks: Int?,
+)
+
+data class VisitItem(
+  val encounterId: String,
+  val date: String,
+  val weight: String?,
+  val bloodPressure: String?,
+  val hemoglobin: String?,
+  val gestationalAge: String?,
+  val dangerSigns: List<String> = emptyList(),
+  val notes: String? = null,
+)
+
+class FhirRepository(private val context: Context) {
+  private val fhirEngine: FhirEngine
+    get() = FhirEngineProvider.getInstance(context.applicationContext)
+
+  private val json = Json {
+    explicitNulls = false
+    encodeDefaults = false
+    ignoreUnknownKeys = true
+  }
+
+  suspend fun getPatients(): List<PatientItem> {
+    val patients = fhirEngine.search<Patient>(Search(ResourceType.Patient)).map { it.resource }
+    val allObservations = fhirEngine.search<Observation>(Search(ResourceType.Observation)).map { it.resource }
+
+    return patients.map { patient ->
+      val patientId = patient.id ?: ""
+
+      // Name
+      val nameElem = patient.name.firstOrNull()
+      val given = nameElem?.given?.mapNotNull { it.value }?.joinToString(" ")?.takeIf { it.isNotBlank() }
+      val family = nameElem?.family?.value
+      val fullName = listOfNotNull(given, family).joinToString(" ").takeIf { it.isNotBlank() } ?: "Unknown"
+
+      // Age from birthDate
+      val dobStr = patient.birthDate?.value?.toString()
+      val dob = dobStr?.let { runCatching { LocalDate.parse(it.substringBefore("T")) }.getOrNull() }
+      val age = dob?.let { Period.between(it, LocalDate.now()).years }
+
+      // Estimated Due Date from Observation (LOINC 11778-8)
+      val eddObs = allObservations.firstOrNull { obs ->
+        val isSubject = obs.subject?.reference?.value?.let { ref ->
+          ref == "Patient/$patientId" || ref.substringAfter("/") == patientId
+        } ?: false
+        val isEdd = obs.code.coding.any { it.code?.value == "11778-8" } ||
+          obs.code.text?.value?.contains("due date", ignoreCase = true) == true
+        isSubject && isEdd
+      }
+
+      val eddStr = eddObs?.value?.asDateTime()?.value?.value?.toString()?.substringBefore("T")
+      val edd = eddStr?.let { runCatching { LocalDate.parse(it) }.getOrNull() }
+
+      // Weeks of pregnancy from EDD (40 weeks / 280 days standard from LMP)
+      val gestationalAgeWeeks = edd?.let { dueDate ->
+        val today = LocalDate.now()
+        val daysUntilDue = ChronoUnit.DAYS.between(today, dueDate)
+        val gestationalDays = 280 - daysUntilDue
+        val weeks = (gestationalDays / 7).toInt()
+        maxOf(0, weeks)
+      }
+
+      PatientItem(
+        id = patientId,
+        name = fullName,
+        age = age,
+        birthDate = dobStr,
+        estimatedDueDate = edd,
+        gestationalAgeWeeks = gestationalAgeWeeks,
+      )
+    }.sortedWith(compareBy(nullsLast()) { it.estimatedDueDate })
+  }
+
+  suspend fun getPatient(patientId: String): PatientItem? {
+    return getPatients().firstOrNull { it.id == patientId }
+  }
+
+  suspend fun getVisits(patientId: String): List<VisitItem> {
+    val encounters = fhirEngine.search<Encounter>(
+      Search(ResourceType.Encounter).apply {
+        filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+      }
+    ).map { it.resource }
+
+    val observations = fhirEngine.search<Observation>(
+      Search(ResourceType.Observation).apply {
+        filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+      }
+    ).map { it.resource }
+
+    return encounters.map { encounter ->
+      val encId = encounter.id ?: ""
+      val encDate = encounter.period?.start?.value?.toString()?.substringBefore("T")
+        ?: encounter.period?.end?.value?.toString()?.substringBefore("T")
+
+      val encObs = observations.filter { obs ->
+        val ref = obs.encounter?.reference?.value
+        if (ref != null) {
+          ref == "Encounter/$encId" || ref.substringAfter("/") == encId
+        } else {
+          // Fallback match by date if encounter reference is missing
+          obs.effective?.asDateTime()?.value?.value?.toString()?.substringBefore("T") == encDate
+        }
+      }
+
+      // Weight (LOINC 29463-7)
+      val weightObs = encObs.firstOrNull { obs ->
+        obs.code.coding.any { it.code?.value == "29463-7" } ||
+          obs.code.text?.value?.contains("weight", ignoreCase = true) == true
+      }
+      val weightVal = weightObs?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+      val weightUnit = weightObs?.value?.asQuantity()?.value?.unit?.value ?: "kg"
+      val weight = weightVal?.let { "$it $weightUnit" }
+
+      // Blood pressure (LOINC 85354-9)
+      val bpObs = encObs.firstOrNull { obs ->
+        obs.code.coding.any { it.code?.value == "85354-9" } ||
+          obs.code.text?.value?.contains("blood pressure", ignoreCase = true) == true
+      }
+      val systolic = bpObs?.component?.firstOrNull { it.code.coding.any { c -> c.code?.value == "8480-6" } }
+        ?.value?.asQuantity()?.value?.value?.value?.toPlainString()?.substringBefore(".")
+      val diastolic = bpObs?.component?.firstOrNull { it.code.coding.any { c -> c.code?.value == "8462-4" } }
+        ?.value?.asQuantity()?.value?.value?.value?.toPlainString()?.substringBefore(".")
+      val bp = if (systolic != null && diastolic != null) {
+        "$systolic/$diastolic mmHg"
+      } else if (systolic != null) {
+        "$systolic mmHg"
+      } else null
+
+      // Hemoglobin (LOINC 718-7)
+      val hbObs = encObs.firstOrNull { obs ->
+        obs.code.coding.any { it.code?.value == "718-7" } ||
+          obs.code.text?.value?.contains("hemoglobin", ignoreCase = true) == true
+      }
+      val hbVal = hbObs?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+      val hbUnit = hbObs?.value?.asQuantity()?.value?.unit?.value ?: "g/dL"
+      val hb = hbVal?.let { "$it $hbUnit" }
+
+      // Gestational age (LOINC 18185-9)
+      val gaObs = encObs.firstOrNull { obs ->
+        obs.code.coding.any { it.code?.value == "18185-9" } ||
+          obs.code.text?.value?.contains("gestational age", ignoreCase = true) == true
+      }
+      val ga = gaObs?.value?.asQuantity()?.value?.value?.value?.toPlainString()?.substringBefore(".")?.let { "$it weeks" }
+
+      // Danger signs
+      val dangerObs = encObs.firstOrNull { obs ->
+        obs.code.text?.value?.contains("danger signs", ignoreCase = true) == true
+      }
+      val dangerSigns = dangerObs?.value?.asString()?.value?.value?.split(",")?.map { it.trim() }?.filter { it.isNotEmpty() } ?: emptyList()
+
+      // Notes
+      val notesObs = encObs.firstOrNull { obs ->
+        obs.code.text?.value?.contains("notes", ignoreCase = true) == true
+      }
+      val notes = notesObs?.value?.asString()?.value?.value
+
+      val date = encDate ?: LocalDate.now().toString()
+
+      VisitItem(
+        encounterId = encId,
+        date = date,
+        weight = weight,
+        bloodPressure = bp,
+        hemoglobin = hb,
+        gestationalAge = ga,
+        dangerSigns = dangerSigns,
+        notes = notes,
+      )
+    }.sortedByDescending { it.date }
+  }
+
+  suspend fun getQuestionnaireJson(): String {
+    return try {
+      val q = fhirEngine.get<Questionnaire>("anc-contact")
+      json.encodeToString(q)
+    } catch (e: Exception) {
+      context.assets.open("anc-contact.json").bufferedReader().use { it.readText() }
+    }
+  }
+
+  suspend fun saveVisit(patientId: String, response: QuestionnaireResponse) {
+    val answers = mutableMapOf<String, MutableList<QuestionnaireResponse.Item.Answer>>()
+    fun collect(items: List<QuestionnaireResponse.Item>) {
+      items.forEach { item ->
+        item.linkId.value?.let { answers.getOrPut(it) { mutableListOf() }.addAll(item.answer) }
+        collect(item.item)
+        item.answer.forEach { collect(it.item) }
+      }
+    }
+    collect(response.item)
+
+    // Extracted answers
+    val dateStr = answers["visit-date"]?.firstOrNull()?.value?.asDate()?.value?.value?.toString()
+      ?: LocalDate.now().toString()
+    val gaInt = answers["gestational-age"]?.firstOrNull()?.value?.asInteger()?.value?.value
+    val weightDec = answers["weight"]?.firstOrNull()?.value?.asDecimal()?.value?.value
+    val systolicInt = answers["bp-systolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+    val diastolicInt = answers["bp-diastolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+    val dangerCodings = answers["danger-signs"].orEmpty().mapNotNull { it.value?.asCoding()?.value }
+    val notesStr = answers["notes"]?.firstOrNull()?.value?.asString()?.value?.value
+
+    val encounterId = UUID.randomUUID().toString()
+
+    val encounter = Encounter(
+      id = encounterId,
+      status = Enumeration(value = Encounter.EncounterStatus.Finished),
+      `class` = Coding(
+        system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"),
+        code = Code(value = "AMB"),
+        display = FhirString(value = "ambulatory"),
+      ),
+      type = listOf(CodeableConcept(text = FhirString(value = "Antenatal care contact"))),
+      subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+      period = Period(
+        start = DateTime(value = FhirDateTime.fromString(dateStr)),
+        end = DateTime(value = FhirDateTime.fromString(dateStr)),
+      ),
+    )
+
+    fhirEngine.create(encounter)
+
+    if (weightDec != null) {
+      val weightObs = Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        category = listOf(
+          CodeableConcept(
+            coding = listOf(
+              Coding(
+                system = Uri(value = "http://terminology.hl7.org/CodeSystem/observation-category"),
+                code = Code(value = "vital-signs"),
+                display = FhirString(value = "Vital Signs"),
+              )
+            )
+          )
+        ),
+        code = CodeableConcept(
+          coding = listOf(
+            Coding(
+              system = Uri(value = "http://loinc.org"),
+              code = Code(value = "29463-7"),
+              display = FhirString(value = "Body weight"),
+            )
+          ),
+          text = FhirString(value = "Body weight"),
+        ),
+        subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+        encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")),
+        effective = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(dateStr))),
+        value = Observation.Value.Quantity(
+          Quantity(
+            value = Decimal(value = weightDec),
+            unit = FhirString(value = "kg"),
+            system = Uri(value = "http://unitsofmeasure.org"),
+            code = Code(value = "kg"),
+          )
+        ),
+      )
+      fhirEngine.create(weightObs)
+    }
+
+    if (systolicInt != null || diastolicInt != null) {
+      val components = mutableListOf<Observation.Component>()
+      if (systolicInt != null) {
+        components.add(
+          Observation.Component(
+            code = CodeableConcept(
+              coding = listOf(
+                Coding(
+                  system = Uri(value = "http://loinc.org"),
+                  code = Code(value = "8480-6"),
+                  display = FhirString(value = "Systolic blood pressure"),
+                )
+              )
+            ),
+            value = Observation.Component.Value.Quantity(
+              Quantity(
+                value = Decimal(value = BigDecimal.fromInt(systolicInt)),
+                unit = FhirString(value = "mmHg"),
+                system = Uri(value = "http://unitsofmeasure.org"),
+                code = Code(value = "mm[Hg]"),
+              )
+            ),
+          )
+        )
+      }
+      if (diastolicInt != null) {
+        components.add(
+          Observation.Component(
+            code = CodeableConcept(
+              coding = listOf(
+                Coding(
+                  system = Uri(value = "http://loinc.org"),
+                  code = Code(value = "8462-4"),
+                  display = FhirString(value = "Diastolic blood pressure"),
+                )
+              )
+            ),
+            value = Observation.Component.Value.Quantity(
+              Quantity(
+                value = Decimal(value = BigDecimal.fromInt(diastolicInt)),
+                unit = FhirString(value = "mmHg"),
+                system = Uri(value = "http://unitsofmeasure.org"),
+                code = Code(value = "mm[Hg]"),
+              )
+            ),
+          )
+        )
+      }
+
+      val bpObs = Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        category = listOf(
+          CodeableConcept(
+            coding = listOf(
+              Coding(
+                system = Uri(value = "http://terminology.hl7.org/CodeSystem/observation-category"),
+                code = Code(value = "vital-signs"),
+                display = FhirString(value = "Vital Signs"),
+              )
+            )
+          )
+        ),
+        code = CodeableConcept(
+          coding = listOf(
+            Coding(
+              system = Uri(value = "http://loinc.org"),
+              code = Code(value = "85354-9"),
+              display = FhirString(value = "Blood pressure panel with all children optional"),
+            )
+          ),
+          text = FhirString(value = "Blood pressure"),
+        ),
+        subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+        encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")),
+        effective = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(dateStr))),
+        component = components,
+      )
+      fhirEngine.create(bpObs)
+    }
+
+    if (gaInt != null) {
+      val gaObs = Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        code = CodeableConcept(
+          coding = listOf(
+            Coding(
+              system = Uri(value = "http://loinc.org"),
+              code = Code(value = "18185-9"),
+              display = FhirString(value = "Gestational age in weeks"),
+            )
+          ),
+          text = FhirString(value = "Gestational age"),
+        ),
+        subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+        encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")),
+        effective = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(dateStr))),
+        value = Observation.Value.Quantity(
+          Quantity(
+            value = Decimal(value = BigDecimal.fromInt(gaInt)),
+            unit = FhirString(value = "wk"),
+            system = Uri(value = "http://unitsofmeasure.org"),
+            code = Code(value = "wk"),
+          )
+        ),
+      )
+      fhirEngine.create(gaObs)
+    }
+
+    if (dangerCodings.isNotEmpty()) {
+      val dangerDisplay = dangerCodings.mapNotNull { it.display?.value ?: it.code?.value }.joinToString(", ")
+      val dangerObs = Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        code = CodeableConcept(
+          text = FhirString(value = "Danger signs present"),
+        ),
+        subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+        encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")),
+        effective = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(dateStr))),
+        value = Observation.Value.String(FhirString(value = dangerDisplay)),
+      )
+      fhirEngine.create(dangerObs)
+    }
+
+    if (!notesStr.isNullOrBlank()) {
+      val notesObs = Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        code = CodeableConcept(
+          text = FhirString(value = "Clinical notes"),
+        ),
+        subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+        encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")),
+        effective = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(dateStr))),
+        value = Observation.Value.String(FhirString(value = notesStr)),
+      )
+      fhirEngine.create(notesObs)
+    }
+
+    val completedResponse = response.toBuilder().apply {
+      id = UUID.randomUUID().toString()
+      status = Enumeration(value = QuestionnaireResponse.QuestionnaireResponseStatus.Completed)
+      subject = Reference(reference = FhirString(value = "Patient/$patientId")).toBuilder()
+      this.encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")).toBuilder()
+      questionnaire = Canonical(value = "http://example.org/fhir/Questionnaire/anc-contact").toBuilder()
+    }.build()
+
+    fhirEngine.create(completedResponse)
+  }
+}
