diff --git a/app/src/main/java/com/example/ancapp/data/FhirExtractor.kt b/app/src/main/java/com/example/ancapp/data/FhirExtractor.kt
new file mode 100644
index 0000000..496b27b
--- /dev/null
+++ b/app/src/main/java/com/example/ancapp/data/FhirExtractor.kt
@@ -0,0 +1,106 @@
+package com.example.ancapp.data
+
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Patient
+import java.time.LocalDate
+import java.time.Period
+
+object FhirExtractor {
+  fun extractPatientInfo(patient: Patient, dueDate: LocalDate?): PatientInfo {
+    val name =
+      patient.name.firstOrNull()?.let { n ->
+        val given = n.given.mapNotNull { it.value }.joinToString(" ")
+        val family = n.family?.value ?: ""
+        listOfNotNull(given, family).joinToString(" ")
+      } ?: "Unknown"
+
+    val birthDate = patient.birthDate?.value?.let { fhirDate ->
+      try {
+        LocalDate.parse(fhirDate.toString())
+      } catch (e: Exception) {
+        null
+      }
+    }
+    val age =
+      birthDate?.let { Period.between(it, LocalDate.now()).years } ?: 0
+
+    return PatientInfo(
+      id = patient.id ?: "",
+      name = name,
+      age = age,
+      estimatedDueDate = dueDate,
+      weeksOfPregnancy = calculateWeeksOfPregnancy(dueDate),
+    )
+  }
+
+  fun extractAncVisit(encounter: Encounter, observations: List<Observation>): AncVisit {
+    val encounterId = encounter.id ?: ""
+    val date = try {
+      encounter.period?.start?.value?.let { fhirDateTime ->
+        LocalDate.parse(fhirDateTime.toString().substring(0, 10))
+      } ?: LocalDate.now()
+    } catch (e: Exception) {
+      LocalDate.now()
+    }
+
+    var gestationalAgeWeeks: Int? = null
+    var weight: Double? = null
+    var systolicBp: Int? = null
+    var diastolicBp: Int? = null
+    val dangerSigns = mutableListOf<String>()
+    var notes: String? = null
+
+    for (obs in observations) {
+      val code = obs.code?.coding?.firstOrNull()?.code?.value ?: continue
+      when (code) {
+        "18185-9" -> {
+          gestationalAgeWeeks =
+            obs.value?.asQuantity()?.value?.value?.toString()?.toIntOrNull()
+        }
+        "29463-7" -> {
+          weight = obs.value?.asQuantity()?.value?.value?.toString()?.toDoubleOrNull()
+        }
+        "85354-9" -> {
+          obs.component.forEach { comp ->
+            when (comp.code?.coding?.firstOrNull()?.code?.value) {
+              "8480-6" -> systolicBp = comp.value?.asQuantity()?.value?.value?.toString()?.toIntOrNull()
+              "8462-4" -> diastolicBp = comp.value?.asQuantity()?.value?.value?.toString()?.toIntOrNull()
+            }
+          }
+        }
+        "718-7" -> {
+          val hb = obs.value?.asQuantity()?.value?.value?.toString()?.toDoubleOrNull()
+          if (hb != null && hb < 11.0) {
+            dangerSigns.add("Low hemoglobin (${String.format("%.1f", hb)} g/dL)")
+          }
+        }
+      }
+      notes = obs.note?.firstOrNull()?.text?.value
+    }
+
+    return AncVisit(
+      encounterId = encounterId,
+      date = date,
+      gestationalAgeWeeks = gestationalAgeWeeks,
+      weight = weight,
+      systolicBp = systolicBp,
+      diastolicBp = diastolicBp,
+      dangerSigns = dangerSigns,
+      notes = notes,
+    )
+  }
+
+  fun extractEstimatedDueDate(patient: Patient): LocalDate? {
+    return try {
+      val ext = patient.extension.find {
+        it.url.toString().contains("estimated-due-date")
+      }
+      ext?.value?.asDate()?.value?.let { fhirDate ->
+        LocalDate.parse(fhirDate.toString())
+      }
+    } catch (e: Exception) {
+      null
+    }
+  }
+}
