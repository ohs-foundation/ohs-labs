+}
+
+@Composable
+fun VisitCard(visit: AncVisitItem) {
+  Card(
+    modifier = Modifier.fillMaxWidth(),
+    elevation = CardDefaults.cardElevation(defaultElevation = 2.dp),
+    colors = CardDefaults.cardColors(
+      containerColor = MaterialTheme.colorScheme.surface
+    )
+  ) {
+    Column(modifier = Modifier.padding(16.dp)) {
+      Row(
+        modifier = Modifier.fillMaxWidth(),
+        horizontalArrangement = Arrangement.SpaceBetween,
+        verticalAlignment = Alignment.CenterVertically
+      ) {
+        Text(
+          text = "Visit Date: ${visit.date}",
+          style = MaterialTheme.typography.titleMedium,
+          fontWeight = FontWeight.Bold,
+          color = MaterialTheme.colorScheme.primary
+        )
+        if (visit.gestationalAgeWeeks != null) {
+          Box(
+            modifier = Modifier
+              .background(
+                MaterialTheme.colorScheme.primaryContainer,
+                RoundedCornerShape(8.dp)
+              )
+              .padding(horizontal = 8.dp, vertical = 4.dp)
+          ) {
+            Text(
+              text = "${visit.gestationalAgeWeeks} wks",
+              style = MaterialTheme.typography.labelMedium,
+              color = MaterialTheme.colorScheme.onPrimaryContainer,
+              fontWeight = FontWeight.SemiBold
+            )
+          }
+        }
+      }
+
+      Spacer(modifier = Modifier.height(8.dp))
+      HorizontalDivider(color = DividerDefaults.color.copy(alpha = 0.5f))
+      Spacer(modifier = Modifier.height(8.dp))
+
+      // Vitals grid
+      Row(
+        modifier = Modifier.fillMaxWidth(),
+        horizontalArrangement = Arrangement.SpaceBetween
+      ) {
+        Column(modifier = Modifier.weight(1f)) {
+          Text(
+            text = "Weight",
+            style = MaterialTheme.typography.labelSmall,
+            color = MaterialTheme.colorScheme.outline
+          )
+          Text(
+            text = if (visit.weight != null) "${visit.weight} kg" else "-",
+            style = MaterialTheme.typography.bodyLarge,
+            fontWeight = FontWeight.SemiBold
+          )
+        }
+
+        Column(modifier = Modifier.weight(1f)) {
+          Text(
+            text = "Blood Pressure",
+            style = MaterialTheme.typography.labelSmall,
+            color = MaterialTheme.colorScheme.outline
+          )
+          Text(
+            text = if (visit.systolic != null && visit.diastolic != null) {
+              "${visit.systolic}/${visit.diastolic} mmHg"
+            } else "-",
+            style = MaterialTheme.typography.bodyLarge,
+            fontWeight = FontWeight.SemiBold
+          )
+        }
+
+        Column(modifier = Modifier.weight(1f)) {
+          Text(
+            text = "Hemoglobin",
+            style = MaterialTheme.typography.labelSmall,
+            color = MaterialTheme.colorScheme.outline
+          )
+          Text(
+            text = if (visit.hemoglobin != null) "${visit.hemoglobin} g/dL" else "Not recorded",
+            style = MaterialTheme.typography.bodyLarge,
+            fontWeight = FontWeight.SemiBold
+          )
+        }
+      }
+
+      // Danger signs if any
+      if (visit.dangerSigns.isNotEmpty()) {
+        Spacer(modifier = Modifier.height(10.dp))
+        val isDanger = visit.dangerSigns.any { !it.equals("none", ignoreCase = true) }
+        val dangerText = visit.dangerSigns.joinToString(", ")
+        Text(
+          text = "Danger signs: $dangerText",
+          style = MaterialTheme.typography.bodyMedium,
+          color = if (isDanger) MaterialTheme.colorScheme.error else MaterialTheme.colorScheme.onSurface,
+          fontWeight = if (isDanger) FontWeight.Bold else FontWeight.Normal
+        )
+      }
+
+      // Notes if any
+      if (!visit.notes.isNullOrBlank()) {
+        Spacer(modifier = Modifier.height(6.dp))
+        Text(
+          text = "Notes: ${visit.notes}",
+          style = MaterialTheme.typography.bodyMedium,
+          color = MaterialTheme.colorScheme.onSurfaceVariant
+        )
+      }
+    }
+  }
+}
