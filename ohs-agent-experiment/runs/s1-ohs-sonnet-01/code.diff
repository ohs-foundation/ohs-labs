+import androidx.compose.ui.platform.LocalContext
+import com.example.ancapp.data.AncRepository
+import dev.ohs.fhir.datacapture.Questionnaire
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.launch
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun NewVisitScreen(patientId: String, onSaved: () -> Unit, onCancel: () -> Unit) {
+  val context = LocalContext.current
+  val scope = rememberCoroutineScope()
+  var questionnaireJson by remember { mutableStateOf<String?>(null) }
+  var saving by remember { mutableStateOf(false) }
+
+  LaunchedEffect(Unit) {
+    questionnaireJson = AncRepository.loadVisitQuestionnaireJson(context)
+  }
+
+  Scaffold(
+    topBar = {
+      TopAppBar(
+        title = { Text("Record ANC visit") },
+        navigationIcon = {
+          IconButton(onClick = onCancel) {
+            Icon(Icons.Filled.ArrowBack, contentDescription = "Cancel")
+          }
+        },
+      )
+    },
+  ) { padding ->
+    Box(modifier = Modifier.fillMaxSize().padding(padding)) {
+      val json = questionnaireJson
+      if (json == null || saving) {
+        CircularProgressIndicator(modifier = Modifier.align(Alignment.Center))
+      } else {
+        Questionnaire(
+          questionnaireJson = json,
+          onSubmit = { getResponse ->
+            scope.launch {
+              saving = true
+              try {
+                val response = getResponse()
+                AncRepository.saveVisit(context, patientId, response)
+                scope.launch { AncRepository.pushLocalChanges(context) }
+                onSaved()
+              } catch (e: CancellationException) {
+                // answer validation failed; the form already shows the errors
+              } finally {
+                saving = false
+              }
+            }
+          },
+          onCancel = onCancel,
+        )
+      }
+    }
+  }
+}
