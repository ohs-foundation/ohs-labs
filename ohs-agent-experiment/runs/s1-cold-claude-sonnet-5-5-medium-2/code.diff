+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun VisitForm(p: Patient, onBack: () -> Unit, onSave: (Visit) -> Unit) {
+  var date by remember { mutableStateOf(LocalDate.now().toString()) }
+  var weeks by remember { mutableStateOf(p.weeks.toString()) }
+  var weight by remember { mutableStateOf("") }
+  var sys by remember { mutableStateOf("") }
+  var dia by remember { mutableStateOf("") }
+  var notes by remember { mutableStateOf("") }
+  var signs by remember { mutableStateOf(emptySet<String>()) }
+  var submitted by remember { mutableStateOf(false) }
+
+  val d = runCatching { LocalDate.parse(date) }.getOrNull()
+  val w = weeks.toIntOrNull()?.takeIf { it in 0..45 }
+  val kg = weight.toDoubleOrNull()?.takeIf { it in 20.0..300.0 }
+  val s = sys.toIntOrNull()?.takeIf { it in 50..300 }
+  val di = dia.toIntOrNull()?.takeIf { it in 30..200 }
+  val ok = d != null && w != null && kg != null && s != null && di != null
+
+  @Composable
+  fun field(label: String, value: String, set: (String) -> Unit, valid: Boolean, num: Boolean = true, mod: Modifier = Modifier.fillMaxWidth()) =
+    OutlinedTextField(
+      value, set, Modifier.then(mod), label = { Text(label) }, isError = submitted && !valid, singleLine = num,
+      keyboardOptions = androidx.compose.foundation.text.KeyboardOptions(keyboardType = if (num) KeyboardType.Decimal else KeyboardType.Text),
+    )
+
+  Scaffold(topBar = {
+    TopAppBar(title = { Text("New visit · ${p.name}") },
+      navigationIcon = { IconButton(onBack) { Icon(Icons.AutoMirrored.Filled.ArrowBack, "Back") } })
+  }) { pad ->
+    Column(Modifier.padding(pad).padding(16.dp).verticalScroll(rememberScrollState()), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+      field("Visit date (yyyy-MM-dd)", date, { date = it }, d != null, num = false)
+      field("Gestational age (weeks)", weeks, { weeks = it }, w != null)
+      field("Weight (kg)", weight, { weight = it }, kg != null)
+      Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+        field("Systolic (mmHg)", sys, { sys = it }, s != null, mod = Modifier.weight(1f))
+        field("Diastolic (mmHg)", dia, { dia = it }, di != null, mod = Modifier.weight(1f))
+      }
+      Text("Danger signs", style = MaterialTheme.typography.titleSmall)
+      DANGER_SIGNS.forEach { sign ->
+        Row(Modifier.fillMaxWidth().clickable { signs = if (sign in signs) signs - sign else signs + sign }, verticalAlignment = Alignment.CenterVertically) {
+          Checkbox(sign in signs, null)
+          Text(sign, Modifier.padding(start = 8.dp))
+        }
+      }
+      if (signs.isEmpty()) Text("None", style = MaterialTheme.typography.bodySmall)
+      OutlinedTextField(notes, { notes = it }, Modifier.fillMaxWidth(), label = { Text("Notes") }, minLines = 3)
+      Button(
+        onClick = {
+          submitted = true
+          if (ok) onSave(Visit(d!!, w!!, kg!!, s!!, di!!, null, DANGER_SIGNS.filter { it in signs }.joinToString(", "), notes.trim()))
+        },
+        Modifier.fillMaxWidth(),
+      ) { Text("Save visit") }
+    }
   }
