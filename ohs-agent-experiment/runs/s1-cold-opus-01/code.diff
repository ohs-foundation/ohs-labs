+package com.example.ancapp.ui.detail
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.example.ancapp.data.AncRepository
+import com.example.ancapp.data.AncVisit
+import com.example.ancapp.data.Patient
+import com.example.ancapp.domain.Gestation
+import com.example.ancapp.domain.ageOn
+import kotlinx.coroutines.flow.SharingStarted
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.combine
+import kotlinx.coroutines.flow.stateIn
+import java.time.LocalDate
+
+data class PatientDetailUiState(
+  val isLoading: Boolean = true,
+  val patient: Patient? = null,
+  val age: Int = 0,
+  val gestationLabel: String = "",
+  val visits: List<AncVisit> = emptyList(),
+)
+
+class PatientDetailViewModel(
+  repository: AncRepository,
+  private val patientId: Long,
+) : ViewModel() {
+
+  val uiState: StateFlow<PatientDetailUiState> = combine(
+    repository.observePatient(patientId),
+    repository.observeVisits(patientId),
+  ) { patient, visits ->
+    val today = LocalDate.now()
+    PatientDetailUiState(
+      isLoading = false,
+      patient = patient,
+      age = patient?.let { ageOn(it.dateOfBirth, today) } ?: 0,
+      gestationLabel = patient?.let { Gestation.format(it.estimatedDueDate, today) }.orEmpty(),
+      visits = visits,
+    )
+  }.stateIn(
+    scope = viewModelScope,
+    started = SharingStarted.WhileSubscribed(5_000),
+    initialValue = PatientDetailUiState(),
+  )
+}
