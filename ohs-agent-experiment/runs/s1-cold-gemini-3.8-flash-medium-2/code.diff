+package com.example.ancapp.ui
+
+import android.app.Application
+import androidx.lifecycle.AndroidViewModel
+import androidx.lifecycle.viewModelScope
+import com.example.ancapp.data.AncVisit
+import com.example.ancapp.data.DangerSigns
+import com.example.ancapp.data.Patient
+import com.example.ancapp.data.PatientRepository
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.SharingStarted
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.combine
+import kotlinx.coroutines.flow.stateIn
+import kotlinx.coroutines.launch
+import java.time.LocalDate
+import java.time.format.DateTimeFormatter
+
+sealed interface Screen {
+    data object Register : Screen
+    data class PatientDetail(val patientId: String) : Screen
+    data class RecordVisit(val patientId: String) : Screen
+}
+
+data class VisitFormState(
+    val visitDate: LocalDate = LocalDate.now(),
+    val gestationalAgeWeeks: String = "",
+    val weightKg: String = "",
+    val systolicBp: String = "",
+    val diastolicBp: String = "",
+    val hemoglobin: String = "",
+    val dangerSigns: Set<String> = setOf(DangerSigns.NONE),
+    val notes: String = "",
+    val errors: Map<String, String> = emptyMap(),
+    val isSaving: Boolean = false
+)
+
+class AncViewModel(application: Application) : AndroidViewModel(application) {
+
+    private val repository = PatientRepository(application)
+
+    private val _currentScreen = MutableStateFlow<Screen>(Screen.Register)
+    val currentScreen: StateFlow<Screen> = _currentScreen.asStateFlow()
+
+    val patients: StateFlow<List<Patient>> = repository.patients
+        .combine(MutableStateFlow(Unit)) { list, _ ->
+            // Sorted by due date (soonest first)
+            list.sortedBy { it.estimatedDueDate }
+        }.stateIn(viewModelScope, SharingStarted.WhileSubscribed(5000), emptyList())
+
+    val visits: StateFlow<List<AncVisit>> = repository.visits
+
+    private val _formState = MutableStateFlow(VisitFormState())
+    val formState: StateFlow<VisitFormState> = _formState.asStateFlow()
+
+    fun navigateToRegister() {
+        _currentScreen.value = Screen.Register
+    }
+
+    fun navigateToPatientDetail(patientId: String) {
+        _currentScreen.value = Screen.PatientDetail(patientId)
+    }
+
+    fun navigateToRecordVisit(patientId: String) {
+        val patient = repository.getPatient(patientId)
+        val today = LocalDate.now()
+        val calculatedWeeks = patient?.calculateGestationalAgeWeeks(today)?.toString() ?: ""
+
+        _formState.value = VisitFormState(
+            visitDate = today,
+            gestationalAgeWeeks = calculatedWeeks,
+            weightKg = "",
+            systolicBp = "",
+            diastolicBp = "",
+            hemoglobin = "",
+            dangerSigns = setOf(DangerSigns.NONE),
+            notes = "",
+            errors = emptyMap()
+        )
+        _currentScreen.value = Screen.RecordVisit(patientId)
+    }
+
+    fun updateVisitDate(date: LocalDate, patientId: String) {
+        val patient = repository.getPatient(patientId)
+        val calculatedWeeks = patient?.calculateGestationalAgeWeeks(date)?.toString() ?: _formState.value.gestationalAgeWeeks
+        _formState.value = _formState.value.copy(
+            visitDate = date,
+            gestationalAgeWeeks = calculatedWeeks,
+            errors = _formState.value.errors - "visitDate"
+        )
+    }
+
+    fun updateGestationalAge(weeks: String) {
+        _formState.value = _formState.value.copy(
+            gestationalAgeWeeks = weeks,
+            errors = _formState.value.errors - "gestationalAge"
+        )
+    }
+
+    fun updateWeight(weight: String) {
+        _formState.value = _formState.value.copy(
+            weightKg = weight,
+            errors = _formState.value.errors - "weight"
+        )
+    }
+
+    fun updateSystolicBp(systolic: String) {
+        _formState.value = _formState.value.copy(
+            systolicBp = systolic,
+            errors = _formState.value.errors - "systolicBp"
+        )
+    }
+
+    fun updateDiastolicBp(diastolic: String) {
+        _formState.value = _formState.value.copy(
+            diastolicBp = diastolic,
+            errors = _formState.value.errors - "diastolicBp"
+        )
+    }
+
+    fun updateHemoglobin(hb: String) {
+        _formState.value = _formState.value.copy(
+            hemoglobin = hb,
+            errors = _formState.value.errors - "hemoglobin"
+        )
+    }
+
+    fun updateNotes(notes: String) {
+        _formState.value = _formState.value.copy(notes = notes)
+    }
+
+    fun toggleDangerSign(sign: String) {
+        val currentSigns = _formState.value.dangerSigns.toMutableSet()
+        if (sign == DangerSigns.NONE) {
+            currentSigns.clear()
+            currentSigns.add(DangerSigns.NONE)
+        } else {
+            currentSigns.remove(DangerSigns.NONE)
+            if (currentSigns.contains(sign)) {
+                currentSigns.remove(sign)
+            } else {
+                currentSigns.add(sign)
+            }
+            if (currentSigns.isEmpty()) {
+                currentSigns.add(DangerSigns.NONE)
+            }
+        }
+        _formState.value = _formState.value.copy(
+            dangerSigns = currentSigns,
+            errors = _formState.value.errors - "dangerSigns"
+        )
+    }
+
+    fun saveVisit(patientId: String, onSuccess: () -> Unit) {
+        val state = _formState.value
+        val errors = mutableMapOf<String, String>()
+
+        val gestationalAge = state.gestationalAgeWeeks.trim().toIntOrNull()
+        if (gestationalAge == null || gestationalAge < 0 || gestationalAge > 50) {
+            errors["gestationalAge"] = "Enter valid weeks (0-50)"
+        }
+
+        val weight = state.weightKg.trim().toDoubleOrNull()
+        if (weight == null || weight <= 20 || weight > 300) {
+            errors["weight"] = "Enter valid weight in kg (e.g. 65.0)"
+        }
+
+        val systolic = state.systolicBp.trim().toIntOrNull()
+        if (systolic == null || systolic <= 40 || systolic > 300) {
+            errors["systolicBp"] = "Enter valid systolic BP (e.g. 120)"
+        }
+
+        val diastolic = state.diastolicBp.trim().toIntOrNull()
+        if (diastolic == null || diastolic <= 20 || diastolic > 200) {
+            errors["diastolicBp"] = "Enter valid diastolic BP (e.g. 80)"
+        }
+
+        var hb: Double? = null
+        if (state.hemoglobin.isNotBlank()) {
+            hb = state.hemoglobin.trim().toDoubleOrNull()
+            if (hb == null || hb <= 2.0 || hb > 30.0) {
+                errors["hemoglobin"] = "Enter valid Hb (e.g. 11.5)"
+            }
+        }
+
+        if (state.dangerSigns.isEmpty()) {
+            errors["dangerSigns"] = "Select at least one danger sign or 'None'"
+        }
+
+        if (errors.isNotEmpty()) {
+            _formState.value = state.copy(errors = errors)
+            return
+        }
+
+        viewModelScope.launch {
+            _formState.value = state.copy(isSaving = true)
+            val newVisit = AncVisit(
+                patientId = patientId,
+                visitDate = state.visitDate,
+                gestationalAgeWeeks = gestationalAge!!,
+                weightKg = weight!!,
+                systolicBp = systolic!!,
+                diastolicBp = diastolic!!,
+                hemoglobin = hb,
+                dangerSigns = state.dangerSigns.toList(),
+                notes = state.notes.trim()
+            )
+            repository.addVisit(newVisit)
+            _formState.value = VisitFormState()
+            _currentScreen.value = Screen.PatientDetail(patientId)
+            onSuccess()
+        }
+    }
+
+    fun getPatient(id: String): Patient? = repository.getPatient(id)
+
+    fun getVisitsForPatient(patientId: String): List<AncVisit> =
+        repository.getVisitsForPatient(patientId)
+}
