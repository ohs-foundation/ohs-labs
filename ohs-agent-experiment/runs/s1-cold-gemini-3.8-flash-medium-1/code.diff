+                            style = MaterialTheme.typography.titleLarge
+                        )
+                        Text(
+                            text = "Patient: ${patient.name}",
+                            style = MaterialTheme.typography.bodySmall,
+                            color = MaterialTheme.colorScheme.onPrimary.copy(alpha = 0.85f)
+                        )
+                    }
+                },
+                navigationIcon = {
+                    IconButton(onClick = onBackClick) {
+                        Icon(
+                            imageVector = Icons.AutoMirrored.Filled.ArrowBack,
+                            contentDescription = "Back",
+                            tint = MaterialTheme.colorScheme.onPrimary
+                        )
+                    }
+                },
+                colors = TopAppBarDefaults.topAppBarColors(
+                    containerColor = MaterialTheme.colorScheme.primary,
+                    titleContentColor = MaterialTheme.colorScheme.onPrimary
+                )
+            )
+        }
+    ) { paddingValues ->
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(paddingValues)
+                .verticalScroll(scrollState)
+                .padding(16.dp),
+            verticalArrangement = Arrangement.spacedBy(16.dp)
+        ) {
+            // Patient Quick Info
+            Card(
+                modifier = Modifier.fillMaxWidth(),
+                shape = RoundedCornerShape(12.dp),
+                colors = CardDefaults.cardColors(
+                    containerColor = MaterialTheme.colorScheme.secondaryContainer.copy(alpha = 0.4f)
+                )
+            ) {
+                Row(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .padding(12.dp),
+                    horizontalArrangement = Arrangement.SpaceBetween,
+                    verticalAlignment = Alignment.CenterVertically
+                ) {
+                    Column {
+                        Text(
+                            text = patient.name,
+                            fontWeight = FontWeight.Bold,
+                            style = MaterialTheme.typography.bodyMedium
+                        )
+                        Text(
+                            text = "EDD: ${patient.getFormattedDueDate()}",
+                            style = MaterialTheme.typography.bodySmall,
+                            color = MaterialTheme.colorScheme.onSecondaryContainer
+                        )
+                    }
+                    Surface(
+                        shape = RoundedCornerShape(8.dp),
+                        color = MaterialTheme.colorScheme.primaryContainer
+                    ) {
+                        Text(
+                            text = patient.getGestationalAgeDisplay(today),
+                            style = MaterialTheme.typography.labelMedium,
+                            fontWeight = FontWeight.Bold,
+                            color = MaterialTheme.colorScheme.onPrimaryContainer,
+                            modifier = Modifier.padding(horizontal = 8.dp, vertical = 4.dp)
+                        )
+                    }
+                }
+            }
+
+            // Error display if validation fails
+            if (errorMessage != null) {
+                Surface(
+                    shape = RoundedCornerShape(8.dp),
+                    color = MaterialTheme.colorScheme.errorContainer,
+                    modifier = Modifier.fillMaxWidth()
+                ) {
+                    Row(
+                        modifier = Modifier.padding(12.dp),
+                        verticalAlignment = Alignment.CenterVertically
+                    ) {
+                        Icon(
+                            imageVector = Icons.Default.Warning,
+                            contentDescription = null,
+                            tint = MaterialTheme.colorScheme.error
+                        )
+                        Spacer(modifier = Modifier.width(8.dp))
+                        Text(
+                            text = errorMessage!!,
+                            color = MaterialTheme.colorScheme.onErrorContainer,
+                            style = MaterialTheme.typography.bodyMedium
+                        )
+                    }
+                }
+            }
+
+            // Section 1: Visit Date & Gestational Age
+            Text(
+                text = "Visit Information",
+                style = MaterialTheme.typography.titleMedium,
+                fontWeight = FontWeight.Bold,
+                color = MaterialTheme.colorScheme.primary
+            )
+
+            Row(
+                modifier = Modifier.fillMaxWidth(),
+                horizontalArrangement = Arrangement.spacedBy(12.dp)
+            ) {
+                OutlinedTextField(
+                    value = visitDate,
+                    onValueChange = {
+                        visitDate = it
+                        errorMessage = null
+                    },
+                    label = { Text("Visit Date") },
+                    placeholder = { Text("YYYY-MM-DD") },
+                    leadingIcon = {
+                        Icon(Icons.Default.CalendarToday, contentDescription = null)
+                    },
+                    modifier = Modifier.weight(1f),
+                    singleLine = true,
+                    keyboardOptions = KeyboardOptions(
+                        keyboardType = KeyboardType.Number,
+                        imeAction = ImeAction.Next
+                    )
+                )
+
+                OutlinedTextField(
+                    value = gestationalWeeksText,
+                    onValueChange = {
+                        gestationalWeeksText = it
+                        errorMessage = null
+                    },
+                    label = { Text("Gestational Age") },
+                    suffix = { Text("wks") },
+                    leadingIcon = {
+                        Icon(Icons.Default.PregnantWoman, contentDescription = null)
+                    },
+                    modifier = Modifier.weight(1f),
+                    singleLine = true,
+                    keyboardOptions = KeyboardOptions(
+                        keyboardType = KeyboardType.Number,
+                        imeAction = ImeAction.Next
+                    )
+                )
+            }
+
+            // Section 2: Vital Signs (Weight & Blood Pressure)
+            Text(
+                text = "Vital Signs",
+                style = MaterialTheme.typography.titleMedium,
+                fontWeight = FontWeight.Bold,
+                color = MaterialTheme.colorScheme.primary
+            )
+
+            OutlinedTextField(
+                value = weightText,
+                onValueChange = {
+                    weightText = it
+                    errorMessage = null
+                },
+                label = { Text("Weight") },
+                placeholder = { Text("e.g. 68.5") },
+                suffix = { Text("kg") },
+                leadingIcon = {
+                    Icon(Icons.Default.MonitorWeight, contentDescription = null)
+                },
+                modifier = Modifier.fillMaxWidth(),
+                singleLine = true,
+                keyboardOptions = KeyboardOptions(
+                    keyboardType = KeyboardType.Decimal,
+                    imeAction = ImeAction.Next
+                )
+            )
+
+            Row(
+                modifier = Modifier.fillMaxWidth(),
+                horizontalArrangement = Arrangement.spacedBy(12.dp)
+            ) {
+                OutlinedTextField(
+                    value = systolicBpText,
+                    onValueChange = {
+                        systolicBpText = it
+                        errorMessage = null
+                    },
+                    label = { Text("Systolic BP") },
+                    placeholder = { Text("e.g. 118") },
+                    suffix = { Text("mmHg") },
+                    leadingIcon = {
+                        Icon(Icons.Default.Favorite, contentDescription = null)
+                    },
+                    modifier = Modifier.weight(1f),
+                    singleLine = true,
+                    keyboardOptions = KeyboardOptions(
+                        keyboardType = KeyboardType.Number,
+                        imeAction = ImeAction.Next
+                    )
+                )
+
+                OutlinedTextField(
+                    value = diastolicBpText,
+                    onValueChange = {
+                        diastolicBpText = it
+                        errorMessage = null
+                    },
+                    label = { Text("Diastolic BP") },
+                    placeholder = { Text("e.g. 76") },
+                    suffix = { Text("mmHg") },
+                    modifier = Modifier.weight(1f),
+                    singleLine = true,
+                    keyboardOptions = KeyboardOptions(
+                        keyboardType = KeyboardType.Number,
+                        imeAction = ImeAction.Next
+                    )
+                )
+            }
+
+            // Section 3: Laboratory / Tests (Hemoglobin)
+            Text(
+                text = "Laboratory (Optional)",
+                style = MaterialTheme.typography.titleMedium,
+                fontWeight = FontWeight.Bold,
+                color = MaterialTheme.colorScheme.primary
+            )
+
+            OutlinedTextField(
+                value = hemoglobinText,
+                onValueChange = {
+                    hemoglobinText = it
+                    errorMessage = null
+                },
+                label = { Text("Hemoglobin (Hb)") },
+                placeholder = { Text("e.g. 11.8 (optional)") },
+                suffix = { Text("g/dL") },
+                leadingIcon = {
+                    Icon(Icons.Default.Bloodtype, contentDescription = null)
+                },
+                modifier = Modifier.fillMaxWidth(),
+                singleLine = true,
+                keyboardOptions = KeyboardOptions(
+                    keyboardType = KeyboardType.Decimal,
+                    imeAction = ImeAction.Next
+                )
+            )
+
+            // Section 4: Danger Signs
+            Text(
+                text = "Danger Signs (Multiple allowed)",
+                style = MaterialTheme.typography.titleMedium,
+                fontWeight = FontWeight.Bold,
+                color = MaterialTheme.colorScheme.primary
+            )
+
+            Card(
+                modifier = Modifier.fillMaxWidth(),
+                shape = RoundedCornerShape(12.dp),
+                colors = CardDefaults.cardColors(
+                    containerColor = MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.35f)
+                )
+            ) {
+                Column(modifier = Modifier.padding(12.dp)) {
+                    DangerSigns.ALL.forEach { sign ->
+                        val isSelected = selectedDangerSigns.contains(sign)
+                        val isDanger = sign != DangerSigns.NONE
+
+                        Row(
+                            modifier = Modifier
+                                .fillMaxWidth()
+                                .clip(RoundedCornerShape(8.dp))
+                                .clickable { toggleDangerSign(sign) }
+                                .padding(vertical = 4.dp, horizontal = 4.dp),
+                            verticalAlignment = Alignment.CenterVertically
+                        ) {
+                            Checkbox(
+                                checked = isSelected,
+                                onCheckedChange = null,
+                                colors = if (isDanger && isSelected) {
+                                    CheckboxDefaults.colors(
+                                        checkedColor = MaterialTheme.colorScheme.error
+                                    )
+                                } else {
+                                    CheckboxDefaults.colors()
+                                }
+                            )
+                            Spacer(modifier = Modifier.width(8.dp))
+                            Text(
+                                text = sign,
+                                style = MaterialTheme.typography.bodyMedium,
+                                fontWeight = if (isSelected) FontWeight.SemiBold else FontWeight.Normal,
+                                color = if (isDanger && isSelected) {
+                                    MaterialTheme.colorScheme.error
+                                } else {
+                                    MaterialTheme.colorScheme.onSurface
+                                }
+                            )
+                        }
+                    }
+                }
+            }
+
+            // Section 5: Clinical Notes
+            Text(
+                text = "Clinical Notes",
+                style = MaterialTheme.typography.titleMedium,
+                fontWeight = FontWeight.Bold,
+                color = MaterialTheme.colorScheme.primary
+            )
+
+            OutlinedTextField(
+                value = notesText,
+                onValueChange = { notesText = it },
+                label = { Text("Free-text notes") },
+                placeholder = { Text("Observations, prescriptions, follow-up instructions...") },
+                leadingIcon = {
+                    Icon(Icons.AutoMirrored.Filled.Notes, contentDescription = null)
+                },
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .height(110.dp),
+                maxLines = 4
+            )
+
+            Spacer(modifier = Modifier.height(8.dp))
+
+            // Save Visit Button
+            Button(
+                onClick = {
+                    // Validation
+                    val trimmedDate = visitDate.trim()
+                    if (trimmedDate.isEmpty()) {
+                        errorMessage = "Please enter visit date"
+                        return@Button
+                    }
+                    try {
+                        LocalDate.parse(trimmedDate)
+                    } catch (_: Exception) {
+                        errorMessage = "Invalid visit date format. Use YYYY-MM-DD"
+                        return@Button
+                    }
+
+                    val gestationalAge = gestationalWeeksText.trim().toIntOrNull()
+                    if (gestationalAge == null || gestationalAge < 1 || gestationalAge > 45) {
+                        errorMessage = "Please enter a valid gestational age in weeks (1-45)"
+                        return@Button
+                    }
+
+                    val weight = weightText.trim().toDoubleOrNull()
+                    if (weight == null || weight <= 20.0 || weight >= 250.0) {
+                        errorMessage = "Please enter a valid weight in kg (e.g. 68.5)"
+                        return@Button
+                    }
+
+                    val systolic = systolicBpText.trim().toIntOrNull()
+                    if (systolic == null || systolic < 50 || systolic > 250) {
+                        errorMessage = "Please enter a valid systolic BP in mmHg (e.g. 118)"
+                        return@Button
+                    }
+
+                    val diastolic = diastolicBpText.trim().toIntOrNull()
+                    if (diastolic == null || diastolic < 30 || diastolic > 180) {
+                        errorMessage = "Please enter a valid diastolic BP in mmHg (e.g. 76)"
+                        return@Button
+                    }
+
+                    val hemoglobin = if (hemoglobinText.isNotBlank()) {
+                        val hbVal = hemoglobinText.trim().toDoubleOrNull()
+                        if (hbVal == null || hbVal <= 2.0 || hbVal > 25.0) {
+                            errorMessage = "Please enter a valid hemoglobin value in g/dL (e.g. 11.8)"
+                            return@Button
+                        }
+                        hbVal
+                    } else {
+                        null
+                    }
+
+                    val signs = if (selectedDangerSigns.isEmpty()) {
+                        listOf(DangerSigns.NONE)
+                    } else {
+                        selectedDangerSigns.toList()
+                    }
+
+                    onSaveVisit(
+                        trimmedDate,
+                        gestationalAge,
+                        weight,
+                        systolic,
+                        diastolic,
+                        hemoglobin,
+                        signs,
+                        notesText.trim()
+                    )
+                },
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .height(52.dp),
+                shape = RoundedCornerShape(12.dp)
+            ) {
+                Icon(Icons.Default.Save, contentDescription = null)
+                Spacer(modifier = Modifier.width(8.dp))
+                Text(
+                    text = "Save Visit Record",
+                    style = MaterialTheme.typography.titleMedium,
+                    fontWeight = FontWeight.Bold
+                )
+            }
+
+            Spacer(modifier = Modifier.height(16.dp))
+        }
+    }
+}
