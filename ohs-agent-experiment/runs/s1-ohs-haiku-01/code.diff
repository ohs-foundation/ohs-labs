+          value = gestationalAge,
+          onValueChange = { gestationalAge = it },
+          label = { Text("Gestational Age (weeks)") },
+          modifier = Modifier.fillMaxWidth()
+        )
+      }
+
+      item {
+        OutlinedTextField(
+          value = weight,
+          onValueChange = { weight = it },
+          label = { Text("Weight (kg)") },
+          modifier = Modifier.fillMaxWidth()
+        )
+      }
+
+      item {
+        OutlinedTextField(
+          value = systolic,
+          onValueChange = { systolic = it },
+          label = { Text("Systolic BP (mmHg)") },
+          modifier = Modifier.fillMaxWidth()
+        )
+      }
+
+      item {
+        OutlinedTextField(
+          value = diastolic,
+          onValueChange = { diastolic = it },
+          label = { Text("Diastolic BP (mmHg)") },
+          modifier = Modifier.fillMaxWidth()
+        )
+      }
+
+      item {
+        OutlinedTextField(
+          value = hemoglobin,
+          onValueChange = { hemoglobin = it },
+          label = { Text("Hemoglobin (g/dL) - Optional") },
+          modifier = Modifier.fillMaxWidth()
+        )
+      }
+
+      item {
+        Text("Danger Signs", fontWeight = FontWeight.Bold)
+      }
+
+      item {
+        Row(
+          modifier = Modifier.fillMaxWidth(),
+          verticalAlignment = Alignment.CenterVertically
+        ) {
+          Checkbox(checked = vaginalBleeding, onCheckedChange = { vaginalBleeding = it })
+          Text("Vaginal Bleeding")
+        }
+      }
+
+      item {
+        Row(
+          modifier = Modifier.fillMaxWidth(),
+          verticalAlignment = Alignment.CenterVertically
+        ) {
+          Checkbox(checked = severeHeadache, onCheckedChange = { severeHeadache = it })
+          Text("Severe Headache")
+        }
+      }
+
+      item {
+        Row(
+          modifier = Modifier.fillMaxWidth(),
+          verticalAlignment = Alignment.CenterVertically
+        ) {
+          Checkbox(checked = blurredVision, onCheckedChange = { blurredVision = it })
+          Text("Blurred Vision")
+        }
+      }
+
+      item {
+        Row(
+          modifier = Modifier.fillMaxWidth(),
+          verticalAlignment = Alignment.CenterVertically
+        ) {
+          Checkbox(checked = fever, onCheckedChange = { fever = it })
+          Text("Fever")
+        }
+      }
+
+      item {
+        OutlinedTextField(
+          value = notes,
+          onValueChange = { notes = it },
+          label = { Text("Notes") },
+          modifier = Modifier
+            .fillMaxWidth()
+            .run { Modifier },
+          minLines = 3
+        )
+      }
+
+      item {
+        Button(
+          onClick = {
+            try {
+              val date = LocalDate.parse(visitDate)
+              val age = gestationalAge.toIntOrNull() ?: return@Button
+              val wt = weight.toDoubleOrNull() ?: return@Button
+              val sys = systolic.toIntOrNull() ?: return@Button
+              val dias = diastolic.toIntOrNull() ?: return@Button
+              val hgb = hemoglobin.toDoubleOrNull()
+
+              val selectedSigns = mutableListOf<String>()
+              if (vaginalBleeding) selectedSigns.add("vaginal bleeding")
+              if (severeHeadache) selectedSigns.add("severe headache")
+              if (blurredVision) selectedSigns.add("blurred vision")
+              if (fever) selectedSigns.add("fever")
+
+              onSaveVisit(date, age, wt, sys, dias, hgb, notes, selectedSigns)
+            } catch (e: Exception) {
+              e.printStackTrace()
+            }
+          },
+          modifier = Modifier
+            .fillMaxWidth()
+            .padding(vertical = 16.dp)
+        ) {
+          Text("Save Visit")
+        }
+      }
+    }
+  }
+}
+
+private fun calculateAge(dateOfBirth: LocalDate): Int {
+  return Period.between(dateOfBirth, LocalDate.now()).years
+}
+
+private fun calculateWeeksPregnant(dateOfBirth: LocalDate, dueDate: LocalDate): Int {
+  val gestationDays = 280
+  val totalDays = gestationDays.toLong()
+  val daysSinceLmp = java.time.temporal.ChronoUnit.DAYS.between(dateOfBirth, LocalDate.now())
+  return ((gestationDays - (java.time.temporal.ChronoUnit.DAYS.between(LocalDate.now(), dueDate))).toInt() / 7).coerceAtLeast(0)
+}
