+import kotlinx.coroutines.launch
+import kotlinx.serialization.json.Json
+
+private val json = Json {
+  explicitNulls = false
+  encodeDefaults = false
+}
+
+private fun CurrentSyncJobStatus.isFinal() =
+  this is CurrentSyncJobStatus.Succeeded || this is CurrentSyncJobStatus.Failed || this is CurrentSyncJobStatus.Cancelled
+
+class AncViewModel(app: Application) : AndroidViewModel(app) {
+  val engine = FhirEngineProvider.getInstance(app)
+  val syncState = MutableStateFlow<String?>(null)
+  /** Bumped whenever local data changes, so screens reload. */
+  val dataVersion = MutableStateFlow(0)
+  private var syncJob: Job? = null
+
+  init { syncNow() }
+
+  fun syncNow() {
+    if (syncJob?.isActive == true) return
+    syncJob = viewModelScope.launch {
+      var ran = false
+      Sync.oneTimeSync<AppSyncWorker>(getApplication())
+        .transformWhile { emit(it); !it.isFinal() }
+        .catch { syncState.value = "Sync status unknown" }
+        .collect { status ->
+          syncState.value = when (status) {
+            is CurrentSyncJobStatus.Enqueued -> if (ran) "Waiting to retry" else "Waiting to sync"
+            is CurrentSyncJobStatus.Running -> { ran = true; "Syncing…" }
+            is CurrentSyncJobStatus.Succeeded -> { dataVersion.value++; "Synced" }
+            is CurrentSyncJobStatus.Failed -> "Sync failed, will try again later"
+            else -> syncState.value
+          }
+        }
+    }
+  }
+}
 
 class MainActivity : ComponentActivity() {
   override fun onCreate(savedInstanceState: Bundle?) {
     super.onCreate(savedInstanceState)
-    setContent { MaterialTheme { Surface { Text("Hello") } } }
+    setContent { MaterialTheme { AncNav() } }
+  }
+}
+
+@Composable
+fun AncNav(vm: AncViewModel = viewModel()) {
+  val nav = rememberNavController()
+  NavHost(nav, startDestination = "register") {
+    composable("register") { RegisterScreen(vm) { nav.navigate("patient/$it") } }
+    composable("patient/{id}") { entry ->
+      val id = entry.arguments?.getString("id")!!
+      PatientScreen(vm, id, onBack = { nav.popBackStack() }, onNewVisit = { nav.navigate("visit/$id") })
+    }
+    // Own destination = own ViewModelStoreOwner, so each new visit form starts blank.
+    composable("visit/{id}") { entry ->
+      VisitFormScreen(vm, entry.arguments?.getString("id")!!) { nav.popBackStack() }
+    }
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun RegisterScreen(vm: AncViewModel, onOpen: (String) -> Unit) {
+  val version by vm.dataVersion.collectAsState()
+  val sync by vm.syncState.collectAsState()
+  var rows by remember { mutableStateOf<List<PatientRow>?>(null) }
+  LaunchedEffect(version) { rows = loadRegister(vm.engine) }
+
+  Scaffold(
+    topBar = {
+      TopAppBar(
+        title = { Text("ANC register") },
+        actions = { TextButton(onClick = vm::syncNow) { Text("Sync") } },
+      )
+    }
+  ) { pad ->
+    Column(Modifier.padding(pad).fillMaxSize()) {
+      sync?.let { Text(it, Modifier.padding(horizontal = 16.dp), style = MaterialTheme.typography.labelMedium) }
+      when {
+        rows == null -> Text("Loading…", Modifier.padding(16.dp))
+        rows!!.isEmpty() -> Text("No patients yet. Waiting for sync with the server.", Modifier.padding(16.dp))
+        else -> LazyColumn {
+          items(rows!!, key = { it.id }) { p ->
+            Column(Modifier.fillMaxWidth().clickable { onOpen(p.id) }.padding(16.dp)) {
+              Text(p.name, style = MaterialTheme.typography.titleMedium)
+              Text(
+                listOf(
+                  "Age ${p.age ?: "?"}",
+                  "EDD ${p.dueDate ?: "unknown"}",
+                  p.weeks?.let { "$it weeks" } ?: "GA unknown",
+                ).joinToString("  •  "),
+                style = MaterialTheme.typography.bodyMedium,
+              )
+            }
+            HorizontalDivider()
+          }
+        }
+      }
+    }
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun PatientScreen(vm: AncViewModel, patientId: String, onBack: () -> Unit, onNewVisit: () -> Unit) {
+  val version by vm.dataVersion.collectAsState()
+  var name by remember { mutableStateOf("") }
+  var visits by remember { mutableStateOf<List<Visit>?>(null) }
+  LaunchedEffect(version) {
+    name = loadRegister(vm.engine).firstOrNull { it.id == patientId }?.name.orEmpty()
+    visits = loadVisits(vm.engine, patientId)
+  }
+
+  Scaffold(
+    topBar = {
+      TopAppBar(title = { Text(name) }, navigationIcon = { TextButton(onClick = onBack) { Text("Back") } })
+    },
+    floatingActionButton = {
+      ExtendedFloatingActionButton(onClick = onNewVisit) { Text("Record visit") }
+    },
+  ) { pad ->
+    LazyColumn(Modifier.padding(pad).fillMaxSize()) {
+      item { Text("ANC visits", Modifier.padding(16.dp), style = MaterialTheme.typography.titleMedium) }
+      if (visits?.isEmpty() == true) item { Text("No visits recorded.", Modifier.padding(16.dp)) }
+      items(visits.orEmpty()) { v ->
+        Column(Modifier.fillMaxWidth().padding(16.dp)) {
+          Text(v.date, style = MaterialTheme.typography.titleSmall)
+          Row(horizontalArrangement = Arrangement.spacedBy(16.dp)) {
+            Text("Weight: ${v.weight?.let { "$it kg" } ?: "—"}")
+            Text("BP: ${v.bp?.let { "$it mmHg" } ?: "—"}")
+          }
+          v.hb?.let { Text("Hb: $it g/dL") }
+        }
+        HorizontalDivider()
+      }
+    }
+  }
+}
+
+@Composable
+fun VisitFormScreen(vm: AncViewModel, patientId: String, close: () -> Unit) {
+  val scope = rememberCoroutineScope()
+  var questionnaireJson by remember { mutableStateOf<String?>(null) }
+  var missing by remember { mutableStateOf(false) }
+  LaunchedEffect(Unit) {
+    runCatching { vm.engine.get<FhirQuestionnaire>("anc-contact") }
+      .onSuccess { questionnaireJson = json.encodeToString(it) }
+      .onFailure { missing = true; vm.syncNow() }
+  }
+
+  Scaffold { pad ->
+    Column(Modifier.padding(pad).fillMaxSize()) {
+      when {
+        questionnaireJson != null -> Questionnaire(
+          questionnaireJson = questionnaireJson!!,
+          onSubmit = { getResponse ->
+            scope.launch {
+              val response = try {
+                getResponse()
+              } catch (e: CancellationException) {
+                return@launch // validation failed; the form shows the errors
+              }
+              saveVisit(vm.engine, patientId, response)
+              vm.dataVersion.value++
+              vm.syncNow()
+              close()
+            }
+          },
+          onCancel = close,
+        )
+        missing -> Column(Modifier.padding(16.dp)) {
+          Text("The visit form has not been downloaded yet. Connect to the clinic server and try again.")
+          TextButton(onClick = close) { Text("Back") }
+        }
+        else -> Text("Loading form…", Modifier.padding(16.dp))
+      }
+    }
   }
