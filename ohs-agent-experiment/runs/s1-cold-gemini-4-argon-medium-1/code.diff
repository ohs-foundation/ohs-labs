+package com.example.ancapp.model
+
+import java.time.LocalDate
+import java.time.Period
+import java.time.temporal.ChronoUnit
+
+enum class DangerSign(val label: String) {
+  NONE("None"),
+  VAGINAL_BLEEDING("Vaginal bleeding"),
+  SEVERE_HEADACHE("Severe headache"),
+  BLURRED_VISION("Blurred vision"),
+  FEVER("Fever");
+
+  companion object {
+    fun fromNameOrNull(name: String): DangerSign? =
+      entries.find { it.name.equals(name.trim(), ignoreCase = true) }
+
+    fun serializeList(signs: List<DangerSign>): String {
+      val normalized = if (signs.isEmpty()) listOf(NONE) else signs
+      return normalized.joinToString(",") { it.name }
+    }
+
+    fun deserializeList(serialized: String?): List<DangerSign> {
+      if (serialized.isNullOrBlank()) return listOf(NONE)
+      val parsed = serialized.split(",")
+        .mapNotNull { fromNameOrNull(it) }
+        .distinct()
+      return if (parsed.isEmpty()) listOf(NONE) else parsed
+    }
+  }
+}
+
+data class AncVisit(
+  val id: Long = 0L,
+  val patientId: Long,
+  val visitDate: LocalDate,
+  val gestationalAgeWeeks: Int,
+  val weightKg: Double,
+  val systolicBp: Int,
+  val diastolicBp: Int,
+  val hemoglobinGdl: Double? = null,
+  val dangerSigns: List<DangerSign> = listOf(DangerSign.NONE),
+  val notes: String = ""
+) {
+  val formattedBp: String
+    get() = "$systolicBp/$diastolicBp mmHg"
+
+  val hasActiveDangerSigns: Boolean
+    get() = dangerSigns.any { it != DangerSign.NONE }
+
+  val formattedDangerSigns: String
+    get() = if (dangerSigns.isEmpty() || (dangerSigns.size == 1 && dangerSigns.first() == DangerSign.NONE)) {
+      DangerSign.NONE.label
+    } else {
+      dangerSigns.filter { it != DangerSign.NONE }.joinToString(", ") { it.label }
+    }
+}
+
+data class Patient(
+  val id: Long = 0L,
+  val name: String,
+  val dateOfBirth: LocalDate,
+  val estimatedDueDate: LocalDate
+) {
+  fun ageYears(referenceDate: LocalDate = LocalDate.now()): Int {
+    return Period.between(dateOfBirth, referenceDate).years.coerceAtLeast(0)
+  }
+
+  fun currentPregnancyWeeks(referenceDate: LocalDate = LocalDate.now()): Int {
+    return Companion.calculateGestationalWeeks(estimatedDueDate, referenceDate)
+  }
+
+  companion object {
+    /**
+     * Standard 40-week (280-day) gestation calculation based on Estimated Due Date (EDD).
+     */
+    fun calculateGestationalWeeks(
+      estimatedDueDate: LocalDate,
+      onDate: LocalDate = LocalDate.now()
+    ): Int {
+      val daysUntilDue = ChronoUnit.DAYS.between(onDate, estimatedDueDate)
+      val gestationalDays = 280L - daysUntilDue
+      return (gestationalDays / 7L).toInt().coerceIn(1, 45)
+    }
+  }
+}
+
+data class PatientWithVisits(
+  val patient: Patient,
+  val visits: List<AncVisit>
+) {
+  val lastVisit: AncVisit?
+    get() = visits.maxWithOrNull(compareBy<AncVisit> { it.visitDate }.thenBy { it.id })
+}
