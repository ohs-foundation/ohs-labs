+package com.example.ancapp
+
+import android.app.Application
+import android.content.Context
+import androidx.work.WorkerParameters
+import dev.ohs.fhir.datacapture.DataCapture
+import dev.ohs.fhir.engine.FhirEngineConfiguration
+import dev.ohs.fhir.engine.FhirEngineProvider
+import dev.ohs.fhir.engine.ServerConfiguration
+import dev.ohs.fhir.engine.sync.AcceptRemoteConflictResolver
+import dev.ohs.fhir.engine.sync.FhirSyncWorker
+import dev.ohs.fhir.engine.sync.download.ResourceParamsBasedDownloadWorkManager
+import dev.ohs.fhir.engine.sync.upload.HttpCreateMethod
+import dev.ohs.fhir.engine.sync.upload.HttpUpdateMethod
+import dev.ohs.fhir.engine.sync.upload.UploadStrategy
+import dev.ohs.fhir.model.r4.terminologies.ResourceType
+
+class AncApp : Application() {
+  override fun onCreate() {
+    super.onCreate()
+    FhirEngineProvider.init(
+      FhirEngineConfiguration(serverConfiguration = ServerConfiguration(baseUrl = "http://10.0.2.2:8080/fhir/")),
+      this,
+    )
+    FhirEngineProvider.getInstance(this)
+    DataCapture.initialize(this)
+  }
+}
+
+class AppSyncWorker(ctx: Context, params: WorkerParameters) : FhirSyncWorker(ctx, params) {
+  override fun getFhirEngine() = FhirEngineProvider.getInstance(applicationContext)
+
+  override fun getDownloadWorkManager() =
+    ResourceParamsBasedDownloadWorkManager(
+      syncParams = listOf(ResourceType.Patient, ResourceType.Encounter, ResourceType.Observation, ResourceType.Questionnaire)
+        .associateWith { emptyMap<String, String>() },
+      context = object : ResourceParamsBasedDownloadWorkManager.TimestampContext {
+        private val prefs get() = applicationContext.getSharedPreferences("sync_ts", Context.MODE_PRIVATE)
+        override suspend fun saveLastUpdatedTimestamp(resourceType: ResourceType, timestamp: String?) {
+          prefs.edit().putString(resourceType.name, timestamp).apply()
+        }
+        override suspend fun getLasUpdateTimestamp(resourceType: ResourceType): String? = prefs.getString(resourceType.name, null)
+      },
+    )
+
+  override fun getConflictResolver() = AcceptRemoteConflictResolver
+
+  override fun getUploadStrategy() =
+    UploadStrategy.forIndividualRequest(HttpCreateMethod.PUT, HttpUpdateMethod.PATCH, squash = true)
+}
