+package com.example.ancapp.data
+
+import dev.ohs.fhir.model.r4.Date
+import dev.ohs.fhir.model.r4.DateTime
+import dev.ohs.fhir.model.r4.FhirDate
+import dev.ohs.fhir.model.r4.FhirDateTime
+import java.time.LocalDate
+
+fun FhirDate?.toJavaLocalDate(): LocalDate? =
+  when (this) {
+    is FhirDate.Date -> LocalDate.parse(date.toString())
+    else -> null
+  }
+
+fun FhirDateTime?.toJavaLocalDate(): LocalDate? =
+  when (this) {
+    is FhirDateTime.Date -> LocalDate.parse(date.toString())
+    is FhirDateTime.DateTime -> LocalDate.parse(dateTime.date.toString())
+    else -> null
+  }
+
+fun Date?.toJavaLocalDate(): LocalDate? = this?.value.toJavaLocalDate()
+
+fun DateTime?.toJavaLocalDate(): LocalDate? = this?.value.toJavaLocalDate()
+
+fun LocalDate.toFhirDate(): Date = Date(value = FhirDate.fromString(this.toString()))
+
+fun LocalDate.toFhirDateTime(): DateTime = DateTime(value = FhirDateTime.fromString(this.toString()))
