index 0000000..9ad2a72
--- /dev/null
+++ b/app/src/main/java/com/example/ancapp/Fhir.kt
@@ -0,0 +1,131 @@
+package com.example.ancapp
+
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import dev.ohs.fhir.model.r4.Resource
+import java.net.HttpURLConnection
+import java.net.URL
+import java.time.LocalDate
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+import kotlinx.serialization.json.Json
+import org.json.JSONArray
+import org.json.JSONObject
+
+// ponytail: plain HttpURLConnection + org.json for reads; FHIR Engine sync/offline cache if the clinic needs offline use.
+const val BASE = "http://10.0.2.2:8080/fhir"
+const val SIGNS = "urn:example:anc-danger-signs"
+
+data class Visit(
+  val date: String, val weeks: Int?, val weight: Double?, val bp: String?, val hb: Double?,
+  val dangerSigns: List<String>, val notes: String?,
+)
+
+data class Patient(val id: String, val name: String, val dob: String, val edd: LocalDate, val visits: List<Visit>) {
+  val age get() = ChronoUnit.YEARS.between(LocalDate.parse(dob), LocalDate.now()).toInt()
+  val weeks get() = (40 - ChronoUnit.DAYS.between(LocalDate.now(), edd) / 7).toInt().coerceIn(0, 42)
+}
+
+private fun http(method: String, url: String, body: String? = null): String {
+  val c = URL(url).openConnection() as HttpURLConnection
+  c.requestMethod = method
+  c.setRequestProperty("Accept", "application/fhir+json")
+  if (body != null) {
+    c.doOutput = true
+    c.setRequestProperty("Content-Type", "application/fhir+json")
+    c.outputStream.use { it.write(body.toByteArray()) }
+  }
+  val ok = c.responseCode in 200..299
+  val text = (if (ok) c.inputStream else c.errorStream).bufferedReader().use { it.readText() }
+  check(ok) { "HTTP ${c.responseCode}: $text" }
+  return text
+}
+
+private fun JSONArray?.objs() = this?.let { a -> (0 until a.length()).map { a.getJSONObject(it) } } ?: emptyList()
+
+private fun entries(type: String) =
+  JSONObject(http("GET", "$BASE/$type?_count=500")).optJSONArray("entry").objs().map { it.getJSONObject("resource") }
+
+private fun JSONObject.ref(field: String) = optJSONObject(field)?.optString("reference")?.substringAfter('/')
+private fun JSONObject.loinc() = getJSONObject("code").getJSONArray("coding").getJSONObject(0).getString("code")
+
+fun loadPatients(): List<Patient> {
+  val obs = entries("Observation")
+  val encs = entries("Encounter")
+  return entries("Patient").mapNotNull { p ->
+    val id = p.getString("id")
+    val edd = obs.firstOrNull { it.ref("subject") == id && it.loinc() == "11778-8" }
+      ?.optString("valueDateTime")?.takeIf { it.isNotEmpty() } ?: return@mapNotNull null // no EDD = not pregnant
+    val n = p.getJSONArray("name").getJSONObject(0)
+    val visits = encs.filter { it.ref("subject") == id }.map { e ->
+      val o = obs.filter { it.ref("encounter") == e.getString("id") }.associateBy { it.loinc() }
+      val bp = o["85354-9"]?.optJSONArray("component").objs().associate {
+        it.loinc() to it.getJSONObject("valueQuantity").getInt("value")
+      }
+      Visit(
+        date = e.getJSONObject("period").getString("start"),
+        weeks = o["11884-4"]?.optJSONObject("valueQuantity")?.getInt("value"),
+        weight = o["29463-7"]?.optJSONObject("valueQuantity")?.getDouble("value"),
+        bp = if (bp["8480-6"] != null) "${bp["8480-6"]}/${bp["8462-4"]}" else null,
+        hb = o["718-7"]?.optJSONObject("valueQuantity")?.getDouble("value"),
+        dangerSigns = obs.filter { it.ref("encounter") == e.getString("id") && it.loinc() == "danger-sign" }
+          .map { it.getJSONObject("valueCodeableConcept").getString("text") },
+        notes = o["48767-8"]?.optString("valueString"),
+      )
+    }.sortedByDescending { it.date }
+    Patient(id, "${n.getJSONArray("given").getString(0)} ${n.getString("family")}", p.getString("birthDate"), LocalDate.parse(edd), visits)
+  }.sortedBy { it.edd }
+}
+
+fun loadQuestionnaire() = http("GET", "$BASE/Questionnaire/anc-contact")
+
+/** Flattens answers by linkId from the QuestionnaireResponse JSON. */
+private fun answers(items: JSONArray?, out: MutableMap<String, List<JSONObject>> = mutableMapOf()): Map<String, List<JSONObject>> {
+  items.objs().forEach { out[it.getString("linkId")] = it.optJSONArray("answer").objs(); answers(it.optJSONArray("item"), out) }
+  return out
+}
+
+private val json = Json { ignoreUnknownKeys = true }
+
+/** Saves the form as a transaction: Encounter + Observations on the server. */
+fun saveVisit(patientId: String, qr: QuestionnaireResponse) {
+  val a = answers(JSONObject(json.encodeToString(Resource.serializer(), qr)).optJSONArray("item"))
+  val date = a["visit-date"]?.firstOrNull()?.getString("valueDate") ?: error("Visit date required")
+  val subject = JSONObject().put("reference", "Patient/$patientId")
+  val enc = "urn:uuid:${UUID.randomUUID()}"
+  val entries = JSONArray().put(entry(JSONObject()
+    .put("resourceType", "Encounter").put("status", "finished").put("subject", subject)
+    .put("class", JSONObject().put("system", "http://terminology.hl7.org/CodeSystem/v3-ActCode").put("code", "AMB"))
+    .put("type", JSONArray().put(JSONObject().put("text", "Antenatal care contact")))
+    .put("period", JSONObject().put("start", date).put("end", date)), "Encounter", enc))
+
+  fun obs(code: String, text: String, vararg v: Pair<String, Any>, comp: JSONArray? = null) {
+    val o = JSONObject().put("resourceType", "Observation").put("status", "final").put("subject", subject)
+      .put("encounter", JSONObject().put("reference", enc)).put("effectiveDateTime", date)
+      .put("code", JSONObject().put("coding", JSONArray().put(JSONObject().put("system", if (code == "danger-sign") SIGNS else "http://loinc.org").put("code", code))).put("text", text))
+    v.forEach { o.put(it.first, it.second) }
+    comp?.let { o.put("component", it) }
+    entries.put(entry(o, "Observation"))
+  }
+  fun qty(v: Number, unit: String, code: String = unit) =
+    JSONObject().put("value", v).put("unit", unit).put("system", "http://unitsofmeasure.org").put("code", code)
+
+  a["gestational-age"]?.firstOrNull()?.optInt("valueInteger")?.let { obs("11884-4", "Gestational age", "valueQuantity" to qty(it, "weeks", "wk")) }
+  a["weight"]?.firstOrNull()?.optDouble("valueDecimal")?.takeIf { !it.isNaN() }?.let { obs("29463-7", "Body weight", "valueQuantity" to qty(it, "kg")) }
+  val sys = a["bp-systolic"]?.firstOrNull()?.optInt("valueInteger")
+  val dia = a["bp-diastolic"]?.firstOrNull()?.optInt("valueInteger")
+  if (sys != null && dia != null) {
+    fun c(code: String, v: Int) = JSONObject().put("code", JSONObject().put("coding", JSONArray().put(JSONObject().put("system", "http://loinc.org").put("code", code)))).put("valueQuantity", qty(v, "mmHg", "mm[Hg]"))
+    obs("85354-9", "Blood pressure", comp = JSONArray().put(c("8480-6", sys)).put(c("8462-4", dia)))
+  }
+  a["danger-signs"].orEmpty().mapNotNull { it.optJSONObject("valueCoding") }.filter { it.getString("code") != "none" }.forEach { s ->
+    obs("danger-sign", "Danger sign", "valueCodeableConcept" to JSONObject().put("text", s.getString("display"))
+      .put("coding", JSONArray().put(JSONObject().put("system", SIGNS).put("code", s.getString("code")))))
+  }
+  a["notes"]?.firstOrNull()?.optString("valueString")?.takeIf { it.isNotBlank() }?.let { obs("48767-8", "Annotation comment", "valueString" to it) }
+
+  http("POST", BASE, JSONObject().put("resourceType", "Bundle").put("type", "transaction").put("entry", entries).toString())
+}
+
+private fun entry(r: JSONObject, type: String, fullUrl: String = "urn:uuid:${UUID.randomUUID()}") = JSONObject()
+  .put("fullUrl", fullUrl)
+  .put("resource", r).put("request", JSONObject().put("method", "POST").put("url", type))
