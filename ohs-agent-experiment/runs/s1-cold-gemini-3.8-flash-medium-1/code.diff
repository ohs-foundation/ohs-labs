+package com.example.ancapp.ui.theme
+
+import androidx.compose.ui.graphics.Color
+
+val TealPrimary = Color(0xFF006874)
+val TealOnPrimary = Color(0xFFFFFFFF)
+val TealPrimaryContainer = Color(0xFF9EEFFD)
+val TealOnPrimaryContainer = Color(0xFF001F24)
+
+val SecondaryTeal = Color(0xFF4A6267)
+val OnSecondaryTeal = Color(0xFFFFFFFF)
+val SecondaryContainer = Color(0xFFCDE7EC)
+val OnSecondaryContainer = Color(0xFF051F23)
+
+val DangerRed = Color(0xFFBA1A1A)
+val DangerRedContainer = Color(0xFFFFDAD6)
+val OnDangerRed = Color(0xFFFFFFFF)
+val OnDangerRedContainer = Color(0xFF410002)
+
+val CardBackground = Color(0xFFF7FAFA)
