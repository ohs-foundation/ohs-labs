+package com.example.ancapp.ui
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.example.ancapp.data.AncRepository
+import com.example.ancapp.data.Visit
+import kotlinx.coroutines.launch
+import java.time.LocalDate
+
+class VisitFormViewModel(
+    private val repository: AncRepository,
+    private val patientId: Long
+) : ViewModel() {
+
+    suspend fun saveVisit(
+        visitDate: LocalDate,
+        gestationalAgeWeeks: Int,
+        weightKg: Double,
+        systolicBP: Int,
+        diastolicBP: Int,
+        hemoglobinGdL: Double?,
+        dangerSigns: String,
+        notes: String
+    ) {
+        val visit = Visit(
+            patientId = patientId,
+            visitDate = visitDate,
+            gestationalAgeWeeks = gestationalAgeWeeks,
+            weightKg = weightKg,
+            systolicBP = systolicBP,
+            diastolicBP = diastolicBP,
+            hemoglobinGdL = hemoglobinGdL,
+            dangerSigns = dangerSigns,
+            notes = notes
+        )
+        repository.insertVisit(visit)
+    }
+}
