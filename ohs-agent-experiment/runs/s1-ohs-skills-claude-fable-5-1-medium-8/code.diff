 class MainActivity : ComponentActivity() {
   override fun onCreate(savedInstanceState: Bundle?) {
     super.onCreate(savedInstanceState)
-    setContent { MaterialTheme { Surface { Text("Hello") } } }
+    setContent { MaterialTheme { AncApp() } }
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun AncApp() {
+  val nav = rememberNavController()
+  val vm: AncViewModel = viewModel()
+  NavHost(nav, startDestination = "register") {
+    composable("register") {
+      val patients by vm.patients.collectAsState()
+      val sync by vm.syncState.collectAsState()
+      Scaffold(topBar = { TopAppBar(title = { Text("ANC Register") }) }) { pad ->
+        Column(Modifier.padding(pad)) {
+          Text(sync, Modifier.padding(16.dp, 4.dp), style = MaterialTheme.typography.labelMedium)
+          LazyColumn {
+            items(patients, key = { it.id }) { p ->
+              ListItem(
+                modifier = Modifier.clickable { nav.navigate("patient/${p.id}") },
+                headlineContent = { Text("${p.name}, ${p.age}") },
+                supportingContent = { Text("Due ${p.dueDate ?: "unknown"} · ${p.weeks?.let { "$it weeks" } ?: "GA unknown"}") },
+              )
+              HorizontalDivider()
+            }
+          }
+        }
+      }
+    }
+    composable("patient/{id}") { entry ->
+      val id = entry.arguments?.getString("id")!!
+      val patient = vm.patients.collectAsState().value.firstOrNull { it.id == id }
+      var refresh by remember { mutableStateOf(0) }
+      val visits by produceState(emptyList<Visit>(), refresh) { value = vm.visits(id) }
+      LaunchedEffect(Unit) { entry.savedStateHandle.getStateFlow("saved", 0).collect { refresh = it } }
+      Scaffold(topBar = { TopAppBar(title = { Text(patient?.name ?: "Patient") }) }) { pad ->
+        Column(Modifier.padding(pad).fillMaxSize()) {
+          Button({ nav.navigate("visit/$id") }, Modifier.padding(16.dp).fillMaxWidth()) { Text("Record ANC visit") }
+          Text("Past visits", Modifier.padding(16.dp, 0.dp), style = MaterialTheme.typography.titleMedium)
+          LazyColumn {
+            items(visits) { v ->
+              ListItem(
+                headlineContent = { Text(v.date) },
+                supportingContent = {
+                  Text(listOfNotNull(v.weight, v.bp, v.hb?.let { "Hb $it" }).ifEmpty { listOf("No vitals recorded") }.joinToString(" · "))
+                },
+              )
+              HorizontalDivider()
+            }
+          }
+        }
+      }
+    }
+    composable("visit/{id}") { entry ->
+      val id = entry.arguments?.getString("id")!!
+      val scope = rememberCoroutineScope()
+      val json by produceState<String?>(null) { value = runCatching { vm.questionnaireJson() }.getOrNull() }
+      val q = json
+      if (q == null) {
+        Text("Visit form not available yet (waiting for sync)", Modifier.padding(16.dp))
+        return@composable
+      }
+      Questionnaire(
+        questionnaireJson = q,
+        onSubmit = { getResponse ->
+          scope.launch {
+            try {
+              vm.saveVisit(id, getResponse())
+              nav.previousBackStackEntry?.savedStateHandle?.let { h -> h["saved"] = (h.get<Int>("saved") ?: 0) + 1 }
+              nav.popBackStack()
+            } catch (_: CancellationException) { /* form shows validation errors */ }
+          }
+        },
+        onCancel = { nav.popBackStack() },
+      )
+    }
   }
 }
