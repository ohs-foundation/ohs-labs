+package com.example.ancapp.data
+
+import android.content.ContentValues
+import android.content.Context
+import android.database.sqlite.SQLiteDatabase
+import android.database.sqlite.SQLiteOpenHelper
+import com.example.ancapp.model.AncVisit
+import com.example.ancapp.model.DangerSign
+import com.example.ancapp.model.Patient
+import com.example.ancapp.model.PatientWithVisits
+
+class AncDatabaseHelper(context: Context) :
+  SQLiteOpenHelper(context.applicationContext, DATABASE_NAME, null, DATABASE_VERSION) {
+
+  override fun onConfigure(db: SQLiteDatabase) {
+    super.onConfigure(db)
+    db.setForeignKeyConstraintsEnabled(true)
+  }
+
+  override fun onCreate(db: SQLiteDatabase) {
+    db.execSQL(
+      """
+      CREATE TABLE $TABLE_PATIENTS (
+        $COL_PATIENT_ID INTEGER PRIMARY KEY AUTOINCREMENT,
+        $COL_PATIENT_NAME TEXT NOT NULL,
+        $COL_PATIENT_DOB TEXT NOT NULL,
+        $COL_PATIENT_EDD TEXT NOT NULL
+      )
+      """.trimIndent()
+    )
+
+    db.execSQL(
+      """
+      CREATE TABLE $TABLE_VISITS (
+        $COL_VISIT_ID INTEGER PRIMARY KEY AUTOINCREMENT,
+        $COL_VISIT_PATIENT_ID INTEGER NOT NULL,
+        $COL_VISIT_DATE TEXT NOT NULL,
+        $COL_VISIT_GA_WEEKS INTEGER NOT NULL,
+        $COL_VISIT_WEIGHT REAL NOT NULL,
+        $COL_VISIT_SYSTOLIC INTEGER NOT NULL,
+        $COL_VISIT_DIASTOLIC INTEGER NOT NULL,
+        $COL_VISIT_HB REAL,
+        $COL_VISIT_DANGER_SIGNS TEXT NOT NULL,
+        $COL_VISIT_NOTES TEXT NOT NULL,
+        FOREIGN KEY($COL_VISIT_PATIENT_ID) REFERENCES $TABLE_PATIENTS($COL_PATIENT_ID) ON DELETE CASCADE
+      )
+      """.trimIndent()
+    )
+
+    seedInitialData(db)
+  }
+
+  override fun onUpgrade(db: SQLiteDatabase, oldVersion: Int, newVersion: Int) {
+    db.execSQL("DROP TABLE IF EXISTS $TABLE_VISITS")
+    db.execSQL("DROP TABLE IF EXISTS $TABLE_PATIENTS")
+    onCreate(db)
+  }
+
+  private fun seedInitialData(db: SQLiteDatabase) {
+    db.beginTransaction()
+    try {
+      // 1. Emily Carter | 1996-04-12 | 2026-12-05 | 2026-08-10 | 68.5 kg | 118/76 | 11.8 g/dL
+      val emilyId =
+        insertPatientInternal(
+          db = db,
+          name = "Emily Carter",
+          dob = "1996-04-12",
+          edd = "2026-12-05",
+        )
+      insertVisitInternal(
+        db = db,
+        visit =
+          AncVisit(
+            patientId = emilyId,
+            visitDate = "2026-08-10",
+            gestationalAgeWeeks = 23,
+            weightKg = 68.5,
+            systolicBp = 118,
+            diastolicBp = 76,
+            hemoglobinGdL = 11.8,
+            dangerSigns = emptyList(),
+            notes = "",
+          ),
+      )
+
+      // 2. Sarah Mitchell | 1990-11-02 | 2027-01-20 | 2026-08-12 | 61.2 kg | 110/70 | 12.4 g/dL
+      val sarahId =
+        insertPatientInternal(
+          db = db,
+          name = "Sarah Mitchell",
+          dob = "1990-11-02",
+          edd = "2027-01-20",
+        )
+      insertVisitInternal(
+        db = db,
+        visit =
+          AncVisit(
+            patientId = sarahId,
+            visitDate = "2026-08-12",
+            gestationalAgeWeeks = 17,
+            weightKg = 61.2,
+            systolicBp = 110,
+            diastolicBp = 70,
+            hemoglobinGdL = 12.4,
+            dangerSigns = emptyList(),
+            notes = "",
+          ),
+      )
+
+      // 3. Grace Thompson | 2001-07-30 | 2026-10-15 | 2026-08-05 | 72.0 kg | 128/84 | 10.2 g/dL
+      val graceId =
+        insertPatientInternal(
+          db = db,
+          name = "Grace Thompson",
+          dob = "2001-07-30",
+          edd = "2026-10-15",
+        )
+      insertVisitInternal(
+        db = db,
+        visit =
+          AncVisit(
+            patientId = graceId,
+            visitDate = "2026-08-05",
+            gestationalAgeWeeks = 29,
+            weightKg = 72.0,
+            systolicBp = 128,
+            diastolicBp = 84,
+            hemoglobinGdL = 10.2,
+            dangerSigns = emptyList(),
+            notes = "",
+          ),
+      )
+
+      db.setTransactionSuccessful()
+    } finally {
+      db.endTransaction()
+    }
+  }
+
+  private fun insertPatientInternal(
+    db: SQLiteDatabase,
+    name: String,
+    dob: String,
+    edd: String,
+  ): Long {
+    val values =
+      ContentValues().apply {
+        put(COL_PATIENT_NAME, name)
+        put(COL_PATIENT_DOB, dob)
+        put(COL_PATIENT_EDD, edd)
+      }
+    return db.insertOrThrow(TABLE_PATIENTS, null, values)
+  }
+
+  private fun insertVisitInternal(db: SQLiteDatabase, visit: AncVisit): Long {
+    val values =
+      ContentValues().apply {
+        put(COL_VISIT_PATIENT_ID, visit.patientId)
+        put(COL_VISIT_DATE, visit.visitDate)
+        put(COL_VISIT_GA_WEEKS, visit.gestationalAgeWeeks)
+        put(COL_VISIT_WEIGHT, visit.weightKg)
+        put(COL_VISIT_SYSTOLIC, visit.systolicBp)
+        put(COL_VISIT_DIASTOLIC, visit.diastolicBp)
+        if (visit.hemoglobinGdL != null) {
+          put(COL_VISIT_HB, visit.hemoglobinGdL)
+        } else {
+          putNull(COL_VISIT_HB)
+        }
+        put(COL_VISIT_DANGER_SIGNS, DangerSign.toDbString(visit.dangerSigns))
+        put(COL_VISIT_NOTES, visit.notes)
+      }
+    return db.insertOrThrow(TABLE_VISITS, null, values)
+  }
+
+  @Synchronized
+  fun insertVisit(visit: AncVisit): Long {
+    val db = writableDatabase
+    return insertVisitInternal(db, visit)
+  }
+
+  @Synchronized
+  fun getAllPatientsSortedByDueDate(): List<PatientWithVisits> {
+    val db = writableDatabase
+    val patients = mutableListOf<Patient>()
+
+    // Sort patients by estimated due date ascending (soonest first)
+    db.query(
+        TABLE_PATIENTS,
+        null,
+        null,
+        null,
+        null,
+        null,
+        "$COL_PATIENT_EDD ASC, $COL_PATIENT_ID ASC",
+      )
+      .use { cursor ->
+        val idIdx = cursor.getColumnIndexOrThrow(COL_PATIENT_ID)
+        val nameIdx = cursor.getColumnIndexOrThrow(COL_PATIENT_NAME)
+        val dobIdx = cursor.getColumnIndexOrThrow(COL_PATIENT_DOB)
+        val eddIdx = cursor.getColumnIndexOrThrow(COL_PATIENT_EDD)
+
+        while (cursor.moveToNext()) {
+          patients.add(
+            Patient(
+              id = cursor.getLong(idIdx),
+              name = cursor.getString(nameIdx),
+              dateOfBirth = cursor.getString(dobIdx),
+              estimatedDueDate = cursor.getString(eddIdx),
+            )
+          )
+        }
+      }
+
+    // If database somehow had 0 patients, seed it immediately
+    if (patients.isEmpty()) {
+      seedInitialData(db)
+      return getAllPatientsSortedByDueDate()
+    }
+
+    val visitsByPatient = mutableMapOf<Long, MutableList<AncVisit>>()
+    db.query(
+        TABLE_VISITS,
+        null,
+        null,
+        null,
+        null,
+        null,
+        "$COL_VISIT_DATE DESC, $COL_VISIT_ID DESC",
+      )
+      .use { cursor ->
+        val idIdx = cursor.getColumnIndexOrThrow(COL_VISIT_ID)
+        val patientIdIdx = cursor.getColumnIndexOrThrow(COL_VISIT_PATIENT_ID)
+        val dateIdx = cursor.getColumnIndexOrThrow(COL_VISIT_DATE)
+        val gaIdx = cursor.getColumnIndexOrThrow(COL_VISIT_GA_WEEKS)
+        val weightIdx = cursor.getColumnIndexOrThrow(COL_VISIT_WEIGHT)
+        val sysIdx = cursor.getColumnIndexOrThrow(COL_VISIT_SYSTOLIC)
+        val diaIdx = cursor.getColumnIndexOrThrow(COL_VISIT_DIASTOLIC)
+        val hbIdx = cursor.getColumnIndexOrThrow(COL_VISIT_HB)
+        val signsIdx = cursor.getColumnIndexOrThrow(COL_VISIT_DANGER_SIGNS)
+        val notesIdx = cursor.getColumnIndexOrThrow(COL_VISIT_NOTES)
+
+        while (cursor.moveToNext()) {
+          val patientId = cursor.getLong(patientIdIdx)
+          val hb = if (cursor.isNull(hbIdx)) null else cursor.getDouble(hbIdx)
+          val visit =
+            AncVisit(
+              id = cursor.getLong(idIdx),
+              patientId = patientId,
+              visitDate = cursor.getString(dateIdx),
+              gestationalAgeWeeks = cursor.getInt(gaIdx),
+              weightKg = cursor.getDouble(weightIdx),
+              systolicBp = cursor.getInt(sysIdx),
+              diastolicBp = cursor.getInt(diaIdx),
+              hemoglobinGdL = hb,
+              dangerSigns = DangerSign.fromDbString(cursor.getString(signsIdx)),
+              notes = cursor.getString(notesIdx) ?: "",
+            )
+          visitsByPatient.getOrPut(patientId) { mutableListOf() }.add(visit)
+        }
+      }
+
+    return patients.map { patient ->
+      PatientWithVisits(
+        patient = patient,
+        visits = visitsByPatient[patient.id] ?: emptyList(),
+      )
+    }
+  }
+
+  companion object {
+    private const val DATABASE_NAME = "anc_clinic.db"
+    private const val DATABASE_VERSION = 1
+
+    private const val TABLE_PATIENTS = "patients"
+    private const val COL_PATIENT_ID = "id"
+    private const val COL_PATIENT_NAME = "name"
+    private const val COL_PATIENT_DOB = "date_of_birth"
+    private const val COL_PATIENT_EDD = "estimated_due_date"
+
+    private const val TABLE_VISITS = "anc_visits"
+    private const val COL_VISIT_ID = "id"
+    private const val COL_VISIT_PATIENT_ID = "patient_id"
+    private const val COL_VISIT_DATE = "visit_date"
+    private const val COL_VISIT_GA_WEEKS = "gestational_age_weeks"
+    private const val COL_VISIT_WEIGHT = "weight_kg"
+    private const val COL_VISIT_SYSTOLIC = "systolic_bp"
+    private const val COL_VISIT_DIASTOLIC = "diastolic_bp"
+    private const val COL_VISIT_HB = "hemoglobin_gdl"
+    private const val COL_VISIT_DANGER_SIGNS = "danger_signs"
+    private const val COL_VISIT_NOTES = "notes"
+
+    @Volatile private var instance: AncDatabaseHelper? = null
+
+    fun getInstance(context: Context): AncDatabaseHelper {
+      return instance
+        ?: synchronized(this) {
+          instance ?: AncDatabaseHelper(context.applicationContext).also { instance = it }
+        }
+    }
+  }
+}
