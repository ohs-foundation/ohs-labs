+package com.example.ancapp
+
+import java.time.LocalDate
+import org.json.JSONObject
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class FhirTest {
+  private val q = JSONObject(javaClass.getResource("/anc-contact.json")!!.readText())
+  private val today = LocalDate.parse("2026-10-23")
+
+  @Test fun formRoundTripsThroughBundle() {
+    val raw = mapOf(
+      "visit-date" to "2026-10-20", "gestational-age" to "34", "weight" to "70.5",
+      "bp-systolic" to "120", "bp-diastolic" to "80",
+      "danger-signs" to setOf("fever", "severe-headache"), "notes" to "tired",
+    )
+    val (typed, errors) = validate(q, raw, today)
+    assertEquals(emptyMap<String, String>(), errors)
+    val visits = parseVisits(buildVisitBundle("p1", q, typed))
+    assertEquals(listOf(Visit("2026-10-20", 34, 70.5, 120, 80, null, listOf("Severe headache", "Fever"), "tired")), visits)
+  }
+
+  @Test fun rejectsBadInput() {
+    val (_, errors) = validate(q, mapOf("visit-date" to "2026-12-01", "bp-systolic" to "80", "bp-diastolic" to "90", "weight" to "x"), today)
+    assertEquals(setOf("visit-date", "bp-diastolic", "weight"), errors.keys)
+  }
+
+  @Test fun gestationalAgeFromEdd() {
+    assertEquals(281 + 7, Patient("x", "x", null, LocalDate.parse("2026-10-15")).gaDays(today))
+  }
+}
