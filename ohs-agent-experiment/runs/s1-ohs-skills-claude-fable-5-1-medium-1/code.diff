+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun RegisterScreen(repo: AncRepo, onOpen: (String) -> Unit) {
+  var rows by remember { mutableStateOf<List<RegisterRow>?>(null) }
+  var status by remember { mutableStateOf("Syncing…") }
+  LaunchedEffect(Unit) {
+    rows = repo.register()
+    status = if (repo.sync()) "" else "Sync failed; showing local data"
+    rows = repo.register()
+  }
+  Scaffold(topBar = { TopAppBar(title = { Text("ANC Register") }) }) { pad ->
+    Column(Modifier.padding(pad)) {
+      if (status.isNotEmpty()) Text(status, Modifier.padding(16.dp), style = MaterialTheme.typography.bodySmall)
+      when (val list = rows) {
+        null -> Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) { CircularProgressIndicator() }
+        else -> LazyColumn {
+          if (list.isEmpty()) item { Text("No pregnant patients found.", Modifier.padding(16.dp)) }
+          items(list) { r ->
+            ListItem(
+              modifier = Modifier.clickable { onOpen(r.id) },
+              headlineContent = { Text("${r.name}, ${r.age}") },
+              supportingContent = { Text("Due ${r.dueDate} · ${r.weeks} weeks") },
+            )
+            HorizontalDivider()
+          }
+        }
+      }
+    }
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun PatientScreen(repo: AncRepo, id: String, onNewVisit: () -> Unit) {
+  var name by remember { mutableStateOf("") }
+  var visits by remember { mutableStateOf<List<Visit>>(emptyList()) }
+  LaunchedEffect(id) { name = repo.patientName(id); visits = repo.visits(id) }
+  Scaffold(topBar = { TopAppBar(title = { Text(name) }) }) { pad ->
+    Column(Modifier.padding(pad)) {
+      Button(onClick = onNewVisit, Modifier.padding(16.dp).fillMaxWidth()) { Text("Record ANC visit") }
+      LazyColumn {
+        if (visits.isEmpty()) item { Text("No visits recorded.", Modifier.padding(16.dp)) }
+        items(visits) { v ->
+          ListItem(
+            headlineContent = { Text(v.date) },
+            supportingContent = {
+              Text(listOfNotNull(v.weight, v.bp?.let { "BP $it" }, v.hb?.let { "Hb $it" }).joinToString("  ·  ").ifEmpty { "No measurements" })
+            },
+          )
+          HorizontalDivider()
+        }
+      }
+    }
+  }
+}
+
+@Composable
+fun VisitScreen(repo: AncRepo, patientId: String, onDone: () -> Unit) {
+  var q by remember { mutableStateOf<String?>(null) }
+  var loaded by remember { mutableStateOf(false) }
+  val scope = rememberCoroutineScope()
+  LaunchedEffect(Unit) { q = repo.questionnaireJson(); loaded = true }
+  when {
+    !loaded -> Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) { CircularProgressIndicator() }
+    q == null -> Column(Modifier.padding(16.dp)) {
+      Text("Visit form not available yet. Sync with the server and try again.")
+      Button(onClick = onDone) { Text("Back") }
+    }
+    else -> Questionnaire(
+      questionnaireJson = q!!,
+      onSubmit = { getResponse ->
+        scope.launch {
+          try {
+            repo.saveVisit(patientId, getResponse())
+            onDone()
+          } catch (_: CancellationException) { /* validation errors shown by the form */ }
+        }
+      },
+      onCancel = onDone,
+    )
   }
 }
