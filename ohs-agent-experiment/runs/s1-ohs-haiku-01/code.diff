+package com.example.ancapp.data
+
+import androidx.room.Entity
+import androidx.room.ForeignKey
+import androidx.room.PrimaryKey
+import java.time.LocalDate
+
+@Entity(tableName = "patients")
+data class PatientEntity(
+  @PrimaryKey
+  val id: String,
+  val name: String,
+  val dateOfBirth: LocalDate,
+  val estimatedDueDate: LocalDate
+)
+
+@Entity(
+  tableName = "anc_visits",
+  foreignKeys = [
+    ForeignKey(
+      entity = PatientEntity::class,
+      parentColumns = ["id"],
+      childColumns = ["patientId"],
+      onDelete = ForeignKey.CASCADE
+    )
+  ]
+)
+data class AncVisitEntity(
+  @PrimaryKey(autoGenerate = true)
+  val id: Long = 0,
+  val patientId: String,
+  val visitDate: LocalDate,
+  val gestationalAgeWeeks: Int,
+  val weightKg: Double,
+  val systolicBp: Int,
+  val diastolicBp: Int,
+  val hemoglobinGdl: Double? = null,
+  val notes: String = ""
+)
+
+@Entity(
+  tableName = "danger_signs",
+  foreignKeys = [
+    ForeignKey(
+      entity = AncVisitEntity::class,
+      parentColumns = ["id"],
+      childColumns = ["visitId"],
+      onDelete = ForeignKey.CASCADE
+    )
+  ]
+)
+data class DangerSignEntity(
+  @PrimaryKey(autoGenerate = true)
+  val id: Long = 0,
+  val visitId: Long,
+  val sign: String
+)
+
+data class PatientWithVisits(
+  val patient: PatientEntity,
+  val visits: List<AncVisitEntity>
+)
+
+data class AncVisitWithSigns(
+  val visit: AncVisitEntity,
+  val dangerSigns: List<DangerSignEntity>
+)
