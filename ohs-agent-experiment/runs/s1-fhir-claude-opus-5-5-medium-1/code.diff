+// Plausibility limits for numeric answers, by Questionnaire linkId.
+private val RANGES = mapOf(
+  "gestational-age" to 1.0..45.0,
+  "weight" to 25.0..250.0,
+  "bp-systolic" to 50.0..260.0,
+  "bp-diastolic" to 30.0..180.0,
+)
+
+@Composable
+fun VisitFormScreen(p: Patient, onDone: () -> Unit) {
+  val (q, error, retry) = rememberLoad(Unit) { Fhir.questionnaire() }
+  val text = remember { mutableStateMapOf("visit-date" to LocalDate.now().toString()) }
+  val choices = remember { mutableStateMapOf<String, List<JSONObject>>() }
+  var errors by remember { mutableStateOf(mapOf<String, String>()) }
+  var saving by remember { mutableStateOf(false) }
+  var saveError by remember { mutableStateOf<String?>(null) }
+  val scope = rememberCoroutineScope()
+
+  Screen("New visit · ${p.name}", onDone) { padding ->
+    if (q == null) return@Screen LoadState(error, retry, padding)
+    val leaves = remember(q) { leafItems(q) }
+
+    fun save() {
+      val answers = mutableMapOf<String, Any>()
+      val errs = mutableMapOf<String, String>()
+      for (item in leaves) {
+        val id = item.getString("linkId")
+        val raw = text[id]?.trim().orEmpty()
+        val type = item.optString("type")
+        if (type == "choice") {
+          choices[id]?.takeIf { it.isNotEmpty() }?.let { answers[id] = it }
+            ?: if (item.optBoolean("required")) errs[id] = "Required" else Unit
+          continue
+        }
+        if (raw.isEmpty()) {
+          if (item.optBoolean("required")) errs[id] = "Required"
+          continue
+        }
+        val value: Any? = when (type) {
+          "integer" -> raw.toIntOrNull()
+          "decimal" -> raw.replace(',', '.').toDoubleOrNull()
+          "date" -> runCatching { LocalDate.parse(raw) }.getOrNull()
+            ?.takeIf { !it.isAfter(LocalDate.now()) }?.toString()
+          else -> raw
+        }
+        val range = RANGES[id]
+        when {
+          value == null -> errs[id] = if (type == "date") "Use YYYY-MM-DD, not in the future" else "Enter a number"
+          range != null && (value as Number).toDouble() !in range ->
+            errs[id] = "Must be ${range.start.toInt()}–${range.endInclusive.toInt()}"
+          else -> answers[id] = value
+        }
+      }
+      val sys = answers["bp-systolic"] as? Int
+      val dia = answers["bp-diastolic"] as? Int
+      if ((sys == null) != (dia == null)) errs[if (sys == null) "bp-systolic" else "bp-diastolic"] = "Enter both systolic and diastolic"
+      else if (sys != null && dia != null && sys <= dia) errs["bp-systolic"] = "Systolic must be above diastolic"
+      errors = errs
+      if (errs.isNotEmpty()) return
+      saving = true
+      saveError = null
+      scope.launch {
+        runCatching { Fhir.saveVisit(p.id, q, answers) }
+          .onSuccess { onDone() }
+          .onFailure { saveError = it.message ?: it.toString(); saving = false }
+      }
+    }
+
+    Column(
+      Modifier.fillMaxSize().padding(padding).imePadding().verticalScroll(rememberScrollState()).padding(16.dp),
+      verticalArrangement = Arrangement.spacedBy(12.dp),
+    ) {
+      q.optJSONArray("item")?.objects()?.forEach { QuestionItem(it, text, choices, errors) }
+      saveError?.let { Text("Save failed: $it", color = MaterialTheme.colorScheme.error) }
+      Button(onClick = ::save, enabled = !saving, modifier = Modifier.fillMaxWidth()) {
+        Text(if (saving) "Saving…" else "Save visit")
+      }
+    }
+  }
+}
+
+private fun leafItems(q: JSONObject): List<JSONObject> {
+  fun walk(o: JSONObject): List<JSONObject> =
+    o.optJSONArray("item")?.objects()?.flatMap { if (it.optString("type") == "group") walk(it) else listOf(it) }.orEmpty()
+  return walk(q)
+}
+
+@Composable
+fun QuestionItem(
+  item: JSONObject,
+  text: MutableMap<String, String>,
+  choices: MutableMap<String, List<JSONObject>>,
+  errors: Map<String, String>,
+) {
+  val id = item.getString("linkId")
+  val label = item.optString("text", id) + if (item.optBoolean("required")) " *" else ""
+  val error = errors[id]
+  when (val type = item.optString("type")) {
+    "group" -> {
+      Text(label, style = MaterialTheme.typography.titleMedium)
+      item.optJSONArray("item")?.objects()?.forEach { QuestionItem(it, text, choices, errors) }
+    }
+    "choice" -> Column {
+      Text(label, style = MaterialTheme.typography.titleSmall)
+      val options = item.optJSONArray("answerOption")?.objects()?.mapNotNull { it.optJSONObject("valueCoding") }.orEmpty()
+      val selected = choices[id].orEmpty()
+      val repeats = item.optBoolean("repeats")
+      options.forEach { opt ->
+        val code = opt.optString("code")
+        val checked = selected.any { it.optString("code") == code }
+        fun toggle() {
+          choices[id] = when {
+            !repeats -> listOf(opt)
+            checked -> selected.filter { it.optString("code") != code }
+            // "None" excludes every other sign, and vice versa.
+            code == "none" -> listOf(opt)
+            else -> selected.filter { it.optString("code") != "none" } + opt
+          }
+        }
+        Row(verticalAlignment = Alignment.CenterVertically, modifier = Modifier.fillMaxWidth().clickable(onClick = ::toggle)) {
+          if (repeats) Checkbox(checked, { toggle() }) else RadioButton(checked, ::toggle)
+          Text(opt.optString("display", code))
+        }
+      }
+      error?.let { Text(it, color = MaterialTheme.colorScheme.error) }
+    }
+    else -> OutlinedTextField(
+      value = text[id].orEmpty(),
+      onValueChange = { text[id] = it },
+      label = { Text(label) },
+      placeholder = if (type == "date") ({ Text("YYYY-MM-DD") }) else null,
+      isError = error != null,
+      supportingText = error?.let { { Text(it) } },
+      singleLine = type != "text",
+      minLines = if (type == "text") 3 else 1,
+      keyboardOptions = KeyboardOptions(keyboardType = when (type) {
+        "integer" -> KeyboardType.Number
+        "decimal" -> KeyboardType.Decimal
+        else -> KeyboardType.Text
+      }),
