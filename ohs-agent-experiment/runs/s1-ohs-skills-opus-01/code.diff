+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.runtime.saveable.rememberSaveable
+import androidx.compose.runtime.setValue
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import androidx.lifecycle.viewmodel.compose.viewModel
+import com.example.ancapp.ui.AncViewModel
+import com.example.ancapp.ui.PatientDetailScreen
+import com.example.ancapp.ui.RegisterScreen
+import com.example.ancapp.ui.VisitFormScreen
 
 class MainActivity : ComponentActivity() {
   override fun onCreate(savedInstanceState: Bundle?) {
     super.onCreate(savedInstanceState)
-    setContent { MaterialTheme { Surface { Text("Hello") } } }
+    setContent { MaterialTheme { Surface { AncApp() } } }
+  }
+}
+
+@Composable
+private fun AncApp(viewModel: AncViewModel = viewModel()) {
+  var patientId by rememberSaveable { mutableStateOf<String?>(null) }
+  var patientName by rememberSaveable { mutableStateOf("") }
+  var showingForm by rememberSaveable { mutableStateOf(false) }
+
+  val register by viewModel.register.collectAsStateWithLifecycle()
+  val detail by viewModel.detail.collectAsStateWithLifecycle()
+  val form by viewModel.form.collectAsStateWithLifecycle()
+  val syncing by viewModel.syncing.collectAsStateWithLifecycle()
+  val banner by viewModel.banner.collectAsStateWithLifecycle()
+  val scope = rememberCoroutineScope()
+
+  val openPatientId = patientId
+
+  when {
+    openPatientId != null && showingForm -> {
+      BackHandler { showingForm = false }
+      VisitFormScreen(
+        patientName = patientName,
+        state = form,
+        scope = scope,
+        onSaved = { showingForm = false },
+        onSave = { response -> viewModel.saveVisit(openPatientId, response) },
+        onCancel = { showingForm = false },
+      )
+    }
+
+    openPatientId != null -> {
+      BackHandler { patientId = null }
+      PatientDetailScreen(
+        state = detail,
+        onBack = { patientId = null },
+        onRecordVisit = {
+          showingForm = true
+          viewModel.openVisitForm()
