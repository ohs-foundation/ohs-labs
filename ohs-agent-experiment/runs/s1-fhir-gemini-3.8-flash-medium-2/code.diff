@@ -0,0 +1,99 @@
+package com.example.ancapp.data
+
+import org.json.JSONArray
+import org.json.JSONObject
+
+class AncRepository(
+    private val fhirClient: FhirClient = FhirClient()
+) {
+    private var cachedPatients: List<PatientInfo> = emptyList()
+    private var cachedDangerSigns: List<DangerSignOption>? = null
+
+    suspend fun getPatients(forceRefresh: Boolean = false): List<PatientInfo> {
+        if (!forceRefresh && cachedPatients.isNotEmpty()) {
+            return cachedPatients
+        }
+        val patients = fhirClient.getPatients()
+        cachedPatients = patients
+        return patients
+    }
+
+    suspend fun getVisitsForPatient(patientId: String): List<AncVisit> {
+        return fhirClient.getVisitsForPatient(patientId)
+    }
+
+    suspend fun getDangerSignOptions(): List<DangerSignOption> {
+        cachedDangerSigns?.let { return it }
+
+        val defaultOptions = listOf(
+            DangerSignOption("none", "None"),
+            DangerSignOption("vaginal-bleeding", "Vaginal bleeding"),
+            DangerSignOption("severe-headache", "Severe headache"),
+            DangerSignOption("blurred-vision", "Blurred vision"),
+            DangerSignOption("fever", "Fever")
+        )
+
+        try {
+            val qJson = fhirClient.getQuestionnaire("anc-contact")
+            if (qJson != null) {
+                val parsed = parseDangerSignsFromQuestionnaire(qJson)
+                if (parsed.isNotEmpty()) {
+                    cachedDangerSigns = parsed
+                    return parsed
+                }
+            }
+        } catch (_: Exception) {}
+
+        cachedDangerSigns = defaultOptions
+        return defaultOptions
+    }
+
+    private fun parseDangerSignsFromQuestionnaire(q: JSONObject): List<DangerSignOption> {
+        val result = mutableListOf<DangerSignOption>()
+        fun searchItems(items: JSONArray) {
+            for (i in 0 until items.length()) {
+                val item = items.getJSONObject(i)
+                if (item.optString("linkId") == "danger-signs") {
+                    val opts = item.optJSONArray("answerOption")
+                    if (opts != null) {
+                        for (j in 0 until opts.length()) {
+                            val coding = opts.getJSONObject(j).optJSONObject("valueCoding")
+                            if (coding != null) {
+                                val code = coding.optString("code")
+                                val display = coding.optString("display", code)
+                                result.add(DangerSignOption(code, display))
+                            }
+                        }
+                    }
+                }
+                val nested = item.optJSONArray("item")
+                if (nested != null) searchItems(nested)
+            }
+        }
+        val items = q.optJSONArray("item")
+        if (items != null) searchItems(items)
+        return result
+    }
+
+    suspend fun saveVisit(
+        patientId: String,
+        visitDate: String,
+        gestationalAgeWeeks: Int?,
+        weightKg: Double?,
+        systolicBp: Int?,
+        diastolicBp: Int?,
+        dangerSigns: List<DangerSignOption>,
+        notes: String?
+    ): Result<Unit> {
+        return fhirClient.saveAncVisit(
+            patientId = patientId,
+            visitDate = visitDate,
+            gestationalAgeWeeks = gestationalAgeWeeks,
+            weightKg = weightKg,
+            systolicBp = systolicBp,
+            diastolicBp = diastolicBp,
+            dangerSigns = dangerSigns,
+            notes = notes
+        )
+    }
+}
diff --git a/app/src/main/java/com/example/ancapp/data/FhirClient.kt b/app/src/main/java/com/example/ancapp/data/FhirClient.kt
new file mode 100644
index 0000000..928c53d
--- /dev/null
+++ b/app/src/main/java/com/example/ancapp/data/FhirClient.kt
@@ -0,0 +1,798 @@
+package com.example.ancapp.data
+
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import org.json.JSONArray
+import org.json.JSONObject
+import java.time.Instant
+import java.time.LocalDate
+import java.util.concurrent.TimeUnit
+
+class FhirClient(
+    val baseUrl: String = "http://10.0.2.2:8080/fhir"
+) {
+    private val client = OkHttpClient.Builder()
+        .connectTimeout(10, TimeUnit.SECONDS)
+        .readTimeout(10, TimeUnit.SECONDS)
+        .writeTimeout(10, TimeUnit.SECONDS)
+        .build()
+
+    private val jsonMediaType = "application/fhir+json; charset=utf-8".toMediaType()
+
+    suspend fun getPatients(): List<PatientInfo> = withContext(Dispatchers.IO) {
+        val patientRequest = Request.Builder()
+            .url("$baseUrl/Patient?_count=100")
+            .header("Accept", "application/fhir+json")
+            .build()
+
+        val patientBundleJson = client.newCall(patientRequest).execute().use { response ->
+            if (!response.isSuccessful) throw Exception("Failed to fetch patients: ${response.code}")
+            response.body?.string().orEmpty()
+        }
+
+        // Fetch EDD observations: code 11778-8
+        val eddMap = mutableMapOf<String, LocalDate>()
+        try {
+            val eddRequest = Request.Builder()
+                .url("$baseUrl/Observation?code=11778-8&_count=100")
+                .header("Accept", "application/fhir+json")
+                .build()
+            client.newCall(eddRequest).execute().use { response ->
+                if (response.isSuccessful) {
+                    val body = response.body?.string().orEmpty()
+                    val bundle = JSONObject(body)
+                    val entries = bundle.optJSONArray("entry")
+                    if (entries != null) {
+                        for (i in 0 until entries.length()) {
+                            val res = entries.getJSONObject(i).optJSONObject("resource") ?: continue
+                            val subjRef = res.optJSONObject("subject")?.optString("reference").orEmpty()
+                            val patientId = subjRef.removePrefix("Patient/")
+                            val eddStr = if (res.has("valueDateTime")) res.optString("valueDateTime") else null
+                            if (patientId.isNotBlank() && !eddStr.isNullOrBlank()) {
+                                try {
+                                    val datePart = if (eddStr.length >= 10) eddStr.substring(0, 10) else eddStr
+                                    eddMap[patientId] = LocalDate.parse(datePart)
+                                } catch (_: Exception) {}
+                            }
+                        }
+                    }
+                }
+            }
+        } catch (_: Exception) {}
+
+        val patients = mutableListOf<PatientInfo>()
+        val root = JSONObject(patientBundleJson)
+        val entries = root.optJSONArray("entry") ?: JSONArray()
+
+        for (i in 0 until entries.length()) {
+            val entryObj = entries.getJSONObject(i)
+            val res = entryObj.optJSONObject("resource") ?: continue
+            val id = res.optString("id")
+
+            var fullName = "Unknown"
+            val names = res.optJSONArray("name")
+            if (names != null && names.length() > 0) {
+                val nObj = names.getJSONObject(0)
+                val givens = mutableListOf<String>()
+                val gArr = nObj.optJSONArray("given")
+                if (gArr != null) {
+                    for (g in 0 until gArr.length()) {
+                        givens.add(gArr.getString(g))
+                    }
+                }
+                val family = nObj.optString("family", "")
+                val givenStr = givens.joinToString(" ")
+                fullName = listOf(givenStr, family).filter { it.isNotBlank() }.joinToString(" ")
+            }
+
+            val dobStr = if (res.has("birthDate")) res.optString("birthDate") else null
+            val dob = if (!dobStr.isNullOrBlank()) {
+                try {
+                    LocalDate.parse(dobStr.substring(0, 10))
+                } catch (_: Exception) {
+                    null
+                }
+            } else null
+
+            val phone = res.optJSONArray("telecom")?.let { telecoms ->
+                var p: String? = null
+                for (t in 0 until telecoms.length()) {
+                    val tObj = telecoms.getJSONObject(t)
+                    if (tObj.optString("system") == "phone") {
+                        p = tObj.optString("value")
+                        break
+                    }
+                }
+                p
+            }
+
+            val identifier = res.optJSONArray("identifier")?.let { ids ->
+                if (ids.length() > 0) ids.getJSONObject(0).optString("value") else null
+            }
+
+            val edd = eddMap[id]
+
+            patients.add(
+                PatientInfo(
+                    id = id,
+                    fullName = fullName,
+                    birthDate = dob,
+                    edd = edd,
+                    phone = phone,
+                    identifier = identifier
+                )
+            )
+        }
+
+        // Sorted by due date (soonest first)
+        patients.sortedWith(
+            compareBy<PatientInfo> { it.edd ?: LocalDate.MAX }
+                .thenBy { it.fullName }
+        )
+    }
+
+    suspend fun getQuestionnaire(id: String = "anc-contact"): JSONObject? = withContext(Dispatchers.IO) {
+        val request = Request.Builder()
+            .url("$baseUrl/Questionnaire/$id")
+            .header("Accept", "application/fhir+json")
+            .build()
+
+        client.newCall(request).execute().use { response ->
+            if (response.isSuccessful) {
+                val body = response.body?.string().orEmpty()
+                JSONObject(body)
+            } else {
+                null
+            }
+        }
+    }
+
+    suspend fun getVisitsForPatient(patientId: String): List<AncVisit> = withContext(Dispatchers.IO) {
+        // 1. Fetch encounters for this patient
+        val encounterMap = mutableMapOf<String, EncounterData>()
+        try {
+            val encRequest = Request.Builder()
+                .url("$baseUrl/Encounter?subject=Patient/$patientId&_count=100")
+                .header("Accept", "application/fhir+json")
+                .build()
+
+            client.newCall(encRequest).execute().use { response ->
+                if (response.isSuccessful) {
+                    val body = response.body?.string().orEmpty()
+                    val bundle = JSONObject(body)
+                    val entries = bundle.optJSONArray("entry") ?: JSONArray()
+                    for (i in 0 until entries.length()) {
+                        val res = entries.getJSONObject(i).optJSONObject("resource") ?: continue
+                        val id = res.optString("id")
+                        val period = res.optJSONObject("period")
+                        val start = period?.optString("start")
+                        val date = start?.let {
+                            try {
+                                val s = if (it.length >= 10) it.substring(0, 10) else it
+                                LocalDate.parse(s)
+                            } catch (_: Exception) { null }
+                        }
+                        encounterMap[id] = EncounterData(id = id, date = date, dateString = start ?: "")
+                    }
+                }
+            }
+        } catch (_: Exception) {}
+
+        // 2. Fetch observations for this patient
+        val visitObsMap = mutableMapOf<String, MutableVisitObservations>()
+        // Initialize visit observations for all encounters found
+        for ((encId, enc) in encounterMap) {
+            visitObsMap[encId] = MutableVisitObservations(date = enc.date, dateString = enc.dateString)
+        }
+
+        try {
+            val obsRequest = Request.Builder()
+                .url("$baseUrl/Observation?subject=Patient/$patientId&_count=100")
+                .header("Accept", "application/fhir+json")
+                .build()
+
+            client.newCall(obsRequest).execute().use { response ->
+                if (response.isSuccessful) {
+                    val body = response.body?.string().orEmpty()
+                    val bundle = JSONObject(body)
+                    val entries = bundle.optJSONArray("entry") ?: JSONArray()
+                    for (i in 0 until entries.length()) {
+                        val res = entries.getJSONObject(i).optJSONObject("resource") ?: continue
+                        val encRef = res.optJSONObject("encounter")?.optString("reference").orEmpty()
+                        val encId = encRef.removePrefix("Encounter/")
+                        val effective = if (res.has("effectiveDateTime")) res.optString("effectiveDateTime") else null
+                        val effDate = if (!effective.isNullOrBlank()) {
+                            try {
+                                val s = if (effective.length >= 10) effective.substring(0, 10) else effective
+                                LocalDate.parse(s)
+                            } catch (_: Exception) { null }
+                        } else null
+
+                        val targetKey = if (encId.isNotBlank()) encId else "obs-date-${effective ?: i}"
+                        val target = visitObsMap.getOrPut(targetKey) {
+                            MutableVisitObservations(date = effDate, dateString = effective ?: "")
+                        }
+
+                        // Determine observation type by code
+                        val codeObj = res.optJSONObject("code")
+                        val codings = codeObj?.optJSONArray("coding") ?: JSONArray()
+                        var codeVal = ""
+                        for (c in 0 until codings.length()) {
+                            val cd = codings.getJSONObject(c).optString("code")
+                            if (cd.isNotBlank()) {
+                                codeVal = cd
+                                break
+                            }
+                        }
+
+                        when (codeVal) {
+                            "29463-7" -> { // Weight
+                                res.optJSONObject("valueQuantity")?.let {
+                                    if (it.has("value")) target.weightKg = it.optDouble("value")
+                                }
+                            }
+                            "85354-9" -> { // BP Panel
+                                val components = res.optJSONArray("component") ?: JSONArray()
+                                for (c in 0 until components.length()) {
+                                    val comp = components.getJSONObject(c)
+                                    val compCodes = comp.optJSONObject("code")?.optJSONArray("coding") ?: JSONArray()
+                                    var cCode = ""
+                                    for (k in 0 until compCodes.length()) {
+                                        val cd = compCodes.getJSONObject(k).optString("code")
+                                        if (cd.isNotBlank()) { cCode = cd; break }
+                                    }
+                                    val qVal = comp.optJSONObject("valueQuantity")?.optDouble("value")?.toInt()
+                                    if (cCode == "8480-6") target.systolicBp = qVal
+                                    if (cCode == "8462-4") target.diastolicBp = qVal
+                                }
+                            }
+                            "8480-6" -> { // Systolic standalone
+                                target.systolicBp = res.optJSONObject("valueQuantity")?.optDouble("value")?.toInt()
+                            }
+                            "8462-4" -> { // Diastolic standalone
+                                target.diastolicBp = res.optJSONObject("valueQuantity")?.optDouble("value")?.toInt()
+                            }
+                            "718-7" -> { // Hemoglobin
+                                res.optJSONObject("valueQuantity")?.let {
+                                    if (it.has("value")) target.hemoglobin = it.optDouble("value")
+                                }
+                            }
+                            "18185-9", "49051-6" -> { // Gestational age
+                                val gaVal = res.optJSONObject("valueQuantity")?.optDouble("value")?.toInt()
+                                    ?: res.optInt("valueInteger", -1)
+                                if (gaVal > 0) target.gestationalAgeWeeks = gaVal
+                            }
+                            "danger-signs" -> {
+                                val text = res.optString("valueString")
+                                if (text.isNotBlank()) {
+                                    target.dangerSigns.addAll(text.split(",").map { it.trim() })
+                                }
+                            }
+                            "notes" -> {
+                                target.notes = res.optString("valueString")
+                            }
+                        }
+                    }
+                }
+            }
+        } catch (_: Exception) {}
+
+        // 3. Fetch QuestionnaireResponses for this patient to enrich / capture visits
+        try {
+            val qrRequest = Request.Builder()
+                .url("$baseUrl/QuestionnaireResponse?subject=Patient/$patientId&_count=100")
+                .header("Accept", "application/fhir+json")
+                .build()
+
+            client.newCall(qrRequest).execute().use { response ->
+                if (response.isSuccessful) {
+                    val body = response.body?.string().orEmpty()
+                    val bundle = JSONObject(body)
+                    val entries = bundle.optJSONArray("entry") ?: JSONArray()
+                    for (i in 0 until entries.length()) {
+                        val res = entries.getJSONObject(i).optJSONObject("resource") ?: continue
+                        val qrId = res.optString("id")
+                        val encRef = res.optJSONObject("encounter")?.optString("reference").orEmpty()
+                        val encId = encRef.removePrefix("Encounter/")
+
+                        val parsedQr = parseQuestionnaireResponse(res)
+
+                        val key = if (encId.isNotBlank() && visitObsMap.containsKey(encId)) {
+                            encId
+                        } else {
+                            "qr-$qrId"
+                        }
+
+                        val target = visitObsMap.getOrPut(key) {
+                            MutableVisitObservations(date = parsedQr.date, dateString = parsedQr.dateString)
+                        }
+
+                        if (target.date == null) target.date = parsedQr.date
+                        if (target.dateString.isBlank()) target.dateString = parsedQr.dateString
+                        if (target.weightKg == null) target.weightKg = parsedQr.weightKg
+                        if (target.systolicBp == null) target.systolicBp = parsedQr.systolicBp
+                        if (target.diastolicBp == null) target.diastolicBp = parsedQr.diastolicBp
+                        if (target.gestationalAgeWeeks == null) target.gestationalAgeWeeks = parsedQr.gestationalAgeWeeks
+                        if (target.dangerSigns.isEmpty()) target.dangerSigns.addAll(parsedQr.dangerSigns)
+                        if (target.notes.isNullOrBlank()) target.notes = parsedQr.notes
+                    }
+                }
+            }
+        } catch (_: Exception) {}
+
+        val visits = visitObsMap.map { (key, obs) ->
+            AncVisit(
+                id = key,
+                date = obs.date,
+                dateString = obs.dateString.ifBlank { obs.date?.toString().orEmpty() },
+                weightKg = obs.weightKg,
+                systolicBp = obs.systolicBp,
+                diastolicBp = obs.diastolicBp,
+                hemoglobin = obs.hemoglobin,
+                gestationalAgeWeeks = obs.gestationalAgeWeeks,
+                dangerSigns = obs.dangerSigns.distinct(),
+                notes = obs.notes
+            )
+        }
+
+        // Sort by date descending (most recent first)
+        visits.sortedWith(
+            compareByDescending<AncVisit> { it.date ?: LocalDate.MIN }
+                .thenByDescending { it.dateString }
+        )
+    }
+
+    private fun parseQuestionnaireResponse(res: JSONObject): ParsedQr {
+        var date: LocalDate? = null
+        var dateStr = ""
+        var ga: Int? = null
+        var weight: Double? = null
+        var systolic: Int? = null
+        var diastolic: Int? = null
+        val dangerSigns = mutableListOf<String>()
+        var notes: String? = null
+
+        fun inspectItems(items: JSONArray) {
+            for (i in 0 until items.length()) {
+                val item = items.getJSONObject(i)
+                val linkId = item.optString("linkId")
+                val answers = item.optJSONArray("answer") ?: JSONArray()
+                when (linkId) {
+                    "visit-date" -> {
+                        if (answers.length() > 0) {
+                            dateStr = answers.getJSONObject(0).optString("valueDate")
+                            try {
+                                date = LocalDate.parse(dateStr.substring(0, 10))
+                            } catch (_: Exception) {}
+                        }
+                    }
+                    "gestational-age" -> {
+                        if (answers.length() > 0) {
+                            ga = answers.getJSONObject(0).optInt("valueInteger")
+                        }
+                    }
+                    "weight" -> {
+                        if (answers.length() > 0) {
+                            weight = answers.getJSONObject(0).optDouble("valueDecimal")
+                        }
+                    }
+                    "bp-systolic" -> {
+                        if (answers.length() > 0) {
+                            systolic = answers.getJSONObject(0).optInt("valueInteger")
+                        }
+                    }
+                    "bp-diastolic" -> {
+                        if (answers.length() > 0) {
+                            diastolic = answers.getJSONObject(0).optInt("valueInteger")
+                        }
+                    }
+                    "danger-signs" -> {
+                        for (a in 0 until answers.length()) {
+                            val coding = answers.getJSONObject(a).optJSONObject("valueCoding")
+                            if (coding != null) {
+                                val d = coding.optString("display").ifBlank { coding.optString("code") }
+                                if (d.isNotBlank()) dangerSigns.add(d)
+                            }
+                        }
+                    }
+                    "notes" -> {
+                        if (answers.length() > 0) {
+                            notes = answers.getJSONObject(0).optString("valueString")
+                        }
+                    }
+                }
+                val nested = item.optJSONArray("item")
+                if (nested != null) inspectItems(nested)
+            }
+        }
+
+        val items = res.optJSONArray("item")
+        if (items != null) inspectItems(items)
+
+        if (dateStr.isBlank()) {
+            val authored = res.optString("authored")
+            if (authored.isNotBlank()) {
+                dateStr = authored
+                try {
+                    date = LocalDate.parse(authored.substring(0, 10))
+                } catch (_: Exception) {}
+            }
+        }
+
+        return ParsedQr(
+            date = date,
+            dateString = dateStr,
+            gestationalAgeWeeks = ga,
+            weightKg = weight,
+            systolicBp = systolic,
+            diastolicBp = diastolic,
+            dangerSigns = dangerSigns,
+            notes = notes
+        )
+    }
+
+    suspend fun saveAncVisit(
+        patientId: String,
+        visitDate: String,
+        gestationalAgeWeeks: Int?,
+        weightKg: Double?,
+        systolicBp: Int?,
+        diastolicBp: Int?,
+        dangerSigns: List<DangerSignOption>,
+        notes: String?
+    ): Result<Unit> = withContext(Dispatchers.IO) {
+        try {
+            // 1. Create Encounter
+            val encJson = JSONObject().apply {
+                put("resourceType", "Encounter")
+                put("status", "finished")
+                put("class", JSONObject().apply {
+                    put("system", "http://terminology.hl7.org/CodeSystem/v3-ActCode")
+                    put("code", "AMB")
+                    put("display", "ambulatory")
+                })
+                put("type", JSONArray().apply {
+                    put(JSONObject().apply { put("text", "Antenatal care contact") })
+                })
+                put("subject", JSONObject().apply { put("reference", "Patient/$patientId") })
+                put("period", JSONObject().apply {
+                    put("start", visitDate)
+                    put("end", visitDate)
+                })
+            }
+
+            val encRequest = Request.Builder()
+                .url("$baseUrl/Encounter")
+                .post(encJson.toString().toRequestBody(jsonMediaType))
+                .header("Content-Type", "application/fhir+json")
+                .header("Accept", "application/fhir+json")
+                .build()
+
+            var encounterId = ""
+            client.newCall(encRequest).execute().use { response ->
+                if (!response.isSuccessful) {
+                    val err = response.body?.string().orEmpty()
+                    return@withContext Result.failure(Exception("Failed to create Encounter (${response.code}): $err"))
+                }
+                val loc = response.header("Location").orEmpty()
+                val respBody = response.body?.string().orEmpty()
+                encounterId = try {
+                    JSONObject(respBody).optString("id")
+                } catch (_: Exception) { "" }
+
+                if (encounterId.isBlank() && loc.isNotBlank()) {
+                    encounterId = loc.substringAfter("Encounter/").substringBefore("/_history")
+                }
+            }
+
+            // 2. Create Weight Observation
+            if (weightKg != null && weightKg > 0) {
+                val weightJson = JSONObject().apply {
+                    put("resourceType", "Observation")
+                    put("status", "final")
+                    put("category", JSONArray().apply {
+                        put(JSONObject().apply {
+                            put("coding", JSONArray().apply {
+                                put(JSONObject().apply {
+                                    put("system", "http://terminology.hl7.org/CodeSystem/observation-category")
+                                    put("code", "vital-signs")
+                                    put("display", "Vital Signs")
+                                })
+                            })
+                        })
+                    })
+                    put("code", JSONObject().apply {
+                        put("coding", JSONArray().apply {
+                            put(JSONObject().apply {
+                                put("system", "http://loinc.org")
+                                put("code", "29463-7")
+                                put("display", "Body weight")
+                            })
+                        })
+                        put("text", "Body weight")
+                    })
+                    put("subject", JSONObject().apply { put("reference", "Patient/$patientId") })
+                    if (encounterId.isNotBlank()) {
+                        put("encounter", JSONObject().apply { put("reference", "Encounter/$encounterId") })
+                    }
+                    put("effectiveDateTime", visitDate)
+                    put("valueQuantity", JSONObject().apply {
+                        put("value", weightKg)
+                        put("unit", "kg")
+                        put("system", "http://unitsofmeasure.org")
+                        put("code", "kg")
+                    })
+                }
+
+                val req = Request.Builder()
+                    .url("$baseUrl/Observation")
+                    .post(weightJson.toString().toRequestBody(jsonMediaType))
+                    .header("Content-Type", "application/fhir+json")
+                    .build()
+                client.newCall(req).execute().close()
+            }
+
+            // 3. Create Blood Pressure Observation
+            if (systolicBp != null && diastolicBp != null) {
+                val bpJson = JSONObject().apply {
+                    put("resourceType", "Observation")
+                    put("status", "final")
+                    put("category", JSONArray().apply {
+                        put(JSONObject().apply {
+                            put("coding", JSONArray().apply {
+                                put(JSONObject().apply {
+                                    put("system", "http://terminology.hl7.org/CodeSystem/observation-category")
+                                    put("code", "vital-signs")
+                                    put("display", "Vital Signs")
+                                })
+                            })
+                        })
+                    })
+                    put("code", JSONObject().apply {
+                        put("coding", JSONArray().apply {
+                            put(JSONObject().apply {
+                                put("system", "http://loinc.org")
+                                put("code", "85354-9")
+                                put("display", "Blood pressure panel with all children optional")
+                            })
+                        })
+                        put("text", "Blood pressure")
+                    })
+                    put("subject", JSONObject().apply { put("reference", "Patient/$patientId") })
+                    if (encounterId.isNotBlank()) {
+                        put("encounter", JSONObject().apply { put("reference", "Encounter/$encounterId") })
+                    }
+                    put("effectiveDateTime", visitDate)
+                    put("component", JSONArray().apply {
+                        put(JSONObject().apply {
+                            put("code", JSONObject().apply {
+                                put("coding", JSONArray().apply {
+                                    put(JSONObject().apply {
+                                        put("system", "http://loinc.org")
+                                        put("code", "8480-6")
+                                        put("display", "Systolic blood pressure")
+                                    })
+                                })
+                            })
+                            put("valueQuantity", JSONObject().apply {
+                                put("value", systolicBp)
+                                put("unit", "mmHg")
+                                put("system", "http://unitsofmeasure.org")
+                                put("code", "mm[Hg]")
+                            })
+                        })
+                        put(JSONObject().apply {
+                            put("code", JSONObject().apply {
+                                put("coding", JSONArray().apply {
+                                    put(JSONObject().apply {
+                                        put("system", "http://loinc.org")
+                                        put("code", "8462-4")
+                                        put("display", "Diastolic blood pressure")
+                                    })
+                                })
+                            })
+                            put("valueQuantity", JSONObject().apply {
+                                put("value", diastolicBp)
+                                put("unit", "mmHg")
+                                put("system", "http://unitsofmeasure.org")
+                                put("code", "mm[Hg]")
+                            })
+                        })
+                    })
+                }
+
+                val req = Request.Builder()
+                    .url("$baseUrl/Observation")
+                    .post(bpJson.toString().toRequestBody(jsonMediaType))
+                    .header("Content-Type", "application/fhir+json")
+                    .build()
+                client.newCall(req).execute().close()
+            }
+
+            // 4. Create Gestational Age Observation
+            if (gestationalAgeWeeks != null && gestationalAgeWeeks > 0) {
+                val gaJson = JSONObject().apply {
+                    put("resourceType", "Observation")
+                    put("status", "final")
+                    put("code", JSONObject().apply {
+                        put("coding", JSONArray().apply {
+                            put(JSONObject().apply {
+                                put("system", "http://loinc.org")
+                                put("code", "18185-9")
+                                put("display", "Gestational age")
+                            })
+                        })
+                        put("text", "Gestational age")
+                    })
+                    put("subject", JSONObject().apply { put("reference", "Patient/$patientId") })
+                    if (encounterId.isNotBlank()) {
+                        put("encounter", JSONObject().apply { put("reference", "Encounter/$encounterId") })
+                    }
+                    put("effectiveDateTime", visitDate)
+                    put("valueQuantity", JSONObject().apply {
+                        put("value", gestationalAgeWeeks)
+                        put("unit", "weeks")
+                        put("system", "http://unitsofmeasure.org")
+                        put("code", "wk")
+                    })
+                }
+
+                val req = Request.Builder()
+                    .url("$baseUrl/Observation")
+                    .post(gaJson.toString().toRequestBody(jsonMediaType))
+                    .header("Content-Type", "application/fhir+json")
+                    .build()
+                client.newCall(req).execute().close()
+            }
+
+            // 5. Create QuestionnaireResponse conforming to anc-contact Questionnaire
+            val qrItems = JSONArray()
+
+            // Item 1: visit-date (required)
+            qrItems.put(JSONObject().apply {
+                put("linkId", "visit-date")
+                put("text", "Visit date")
+                put("answer", JSONArray().apply {
+                    put(JSONObject().apply { put("valueDate", visitDate) })
+                })
+            })
+
+            // Item 2: gestational-age
+            if (gestationalAgeWeeks != null) {
+                qrItems.put(JSONObject().apply {
+                    put("linkId", "gestational-age")
+                    put("text", "Gestational age (weeks)")
+                    put("answer", JSONArray().apply {
+                        put(JSONObject().apply { put("valueInteger", gestationalAgeWeeks) })
+                    })
+                })
+            }
+
+            // Item 3: vitals (group)
+            val vitalsItems = JSONArray()
+            if (weightKg != null) {
+                vitalsItems.put(JSONObject().apply {
+                    put("linkId", "weight")
+                    put("text", "Weight (kg)")
+                    put("answer", JSONArray().apply {
+                        put(JSONObject().apply { put("valueDecimal", weightKg) })
+                    })
+                })
+            }
+            if (systolicBp != null) {
+                vitalsItems.put(JSONObject().apply {
+                    put("linkId", "bp-systolic")
+                    put("text", "Systolic blood pressure (mmHg)")
+                    put("answer", JSONArray().apply {
+                        put(JSONObject().apply { put("valueInteger", systolicBp) })
+                    })
+                })
+            }
+            if (diastolicBp != null) {
+                vitalsItems.put(JSONObject().apply {
+                    put("linkId", "bp-diastolic")
+                    put("text", "Diastolic blood pressure (mmHg)")
+                    put("answer", JSONArray().apply {
+                        put(JSONObject().apply { put("valueInteger", diastolicBp) })
+                    })
+                })
+            }
+
+            if (vitalsItems.length() > 0) {
+                qrItems.put(JSONObject().apply {
+                    put("linkId", "vitals")
+                    put("text", "Vital signs")
+                    put("item", vitalsItems)
+                })
+            }
+
+            // Item 4: danger-signs
+            if (dangerSigns.isNotEmpty()) {
+                val answers = JSONArray()
+                for (sign in dangerSigns) {
+                    answers.put(JSONObject().apply {
+                        put("valueCoding", JSONObject().apply {
+                            put("system", "urn:example:anc-danger-signs")
+                            put("code", sign.code)
+                            put("display", sign.display)
+                        })
+                    })
+                }
+                qrItems.put(JSONObject().apply {
+                    put("linkId", "danger-signs")
+                    put("text", "Danger signs present")
+                    put("answer", answers)
+                })
+            }
+
+            // Item 5: notes
+            if (!notes.isNullOrBlank()) {
+                qrItems.put(JSONObject().apply {
+                    put("linkId", "notes")
+                    put("text", "Notes")
+                    put("answer", JSONArray().apply {
+                        put(JSONObject().apply { put("valueString", notes.trim()) })
+                    })
+                })
+            }
+
+            val qrJson = JSONObject().apply {
+                put("resourceType", "QuestionnaireResponse")
+                put("questionnaire", "http://example.org/fhir/Questionnaire/anc-contact")
+                put("status", "completed")
+                put("subject", JSONObject().apply { put("reference", "Patient/$patientId") })
+                if (encounterId.isNotBlank()) {
+                    put("encounter", JSONObject().apply { put("reference", "Encounter/$encounterId") })
+                }
+                put("authored", Instant.now().toString())
+                put("item", qrItems)
+            }
+
+            val qrRequest = Request.Builder()
+                .url("$baseUrl/QuestionnaireResponse")
+                .post(qrJson.toString().toRequestBody(jsonMediaType))
+                .header("Content-Type", "application/fhir+json")
+                .header("Accept", "application/fhir+json")
+                .build()
+
+            client.newCall(qrRequest).execute().use { response ->
+                if (!response.isSuccessful) {
+                    val err = response.body?.string().orEmpty()
+                    // If QR failed, log or notify, but encounter and observations were already created
+                    return@withContext Result.failure(Exception("QuestionnaireResponse error (${response.code}): $err"))
+                }
+            }
+
+            Result.success(Unit)
+        } catch (e: Exception) {
+            Result.failure(e)
+        }
+    }
+
+    private data class EncounterData(val id: String, val date: LocalDate?, val dateString: String)
+    private data class MutableVisitObservations(
+        var date: LocalDate? = null,
+        var dateString: String = "",
+        var weightKg: Double? = null,
+        var systolicBp: Int? = null,
+        var diastolicBp: Int? = null,
+        var hemoglobin: Double? = null,
+        var gestationalAgeWeeks: Int? = null,
+        val dangerSigns: MutableList<String> = mutableListOf(),
+        var notes: String? = null
+    )
+    private data class ParsedQr(
+        val date: LocalDate?,
+        val dateString: String,
+        val gestationalAgeWeeks: Int?,
+        val weightKg: Double?,
+        val systolicBp: Int?,
+        val diastolicBp: Int?,
+        val dangerSigns: List<String>,
+        val notes: String?
+    )
+}
