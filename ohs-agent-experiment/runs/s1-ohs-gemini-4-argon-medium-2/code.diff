+private class ImmediateChoiceViewFactory(
+  private val formStateHolder: AncFormStateHolder,
+) : QuestionnaireItemViewFactory {
+
+  @Composable
+  override fun Content(questionnaireViewItem: QuestionnaireViewItem) {
+    SideEffect { formStateHolder.registerItem(questionnaireViewItem) }
+    val currentViewItem by rememberUpdatedState(questionnaireViewItem)
+    val coroutineScope = rememberCoroutineScope()
+    val focusManager = LocalFocusManager.current
+    val linkId = questionnaireViewItem.questionnaireItem.linkId.value ?: "choice-field"
+    val labelText =
+      questionnaireViewItem.questionnaireItem.text?.value
+        ?: questionnaireViewItem.questionText?.text
+        ?: "Danger signs present"
+
+    val options: List<Coding> =
+      remember(questionnaireViewItem.enabledAnswerOptions) {
+        questionnaireViewItem.enabledAnswerOptions.mapNotNull { it.value.asCoding()?.value }
+      }
+
+    var selectedCodes by
+      remember(linkId) {
+        val initialCodes =
+          questionnaireViewItem.answers
+            .mapNotNull { it.value?.asCoding()?.value?.code?.value }
+            .toSet()
+        mutableStateOf(initialCodes)
+      }
+
+    Column(
+      modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 2.dp),
+      verticalArrangement = Arrangement.spacedBy(2.dp),
+    ) {
+      Text(
+        text = labelText,
+        style = MaterialTheme.typography.titleSmall,
+        fontWeight = FontWeight.SemiBold,
+        color = MaterialTheme.colorScheme.primary,
+      )
+
+      options.chunked(2).forEach { rowOptions ->
+        Row(
+          modifier = Modifier.fillMaxWidth(),
+          horizontalArrangement = Arrangement.spacedBy(8.dp),
+        ) {
+          rowOptions.forEach { coding ->
+            val codeStr = coding.code?.value ?: ""
+            val displayStr = coding.display?.value ?: codeStr
+            val isSelected = codeStr in selectedCodes
+
+            Surface(
+              shape = RoundedCornerShape(6.dp),
+              color =
+                if (isSelected) {
+                  MaterialTheme.colorScheme.secondaryContainer.copy(alpha = 0.6f)
+                } else {
+                  MaterialTheme.colorScheme.surface
+                },
+              modifier =
+                Modifier.weight(1f)
+                  .toggleable(
+                    value = isSelected,
+                    role = Role.Checkbox,
+                    onValueChange = { checked ->
+                      focusManager.clearFocus()
+                      val updatedCodes =
+                        if (checked) {
+                          if (codeStr == "none") {
+                            setOf("none")
+                          } else {
+                            (selectedCodes - "none") + codeStr
+                          }
+                        } else {
+                          selectedCodes - codeStr
+                        }
+                      selectedCodes = updatedCodes
+                      val newAnswers =
+                        options
+                          .filter { (it.code?.value ?: "") in updatedCodes }
+                          .map { selectedCoding ->
+                            QuestionnaireResponse.Item.Answer(
+                              value = QuestionnaireResponse.Item.Answer.Value.Coding(selectedCoding)
+                            )
+                          }
+                      coroutineScope.launch(start = CoroutineStart.UNDISPATCHED) {
+                        if (newAnswers.isEmpty()) {
+                          currentViewItem.clearAnswer()
+                        } else {
+                          currentViewItem.setAnswer(*newAnswers.toTypedArray())
+                        }
+                      }
+                    },
+                  )
+                  .testTag("danger_sign_$codeStr"),
+            ) {
+              Row(
+                modifier = Modifier.fillMaxWidth().padding(horizontal = 6.dp, vertical = 6.dp),
+                verticalAlignment = Alignment.CenterVertically,
+              ) {
+                Checkbox(checked = isSelected, onCheckedChange = null)
+                Spacer(modifier = Modifier.width(6.dp))
+                Text(
+                  text = displayStr,
+                  style = MaterialTheme.typography.bodyMedium,
+                )
+              }
+            }
+          }
+          if (rowOptions.size == 1) {
+            Spacer(modifier = Modifier.weight(1f))
+          }
+        }
+      }
+    }
+  }
+}
