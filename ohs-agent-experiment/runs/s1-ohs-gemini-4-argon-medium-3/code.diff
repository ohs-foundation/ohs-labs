+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun NewAncVisitScreen(
+  patientName: String,
+  questionnaireJson: String?,
+  formInstanceKey: Int,
+  isSaving: Boolean,
+  snackbarHostState: SnackbarHostState,
+  onCancel: () -> Unit,
+  onSubmit: ((suspend () -> dev.ohs.fhir.model.r4.QuestionnaireResponse) -> Unit),
+) {
+  Scaffold(
+    snackbarHost = { SnackbarHost(snackbarHostState) },
+    topBar = {
+      TopAppBar(
+        title = {
+          Column {
+            Text(
+              text = "Record ANC Visit",
+              style = MaterialTheme.typography.titleLarge,
+              fontWeight = FontWeight.Bold,
+            )
+            Text(
+              text = patientName,
+              style = MaterialTheme.typography.bodySmall,
+              color = MaterialTheme.colorScheme.onPrimary.copy(alpha = 0.9f),
+            )
+          }
+        },
+        navigationIcon = {
+          IconButton(onClick = onCancel, enabled = !isSaving) {
+            Icon(
+              imageVector = Icons.AutoMirrored.Filled.ArrowBack,
+              contentDescription = "Cancel",
+              tint = MaterialTheme.colorScheme.onPrimary,
+            )
+          }
+        },
+        colors =
+          TopAppBarDefaults.topAppBarColors(
+            containerColor = MaterialTheme.colorScheme.primary,
+            titleContentColor = MaterialTheme.colorScheme.onPrimary,
+          ),
+      )
+    },
+  ) { innerPadding ->
+    Box(modifier = Modifier.fillMaxSize().padding(innerPadding)) {
+      if (questionnaireJson.isNullOrBlank()) {
+        CircularProgressIndicator(modifier = Modifier.align(Alignment.Center))
+      } else {
+        // Append whitespace padding based on formInstanceKey so Questionnaire composable's
+        // remember/viewModel key creates a fresh ViewModel for each new visit entry
+        val keyedQuestionnaireJson =
+          remember(questionnaireJson, formInstanceKey) {
+            questionnaireJson + " ".repeat(formInstanceKey)
+          }
+        Questionnaire(
+          questionnaireJson = keyedQuestionnaireJson,
+          config =
+            QuestionnaireConfig(
+              showSubmitButton = true,
+              showCancelButton = true,
+              showRequiredText = true,
+              submitButtonText = "Save Visit",
+              showSubmitAnywayWhenValidationFails = false,
+            ),
+          onSubmit = onSubmit,
+          onCancel = onCancel,
+        )
+      }
+
+      if (isSaving) {
+        Box(
+          modifier =
+            Modifier.fillMaxSize().background(Color.Black.copy(alpha = 0.3f)),
+          contentAlignment = Alignment.Center,
+        ) {
+          CircularProgressIndicator()
+        }
+      }
+    }
   }
 }
