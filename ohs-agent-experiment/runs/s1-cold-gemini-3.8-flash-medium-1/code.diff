+package com.example.ancapp.model
+
+import org.json.JSONObject
+import java.time.LocalDate
+import java.time.Period
+import java.time.format.DateTimeFormatter
+import java.time.temporal.ChronoUnit
+
+data class Patient(
+    val id: String,
+    val name: String,
+    val dateOfBirth: String, // Format: YYYY-MM-DD
+    val estimatedDueDate: String // Format: YYYY-MM-DD
+) {
+    /**
+     * Computes the patient's age in years as of [asOfDate].
+     */
+    fun getAge(asOfDate: LocalDate = LocalDate.now()): Int {
+        return try {
+            val dob = LocalDate.parse(dateOfBirth)
+            Period.between(dob, asOfDate).years
+        } catch (_: Exception) {
+            0
+        }
+    }
+
+    /**
+     * Computes gestational age in completed weeks as of [asOfDate].
+     * Standard obstetric formula:
+     * Full-term gestation is 40 weeks (280 days).
+     * Estimated LMP = EDD - 280 days.
+     * Days pregnant = days elapsed between LMP and [asOfDate].
+     */
+    fun getGestationalWeeks(asOfDate: LocalDate = LocalDate.now()): Int {
+        return try {
+            val edd = LocalDate.parse(estimatedDueDate)
+            val lmp = edd.minusDays(280)
+            val days = ChronoUnit.DAYS.between(lmp, asOfDate)
+            (days / 7).toInt().coerceAtLeast(0)
+        } catch (_: Exception) {
+            0
+        }
+    }
+
+    /**
+     * Returns a human-friendly string for gestational age, e.g. "36 weeks" or "36 wks 4 d".
+     */
+    fun getGestationalAgeDisplay(asOfDate: LocalDate = LocalDate.now()): String {
+        return try {
+            val edd = LocalDate.parse(estimatedDueDate)
+            val lmp = edd.minusDays(280)
+            val days = ChronoUnit.DAYS.between(lmp, asOfDate).coerceAtLeast(0)
+            val weeks = days / 7
+            val remainingDays = days % 7
+            if (remainingDays > 0) {
+                "$weeks wks $remainingDays d"
+            } else {
+                "$weeks weeks"
+            }
+        } catch (_: Exception) {
+            "0 weeks"
+        }
+    }
+
+    fun getFormattedDueDate(): String {
+        return try {
+            val edd = LocalDate.parse(estimatedDueDate)
+            edd.format(DateTimeFormatter.ofPattern("MMM d, yyyy"))
+        } catch (_: Exception) {
+            estimatedDueDate
+        }
+    }
+
+    fun toJson(): JSONObject {
+        return JSONObject().apply {
+            put("id", id)
+            put("name", name)
+            put("dateOfBirth", dateOfBirth)
+            put("estimatedDueDate", estimatedDueDate)
+        }
+    }
+
+    companion object {
+        fun fromJson(json: JSONObject): Patient {
+            return Patient(
+                id = json.getString("id"),
+                name = json.getString("name"),
+                dateOfBirth = json.getString("dateOfBirth"),
+                estimatedDueDate = json.getString("estimatedDueDate")
+            )
+        }
+    }
+}
