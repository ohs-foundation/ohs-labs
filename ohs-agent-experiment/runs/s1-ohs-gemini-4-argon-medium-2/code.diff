+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun PatientDetailScreen(
+  patientDetail: PatientDetail?,
+  isSyncing: Boolean,
+  onBack: () -> Unit,
+  onRecordNewVisit: () -> Unit,
+) {
+  Scaffold(
+    topBar = {
+      Column {
+        TopAppBar(
+          title = {
+            Text(
+              text = patientDetail?.patient?.name ?: "Patient Detail",
+              fontWeight = FontWeight.Bold,
+            )
+          },
+          navigationIcon = {
+            IconButton(onClick = onBack) {
+              Icon(
+                imageVector = Icons.AutoMirrored.Filled.ArrowBack,
+                contentDescription = "Back",
+                tint = MaterialTheme.colorScheme.onPrimary,
+              )
+            }
+          },
+          colors =
+            TopAppBarDefaults.topAppBarColors(
+              containerColor = MaterialTheme.colorScheme.primary,
+              titleContentColor = MaterialTheme.colorScheme.onPrimary,
+            ),
+        )
+        if (isSyncing) {
+          LinearProgressIndicator(modifier = Modifier.fillMaxWidth())
+        }
+      }
+    }
+  ) { innerPadding ->
+    if (patientDetail == null) {
+      Box(
+        modifier = Modifier.fillMaxSize().padding(innerPadding),
+        contentAlignment = Alignment.Center,
+      ) {
+        CircularProgressIndicator()
+      }
+    } else {
+      val patient = patientDetail.patient
+      val visits = patientDetail.visits
+
+      LazyColumn(
+        modifier = Modifier.fillMaxSize().padding(innerPadding).testTag("patient_detail_list"),
+        contentPadding = PaddingValues(16.dp),
+        verticalArrangement = Arrangement.spacedBy(12.dp),
+      ) {
+        item {
+          PatientSummaryHeaderCard(
+            patient = patient,
+            onRecordNewVisit = onRecordNewVisit,
+          )
+        }
+
+        item {
+          Row(
+            modifier = Modifier.fillMaxWidth().padding(top = 4.dp),
+            horizontalArrangement = Arrangement.SpaceBetween,
+            verticalAlignment = Alignment.CenterVertically,
+          ) {
+            Text(
+              text = "Past ANC Visits (${visits.size})",
+              style = MaterialTheme.typography.titleMedium,
+              fontWeight = FontWeight.Bold,
+            )
+          }
+        }
+
+        if (visits.isEmpty()) {
+          item {
+            Card(
+              modifier = Modifier.fillMaxWidth(),
+              colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),
+            ) {
+              Text(
+                text = "No ANC visits recorded yet.",
+                modifier = Modifier.padding(16.dp),
+                style = MaterialTheme.typography.bodyMedium,
+              )
+            }
+          }
+        } else {
+          items(visits, key = { it.id }) { visit ->
+            AncVisitCard(visit = visit)
+          }
+        }
+      }
+    }
+  }
+}
