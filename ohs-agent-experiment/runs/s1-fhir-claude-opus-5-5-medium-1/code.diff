+package com.example.ancapp
+
+import java.net.HttpURLConnection
+import java.net.URL
+import java.time.LocalDate
+import java.time.Period
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import org.json.JSONArray
+import org.json.JSONObject
+
+// Emulator alias for the host's localhost.
+const val FHIR_BASE = "http://10.0.2.2:8080/fhir"
+
+const val LOINC = "http://loinc.org"
+const val EDD = "11778-8"
+const val WEIGHT = "29463-7"
+const val BP = "85354-9"
+const val SYS = "8480-6"
+const val DIA = "8462-4"
+const val HB = "718-7"
+const val GA = "18185-9"
+
+data class Patient(val id: String, val name: String, val birthDate: LocalDate?, val edd: LocalDate?) {
+  fun age(today: LocalDate) = birthDate?.let { Period.between(it, today).years }
+
+  /** Gestational age in days, counted back from a 280-day term ending at the EDD. */
+  fun gaDays(today: LocalDate) = edd?.let { 280 - ChronoUnit.DAYS.between(today, it) }
+}
+
+data class Visit(
+  val date: String,
+  val weightKg: Double?,
+  val systolic: Int?,
+  val diastolic: Int?,
+  val hb: Double?,
+  val gaWeeks: Int?,
+)
+
+object Fhir {
+  private suspend fun request(path: String, body: JSONObject? = null): JSONObject =
+    withContext(Dispatchers.IO) {
+      val conn = URL(if (path.startsWith("http")) path else "$FHIR_BASE/$path").openConnection() as HttpURLConnection
+      conn.connectTimeout = 10_000
+      conn.readTimeout = 20_000
+      conn.setRequestProperty("Accept", "application/fhir+json")
+      if (body != null) {
+        conn.requestMethod = "POST"
+        conn.doOutput = true
+        conn.setRequestProperty("Content-Type", "application/fhir+json")
+        conn.outputStream.use { it.write(body.toString().toByteArray()) }
+      }
+      try {
+        val code = conn.responseCode
+        val text = (if (code < 400) conn.inputStream else conn.errorStream)?.bufferedReader()?.use { it.readText() }.orEmpty()
+        if (code >= 400) error("HTTP $code: ${text.take(300)}")
+        JSONObject(text)
+      } finally {
+        conn.disconnect()
+      }
+    }
+
+  /** All resources of a search, following `next` links. */
+  private suspend fun search(query: String): List<JSONObject> {
+    val out = mutableListOf<JSONObject>()
+    var next: String? = query
+    while (next != null) {
+      val bundle = request(next)
+      bundle.optJSONArray("entry")?.objects()?.forEach { out += it.getJSONObject("resource") }
+      next = bundle.optJSONArray("link")?.objects()?.firstOrNull { it.optString("relation") == "next" }?.optString("url")
+    }
+    return out
+  }
+
+  suspend fun patients(): List<Patient> {
+    val patients = search("Patient?active=true&_count=100")
+    val edds = search("Observation?code=$LOINC|$EDD&_count=200")
+      .groupBy { it.ref("subject") }
+      .mapValues { (_, obs) -> obs.maxBy { it.optString("effectiveDateTime") }.optString("valueDateTime").date() }
+    return patients.map { p ->
+      val n = p.optJSONArray("name")?.optJSONObject(0)
+      val name = n?.optString("text")?.takeIf { it.isNotBlank() }
+        ?: listOfNotNull(n?.optJSONArray("given")?.strings()?.joinToString(" "), n?.optString("family")).joinToString(" ")
+      Patient(p.getString("id"), name, p.optString("birthDate").date(), edds["Patient/${p.getString("id")}"])
+    }
+      // ponytail: no delivery records on the server, so "pregnant" = has an EDD.
+      .filter { it.edd != null }
+      .sortedBy { it.edd }
+  }
+
+  suspend fun visits(patientId: String): List<Visit> {
+    val encounters = search("Encounter?subject=Patient/$patientId&_count=200")
+    val obsByEnc = search("Observation?subject=Patient/$patientId&_count=500").groupBy { it.ref("encounter") }
+    return encounters.map { enc ->
+      val obs = obsByEnc["Encounter/${enc.getString("id")}"].orEmpty()
+      fun find(code: String) = obs.firstOrNull { it.hasCode(code) }
+      val bp = find(BP)?.optJSONArray("component")?.objects()
+      Visit(
+        date = enc.optJSONObject("period")?.optString("start")?.take(10).orEmpty(),
+        weightKg = find(WEIGHT)?.quantity(),
+        systolic = bp?.firstOrNull { it.hasCode(SYS) }?.quantity()?.toInt(),
+        diastolic = bp?.firstOrNull { it.hasCode(DIA) }?.quantity()?.toInt(),
+        hb = find(HB)?.quantity(),
+        gaWeeks = find(GA)?.quantity()?.toInt(),
+      )
+    }.sortedByDescending { it.date }
+  }
+
+  suspend fun questionnaire(): JSONObject = request("Questionnaire/anc-contact")
+
+  /**
+   * Saves one ANC contact atomically: the QuestionnaireResponse plus an Encounter and the
+   * Observations extracted from it, so the visit shows up in the same queries as seeded data.
+   */
+  suspend fun saveVisit(patientId: String, questionnaire: JSONObject, answers: Map<String, Any>) {
+    val subject = JSONObject().put("reference", "Patient/$patientId")
+    val encUrl = "urn:uuid:${UUID.randomUUID()}"
+    val date = answers["visit-date"] as String
+    val entries = mutableListOf<JSONObject>()
+
+    entries += JSONObject()
+      .put("resourceType", "Encounter")
+      .put("status", "finished")
+      .put("class", JSONObject().put("system", "http://terminology.hl7.org/CodeSystem/v3-ActCode").put("code", "AMB").put("display", "ambulatory"))
+      .put("type", JSONArray().put(JSONObject().put("text", "Antenatal care contact")))
+      .put("subject", subject)
+      .put("period", JSONObject().put("start", date).put("end", date))
+
+    entries += JSONObject()
+      .put("resourceType", "QuestionnaireResponse")
+      .put("questionnaire", questionnaire.optString("url").ifBlank { "Questionnaire/anc-contact" })
+      .put("status", "completed")
+      .put("subject", subject)
+      .put("encounter", JSONObject().put("reference", encUrl))
+      .put("authored", date)
+      .put("item", responseItems(questionnaire.optJSONArray("item"), answers))
+
+    fun obs(code: String, display: String, category: String) = JSONObject()
+      .put("resourceType", "Observation")
+      .put("status", "final")
+      .put("category", JSONArray().put(JSONObject().put("coding", JSONArray().put(
+        JSONObject().put("system", "http://terminology.hl7.org/CodeSystem/observation-category").put("code", category)))))
+      .put("code", JSONObject().put("coding", JSONArray().put(JSONObject().put("system", LOINC).put("code", code).put("display", display))).put("text", display))
+      .put("subject", subject)
+      .put("encounter", JSONObject().put("reference", encUrl))
+      .put("effectiveDateTime", date)
+
+    fun qty(v: Number, unit: String, ucum: String) =
+      JSONObject().put("value", v).put("unit", unit).put("system", "http://unitsofmeasure.org").put("code", ucum)
+
+    (answers["weight"] as? Double)?.let {
+      entries += obs(WEIGHT, "Body weight", "vital-signs").put("valueQuantity", qty(it, "kg", "kg"))
+    }
+    (answers["gestational-age"] as? Int)?.let {
+      entries += obs(GA, "Gestational age", "exam").put("valueQuantity", qty(it, "weeks", "wk"))
+    }
+    val sys = answers["bp-systolic"] as? Int
+    val dia = answers["bp-diastolic"] as? Int
+    if (sys != null || dia != null) {
+      val comps = JSONArray()
+      sys?.let { comps.put(JSONObject().put("code", JSONObject().put("coding", JSONArray().put(JSONObject().put("system", LOINC).put("code", SYS)))).put("valueQuantity", qty(it, "mmHg", "mm[Hg]"))) }
+      dia?.let { comps.put(JSONObject().put("code", JSONObject().put("coding", JSONArray().put(JSONObject().put("system", LOINC).put("code", DIA)))).put("valueQuantity", qty(it, "mmHg", "mm[Hg]"))) }
+      entries += obs(BP, "Blood pressure", "vital-signs").put("component", comps)
+    }
+
+    val bundle = JSONObject().put("resourceType", "Bundle").put("type", "transaction").put("entry", JSONArray().apply {
+      entries.forEachIndexed { i, r ->
+        put(JSONObject()
+          .put("fullUrl", if (i == 0) encUrl else "urn:uuid:${UUID.randomUUID()}")
+          .put("resource", r)
+          .put("request", JSONObject().put("method", "POST").put("url", r.getString("resourceType"))))
+      }
+    })
+    request("", bundle)
+  }
+
+  /** Mirrors the Questionnaire item tree, keeping only answered items (and non-empty groups). */
+  private fun responseItems(items: JSONArray?, answers: Map<String, Any>): JSONArray {
+    val out = JSONArray()
+    items?.objects()?.forEach { q ->
+      val linkId = q.getString("linkId")
+      val item = JSONObject().put("linkId", linkId).put("text", q.optString("text"))
+      if (q.optString("type") == "group") {
+        val children = responseItems(q.optJSONArray("item"), answers)
+        if (children.length() > 0) out.put(item.put("item", children))
+        return@forEach
+      }
+      val values: List<Any> = when (val a = answers[linkId]) {
+        null -> emptyList()
+        is List<*> -> a.filterNotNull()
+        else -> listOf(a)
+      }
+      if (values.isEmpty()) return@forEach
+      item.put("answer", JSONArray().apply {
+        values.forEach { v ->
+          put(when (q.optString("type")) {
+            "date" -> JSONObject().put("valueDate", v)
+            "integer" -> JSONObject().put("valueInteger", v)
+            "decimal" -> JSONObject().put("valueDecimal", v)
+            "choice" -> JSONObject().put("valueCoding", v)
+            else -> JSONObject().put("valueString", v)
+          })
+        }
+      })
+      out.put(item)
+    }
+    return out
+  }
+}
+
+fun JSONArray.objects(): List<JSONObject> = (0 until length()).mapNotNull { optJSONObject(it) }
+fun JSONArray.strings(): List<String> = (0 until length()).map { optString(it) }
+private fun JSONObject.ref(field: String) = optJSONObject(field)?.optString("reference").orEmpty()
+private fun JSONObject.hasCode(code: String) =
+  optJSONObject("code")?.optJSONArray("coding")?.objects()?.any { it.optString("code") == code } == true
+private fun JSONObject.quantity() = optJSONObject("valueQuantity")?.optDouble("value")?.takeUnless { it.isNaN() }
+private fun String.date() = runCatching { LocalDate.parse(take(10)) }.getOrNull()
