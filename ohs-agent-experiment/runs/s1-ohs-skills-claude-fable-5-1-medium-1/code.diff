+package com.example.ancapp
+
+import android.content.Context
+import androidx.work.ExistingWorkPolicy
+import com.ionspin.kotlin.bignum.decimal.BigDecimal
+import dev.ohs.fhir.engine.FhirEngine
+import dev.ohs.fhir.engine.FhirEngineProvider
+import dev.ohs.fhir.engine.get
+import dev.ohs.fhir.engine.search.ReferenceClientParam
+import dev.ohs.fhir.engine.search.Search
+import dev.ohs.fhir.engine.sync.CurrentSyncJobStatus
+import dev.ohs.fhir.engine.sync.Sync
+import dev.ohs.fhir.model.r4.Canonical
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.CodeableConcept
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.DateTime
+import dev.ohs.fhir.model.r4.Decimal
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Enumeration
+import dev.ohs.fhir.model.r4.FhirDateTime
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Patient
+import dev.ohs.fhir.model.r4.Period
+import dev.ohs.fhir.model.r4.Quantity
+import dev.ohs.fhir.model.r4.Questionnaire
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import dev.ohs.fhir.model.r4.Reference
+import dev.ohs.fhir.model.r4.Resource
+import dev.ohs.fhir.model.r4.String as FhirString
+import dev.ohs.fhir.model.r4.Uri
+import dev.ohs.fhir.model.r4.terminologies.ResourceType
+import java.time.LocalDate
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+import kotlinx.coroutines.flow.first
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+
+const val LOINC = "http://loinc.org"
+const val EDD = "11778-8"
+const val WEIGHT = "29463-7"
+const val BP = "85354-9"
+const val SYSTOLIC = "8480-6"
+const val DIASTOLIC = "8462-4"
+const val HB = "718-7"
+
+data class RegisterRow(val id: String, val name: String, val age: Long, val dueDate: LocalDate, val weeks: Long)
+data class Visit(val date: String, val weight: String?, val bp: String?, val hb: String?)
+
+val json = Json { explicitNulls = false; encodeDefaults = false; ignoreUnknownKeys = true }
+
+class AncRepo(private val ctx: Context) {
+  private val engine: FhirEngine get() = FhirEngineProvider.getInstance(ctx.applicationContext)
+
+  /** Runs one sync to completion; returns true on success. */
+  suspend fun sync(policy: ExistingWorkPolicy = ExistingWorkPolicy.KEEP): Boolean =
+    Sync.oneTimeSync<AppSyncWorker>(ctx.applicationContext, existingWorkPolicy = policy).first {
+      it is CurrentSyncJobStatus.Succeeded || it is CurrentSyncJobStatus.Failed || it is CurrentSyncJobStatus.Cancelled
+    } is CurrentSyncJobStatus.Succeeded
+
+  suspend fun register(): List<RegisterRow> {
+    val today = LocalDate.now()
+    val edds = engine.search<Observation>(Search(ResourceType.Observation)).map { it.resource }
+      .filter { it.loinc() == EDD }
+      .groupBy { it.subject?.reference?.value?.substringAfter("/") }
+    return engine.search<Patient>(Search(ResourceType.Patient)).map { it.resource }.mapNotNull { p ->
+      val edd = edds[p.id].orEmpty().mapNotNull { it.value?.asDateTime()?.value?.value?.toLocalDate() }.maxOrNull()
+        ?: return@mapNotNull null
+      val dob = p.birthDate?.value?.toString()?.let { LocalDate.parse(it) }
+      RegisterRow(
+        id = p.id!!,
+        name = p.name.firstOrNull()?.let { n -> (n.given.mapNotNull { it.value } + listOfNotNull(n.family?.value)).joinToString(" ") } ?: p.id!!,
+        age = dob?.let { ChronoUnit.YEARS.between(it, today) } ?: 0,
+        dueDate = edd,
+        weeks = 40 - ChronoUnit.WEEKS.between(today, edd),
+      )
+    }.filter { it.dueDate >= today }.sortedBy { it.dueDate }
+  }
+
+  suspend fun patientName(id: String): String = register().firstOrNull { it.id == id }?.name ?: id
+
+  suspend fun visits(patientId: String): List<Visit> {
+    val obsByEnc = engine.search<Observation>(Search(ResourceType.Observation).apply {
+      filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+    }).map { it.resource }.groupBy { it.encounter?.reference?.value?.substringAfter("/") }
+    return engine.search<Encounter>(Search(ResourceType.Encounter).apply {
+      filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+    }).map { it.resource }.map { e ->
+      val obs = obsByEnc[e.id].orEmpty()
+      val bp = obs.firstOrNull { it.loinc() == BP }
+      Visit(
+        date = e.period?.start?.value?.toString().orEmpty().substringBefore("T"),
+        weight = obs.firstOrNull { it.loinc() == WEIGHT }?.qty()?.let { "$it kg" },
+        bp = bp?.let { b ->
+          val s = b.component.firstOrNull { it.code.loinc() == SYSTOLIC }?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+          val d = b.component.firstOrNull { it.code.loinc() == DIASTOLIC }?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+          if (s != null && d != null) "$s/$d" else null
+        },
+        hb = obs.firstOrNull { it.loinc() == HB }?.qty()?.let { "$it g/dL" },
+      )
+    }.sortedByDescending { it.date }
+  }
+
+  suspend fun questionnaireJson(): String? =
+    runCatching { engine.get<Questionnaire>("anc-contact") }.getOrNull()?.let { json.encodeToString(it) }
+
+  /** Maps the filled form to Encounter + Observations, stores them and the response, and queues an upload. */
+  suspend fun saveVisit(patientId: String, response: QuestionnaireResponse) {
+    val answers = mutableMapOf<String, List<QuestionnaireResponse.Item.Answer>>()
+    fun collect(items: List<QuestionnaireResponse.Item>): Unit = items.forEach { i ->
+      i.linkId.value?.let { answers[it] = i.answer }
+      collect(i.item); i.answer.forEach { collect(it.item) }
+    }
+    collect(response.item)
+    val date = answers["visit-date"]?.firstOrNull()?.value?.asDate()?.value?.value?.toString() ?: LocalDate.now().toString()
+    val when_ = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(date)))
+    val subject = Reference(reference = FhirString(value = "Patient/$patientId"))
+    val encId = UUID.randomUUID().toString()
+    val encRef = Reference(reference = FhirString(value = "Encounter/$encId"))
+    fun obs(code: String, display: String, value: Observation.Value? = null, components: List<Observation.Component> = emptyList()) =
+      Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        code = concept(code, display), subject = subject, encounter = encRef, effective = when_,
+        value = value, component = components,
+      )
+    fun qty(v: BigDecimal, unit: String, code: String) = Quantity(
+      value = Decimal(value = v), unit = FhirString(value = unit),
+      system = Uri(value = "http://unitsofmeasure.org"), code = Code(value = code),
+    )
+    val resources = mutableListOf<Resource>(
+      Encounter(
+        id = encId,
+        status = Enumeration(value = Encounter.EncounterStatus.Finished),
+        `class` = Coding(system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"), code = Code(value = "AMB"), display = FhirString(value = "ambulatory")),
+        type = listOf(CodeableConcept(text = FhirString(value = "Antenatal care contact"))),
+        subject = subject,
+        period = Period(start = DateTime(value = FhirDateTime.fromString(date)), end = DateTime(value = FhirDateTime.fromString(date))),
+      ),
+      response.toBuilder().apply {
+        id = UUID.randomUUID().toString()
+        status = Enumeration(value = QuestionnaireResponse.QuestionnaireResponseStatus.Completed)
+        questionnaire = Canonical(value = "http://example.org/fhir/Questionnaire/anc-contact").toBuilder()
+        this.subject = subject.toBuilder()
+        encounter = encRef.toBuilder()
+        authored = DateTime(value = FhirDateTime.fromString(date)).toBuilder()
+      }.build(),
+    )
+    answers["weight"]?.firstOrNull()?.value?.asDecimal()?.value?.value?.let {
+      resources += obs(WEIGHT, "Body weight", Observation.Value.Quantity(qty(it, "kg", "kg")))
+    }
+    val sys = answers["bp-systolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+    val dia = answers["bp-diastolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+    if (sys != null || dia != null) {
+      resources += obs(BP, "Blood pressure panel with all children optional", components = listOfNotNull(
+        sys?.let { Observation.Component(code = concept(SYSTOLIC, "Systolic blood pressure"), value = Observation.Component.Value.Quantity(qty(BigDecimal.fromInt(it), "mmHg", "mm[Hg]"))) },
+        dia?.let { Observation.Component(code = concept(DIASTOLIC, "Diastolic blood pressure"), value = Observation.Component.Value.Quantity(qty(BigDecimal.fromInt(it), "mmHg", "mm[Hg]"))) },
+      ))
+    }
+    engine.create(*resources.toTypedArray())
+    runCatching { sync(ExistingWorkPolicy.APPEND_OR_REPLACE) } // upload is best-effort; data is already local
+  }
+}
+
+private fun concept(code: String, display: String) = CodeableConcept(
+  coding = listOf(Coding(system = Uri(value = LOINC), code = Code(value = code), display = FhirString(value = display))),
+  text = FhirString(value = display),
+)
+private fun CodeableConcept.loinc() = coding.firstOrNull { it.system?.value == LOINC }?.code?.value
+private fun Observation.loinc() = code.loinc()
+private fun Observation.qty() = value?.asQuantity()?.value?.value?.value?.toPlainString()
+private fun FhirDateTime.toLocalDate() = runCatching { LocalDate.parse(toString().substringBefore("T")) }.getOrNull()
