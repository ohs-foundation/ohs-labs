+package com.example.ancapp
+
+import android.content.ContentValues
+import android.content.Context
+import android.database.sqlite.SQLiteDatabase
+import android.database.sqlite.SQLiteOpenHelper
+import java.time.LocalDate
+
+enum class DangerSign(val label: String) {
+  VAGINAL_BLEEDING("Vaginal bleeding"),
+  SEVERE_HEADACHE("Severe headache"),
+  BLURRED_VISION("Blurred vision"),
+  FEVER("Fever"),
+}
+
+data class Patient(val id: Long, val name: String, val dob: LocalDate, val dueDate: LocalDate)
+
+data class Visit(
+  val id: Long,
+  val patientId: Long,
+  val date: LocalDate,
+  val gaWeeks: Int,
+  val weightKg: Double,
+  val systolic: Int,
+  val diastolic: Int,
+  val hemoglobin: Double?,
+  val dangerSigns: Set<DangerSign>,
+  val notes: String,
+)
+
+// ponytail: no migrations yet (schema v1). Add onUpgrade steps when the schema changes.
+class AncDatabase(context: Context) : SQLiteOpenHelper(context, "anc.db", null, 1) {
+
+  override fun onCreate(db: SQLiteDatabase) {
+    db.execSQL("CREATE TABLE patients (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, dob TEXT NOT NULL, due_date TEXT NOT NULL)")
+    db.execSQL("CREATE TABLE visits (id INTEGER PRIMARY KEY AUTOINCREMENT, patient_id INTEGER NOT NULL REFERENCES patients(id), visit_date TEXT NOT NULL, ga_weeks INTEGER NOT NULL, weight_kg REAL NOT NULL, systolic INTEGER NOT NULL, diastolic INTEGER NOT NULL, hemoglobin REAL, danger_signs TEXT NOT NULL, notes TEXT NOT NULL)")
+
+    // Starting data: each patient has one prior visit on file.
+    seed(db, "Emily Carter", "1996-04-12", "2026-12-05", "2026-08-10", 23, 68.5, 118, 76, 11.8)
+    seed(db, "Sarah Mitchell", "1990-11-02", "2027-01-20", "2026-08-12", 17, 61.2, 110, 70, 12.4)
+    seed(db, "Grace Thompson", "2001-07-30", "2026-10-15", "2026-08-05", 29, 72.0, 128, 84, 10.2)
+  }
+
+  override fun onUpgrade(db: SQLiteDatabase, oldVersion: Int, newVersion: Int) {}
+
+  private fun seed(
+    db: SQLiteDatabase,
+    name: String,
+    dob: String,
+    dueDate: String,
+    visitDate: String,
+    gaWeeks: Int,
+    weightKg: Double,
+    systolic: Int,
+    diastolic: Int,
+    hemoglobin: Double,
+  ) {
+    val patientId = db.insert("patients", null, ContentValues().apply {
+      put("name", name)
+      put("dob", dob)
+      put("due_date", dueDate)
+    })
+    db.insert("visits", null, ContentValues().apply {
+      put("patient_id", patientId)
+      put("visit_date", visitDate)
+      put("ga_weeks", gaWeeks)
+      put("weight_kg", weightKg)
+      put("systolic", systolic)
+      put("diastolic", diastolic)
+      put("hemoglobin", hemoglobin)
+      put("danger_signs", "")
+      put("notes", "")
+    })
+  }
+
+  // ponytail: queries run on the main thread; fine for a clinic-sized list, move to coroutines if it grows.
+  fun patients(): List<Patient> = readableDatabase
+    .rawQuery("SELECT id, name, dob, due_date FROM patients ORDER BY due_date", null)
+    .use { c ->
+      buildList {
+        while (c.moveToNext()) {
+          add(Patient(c.getLong(0), c.getString(1), LocalDate.parse(c.getString(2)), LocalDate.parse(c.getString(3))))
+        }
+      }
+    }
+
+  fun visits(patientId: Long): List<Visit> = readableDatabase
+    .rawQuery(
+      "SELECT id, visit_date, ga_weeks, weight_kg, systolic, diastolic, hemoglobin, danger_signs, notes " +
+        "FROM visits WHERE patient_id = ? ORDER BY visit_date DESC, id DESC",
+      arrayOf(patientId.toString()),
+    )
+    .use { c ->
+      buildList {
+        while (c.moveToNext()) {
+          add(
+            Visit(
+              id = c.getLong(0),
+              patientId = patientId,
+              date = LocalDate.parse(c.getString(1)),
+              gaWeeks = c.getInt(2),
+              weightKg = c.getDouble(3),
+              systolic = c.getInt(4),
+              diastolic = c.getInt(5),
+              hemoglobin = if (c.isNull(6)) null else c.getDouble(6),
+              dangerSigns = c.getString(7).split(",").filter { it.isNotBlank() }
+                .map { DangerSign.valueOf(it) }.toSet(),
+              notes = c.getString(8),
+            ),
+          )
+        }
+      }
+    }
+
+  fun addVisit(v: Visit) {
+    writableDatabase.insert("visits", null, ContentValues().apply {
+      put("patient_id", v.patientId)
+      put("visit_date", v.date.toString())
+      put("ga_weeks", v.gaWeeks)
+      put("weight_kg", v.weightKg)
+      put("systolic", v.systolic)
+      put("diastolic", v.diastolic)
+      put("hemoglobin", v.hemoglobin)
+      put("danger_signs", v.dangerSigns.joinToString(",") { it.name })
+      put("notes", v.notes)
+    })
+  }
+}
