+package com.example.ancapp.viewmodel
+
+import android.content.Context
+import androidx.lifecycle.ViewModelProvider
+import com.example.ancapp.data.AncDatabase
+import com.example.ancapp.data.AncRepository
+import com.example.ancapp.network.FhirServiceFactory
+
+class AncViewModelFactory(private val context: Context) : ViewModelProvider.Factory {
+  override fun <T : androidx.lifecycle.ViewModel> create(modelClass: Class<T>): T {
+    if (modelClass.isAssignableFrom(AncViewModel::class.java)) {
+      val database = AncDatabase.getInstance(context)
+      val fhirApi = FhirServiceFactory.createFhirService()
+      val repository = AncRepository(
+        patientDao = database.patientDao(),
+        ancVisitDao = database.ancVisitDao(),
+        dangerSignDao = database.dangerSignDao(),
+        fhirApi = fhirApi
+      )
+      @Suppress("UNCHECKED_CAST")
+      return AncViewModel(repository) as T
+    }
+    throw IllegalArgumentException("Unknown ViewModel class")
+  }
+}
