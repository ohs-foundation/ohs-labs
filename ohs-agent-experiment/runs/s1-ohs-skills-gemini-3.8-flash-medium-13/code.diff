+                      Text(
+                        "Current Gestational Age",
+                        style = MaterialTheme.typography.labelMedium,
+                        color = MaterialTheme.colorScheme.outline,
+                      )
+                      Text(
+                        if (currentPatient.gestationalAgeWeeks != null) {
+                          "${currentPatient.gestationalAgeWeeks} weeks"
+                        } else {
+                          "Unknown"
