+package com.example.ancapp.ui
+
+import android.app.Application
+import androidx.lifecycle.AndroidViewModel
+import androidx.lifecycle.viewModelScope
+import com.example.ancapp.data.AncRepository
+import com.example.ancapp.data.AncVisitItem
+import com.example.ancapp.data.PatientItem
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+
+class AncViewModel(application: Application) : AndroidViewModel(application) {
+  private val repository = AncRepository(application.applicationContext)
+
+  private val _patients = MutableStateFlow<List<PatientItem>>(emptyList())
+  val patients: StateFlow<List<PatientItem>> = _patients.asStateFlow()
+
+  private val _selectedPatient = MutableStateFlow<PatientItem?>(null)
+  val selectedPatient: StateFlow<PatientItem?> = _selectedPatient.asStateFlow()
+
+  private val _visits = MutableStateFlow<List<AncVisitItem>>(emptyList())
+  val visits: StateFlow<List<AncVisitItem>> = _visits.asStateFlow()
+
+  private val _questionnaireJson = MutableStateFlow<String?>(null)
+  val questionnaireJson: StateFlow<String?> = _questionnaireJson.asStateFlow()
+
+  private val _isLoading = MutableStateFlow<Boolean>(false)
+  val isLoading: StateFlow<Boolean> = _isLoading.asStateFlow()
+
+  init {
+    loadInitialData()
+  }
+
+  fun loadInitialData() {
+    viewModelScope.launch {
+      _isLoading.value = true
+      // First load local data if available
+      loadLocalPatients()
+      // Preload questionnaire JSON
+      _questionnaireJson.value = repository.getQuestionnaireJson()
+      // Sync with remote FHIR server
+      repository.syncWithServer()
+      // Reload local data post-sync
+      loadLocalPatients()
+      _isLoading.value = false
+    }
+  }
+
+  fun refresh() {
+    viewModelScope.launch {
+      _isLoading.value = true
+      repository.syncWithServer()
+      loadLocalPatients()
+      _selectedPatient.value?.let { current ->
+        loadVisits(current.id)
+      }
+      _isLoading.value = false
+    }
+  }
+
+  private suspend fun loadLocalPatients() {
+    val patientList = repository.getPatients()
+    _patients.value = patientList
+    _selectedPatient.value?.let { current ->
+      _selectedPatient.value = patientList.firstOrNull { it.id == current.id }
+    }
+  }
+
+  fun selectPatient(patientId: String) {
+    viewModelScope.launch {
+      _selectedPatient.value = _patients.value.firstOrNull { it.id == patientId }
+      loadVisits(patientId)
+    }
+  }
+
+  fun loadVisits(patientId: String) {
+    viewModelScope.launch {
+      _visits.value = repository.getVisitsForPatient(patientId)
+    }
+  }
+
+  fun saveVisit(patientId: String, qr: QuestionnaireResponse, onComplete: () -> Unit = {}) {
+    viewModelScope.launch {
+      _isLoading.value = true
+      repository.saveVisit(patientId, qr)
+      // Reload visits immediately
+      _visits.value = repository.getVisitsForPatient(patientId)
+      // Reload patients
+      loadLocalPatients()
+      _isLoading.value = false
+      onComplete()
+    }
+  }
+}
