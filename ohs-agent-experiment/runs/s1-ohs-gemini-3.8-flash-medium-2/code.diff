+                    style = MaterialTheme.typography.labelSmall,
+                    color = MaterialTheme.colorScheme.outline
+                  )
+                  Text(
+                    text = patient.estimatedDueDate,
+                    style = MaterialTheme.typography.bodyLarge,
+                    fontWeight = FontWeight.SemiBold
+                  )
+                }
+              }
+            }
+          }
+        }
+
+        // Section Title: Past ANC Visits
+        item {
+          Row(
+            modifier = Modifier
+              .fillMaxWidth()
+              .padding(top = 8.dp),
+            horizontalArrangement = Arrangement.SpaceBetween,
+            verticalAlignment = Alignment.CenterVertically
+          ) {
+            Text(
+              text = "Past ANC Visits",
+              style = MaterialTheme.typography.titleLarge,
+              fontWeight = FontWeight.Bold
+            )
+            Text(
+              text = "${visits.size} recorded",
+              style = MaterialTheme.typography.labelMedium,
+              color = MaterialTheme.colorScheme.secondary
+            )
+          }
+        }
+
+        if (isLoading && visits.isEmpty()) {
+          item {
+            Box(
+              modifier = Modifier
+                .fillMaxWidth()
+                .padding(32.dp),
+              contentAlignment = Alignment.Center
+            ) {
+              CircularProgressIndicator()
+            }
+          }
+        } else if (visits.isEmpty()) {
+          item {
+            Card(
+              modifier = Modifier.fillMaxWidth(),
+              colors = CardDefaults.cardColors(
+                containerColor = MaterialTheme.colorScheme.surface
+              )
+            ) {
+              Box(
+                modifier = Modifier
+                  .fillMaxWidth()
+                  .padding(32.dp),
+                contentAlignment = Alignment.Center
+              ) {
+                Text(
+                  text = "No past visits recorded yet.\nTap 'Record ANC Visit' to add one.",
+                  style = MaterialTheme.typography.bodyMedium,
+                  color = MaterialTheme.colorScheme.onSurfaceVariant
+                )
+              }
+            }
+          }
+        } else {
+          items(visits, key = { it.id }) { visit ->
+            VisitCard(visit = visit)
+          }
+        }
+
+        // Padding at bottom for FAB
+        item {
+          Spacer(modifier = Modifier.height(72.dp))
+        }
+      }
+    }
+  }
+}
+
+@Composable
+fun VisitCard(visit: AncVisit) {
+  OutlinedCard(
+    modifier = Modifier.fillMaxWidth(),
+    shape = RoundedCornerShape(14.dp),
+    colors = CardDefaults.outlinedCardColors(
+      containerColor = MaterialTheme.colorScheme.surface
+    )
+  ) {
+    Column(
+      modifier = Modifier
+        .fillMaxWidth()
+        .padding(16.dp)
+    ) {
+      // Visit Header: Date
+      Row(
+        modifier = Modifier.fillMaxWidth(),
+        horizontalArrangement = Arrangement.SpaceBetween,
+        verticalAlignment = Alignment.CenterVertically
+      ) {
+        Row(verticalAlignment = Alignment.CenterVertically) {
+          Icon(
+            imageVector = Icons.Default.CalendarToday,
+            contentDescription = null,
+            modifier = Modifier.size(18.dp),
+            tint = MaterialTheme.colorScheme.primary
+          )
+          Spacer(modifier = Modifier.width(8.dp))
+          Text(
+            text = "Visit Date: ${visit.date}",
+            style = MaterialTheme.typography.titleMedium,
+            fontWeight = FontWeight.Bold
+          )
+        }
+
+        if (visit.gestationalAgeWeeks != null) {
+          SuggestionChip(
+            onClick = {},
+            label = { Text("${visit.gestationalAgeWeeks} wks") }
+          )
+        }
+      }
+
+      HorizontalDivider(
+        modifier = Modifier.padding(vertical = 10.dp),
+        color = MaterialTheme.colorScheme.surfaceVariant
+      )
+
+      // Vitals & Clinical Measurements
+      // 1. Weight
+      Row(
+        modifier = Modifier
+          .fillMaxWidth()
+          .padding(vertical = 2.dp),
+        horizontalArrangement = Arrangement.SpaceBetween
+      ) {
+        Text(
+          text = "Weight:",
+          style = MaterialTheme.typography.bodyMedium,
+          color = MaterialTheme.colorScheme.onSurfaceVariant
+        )
+        Text(
+          text = if (visit.weightKg != null) "${visit.weightKg} kg" else "Not recorded",
+          style = MaterialTheme.typography.bodyMedium,
+          fontWeight = FontWeight.SemiBold
+        )
+      }
+
+      // 2. Blood Pressure
+      Row(
+        modifier = Modifier
+          .fillMaxWidth()
+          .padding(vertical = 2.dp),
+        horizontalArrangement = Arrangement.SpaceBetween
+      ) {
+        Text(
+          text = "Blood Pressure:",
+          style = MaterialTheme.typography.bodyMedium,
+          color = MaterialTheme.colorScheme.onSurfaceVariant
+        )
+        Text(
+          text = visit.bloodPressureDisplay ?: "Not recorded",
+          style = MaterialTheme.typography.bodyMedium,
+          fontWeight = FontWeight.SemiBold
+        )
+      }
+
+      // 3. Hemoglobin (if recorded!)
+      if (visit.hemoglobinGdl != null) {
+        Row(
+          modifier = Modifier
+            .fillMaxWidth()
+            .padding(vertical = 2.dp),
+          horizontalArrangement = Arrangement.SpaceBetween
+        ) {
+          Text(
+            text = "Hemoglobin:",
+            style = MaterialTheme.typography.bodyMedium,
+            color = MaterialTheme.colorScheme.onSurfaceVariant
+          )
+          Text(
+            text = "${visit.hemoglobinGdl} g/dL",
+            style = MaterialTheme.typography.bodyMedium,
+            fontWeight = FontWeight.SemiBold,
+            color = if (visit.hemoglobinGdl < 11.0) MaterialTheme.colorScheme.error else MaterialTheme.colorScheme.onSurface
+          )
+        }
+      }
+
+      // Danger signs (if recorded)
+      if (visit.dangerSigns.isNotEmpty()) {
+        Spacer(modifier = Modifier.height(6.dp))
+        Row(
+          modifier = Modifier.fillMaxWidth(),
+          verticalAlignment = Alignment.Top
+        ) {
+          Icon(
+            imageVector = Icons.Default.Warning,
+            contentDescription = null,
+            modifier = Modifier.size(16.dp),
+            tint = if (visit.dangerSigns.all { it.equals("none", ignoreCase = true) }) {
+              MaterialTheme.colorScheme.outline
+            } else {
+              MaterialTheme.colorScheme.error
+            }
+          )
+          Spacer(modifier = Modifier.width(6.dp))
+          Text(
+            text = "Danger signs: ${visit.dangerSigns.joinToString(", ")}",
+            style = MaterialTheme.typography.bodySmall,
+            color = if (visit.dangerSigns.all { it.equals("none", ignoreCase = true) }) {
+              MaterialTheme.colorScheme.onSurfaceVariant
+            } else {
+              MaterialTheme.colorScheme.error
+            },
+            fontWeight = FontWeight.Medium
+          )
+        }
+      }
+
+      // Notes (if recorded)
+      if (!visit.notes.isNullOrBlank()) {
+        Spacer(modifier = Modifier.height(6.dp))
+        Surface(
+          modifier = Modifier.fillMaxWidth(),
+          color = MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.5f),
+          shape = RoundedCornerShape(8.dp)
+        ) {
+          Text(
+            text = "Notes: ${visit.notes}",
+            modifier = Modifier.padding(8.dp),
+            style = MaterialTheme.typography.bodySmall,
+            color = MaterialTheme.colorScheme.onSurfaceVariant
+          )
+        }
+      }
+    }
+  }
+}
