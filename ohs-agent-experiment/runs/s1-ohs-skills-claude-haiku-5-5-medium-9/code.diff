+import dev.ohs.fhir.datacapture.Questionnaire
+import java.time.LocalDate
+import java.time.temporal.ChronoUnit
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.launch
 
 class MainActivity : ComponentActivity() {
   override fun onCreate(savedInstanceState: Bundle?) {
     super.onCreate(savedInstanceState)
-    setContent { MaterialTheme { Surface { Text("Hello") } } }
+    setContent { MaterialTheme { Surface { AncRoot() } } }
   }
 }
+
+private sealed interface Screen {
+  data object Register : Screen
+  data class Patient(val id: String) : Screen
+  data class NewVisit(val patientId: String) : Screen
+}
+
+@Composable
+private fun AncRoot() {
+  var screen by remember { mutableStateOf<Screen>(Screen.Register) }
+  when (val s = screen) {
+    Screen.Register -> RegisterScreen(onOpen = { screen = Screen.Patient(it) })
+    is Screen.Patient -> PatientScreen(
+      patientId = s.id,
+      onBack = { screen = Screen.Register },
+      onNewVisit = { screen = Screen.NewVisit(s.id) },
+    )
+    is Screen.NewVisit -> NewVisitScreen(
+      patientId = s.patientId,
+      onDone = { screen = Screen.Patient(s.patientId) },
+    )
+  }
+}
+
+@Composable
+private fun RegisterScreen(onOpen: (String) -> Unit) {
+  val result by produceState<Result<List<PatientRow>>?>(null) {
+    value = runCatching { loadPregnantPatients() }
+  }
+  Column(Modifier.fillMaxSize().padding(16.dp)) {
+    Text("Pregnant patients", style = MaterialTheme.typography.headlineSmall)
+    Text("Sorted by estimated due date", style = MaterialTheme.typography.bodySmall)
+    val r = result
+    when {
+      r == null -> Text("Loading…")
+      r.isFailure -> Text("Could not load patients: ${r.exceptionOrNull()?.message}")
+      else -> LazyColumn {
+        items(r.getOrThrow()) { p ->
+          Column(Modifier.fillMaxWidth().clickable { onOpen(p.id) }.padding(vertical = 12.dp)) {
+            Text(p.name, style = MaterialTheme.typography.titleMedium)
+            Text("Age ${p.age} · Due ${p.dueDate} · ${gestation(p.dueDate)}")
+          }
+          HorizontalDivider()
+        }
+      }
+    }
+  }
+}
+
+@Composable
+private fun PatientScreen(patientId: String, onBack: () -> Unit, onNewVisit: () -> Unit) {
+  val result by produceState<Result<Pair<PatientRow, List<VisitRow>>>?>(null, patientId) {
+    value = runCatching { loadPatient(patientId) to loadVisits(patientId) }
+  }
+  Column(Modifier.fillMaxSize().padding(16.dp)) {
+    TextButton(onClick = onBack) { Text("Back") }
+    val r = result
+    when {
+      r == null -> Text("Loading…")
+      r.isFailure -> Text("Could not load patient: ${r.exceptionOrNull()?.message}")
+      else -> {
+        val (patient, visits) = r.getOrThrow()
+        Text(patient.name, style = MaterialTheme.typography.headlineSmall)
+        Text("Age ${patient.age} · Due ${patient.dueDate} · ${gestation(patient.dueDate)}")
+        Button(onClick = onNewVisit, modifier = Modifier.padding(vertical = 8.dp)) {
+          Text("Record ANC visit")
+        }
+        Text("Visits", style = MaterialTheme.typography.titleMedium)
+        if (visits.isEmpty()) Text("No visits recorded")
+        LazyColumn {
+          items(visits) { v ->
+            Text(
+              "${v.date} · Weight ${v.weight ?: "—"} · BP ${v.bp ?: "—"} · Hb ${v.hb ?: "—"}",
+              modifier = Modifier.padding(vertical = 6.dp),
+            )
+          }
+        }
+      }
+    }
+  }
+}
+
+@Composable
+private fun NewVisitScreen(patientId: String, onDone: () -> Unit) {
+  val questionnaire by produceState<Result<String>?>(null) {
+    value = runCatching { fetchQuestionnaireJson() }
+  }
+  val scope = rememberCoroutineScope()
+  var error by remember { mutableStateOf<String?>(null) }
+  // A fresh store per form session: the Questionnaire view-model is keyed by the JSON alone,
+  // so reusing the Activity's store would show the previous visit's answers (see data-capture skill).
+  val owner = remember {
+    object : ViewModelStoreOwner {
+      override val viewModelStore = ViewModelStore()
+    }
+  }
+  DisposableEffect(owner) { onDispose { owner.viewModelStore.clear() } }
+
+  Column(Modifier.fillMaxSize().padding(16.dp)) {
+    error?.let { Text(it, color = MaterialTheme.colorScheme.error) }
+    val q = questionnaire
+    when {
+      q == null -> Text("Loading form…")
+      q.isFailure -> Text("Could not load form: ${q.exceptionOrNull()?.message}")
+      else -> CompositionLocalProvider(LocalViewModelStoreOwner provides owner) {
+        Questionnaire(
+          questionnaireJson = q.getOrThrow(),
+          onSubmit = { getResponse ->
+            scope.launch {
+              try {
+                saveVisit(patientId, getResponse())
+                onDone()
+              } catch (e: CancellationException) {
+                // Validation failed; the form is already showing the per-question errors.
+              } catch (e: Exception) {
+                error = "Save failed: ${e.message}"
+              }
+            }
+          },
+          onCancel = onDone,
+        )
+      }
+    }
+  }
+}
+
+private fun gestation(due: LocalDate): String {
+  val today = LocalDate.now()
+  val days = ChronoUnit.DAYS.between(due.minusDays(280), today) // EDD = LMP + 280 days
+  val overdue = if (today.isAfter(due)) " (past due)" else ""
+  return "${days / 7}w${days % 7}d$overdue"
+}
