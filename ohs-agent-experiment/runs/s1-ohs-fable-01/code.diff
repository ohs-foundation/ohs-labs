+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun PatientDetailScreen(
+  patientId: String,
+  refreshKey: Int,
+  onBack: () -> Unit,
+  onRecordVisit: () -> Unit,
+) {
+  val context = LocalContext.current
+  val patientName by
+    produceState(initialValue = "", patientId) {
+      value = AncRepository.getPatientName(context, patientId)
+    }
+  val visits by
+    produceState<List<VisitRow>?>(initialValue = null, patientId, refreshKey) {
+      value = AncRepository.loadVisits(context, patientId)
+    }
+
+  Scaffold(
+    topBar = {
+      TopAppBar(
+        title = { Text(patientName.ifBlank { "Patient" }) },
+        navigationIcon = { IconButton(onClick = onBack) { Text("←", fontSize = 22.sp) } },
+      )
+    },
+    floatingActionButton = {
+      ExtendedFloatingActionButton(onClick = onRecordVisit) { Text("＋ Record visit") }
+    },
+  ) { padding ->
+    val list = visits
+    when {
+      list == null ->
+        Box(Modifier.padding(padding).fillMaxSize(), contentAlignment = Alignment.Center) {
+          CircularProgressIndicator()
+        }
+      list.isEmpty() ->
+        Box(Modifier.padding(padding).fillMaxSize(), contentAlignment = Alignment.Center) {
+          Text("No ANC visits recorded yet.", style = MaterialTheme.typography.bodyLarge)
+        }
+      else ->
+        LazyColumn(
+          modifier = Modifier.padding(padding),
+          contentPadding = PaddingValues(start = 16.dp, end = 16.dp, top = 16.dp, bottom = 96.dp),
+          verticalArrangement = Arrangement.spacedBy(12.dp),
+        ) {
+          items(list, key = { it.encounterId }) { visit -> VisitCard(visit) }
+        }
+    }
+  }
+}
+
+@Composable
+private fun VisitCard(visit: VisitRow) {
+  Card(Modifier.fillMaxWidth()) {
+    Column(Modifier.padding(16.dp)) {
+      Row(verticalAlignment = Alignment.CenterVertically) {
+        Text(
+          "Visit — ${visit.date.display()}",
+          style = MaterialTheme.typography.titleMedium,
+          fontWeight = FontWeight.SemiBold,
+          modifier = Modifier.weight(1f),
+        )
+        visit.gestationalWeeks?.let {
+          Text(
+            "$it wk",
+            style = MaterialTheme.typography.bodyMedium,
+            color = MaterialTheme.colorScheme.primary,
+          )
+        }
+      }
+      Spacer(Modifier.height(8.dp))
+      MeasurementRow("Weight", visit.weightKg?.let { "$it kg" })
+      MeasurementRow(
+        "Blood pressure",
+        if (visit.systolic != null || visit.diastolic != null) {
+          "${visit.systolic ?: "—"}/${visit.diastolic ?: "—"} mmHg"
+        } else {
+          null
+        },
+      )
+      MeasurementRow("Hemoglobin", visit.hemoglobin?.let { "$it g/dL" })
+      if (visit.dangerSigns.isNotEmpty()) {
+        Spacer(Modifier.height(8.dp))
+        Text(
+          "Danger signs: ${visit.dangerSigns.joinToString(", ")}",
+          style = MaterialTheme.typography.bodyMedium,
+          color = MaterialTheme.colorScheme.error,
+          fontWeight = FontWeight.SemiBold,
+        )
+      }
+      visit.notes?.let {
+        Spacer(Modifier.height(8.dp))
+        Text(
+          it,
+          style = MaterialTheme.typography.bodyMedium,
+          color = MaterialTheme.colorScheme.onSurfaceVariant,
+        )
+      }
+    }
+  }
+}
+
+@Composable
+private fun MeasurementRow(label: String, value: String?) {
+  Row(Modifier.fillMaxWidth().padding(vertical = 2.dp)) {
+    Text(
+      label,
+      style = MaterialTheme.typography.bodyMedium,
+      color = MaterialTheme.colorScheme.onSurfaceVariant,
+      modifier = Modifier.weight(1f),
+    )
+    Text(value ?: "—", style = MaterialTheme.typography.bodyMedium)
+  }
+}
