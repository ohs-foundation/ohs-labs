diff --git a/app/src/main/java/com/example/ancapp/data/AncRepository.kt b/app/src/main/java/com/example/ancapp/data/AncRepository.kt
new file mode 100644
index 0000000..f63a37d
--- /dev/null
+++ b/app/src/main/java/com/example/ancapp/data/AncRepository.kt
@@ -0,0 +1,533 @@
+package com.example.ancapp.data
+
+import android.content.Context
+import com.ionspin.kotlin.bignum.decimal.BigDecimal
+import dev.ohs.fhir.engine.FhirEngine
+import dev.ohs.fhir.engine.FhirEngineProvider
+import dev.ohs.fhir.engine.search.ReferenceClientParam
+import dev.ohs.fhir.engine.search.Search
+import dev.ohs.fhir.engine.get
+import dev.ohs.fhir.model.r4.Canonical
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.CodeableConcept
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.DateTime
+import dev.ohs.fhir.model.r4.Decimal
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Enumeration
+import dev.ohs.fhir.model.r4.FhirDateTime
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Patient
+import dev.ohs.fhir.model.r4.Period
+import dev.ohs.fhir.model.r4.Quantity
+import dev.ohs.fhir.model.r4.Questionnaire
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import dev.ohs.fhir.model.r4.Reference
+import dev.ohs.fhir.model.r4.String as FhirString
+import dev.ohs.fhir.model.r4.Uri
+import dev.ohs.fhir.model.r4.terminologies.ResourceType
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import java.time.LocalDate
+import java.time.Period as JavaPeriod
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+
+class AncRepository(private val context: Context) {
+  private val engine: FhirEngine
+    get() = FhirEngineProvider.getInstance(context.applicationContext)
+
+  private val json = Json {
+    explicitNulls = false
+    encodeDefaults = false
+  }
+
+  suspend fun getPatients(): List<PatientItem> {
+    val patients = engine.search<Patient>(Search(ResourceType.Patient)).map { it.resource }
+    val observations = engine.search<Observation>(Search(ResourceType.Observation)).map { it.resource }
+
+    val today = LocalDate.now()
+
+    return patients.map { patient ->
+      val patientId = patient.id ?: ""
+      val nameObj = patient.name.firstOrNull()
+      val fullName = listOfNotNull(
+        nameObj?.given?.mapNotNull { it.value }?.joinToString(" ")?.ifBlank { null },
+        nameObj?.family?.value
+      ).joinToString(" ").ifBlank { "Patient $patientId" }
+
+      val dobStr = patient.birthDate?.value?.toString()
+      val dob = dobStr?.let { runCatching { LocalDate.parse(it) }.getOrNull() }
+      val age = dob?.let { JavaPeriod.between(it, today).years }
+
+      // Find EDD observation (LOINC 11778-8)
+      val eddObs = observations.firstOrNull { obs ->
+        val subjectId = obs.subject?.reference?.value?.substringAfter("Patient/")
+        subjectId == patientId && obs.code.coding.any { it.code?.value == "11778-8" }
+      }
+      val eddStr = eddObs?.value?.asDateTime()?.value?.value?.toString()?.substringBefore("T")
+      val edd = eddStr?.let { runCatching { LocalDate.parse(it) }.getOrNull() }
+
+      val (weeks, weeksDisplay) = if (edd != null) {
+        val lmp = edd.minusDays(280)
+        val days = ChronoUnit.DAYS.between(lmp, today)
+        val w = (days / 7).toInt().coerceAtLeast(0)
+        Pair(w, "$w weeks")
+      } else {
+        Pair(null, "N/A")
+      }
+
+      PatientItem(
+        id = patientId,
+        name = fullName,
+        dob = dob,
+        age = age,
+        edd = edd,
+        eddDisplay = eddStr ?: "N/A",
+        currentWeeks = weeks,
+        currentWeeksDisplay = weeksDisplay,
+      )
+    }.sortedWith(compareBy(nullsLast()) { it.edd })
+  }
+
+  suspend fun getPatientDetails(patientId: String): Pair<PatientItem?, List<PastVisitItem>> {
+    val allPatients = getPatients()
+    val patientItem = allPatients.firstOrNull { it.id == patientId }
+
+    val encounters = engine.search<Encounter>(
+      Search(ResourceType.Encounter).apply {
+        filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+      }
+    ).map { it.resource }
+
+    val observations = engine.search<Observation>(
+      Search(ResourceType.Observation).apply {
+        filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+      }
+    ).map { it.resource }
+
+    val responses = engine.search<QuestionnaireResponse>(
+      Search(ResourceType.QuestionnaireResponse).apply {
+        filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+      }
+    ).map { it.resource }
+
+    val visits = encounters.map { encounter ->
+      val encId = encounter.id ?: ""
+      val encDateStr = encounter.period?.start?.value?.toString()?.substringBefore("T")
+        ?: encounter.period?.end?.value?.toString()?.substringBefore("T")
+
+      // Linked observations for this encounter
+      val encObs = observations.filter { obs ->
+        val ref = obs.encounter?.reference?.value?.substringAfter("Encounter/")
+        if (ref != null) {
+          ref == encId
+        } else {
+          val obsDate = obs.effective?.asDateTime()?.value?.value?.toString()?.substringBefore("T")
+          obsDate != null && obsDate == encDateStr
+        }
+      }
+
+      // Weight (LOINC 29463-7)
+      val weightObs = encObs.firstOrNull { it.code.coding.any { c -> c.code?.value == "29463-7" } }
+      val weightVal = weightObs?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+      val weightDisplay = weightVal?.let { "$it kg" }
+
+      // Blood pressure (LOINC 85354-9)
+      val bpObs = encObs.firstOrNull { it.code.coding.any { c -> c.code?.value == "85354-9" } }
+      var systolicVal: String? = null
+      var diastolicVal: String? = null
+      bpObs?.component?.forEach { comp ->
+        val code = comp.code.coding.firstOrNull { it.system?.value == "http://loinc.org" }?.code?.value
+        val q = comp.value?.asQuantity()?.value?.value?.value?.toPlainString()
+        if (code == "8480-6") systolicVal = q
+        if (code == "8462-4") diastolicVal = q
+      }
+      val bpDisplay = when {
+        systolicVal != null && diastolicVal != null -> "$systolicVal/$diastolicVal"
+        systolicVal != null -> "$systolicVal/-"
+        else -> null
+      }
+
+      // Hemoglobin (LOINC 718-7)
+      val hbObs = encObs.firstOrNull { it.code.coding.any { c -> c.code?.value == "718-7" } }
+      val hbVal = hbObs?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+      val hbDisplay = hbVal?.let { "$it g/dL" }
+
+      // Gestational age (LOINC 49051-6)
+      val gaObs = encObs.firstOrNull { it.code.coding.any { c -> c.code?.value == "49051-6" } }
+      val gaVal = gaObs?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+      var gaDisplay = gaVal?.let { "$it weeks" }
+
+      // Also check QuestionnaireResponse linked to this encounter
+      val qr = responses.firstOrNull { r ->
+        val rEnc = r.encounter?.reference?.value?.substringAfter("Encounter/")
+        if (rEnc != null) {
+          rEnc == encId
+        } else {
+          val rDate = r.authored?.value?.toString()?.substringBefore("T")
+          rDate != null && rDate == encDateStr
+        }
+      }
+
+      val dangerSignsList = mutableListOf<String>()
+      var notesVal: String? = null
+
+      if (qr != null) {
+        val answers = mutableMapOf<String, MutableList<QuestionnaireResponse.Item.Answer>>()
+        fun collect(items: List<QuestionnaireResponse.Item>) {
+          items.forEach { item ->
+            item.linkId.value?.let { answers.getOrPut(it) { mutableListOf() }.addAll(item.answer) }
+            collect(item.item)
+            item.answer.forEach { collect(it.item) }
+          }
+        }
+        collect(qr.item)
+
+        if (gaDisplay == null) {
+          val gaInt = answers["gestational-age"]?.firstOrNull()?.value?.asInteger()?.value?.value
+          if (gaInt != null) {
+            gaDisplay = "$gaInt weeks"
+          }
+        }
+
+        val dangerCodings = answers["danger-signs"].orEmpty().mapNotNull { it.value?.asCoding()?.value }
+        dangerCodings.forEach { coding ->
+          val display = coding.display?.value ?: coding.code?.value
+          if (display != null) dangerSignsList.add(display)
+        }
+
+        notesVal = answers["notes"]?.firstOrNull()?.value?.asString()?.value?.value
+      }
+
+      val visitDate = encDateStr ?: "Unknown"
+      val parsedDate = runCatching { LocalDate.parse(visitDate) }.getOrNull()
+
+      PastVisitItem(
+        encounterId = encId,
+        date = visitDate,
+        dateSort = parsedDate,
+        weight = weightDisplay,
+        bloodPressure = bpDisplay,
+        hemoglobin = hbDisplay,
+        gestationalAge = gaDisplay,
+        dangerSigns = dangerSignsList,
+        notes = notesVal,
+      )
+    }.sortedWith(compareByDescending(nullsLast()) { it.dateSort })
+
+    return Pair(patientItem, visits)
+  }
+
+  suspend fun getQuestionnaireJson(): String {
+    val dbQ: Questionnaire? = try {
+      engine.get<Questionnaire>("anc-contact")
+    } catch (e: Exception) {
+      try {
+        engine.search<Questionnaire>(Search(ResourceType.Questionnaire)).firstOrNull()?.resource
+      } catch (e2: Exception) {
+        null
+      }
+    }
+
+    if (dbQ != null) {
+      return json.encodeToString(dbQ)
+    }
+
+    return BUNDLED_ANC_QUESTIONNAIRE_JSON
+  }
+
+  suspend fun saveNewVisit(patientId: String, response: QuestionnaireResponse) {
+    val answers = mutableMapOf<String, MutableList<QuestionnaireResponse.Item.Answer>>()
+    fun collect(items: List<QuestionnaireResponse.Item>) {
+      items.forEach { item ->
+        item.linkId.value?.let { answers.getOrPut(it) { mutableListOf() }.addAll(item.answer) }
+        collect(item.item)
+        item.answer.forEach { collect(it.item) }
+      }
+    }
+    collect(response.item)
+
+    val visitDateStr = answers["visit-date"]?.firstOrNull()?.value?.asDate()?.value?.value?.toString()
+      ?: LocalDate.now().toString()
+    val gaWeeksInt = answers["gestational-age"]?.firstOrNull()?.value?.asInteger()?.value?.value
+    val weightBigDecimal = answers["weight"]?.firstOrNull()?.value?.asDecimal()?.value?.value
+    val bpSysInt = answers["bp-systolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+    val bpDiaInt = answers["bp-diastolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+
+    val encounterId = UUID.randomUUID().toString()
+
+    val encounterResource = Encounter(
+      id = encounterId,
+      status = Enumeration(value = Encounter.EncounterStatus.Finished),
+      `class` = Coding(
+        system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"),
+        code = Code(value = "AMB"),
+        display = FhirString(value = "ambulatory"),
+      ),
+      type = listOf(
+        CodeableConcept(
+          text = FhirString(value = "Antenatal care contact")
+        )
+      ),
+      subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+      period = Period(
+        start = DateTime(value = FhirDateTime.fromString(visitDateStr)),
+        end = DateTime(value = FhirDateTime.fromString(visitDateStr)),
+      ),
+    )
+
+    val weightObs = weightBigDecimal?.let { w ->
+      Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        category = listOf(
+          CodeableConcept(
+            coding = listOf(
+              Coding(
+                system = Uri(value = "http://terminology.hl7.org/CodeSystem/observation-category"),
+                code = Code(value = "vital-signs"),
+                display = FhirString(value = "Vital Signs"),
+              )
+            )
+          )
+        ),
+        code = CodeableConcept(
+          coding = listOf(
+            Coding(
+              system = Uri(value = "http://loinc.org"),
+              code = Code(value = "29463-7"),
+              display = FhirString(value = "Body weight"),
+            )
+          ),
+          text = FhirString(value = "Body weight"),
+        ),
+        subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+        encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")),
+        effective = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(visitDateStr))),
+        value = Observation.Value.Quantity(
+          Quantity(
+            value = Decimal(value = w),
+            unit = FhirString(value = "kg"),
+            system = Uri(value = "http://unitsofmeasure.org"),
+            code = Code(value = "kg"),
+          )
+        ),
+      )
+    }
+
+    val bpObs = if (bpSysInt != null || bpDiaInt != null) {
+      val components = mutableListOf<Observation.Component>()
+      if (bpSysInt != null) {
+        components.add(
+          Observation.Component(
+            code = CodeableConcept(
+              coding = listOf(
+                Coding(
+                  system = Uri(value = "http://loinc.org"),
+                  code = Code(value = "8480-6"),
+                  display = FhirString(value = "Systolic blood pressure"),
+                )
+              )
+            ),
+            value = Observation.Component.Value.Quantity(
+              Quantity(
+                value = Decimal(value = BigDecimal.fromInt(bpSysInt)),
+                unit = FhirString(value = "mmHg"),
+                system = Uri(value = "http://unitsofmeasure.org"),
+                code = Code(value = "mm[Hg]"),
+              )
+            )
+          )
+        )
+      }
+      if (bpDiaInt != null) {
+        components.add(
+          Observation.Component(
+            code = CodeableConcept(
+              coding = listOf(
+                Coding(
+                  system = Uri(value = "http://loinc.org"),
+                  code = Code(value = "8462-4"),
+                  display = FhirString(value = "Diastolic blood pressure"),
+                )
+              )
+            ),
+            value = Observation.Component.Value.Quantity(
+              Quantity(
+                value = Decimal(value = BigDecimal.fromInt(bpDiaInt)),
+                unit = FhirString(value = "mmHg"),
+                system = Uri(value = "http://unitsofmeasure.org"),
+                code = Code(value = "mm[Hg]"),
+              )
+            )
+          )
+        )
+      }
+      Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        category = listOf(
+          CodeableConcept(
+            coding = listOf(
+              Coding(
+                system = Uri(value = "http://terminology.hl7.org/CodeSystem/observation-category"),
+                code = Code(value = "vital-signs"),
+                display = FhirString(value = "Vital Signs"),
+              )
+            )
+          )
+        ),
+        code = CodeableConcept(
+          coding = listOf(
+            Coding(
+              system = Uri(value = "http://loinc.org"),
+              code = Code(value = "85354-9"),
+              display = FhirString(value = "Blood pressure panel with all children optional"),
+            )
+          ),
+          text = FhirString(value = "Blood pressure"),
+        ),
+        subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+        encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")),
+        effective = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(visitDateStr))),
+        component = components,
+      )
+    } else null
+
+    val gaObs = gaWeeksInt?.let { ga ->
+      Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        code = CodeableConcept(
+          coding = listOf(
+            Coding(
+              system = Uri(value = "http://loinc.org"),
+              code = Code(value = "49051-6"),
+              display = FhirString(value = "Gestational age in weeks"),
+            )
+          ),
+          text = FhirString(value = "Gestational age"),
+        ),
+        subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+        encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")),
+        effective = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(visitDateStr))),
+        value = Observation.Value.Quantity(
+          Quantity(
+            value = Decimal(value = BigDecimal.fromInt(ga)),
+            unit = FhirString(value = "wk"),
+            system = Uri(value = "http://unitsofmeasure.org"),
+            code = Code(value = "wk"),
+          )
+        ),
+      )
+    }
+
+    val completedResponse = response.toBuilder().apply {
+      id = UUID.randomUUID().toString()
+      status = Enumeration(value = QuestionnaireResponse.QuestionnaireResponseStatus.Completed)
+      subject = Reference(reference = FhirString(value = "Patient/$patientId")).toBuilder()
+      encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")).toBuilder()
+      questionnaire = Canonical(value = "http://example.org/fhir/Questionnaire/anc-contact").toBuilder()
+      authored = DateTime(value = FhirDateTime.fromString(visitDateStr)).toBuilder()
+    }.build()
+
+    val resources = listOfNotNull(encounterResource, weightObs, bpObs, gaObs, completedResponse)
+    engine.create(*resources.toTypedArray())
+  }
+
+  companion object {
+    const val BUNDLED_ANC_QUESTIONNAIRE_JSON = """{
+  "resourceType": "Questionnaire",
+  "id": "anc-contact",
+  "url": "http://example.org/fhir/Questionnaire/anc-contact",
+  "version": "0.1.0",
+  "name": "AncContact",
+  "title": "ANC Contact Visit",
+  "status": "active",
+  "subjectType": [ "Patient" ],
+  "item": [ {
+    "linkId": "visit-date",
+    "text": "Visit date",
+    "type": "date",
+    "required": true
+  }, {
+    "linkId": "gestational-age",
+    "text": "Gestational age (weeks)",
+    "type": "integer"
+  }, {
+    "linkId": "vitals",
+    "text": "Vital signs",
+    "type": "group",
+    "item": [ {
+      "linkId": "weight",
+      "code": [ {
+        "system": "http://loinc.org",
+        "code": "29463-7",
+        "display": "Body weight"
+      } ],
+      "text": "Weight (kg)",
+      "type": "decimal"
+    }, {
+      "linkId": "bp-systolic",
+      "code": [ {
+        "system": "http://loinc.org",
+        "code": "8480-6",
+        "display": "Systolic blood pressure"
+      } ],
+      "text": "Systolic blood pressure (mmHg)",
+      "type": "integer"
+    }, {
+      "linkId": "bp-diastolic",
+      "code": [ {
+        "system": "http://loinc.org",
+        "code": "8462-4",
+        "display": "Diastolic blood pressure"
+      } ],
+      "text": "Diastolic blood pressure (mmHg)",
+      "type": "integer"
+    } ]
+  }, {
+    "linkId": "danger-signs",
+    "text": "Danger signs present",
+    "type": "choice",
+    "repeats": true,
+    "answerOption": [ {
+      "valueCoding": {
+        "system": "urn:example:anc-danger-signs",
+        "code": "none",
+        "display": "None"
+      }
