+import com.example.ancapp.AncRepository
+import dev.ohs.fhir.datacapture.Questionnaire
+import dev.ohs.fhir.datacapture.QuestionnaireConfig
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.launch
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun NewVisitScreen(
+  patientId: String,
+  repository: AncRepository,
+  onVisitSaved: () -> Unit,
+  onCancel: () -> Unit,
+) {
+  var questionnaireJson by remember { mutableStateOf<String?>(null) }
+  var isSaving by remember { mutableStateOf(false) }
+  val scope = rememberCoroutineScope()
+
+  LaunchedEffect(patientId) {
+    questionnaireJson = repository.getQuestionnaireJson()
+  }
+
+  Scaffold(
+    topBar = {
+      TopAppBar(
+        title = { Text("Record ANC Visit", fontWeight = FontWeight.Bold) },
+        navigationIcon = {
+          IconButton(onClick = onCancel) {
+            Icon(Icons.AutoMirrored.Filled.ArrowBack, contentDescription = "Cancel")
+          }
+        },
+        colors = TopAppBarDefaults.topAppBarColors(
+          containerColor = MaterialTheme.colorScheme.primaryContainer,
+          titleContentColor = MaterialTheme.colorScheme.onPrimaryContainer,
+        ),
+      )
+    },
+  ) { innerPadding ->
+    Box(
+      modifier = Modifier
+        .fillMaxSize()
+        .padding(innerPadding),
+    ) {
+      val json = questionnaireJson
+      if (json == null || isSaving) {
+        Box(modifier = Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
+          CircularProgressIndicator()
+        }
+      } else {
+        Questionnaire(
+          questionnaireJson = json,
+          config = QuestionnaireConfig(
+            showSubmitButton = true,
+            showCancelButton = true,
+            submitButtonText = "Save Visit",
+          ),
+          onSubmit = { getResponse ->
+            scope.launch {
+              try {
+                isSaving = true
+                val response: QuestionnaireResponse = getResponse()
+                repository.saveVisit(patientId, response)
+                onVisitSaved()
+              } catch (_: CancellationException) {
+                // Validation failed; form displays errors itself
+                isSaving = false
+              } catch (_: Exception) {
+                isSaving = false
+              }
+            }
+          },
+          onCancel = onCancel,
+        )
+      }
+    }
+  }
+}
