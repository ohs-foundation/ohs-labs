@@ -0,0 +1,15 @@
+package com.example.ancapp
+
+import java.time.LocalDate
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class CalcTest {
+  @Test fun calcs() {
+    val today = LocalDate.parse("2026-10-13")
+    assertEquals(39, gaWeeks(LocalDate.parse("2026-10-15"), today)) // 278 days
+    assertEquals(32, gaWeeks(LocalDate.parse("2026-12-05"), today)) // 227 days
+    assertEquals(30, ageYears(LocalDate.parse("1996-04-12"), today))
+    assertEquals(35, ageYears(LocalDate.parse("1990-11-02"), today)) // birthday not yet reached
+  }
+}
