@@ -0,0 +1,95 @@
+package com.example.ancapp
+
+import android.content.ContentValues
+import android.content.Context
+import android.database.sqlite.SQLiteDatabase
+import android.database.sqlite.SQLiteOpenHelper
+import java.time.LocalDate
+import java.time.Period
+import java.time.temporal.ChronoUnit
+
+data class Patient(val id: Long, val name: String, val dob: LocalDate, val edd: LocalDate)
+
+data class Visit(
+  val date: LocalDate,
+  val gaWeeks: Int?,
+  val weightKg: Double,
+  val systolic: Int,
+  val diastolic: Int,
+  val hbGdl: Double?,
+  val dangerSigns: List<String>,
+  val notes: String,
+)
+
+val DANGER_SIGNS = listOf("Vaginal bleeding", "Severe headache", "Blurred vision", "Fever")
+
+fun ageYears(dob: LocalDate, today: LocalDate): Int = Period.between(dob, today).years
+
+/** Gestational weeks from EDD (Naegele: EDD = LMP + 280 days). */
+fun gaWeeks(edd: LocalDate, today: LocalDate): Int =
+  ((280 - ChronoUnit.DAYS.between(today, edd)) / 7).toInt()
+
+class Db(context: Context) : SQLiteOpenHelper(context, "anc.db", null, 1) {
+  override fun onCreate(db: SQLiteDatabase) {
+    db.execSQL("CREATE TABLE patient(id INTEGER PRIMARY KEY, name TEXT NOT NULL, dob TEXT NOT NULL, edd TEXT NOT NULL)")
+    db.execSQL(
+      """CREATE TABLE visit(id INTEGER PRIMARY KEY, patient_id INTEGER NOT NULL REFERENCES patient(id),
+        date TEXT NOT NULL, ga_weeks INTEGER, weight_kg REAL NOT NULL, systolic INTEGER NOT NULL,
+        diastolic INTEGER NOT NULL, hb_gdl REAL, danger_signs TEXT NOT NULL DEFAULT '', notes TEXT NOT NULL DEFAULT '')"""
+    )
+    listOf(
+      Triple("Emily Carter", "1996-04-12", "2026-12-05") to Visit(LocalDate.parse("2026-08-10"), null, 68.5, 118, 76, 11.8, emptyList(), ""),
+      Triple("Sarah Mitchell", "1990-11-02", "2027-01-20") to Visit(LocalDate.parse("2026-08-12"), null, 61.2, 110, 70, 12.4, emptyList(), ""),
+      Triple("Grace Thompson", "2001-07-30", "2026-10-15") to Visit(LocalDate.parse("2026-08-05"), null, 72.0, 128, 84, 10.2, emptyList(), ""),
+    ).forEach { (p, v) ->
+      val pid = db.insertOrThrow("patient", null, ContentValues().apply {
+        put("name", p.first); put("dob", p.second); put("edd", p.third)
+      })
+      insertVisit(db, pid, v.copy(gaWeeks = gaWeeks(LocalDate.parse(p.third), v.date)))
+    }
+  }
+
+  override fun onUpgrade(db: SQLiteDatabase, oldVersion: Int, newVersion: Int) = Unit
+
+  fun patients(): List<Patient> =
+    readableDatabase.rawQuery("SELECT id, name, dob, edd FROM patient ORDER BY edd", null).use { c ->
+      buildList {
+        while (c.moveToNext()) add(Patient(c.getLong(0), c.getString(1), LocalDate.parse(c.getString(2)), LocalDate.parse(c.getString(3))))
+      }
+    }
+
+  fun visits(patientId: Long): List<Visit> =
+    readableDatabase.rawQuery(
+      "SELECT date, ga_weeks, weight_kg, systolic, diastolic, hb_gdl, danger_signs, notes FROM visit WHERE patient_id = ? ORDER BY date DESC, id DESC",
+      arrayOf(patientId.toString()),
+    ).use { c ->
+      buildList {
+        while (c.moveToNext()) add(
+          Visit(
+            LocalDate.parse(c.getString(0)),
+            if (c.isNull(1)) null else c.getInt(1),
+            c.getDouble(2), c.getInt(3), c.getInt(4),
+            if (c.isNull(5)) null else c.getDouble(5),
+            c.getString(6).split('|').filter { it.isNotEmpty() },
+            c.getString(7),
+          )
+        )
+      }
+    }
+
+  fun addVisit(patientId: Long, v: Visit) = insertVisit(writableDatabase, patientId, v)
+
+  private fun insertVisit(db: SQLiteDatabase, patientId: Long, v: Visit) {
+    db.insertOrThrow("visit", null, ContentValues().apply {
+      put("patient_id", patientId)
+      put("date", v.date.toString())
+      put("ga_weeks", v.gaWeeks)
+      put("weight_kg", v.weightKg)
+      put("systolic", v.systolic)
+      put("diastolic", v.diastolic)
+      put("hb_gdl", v.hbGdl)
+      put("danger_signs", v.dangerSigns.joinToString("|"))
+      put("notes", v.notes)
+    })
+  }
+}
diff --git a/app/src/main/java/com/example/ancapp/MainActivity.kt b/app/src/main/java/com/example/ancapp/MainActivity.kt
index b5e554b..c7f9439 100644
--- a/app/src/main/java/com/example/ancapp/MainActivity.kt
