+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun NewVisitFormScreen(
+  viewModel: AncViewModel,
+  patient: PatientItem,
+  onClose: () -> Unit
+) {
+  val questionnaireJson by viewModel.questionnaireJson.collectAsState()
+  val scope = rememberCoroutineScope()
+  var isSaving by remember { mutableStateOf(false) }
+  var saveError by remember { mutableStateOf<String?>(null) }
+
+  Scaffold(
+    topBar = {
+      TopAppBar(
+        title = { Text("New ANC Visit - ${patient.name}") },
+        navigationIcon = {
+          IconButton(onClick = onClose) {
+            Icon(Icons.AutoMirrored.Filled.ArrowBack, contentDescription = "Cancel")
+          }
+        }
+      )
+    }
+  ) { paddingValues ->
+    Box(
+      modifier = Modifier
+        .fillMaxSize()
+        .padding(paddingValues)
+    ) {
+      val jsonStr = questionnaireJson
+      if (jsonStr == null) {
+        CircularProgressIndicator(modifier = Modifier.align(Alignment.Center))
+      } else {
+        Questionnaire(
+          questionnaireJson = jsonStr,
+          config = QuestionnaireConfig(
+            showSubmitButton = true,
+            showCancelButton = true,
+            submitButtonText = "Save Visit"
+          ),
+          onSubmit = { getResponse ->
+            scope.launch {
+              try {
+                isSaving = true
+                val response: QuestionnaireResponse = getResponse()
+                viewModel.saveAncVisit(patient.id, response)
+                isSaving = false
+                onClose()
+              } catch (e: CancellationException) {
+                // Answer validation failed, questionnaire displays errors internally
+                isSaving = false
+              } catch (e: Exception) {
+                isSaving = false
+                saveError = e.message ?: "Failed to save visit"
+              }
+            }
+          },
+          onCancel = onClose
+        )
+      }
+
+      if (isSaving) {
+        Surface(
+          modifier = Modifier.fillMaxSize(),
+          color = Color.Black.copy(alpha = 0.3f)
+        ) {
+          Box(contentAlignment = Alignment.Center) {
+            CircularProgressIndicator()
+          }
+        }
+      }
+
+      saveError?.let { err ->
+        AlertDialog(
+          onDismissRequest = { saveError = null },
+          title = { Text("Error") },
+          text = { Text(err) },
+          confirmButton = {
+            Button(onClick = { saveError = null }) {
+              Text("OK")
+            }
+          }
+        )
+      }
+    }
   }
 }
