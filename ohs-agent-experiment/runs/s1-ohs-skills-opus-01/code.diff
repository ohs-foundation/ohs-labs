@@ -0,0 +1,141 @@
+package com.example.ancapp.ui
+
+import android.app.Application
+import androidx.lifecycle.AndroidViewModel
+import androidx.lifecycle.viewModelScope
+import com.example.ancapp.data.AncRepository
+import com.example.ancapp.data.PatientDetail
+import com.example.ancapp.data.RegisterEntry
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+
+sealed interface RegisterUiState {
+  data object Loading : RegisterUiState
+
+  data class Ready(val entries: List<RegisterEntry>) : RegisterUiState
+
+  data class Error(val message: String) : RegisterUiState
+}
+
+sealed interface DetailUiState {
+  data object Loading : DetailUiState
+
+  data class Ready(val patient: PatientDetail) : DetailUiState
+
+  data class Error(val message: String) : DetailUiState
+}
+
+sealed interface FormUiState {
+  data object Loading : FormUiState
+
+  data class Ready(val questionnaireJson: String) : FormUiState
+
+  data class Error(val message: String) : FormUiState
+}
+
+class AncViewModel(app: Application) : AndroidViewModel(app) {
+
+  private val repository = AncRepository(app)
+
+  private val _register = MutableStateFlow<RegisterUiState>(RegisterUiState.Loading)
+  val register: StateFlow<RegisterUiState> = _register.asStateFlow()
+
+  private val _detail = MutableStateFlow<DetailUiState>(DetailUiState.Loading)
+  val detail: StateFlow<DetailUiState> = _detail.asStateFlow()
+
+  private val _form = MutableStateFlow<FormUiState>(FormUiState.Loading)
+  val form: StateFlow<FormUiState> = _form.asStateFlow()
+
+  private val _syncing = MutableStateFlow(false)
+  val syncing: StateFlow<Boolean> = _syncing.asStateFlow()
+
+  private val _banner = MutableStateFlow<String?>(null)
+  val banner: StateFlow<String?> = _banner.asStateFlow()
+
+  init {
+    viewModelScope.launch {
+      // Show whatever is already on the device first, then reconcile with the server.
+      if (repository.hasLocalPatients()) refreshRegister()
+      syncThenRefresh()
+    }
+  }
+
+  fun retry() {
+    viewModelScope.launch {
+      _register.value = RegisterUiState.Loading
+      syncThenRefresh()
+    }
+  }
+
+  fun dismissBanner() {
+    _banner.value = null
+  }
+
+  private suspend fun syncThenRefresh() {
+    _syncing.value = true
+    val ok = runCatching { repository.sync() }.getOrDefault(false)
+    _syncing.value = false
+    refreshRegister()
+    _banner.value =
+      if (ok) null else "Could not reach the clinic server. Showing data stored on this device."
+  }
+
+  private suspend fun refreshRegister() {
+    _register.value =
+      runCatching { RegisterUiState.Ready(repository.loadRegister()) }
+        .getOrElse { RegisterUiState.Error(it.message ?: "Could not load the ANC register.") }
+  }
+
+  fun openPatient(patientId: String) {
+    viewModelScope.launch {
+      _detail.value = DetailUiState.Loading
+      reloadDetail(patientId)
+    }
+  }
+
+  private suspend fun reloadDetail(patientId: String) {
+    _detail.value =
+      runCatching {
+          repository.loadPatientDetail(patientId)?.let { DetailUiState.Ready(it) }
+            ?: DetailUiState.Error("Patient not found on this device.")
+        }
+        .getOrElse { DetailUiState.Error(it.message ?: "Could not load this patient.") }
+  }
+
+  fun openVisitForm() {
+    viewModelScope.launch {
+      _form.value = FormUiState.Loading
+      val json = runCatching { repository.loadQuestionnaireJson() }.getOrNull()
+      if (json != null) {
+        _form.value = FormUiState.Ready(json)
+        return@launch
+      }
+      // The form definition lives on the server; pull it if we have not synced yet.
+      repository.sync()
+      _form.value =
+        runCatching { repository.loadQuestionnaireJson() }
+          .getOrNull()
+          ?.let { FormUiState.Ready(it) }
+          ?: FormUiState.Error("The ANC visit form could not be loaded from the server.")
+    }
+  }
+
+  /**
+   * Saves the filled form to the device and refreshes the patient's visit list. The upload to
+   * the server runs on afterwards so the nurse is not kept waiting on the network.
+   */
+  suspend fun saveVisit(patientId: String, response: QuestionnaireResponse) {
+    repository.saveVisit(patientId, response)
+    reloadDetail(patientId)
+    refreshRegister()
+    viewModelScope.launch {
+      _syncing.value = true
+      val ok = repository.uploadPendingChanges()
+      _syncing.value = false
+      if (!ok) _banner.value = "The visit is saved on this device but has not reached the server yet."
+    }
+  }
+}
