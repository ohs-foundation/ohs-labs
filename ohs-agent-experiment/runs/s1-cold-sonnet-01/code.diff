+package com.example.ancapp.ui.register
+
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.PaddingValues
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.lazy.LazyColumn
+import androidx.compose.foundation.lazy.items
+import androidx.compose.material3.Card
+import androidx.compose.material3.CardDefaults
+import androidx.compose.material3.ExperimentalMaterial3Api
+import androidx.compose.material3.Scaffold
+import androidx.compose.material3.Text
+import androidx.compose.material3.TopAppBar
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.text.font.FontWeight
+import androidx.compose.ui.unit.dp
+import com.example.ancapp.data.Patient
+import com.example.ancapp.data.ageInYears
+import com.example.ancapp.data.currentWeeksPregnant
+import com.example.ancapp.data.toDisplayString
+import com.example.ancapp.data.toLocalDate
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun RegisterScreen(
+    patients: List<Patient>,
+    onPatientClick: (Patient) -> Unit,
+) {
+    val sorted = patients.sortedBy { it.estimatedDueDate.toLocalDate() }
+
+    Scaffold(
+        topBar = { TopAppBar(title = { Text("Antenatal Register") }) },
+    ) { padding ->
+        LazyColumn(
+            contentPadding = PaddingValues(16.dp, padding.calculateTopPadding() + 8.dp, 16.dp, 16.dp),
+            verticalArrangement = Arrangement.spacedBy(12.dp),
+            modifier = Modifier.fillMaxWidth(),
+        ) {
+            items(sorted, key = { it.id }) { patient ->
+                PatientRow(patient = patient, onClick = { onPatientClick(patient) })
+            }
+        }
+    }
+}
+
+@Composable
+private fun PatientRow(patient: Patient, onClick: () -> Unit) {
+    Card(
+        onClick = onClick,
+        modifier = Modifier.fillMaxWidth(),
+        elevation = CardDefaults.cardElevation(defaultElevation = 2.dp),
+    ) {
+        Column(modifier = Modifier.padding(16.dp)) {
+            Text(patient.name, fontWeight = FontWeight.Bold)
+            Text("Age ${ageInYears(patient.dateOfBirth)}")
+            Text("Due ${patient.estimatedDueDate.toLocalDate().toDisplayString()}")
+            Text("${currentWeeksPregnant(patient.estimatedDueDate)} weeks pregnant")
+        }
+    }
+}
