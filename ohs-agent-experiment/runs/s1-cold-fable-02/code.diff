+import kotlinx.coroutines.launch
+
+class VisitFormViewModel(
+  private val repository: AncRepository,
+  private val patientId: Long,
+) : ViewModel() {
+  var date by mutableStateOf(LocalDate.now())
+  var gestationalWeeks by mutableStateOf("")
+  var weight by mutableStateOf("")
+  var systolic by mutableStateOf("")
+  var diastolic by mutableStateOf("")
+  var dangerSigns by mutableStateOf(setOf<DangerSign>())
+  var notes by mutableStateOf("")
+
+  var errors by mutableStateOf(mapOf<String, String>())
+    private set
+  var saved by mutableStateOf(false)
+    private set
+
+  init {
+    // Suggest the gestational age implied by the patient's due date; the nurse can edit it.
+    viewModelScope.launch {
+      val patient = repository.patient(patientId).firstOrNull()
+      if (patient != null && gestationalWeeks.isEmpty()) {
+        gestationalWeeks = gestationalWeeks(patient.dueDate, date).toString()
+      }
+    }
+  }
+
+  fun toggleDangerSign(sign: DangerSign) {
+    dangerSigns = if (sign in dangerSigns) dangerSigns - sign else dangerSigns + sign
+  }
+
+  fun clearDangerSigns() {
+    dangerSigns = emptySet()
+  }
+
+  fun save() {
+    val newErrors = mutableMapOf<String, String>()
+    val weeks = gestationalWeeks.toIntOrNull()
+    if (weeks == null || weeks !in 1..45) newErrors["weeks"] = "Enter weeks between 1 and 45"
+    val weightKg = weight.toDoubleOrNull()
+    if (weightKg == null || weightKg !in 30.0..200.0) newErrors["weight"] = "Enter weight in kg (30–200)"
+    val sys = systolic.toIntOrNull()
+    if (sys == null || sys !in 60..250) newErrors["systolic"] = "Enter 60–250"
+    val dia = diastolic.toIntOrNull()
+    if (dia == null || dia !in 30..150) newErrors["diastolic"] = "Enter 30–150"
+    errors = newErrors
+    if (newErrors.isNotEmpty()) return
+
+    viewModelScope.launch {
+      repository.recordVisit(
+        Visit(
+          patientId = patientId,
+          date = date,
+          gestationalWeeks = weeks!!,
+          weightKg = weightKg!!,
+          systolic = sys!!,
+          diastolic = dia!!,
+          dangerSigns = dangerSigns,
+          notes = notes.trim(),
+        )
+      )
+      saved = true
+    }
+  }
+
+  companion object {
+    fun factory(patientId: Long) = viewModelFactory {
+      initializer {
+        VisitFormViewModel((this[APPLICATION_KEY] as AncApplication).repository, patientId)
+      }
+    }
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun VisitFormScreen(
+  patientId: Long,
+  onDone: () -> Unit,
+  viewModel: VisitFormViewModel = viewModel(
+    key = "visit-form-$patientId",
+    factory = VisitFormViewModel.factory(patientId),
+  ),
+) {
+  LaunchedEffect(viewModel.saved) {
+    if (viewModel.saved) onDone()
+  }
+
+  var showDatePicker by remember { mutableStateOf(false) }
+
+  Scaffold(
+    topBar = {
+      TopAppBar(
+        title = { Text("Record ANC visit") },
+        navigationIcon = {
+          IconButton(onClick = onDone) {
+            Icon(Icons.AutoMirrored.Filled.ArrowBack, contentDescription = "Back")
+          }
+        },
+      )
+    },
+  ) { innerPadding ->
+    Column(
+      modifier = Modifier
+        .fillMaxSize()
+        .padding(innerPadding)
+        .verticalScroll(rememberScrollState())
+        .padding(16.dp),
+      verticalArrangement = Arrangement.spacedBy(12.dp),
+    ) {
+      OutlinedTextField(
+        value = viewModel.date.display(),
+        onValueChange = {},
+        readOnly = true,
+        label = { Text("Visit date") },
+        trailingIcon = {
+          IconButton(onClick = { showDatePicker = true }) {
+            Icon(Icons.Default.DateRange, contentDescription = "Pick date")
+          }
+        },
+        modifier = Modifier.fillMaxWidth().clickable { showDatePicker = true },
+      )
+
+      OutlinedTextField(
+        value = viewModel.gestationalWeeks,
+        onValueChange = { viewModel.gestationalWeeks = it },
+        label = { Text("Gestational age (weeks)") },
+        keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+        isError = "weeks" in viewModel.errors,
+        supportingText = { viewModel.errors["weeks"]?.let { Text(it) } },
+        singleLine = true,
+        modifier = Modifier.fillMaxWidth(),
+      )
+
+      OutlinedTextField(
+        value = viewModel.weight,
+        onValueChange = { viewModel.weight = it },
+        label = { Text("Weight (kg)") },
+        keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Decimal),
+        isError = "weight" in viewModel.errors,
+        supportingText = { viewModel.errors["weight"]?.let { Text(it) } },
+        singleLine = true,
+        modifier = Modifier.fillMaxWidth(),
+      )
+
+      Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
+        OutlinedTextField(
+          value = viewModel.systolic,
+          onValueChange = { viewModel.systolic = it },
+          label = { Text("Systolic (mmHg)") },
+          keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+          isError = "systolic" in viewModel.errors,
+          supportingText = { viewModel.errors["systolic"]?.let { Text(it) } },
+          singleLine = true,
+          modifier = Modifier.weight(1f),
+        )
+        OutlinedTextField(
+          value = viewModel.diastolic,
+          onValueChange = { viewModel.diastolic = it },
+          label = { Text("Diastolic (mmHg)") },
+          keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+          isError = "diastolic" in viewModel.errors,
+          supportingText = { viewModel.errors["diastolic"]?.let { Text(it) } },
+          singleLine = true,
+          modifier = Modifier.weight(1f),
+        )
+      }
+
+      Text("Danger signs", style = MaterialTheme.typography.titleSmall)
+      DangerSignRow(
+        label = "None",
+        checked = viewModel.dangerSigns.isEmpty(),
+        onClick = { viewModel.clearDangerSigns() },
+      )
+      DangerSign.entries.forEach { sign ->
+        DangerSignRow(
+          label = sign.label,
+          checked = sign in viewModel.dangerSigns,
+          onClick = { viewModel.toggleDangerSign(sign) },
+        )
+      }
+
+      OutlinedTextField(
+        value = viewModel.notes,
+        onValueChange = { viewModel.notes = it },
+        label = { Text("Notes") },
+        minLines = 3,
+        modifier = Modifier.fillMaxWidth(),
+      )
+
+      Button(onClick = { viewModel.save() }, modifier = Modifier.fillMaxWidth()) {
+        Text("Save visit")
+      }
+    }
+  }
+
+  if (showDatePicker) {
+    val datePickerState = rememberDatePickerState(
+      initialSelectedDateMillis = viewModel.date.atStartOfDay(ZoneOffset.UTC).toInstant().toEpochMilli(),
+    )
+    DatePickerDialog(
+      onDismissRequest = { showDatePicker = false },
+      confirmButton = {
+        TextButton(
+          onClick = {
+            datePickerState.selectedDateMillis?.let { millis ->
+              viewModel.date = Instant.ofEpochMilli(millis).atZone(ZoneOffset.UTC).toLocalDate()
+            }
+            showDatePicker = false
+          },
+        ) { Text("OK") }
+      },
+      dismissButton = {
+        TextButton(onClick = { showDatePicker = false }) { Text("Cancel") }
+      },
+    ) {
+      DatePicker(state = datePickerState)
+    }
+  }
+}
+
+@Composable
+private fun DangerSignRow(label: String, checked: Boolean, onClick: () -> Unit) {
+  Row(
+    modifier = Modifier.fillMaxWidth().clickable(onClick = onClick),
+    verticalAlignment = Alignment.CenterVertically,
+  ) {
+    Checkbox(checked = checked, onCheckedChange = { onClick() })
+    Text(label, style = MaterialTheme.typography.bodyLarge)
+  }
+}
