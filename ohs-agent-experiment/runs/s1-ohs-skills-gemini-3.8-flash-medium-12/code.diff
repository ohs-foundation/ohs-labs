+import androidx.lifecycle.ViewModelStore
+import androidx.lifecycle.ViewModelStoreOwner
+import androidx.lifecycle.viewmodel.compose.LocalViewModelStoreOwner
+import com.example.ancapp.data.AncRepository
+import com.example.ancapp.sync.SyncViewModel
+import dev.ohs.fhir.datacapture.Questionnaire
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.launch
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun NewVisitScreen(
+  patientId: String,
+  repository: AncRepository,
+  syncViewModel: SyncViewModel,
+  onNavigateBack: () -> Unit,
+) {
+  val scope = rememberCoroutineScope()
+  var questionnaireJson by remember { mutableStateOf<String?>(null) }
+  var isSaving by remember { mutableStateOf(false) }
+
+  // Fresh ViewModelStore scoped to this screen session to avoid stale form state
+  val viewModelStore = remember { ViewModelStore() }
+  DisposableEffect(Unit) {
+    onDispose {
+      viewModelStore.clear()
+    }
+  }
+  val storeOwner = remember {
+    object : ViewModelStoreOwner {
+      override val viewModelStore: ViewModelStore = viewModelStore
+    }
+  }
+
+  LaunchedEffect(Unit) {
+    questionnaireJson = repository.getQuestionnaireJson()
+  }
+
+  Scaffold(
+    topBar = {
+      TopAppBar(
+        title = {
+          Text(
+            "Record ANC Visit",
+            fontWeight = FontWeight.Bold,
+          )
+        },
+        navigationIcon = {
+          IconButton(onClick = onNavigateBack) {
+            Icon(
+              imageVector = Icons.AutoMirrored.Filled.ArrowBack,
+              contentDescription = "Back",
+            )
+          }
+        },
+        colors = TopAppBarDefaults.topAppBarColors(
+          containerColor = MaterialTheme.colorScheme.primaryContainer,
+          titleContentColor = MaterialTheme.colorScheme.onPrimaryContainer,
+        ),
+      )
+    },
+  ) { innerPadding ->
+    Box(
+      modifier = Modifier
+        .fillMaxSize()
+        .padding(innerPadding),
+    ) {
+      val json = questionnaireJson
+      if (json == null || isSaving) {
+        Box(
+          modifier = Modifier.fillMaxSize(),
+          contentAlignment = Alignment.Center,
+        ) {
+          CircularProgressIndicator()
+        }
+      } else {
+        CompositionLocalProvider(LocalViewModelStoreOwner provides storeOwner) {
+          Questionnaire(
+            questionnaireJson = json,
+            onSubmit = { getResponse ->
+              scope.launch {
+                try {
+                  isSaving = true
+                  val response: QuestionnaireResponse = getResponse()
+                  repository.saveVisit(patientId, response)
+                  syncViewModel.syncNow()
+                  onNavigateBack()
+                } catch (e: CancellationException) {
+                  // Answer validation failed; the form is already displaying errors
+                  isSaving = false
+                } catch (e: Exception) {
+                  isSaving = false
+                }
+              }
+            },
+            onCancel = onNavigateBack,
+          )
+        }
+      }
+    }
+  }
+}
