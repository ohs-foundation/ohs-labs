+      )
+    }
+
+    else ->
+      RegisterScreen(
+        state = register,
+        syncing = syncing,
+        banner = banner,
+        onDismissBanner = viewModel::dismissBanner,
+        onRetry = viewModel::retry,
+        onPatientClick = { entry ->
+          patientId = entry.patientId
+          patientName = entry.name
+          viewModel.openPatient(entry.patientId)
+        },
+      )
   }
 }
diff --git a/app/src/main/java/com/example/ancapp/data/AncRepository.kt b/app/src/main/java/com/example/ancapp/data/AncRepository.kt
new file mode 100644
index 0000000..ce5f84f
--- /dev/null
+++ b/app/src/main/java/com/example/ancapp/data/AncRepository.kt
@@ -0,0 +1,387 @@
+package com.example.ancapp.data
+
+import android.content.Context
+import android.util.Log
+import androidx.work.ExistingWorkPolicy
+import com.ionspin.kotlin.bignum.decimal.BigDecimal
+import dev.ohs.fhir.engine.FhirEngineProvider
+import dev.ohs.fhir.engine.get
+import dev.ohs.fhir.engine.search.ReferenceClientParam
+import dev.ohs.fhir.engine.search.Search
+import dev.ohs.fhir.engine.sync.CurrentSyncJobStatus
+import dev.ohs.fhir.engine.sync.Sync
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.DateTime
+import dev.ohs.fhir.model.r4.Decimal
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Enumeration
+import dev.ohs.fhir.model.r4.FhirDateTime
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Patient
+import dev.ohs.fhir.model.r4.Period
+import dev.ohs.fhir.model.r4.Quantity
+import dev.ohs.fhir.model.r4.Questionnaire
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import dev.ohs.fhir.model.r4.Reference
+import dev.ohs.fhir.model.r4.Resource
+import dev.ohs.fhir.model.r4.Uri
+import dev.ohs.fhir.model.r4.terminologies.ResourceType
+import dev.ohs.fhir.model.r4.CodeableConcept
+import dev.ohs.fhir.model.r4.String as FhirString
+import java.time.LocalDate
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+import kotlinx.coroutines.flow.first
+import kotlinx.serialization.json.Json
+
+private const val TAG = "AncRepository"
+
+/** A full-term pregnancy is 280 days from the last menstrual period. */
+private const val TERM_DAYS = 280L
+
+/**
+ * Reads and writes ANC data. The on-device FHIR database is the working store; the clinic's
+ * HAPI server is the source of truth, reconciled by [AppSyncWorker].
+ */
+class AncRepository(context: Context) {
+
+  private val appContext = context.applicationContext
+  private val engine = FhirEngineProvider.getInstance(appContext)
+
+  private val json = Json {
+    explicitNulls = false
+    encodeDefaults = false
+  }
+
+  /** Runs a one-time sync and returns true when it completed successfully. */
+  suspend fun sync(policy: ExistingWorkPolicy? = null): Boolean {
+    val flow =
+      if (policy == null) Sync.oneTimeSync<AppSyncWorker>(appContext)
+      else Sync.oneTimeSync<AppSyncWorker>(appContext, existingWorkPolicy = policy)
+    val terminal =
+      flow.first {
+        it is CurrentSyncJobStatus.Succeeded ||
+          it is CurrentSyncJobStatus.Failed ||
+          it is CurrentSyncJobStatus.Cancelled
+      }
+    if (terminal !is CurrentSyncJobStatus.Succeeded) Log.w(TAG, "Sync finished as $terminal")
+    return terminal is CurrentSyncJobStatus.Succeeded
+  }
+
+  suspend fun hasLocalPatients(): Boolean =
+    engine.search<Patient>(Search(ResourceType.Patient)).isNotEmpty()
+
+  /** Currently pregnant patients, soonest due date first. */
+  suspend fun loadRegister(today: LocalDate = LocalDate.now()): List<RegisterEntry> {
+    val patients = engine.search<Patient>(Search(ResourceType.Patient)).map { it.resource }
+    val dueDates = latestDueDatePerPatient()
+
+    return patients
+      .mapNotNull { patient ->
+        val id = patient.id ?: return@mapNotNull null
+        val due = dueDates[id] ?: return@mapNotNull null
+        // A due date that has passed means the pregnancy is no longer current.
+        if (due.isBefore(today)) return@mapNotNull null
+        RegisterEntry(
+          patientId = id,
+          name = patient.displayName(),
+          age = patient.ageOn(today),
+          dueDate = due,
+          gestationalWeeks = gestationalWeeksFromDueDate(due, today),
+        )
+      }
+      .sortedWith(compareBy({ it.dueDate }, { it.name }))
+  }
+
+  suspend fun loadPatientDetail(
+    patientId: String,
+    today: LocalDate = LocalDate.now(),
+  ): PatientDetail? {
+    val patient = runCatching { engine.get<Patient>(patientId) }.getOrNull() ?: return null
+    val observations = observationsFor(patientId)
+    val due =
+      observations
+        .filter { it.hasCode(AncCodes.ESTIMATED_DUE_DATE) }
+        .sortedByDescending { it.effectiveDate() ?: LocalDate.MIN }
+        .firstNotNullOfOrNull { it.dateTimeValue() }
+
+    return PatientDetail(
+      patientId = patientId,
+      name = patient.displayName(),
+      age = patient.ageOn(today),
+      dueDate = due,
+      gestationalWeeks = due?.let { gestationalWeeksFromDueDate(it, today) },
+      visits = buildVisits(patientId, observations),
+    )
+  }
+
+  /** The ANC form definition, as JSON for the Data Capture renderer. */
+  suspend fun loadQuestionnaireJson(): String? {
+    val questionnaire = runCatching { engine.get<Questionnaire>(QUESTIONNAIRE_ID) }.getOrNull()
+    if (questionnaire == null) {
+      Log.w(TAG, "Questionnaire $QUESTIONNAIRE_ID is not in the local database yet")
+      return null
+    }
+    return json.encodeToString(questionnaire)
+  }
+
+  /**
+   * Turns a filled ANC form into an Encounter plus its Observations and saves them to the
+   * on-device database. Call [uploadPendingChanges] afterwards to push them to the server.
+   */
+  suspend fun saveVisit(patientId: String, response: QuestionnaireResponse) {
+    val answers = flattenAnswers(response)
+    val visitDate =
+      fhirDate(answers.single("visit-date")?.value?.asDate()?.value?.value?.toString())
+        ?: LocalDate.now()
+    val visitDateTime = DateTime(value = FhirDateTime.fromString(visitDate.toString()))
+    val patientRef = Reference(reference = FhirString(value = "Patient/$patientId"))
+
+    val encounterId = UUID.randomUUID().toString()
+    val encounterRef = Reference(reference = FhirString(value = "Encounter/$encounterId"))
+    val encounter =
+      Encounter(
+        id = encounterId,
+        status = Enumeration(value = Encounter.EncounterStatus.Finished),
+        `class` =
+          Coding(
+            system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"),
+            code = Code(value = "AMB"),
+            display = FhirString(value = "ambulatory"),
+          ),
+        type = listOf(CodeableConcept(text = FhirString(value = "Antenatal care contact"))),
+        subject = patientRef,
+        period = Period(start = visitDateTime, end = visitDateTime),
+      )
+
+    val resources = mutableListOf<Resource>(encounter)
+
+    fun observation(
+      code: CodeableConcept,
+      value: Observation.Value?,
+      categoryConcept: CodeableConcept? = null,
+      components: List<Observation.Component> = emptyList(),
+    ) =
+      Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        category = listOfNotNull(categoryConcept),
+        code = code,
+        subject = patientRef,
+        encounter = encounterRef,
+        effective = Observation.Effective.DateTime(visitDateTime),
+        value = value,
+        component = components,
+      )
+
+    val vitals = category("vital-signs", "Vital Signs")
+
+    answers.single("gestational-age")?.value?.asInteger()?.value?.value?.let { weeks ->
+      resources +=
+        observation(
+          code = loinc(AncCodes.GESTATIONAL_AGE, "Gestational age in weeks"),
+          value =
+            Observation.Value.Quantity(
+              quantity(BigDecimal.fromInt(weeks), unit = "weeks", ucumCode = "wk")
+            ),
+        )
+    }
+
+    answers.single("weight")?.value?.asDecimal()?.value?.value?.let { kg ->
+      resources +=
+        observation(
+          code = loinc(AncCodes.BODY_WEIGHT, "Body weight"),
+          value = Observation.Value.Quantity(quantity(kg, unit = "kg", ucumCode = "kg")),
+          categoryConcept = vitals,
+        )
+    }
+
+    val systolic = answers.single("bp-systolic")?.value?.asInteger()?.value?.value
+    val diastolic = answers.single("bp-diastolic")?.value?.asInteger()?.value?.value
+    if (systolic != null || diastolic != null) {
+      val components =
+        listOfNotNull(
+          systolic?.let {
+            Observation.Component(
+              code = loinc(AncCodes.BP_SYSTOLIC, "Systolic blood pressure"),
+              value =
+                Observation.Component.Value.Quantity(
+                  quantity(BigDecimal.fromInt(it), unit = "mmHg", ucumCode = "mm[Hg]")
+                ),
+            )
+          },
+          diastolic?.let {
+            Observation.Component(
+              code = loinc(AncCodes.BP_DIASTOLIC, "Diastolic blood pressure"),
+              value =
+                Observation.Component.Value.Quantity(
+                  quantity(BigDecimal.fromInt(it), unit = "mmHg", ucumCode = "mm[Hg]")
+                ),
+            )
+          },
+        )
+      resources +=
+        observation(
+          code = loinc(AncCodes.BP_PANEL, "Blood pressure"),
+          value = null,
+          categoryConcept = vitals,
+          components = components,
+        )
+    }
+
+    answers["danger-signs"].orEmpty().mapNotNull { it.value?.asCoding()?.value }.forEach { coding ->
+      val display = coding.display?.value ?: coding.code?.value ?: return@forEach
+      resources +=
+        observation(
+          code = localCode(AncCodes.DANGER_SIGN, "ANC danger sign"),
+          value =
+            Observation.Value.CodeableConcept(
+              CodeableConcept(coding = listOf(coding), text = FhirString(value = display))
+            ),
+        )
+    }
+
+    answers.single("notes")?.value?.asString()?.value?.value?.takeIf { it.isNotBlank() }?.let {
+      resources +=
+        observation(
+          code = localCode(AncCodes.VISIT_NOTE, "ANC visit note"),
+          value = Observation.Value.String(FhirString(value = it)),
+        )
+    }
+
+    resources +=
+      response
+        .toBuilder()
+        .apply {
+          this.id = UUID.randomUUID().toString()
+          this.status =
+            Enumeration(value = QuestionnaireResponse.QuestionnaireResponseStatus.Completed)
+          this.questionnaire =
+            dev.ohs.fhir.model.r4.Canonical(value = QUESTIONNAIRE_URL).toBuilder()
+          this.subject = patientRef.toBuilder()
+          this.encounter = encounterRef.toBuilder()
+          this.authored = visitDateTime.toBuilder()
+        }
+        .build()
+
+    engine.create(*resources.toTypedArray())
+  }
+
+  /**
+   * Pushes locally recorded visits to the server. Queued behind any sync already running, and
+   * safe to skip: the visit is already saved on the device either way.
+   */
+  suspend fun uploadPendingChanges(): Boolean =
+    runCatching { sync(ExistingWorkPolicy.APPEND_OR_REPLACE) }
+      .onFailure { Log.w(TAG, "Upload sync failed", it) }
+      .getOrDefault(false)
+
+  // --- internals ---------------------------------------------------------
+
+  private suspend fun latestDueDatePerPatient(): Map<String, LocalDate> =
+    engine
+      .search<Observation>(Search(ResourceType.Observation))
+      .map { it.resource }
+      .filter { it.hasCode(AncCodes.ESTIMATED_DUE_DATE) }
+      .sortedBy { it.effectiveDate() ?: LocalDate.MIN }
+      .mapNotNull { obs ->
+        val patientId = obs.subjectPatientId() ?: return@mapNotNull null
+        val due = obs.dateTimeValue() ?: return@mapNotNull null
+        patientId to due
+      }
+      // Sorted oldest first, so later entries win: the most recent estimate.
+      .toMap()
+
+  private suspend fun observationsFor(patientId: String): List<Observation> =
+    engine
+      .search<Observation>(
+        Search(ResourceType.Observation).apply {
+          filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+        }
+      )
+      .map { it.resource }
+
+  private suspend fun buildVisits(
+    patientId: String,
+    observations: List<Observation>,
+  ): List<AncVisit> {
+    val encounters =
+      engine
+        .search<Encounter>(
+          Search(ResourceType.Encounter).apply {
+            filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+          }
+        )
+        .map { it.resource }
+
+    val byEncounter = observations.groupBy { it.encounterId() }
+
+    return encounters
+      .mapNotNull { encounter ->
+        val id = encounter.id ?: return@mapNotNull null
+        val obs = byEncounter[id].orEmpty()
+        AncVisit(
+          encounterId = id,
+          date = encounter.startDate() ?: obs.firstNotNullOfOrNull { it.effectiveDate() },
+          gestationalWeeks =
+            obs
+              .firstOrNull { it.hasCode(AncCodes.GESTATIONAL_AGE) }
+              ?.quantityValue()
+              ?.toDoubleOrNull()
+              ?.toInt(),
+          weightKg = obs.firstOrNull { it.hasCode(AncCodes.BODY_WEIGHT) }?.quantityValue(),
+          systolic =
+            obs
+              .firstOrNull { it.hasCode(AncCodes.BP_PANEL) }
+              ?.componentQuantity(AncCodes.BP_SYSTOLIC),
+          diastolic =
+            obs
+              .firstOrNull { it.hasCode(AncCodes.BP_PANEL) }
+              ?.componentQuantity(AncCodes.BP_DIASTOLIC),
+          hemoglobin = obs.firstOrNull { it.hasCode(AncCodes.HEMOGLOBIN) }?.quantityValue(),
+          dangerSigns =
+            obs
+              .filter { it.hasCode(AncCodes.DANGER_SIGN) }
+              .mapNotNull { it.codeableValueDisplay() },
+          notes = obs.firstOrNull { it.hasCode(AncCodes.VISIT_NOTE) }?.stringValue(),
+        )
+      }
+      .sortedByDescending { it.date ?: LocalDate.MIN }
+  }
+}
+
+private fun quantity(value: BigDecimal, unit: String, ucumCode: String) =
+  Quantity(
+    value = Decimal(value = value),
+    unit = FhirString(value = unit),
+    system = Uri(value = UCUM),
+    code = Code(value = ucumCode),
+  )
+
+/** Weeks of pregnancy today, derived from the estimated due date. */
+fun gestationalWeeksFromDueDate(dueDate: LocalDate, today: LocalDate): Int? {
+  val daysToDue = ChronoUnit.DAYS.between(today, dueDate)
+  val gestationDays = TERM_DAYS - daysToDue
+  if (gestationDays < 0) return null
+  return (gestationDays / 7).toInt()
+}
+
+private typealias Answers = Map<String, List<QuestionnaireResponse.Item.Answer>>
+
+private fun Answers.single(linkId: String): QuestionnaireResponse.Item.Answer? =
+  this[linkId]?.firstOrNull()
+
+/** Questionnaire answers arrive in a tree of groups; flatten it by linkId. */
+private fun flattenAnswers(response: QuestionnaireResponse): Answers {
+  val answers = mutableMapOf<String, MutableList<QuestionnaireResponse.Item.Answer>>()
+  fun collect(items: List<QuestionnaireResponse.Item>) {
+    items.forEach { item ->
+      item.linkId.value?.let { answers.getOrPut(it) { mutableListOf() }.addAll(item.answer) }
+      collect(item.item)
+      item.answer.forEach { collect(it.item) }
+    }
+  }
+  collect(response.item)
+  return answers
+}
