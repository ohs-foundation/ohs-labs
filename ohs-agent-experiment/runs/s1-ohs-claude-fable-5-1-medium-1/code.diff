+
+const val FHIR_BASE_URL = "http://10.0.2.2:8080/fhir/" // trailing slash: ktor resolves "Patient" relative to the last path segment
+const val LOINC = "http://loinc.org"
+
+object Fhir {
+  lateinit var engine: FhirEngine
+
+  fun init(context: Context) {
+    if (FhirEngineProvider.isNotInitialized()) {
+      FhirEngineProvider.init(
+        FhirEngineConfiguration(serverConfiguration = ServerConfiguration(FHIR_BASE_URL)),
+        context.applicationContext,
+      )
+    }
+    engine = FhirEngineProvider.getInstance(context.applicationContext)
+  }
+
+  /** Upload local changes, then pull everything from the server. Returns true on success. */
+  // ponytail: observe WorkManager directly; Sync.oneTimeSync's status flow throws on stale DataStore state after a failed run.
+  suspend fun sync(context: Context): Boolean = runCatching {
+    val wm = WorkManager.getInstance(context.applicationContext)
+    val req = OneTimeWorkRequestBuilder<AncSyncWorker>().setInputData(workDataOf("unique_work_name" to "anc-sync")).build()
+    wm.enqueueUniqueWork("anc-sync", ExistingWorkPolicy.REPLACE, req)
+    wm.getWorkInfoByIdFlow(req.id).first { it != null && it.state.isFinished }!!.state == WorkInfo.State.SUCCEEDED
+  }.onFailure { Log.e("ANC", "sync failed", it) }.getOrDefault(false)
+
+  suspend fun patients(): List<Patient> = engine.search<Patient> {}.map { it.resource }
+
+  suspend fun observations(patientId: String? = null): List<Observation> =
+    engine.search<Observation> {
+      if (patientId != null) filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+    }.map { it.resource }
+
+  private val json = Json { explicitNulls = false; encodeDefaults = false }
+  suspend fun questionnaireJson(): String = json.encodeToString(Questionnaire.serializer(), engine.get<Questionnaire>("anc-contact"))
+
+  /** Turn a filled ANC form into Encounter + Observations (+ the response itself) and store them locally. */
+  suspend fun saveVisit(patientId: String, qr: QuestionnaireResponse) {
+    val answers = qr.item.flatten().associate { it.linkId.value!! to it.answer.map { a -> a.value } }
+    val date = (answers["visit-date"]?.firstOrNull() as? QuestionnaireResponse.Item.Answer.Value.Date)
+      ?.value?.value.let { (it as? FhirDate.Date)?.date?.toString() }
+      ?.let(LocalDate::parse) ?: LocalDate.now()
+    val weight = (answers["weight"]?.firstOrNull() as? QuestionnaireResponse.Item.Answer.Value.Decimal)?.value?.value
+    val sys = (answers["bp-systolic"]?.firstOrNull() as? QuestionnaireResponse.Item.Answer.Value.Integer)?.value?.value
+    val dia = (answers["bp-diastolic"]?.firstOrNull() as? QuestionnaireResponse.Item.Answer.Value.Integer)?.value?.value
+
+    val encId = UUID.randomUUID().toString()
+    val encounter = Encounter.Builder(
+      Enumeration(value = Encounter.EncounterStatus.Finished),
+      coding("http://terminology.hl7.org/CodeSystem/v3-ActCode", "AMB", "ambulatory"),
+    ).apply {
+      id = encId
+      type = mutableListOf(CodeableConcept.Builder().apply { text = str("Antenatal care contact") })
+      subject = ref("Patient/$patientId")
+      period = Period.Builder().apply { start = dateTime(date); end = dateTime(date) }
+    }.build()
+
+    val obs = buildList {
+      if (weight != null) add(observation(patientId, encId, date, "29463-7", "Body weight") {
+        value = Observation.Value.Quantity(qty(weight, "kg", "kg"))
+      })
+      if (sys != null || dia != null) add(observation(patientId, encId, date, "85354-9", "Blood pressure panel with all children optional") {
+        component = listOfNotNull(
+          sys?.let { bpComponent("8480-6", "Systolic blood pressure", it) },
+          dia?.let { bpComponent("8462-4", "Diastolic blood pressure", it) },
+        ).toMutableList()
+      })
+    }
+
+    val response = qr.toBuilder().apply {
+      id = UUID.randomUUID().toString()
+      subject = ref("Patient/$patientId")
+      this.encounter = ref("Encounter/$encId")
+      authored = dateTime(LocalDate.now())
+    }.build()
+
+    engine.create(encounter, *obs.toTypedArray(), response)
+  }
+
+  private fun observation(
+    patientId: String, encId: String, date: LocalDate, code: String, display: String,
+    init: Observation.Builder.() -> Unit,
+  ) = Observation.Builder(
+    Enumeration(value = Observation.ObservationStatus.Final),
+    CodeableConcept.Builder().apply { coding = mutableListOf(coding(LOINC, code, display)); text = str(display) },
+  ).apply {
+    id = UUID.randomUUID().toString()
+    subject = ref("Patient/$patientId")
+    encounter = ref("Encounter/$encId")
+    effective = Observation.Effective.DateTime(dateTime(date).build())
+    init()
+  }.build()
+
+  private fun bpComponent(code: String, display: String, mmHg: Int) =
+    Observation.Component.Builder(
+      CodeableConcept.Builder().apply { coding = mutableListOf(coding(LOINC, code, display)) }
+    ).apply { value = Observation.Component.Value.Quantity(qty(BigDecimal.fromInt(mmHg), "mmHg", "mm[Hg]")) }
+
+  private fun str(s: String) = FhirString.Builder().apply { value = s }
+  private fun ref(r: String) = Reference.Builder().apply { reference = str(r) }
+  private fun dateTime(d: LocalDate) = DateTime.Builder().apply { value = FhirDateTime.Date(kotlinx.datetime.LocalDate.parse(d.toString())) }
+  private fun coding(system: String, code: String, display: String) = Coding.Builder().apply {
+    this.system = Uri.Builder().apply { value = system }
+    this.code = Code.Builder().apply { value = code }
+    this.display = str(display)
+  }
+  private fun qty(v: BigDecimal, unit: String, ucum: String) = Quantity.Builder().apply {
+    value = Decimal.Builder().apply { value = v }
+    this.unit = str(unit)
+    system = Uri.Builder().apply { value = "http://unitsofmeasure.org" }
+    code = Code.Builder().apply { value = ucum }
+  }.build()
+}
+
+private fun List<QuestionnaireResponse.Item>.flatten(): List<QuestionnaireResponse.Item> =
+  flatMap { listOf(it) + it.item.flatten() + it.answer.flatMap { a -> a.item.flatten() } }
+
+class AncSyncWorker(ctx: Context, params: WorkerParameters) : FhirSyncWorker(ctx, params) {
+  override fun getFhirEngine() = FhirEngineProvider.getInstance(applicationContext)
+  override fun getConflictResolver(): ConflictResolver = AcceptRemoteConflictResolver
+  // ponytail: individual PUTs because HAPI rejects the relative fullUrls the bundle generator emits; Encounter is created first so references resolve.
+  override fun getUploadStrategy() = UploadStrategy.forIndividualRequest(HttpCreateMethod.PUT, HttpUpdateMethod.PATCH, true)
+  override fun getDownloadWorkManager(): DownloadWorkManager =
+    ResourceParamsBasedDownloadWorkManager(
+      mapOf(
+        ResourceType.Patient to emptyMap(),
+        ResourceType.Encounter to emptyMap(),
+        ResourceType.Observation to emptyMap(),
+        ResourceType.Questionnaire to mapOf("_id" to "anc-contact"),
+      ),
+      // ponytail: no _lastUpdated tracking, full re-download every sync; store timestamps in DataStore if the dataset grows.
+      object : ResourceParamsBasedDownloadWorkManager.TimestampContext {
+        override suspend fun saveLastUpdatedTimestamp(type: ResourceType, timestamp: String?) {}
+        override suspend fun getLasUpdateTimestamp(type: ResourceType): String? = null
+      },
+    )
+}
+
+// ---- read-side helpers ----
+
+data class Visit(val date: String, val weightKg: String?, val bp: String?, val hb: String?)
+
+fun Patient.displayName() = name.firstOrNull()?.let { n -> (n.given.mapNotNull { it.value } + listOfNotNull(n.family?.value)).joinToString(" ") } ?: id.orEmpty()
+
+fun Patient.ageYears(today: LocalDate = LocalDate.now()): Int? =
+  (birthDate?.value as? FhirDate.Date)?.date?.toString()?.let { java.time.Period.between(LocalDate.parse(it), today).years }
+
+fun Observation.loinc() = code?.coding?.firstOrNull { it.system?.value == LOINC }?.code?.value
+fun Observation.date(): String? = (effective as? Observation.Effective.DateTime)?.value?.value?.toString()?.take(10)
+fun Observation.quantity(): String? = ((value as? Observation.Value.Quantity)?.value?.value?.value)?.toStringExpanded()
+
+/** Estimated due date from the LOINC 11778-8 observation. */
+fun List<Observation>.dueDate(): LocalDate? =
+  filter { it.loinc() == "11778-8" }.mapNotNull { ((it.value as? Observation.Value.DateTime)?.value?.value)?.toString()?.take(10) }
+    .maxOrNull()?.let(LocalDate::parse)
+
+fun gestationalWeeks(edd: LocalDate, today: LocalDate = LocalDate.now()): Int =
+  40 - java.time.temporal.ChronoUnit.DAYS.between(today, edd).toInt() / 7
+
+/** Group a patient's observations by encounter into visits, newest first. */
+fun List<Observation>.toVisits(): List<Visit> =
+  filter { it.loinc() != "11778-8" }
+    .groupBy { it.encounter?.reference?.value ?: it.date() }
+    .values.map { group ->
+      val bp = group.firstOrNull { it.loinc() == "85354-9" }?.component
+      fun comp(code: String) = bp?.firstOrNull { c -> c.code?.coding?.any { it.code?.value == code } == true }
+        ?.let { (it.value as? Observation.Component.Value.Quantity)?.value?.value?.value?.toStringExpanded() }
+      Visit(
+        date = group.firstNotNullOfOrNull { it.date() } ?: "?",
+        weightKg = group.firstOrNull { it.loinc() == "29463-7" }?.quantity(),
+        bp = comp("8480-6")?.let { s -> "$s/${comp("8462-4") ?: "?"}" },
+        hb = group.firstOrNull { it.loinc() == "718-7" }?.quantity(),
+      )
+    }.sortedByDescending { it.date }
