+@Composable
+private fun VisitFormScreen(nav: NavController, patientId: String, onSaved: () -> Unit) {
+  val engine = engine()
+  val scope = rememberCoroutineScope()
+  var json by remember { mutableStateOf<String?>(null) }
+  var loaded by remember { mutableStateOf(false) }
+  LaunchedEffect(Unit) { json = engine.questionnaireJson(); loaded = true }
+  val q = json
+  when {
+    q != null -> Questionnaire(
+      questionnaireJson = q,
+      onSubmit = { getResponse ->
+        scope.launch {
+          try {
+            engine.saveVisit(patientId, getResponse())
+            onSaved()
+            nav.popBackStack()
+          } catch (e: CancellationException) {
+            // validation failed; the form shows the errors
+          }
+        }
+      },
+      onCancel = { nav.popBackStack() },
+    )
+    loaded -> Box(Modifier.padding(16.dp)) { Text("Visit form not downloaded yet. Sync with the server and try again.") }
+    else -> Box(Modifier.padding(16.dp)) { Text("Loading form…") }
   }
