+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun NewVisitFormScreen(
+    patient: PatientSummary,
+    questionnaire: AncQuestionnaire,
+    isSaving: Boolean,
+    errorMessage: String?,
+    onBack: () -> Unit,
+    onSave: (NewVisitInput) -> Unit
+) {
+    // Extract labels and options dynamically from Questionnaire/anc-contact
+    val flatItems = remember(questionnaire) {
+        questionnaire.items.flatMap { listOf(it) + it.children }.associateBy { it.linkId }
+    }
+
+    val visitDateLabel = flatItems["visit-date"]?.text ?: "Visit date"
+    val gaLabel = flatItems["gestational-age"]?.text ?: "Gestational age (weeks)"
+    val weightLabel = flatItems["weight"]?.text ?: "Weight (kg)"
+    val bpSysLabel = flatItems["bp-systolic"]?.text ?: "Systolic blood pressure (mmHg)"
+    val bpDiaLabel = flatItems["bp-diastolic"]?.text ?: "Diastolic blood pressure (mmHg)"
+    val dangerSignsSpec = flatItems["danger-signs"]
+    val dangerSignsLabel = dangerSignsSpec?.text ?: "Danger signs present"
+    val dangerSignOptions = dangerSignsSpec?.options?.takeIf { it.isNotEmpty() }
+        ?: defaultDangerSignOptions()
+    val notesLabel = flatItems["notes"]?.text ?: "Notes"
+
+    var visitDate by remember { mutableStateOf(LocalDate.now().toString()) }
+    var gestationalAge by remember { mutableStateOf(patient.currentGestationalWeeks.toString()) }
+    var weight by remember { mutableStateOf("") }
+    var bpSystolic by remember { mutableStateOf("") }
+    var bpDiastolic by remember { mutableStateOf("") }
+    val selectedCodes = remember { mutableStateListOf("none") }
+    var notes by remember { mutableStateOf("") }
+    var validationError by remember { mutableStateOf<String?>(null) }
+
+    Scaffold(
+        topBar = {
+            TopAppBar(
+                title = {
+                    Column {
+                        Text(
+                            text = questionnaire.title,
+                            style = MaterialTheme.typography.titleLarge,
+                            fontWeight = FontWeight.Bold
+                        )
+                        Text(
+                            text = "Patient: ${patient.name}",
+                            style = MaterialTheme.typography.bodySmall,
+                            color = MaterialTheme.colorScheme.onPrimary.copy(alpha = 0.85f)
+                        )
+                    }
+                },
+                navigationIcon = {
+                    IconButton(onClick = onBack, enabled = !isSaving) {
+                        Icon(
+                            imageVector = Icons.AutoMirrored.Filled.ArrowBack,
+                            contentDescription = "Back"
+                        )
+                    }
+                },
+                colors = TopAppBarDefaults.topAppBarColors(
+                    containerColor = MaterialTheme.colorScheme.primary,
+                    titleContentColor = MaterialTheme.colorScheme.onPrimary,
+                    navigationIconContentColor = MaterialTheme.colorScheme.onPrimary
+                )
+            )
+        }
+    ) { innerPadding ->
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(innerPadding)
+                .verticalScroll(rememberScrollState())
+                .padding(16.dp),
+            verticalArrangement = Arrangement.spacedBy(14.dp)
+        ) {
+            if (errorMessage != null) {
+                ErrorBanner(message = errorMessage, onRetry = null)
+            }
+            if (validationError != null) {
+                ErrorBanner(message = validationError!!, onRetry = null)
+            }
+
+            OutlinedTextField(
+                value = visitDate,
+                onValueChange = { visitDate = it },
+                label = { Text("$visitDateLabel (YYYY-MM-DD) *") },
+                modifier = Modifier.fillMaxWidth(),
+                singleLine = true
+            )
+
+            OutlinedTextField(
+                value = gestationalAge,
+                onValueChange = { gestationalAge = it },
+                label = { Text(gaLabel) },
+                keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+                modifier = Modifier.fillMaxWidth(),
+                singleLine = true
+            )
+
+            Text(
+                text = flatItems["vitals"]?.text ?: "Vital signs",
+                style = MaterialTheme.typography.titleMedium,
+                fontWeight = FontWeight.Bold
+            )
+
+            OutlinedTextField(
+                value = weight,
+                onValueChange = { weight = it },
+                label = { Text(weightLabel) },
+                keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Decimal),
+                modifier = Modifier.fillMaxWidth(),
+                singleLine = true
+            )
+
+            Row(
+                modifier = Modifier.fillMaxWidth(),
+                horizontalArrangement = Arrangement.spacedBy(12.dp)
+            ) {
+                OutlinedTextField(
+                    value = bpSystolic,
+                    onValueChange = { bpSystolic = it },
+                    label = { Text(bpSysLabel) },
+                    keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+                    modifier = Modifier.weight(1f),
+                    singleLine = true
+                )
+                OutlinedTextField(
+                    value = bpDiastolic,
+                    onValueChange = { bpDiastolic = it },
+                    label = { Text(bpDiaLabel) },
+                    keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+                    modifier = Modifier.weight(1f),
+                    singleLine = true
+                )
+            }
+
+            Card(
+                modifier = Modifier.fillMaxWidth(),
+                colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)
+            ) {
+                Column(modifier = Modifier.padding(14.dp)) {
+                    Text(
+                        text = dangerSignsLabel,
+                        style = MaterialTheme.typography.titleMedium,
+                        fontWeight = FontWeight.Bold
+                    )
+                    Text(
+                        text = "Select all that apply",
+                        style = MaterialTheme.typography.bodySmall,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant
+                    )
+                    Spacer(modifier = Modifier.height(8.dp))
+
+                    dangerSignOptions.forEach { option ->
+                        val isChecked = option.code in selectedCodes
+                        Row(
+                            modifier = Modifier
+                                .fillMaxWidth()
+                                .clickable {
+                                    if (option.code == "none") {
+                                        selectedCodes.clear()
+                                        selectedCodes.add("none")
+                                    } else {
+                                        selectedCodes.remove("none")
+                                        if (isChecked) {
+                                            selectedCodes.remove(option.code)
+                                        } else {
+                                            selectedCodes.add(option.code)
+                                        }
+                                    }
+                                }
+                                .padding(vertical = 4.dp),
+                            verticalAlignment = Alignment.CenterVertically
+                        ) {
+                            Checkbox(
+                                checked = isChecked,
+                                onCheckedChange = { checked ->
+                                    if (option.code == "none") {
+                                        if (checked) {
+                                            selectedCodes.clear()
+                                            selectedCodes.add("none")
+                                        } else {
+                                            selectedCodes.remove("none")
+                                        }
+                                    } else {
+                                        selectedCodes.remove("none")
+                                        if (checked) {
+                                            if (option.code !in selectedCodes) {
+                                                selectedCodes.add(option.code)
+                                            }
+                                        } else {
+                                            selectedCodes.remove(option.code)
+                                        }
+                                    }
+                                }
+                            )
+                            Spacer(modifier = Modifier.width(8.dp))
+                            Text(
+                                text = option.display,
+                                style = MaterialTheme.typography.bodyLarge
+                            )
+                        }
+                    }
+                }
+            }
+
+            OutlinedTextField(
+                value = notes,
+                onValueChange = { notes = it },
+                label = { Text(notesLabel) },
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .heightIn(min = 100.dp),
+                minLines = 3
+            )
+
+            Spacer(modifier = Modifier.height(8.dp))
+
+            Button(
+                onClick = {
+                    val trimmedDate = visitDate.trim()
+                    if (trimmedDate.isBlank()) {
+                        validationError = "Visit date is required."
+                        return@Button
+                    }
+                    try {
+                        LocalDate.parse(trimmedDate)
+                    } catch (_: Exception) {
+                        validationError = "Please enter Visit Date in YYYY-MM-DD format."
+                        return@Button
+                    }
+
+                    val gaVal = gestationalAge.trim().takeIf { it.isNotEmpty() }?.toIntOrNull()
+                    val weightVal = weight.trim().takeIf { it.isNotEmpty() }?.toDoubleOrNull()
+                    val sysVal = bpSystolic.trim().takeIf { it.isNotEmpty() }?.toIntOrNull()
+                    val diaVal = bpDiastolic.trim().takeIf { it.isNotEmpty() }?.toIntOrNull()
+
+                    val chosenSigns = dangerSignOptions.filter { it.code in selectedCodes }
+                    validationError = null
+
+                    onSave(
+                        NewVisitInput(
+                            visitDate = trimmedDate,
+                            gestationalAgeWeeks = gaVal,
+                            weightKg = weightVal,
+                            bpSystolic = sysVal,
+                            bpDiastolic = diaVal,
+                            selectedDangerSigns = chosenSigns,
+                            notes = notes.trim().takeIf { it.isNotEmpty() }
+                        )
+                    )
+                },
+                enabled = !isSaving,
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .height(52.dp)
+            ) {
+                if (isSaving) {
+                    CircularProgressIndicator(
+                        modifier = Modifier.size(22.dp),
+                        color = MaterialTheme.colorScheme.onPrimary,
+                        strokeWidth = 2.dp
+                    )
+                    Spacer(modifier = Modifier.width(10.dp))
+                    Text("Saving Visit...")
+                } else {
+                    Text(
+                        text = "Save Visit",
+                        style = MaterialTheme.typography.titleMedium,
+                        fontWeight = FontWeight.Bold
+                    )
+                }
+            }
+        }
+    }
+}
+
+@Composable
+fun ErrorBanner(message: String, onRetry: (() -> Unit)?) {
+    Card(
+        modifier = Modifier
+            .fillMaxWidth()
+            .padding(horizontal = 16.dp, vertical = 8.dp),
+        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.errorContainer)
+    ) {
+        Row(
+            modifier = Modifier
+                .fillMaxWidth()
+                .padding(12.dp),
+            verticalAlignment = Alignment.CenterVertically,
+            horizontalArrangement = Arrangement.SpaceBetween
+        ) {
+            Text(
+                text = message,
+                modifier = Modifier.weight(1f),
+                color = MaterialTheme.colorScheme.onErrorContainer,
+                style = MaterialTheme.typography.bodySmall
+            )
+            if (onRetry != null) {
+                TextButton(onClick = onRetry) {
+                    Text("Retry")
+                }
+            }
+        }
+    }
+}
+
+fun defaultDangerSignOptions(): List<QuestionnaireOption> = listOf(
+    QuestionnaireOption("urn:example:anc-danger-signs", "none", "None"),
+    QuestionnaireOption("urn:example:anc-danger-signs", "vaginal-bleeding", "Vaginal bleeding"),
+    QuestionnaireOption("urn:example:anc-danger-signs", "severe-headache", "Severe headache"),
+    QuestionnaireOption("urn:example:anc-danger-signs", "blurred-vision", "Blurred vision"),
+    QuestionnaireOption("urn:example:anc-danger-signs", "fever", "Fever")
+)
+
+fun defaultAncQuestionnaire(): AncQuestionnaire = AncQuestionnaire(
+    id = "anc-contact",
+    url = "http://example.org/fhir/Questionnaire/anc-contact",
+    title = "ANC Contact Visit",
+    items = listOf(
+        QuestionnaireItemSpec("visit-date", "Visit date", "date", required = true),
+        QuestionnaireItemSpec("gestational-age", "Gestational age (weeks)", "integer"),
+        QuestionnaireItemSpec(
+            linkId = "vitals",
+            text = "Vital signs",
+            type = "group",
+            children = listOf(
+                QuestionnaireItemSpec("weight", "Weight (kg)", "decimal"),
+                QuestionnaireItemSpec("bp-systolic", "Systolic blood pressure (mmHg)", "integer"),
+                QuestionnaireItemSpec("bp-diastolic", "Diastolic blood pressure (mmHg)", "integer")
+            )
+        ),
+        QuestionnaireItemSpec(
+            linkId = "danger-signs",
+            text = "Danger signs present",
+            type = "choice",
+            repeats = true,
+            options = defaultDangerSignOptions()
+        ),
+        QuestionnaireItemSpec("notes", "Notes", "text")
+    )
+)
