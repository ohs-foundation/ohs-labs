+@Composable
+fun AncAppNavHost(viewModel: AncViewModel) {
+  var currentScreen by remember { mutableStateOf<Screen>(Screen.PatientList) }
+
+  when (val screen = currentScreen) {
+    is Screen.PatientList -> {
+      PatientListScreen(
+        viewModel = viewModel,
+        onPatientClick = { patient ->
+          viewModel.selectPatient(patient)
+          currentScreen = Screen.PatientDetail(patient)
+        }
+      )
+    }
+    is Screen.PatientDetail -> {
+      BackHandler {
+        currentScreen = Screen.PatientList
+      }
+      PatientDetailScreen(
+        viewModel = viewModel,
+        patient = screen.patient,
+        onBack = { currentScreen = Screen.PatientList },
+        onRecordNewVisit = {
+          viewModel.loadQuestionnaire()
+          currentScreen = Screen.NewVisitForm(screen.patient)
+        }
+      )
+    }
+    is Screen.NewVisitForm -> {
+      BackHandler {
+        currentScreen = Screen.PatientDetail(screen.patient)
+      }
+      NewVisitFormScreen(
+        viewModel = viewModel,
+        patient = screen.patient,
+        onClose = {
+          currentScreen = Screen.PatientDetail(screen.patient)
+        }
+      )
+    }
+  }
