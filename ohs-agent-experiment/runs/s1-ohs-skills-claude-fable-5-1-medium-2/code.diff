 class MainActivity : ComponentActivity() {
   override fun onCreate(savedInstanceState: Bundle?) {
     super.onCreate(savedInstanceState)
-    setContent { MaterialTheme { Surface { Text("Hello") } } }
+    val engine = FhirEngineProvider.getInstance(applicationContext)
+    setContent {
+      MaterialTheme {
+        var screen by remember { mutableStateOf<Screen>(Screen.Register) }
+        var version by remember { mutableStateOf(0) }
+        val scope = rememberCoroutineScope()
+        val ctx = applicationContext
+
+        when (val s = screen) {
+          Screen.Register -> {
+            val patients by produceState<List<PatientRow>?>(null) {
+              value = engine.loadPatients().ifEmpty { null }
+              Sync.oneTimeSync<AppSyncWorker>(ctx).first {
+                it is CurrentSyncJobStatus.Succeeded || it is CurrentSyncJobStatus.Failed || it is CurrentSyncJobStatus.Cancelled
+              }
+              value = engine.loadPatients()
+            }
+            Page("ANC Register") {
+              val list = patients ?: return@Page Loading()
+              LazyColumn {
+                items(list) { p ->
+                  Row2(
+                    title = "${p.name}, ${p.age}",
+                    sub = "EDD ${p.edd ?: "unknown"} · ${p.weeks?.let { "$it weeks" } ?: "GA unknown"}",
+                    onClick = { screen = Screen.Detail(p) },
+                  )
+                }
+              }
+            }
+          }
+          is Screen.Detail -> {
+            BackHandler { screen = Screen.Register }
+            val visits by produceState<List<Visit>?>(null, version) { value = engine.loadVisits(s.p.id) }
+            Page(s.p.name) {
+              Button(onClick = { screen = Screen.NewVisit(s.p) }, modifier = Modifier.padding(16.dp)) { Text("Record ANC visit") }
+              val list = visits ?: return@Page Loading()
+              if (list.isEmpty()) Text("No visits yet", Modifier.padding(16.dp))
+              LazyColumn {
+                items(list) { v ->
+                  Row2(
+                    title = v.date.toString(),
+                    sub = listOfNotNull(
+                      v.weight?.let { "Weight $it kg" }, v.bp?.let { "BP $it mmHg" }, v.hb?.let { "Hb $it g/dL" },
+                    ).joinToString(" · "),
+                  )
+                }
+              }
+            }
+          }
+          is Screen.NewVisit -> {
+            val back = { screen = Screen.Detail(s.p) }
+            BackHandler(onBack = back)
+            val q by produceState<dev.ohs.fhir.model.r4.Questionnaire?>(null) { value = engine.questionnaire() }
+            Page("New visit: ${s.p.name}") {
+              val questionnaire = q ?: return@Page Loading()
+              FreshViewModelStore {
+                Questionnaire(
+                  questionnaireJson = json.encodeToString(questionnaire),
+                  onSubmit = { getResponse ->
