+import java.time.LocalDate
 
 class MainActivity : ComponentActivity() {
   override fun onCreate(savedInstanceState: Bundle?) {
     super.onCreate(savedInstanceState)
-    setContent { MaterialTheme { Surface { Text("Hello") } } }
+    val store = Store(applicationContext)
+    setContent { MaterialTheme { Surface(Modifier.fillMaxSize()) { App(store) } } }
+  }
+}
+
+// ponytail: screen = nullable ids, no nav lib; add Navigation Compose if deep links/more screens appear
+@Composable
+fun App(store: Store) {
+  var selected by remember { mutableStateOf<Patient?>(null) }
+  var recording by remember { mutableStateOf(false) }
+  var visits by remember { mutableStateOf(store.visits) }
+  val p = selected
+  when {
+    p == null -> RegisterScreen(store.patients) { selected = it }
+    recording -> VisitForm(p, onCancel = { recording = false }) {
+      store.addVisit(it); visits = store.visits; recording = false
+    }
+    else -> DetailScreen(p, visits.filter { it.patientId == p.id }, onBack = { selected = null }) { recording = true }
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun RegisterScreen(patients: List<Patient>, onOpen: (Patient) -> Unit) {
+  Scaffold(topBar = { TopAppBar(title = { Text("ANC Register") }) }) { pad ->
+    LazyColumn(Modifier.padding(pad)) {
+      items(patients.sortedBy { it.edd }) { p ->
+        ListItem(
+          modifier = Modifier.clickable { onOpen(p) },
+          headlineContent = { Text(p.name) },
+          supportingContent = { Text("Age ${p.age} · EDD ${p.edd} · ${p.weeksPregnant} weeks") },
+        )
+        HorizontalDivider()
+      }
+    }
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun DetailScreen(p: Patient, visits: List<Visit>, onBack: () -> Unit, onRecord: () -> Unit) {
+  BackHandler(onBack = onBack)
+  Scaffold(
+    topBar = { TopAppBar(title = { Text(p.name) }, navigationIcon = { TextButton(onBack) { Text("Back") } }) },
+    floatingActionButton = { ExtendedFloatingActionButton(onClick = onRecord) { Text("Record visit") } },
+  ) { pad ->
+    LazyColumn(Modifier.padding(pad)) {
+      item { Text("Age ${p.age} · EDD ${p.edd} · ${p.weeksPregnant} weeks", Modifier.padding(16.dp)) }
+      items(visits.sortedByDescending { it.date }) { v ->
+        ListItem(
+          headlineContent = { Text("${v.date} · ${v.gaWeeks} wks") },
+          supportingContent = {
+            Text(
+              "Weight ${v.weightKg} kg · BP ${v.systolic}/${v.diastolic}" +
+                (v.hb?.let { " · Hb $it g/dL" } ?: "") +
+                (if (v.dangerSigns.isNotEmpty()) "\nDanger signs: ${v.dangerSigns.joinToString()}" else "") +
+                (if (v.notes.isNotBlank()) "\n${v.notes}" else "")
+            )
+          },
+        )
+        HorizontalDivider()
+      }
+    }
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun VisitForm(p: Patient, onCancel: () -> Unit, onSave: (Visit) -> Unit) {
+  BackHandler(onBack = onCancel)
+  var date by remember { mutableStateOf(LocalDate.now().toString()) }
+  var ga by remember { mutableStateOf(p.weeksPregnant.toString()) }
+  var weight by remember { mutableStateOf("") }
+  var sys by remember { mutableStateOf("") }
+  var dia by remember { mutableStateOf("") }
+  var hb by remember { mutableStateOf("") }
+  var signs by remember { mutableStateOf(setOf<String>()) }
+  var notes by remember { mutableStateOf("") }
+  var error by remember { mutableStateOf<String?>(null) }
+
+  Scaffold(topBar = { TopAppBar(title = { Text("New visit · ${p.name}") }, navigationIcon = { TextButton(onCancel) { Text("Cancel") } }) }) { pad ->
+    Column(Modifier.padding(pad).padding(16.dp).verticalScroll(rememberScrollState()), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+      val num = KeyboardOptions(keyboardType = KeyboardType.Number)
+      val dec = KeyboardOptions(keyboardType = KeyboardType.Decimal)
+      OutlinedTextField(date, { date = it }, label = { Text("Visit date (YYYY-MM-DD)") }, singleLine = true, modifier = Modifier.fillMaxWidth())
+      OutlinedTextField(ga, { ga = it }, label = { Text("Gestational age (weeks)") }, keyboardOptions = num, singleLine = true, modifier = Modifier.fillMaxWidth())
+      OutlinedTextField(weight, { weight = it }, label = { Text("Weight (kg)") }, keyboardOptions = dec, singleLine = true, modifier = Modifier.fillMaxWidth())
+      Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+        OutlinedTextField(sys, { sys = it }, label = { Text("Systolic (mmHg)") }, keyboardOptions = num, singleLine = true, modifier = Modifier.weight(1f))
+        OutlinedTextField(dia, { dia = it }, label = { Text("Diastolic (mmHg)") }, keyboardOptions = num, singleLine = true, modifier = Modifier.weight(1f))
+      }
+      OutlinedTextField(hb, { hb = it }, label = { Text("Hemoglobin (g/dL, optional)") }, keyboardOptions = dec, singleLine = true, modifier = Modifier.fillMaxWidth())
+      Text("Danger signs", style = MaterialTheme.typography.titleSmall)
+      Row(Modifier.fillMaxWidth().clickable { signs = emptySet() }, verticalAlignment = androidx.compose.ui.Alignment.CenterVertically) {
+        Checkbox(signs.isEmpty(), { signs = emptySet() }); Text("None")
+      }
+      DANGER_SIGNS.forEach { s ->
+        val on = s in signs
+        Row(Modifier.fillMaxWidth().clickable { signs = if (on) signs - s else signs + s }, verticalAlignment = androidx.compose.ui.Alignment.CenterVertically) {
+          Checkbox(on, { signs = if (on) signs - s else signs + s }); Text(s)
+        }
+      }
+      OutlinedTextField(notes, { notes = it }, label = { Text("Notes") }, minLines = 3, modifier = Modifier.fillMaxWidth())
+      error?.let { Text(it, color = MaterialTheme.colorScheme.error) }
+      Button(
+        modifier = Modifier.fillMaxWidth(),
+        onClick = {
+          val d = runCatching { LocalDate.parse(date.trim()) }.getOrNull()
+          val g = ga.trim().toIntOrNull(); val w = weight.trim().toDoubleOrNull()
+          val s = sys.trim().toIntOrNull(); val di = dia.trim().toIntOrNull()
+          val h = hb.trim().let { if (it.isEmpty()) null else it.toDoubleOrNull() }
+          error = when {
+            d == null -> "Date must be YYYY-MM-DD"
+            g == null || g !in 1..45 -> "Gestational age must be 1–45 weeks"
+            w == null || w <= 0 -> "Weight must be a positive number"
+            s == null || di == null || s <= di -> "Enter valid systolic/diastolic (systolic > diastolic)"
+            hb.isNotBlank() && h == null -> "Hemoglobin must be a number"
+            else -> null
+          }
+          if (error == null) onSave(Visit(p.id, d!!, g!!, w!!, s!!, di!!, h, DANGER_SIGNS.filter { it in signs }, notes.trim()))
+        },
+      ) { Text("Save visit") }
+    }
   }
 }
