+  val patient = _patient.asStateFlow()
+
+  private val _visits = MutableStateFlow<List<PastVisitItem>>(emptyList())
+  val visits = _visits.asStateFlow()
+
+  private val _isLoading = MutableStateFlow(false)
+  val isLoading = _isLoading.asStateFlow()
+
+  fun loadDetails(patientId: String) {
+    viewModelScope.launch {
+      _isLoading.value = true
+      try {
+        val (p, v) = repository.getPatientDetails(patientId)
+        _patient.value = p
+        _visits.value = v
+      } catch (e: Exception) {
+        e.printStackTrace()
+      } finally {
+        _isLoading.value = false
+      }
+    }
+  }
+}
