+package com.example.ancapp.data
+
+import java.time.LocalDate
+import java.time.format.DateTimeFormatter
+import java.time.temporal.ChronoUnit
+
+private const val FULL_TERM_WEEKS = 40L
+
+private val displayFormatter: DateTimeFormatter = DateTimeFormatter.ofPattern("d MMM yyyy")
+
+fun String.toLocalDate(): LocalDate = LocalDate.parse(this)
+
+fun LocalDate.toDisplayString(): String = format(displayFormatter)
+
+fun ageInYears(dateOfBirth: String, today: LocalDate = LocalDate.now()): Int =
+    ChronoUnit.YEARS.between(dateOfBirth.toLocalDate(), today).toInt()
+
+/** Current gestational age in completed weeks, derived from the estimated due date. */
+fun currentWeeksPregnant(estimatedDueDate: String, today: LocalDate = LocalDate.now()): Int {
+    val conceptionDate = estimatedDueDate.toLocalDate().minusWeeks(FULL_TERM_WEEKS)
+    val weeks = ChronoUnit.WEEKS.between(conceptionDate, today)
+    return weeks.coerceIn(0, FULL_TERM_WEEKS).toInt()
+}
