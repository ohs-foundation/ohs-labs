+
+/**
+ * Tracks the active [QuestionnaireResponse.Item]s across the form so that either the top-bar Save
+ * action or the bottom-bar Submit button can construct the current [QuestionnaireResponse]
+ * without any input debounce delay.
+ */
+class AncFormStateHolder {
+  private val responseItemsByLinkId = LinkedHashMap<String, QuestionnaireResponse.Item>()
+
+  fun registerItem(viewItem: QuestionnaireViewItem) {
+    val linkId = viewItem.questionnaireItem.linkId.value ?: return
+    responseItemsByLinkId[linkId] = viewItem.getQuestionnaireResponseItem()
+  }
+
+  fun buildQuestionnaireResponse(): QuestionnaireResponse =
+    QuestionnaireResponse(
+      status = Enumeration(value = QuestionnaireResponse.QuestionnaireResponseStatus.Completed),
+      item = responseItemsByLinkId.values.toList(),
+    )
+}
+
+class CustomQuestionnaireMatchersProvider(
+  private val formStateHolder: AncFormStateHolder,
+) : QuestionnaireItemViewFactoryMatchersProvider {
+
+  override fun get(): List<QuestionnaireItemViewFactoryMatcher> =
+    listOf(
+      QuestionnaireItemViewFactoryMatcher(
+        factory = ImmediateGroupViewFactory(formStateHolder),
+        matches = { item -> item.type.value == Questionnaire.QuestionnaireItemType.Group },
+      ),
+      QuestionnaireItemViewFactoryMatcher(
+        factory = ImmediateDateViewFactory(formStateHolder),
+        matches = { item -> item.type.value == Questionnaire.QuestionnaireItemType.Date },
+      ),
+      QuestionnaireItemViewFactoryMatcher(
+        factory = ImmediateIntegerViewFactory(formStateHolder),
+        matches = { item -> item.type.value == Questionnaire.QuestionnaireItemType.Integer },
+      ),
+      QuestionnaireItemViewFactoryMatcher(
+        factory = ImmediateDecimalViewFactory(formStateHolder),
+        matches = { item -> item.type.value == Questionnaire.QuestionnaireItemType.Decimal },
+      ),
+      QuestionnaireItemViewFactoryMatcher(
+        factory = ImmediateChoiceViewFactory(formStateHolder),
+        matches = { item -> item.type.value == Questionnaire.QuestionnaireItemType.Choice },
+      ),
+      QuestionnaireItemViewFactoryMatcher(
+        factory = ImmediateTextViewFactory(formStateHolder),
+        matches = { item ->
+          item.type.value == Questionnaire.QuestionnaireItemType.Text ||
+            item.type.value == Questionnaire.QuestionnaireItemType.String
+        },
+      ),
+    )
+}
+
+private class ImmediateGroupViewFactory(
+  private val formStateHolder: AncFormStateHolder,
+) : QuestionnaireItemViewFactory {
+  @Composable
+  override fun Content(questionnaireViewItem: QuestionnaireViewItem) {
+    SideEffect { formStateHolder.registerItem(questionnaireViewItem) }
+    val labelText =
+      questionnaireViewItem.questionnaireItem.text?.value
+        ?: questionnaireViewItem.questionText?.text
+        ?: ""
+    if (labelText.isNotBlank()) {
+      Text(
+        text = labelText,
+        style = MaterialTheme.typography.titleSmall,
+        fontWeight = FontWeight.SemiBold,
+        color = MaterialTheme.colorScheme.primary,
+        modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 2.dp),
+      )
+    }
+  }
+}
+
+private class ImmediateDateViewFactory(
+  private val formStateHolder: AncFormStateHolder,
+) : QuestionnaireItemViewFactory {
+
+  @OptIn(ExperimentalMaterial3Api::class)
+  @Composable
+  override fun Content(questionnaireViewItem: QuestionnaireViewItem) {
+    SideEffect { formStateHolder.registerItem(questionnaireViewItem) }
+    val currentViewItem by rememberUpdatedState(questionnaireViewItem)
+    val coroutineScope = rememberCoroutineScope()
+    val focusManager = LocalFocusManager.current
+    val linkId = questionnaireViewItem.questionnaireItem.linkId.value ?: "visit-date"
+    val labelText =
+      questionnaireViewItem.questionnaireItem.text?.value
+        ?: questionnaireViewItem.questionText?.text
+        ?: "Visit date"
+
+    var textValue by
+      remember(linkId) {
+        val existingIso =
+          questionnaireViewItem.answers
+            .firstOrNull()
+            ?.value
+            ?.asDate()
+            ?.value
+            ?.value
+            ?.toString()
+            ?: (questionnaireViewItem.draftAnswer as? String)
+            ?: ""
+        mutableStateOf(existingIso)
+      }
+
+    var showDatePicker by remember(linkId) { mutableStateOf(false) }
+
+    val applyDateInput: (String) -> Unit = { rawInput ->
+      textValue = rawInput
+      val trimmed = rawInput.trim()
+      val parsedIso = parseFlexibleDateToIso(trimmed)
+      coroutineScope.launch(start = CoroutineStart.UNDISPATCHED) {
+        if (parsedIso != null) {
+          val fhirDate = FhirDate.fromString(parsedIso)
+          if (fhirDate != null) {
+            currentViewItem.setAnswer(
+              QuestionnaireResponse.Item.Answer(
+                value = QuestionnaireResponse.Item.Answer.Value.Date(Date(value = fhirDate))
+              )
+            )
+          }
+        } else if (trimmed.isEmpty()) {
+          currentViewItem.clearAnswer()
+        } else {
+          currentViewItem.setDraftAnswer(trimmed)
+        }
+      }
+    }
+
+    val isInvalid = questionnaireViewItem.validationResult is Invalid
+    val errorMsg =
+      (questionnaireViewItem.validationResult as? Invalid)?.singleStringValidationMessage
+
+    Column(
+      modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 2.dp),
+    ) {
+      Row(
+        modifier = Modifier.fillMaxWidth(),
+        verticalAlignment = Alignment.CenterVertically,
+      ) {
+        OutlinedTextField(
+          value = textValue,
+          onValueChange = applyDateInput,
+          label = { Text(labelText) },
+          placeholder = { Text("YYYY-MM-DD") },
+          singleLine = true,
+          isError = isInvalid,
+          supportingText =
+            if (isInvalid && !errorMsg.isNullOrBlank()) {
+              { Text(errorMsg) }
+            } else {
+              null
+            },
+          keyboardOptions = KeyboardOptions(imeAction = ImeAction.Done),
+          keyboardActions = KeyboardActions(onDone = { focusManager.clearFocus() }),
+          trailingIcon = {
+            IconButton(onClick = { showDatePicker = true }) {
+              Icon(
+                imageVector = Icons.Default.CalendarToday,
+                contentDescription = "Select date",
