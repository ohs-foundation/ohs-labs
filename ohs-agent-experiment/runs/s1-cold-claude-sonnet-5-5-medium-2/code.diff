+data class Patient(val id: Long, val name: String, val dob: LocalDate, val edd: LocalDate) {
+  val age get() = ChronoUnit.YEARS.between(dob, LocalDate.now())
+  // 40 weeks gestation at EDD
+  val weeks get() = ((280 - ChronoUnit.DAYS.between(LocalDate.now(), edd)) / 7).toInt()
+}
+
+data class Visit(
+  val date: LocalDate, val weeks: Int, val weight: Double, val sys: Int, val dia: Int,
+  val hb: Double?, val danger: String, val notes: String,
+)
+
+val DANGER_SIGNS = listOf("Vaginal bleeding", "Severe headache", "Blurred vision", "Fever")
+
+// ponytail: DB calls on the main thread; fine for clinic-sized data, move to a coroutine if it grows.
+class Db(ctx: Context) : SQLiteOpenHelper(ctx, "anc.db", null, 1) {
+  override fun onCreate(db: SQLiteDatabase) {
+    db.execSQL("CREATE TABLE patient(id INTEGER PRIMARY KEY, name TEXT, dob TEXT, edd TEXT)")
+    db.execSQL(
+      "CREATE TABLE visit(id INTEGER PRIMARY KEY, patient_id INTEGER, date TEXT, weeks INTEGER, " +
+        "weight REAL, sys INTEGER, dia INTEGER, hb REAL, danger TEXT, notes TEXT)"
+    )
+    // name, dob, edd, last visit, weeks at visit, weight, sys, dia, hb
+    listOf(
+      arrayOf<Any>("Emily Carter", "1996-04-12", "2026-12-05", "2026-08-10", 68.5, 118, 76, 11.8),
+      arrayOf<Any>("Sarah Mitchell", "1990-11-02", "2027-01-20", "2026-08-12", 61.2, 110, 70, 12.4),
+      arrayOf<Any>("Grace Thompson", "2001-07-30", "2026-10-15", "2026-08-05", 72.0, 128, 84, 10.2),
+    ).forEachIndexed { i, p ->
+      val id = i + 1L
+      db.execSQL("INSERT INTO patient VALUES(?,?,?,?)", arrayOf<Any?>(id, p[0], p[1], p[2]))
+      val wk = (280 - ChronoUnit.DAYS.between(LocalDate.parse(p[3] as String), LocalDate.parse(p[2] as String))) / 7
+      db.execSQL(
+        "INSERT INTO visit(patient_id,date,weeks,weight,sys,dia,hb,danger,notes) VALUES(?,?,?,?,?,?,?,'','')",
+        arrayOf<Any?>(id, p[3], wk, p[4], p[5], p[6], p[7]),
+      )
+    }
+  }
+
+  override fun onUpgrade(db: SQLiteDatabase, o: Int, n: Int) {}
+
+  fun patients(): List<Patient> =
+    readableDatabase.rawQuery("SELECT id,name,dob,edd FROM patient", null).use { c ->
+      buildList {
+        while (c.moveToNext()) add(Patient(c.getLong(0), c.getString(1), LocalDate.parse(c.getString(2)), LocalDate.parse(c.getString(3))))
+      }
+    }.sortedBy { it.edd }
+
+  fun visits(pid: Long): List<Visit> =
+    readableDatabase.rawQuery(
+      "SELECT date,weeks,weight,sys,dia,hb,danger,notes FROM visit WHERE patient_id=? ORDER BY date DESC, id DESC",
+      arrayOf(pid.toString()),
+    ).use { c ->
+      buildList {
+        while (c.moveToNext()) add(
+          Visit(LocalDate.parse(c.getString(0)), c.getInt(1), c.getDouble(2), c.getInt(3), c.getInt(4),
+            if (c.isNull(5)) null else c.getDouble(5), c.getString(6), c.getString(7))
+        )
+      }
+    }
+
+  fun addVisit(pid: Long, v: Visit) {
+    writableDatabase.insert("visit", null, ContentValues().apply {
+      put("patient_id", pid); put("date", v.date.toString()); put("weeks", v.weeks)
+      put("weight", v.weight); put("sys", v.sys); put("dia", v.dia)
+      put("danger", v.danger); put("notes", v.notes)
+    })
+  }
+}
 
