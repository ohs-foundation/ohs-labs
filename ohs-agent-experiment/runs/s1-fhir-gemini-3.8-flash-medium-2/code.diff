+package com.example.ancapp
+
+import com.example.ancapp.data.PatientInfo
+import org.junit.Assert.assertEquals
+import org.junit.Test
+import java.time.LocalDate
+
+class PatientCalculationTest {
+
+    @Test
+    fun testPatientCalculations() {
+        val emily = PatientInfo(
+            id = "anc-patient-1",
+            fullName = "Emily Carter",
+            birthDate = LocalDate.parse("1996-04-12"),
+            edd = LocalDate.parse("2026-12-05")
+        )
+        val sarah = PatientInfo(
+            id = "anc-patient-2",
+            fullName = "Sarah Mitchell",
+            birthDate = LocalDate.parse("1990-11-02"),
+            edd = LocalDate.parse("2027-01-20")
+        )
+        val grace = PatientInfo(
+            id = "anc-patient-3",
+            fullName = "Grace Thompson",
+            birthDate = LocalDate.parse("2001-07-30"),
+            edd = LocalDate.parse("2026-10-15")
+        )
+
+        val list = listOf(emily, sarah, grace).sortedWith(
+            compareBy<PatientInfo> { it.edd ?: LocalDate.MAX }
+                .thenBy { it.fullName }
+        )
+
+        // Sorted by soonest due date: Grace (2026-10-15), Emily (2026-12-05), Sarah (2027-01-20)
+        assertEquals("Grace Thompson", list[0].fullName)
+        assertEquals("Emily Carter", list[1].fullName)
+        assertEquals("Sarah Mitchell", list[2].fullName)
+    }
+}
