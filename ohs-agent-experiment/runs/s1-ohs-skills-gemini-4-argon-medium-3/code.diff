+package com.example.ancapp
+
+import android.app.Application
+import dev.ohs.fhir.datacapture.DataCapture
+import dev.ohs.fhir.engine.DatabaseErrorStrategy
+import dev.ohs.fhir.engine.FhirEngineConfiguration
+import dev.ohs.fhir.engine.FhirEngineProvider
+import dev.ohs.fhir.engine.ServerConfiguration
+
+class AncApplication : Application() {
+  override fun onCreate() {
+    super.onCreate()
+    FhirEngineProvider.init(
+      FhirEngineConfiguration(
+        databaseErrorStrategy = DatabaseErrorStrategy.RECREATE_AT_OPEN,
+        serverConfiguration = ServerConfiguration(baseUrl = "http://10.0.2.2:8080/fhir/"),
+      ),
+      this,
+    )
+    FhirEngineProvider.getInstance(this)
+    DataCapture.initialize(this)
+  }
+}
diff --git a/app/src/main/java/com/example/ancapp/AncViewModel.kt b/app/src/main/java/com/example/ancapp/AncViewModel.kt
new file mode 100644
index 0000000..9628c15
--- /dev/null
+++ b/app/src/main/java/com/example/ancapp/AncViewModel.kt
@@ -0,0 +1,783 @@
+package com.example.ancapp
+
+import android.app.Application
+import androidx.lifecycle.AndroidViewModel
+import androidx.lifecycle.viewModelScope
+import com.ionspin.kotlin.bignum.decimal.BigDecimal
+import dev.ohs.fhir.engine.FhirEngineProvider
+import dev.ohs.fhir.engine.get
+import dev.ohs.fhir.engine.search.Search
+import dev.ohs.fhir.engine.sync.CurrentSyncJobStatus
+import dev.ohs.fhir.engine.sync.Sync
+import dev.ohs.fhir.model.r4.Canonical
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.CodeableConcept
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.DateTime
+import dev.ohs.fhir.model.r4.Decimal
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Enumeration
+import dev.ohs.fhir.model.r4.FhirDateTime
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Patient
+import dev.ohs.fhir.model.r4.Period
+import dev.ohs.fhir.model.r4.Quantity
+import dev.ohs.fhir.model.r4.Questionnaire
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import dev.ohs.fhir.model.r4.Reference
+import dev.ohs.fhir.model.r4.Resource
+import dev.ohs.fhir.model.r4.String as FhirString
+import dev.ohs.fhir.model.r4.Uri
+import dev.ohs.fhir.model.r4.terminologies.ResourceType
+import java.time.LocalDate
+import java.time.Period as JavaPeriod
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.catch
+import kotlinx.coroutines.flow.transformWhile
+import kotlinx.coroutines.launch
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+
+data class PatientSummary(
+  val id: String,
+  val name: String,
+  val birthDate: LocalDate?,
+  val ageYears: Int?,
+  val dueDate: LocalDate?,
+  val pregnancyWeeks: Int?,
+)
+
+data class VisitSummary(
+  val encounterId: String,
+  val date: String,
+  val gestationalAgeWeeks: Int?,
+  val weight: String?,
+  val bloodPressure: String?,
+  val hemoglobin: String?,
+  val dangerSigns: List<String>,
+  val notes: String?,
+)
+
+data class AncUiState(
+  val patients: List<PatientSummary> = emptyList(),
+  val visitsByPatient: Map<String, List<VisitSummary>> = emptyMap(),
+  val questionnaireJson: String = AncViewModel.DEFAULT_ANC_QUESTIONNAIRE_JSON,
+  val syncStatus: String? = null,
+  val isSyncing: Boolean = false,
+)
+
+private fun CurrentSyncJobStatus.isFinal(): Boolean =
+  this is CurrentSyncJobStatus.Succeeded ||
+    this is CurrentSyncJobStatus.Failed ||
+    this is CurrentSyncJobStatus.Cancelled
+
+class AncViewModel(app: Application) : AndroidViewModel(app) {
+  private val engine = FhirEngineProvider.getInstance(app.applicationContext)
+  private val json = Json {
+    explicitNulls = false
+    encodeDefaults = false
+  }
+
+  private val _uiState = MutableStateFlow(AncUiState())
+  val uiState: StateFlow<AncUiState> = _uiState.asStateFlow()
+
+  private var syncJob: Job? = null
+
+  init {
+    viewModelScope.launch {
+      loadLocalData()
+      syncNow()
+    }
+  }
+
+  fun syncNow() {
+    if (syncJob?.isActive == true) return
+    syncJob =
+      viewModelScope.launch {
+        var ran = false
+        Sync.oneTimeSync<AppSyncWorker>(getApplication())
+          .transformWhile {
+            emit(it)
+            !it.isFinal()
+          }
+          .catch {
+            _uiState.value =
+              _uiState.value.copy(syncStatus = "Sync status unknown", isSyncing = false)
+            loadLocalData()
+          }
+          .collect { status ->
+            when (status) {
+              is CurrentSyncJobStatus.Enqueued -> {
+                _uiState.value =
+                  _uiState.value.copy(
+                    syncStatus = if (ran) "Waiting to retry" else "Waiting to sync",
+                    isSyncing = true,
+                  )
+              }
+              is CurrentSyncJobStatus.Running -> {
+                ran = true
+                _uiState.value = _uiState.value.copy(syncStatus = "Syncing…", isSyncing = true)
+                loadLocalData()
+              }
+              is CurrentSyncJobStatus.Succeeded -> {
+                _uiState.value = _uiState.value.copy(syncStatus = "Synced", isSyncing = false)
+                loadLocalData()
+              }
+              is CurrentSyncJobStatus.Failed -> {
+                _uiState.value =
+                  _uiState.value.copy(
+                    syncStatus = "Sync failed, using local data",
+                    isSyncing = false,
+                  )
+                loadLocalData()
+              }
+              else -> {
+                _uiState.value = _uiState.value.copy(isSyncing = false)
+                loadLocalData()
+              }
+            }
+          }
+      }
+  }
+
+  suspend fun loadLocalData() {
+    val patients = engine.search<Patient>(Search(ResourceType.Patient)).map { it.resource }
+    val encounters = engine.search<Encounter>(Search(ResourceType.Encounter)).map { it.resource }
+    val observations =
+      engine.search<Observation>(Search(ResourceType.Observation)).map { it.resource }
+
+    val questionnaireJson =
+      runCatching {
+          val q = engine.get<Questionnaire>("anc-contact")
+          json.encodeToString(q)
+        }
+        .getOrElse {
+          val fromSearch =
+            engine
+              .search<Questionnaire>(Search(ResourceType.Questionnaire))
+              .map { it.resource }
+              .firstOrNull { it.id == "anc-contact" || it.name?.value == "AncContact" }
+          if (fromSearch != null) json.encodeToString(fromSearch) else DEFAULT_ANC_QUESTIONNAIRE_JSON
+        }
+
+    val obsByPatient =
+      observations.groupBy { obs ->
+        obs.subject?.reference?.value?.substringAfter("Patient/") ?: ""
+      }
+
+    val encountersByPatient =
+      encounters.groupBy { enc ->
+        enc.subject?.reference?.value?.substringAfter("Patient/") ?: ""
+      }
+
+    val today = LocalDate.now()
+
+    val patientSummaries =
+      patients
+        .mapNotNull { patient ->
+          val patientId = patient.id ?: return@mapNotNull null
+          val humanName = patient.name.firstOrNull()
+          val fullName =
+            listOfNotNull(
+                humanName?.given?.mapNotNull { it.value }?.joinToString(" "),
+                humanName?.family?.value,
+              )
+              .filter { it.isNotBlank() }
+              .joinToString(" ")
+              .ifBlank { patientId }
+
+          val birthDate =
+            patient.birthDate?.value?.toString()?.let {
+              runCatching { LocalDate.parse(it.substringBefore("T")) }.getOrNull()
+            }
+          val ageYears = birthDate?.let { JavaPeriod.between(it, today).years }
+
+          val patientObs = obsByPatient[patientId].orEmpty()
+          val eddObs = patientObs.firstOrNull { it.hasCode(LOINC_EDD) }
+          val dueDate =
+            eddObs
+              ?.value
+              ?.asDateTime()
+              ?.value
+              ?.value
+              ?.toString()
+              ?.let { runCatching { LocalDate.parse(it.substringBefore("T")) }.getOrNull() }
+
+          val pregnancyWeeks =
+            dueDate?.let { edd ->
+              val lmp = edd.minusDays(280)
+              (ChronoUnit.DAYS.between(lmp, today) / 7).toInt()
+            }
+
+          PatientSummary(
+            id = patientId,
+            name = fullName,
+            birthDate = birthDate,
+            ageYears = ageYears,
+            dueDate = dueDate,
+            pregnancyWeeks = pregnancyWeeks,
+          )
+        }
+        .sortedWith(compareBy(nullsLast()) { it.dueDate })
+
+    val visitsByPatient = mutableMapOf<String, List<VisitSummary>>()
+    for (patient in patientSummaries) {
+      val patientEncounters = encountersByPatient[patient.id].orEmpty()
+      val patientObs = obsByPatient[patient.id].orEmpty()
+      val obsByEncounter =
+        patientObs.groupBy { obs ->
+          obs.encounter?.reference?.value?.substringAfter("Encounter/") ?: ""
+        }
+
+      val visits =
+        patientEncounters
+          .mapNotNull { enc ->
+            val encId = enc.id ?: return@mapNotNull null
+            val dateStr =
+              enc.period
+                ?.start
+                ?.value
+                ?.toString()
+                ?.substringBefore("T")
+                ?: obsByEncounter[encId]
+                  ?.firstOrNull()
+                  ?.effective
+                  ?.asDateTime()
+                  ?.value
+                  ?.value
+                  ?.toString()
+                  ?.substringBefore("T")
+                ?: return@mapNotNull null
+
+            val linkedObs = obsByEncounter[encId].orEmpty()
+
+            val weightObs = linkedObs.firstOrNull { it.hasCode(LOINC_WEIGHT) }
+            val weightStr =
+              weightObs?.value?.asQuantity()?.value?.let { qty ->
+                val num = qty.value?.value?.toPlainString()
+                val unit = qty.unit?.value ?: "kg"
+                if (num != null) "$num $unit" else null
+              }
+
+            val bpObs = linkedObs.firstOrNull { it.hasCode(LOINC_BP_PANEL) }
+            val systolic =
+              bpObs
+                ?.component
+                ?.firstOrNull { comp ->
+                  comp.code.coding.any { it.code?.value == LOINC_BP_SYSTOLIC }
+                }
+                ?.value
+                ?.asQuantity()
+                ?.value
+                ?.value
+                ?.value
+                ?.toPlainString()
+                ?.removeSuffix(".0")
+            val diastolic =
+              bpObs
+                ?.component
+                ?.firstOrNull { comp ->
+                  comp.code.coding.any { it.code?.value == LOINC_BP_DIASTOLIC }
+                }
+                ?.value
+                ?.asQuantity()
+                ?.value
+                ?.value
+                ?.value
+                ?.toPlainString()
+                ?.removeSuffix(".0")
+            val bpStr =
+              if (systolic != null && diastolic != null) {
+                "$systolic/$diastolic mmHg"
+              } else {
+                null
+              }
+
+            val hbObs = linkedObs.firstOrNull { it.hasCode(LOINC_HEMOGLOBIN) }
+            val hbStr =
+              hbObs?.value?.asQuantity()?.value?.let { qty ->
+                val num = qty.value?.value?.toPlainString()
+                val unit = qty.unit?.value ?: "g/dL"
+                if (num != null) "$num $unit" else null
+              }
+
+            val gaObs = linkedObs.firstOrNull { it.hasCode(LOINC_GESTATIONAL_AGE) }
+            val gaWeeks =
+              gaObs
+                ?.value
+                ?.asQuantity()
+                ?.value
+                ?.value
+                ?.value
+                ?.intValue(exactRequired = false)
+
+            val dangerObs = linkedObs.filter { it.hasCode(CODE_DANGER_SIGNS) }
+            val dangerSigns =
+              dangerObs
+                .flatMap { obs ->
+                  obs.value
+                    ?.asCodeableConcept()
+                    ?.value
+                    ?.coding
+                    ?.mapNotNull { it.display?.value ?: it.code?.value }
+                    .orEmpty()
+                }
+                .distinct()
+
+            val notesObs = linkedObs.firstOrNull { it.hasCode(LOINC_NOTES) }
+            val notesStr = notesObs?.value?.asString()?.value?.value
+
+            VisitSummary(
+              encounterId = encId,
+              date = dateStr,
+              gestationalAgeWeeks = gaWeeks,
+              weight = weightStr,
+              bloodPressure = bpStr,
+              hemoglobin = hbStr,
+              dangerSigns = dangerSigns,
+              notes = notesStr,
+            )
+          }
+          .sortedByDescending { it.date }
+
+      visitsByPatient[patient.id] = visits
+    }
+
+    _uiState.value =
+      _uiState.value.copy(
+        patients = patientSummaries,
+        visitsByPatient = visitsByPatient,
+        questionnaireJson = questionnaireJson,
+      )
+  }
+
+  suspend fun saveVisit(patientId: String, response: QuestionnaireResponse) {
+    val answers = mutableMapOf<String, MutableList<QuestionnaireResponse.Item.Answer>>()
+    fun collect(items: List<QuestionnaireResponse.Item>) {
+      items.forEach { item ->
+        item.linkId.value?.let { linkId ->
+          answers.getOrPut(linkId) { mutableListOf() }.addAll(item.answer)
+        }
+        collect(item.item)
+        item.answer.forEach { collect(it.item) }
+      }
+    }
+    collect(response.item)
+
+    val visitDateStr =
+      answers["visit-date"]?.firstOrNull()?.value?.asDate()?.value?.value?.toString()
+        ?: LocalDate.now().toString()
+
+    val gestationalAge =
+      answers["gestational-age"]?.firstOrNull()?.value?.asInteger()?.value?.value
+
+    val weightDecimal =
+      answers["weight"]?.firstOrNull()?.value?.let { valChoice ->
+        valChoice.asDecimal()?.value?.value
+          ?: valChoice.asInteger()?.value?.value?.let { BigDecimal.fromInt(it) }
+      }
+
+    val bpSystolic = answers["bp-systolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+    val bpDiastolic = answers["bp-diastolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+
+    val dangerCodings =
+      answers["danger-signs"].orEmpty().mapNotNull { it.value?.asCoding()?.value }
+
+    val notesText = answers["notes"]?.firstOrNull()?.value?.asString()?.value?.value
+
+    val encounterId = UUID.randomUUID().toString()
+    val patientRef = Reference(reference = FhirString(value = "Patient/$patientId"))
+    val encounterRef = Reference(reference = FhirString(value = "Encounter/$encounterId"))
+    val effectiveDateTime = DateTime(value = FhirDateTime.fromString(visitDateStr))
+
+    val encounter =
+      Encounter(
+        id = encounterId,
+        status = Enumeration(value = Encounter.EncounterStatus.Finished),
+        `class` =
+          Coding(
+            system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"),
+            code = Code(value = "AMB"),
+            display = FhirString(value = "ambulatory"),
+          ),
+        type = listOf(CodeableConcept(text = FhirString(value = "Antenatal care contact"))),
+        subject = patientRef,
+        period = Period(start = effectiveDateTime, end = effectiveDateTime),
+      )
+
+    val vitalSignsCategory =
+      listOf(
+        CodeableConcept(
+          coding =
+            listOf(
+              Coding(
+                system = Uri(value = "http://terminology.hl7.org/CodeSystem/observation-category"),
+                code = Code(value = "vital-signs"),
+                display = FhirString(value = "Vital Signs"),
+              )
+            )
+        )
+      )
+
+    val resourcesToCreate = mutableListOf<Resource>(encounter)
+
+    if (gestationalAge != null) {
+      resourcesToCreate +=
+        Observation(
+          id = UUID.randomUUID().toString(),
+          status = Enumeration(value = Observation.ObservationStatus.Final),
+          code =
+            CodeableConcept(
+              coding =
+                listOf(
+                  Coding(
+                    system = Uri(value = "http://loinc.org"),
+                    code = Code(value = LOINC_GESTATIONAL_AGE),
+                    display = FhirString(value = "Gestational age Estimated"),
+                  )
+                ),
+              text = FhirString(value = "Gestational age"),
+            ),
+          subject = patientRef,
+          encounter = encounterRef,
+          effective = Observation.Effective.DateTime(effectiveDateTime),
+          value =
+            Observation.Value.Quantity(
+              Quantity(
+                value = Decimal(value = BigDecimal.fromInt(gestationalAge)),
+                unit = FhirString(value = "wk"),
+                system = Uri(value = "http://unitsofmeasure.org"),
+                code = Code(value = "wk"),
+              )
+            ),
+        )
+    }
+
+    if (weightDecimal != null) {
+      resourcesToCreate +=
+        Observation(
+          id = UUID.randomUUID().toString(),
+          status = Enumeration(value = Observation.ObservationStatus.Final),
+          category = vitalSignsCategory,
+          code =
+            CodeableConcept(
+              coding =
+                listOf(
+                  Coding(
+                    system = Uri(value = "http://loinc.org"),
+                    code = Code(value = LOINC_WEIGHT),
+                    display = FhirString(value = "Body weight"),
+                  )
+                ),
+              text = FhirString(value = "Body weight"),
+            ),
+          subject = patientRef,
+          encounter = encounterRef,
+          effective = Observation.Effective.DateTime(effectiveDateTime),
+          value =
+            Observation.Value.Quantity(
+              Quantity(
+                value = Decimal(value = weightDecimal),
+                unit = FhirString(value = "kg"),
+                system = Uri(value = "http://unitsofmeasure.org"),
+                code = Code(value = "kg"),
+              )
+            ),
+        )
+    }
+
+    if (bpSystolic != null || bpDiastolic != null) {
+      val components = mutableListOf<Observation.Component>()
+      if (bpSystolic != null) {
+        components +=
+          Observation.Component(
+            code =
+              CodeableConcept(
+                coding =
+                  listOf(
+                    Coding(
+                      system = Uri(value = "http://loinc.org"),
+                      code = Code(value = LOINC_BP_SYSTOLIC),
+                      display = FhirString(value = "Systolic blood pressure"),
+                    )
+                  )
+              ),
+            value =
+              Observation.Component.Value.Quantity(
+                Quantity(
+                  value = Decimal(value = BigDecimal.fromInt(bpSystolic)),
+                  unit = FhirString(value = "mmHg"),
+                  system = Uri(value = "http://unitsofmeasure.org"),
+                  code = Code(value = "mm[Hg]"),
+                )
+              ),
+          )
+      }
+      if (bpDiastolic != null) {
+        components +=
+          Observation.Component(
+            code =
+              CodeableConcept(
+                coding =
+                  listOf(
+                    Coding(
+                      system = Uri(value = "http://loinc.org"),
+                      code = Code(value = LOINC_BP_DIASTOLIC),
+                      display = FhirString(value = "Diastolic blood pressure"),
+                    )
+                  )
+              ),
+            value =
+              Observation.Component.Value.Quantity(
+                Quantity(
+                  value = Decimal(value = BigDecimal.fromInt(bpDiastolic)),
+                  unit = FhirString(value = "mmHg"),
+                  system = Uri(value = "http://unitsofmeasure.org"),
+                  code = Code(value = "mm[Hg]"),
+                )
+              ),
+          )
+      }
+      resourcesToCreate +=
+        Observation(
+          id = UUID.randomUUID().toString(),
+          status = Enumeration(value = Observation.ObservationStatus.Final),
+          category = vitalSignsCategory,
+          code =
+            CodeableConcept(
+              coding =
+                listOf(
+                  Coding(
+                    system = Uri(value = "http://loinc.org"),
+                    code = Code(value = LOINC_BP_PANEL),
+                    display =
+                      FhirString(value = "Blood pressure panel with all children optional"),
+                  )
+                ),
+              text = FhirString(value = "Blood pressure"),
+            ),
+          subject = patientRef,
+          encounter = encounterRef,
+          effective = Observation.Effective.DateTime(effectiveDateTime),
+          component = components,
+        )
+    }
+
+    if (dangerCodings.isNotEmpty()) {
+      resourcesToCreate +=
+        Observation(
+          id = UUID.randomUUID().toString(),
+          status = Enumeration(value = Observation.ObservationStatus.Final),
+          code =
+            CodeableConcept(
+              coding =
+                listOf(
+                  Coding(
+                    system = Uri(value = "urn:example:anc-danger-signs"),
+                    code = Code(value = CODE_DANGER_SIGNS),
+                    display = FhirString(value = "Danger signs present"),
+                  )
+                ),
+              text = FhirString(value = "Danger signs present"),
+            ),
+          subject = patientRef,
+          encounter = encounterRef,
+          effective = Observation.Effective.DateTime(effectiveDateTime),
+          value =
+            Observation.Value.CodeableConcept(
+              CodeableConcept(
+                coding = dangerCodings,
+                text =
+                  FhirString(
+                    value =
+                      dangerCodings.mapNotNull { it.display?.value ?: it.code?.value }
+                        .joinToString(", ")
+                  ),
+              )
+            ),
+        )
+    }
+
+    if (!notesText.isNullOrBlank()) {
+      resourcesToCreate +=
+        Observation(
+          id = UUID.randomUUID().toString(),
+          status = Enumeration(value = Observation.ObservationStatus.Final),
+          code =
+            CodeableConcept(
+              coding =
+                listOf(
+                  Coding(
+                    system = Uri(value = "http://loinc.org"),
+                    code = Code(value = LOINC_NOTES),
+                    display = FhirString(value = "Annotation comment"),
+                  )
+                ),
+              text = FhirString(value = "Notes"),
+            ),
+          subject = patientRef,
+          encounter = encounterRef,
+          effective = Observation.Effective.DateTime(effectiveDateTime),
+          value = Observation.Value.String(FhirString(value = notesText.trim())),
+        )
+    }
+
+    val completedResponse =
+      response
+        .toBuilder()
+        .apply {
+          id = UUID.randomUUID().toString()
+          status = Enumeration(value = QuestionnaireResponse.QuestionnaireResponseStatus.Completed)
+          subject = patientRef.toBuilder()
+          this.encounter = encounterRef.toBuilder()
+          authored = effectiveDateTime.toBuilder()
+          questionnaire =
+            Canonical(value = "http://example.org/fhir/Questionnaire/anc-contact").toBuilder()
+        }
+        .build()
+
+    resourcesToCreate += completedResponse
+
+    engine.create(*resourcesToCreate.toTypedArray())
+    loadLocalData()
+    syncNow()
+  }
+
+  private fun Observation.hasCode(targetCode: String): Boolean =
+    code.coding.any { it.code?.value == targetCode }
