+/** Runs [block] off the main thread and exposes the result (or error message). */
+@Composable
+fun <T> rememberLoad(key: Any?, block: () -> T): Triple<T?, String?, () -> Unit> {
+  var attempt by remember { mutableIntStateOf(0) }
+  var value by remember(key) { mutableStateOf<T?>(null) }
+  var err by remember(key) { mutableStateOf<String?>(null) }
+  LaunchedEffect(key, attempt) {
+    err = null
+    try { value = withContext(Dispatchers.IO) { block() } } catch (e: Exception) { err = e.message ?: e.toString() }
+  }
+  return Triple(value, err) { value = null; attempt++ }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun App() {
+  var selected by remember { mutableStateOf<Patient?>(null) }
+  var recording by remember { mutableStateOf(false) }
+  var saved by remember { mutableIntStateOf(0) } // bumps to refetch visits after a save
+  val (patients, error, reload) = rememberLoad(Unit) { loadPatients() }
+  BackHandler(selected != null) { if (recording) recording = false else selected = null }
+  val title = when { recording -> "New ANC visit"; selected != null -> selected!!.name; else -> "ANC Register" }
+  Scaffold(topBar = {
+    TopAppBar(title = { Text(title) }, navigationIcon = {
+      if (selected != null) TextButton(onClick = { if (recording) recording = false else selected = null }) { Text("Back") }
+    })
+  }) { pad ->
+    Box(Modifier.padding(pad).fillMaxSize()) {
+      val p = selected
+      when {
+        p != null && recording -> VisitForm(p, onDone = { saved++; recording = false })
+        p != null -> Detail(p, saved, onRecord = { recording = true })
+        patients != null -> Register(patients) { selected = it }
+        error != null -> ErrorView(error, reload)
+        else -> CircularProgressIndicator(Modifier.align(Alignment.Center))
+      }
+    }
+  }
+}
+
+@Composable
+fun ErrorView(msg: String, retry: () -> Unit) = Column(Modifier.padding(16.dp)) {
+  Text("Could not reach the FHIR server:\n$msg", color = MaterialTheme.colorScheme.error)
+  Button(onClick = retry) { Text("Retry") }
+}
+
+@Composable
+fun Register(patients: List<Patient>, onOpen: (Patient) -> Unit) {
+  if (patients.isEmpty()) Text("No patients on the register.", Modifier.padding(16.dp))
+  LazyColumn {
+    items(patients) { p ->
+      Column(Modifier.fillMaxWidth().clickable { onOpen(p) }.padding(16.dp, 12.dp)) {
+        Text(p.name, style = MaterialTheme.typography.titleMedium)
+        Text("Age ${p.age} · Due ${p.edd ?: "unknown"} · ${p.weeks?.let { "$it weeks" } ?: "weeks unknown"}")
+      }
+      HorizontalDivider()
+    }
+  }
+}
+
+@Composable
+fun Detail(p: Patient, saved: Int, onRecord: () -> Unit) {
+  val (visits, error, reload) = rememberLoad(p.id to saved) { loadVisits(p.id) }
+  Column(Modifier.fillMaxSize()) {
+    Column(Modifier.padding(16.dp)) {
+      Text("Age ${p.age} · Due ${p.edd ?: "unknown"} · ${p.weeks?.let { "$it weeks" } ?: ""}")
+      Button(onClick = onRecord, Modifier.padding(top = 8.dp)) { Text("Record new ANC visit") }
+    }
+    HorizontalDivider()
+    when {
+      visits != null -> {
+        if (visits.isEmpty()) Text("No visits recorded yet.", Modifier.padding(16.dp))
+        LazyColumn {
+          items(visits) { v ->
+            Column(Modifier.fillMaxWidth().padding(16.dp, 10.dp)) {
+              Text(v.date + (v.weeks?.let { " · $it weeks" } ?: ""), style = MaterialTheme.typography.titleMedium)
+              Text("Weight: ${v.weight ?: "—"}")
+              Text("BP: ${v.bp ?: "—"}")
+              v.hb?.let { Text("Hemoglobin: $it") }
+              v.dangerSigns?.let { Text("Danger signs: $it", color = MaterialTheme.colorScheme.error) }
+              v.notes?.let { Text("Notes: $it") }
+            }
+            HorizontalDivider()
+          }
+        }
+      }
+      error != null -> ErrorView(error, reload)
+      else -> Box(Modifier.fillMaxSize()) { CircularProgressIndicator(Modifier.align(Alignment.Center)) }
+    }
+  }
+}
+
+@Composable
+fun VisitForm(p: Patient, onDone: () -> Unit) {
+  val (form, loadError, reload) = rememberLoad(Unit) { parseItems(get("Questionnaire/anc-contact").getJSONArray("item")) }
+  val text = remember { mutableStateMapOf("visit-date" to LocalDate.now().toString()) }
+  val choices = remember { mutableStateMapOf<String, Set<String>>() }
+  var error by remember { mutableStateOf<String?>(null) }
+  var saving by remember { mutableStateOf(false) }
+  val scope = rememberCoroutineScope()
+
+  if (form == null) {
+    if (loadError != null) ErrorView(loadError, reload) else Box(Modifier.fillMaxSize()) { CircularProgressIndicator(Modifier.align(Alignment.Center)) }
+    return
+  }
+
+  fun flat(qs: List<Q>): List<Q> = qs.flatMap { if (it.type == "group") flat(it.children) else listOf(it) }
+  fun validate(): String? {
+    for (q in flat(form)) {
+      val v = text[q.linkId]?.trim().orEmpty()
+      if (v.isEmpty()) { if (q.required) return "${q.text} is required"; continue }
+      when (q.type) {
+        "date" -> try { LocalDate.parse(v) } catch (e: DateTimeParseException) { return "${q.text}: use YYYY-MM-DD" }
+        "integer" -> if (v.toIntOrNull() == null) return "${q.text}: whole number expected"
+        "decimal" -> if (v.toDoubleOrNull() == null) return "${q.text}: number expected"
+      }
+    }
+    if (text["bp-systolic"].isNullOrBlank() != text["bp-diastolic"].isNullOrBlank()) return "Enter both systolic and diastolic pressure"
+    return null
+  }
+
+  @Composable
+  fun Render(qs: List<Q>) {
+    for (q in qs) when (q.type) {
+      "group" -> { Text(q.text, style = MaterialTheme.typography.titleSmall, modifier = Modifier.padding(top = 12.dp)); Render(q.children) }
+      "choice" -> {
+        Text(q.text, style = MaterialTheme.typography.titleSmall, modifier = Modifier.padding(top = 12.dp))
+        for ((coding, label) in q.options) {
+          val code = coding.getString("code")
+          val on = code in choices[q.linkId].orEmpty()
+          Row(Modifier.fillMaxWidth().clickable {
+            val cur = choices[q.linkId].orEmpty()
+            // "none" excludes the real danger signs and vice versa
+            choices[q.linkId] = when {
+              on -> cur - code
+              code == "none" -> setOf("none")
+              else -> cur - "none" + code
+            }
+          }, verticalAlignment = Alignment.CenterVertically) {
+            Checkbox(checked = on, onCheckedChange = null, modifier = Modifier.padding(end = 8.dp))
+            Text(label)
+          }
+        }
+      }
+      else -> OutlinedTextField(
+        value = text[q.linkId].orEmpty(), onValueChange = { text[q.linkId] = it },
+        label = { Text(q.text + if (q.required) " *" else "") },
+        singleLine = q.type != "text", minLines = if (q.type == "text") 3 else 1,
+        modifier = Modifier.fillMaxWidth().padding(top = 8.dp),
+      )
+    }
+  }
+
+  Column(Modifier.fillMaxSize().verticalScroll(rememberScrollState()).padding(16.dp)) {
+    Render(form)
+    error?.let { Text(it, color = MaterialTheme.colorScheme.error, modifier = Modifier.padding(top = 8.dp)) }
+    Button(enabled = !saving, modifier = Modifier.padding(top = 16.dp), onClick = {
+      error = validate()
+      if (error == null) {
+        saving = true
+        scope.launch {
+          try {
+            withContext(Dispatchers.IO) { saveVisit(p.id, form, text.toMap(), choices.toMap()) }
+            onDone()
+          } catch (e: Exception) { android.util.Log.e("ANC", "save", e); error = "Save failed: ${e.message}" }
+          saving = false
+        }
+      }
+    }) { Text(if (saving) "Saving…" else "Save visit") }
   }
