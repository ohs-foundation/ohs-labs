+package com.example.ancapp.data.model
+
+import java.time.LocalDate
+import java.time.format.DateTimeFormatter
+import java.time.temporal.ChronoUnit
+
+data class PatientItem(
+    val id: String,
+    val name: String,
+    val birthDate: String,
+    val age: Int,
+    val estimatedDueDate: String,
+    val gestationalWeeks: Int,
+    val gestationalDays: Int
+) {
+    companion object {
+        fun create(
+            id: String,
+            name: String,
+            birthDateStr: String,
+            eddStr: String,
+            referenceDate: LocalDate = LocalDate.now()
+        ): PatientItem {
+            val birthDate = try {
+                LocalDate.parse(birthDateStr.take(10))
+            } catch (e: Exception) {
+                LocalDate.of(2000, 1, 1)
+            }
+            val age = ChronoUnit.YEARS.between(birthDate, referenceDate).toInt()
+
+            val edd = try {
+                LocalDate.parse(eddStr.take(10))
+            } catch (e: Exception) {
+                referenceDate.plusDays(40 * 7)
+            }
+            val daysRemaining = ChronoUnit.DAYS.between(referenceDate, edd)
+            val gestationalDays = (280 - daysRemaining).coerceAtLeast(0).toInt()
+            val gestationalWeeks = gestationalDays / 7
+
+            return PatientItem(
+                id = id,
+                name = name,
+                birthDate = birthDateStr,
+                age = age,
+                estimatedDueDate = eddStr.take(10),
+                gestationalWeeks = gestationalWeeks,
+                gestationalDays = gestationalDays
+            )
+        }
+    }
+}
