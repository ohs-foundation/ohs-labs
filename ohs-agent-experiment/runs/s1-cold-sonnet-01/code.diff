+package com.example.ancapp.ui
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.collectAsState
+import androidx.compose.runtime.getValue
+import androidx.navigation.NavType
+import androidx.navigation.compose.NavHost
+import androidx.navigation.compose.composable
+import androidx.navigation.compose.rememberNavController
+import androidx.navigation.navArgument
+import com.example.ancapp.ui.addvisit.AddVisitScreen
+import com.example.ancapp.ui.detail.PatientDetailScreen
+import com.example.ancapp.ui.register.RegisterScreen
+
+private object Routes {
+    const val REGISTER = "register"
+    const val PATIENT_DETAIL = "patient/{patientId}"
+    const val ADD_VISIT = "patient/{patientId}/addVisit"
+
+    fun patientDetail(patientId: String) = "patient/$patientId"
+    fun addVisit(patientId: String) = "patient/$patientId/addVisit"
+}
+
+@Composable
+fun AncNavHost(viewModel: AncViewModel) {
+    val navController = rememberNavController()
+    val patients by viewModel.patients.collectAsState()
+
+    NavHost(navController = navController, startDestination = Routes.REGISTER) {
+        composable(Routes.REGISTER) {
+            RegisterScreen(
+                patients = patients,
+                onPatientClick = { patient -> navController.navigate(Routes.patientDetail(patient.id)) },
+            )
+        }
+        composable(
+            Routes.PATIENT_DETAIL,
+            arguments = listOf(navArgument("patientId") { type = NavType.StringType }),
+        ) { backStackEntry ->
+            val patientId = backStackEntry.arguments?.getString("patientId").orEmpty()
+            val patient = patients.find { it.id == patientId }
+            if (patient != null) {
+                PatientDetailScreen(
+                    patient = patient,
+                    onBack = { navController.popBackStack() },
+                    onAddVisit = { navController.navigate(Routes.addVisit(patientId)) },
+                )
+            }
+        }
+        composable(
+            Routes.ADD_VISIT,
+            arguments = listOf(navArgument("patientId") { type = NavType.StringType }),
+        ) { backStackEntry ->
+            val patientId = backStackEntry.arguments?.getString("patientId").orEmpty()
+            AddVisitScreen(
+                onBack = { navController.popBackStack() },
+                onSave = { visit ->
+                    viewModel.addVisit(patientId, visit)
+                    navController.popBackStack()
+                },
+            )
+        }
+    }
+}
