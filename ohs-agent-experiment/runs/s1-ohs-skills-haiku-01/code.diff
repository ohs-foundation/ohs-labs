@@ -0,0 +1,241 @@
+package com.example.ancapp.ui
+
+import android.content.Context
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.example.ancapp.data.FhirRepository
+import com.ionspin.kotlin.bignum.decimal.BigDecimal
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.CodeableConcept
+import dev.ohs.fhir.model.r4.DateTime
+import dev.ohs.fhir.model.r4.Decimal
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Enumeration
+import dev.ohs.fhir.model.r4.FhirDateTime
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Period
+import dev.ohs.fhir.model.r4.Quantity
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import dev.ohs.fhir.model.r4.Reference
+import dev.ohs.fhir.model.r4.Uri
+import dev.ohs.fhir.model.r4.String as FhirString
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+import java.time.LocalDate
+import java.util.UUID
+
+class NewVisitViewModel(context: Context) : ViewModel() {
+  private val repository = FhirRepository(context)
+
+  private val _questionnaireJson = MutableStateFlow<String?>(null)
+  val questionnaireJson = _questionnaireJson.asStateFlow()
+
+  private val _isSaving = MutableStateFlow(false)
+  val isSaving = _isSaving.asStateFlow()
+
+  private val _saveSuccess = MutableStateFlow(false)
+  val saveSuccess = _saveSuccess.asStateFlow()
+
+  init {
+    loadQuestionnaire()
+  }
+
+  private fun loadQuestionnaire() {
+    viewModelScope.launch {
+      try {
+        val json = repository.getQuestionnaireJson("anc-contact")
+        _questionnaireJson.value = json
+      } catch (e: Exception) {
+        e.printStackTrace()
+      }
+    }
+  }
+
+  fun saveVisit(patientId: String, response: QuestionnaireResponse) {
+    viewModelScope.launch {
+      _isSaving.value = true
+      _saveSuccess.value = false
+      try {
+        val encounterId = UUID.randomUUID().toString()
+        val now = LocalDate.now()
+
+        val encounter = Encounter(
+          id = encounterId,
+          status = Enumeration(value = Encounter.EncounterStatus.Finished),
+          `class` = Coding(
+            system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"),
+            code = Code(value = "AMB"),
+            display = FhirString(value = "Ambulatory"),
+          ),
+          subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+          period = Period(
+            start = DateTime(value = FhirDateTime.fromString(now.toString())),
+          ),
+        )
+
+        val observations = mutableListOf<Observation>()
+        val answers = extractAnswers(response)
+
+        answers["weight"]?.firstOrNull()?.value?.asDecimal()?.value?.value?.let { weight ->
+          observations.add(
+            createObservation(
+              encounterId,
+              patientId,
+              "29463-7",
+              "Body weight",
+              weight,
+              "kg",
+            )
+          )
+        }
+
+        var systolic: Int? = null
+        var diastolic: Int? = null
+
+        answers["systolic-bp"]?.firstOrNull()?.value?.asInteger()?.value?.value?.let { s ->
+          systolic = s
+        }
+
+        answers["diastolic-bp"]?.firstOrNull()?.value?.asInteger()?.value?.value?.let { d ->
+          diastolic = d
+        }
+
+        if (systolic != null || diastolic != null) {
+          observations.add(createBpObservation(encounterId, patientId, systolic, diastolic))
+        }
+
+        repository.saveEncounterAndObservations(encounter, observations)
+        repository.syncData()
+        _saveSuccess.value = true
+      } catch (e: Exception) {
+        e.printStackTrace()
+      } finally {
+        _isSaving.value = false
+      }
+    }
+  }
+
+  private fun extractAnswers(
+    response: QuestionnaireResponse
+  ): Map<String, List<QuestionnaireResponse.Item.Answer>> {
+    val answers = mutableMapOf<String, MutableList<QuestionnaireResponse.Item.Answer>>()
+    fun collect(items: List<QuestionnaireResponse.Item>) {
+      items.forEach { item ->
+        item.linkId.value?.let { linkId ->
+          answers.getOrPut(linkId) { mutableListOf() }.addAll(item.answer)
+        }
+        collect(item.item)
+        item.answer.forEach { collect(it.item) }
+      }
+    }
+    collect(response.item)
+    return answers
+  }
+
+  private fun createObservation(
+    encounterId: String,
+    patientId: String,
+    code: String,
+    display: String,
+    value: BigDecimal,
+    unit: String,
+  ): Observation {
+    return Observation(
+      id = UUID.randomUUID().toString(),
+      status = Enumeration(value = Observation.ObservationStatus.Final),
+      code = CodeableConcept(
+        coding = listOf(
+          Coding(
+            system = Uri(value = "http://loinc.org"),
+            code = Code(value = code),
+            display = FhirString(value = display),
+          )
+        ),
+      ),
+      subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+      encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")),
+      value = Observation.Value.Quantity(
+        Quantity(
+          value = Decimal(value = value),
+          unit = FhirString(value = unit),
+          system = Uri(value = "http://unitsofmeasure.org"),
+          code = Code(value = unit),
+        )
+      ),
+    )
+  }
+
+  private fun createBpObservation(
+    encounterId: String,
+    patientId: String,
+    systolic: Int?,
+    diastolic: Int?,
+  ): Observation {
+    val components = mutableListOf<Observation.Component>()
+    systolic?.let {
+      components.add(
+        Observation.Component(
+          code = CodeableConcept(
+            coding = listOf(
+              Coding(
+                system = Uri(value = "http://loinc.org"),
+                code = Code(value = "8480-6"),
+                display = FhirString(value = "Systolic blood pressure"),
+              )
+            ),
+          ),
+          value = Observation.Component.Value.Quantity(
+            Quantity(
+              value = Decimal(value = BigDecimal.fromInt(it)),
+              unit = FhirString(value = "mmHg"),
+              system = Uri(value = "http://unitsofmeasure.org"),
+              code = Code(value = "mm[Hg]"),
+            )
+          ),
+        )
+      )
+    }
+    diastolic?.let {
+      components.add(
+        Observation.Component(
+          code = CodeableConcept(
+            coding = listOf(
+              Coding(
+                system = Uri(value = "http://loinc.org"),
+                code = Code(value = "8462-4"),
+                display = FhirString(value = "Diastolic blood pressure"),
+              )
+            ),
+          ),
+          value = Observation.Component.Value.Quantity(
+            Quantity(
+              value = Decimal(value = BigDecimal.fromInt(it)),
+              unit = FhirString(value = "mmHg"),
+              system = Uri(value = "http://unitsofmeasure.org"),
+              code = Code(value = "mm[Hg]"),
+            )
+          ),
+        )
+      )
+    }
+
+    return Observation(
+      id = UUID.randomUUID().toString(),
+      status = Enumeration(value = Observation.ObservationStatus.Final),
+      code = CodeableConcept(
+        coding = listOf(
+          Coding(
+            system = Uri(value = "http://loinc.org"),
+            code = Code(value = "85354-9"),
+            display = FhirString(value = "Blood pressure panel with all children optional"),
+          )
+        ),
+      ),
+      subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+      encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")),
+      component = components,
+    )
+  }
+}
