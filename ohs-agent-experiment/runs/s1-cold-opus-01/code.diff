+package com.example.ancapp
+
+import com.example.ancapp.domain.Gestation
+import com.example.ancapp.domain.ageOn
+import org.junit.Assert.assertEquals
+import org.junit.Test
+import java.time.LocalDate
+
+class GestationTest {
+
+  private val emilyDueDate = LocalDate.of(2026, 12, 5)
+
+  @Test
+  fun `gestational age is zero at the notional LMP`() {
+    val lmp = emilyDueDate.minusDays(280)
+    assertEquals(0, Gestation.weeksOn(emilyDueDate, lmp))
+  }
+
+  @Test
+  fun `gestational age is 40 weeks on the due date`() {
+    assertEquals(40, Gestation.weeksOn(emilyDueDate, emilyDueDate))
+  }
+
+  @Test
+  fun `gestational age counts completed weeks and days`() {
+    // 2026-08-10 is 117 days before the due date, i.e. 163 days of gestation.
+    assertEquals("23w 2d", Gestation.format(emilyDueDate, LocalDate.of(2026, 8, 10)))
+    assertEquals(23, Gestation.weeksOn(emilyDueDate, LocalDate.of(2026, 8, 10)))
+  }
+
+  @Test
+  fun `gestational age never goes negative before conception`() {
+    assertEquals(0, Gestation.weeksOn(emilyDueDate, emilyDueDate.minusYears(1)))
+    assertEquals(0f, Gestation.progressOn(emilyDueDate, emilyDueDate.minusYears(1)), 0f)
+  }
+
+  @Test
+  fun `progress is capped at one past term`() {
+    assertEquals(1f, Gestation.progressOn(emilyDueDate, emilyDueDate.plusWeeks(3)), 0f)
+  }
+
+  @Test
+  fun `age is in completed years`() {
+    val dob = LocalDate.of(1996, 4, 12)
+    assertEquals(29, ageOn(dob, LocalDate.of(2026, 4, 11)))
+    assertEquals(30, ageOn(dob, LocalDate.of(2026, 4, 12)))
+  }
+}
