+++ b/app/src/main/java/com/example/ancapp/data/Models.kt
@@ -0,0 +1,32 @@
+package com.example.ancapp.data
+
+import java.math.BigDecimal
+import java.time.LocalDate
+
+data class PatientSummary(
+  val id: String,
+  val name: String,
+  val age: Int,
+  val dueDate: LocalDate?,
+  val gestationalAgeWeeks: Int?,
+)
+
+data class VisitSummary(
+  val encounterId: String,
+  val date: LocalDate,
+  val gestationalAgeWeeks: Int?,
+  val weightKg: BigDecimal?,
+  val systolic: Int?,
+  val diastolic: Int?,
+  val hemoglobin: BigDecimal?,
+  val dangerSigns: List<String>,
+  val notes: String?,
+)
+
+enum class DangerSign(val code: String, val display: String) {
+  NONE("none", "None"),
+  VAGINAL_BLEEDING("vaginal-bleeding", "Vaginal bleeding"),
