+package com.example.ancapp.navigation
+
+import androidx.compose.runtime.Composable
+import androidx.lifecycle.viewmodel.compose.viewModel
+import androidx.navigation.NavHostController
+import androidx.navigation.NavType
+import androidx.navigation.compose.NavHost
+import androidx.navigation.compose.composable
+import androidx.navigation.compose.rememberNavController
+import androidx.navigation.navArgument
+import com.example.ancapp.data.AncRepository
+import com.example.ancapp.ui.PatientDetailScreen
+import com.example.ancapp.ui.PatientDetailViewModel
+import com.example.ancapp.ui.RegisterScreen
+import com.example.ancapp.ui.RegisterViewModel
+import com.example.ancapp.ui.VisitFormScreen
+import com.example.ancapp.ui.VisitFormViewModel
+
+sealed class Route(val route: String) {
+    object Register : Route("register")
+    object PatientDetail : Route("patient/{patientId}") {
+        fun createRoute(patientId: Long) = "patient/$patientId"
+    }
+    object VisitForm : Route("visit_form/{patientId}") {
+        fun createRoute(patientId: Long) = "visit_form/$patientId"
+    }
+}
+
+@Composable
+fun AncNavigation(repository: AncRepository) {
+    val navController = rememberNavController()
+
+    NavHost(navController = navController, startDestination = Route.Register.route) {
+        composable(Route.Register.route) {
+            val viewModel: RegisterViewModel = viewModel(factory = object : androidx.lifecycle.ViewModelProvider.Factory {
+                override fun <T : androidx.lifecycle.ViewModel> create(modelClass: Class<T>): T {
+                    @Suppress("UNCHECKED_CAST")
+                    return RegisterViewModel(repository) as T
+                }
+            })
+            RegisterScreen(viewModel = viewModel) { patientId ->
+                navController.navigate(Route.PatientDetail.createRoute(patientId))
+            }
+        }
+
+        composable(
+            Route.PatientDetail.route,
+            arguments = listOf(navArgument("patientId") { type = NavType.LongType })
+        ) { backStackEntry ->
+            val patientId = backStackEntry.arguments?.getLong("patientId") ?: return@composable
+            val viewModel: PatientDetailViewModel = viewModel(factory = object : androidx.lifecycle.ViewModelProvider.Factory {
+                override fun <T : androidx.lifecycle.ViewModel> create(modelClass: Class<T>): T {
+                    @Suppress("UNCHECKED_CAST")
+                    return PatientDetailViewModel(repository, patientId) as T
+                }
+            })
+            PatientDetailScreen(
+                viewModel = viewModel,
+                onBackClick = { navController.popBackStack() },
+                onAddVisitClick = { navController.navigate(Route.VisitForm.createRoute(patientId)) }
+            )
+        }
+
+        composable(
+            Route.VisitForm.route,
+            arguments = listOf(navArgument("patientId") { type = NavType.LongType })
+        ) { backStackEntry ->
+            val patientId = backStackEntry.arguments?.getLong("patientId") ?: return@composable
+            val viewModel: VisitFormViewModel = viewModel(factory = object : androidx.lifecycle.ViewModelProvider.Factory {
+                override fun <T : androidx.lifecycle.ViewModel> create(modelClass: Class<T>): T {
+                    @Suppress("UNCHECKED_CAST")
+                    return VisitFormViewModel(repository, patientId) as T
+                }
+            })
+            VisitFormScreen(
+                viewModel = viewModel,
+                onBackClick = { navController.popBackStack() },
+                onSaveSuccess = { navController.popBackStack() }
+            )
+        }
+    }
+}
