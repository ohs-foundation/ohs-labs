+import androidx.compose.foundation.clickable
+import androidx.compose.foundation.layout.*
+import androidx.compose.foundation.lazy.LazyColumn
+import androidx.compose.foundation.lazy.items
+import androidx.compose.material3.*
+import androidx.compose.runtime.*
+import androidx.compose.runtime.saveable.rememberSaveable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+import dev.ohs.fhir.datacapture.DataCapture
+import dev.ohs.fhir.datacapture.Questionnaire
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
 
 class MainActivity : ComponentActivity() {
   override fun onCreate(savedInstanceState: Bundle?) {
     super.onCreate(savedInstanceState)
-    setContent { MaterialTheme { Surface { Text("Hello") } } }
+    DataCapture.initialize(applicationContext)
+    setContent { MaterialTheme { Surface(Modifier.fillMaxSize()) { App() } } }
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun App() {
+  var patients by remember { mutableStateOf<List<Patient>?>(null) }
+  var error by remember { mutableStateOf<String?>(null) }
+  var reload by remember { mutableIntStateOf(0) }
+  var selectedId by rememberSaveable { mutableStateOf<String?>(null) }
+  var form by rememberSaveable { mutableStateOf(false) }
+
+  LaunchedEffect(reload) {
+    runCatching { withContext(Dispatchers.IO) { loadPatients() } }
+      .onSuccess { patients = it; error = null }.onFailure { error = it.message }
+  }
+  val selected = patients?.firstOrNull { it.id == selectedId }
+  BackHandler(selected != null) { if (form) form = false else selectedId = null }
+
+  Scaffold(topBar = { TopAppBar(title = { Text(selected?.name ?: "ANC Register") }) }) { pad ->
+    Box(Modifier.padding(pad).fillMaxSize()) {
+      when {
+        error != null -> Column(Modifier.padding(16.dp)) {
+          Text("Cannot reach FHIR server: $error")
+          Button({ reload++ }) { Text("Retry") }
+        }
+        patients == null -> CircularProgressIndicator(Modifier.padding(16.dp))
+        selected == null -> Register(patients!!) { selectedId = it.id }
+        form -> VisitForm(selected) { saved -> form = false; if (saved) reload++ }
+        else -> Detail(selected) { form = true }
+      }
+    }
+  }
+}
+
+@Composable
+fun Register(patients: List<Patient>, onClick: (Patient) -> Unit) = LazyColumn(Modifier.fillMaxSize()) {
+  items(patients) { p ->
+    ListItem(
+      modifier = Modifier.clickable { onClick(p) },
+      headlineContent = { Text(p.name) },
+      supportingContent = { Text("Age ${p.age} · Due ${p.edd} · ${p.weeks} weeks") },
+    )
+    HorizontalDivider()
+  }
+}
+
+@Composable
+fun Detail(p: Patient, onNew: () -> Unit) = Column(Modifier.fillMaxSize()) {
+  Text("Age ${p.age} · Due ${p.edd} · ${p.weeks} weeks", Modifier.padding(16.dp))
+  Button(onNew, Modifier.padding(horizontal = 16.dp)) { Text("Record new ANC visit") }
+  LazyColumn(Modifier.weight(1f)) {
+    items(p.visits) { v ->
+      ListItem(
+        headlineContent = { Text(v.date) },
+        supportingContent = {
+          Text(listOfNotNull(
+            v.weeks?.let { "$it wk" }, v.weight?.let { "$it kg" }, v.bp?.let { "BP $it" }, v.hb?.let { "Hb $it g/dL" },
+            v.dangerSigns.takeIf { it.isNotEmpty() }?.let { "Danger: ${it.joinToString()}" }, v.notes?.let { "Notes: $it" },
+          ).joinToString("\n"))
+        },
+      )
+      HorizontalDivider()
+    }
+  }
+}
+
+@Composable
+fun VisitForm(p: Patient, done: (saved: Boolean) -> Unit) {
+  var q by remember { mutableStateOf<String?>(null) }
+  var error by remember { mutableStateOf<String?>(null) }
+  val scope = rememberCoroutineScope()
+  LaunchedEffect(Unit) {
+    runCatching { withContext(Dispatchers.IO) { loadQuestionnaire() } }.onSuccess { q = it }.onFailure { error = it.message }
+  }
+  Column(Modifier.fillMaxSize()) {
+    error?.let { Text("Error: $it", Modifier.padding(16.dp)) }
+    q?.let {
+      Questionnaire(
+        questionnaireJson = it,
+        onSubmit = { getResponse ->
+          scope.launch {
+            runCatching { val r = getResponse(); withContext(Dispatchers.IO) { saveVisit(p.id, r) } }
+              .onSuccess { done(true) }.onFailure { e -> error = e.message }
+          }
+        },
+        onCancel = { done(false) },
+      )
+    } ?: if (error == null) CircularProgressIndicator(Modifier.padding(16.dp)) else Unit
   }
 }
