+package com.example.ancapp.data
+
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Patient
+import java.time.LocalDate
+import java.time.format.DateTimeParseException
+
+/** FHIR date/dateTime print as ISO-8601; the first 10 characters are always the date. */
+fun fhirDate(text: String?): LocalDate? {
+  if (text == null || text.length < 10) return null
+  return try {
+    LocalDate.parse(text.substring(0, 10))
+  } catch (e: DateTimeParseException) {
+    null
+  }
+}
+
+fun Patient.displayName(): String {
+  val name = this.name.orEmpty().firstOrNull()
+  val given = name?.given.orEmpty().mapNotNull { it.value }.joinToString(" ")
+  val family = name?.family?.value.orEmpty()
+  return listOf(given, family).filter { it.isNotBlank() }.joinToString(" ").ifBlank {
+    name?.text?.value ?: "Unnamed patient"
+  }
+}
+
+fun Patient.birthDateOrNull(): LocalDate? = fhirDate(birthDate?.value?.toString())
+
+fun Patient.ageOn(today: LocalDate): Int? =
+  birthDateOrNull()?.let { java.time.Period.between(it, today).years }
+
+fun Observation.codes(): List<String> = code.coding.orEmpty().mapNotNull { it.code?.value }
+
+fun Observation.hasCode(loincCode: String): Boolean = loincCode in codes()
+
+fun Observation.subjectPatientId(): String? =
+  subject?.reference?.value?.takeIf { it.startsWith("Patient/") }?.removePrefix("Patient/")
+
+fun Observation.encounterId(): String? =
+  encounter?.reference?.value?.takeIf { it.startsWith("Encounter/") }?.removePrefix("Encounter/")
+
+fun Observation.effectiveDate(): LocalDate? =
+  fhirDate(effective?.asDateTime()?.value?.value?.toString())
+    ?: fhirDate(effective?.asPeriod()?.value?.start?.value?.toString())
+
+/** The numeric part of a `valueQuantity`, formatted for display (no trailing exponent). */
+fun Observation.quantityValue(): String? =
+  value?.asQuantity()?.value?.value?.value?.toPlainString()?.trimTrailingZeros()
+
+fun Observation.stringValue(): String? = value?.asString()?.value?.value
+
+fun Observation.codeableValueDisplay(): String? {
+  val concept = value?.asCodeableConcept()?.value ?: return null
+  return concept.text?.value
+    ?: concept.coding.orEmpty().firstOrNull()?.display?.value
+    ?: concept.coding.orEmpty().firstOrNull()?.code?.value
+}
+
+fun Observation.dateTimeValue(): LocalDate? = fhirDate(value?.asDateTime()?.value?.value?.toString())
+
+/** Reads one child of a component-based panel such as the blood-pressure panel. */
+fun Observation.componentQuantity(loincCode: String): String? =
+  component
+    .orEmpty()
+    .firstOrNull { comp -> comp.code.coding.orEmpty().any { it.code?.value == loincCode } }
+    ?.value
+    ?.asQuantity()
+    ?.value
+    ?.value
+    ?.value
+    ?.toPlainString()
+    ?.trimTrailingZeros()
+
+fun Encounter.subjectPatientId(): String? =
+  subject?.reference?.value?.takeIf { it.startsWith("Patient/") }?.removePrefix("Patient/")
+
+fun Encounter.startDate(): LocalDate? =
+  fhirDate(period?.start?.value?.toString()) ?: fhirDate(period?.end?.value?.toString())
+
+private fun String.trimTrailingZeros(): String =
+  if (contains('.')) trimEnd('0').trimEnd('.') else this
