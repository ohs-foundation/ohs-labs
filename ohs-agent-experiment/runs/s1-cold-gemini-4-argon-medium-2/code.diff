+@OptIn(ExperimentalMaterial3Api::class, ExperimentalLayoutApi::class)
+@Composable
+fun RecordVisitScreen(
+  patientWithVisits: PatientWithVisits,
+  onCancel: () -> Unit,
+  onSaveVisit: (
+    visitDate: String,
+    gestationalAgeWeeks: Int,
+    weightKg: Double,
+    systolicBp: Int,
+    diastolicBp: Int,
+    hemoglobinGdL: Double?,
+    dangerSigns: List<DangerSign>,
+    notes: String,
+  ) -> Unit,
+) {
+  BackHandler(onBack = onCancel)
+
+  val patient = patientWithVisits.patient
+  val todayString = LocalDate.now().toString()
+  val suggestedWeeks = patientWithVisits.currentWeeksOfPregnancy()
+
+  var visitDate by rememberSaveable { mutableStateOf("") }
+  var gestationalAgeText by rememberSaveable { mutableStateOf("") }
+  var weightText by rememberSaveable { mutableStateOf("") }
+  var systolicText by rememberSaveable { mutableStateOf("") }
+  var diastolicText by rememberSaveable { mutableStateOf("") }
+  var hemoglobinText by rememberSaveable { mutableStateOf("") }
+  var selectedDangerSignKeys by rememberSaveable { mutableStateOf(emptyList<String>()) }
+  var notesText by rememberSaveable { mutableStateOf("") }
+  var errorMessage by rememberSaveable { mutableStateOf<String?>(null) }
+  var showDatePicker by rememberSaveable { mutableStateOf(false) }
+
+  val selectedDangerSigns =
+    selectedDangerSignKeys.mapNotNull { key -> DangerSign.entries.find { it.dbKey == key } }
+
+  fun validateAndSubmit() {
+    val finalDate = visitDate.trim().ifEmpty { todayString }
+    val gaWeeks =
+      if (gestationalAgeText.trim().isEmpty()) {
+        suggestedWeeks.coerceIn(1, 45)
+      } else {
+        gestationalAgeText.trim().toIntOrNull()
+      }
+    val weightKg = weightText.trim().replace(',', '.').toDoubleOrNull()
+    val systolicBp = systolicText.trim().toIntOrNull()
+    val diastolicBp = diastolicText.trim().toIntOrNull()
+    val hbGdL =
+      if (hemoglobinText.trim().isEmpty()) {
+        null
+      } else {
+        hemoglobinText.trim().replace(',', '.').toDoubleOrNull()
+      }
+
+    if (gaWeeks == null || gaWeeks < 1 || gaWeeks > 46) {
+      errorMessage = "Please enter a valid gestational age in weeks (1–45)."
+      return
+    }
+    if (weightKg == null || weightKg <= 20.0 || weightKg > 250.0) {
+      errorMessage = "Please enter a valid maternal weight in kg."
+      return
+    }
+    if (systolicBp == null || systolicBp < 50 || systolicBp > 300) {
+      errorMessage = "Please enter a valid systolic blood pressure (mmHg)."
+      return
+    }
+    if (diastolicBp == null || diastolicBp < 30 || diastolicBp > 200) {
+      errorMessage = "Please enter a valid diastolic blood pressure (mmHg)."
+      return
+    }
+    if (hemoglobinText.trim().isNotEmpty() && (hbGdL == null || hbGdL <= 1.0 || hbGdL > 25.0)) {
+      errorMessage = "Please enter a valid hemoglobin value (g/dL) or leave blank."
+      return
+    }
+
+    errorMessage = null
+    onSaveVisit(
+      finalDate,
+      gaWeeks,
+      weightKg,
+      systolicBp,
+      diastolicBp,
+      hbGdL,
+      selectedDangerSigns,
+      notesText.trim(),
+    )
+  }
+
+  if (showDatePicker) {
+    val datePickerState = rememberDatePickerState()
+    DatePickerDialog(
+      onDismissRequest = { showDatePicker = false },
+      confirmButton = {
+        TextButton(
+          onClick = {
+            datePickerState.selectedDateMillis?.let { millis ->
+              val picked = Instant.ofEpochMilli(millis).atZone(ZoneOffset.UTC).toLocalDate()
+              visitDate = picked.toString()
+            }
+            showDatePicker = false
+          }
+        ) {
+          Text("OK")
+        }
+      },
+      dismissButton = {
+        TextButton(onClick = { showDatePicker = false }) { Text("Cancel") }
+      },
+    ) {
+      DatePicker(state = datePickerState)
+    }
+  }
+
+  Scaffold(
+    topBar = {
+      TopAppBar(
+        title = {
+          Column {
+            Text(
+              text = "Record New ANC Visit",
+              style = MaterialTheme.typography.titleLarge,
+              fontWeight = FontWeight.Bold,
+            )
+            Text(
+              text = "${patient.name} • Due ${patient.estimatedDueDate}",
+              style = MaterialTheme.typography.labelMedium,
+              color = MaterialTheme.colorScheme.onPrimary.copy(alpha = 0.85f),
+            )
+          }
+        },
+        navigationIcon = {
+          IconButton(
+            onClick = onCancel,
+            modifier = Modifier.testTag("cancel_visit_back_button"),
+          ) {
+            Icon(
+              imageVector = Icons.AutoMirrored.Filled.ArrowBack,
+              contentDescription = "Cancel",
+              tint = MaterialTheme.colorScheme.onPrimary,
+            )
+          }
+        },
+        colors =
+          TopAppBarDefaults.topAppBarColors(
+            containerColor = MaterialTheme.colorScheme.primary,
+            titleContentColor = MaterialTheme.colorScheme.onPrimary,
+          ),
+      )
+    },
+    bottomBar = {
+      Surface(
+        tonalElevation = 4.dp,
+        shadowElevation = 6.dp,
+        color = MaterialTheme.colorScheme.surface,
+      ) {
+        Row(
+          modifier =
+            Modifier.fillMaxWidth()
+              .imePadding()
+              .padding(horizontal = 16.dp, vertical = 12.dp),
+          horizontalArrangement = Arrangement.spacedBy(12.dp),
+        ) {
+          OutlinedButton(
+            onClick = onCancel,
+            modifier = Modifier.weight(1f).testTag("cancel_visit_button"),
+            shape = RoundedCornerShape(12.dp),
+          ) {
+            Text("Cancel")
+          }
+          Button(
+            onClick = { validateAndSubmit() },
+            modifier = Modifier.weight(2f).testTag("save_visit_button"),
+            shape = RoundedCornerShape(12.dp),
+            colors =
+              ButtonDefaults.buttonColors(
+                containerColor = MaterialTheme.colorScheme.primary,
+                contentColor = MaterialTheme.colorScheme.onPrimary,
+              ),
+          ) {
+            Icon(
+              imageVector = Icons.Default.Save,
+              contentDescription = null,
+              modifier = Modifier.size(18.dp),
+            )
+            Spacer(modifier = Modifier.width(8.dp))
+            Text(
+              text = "Save ANC Visit",
+              fontWeight = FontWeight.Bold,
+            )
+          }
+        }
+      }
+    },
+    containerColor = MaterialTheme.colorScheme.background,
+  ) { innerPadding ->
+    Column(
+      modifier =
+        Modifier.fillMaxSize()
+          .padding(innerPadding)
+          .verticalScroll(rememberScrollState())
+          .padding(horizontal = 16.dp, vertical = 12.dp),
+      verticalArrangement = Arrangement.spacedBy(12.dp),
+    ) {
+      if (errorMessage != null) {
+        Surface(
+          shape = RoundedCornerShape(12.dp),
+          color = ClinicDangerContainer,
+          modifier = Modifier.fillMaxWidth(),
+        ) {
+          Row(
+            modifier = Modifier.padding(12.dp),
+            verticalAlignment = Alignment.CenterVertically,
+          ) {
+            Icon(
+              imageVector = Icons.Default.WarningAmber,
+              contentDescription = null,
+              tint = ClinicDangerRed,
+            )
+            Spacer(modifier = Modifier.width(8.dp))
+            Text(
+              text = errorMessage ?: "",
+              style = MaterialTheme.typography.bodyMedium,
+              fontWeight = FontWeight.Medium,
+              color = ClinicDangerRed,
+            )
+          }
+        }
+      }
+
+      // Row 1: Visit Date + Gestational Age in weeks
+      Row(
+        modifier = Modifier.fillMaxWidth(),
+        horizontalArrangement = Arrangement.spacedBy(12.dp),
+      ) {
+        OutlinedTextField(
+          value = visitDate,
+          onValueChange = {
+            visitDate = it
+            errorMessage = null
+          },
+          label = { Text("Visit date (YYYY-MM-DD)") },
+          placeholder = { Text("2026-11-02") },
+          singleLine = true,
+          trailingIcon = {
+            IconButton(onClick = { showDatePicker = true }) {
+              Icon(
+                imageVector = Icons.Default.CalendarMonth,
+                contentDescription = "Pick visit date",
+              )
+            }
+          },
+          modifier = Modifier.weight(1.25f).testTag("input_visit_date"),
+        )
+
+        OutlinedTextField(
+          value = gestationalAgeText,
+          onValueChange = {
+            gestationalAgeText = it.filter { ch -> ch.isDigit() }
+            errorMessage = null
+          },
+          label = { Text("Gestational age (weeks)") },
+          placeholder = { Text("$suggestedWeeks") },
+          singleLine = true,
+          keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+          modifier = Modifier.weight(1f).testTag("input_gestational_age"),
+        )
+      }
+
+      // Row 2: Weight (kg) + Hemoglobin (g/dL, optional)
+      Row(
+        modifier = Modifier.fillMaxWidth(),
+        horizontalArrangement = Arrangement.spacedBy(12.dp),
+      ) {
+        OutlinedTextField(
+          value = weightText,
+          onValueChange = {
+            weightText = it
+            errorMessage = null
+          },
+          label = { Text("Weight (kg)") },
+          placeholder = { Text("e.g. 69.5") },
+          singleLine = true,
+          keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Decimal),
+          modifier = Modifier.weight(1f).testTag("input_weight_kg"),
+        )
+
+        OutlinedTextField(
+          value = hemoglobinText,
+          onValueChange = {
+            hemoglobinText = it
+            errorMessage = null
+          },
+          label = { Text("Hb (g/dL, optional)") },
+          placeholder = { Text("e.g. 11.8") },
+          singleLine = true,
+          keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Decimal),
+          modifier = Modifier.weight(1f).testTag("input_hemoglobin"),
+        )
+      }
+
+      // Row 3: Blood Pressure (Systolic & Diastolic mmHg)
+      Row(
+        modifier = Modifier.fillMaxWidth(),
+        horizontalArrangement = Arrangement.spacedBy(12.dp),
+      ) {
+        OutlinedTextField(
+          value = systolicText,
+          onValueChange = {
+            systolicText = it.filter { ch -> ch.isDigit() }
+            errorMessage = null
+          },
+          label = { Text("Systolic BP (mmHg)") },
+          placeholder = { Text("e.g. 120") },
+          singleLine = true,
+          keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+          modifier = Modifier.weight(1f).testTag("input_systolic_bp"),
+        )
+
+        OutlinedTextField(
+          value = diastolicText,
+          onValueChange = {
+            diastolicText = it.filter { ch -> ch.isDigit() }
+            errorMessage = null
+          },
+          label = { Text("Diastolic BP (mmHg)") },
+          placeholder = { Text("e.g. 80") },
+          singleLine = true,
+          keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+          modifier = Modifier.weight(1f).testTag("input_diastolic_bp"),
+        )
+      }
+
+      // Section 4: Danger Signs (None / Vaginal bleeding / Severe headache / Blurred vision / Fever)
+      Surface(
+        shape = RoundedCornerShape(14.dp),
+        color = MaterialTheme.colorScheme.surface,
+        border = BorderStroke(1.dp, MaterialTheme.colorScheme.surfaceVariant),
+        modifier = Modifier.fillMaxWidth(),
+      ) {
+        Column(modifier = Modifier.fillMaxWidth().padding(14.dp)) {
+          Text(
+            text = "Danger Signs (multiple allowed)",
+            style = MaterialTheme.typography.titleSmall,
+            fontWeight = FontWeight.Bold,
+            color = MaterialTheme.colorScheme.onSurface,
+          )
+          Text(
+            text = "Select 'None' or all maternal danger signs observed during this visit:",
+            style = MaterialTheme.typography.bodySmall,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+          )
+          Spacer(modifier = Modifier.height(10.dp))
+
+          FlowRow(
+            horizontalArrangement = Arrangement.spacedBy(8.dp),
+            verticalArrangement = Arrangement.spacedBy(8.dp),
+          ) {
+            val isNoneSelected = selectedDangerSignKeys.isEmpty()
+
+            DangerSignOptionChip(
+              label = "None",
+              selected = isNoneSelected,
+              isDanger = false,
+              onClick = { selectedDangerSignKeys = emptyList() },
+              testTag = "danger_sign_NONE",
+            )
+
+            DangerSign.entries.forEach { sign ->
+              val isSelected = selectedDangerSignKeys.contains(sign.dbKey)
+              DangerSignOptionChip(
+                label = sign.displayName,
+                selected = isSelected,
+                isDanger = true,
+                onClick = {
+                  selectedDangerSignKeys =
+                    if (isSelected) {
+                      selectedDangerSignKeys - sign.dbKey
+                    } else {
+                      selectedDangerSignKeys + sign.dbKey
+                    }
+                },
+                testTag = "danger_sign_${sign.dbKey}",
+              )
+            }
+          }
+        }
+      }
+
+      // Row 5: Free-text Notes
+      OutlinedTextField(
+        value = notesText,
+        onValueChange = { notesText = it },
+        label = { Text("Clinical Notes") },
+        placeholder = { Text("Enter any additional observations, fetal movement, or care plan...") },
+        minLines = 3,
+        maxLines = 5,
+        modifier = Modifier.fillMaxWidth().testTag("input_notes"),
+      )
+
+      // Quick helper row if date or gestational age was cleared
+      Row(
+        horizontalArrangement = Arrangement.spacedBy(8.dp),
+        verticalAlignment = Alignment.CenterVertically,
+      ) {
+        AssistChip(
+          onClick = { visitDate = todayString },
+          label = { Text("Set Date: Today ($todayString)") },
+        )
+        AssistChip(
+          onClick = { gestationalAgeText = suggestedWeeks.toString() },
+          label = { Text("Set GA: $suggestedWeeks wks") },
+        )
+      }
+    }
+  }
+}
+
+@Composable
+private fun DangerSignOptionChip(
+  label: String,
+  selected: Boolean,
+  isDanger: Boolean,
+  onClick: () -> Unit,
+  testTag: String,
+) {
+  val containerColor =
+    when {
+      selected && isDanger -> ClinicDangerContainer
+      selected && !isDanger -> ClinicSuccessContainer
+      else -> MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.55f)
+    }
+  val contentColor =
+    when {
+      selected && isDanger -> ClinicDangerRed
+      selected && !isDanger -> ClinicSuccessGreen
+      else -> MaterialTheme.colorScheme.onSurface
+    }
+  val borderColor =
+    when {
+      selected && isDanger -> ClinicDangerRed
+      selected && !isDanger -> ClinicSuccessGreen
+      else -> MaterialTheme.colorScheme.outline.copy(alpha = 0.35f)
+    }
+
+  Surface(
+    shape = RoundedCornerShape(10.dp),
+    color = containerColor,
+    border = BorderStroke(if (selected) 1.5.dp else 1.dp, borderColor),
+    modifier =
+      Modifier.clickable(onClick = onClick)
+        .testTag(testTag),
+  ) {
+    Row(
+      modifier = Modifier.padding(horizontal = 12.dp, vertical = 8.dp),
+      verticalAlignment = Alignment.CenterVertically,
+    ) {
+      if (selected) {
+        Icon(
+          imageVector = Icons.Default.Check,
+          contentDescription = null,
+          tint = contentColor,
+          modifier = Modifier.size(16.dp),
+        )
+        Spacer(modifier = Modifier.width(6.dp))
+      }
+      Text(
+        text = label,
+        style = MaterialTheme.typography.labelLarge,
+        fontWeight = if (selected) FontWeight.Bold else FontWeight.Medium,
+        color = contentColor,
+      )
+    }
+  }
+}
