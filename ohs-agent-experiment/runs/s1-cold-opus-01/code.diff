+package com.example.ancapp.data
+
+import androidx.room.TypeConverter
+import java.time.LocalDate
+
+class Converters {
+
+  @TypeConverter
+  fun localDateToEpochDay(date: LocalDate?): Long? = date?.toEpochDay()
+
+  @TypeConverter
+  fun epochDayToLocalDate(epochDay: Long?): LocalDate? = epochDay?.let(LocalDate::ofEpochDay)
+
+  @TypeConverter
+  fun dangerSignsToString(signs: Set<DangerSign>): String = signs.joinToString(",") { it.name }
+
+  @TypeConverter
+  fun stringToDangerSigns(stored: String): Set<DangerSign> =
+    if (stored.isBlank()) {
+      emptySet()
+    } else {
+      // Unknown names are dropped rather than crashing, so an older build can read newer rows.
+      stored.split(",").mapNotNull { name ->
+        DangerSign.entries.firstOrNull { it.name == name }
+      }.toSet()
+    }
+}
