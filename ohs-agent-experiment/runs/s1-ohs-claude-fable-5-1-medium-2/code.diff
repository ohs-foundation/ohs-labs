+sealed interface Screen {
+  data object Register : Screen
+  data class Detail(val row: RegisterRow) : Screen
+  data class NewVisit(val row: RegisterRow) : Screen
+}
 
 class MainActivity : ComponentActivity() {
   override fun onCreate(savedInstanceState: Bundle?) {
     super.onCreate(savedInstanceState)
-    setContent { MaterialTheme { Surface { Text("Hello") } } }
+    DataCapture.initialize(this)
+    fhirEngine(this)
+    setContent { MaterialTheme { App() } }
+  }
+}
+
+@Composable
+fun App() {
+  var screen by remember { mutableStateOf<Screen>(Screen.Register) }
+  var version by remember { mutableIntStateOf(0) } // bump to reload data after sync/save
+  val ctx = LocalContext.current
+  val scope = rememberCoroutineScope()
+  val synced by produceState(false) { runCatching { syncOnce(fhirEngine(ctx)) }; value = true; version++ }
+
+  when (val s = screen) {
+    Screen.Register -> RegisterScreen(version, synced) { screen = Screen.Detail(it) }
+    is Screen.Detail -> {
+      BackHandler { screen = Screen.Register }
+      DetailScreen(s.row, version, onBack = { screen = Screen.Register }, onAdd = { screen = Screen.NewVisit(s.row) })
+    }
+    is Screen.NewVisit -> {
+      BackHandler { screen = Screen.Detail(s.row) }
+      NewVisitScreen(s.row, onDone = { saved ->
+        screen = Screen.Detail(s.row)
+        if (saved) { version++; scope.launch { runCatching { syncOnce(fhirEngine(ctx)) } } }
+      })
+    }
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun RegisterScreen(version: Int, synced: Boolean, onOpen: (RegisterRow) -> Unit) {
+  val ctx = LocalContext.current
+  val rows by produceState<List<RegisterRow>?>(null, version) { value = loadRegister(fhirEngine(ctx)) }
+  Scaffold(topBar = { TopAppBar(title = { Text("ANC Register") }) }) { pad ->
+    when {
+      rows == null -> Loading(pad)
+      rows!!.isEmpty() -> Box(Modifier.padding(pad).fillMaxSize(), Alignment.Center) {
+        Text(if (synced) "No patients found. Is the FHIR server running?" else "Syncing with server…")
+      }
+      else -> LazyColumn(Modifier.padding(pad)) {
+        items(rows!!, key = { it.id }) { r ->
+          ListItem(
+            modifier = Modifier.clickable { onOpen(r) },
+            headlineContent = { Text(r.name) },
+            supportingContent = { Text("Age ${r.age ?: "?"} · EDD ${r.edd ?: "unknown"} · ${r.weeks?.let { "$it weeks" } ?: "GA unknown"}") },
+          )
+          HorizontalDivider()
+        }
+      }
+    }
   }
 }
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun DetailScreen(row: RegisterRow, version: Int, onBack: () -> Unit, onAdd: () -> Unit) {
+  val ctx = LocalContext.current
+  val visits by produceState<List<Visit>?>(null, version) { value = loadVisits(fhirEngine(ctx), row.id) }
+  Scaffold(
+    topBar = { TopAppBar(title = { Text(row.name) }, navigationIcon = { IconButton(onBack) { Icon(Icons.AutoMirrored.Filled.ArrowBack, "Back") } }) },
+    floatingActionButton = { ExtendedFloatingActionButton(onClick = onAdd, icon = { Icon(Icons.Default.Add, null) }, text = { Text("New ANC visit") }) },
+  ) { pad ->
+    if (visits == null) Loading(pad)
+    else LazyColumn(Modifier.padding(pad)) {
+      item {
+        Text(
+          "Age ${row.age ?: "?"} · EDD ${row.edd ?: "unknown"} · ${row.weeks?.let { "$it weeks pregnant" } ?: ""}",
+          Modifier.padding(16.dp), style = MaterialTheme.typography.bodyMedium,
+        )
+        HorizontalDivider()
+      }
+      if (visits!!.isEmpty()) item { Text("No visits recorded yet.", Modifier.padding(16.dp)) }
+      items(visits!!) { v ->
+        ListItem(
+          headlineContent = { Text(v.date?.toString() ?: "Unknown date") },
+          supportingContent = {
+            Column {
+              Text("Weight: ${v.weightKg?.let { "$it kg" } ?: "—"}")
+              Text("BP: ${v.bp?.let { "$it mmHg" } ?: "—"}")
+              v.hb?.let { Text("Hb: $it g/dL") }
+            }
+          },
+        )
+        HorizontalDivider()
+      }
+    }
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun NewVisitScreen(row: RegisterRow, onDone: (Boolean) -> Unit) {
+  val ctx = LocalContext.current
+  val scope = rememberCoroutineScope()
+  val json by produceState<String?>(null) {
+    value = runCatching {
+      Sync.json.encodeToString(Resource.serializer(), fhirEngine(ctx).get(ResourceType.Questionnaire, "anc-contact"))
+    }.getOrNull() ?: ""
+  }
+  Scaffold(topBar = {
+    TopAppBar(title = { Text("New visit · ${row.name}") }, navigationIcon = { IconButton({ onDone(false) }) { Icon(Icons.AutoMirrored.Filled.ArrowBack, "Back") } })
+  }) { pad ->
+    when (json) {
+      null -> Loading(pad)
+      "" -> Box(Modifier.padding(pad).fillMaxSize(), Alignment.Center) { Text("Visit form not downloaded yet. Check the FHIR server and retry.") }
+      else -> Box(Modifier.padding(pad)) {
+        Questionnaire(
+          questionnaireJson = json!!,
+          config = QuestionnaireConfig(showSubmitButton = true, showCancelButton = true),
+          onSubmit = { getResponse ->
+            scope.launch {
+              saveVisit(fhirEngine(ctx), row.id, getResponse())
+              onDone(true)
+            }
+          },
+          onCancel = { onDone(false) },
+        )
+      }
+    }
+  }
+}
+
+@Composable
+private fun Loading(pad: androidx.compose.foundation.layout.PaddingValues) {
+  Box(Modifier.padding(pad).fillMaxSize(), Alignment.Center) { CircularProgressIndicator() }
+}
