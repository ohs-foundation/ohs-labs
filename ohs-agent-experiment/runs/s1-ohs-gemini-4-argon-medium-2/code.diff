+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun NewAncVisitScreen(
+  patientId: String,
+  patientName: String,
+  questionnaireJson: String,
+  isSaving: Boolean,
+  onSave: (QuestionnaireResponse) -> Unit,
+  onCancel: () -> Unit,
+) {
+  val coroutineScope = rememberCoroutineScope()
+  val formStateHolder = remember(patientId) { AncFormStateHolder() }
+  val matchersProvider =
+    remember(formStateHolder) { CustomQuestionnaireMatchersProvider(formStateHolder) }
+
+  // Provide an isolated ViewModelStoreOwner so QuestionnaireViewModel is created fresh every time
+  // the New ANC Visit form is opened.
+  val localViewModelStoreOwner =
+    remember(patientId) {
+      object : ViewModelStoreOwner {
+        override val viewModelStore: ViewModelStore = ViewModelStore()
+      }
+    }
+  DisposableEffect(localViewModelStoreOwner) {
+    onDispose { localViewModelStoreOwner.viewModelStore.clear() }
+  }
+
+  Scaffold(
+    topBar = {
+      Column {
+        TopAppBar(
+          title = {
+            Column {
+              Text(
+                text = "New ANC Visit",
+                style = MaterialTheme.typography.titleMedium,
+                fontWeight = FontWeight.Bold,
+              )
+              Text(
+                text = patientName,
+                style = MaterialTheme.typography.labelMedium,
+                color = MaterialTheme.colorScheme.onPrimary.copy(alpha = 0.85f),
+              )
+            }
+          },
+          navigationIcon = {
+            IconButton(onClick = onCancel, enabled = !isSaving) {
+              Icon(
+                imageVector = Icons.AutoMirrored.Filled.ArrowBack,
+                contentDescription = "Back",
+                tint = MaterialTheme.colorScheme.onPrimary,
+              )
+            }
+          },
+          actions = {
+            TextButton(
+              onClick = {
+                val response = formStateHolder.buildQuestionnaireResponse()
+                onSave(response)
+              },
+              enabled = !isSaving,
+              modifier = Modifier.testTag("top_save_visit_button"),
+            ) {
+              Text(
+                text = "Save",
+                color = MaterialTheme.colorScheme.onPrimary,
+                fontWeight = FontWeight.Bold,
+              )
+            }
+          },
+          colors =
+            TopAppBarDefaults.topAppBarColors(
+              containerColor = MaterialTheme.colorScheme.primary,
+              titleContentColor = MaterialTheme.colorScheme.onPrimary,
+            ),
+        )
+        if (isSaving) {
+          LinearProgressIndicator(modifier = Modifier.fillMaxWidth())
+        }
+      }
+    }
+  ) { innerPadding ->
+    Box(modifier = Modifier.fillMaxSize().padding(innerPadding)) {
+      CompositionLocalProvider(LocalViewModelStoreOwner provides localViewModelStoreOwner) {
+        Questionnaire(
+          questionnaireJson = questionnaireJson,
+          config =
+            QuestionnaireConfig(
+              showSubmitButton = true,
+              showCancelButton = true,
+              showReviewPage = false,
+              showSubmitAnywayWhenValidationFails = true,
+            ),
+          matchersProvider = matchersProvider,
+          onSubmit = { getResponse ->
+            coroutineScope.launch {
+              val response =
+                try {
+                  getResponse()
+                } catch (_: Exception) {
+                  formStateHolder.buildQuestionnaireResponse()
+                }
+              onSave(response)
+            }
+          },
+          onCancel = onCancel,
+        )
+      }
+    }
   }
 }
