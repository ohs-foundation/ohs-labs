+package com.example.ancapp.ui
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.example.ancapp.data.AncRepository
+import kotlinx.coroutines.flow.SharingStarted
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.flow.stateIn
+import java.time.LocalDate
+import java.time.temporal.ChronoUnit
+
+class RegisterViewModel(private val repository: AncRepository) : ViewModel() {
+    val patients = repository.getAllPatients()
+        .map { patientList ->
+            val today = LocalDate.now()
+            patientList.map { patient ->
+                val age = calculateAge(patient.dateOfBirth, today)
+                val weeksOfPregnancy = calculateWeeks(today, patient.estimatedDueDate)
+                PatientListItem(
+                    id = patient.id,
+                    name = patient.name,
+                    age = age,
+                    estimatedDueDate = patient.estimatedDueDate,
+                    weeksOfPregnancy = weeksOfPregnancy
+                )
+            }
+        }
+        .stateIn(viewModelScope, SharingStarted.Lazily, emptyList())
+
+    private fun calculateAge(dateOfBirth: LocalDate, today: LocalDate): Int {
+        var age = today.year - dateOfBirth.year
+        if (today.monthValue < dateOfBirth.monthValue ||
+            (today.monthValue == dateOfBirth.monthValue && today.dayOfMonth < dateOfBirth.dayOfMonth)) {
+            age--
+        }
+        return age
+    }
+
+    private fun calculateWeeks(today: LocalDate, dueDate: LocalDate): Int {
+        val weeksUntilDue = ChronoUnit.WEEKS.between(today, dueDate).toInt()
+        return 40 - weeksUntilDue
+    }
+}
+
+data class PatientListItem(
+    val id: Long,
+    val name: String,
+    val age: Int,
+    val estimatedDueDate: LocalDate,
+    val weeksOfPregnancy: Int
+)
