+package com.example.ancapp.data
+
+import android.content.Context
+import dev.ohs.fhir.engine.FhirEngineProvider
+import dev.ohs.fhir.engine.get
+import dev.ohs.fhir.engine.search.Search
+import dev.ohs.fhir.engine.sync.Sync
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Patient
+import dev.ohs.fhir.model.r4.Questionnaire
+import dev.ohs.fhir.model.r4.terminologies.ResourceType
+import kotlinx.serialization.json.Json
+
+class FhirRepository(private val context: Context) {
+  private val engine = FhirEngineProvider.getInstance(context)
+  private val json = Json { explicitNulls = false; encodeDefaults = false }
+
+  suspend fun syncData(): Boolean {
+    return try {
+      Sync.oneTimeSync<com.example.ancapp.sync.AncSyncWorker>(context).collect { }
+      true
+    } catch (e: Exception) {
+      false
+    }
+  }
+
+  suspend fun getPatients(): List<Patient> {
+    return engine
+      .search<Patient>(Search(ResourceType.Patient))
+      .map { it.resource }
+  }
+
+  suspend fun getPatient(patientId: String): Patient {
+    return engine.get<Patient>(patientId)
+  }
+
+  suspend fun getPatientEncounters(patientId: String): List<Encounter> {
+    val allEncounters = engine
+      .search<Encounter>(Search(ResourceType.Encounter))
+      .map { it.resource }
+    return allEncounters
+      .filter { encounter ->
+        encounter.subject?.reference.toString().contains(patientId)
+      }
+      .sortedByDescending { it.period?.start.toString() }
+  }
+
+  suspend fun getEncounterObservations(encounterId: String): List<Observation> {
+    val allObservations = engine
+      .search<Observation>(Search(ResourceType.Observation))
+      .map { it.resource }
+    return allObservations.filter { obs ->
+      obs.encounter?.reference.toString().contains(encounterId)
+    }
+  }
+
+  suspend fun getQuestionnaire(id: String): Questionnaire {
+    return engine.get<Questionnaire>(id)
+  }
+
+  suspend fun getQuestionnaireJson(id: String): String {
+    val questionnaire = getQuestionnaire(id)
+    return json.encodeToString(Questionnaire.serializer(), questionnaire)
+  }
+
+  suspend fun saveEncounterAndObservations(
+    encounter: Encounter,
+    observations: List<Observation>
+  ) {
+    engine.create(encounter, *observations.toTypedArray())
+  }
+}
