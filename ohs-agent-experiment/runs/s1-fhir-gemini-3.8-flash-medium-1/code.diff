diff --git a/app/src/main/java/com/example/ancapp/data/network/FhirService.kt b/app/src/main/java/com/example/ancapp/data/network/FhirService.kt
new file mode 100644
index 0000000..3a6aab4
--- /dev/null
+++ b/app/src/main/java/com/example/ancapp/data/network/FhirService.kt
@@ -0,0 +1,846 @@
+package com.example.ancapp.data.network
+
+import android.util.Log
+import com.example.ancapp.data.model.AncVisit
+import com.example.ancapp.data.model.AncVisitInput
+import com.example.ancapp.data.model.DangerSignOption
+import com.example.ancapp.data.model.PatientItem
+import com.example.ancapp.data.model.QuestionnaireItemModel
+import com.example.ancapp.data.model.QuestionnaireModel
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import org.json.JSONArray
+import org.json.JSONObject
+import java.time.Instant
+import java.time.format.DateTimeFormatter
+import java.util.concurrent.TimeUnit
+
+class FhirService(
+    private val baseUrl: String = "http://10.0.2.2:8080/fhir"
+) {
+    private val client = OkHttpClient.Builder()
+        .connectTimeout(15, TimeUnit.SECONDS)
+        .readTimeout(20, TimeUnit.SECONDS)
+        .writeTimeout(20, TimeUnit.SECONDS)
+        .build()
+
+    private val jsonMediaType = "application/fhir+json; charset=utf-8".toMediaType()
+
+    suspend fun getPatients(): Result<List<PatientItem>> = withContext(Dispatchers.IO) {
+        try {
+            // 1. Fetch Patients
+            val patientsRequest = Request.Builder()
+                .url("$baseUrl/Patient")
+                .header("Accept", "application/fhir+json, application/json")
+                .build()
+
+            val patientsResponse = client.newCall(patientsRequest).execute()
+            if (!patientsResponse.isSuccessful) {
+                return@withContext Result.failure(Exception("Failed to fetch patients: ${patientsResponse.code}"))
+            }
+            val patientsBody = patientsResponse.body?.string() ?: ""
+            val patientsJson = JSONObject(patientsBody)
+            val patientEntries = patientsJson.optJSONArray("entry") ?: JSONArray()
+
+            // 2. Fetch EDD observations (code 11778-8)
+            val eddMap = mutableMapOf<String, String>()
+            try {
+                val eddRequest = Request.Builder()
+                    .url("$baseUrl/Observation?code=11778-8")
+                    .header("Accept", "application/fhir+json, application/json")
+                    .build()
+                val eddResponse = client.newCall(eddRequest).execute()
+                if (eddResponse.isSuccessful) {
+                    val eddBody = eddResponse.body?.string() ?: ""
+                    val eddJson = JSONObject(eddBody)
+                    val eddEntries = eddJson.optJSONArray("entry") ?: JSONArray()
+                    for (i in 0 until eddEntries.length()) {
+                        val res = eddEntries.getJSONObject(i).getJSONObject("resource")
+                        val subjectRef = res.optJSONObject("subject")?.optString("reference") ?: ""
+                        val patientId = subjectRef.removePrefix("Patient/")
+                        val eddDate = res.optString("valueDateTime", "")
+                        if (patientId.isNotBlank() && eddDate.isNotBlank()) {
+                            eddMap[patientId] = eddDate
+                        }
+                    }
+                }
+            } catch (e: Exception) {
+                Log.w("FhirService", "Failed to fetch EDD observations: ${e.message}")
+            }
+
+            // Fallback: If any patient doesn't have EDD from code query, fetch all observations for that patient
+            for (i in 0 until patientEntries.length()) {
+                val pRes = patientEntries.getJSONObject(i).getJSONObject("resource")
+                val pid = pRes.getString("id")
+                if (!eddMap.containsKey(pid)) {
+                    try {
+                        val obsReq = Request.Builder()
+                            .url("$baseUrl/Observation?subject=Patient/$pid")
+                            .header("Accept", "application/fhir+json, application/json")
+                            .build()
+                        val obsRes = client.newCall(obsReq).execute()
+                        if (obsRes.isSuccessful) {
+                            val obsBody = obsRes.body?.string() ?: ""
+                            val obsJson = JSONObject(obsBody)
+                            val entries = obsJson.optJSONArray("entry") ?: JSONArray()
+                            for (j in 0 until entries.length()) {
+                                val o = entries.getJSONObject(j).getJSONObject("resource")
+                                val text = o.optJSONObject("code")?.optString("text") ?: ""
+                                val isEdd = text.contains("due date", ignoreCase = true) ||
+                                        hasLoincCode(o.optJSONObject("code"), "11778-8")
+                                if (isEdd) {
+                                    val edd = o.optString("valueDateTime", "")
+                                    if (edd.isNotBlank()) {
+                                        eddMap[pid] = edd
+                                        break
+                                    }
+                                }
+                            }
+                        }
+                    } catch (e: Exception) {
+                        Log.w("FhirService", "Failed fallback EDD for $pid: ${e.message}")
+                    }
+                }
+            }
+
+            val list = mutableListOf<PatientItem>()
+            for (i in 0 until patientEntries.length()) {
+                val res = patientEntries.getJSONObject(i).getJSONObject("resource")
+                val id = res.getString("id")
+                val nameObj = res.optJSONArray("name")?.optJSONObject(0)
+                val family = nameObj?.optString("family", "") ?: ""
+                val givenArr = nameObj?.optJSONArray("given")
+                val given = if (givenArr != null && givenArr.length() > 0) givenArr.getString(0) else ""
+                val fullName = listOf(given, family).filter { it.isNotBlank() }.joinToString(" ")
+                val birthDate = res.optString("birthDate", "2000-01-01")
+                val edd = eddMap[id] ?: "2026-12-01"
+
+                list.add(PatientItem.create(id, fullName, birthDate, edd))
+            }
+
+            // Sort by due date (soonest first)
+            list.sortBy { it.estimatedDueDate }
+            Result.success(list)
+        } catch (e: Exception) {
+            Log.e("FhirService", "Error in getPatients", e)
+            Result.failure(e)
+        }
+    }
+
+    suspend fun getPatientVisits(patientId: String): Result<List<AncVisit>> = withContext(Dispatchers.IO) {
+        try {
+            // 1. Fetch Encounters
+            val encRequest = Request.Builder()
+                .url("$baseUrl/Encounter?subject=Patient/$patientId")
+                .header("Accept", "application/fhir+json, application/json")
+                .build()
+            val encResponse = client.newCall(encRequest).execute()
+            val encounters = mutableListOf<EncounterData>()
+            if (encResponse.isSuccessful) {
+                val encBody = encResponse.body?.string() ?: ""
+                val encJson = JSONObject(encBody)
+                val entries = encJson.optJSONArray("entry") ?: JSONArray()
+                for (i in 0 until entries.length()) {
+                    val res = entries.getJSONObject(i).getJSONObject("resource")
+                    val id = res.getString("id")
+                    val period = res.optJSONObject("period")
+                    val date = period?.optString("start") ?: period?.optString("end") ?: ""
+                    encounters.add(EncounterData(id = id, date = date))
+                }
+            }
+
+            // 2. Fetch Observations
+            val obsRequest = Request.Builder()
+                .url("$baseUrl/Observation?subject=Patient/$patientId&_count=100")
+                .header("Accept", "application/fhir+json, application/json")
+                .build()
+            val obsResponse = client.newCall(obsRequest).execute()
+            val observations = mutableListOf<ObservationData>()
+            if (obsResponse.isSuccessful) {
+                val obsBody = obsResponse.body?.string() ?: ""
+                val obsJson = JSONObject(obsBody)
+                val entries = obsJson.optJSONArray("entry") ?: JSONArray()
+                for (i in 0 until entries.length()) {
+                    val res = entries.getJSONObject(i).getJSONObject("resource")
+                    val id = res.getString("id")
+                    val encRef = res.optJSONObject("encounter")?.optString("reference")
+                    val date = res.optString("effectiveDateTime", "")
+                    val codeObj = res.optJSONObject("code")
+                    val codeText = codeObj?.optString("text") ?: ""
+
+                    var isWeight = hasLoincCode(codeObj, "29463-7") || codeText.contains("weight", ignoreCase = true)
+                    var isBp = hasLoincCode(codeObj, "85354-9") || codeText.contains("blood pressure", ignoreCase = true)
+                    var isHb = hasLoincCode(codeObj, "718-7") || codeText.contains("hemoglobin", ignoreCase = true)
+                    var isGa = hasLoincCode(codeObj, "18185-9") || codeText.contains("gestational", ignoreCase = true)
+
+                    var weight: Double? = null
+                    var systolic: Int? = null
+                    var diastolic: Int? = null
+                    var hb: Double? = null
+                    var ga: Int? = null
+
+                    if (isWeight) {
+                        weight = res.optJSONObject("valueQuantity")?.optDouble("value")?.takeIf { !it.isNaN() }
+                    } else if (isHb) {
+                        hb = res.optJSONObject("valueQuantity")?.optDouble("value")?.takeIf { !it.isNaN() }
+                    } else if (isBp) {
+                        val comps = res.optJSONArray("component") ?: JSONArray()
+                        for (c in 0 until comps.length()) {
+                            val comp = comps.getJSONObject(c)
+                            val compCode = comp.optJSONObject("code")
+                            val compText = compCode?.optString("text") ?: ""
+                            val isSys = hasLoincCode(compCode, "8480-6") || compText.contains("systolic", ignoreCase = true)
+                            val isDia = hasLoincCode(compCode, "8462-4") || compText.contains("diastolic", ignoreCase = true)
+                            val v = comp.optJSONObject("valueQuantity")?.optInt("value")
+                            if (isSys && v != null) systolic = v
+                            if (isDia && v != null) diastolic = v
+                        }
+                    } else if (isGa) {
+                        ga = res.optJSONObject("valueQuantity")?.optInt("value")
+                            ?: res.optInt("valueInteger").takeIf { it != 0 }
+                    }
+
+                    observations.add(
+                        ObservationData(
+                            id = id,
+                            encounterRef = encRef,
+                            date = date,
+                            weight = weight,
+                            systolicBp = systolic,
+                            diastolicBp = diastolic,
+                            hemoglobin = hb,
+                            gestationalAge = ga
+                        )
+                    )
+                }
+            }
+
+            // 3. Fetch QuestionnaireResponses
+            val qrRequest = Request.Builder()
+                .url("$baseUrl/QuestionnaireResponse?subject=Patient/$patientId&_count=100")
+                .header("Accept", "application/fhir+json, application/json")
+                .build()
+            val qrResponse = client.newCall(qrRequest).execute()
+            val qrList = mutableListOf<QrData>()
+            if (qrResponse.isSuccessful) {
+                val qrBody = qrResponse.body?.string() ?: ""
+                val qrJson = JSONObject(qrBody)
+                val entries = qrJson.optJSONArray("entry") ?: JSONArray()
+                for (i in 0 until entries.length()) {
+                    val res = entries.getJSONObject(i).getJSONObject("resource")
+                    val id = res.getString("id")
+                    val encRef = res.optJSONObject("encounter")?.optString("reference")
+                    val authored = res.optString("authored", "")
+                    val items = res.optJSONArray("item") ?: JSONArray()
+
+                    var visitDate = ""
+                    var gaWeeks: Int? = null
+                    var weight: Double? = null
+                    var systolic: Int? = null
+                    var diastolic: Int? = null
+                    val dangerSigns = mutableListOf<String>()
+                    var notes: String? = null
+
+                    fun processItems(itemList: JSONArray) {
+                        for (k in 0 until itemList.length()) {
+                            val item = itemList.getJSONObject(k)
+                            val linkId = item.optString("linkId")
+                            val subItems = item.optJSONArray("item")
+                            if (subItems != null) {
+                                processItems(subItems)
+                            }
+                            val answers = item.optJSONArray("answer") ?: JSONArray()
+                            for (a in 0 until answers.length()) {
+                                val ans = answers.getJSONObject(a)
+                                when (linkId) {
+                                    "visit-date" -> visitDate = ans.optString("valueDate", "")
+                                    "gestational-age" -> gaWeeks = ans.optInt("valueInteger").takeIf { it != 0 }
+                                    "weight" -> weight = ans.optDouble("valueDecimal").takeIf { !it.isNaN() }
+                                    "bp-systolic" -> systolic = ans.optInt("valueInteger").takeIf { it != 0 }
+                                    "bp-diastolic" -> diastolic = ans.optInt("valueInteger").takeIf { it != 0 }
+                                    "danger-signs" -> {
+                                        val coding = ans.optJSONObject("valueCoding")
+                                        val display = coding?.optString("display")
+                                            ?: coding?.optString("code")
+                                            ?: ans.optString("valueString")
+                                        if (display.isNotBlank()) dangerSigns.add(display)
+                                    }
+                                    "notes" -> notes = ans.optString("valueString").takeIf { it.isNotBlank() }
+                                }
+                            }
+                        }
+                    }
+                    processItems(items)
+
+                    qrList.add(
+                        QrData(
+                            id = id,
+                            encounterRef = encRef,
+                            authored = authored,
+                            visitDate = visitDate.ifBlank { authored.take(10) },
+                            gestationalAge = gaWeeks,
+                            weight = weight,
+                            systolicBp = systolic,
+                            diastolicBp = diastolic,
+                            dangerSigns = dangerSigns,
+                            notes = notes
+                        )
+                    )
+                }
+            }
+
+            // Combine Encounters, Observations, and QRs
+            val visits = mutableListOf<AncVisit>()
+
+            // First, process encounters
+            val matchedObsIds = mutableSetOf<String>()
+            val matchedQrIds = mutableSetOf<String>()
+
+            for (enc in encounters) {
+                // Find matching observations for this encounter
+                val matchingObs = observations.filter { obs ->
+                    obs.encounterRef?.endsWith(enc.id) == true ||
+                            (obs.date.isNotBlank() && enc.date.isNotBlank() && obs.date.take(10) == enc.date.take(10))
+                }
+                matchingObs.forEach { matchedObsIds.add(it.id) }
+
+                // Find matching QR
+                val matchingQr = qrList.firstOrNull { qr ->
+                    qr.encounterRef?.endsWith(enc.id) == true ||
+                            (qr.visitDate.isNotBlank() && enc.date.isNotBlank() && qr.visitDate.take(10) == enc.date.take(10))
+                }
+                if (matchingQr != null) {
+                    matchedQrIds.add(matchingQr.id)
+                }
+
+                val weight = matchingObs.firstNotNullOfOrNull { it.weight } ?: matchingQr?.weight
+                val systolic = matchingObs.firstNotNullOfOrNull { it.systolicBp } ?: matchingQr?.systolicBp
+                val diastolic = matchingObs.firstNotNullOfOrNull { it.diastolicBp } ?: matchingQr?.diastolicBp
+                val hb = matchingObs.firstNotNullOfOrNull { it.hemoglobin }
+                val ga = matchingObs.firstNotNullOfOrNull { it.gestationalAge } ?: matchingQr?.gestationalAge
+                val dangerSigns = matchingQr?.dangerSigns ?: emptyList()
+                val notes = matchingQr?.notes
+
+                visits.add(
+                    AncVisit(
+                        id = enc.id,
+                        encounterId = enc.id,
+                        date = enc.date.take(10),
+                        gestationalAgeWeeks = ga,
+                        weightKg = weight,
+                        systolicBp = systolic,
+                        diastolicBp = diastolic,
+                        hemoglobin = hb,
+                        dangerSigns = dangerSigns,
+                        notes = notes
+                    )
+                )
+            }
+
+            // If any QR was not matched with an encounter, include it
+            for (qr in qrList) {
+                if (!matchedQrIds.contains(qr.id)) {
+                    visits.add(
+                        AncVisit(
+                            id = "qr-${qr.id}",
+                            encounterId = qr.encounterRef?.removePrefix("Encounter/"),
+                            date = qr.visitDate.take(10),
+                            gestationalAgeWeeks = qr.gestationalAge,
+                            weightKg = qr.weight,
+                            systolicBp = qr.systolicBp,
+                            diastolicBp = qr.diastolicBp,
+                            hemoglobin = null,
+                            dangerSigns = qr.dangerSigns,
+                            notes = qr.notes
+                        )
+                    )
+                }
+            }
+
+            // Sort visits by date descending (most recent first)
+            visits.sortByDescending { it.date }
+            Result.success(visits)
+        } catch (e: Exception) {
+            Log.e("FhirService", "Error in getPatientVisits", e)
+            Result.failure(e)
+        }
+    }
+
+    suspend fun getQuestionnaire(id: String = "anc-contact"): Result<QuestionnaireModel> = withContext(Dispatchers.IO) {
+        try {
+            val request = Request.Builder()
+                .url("$baseUrl/Questionnaire/$id")
+                .header("Accept", "application/fhir+json, application/json")
+                .build()
+            val response = client.newCall(request).execute()
+            if (!response.isSuccessful) {
+                return@withContext Result.failure(Exception("Failed to fetch questionnaire: ${response.code}"))
+            }
+            val body = response.body?.string() ?: ""
+            val json = JSONObject(body)
+
+            fun parseItem(itemJson: JSONObject): QuestionnaireItemModel {
+                val linkId = itemJson.optString("linkId")
+                val text = itemJson.optString("text")
+                val type = itemJson.optString("type")
+                val required = itemJson.optBoolean("required", false)
+                val repeats = itemJson.optBoolean("repeats", false)
+
+                val answerOptions = mutableListOf<DangerSignOption>()
+                val optionsArray = itemJson.optJSONArray("answerOption")
+                if (optionsArray != null) {
+                    for (i in 0 until optionsArray.length()) {
+                        val opt = optionsArray.getJSONObject(i)
+                        val vc = opt.optJSONObject("valueCoding")
+                        if (vc != null) {
+                            answerOptions.add(
+                                DangerSignOption(
+                                    code = vc.optString("code"),
+                                    display = vc.optString("display"),
+                                    system = vc.optString("system", "urn:example:anc-danger-signs")
+                                )
+                            )
+                        }
+                    }
+                }
+
+                val subItems = mutableListOf<QuestionnaireItemModel>()
+                val subArray = itemJson.optJSONArray("item")
+                if (subArray != null) {
+                    for (i in 0 until subArray.length()) {
+                        subItems.add(parseItem(subArray.getJSONObject(i)))
+                    }
+                }
+
+                return QuestionnaireItemModel(
+                    linkId = linkId,
+                    text = text,
+                    type = type,
+                    required = required,
+                    repeats = repeats,
+                    answerOptions = answerOptions,
+                    subItems = subItems
+                )
+            }
+
+            val items = mutableListOf<QuestionnaireItemModel>()
+            val itemsArray = json.optJSONArray("item") ?: JSONArray()
+            for (i in 0 until itemsArray.length()) {
+                items.add(parseItem(itemsArray.getJSONObject(i)))
+            }
+
+            Result.success(
+                QuestionnaireModel(
+                    id = json.optString("id", id),
+                    url = json.optString("url"),
+                    title = json.optString("title", "ANC Contact Visit"),
+                    items = items
+                )
+            )
+        } catch (e: Exception) {
+            Log.e("FhirService", "Error in getQuestionnaire", e)
+            Result.failure(e)
+        }
+    }
+
+    suspend fun recordVisit(patientId: String, input: AncVisitInput): Result<AncVisit> = withContext(Dispatchers.IO) {
+        try {
+            // 1. POST Encounter
+            val encJson = JSONObject().apply {
+                put("resourceType", "Encounter")
+                put("status", "finished")
+                put("class", JSONObject().apply {
+                    put("system", "http://terminology.hl7.org/CodeSystem/v3-ActCode")
+                    put("code", "AMB")
+                    put("display", "ambulatory")
+                })
+                put("type", JSONArray().apply {
+                    put(JSONObject().apply {
+                        put("text", "Antenatal care contact")
+                    })
+                })
+                put("subject", JSONObject().apply {
+                    put("reference", "Patient/$patientId")
+                })
+                put("period", JSONObject().apply {
+                    put("start", input.visitDate)
+                    put("end", input.visitDate)
+                })
+            }
+
+            val encReq = Request.Builder()
+                .url("$baseUrl/Encounter")
+                .header("Content-Type", "application/fhir+json")
+                .post(encJson.toString().toRequestBody(jsonMediaType))
+                .build()
+            val encResp = client.newCall(encReq).execute()
+            if (!encResp.isSuccessful) {
+                return@withContext Result.failure(Exception("Failed to create Encounter: ${encResp.code}"))
+            }
+            val encRespBody = encResp.body?.string() ?: ""
+            val encRespJson = JSONObject(encRespBody)
+            val encounterId = encRespJson.optString("id").ifBlank {
+                encResp.header("Location")?.substringAfterLast("/") ?: ""
+            }
+
+            val encRef = if (encounterId.isNotBlank()) "Encounter/$encounterId" else null
+
+            // 2. POST Weight Observation if present
+            if (input.weightKg != null) {
+                val weightJson = JSONObject().apply {
+                    put("resourceType", "Observation")
+                    put("status", "final")
+                    put("category", JSONArray().apply {
+                        put(JSONObject().apply {
+                            put("coding", JSONArray().apply {
+                                put(JSONObject().apply {
+                                    put("system", "http://terminology.hl7.org/CodeSystem/observation-category")
+                                    put("code", "vital-signs")
+                                    put("display", "Vital Signs")
+                                })
+                            })
+                        })
+                    })
+                    put("code", JSONObject().apply {
+                        put("coding", JSONArray().apply {
+                            put(JSONObject().apply {
+                                put("system", "http://loinc.org")
+                                put("code", "29463-7")
+                                put("display", "Body weight")
+                            })
+                        })
+                        put("text", "Body weight")
+                    })
+                    put("subject", JSONObject().apply {
+                        put("reference", "Patient/$patientId")
+                    })
+                    if (encRef != null) {
+                        put("encounter", JSONObject().apply {
+                            put("reference", encRef)
+                        })
+                    }
+                    put("effectiveDateTime", input.visitDate)
+                    put("valueQuantity", JSONObject().apply {
+                        put("value", input.weightKg)
+                        put("unit", "kg")
+                        put("system", "http://unitsofmeasure.org")
+                        put("code", "kg")
+                    })
+                }
+
+                val wReq = Request.Builder()
+                    .url("$baseUrl/Observation")
+                    .header("Content-Type", "application/fhir+json")
+                    .post(weightJson.toString().toRequestBody(jsonMediaType))
+                    .build()
+                client.newCall(wReq).execute()
+            }
+
+            // 3. POST Blood Pressure Observation if present
+            if (input.systolicBp != null || input.diastolicBp != null) {
+                val bpJson = JSONObject().apply {
+                    put("resourceType", "Observation")
+                    put("status", "final")
+                    put("category", JSONArray().apply {
+                        put(JSONObject().apply {
+                            put("coding", JSONArray().apply {
+                                put(JSONObject().apply {
+                                    put("system", "http://terminology.hl7.org/CodeSystem/observation-category")
+                                    put("code", "vital-signs")
+                                    put("display", "Vital Signs")
+                                })
+                            })
+                        })
+                    })
+                    put("code", JSONObject().apply {
+                        put("coding", JSONArray().apply {
+                            put(JSONObject().apply {
+                                put("system", "http://loinc.org")
+                                put("code", "85354-9")
+                                put("display", "Blood pressure panel with all children optional")
+                            })
+                        })
+                        put("text", "Blood pressure")
+                    })
+                    put("subject", JSONObject().apply {
+                        put("reference", "Patient/$patientId")
+                    })
+                    if (encRef != null) {
+                        put("encounter", JSONObject().apply {
+                            put("reference", encRef)
+                        })
+                    }
+                    put("effectiveDateTime", input.visitDate)
+                    val comps = JSONArray()
+                    if (input.systolicBp != null) {
+                        comps.put(JSONObject().apply {
+                            put("code", JSONObject().apply {
+                                put("coding", JSONArray().apply {
+                                    put(JSONObject().apply {
+                                        put("system", "http://loinc.org")
+                                        put("code", "8480-6")
+                                        put("display", "Systolic blood pressure")
+                                    })
+                                })
+                            })
+                            put("valueQuantity", JSONObject().apply {
+                                put("value", input.systolicBp)
+                                put("unit", "mmHg")
+                                put("system", "http://unitsofmeasure.org")
+                                put("code", "mm[Hg]")
+                            })
+                        })
+                    }
+                    if (input.diastolicBp != null) {
+                        comps.put(JSONObject().apply {
+                            put("code", JSONObject().apply {
+                                put("coding", JSONArray().apply {
+                                    put(JSONObject().apply {
+                                        put("system", "http://loinc.org")
+                                        put("code", "8462-4")
+                                        put("display", "Diastolic blood pressure")
+                                    })
+                                })
+                            })
+                            put("valueQuantity", JSONObject().apply {
+                                put("value", input.diastolicBp)
+                                put("unit", "mmHg")
+                                put("system", "http://unitsofmeasure.org")
+                                put("code", "mm[Hg]")
+                            })
+                        })
+                    }
+                    put("component", comps)
+                }
+
+                val bpReq = Request.Builder()
+                    .url("$baseUrl/Observation")
+                    .header("Content-Type", "application/fhir+json")
+                    .post(bpJson.toString().toRequestBody(jsonMediaType))
+                    .build()
+                client.newCall(bpReq).execute()
+            }
+
+            // 4. POST Gestational Age Observation if present
+            if (input.gestationalAgeWeeks != null) {
+                val gaJson = JSONObject().apply {
+                    put("resourceType", "Observation")
+                    put("status", "final")
+                    put("code", JSONObject().apply {
+                        put("coding", JSONArray().apply {
+                            put(JSONObject().apply {
+                                put("system", "http://loinc.org")
+                                put("code", "18185-9")
+                                put("display", "Gestational age in weeks")
+                            })
+                        })
+                        put("text", "Gestational age in weeks")
+                    })
+                    put("subject", JSONObject().apply {
+                        put("reference", "Patient/$patientId")
+                    })
+                    if (encRef != null) {
+                        put("encounter", JSONObject().apply {
+                            put("reference", encRef)
+                        })
+                    }
+                    put("effectiveDateTime", input.visitDate)
+                    put("valueQuantity", JSONObject().apply {
+                        put("value", input.gestationalAgeWeeks)
+                        put("unit", "wk")
+                        put("system", "http://unitsofmeasure.org")
+                        put("code", "wk")
+                    })
+                }
+
+                val gaReq = Request.Builder()
+                    .url("$baseUrl/Observation")
+                    .header("Content-Type", "application/fhir+json")
+                    .post(gaJson.toString().toRequestBody(jsonMediaType))
+                    .build()
+                client.newCall(gaReq).execute()
+            }
+
+            // 5. POST QuestionnaireResponse
+            val qrItems = JSONArray().apply {
+                // visit-date
+                put(JSONObject().apply {
+                    put("linkId", "visit-date")
+                    put("text", "Visit date")
+                    put("answer", JSONArray().apply {
+                        put(JSONObject().apply {
+                            put("valueDate", input.visitDate)
+                        })
+                    })
+                })
+
+                // gestational-age
+                if (input.gestationalAgeWeeks != null) {
+                    put(JSONObject().apply {
+                        put("linkId", "gestational-age")
+                        put("text", "Gestational age (weeks)")
+                        put("answer", JSONArray().apply {
+                            put(JSONObject().apply {
+                                put("valueInteger", input.gestationalAgeWeeks)
+                            })
+                        })
+                    })
+                }
+
+                // vitals group
+                val vitalsSubItems = JSONArray()
+                if (input.weightKg != null) {
+                    vitalsSubItems.put(JSONObject().apply {
+                        put("linkId", "weight")
+                        put("text", "Weight (kg)")
+                        put("answer", JSONArray().apply {
+                            put(JSONObject().apply {
+                                put("valueDecimal", input.weightKg)
+                            })
+                        })
+                    })
+                }
+                if (input.systolicBp != null) {
+                    vitalsSubItems.put(JSONObject().apply {
+                        put("linkId", "bp-systolic")
+                        put("text", "Systolic blood pressure (mmHg)")
+                        put("answer", JSONArray().apply {
+                            put(JSONObject().apply {
+                                put("valueInteger", input.systolicBp)
+                            })
+                        })
+                    })
+                }
+                if (input.diastolicBp != null) {
+                    vitalsSubItems.put(JSONObject().apply {
+                        put("linkId", "bp-diastolic")
+                        put("text", "Diastolic blood pressure (mmHg)")
+                        put("answer", JSONArray().apply {
+                            put(JSONObject().apply {
+                                put("valueInteger", input.diastolicBp)
+                            })
+                        })
+                    })
+                }
+                if (vitalsSubItems.length() > 0) {
+                    put(JSONObject().apply {
+                        put("linkId", "vitals")
+                        put("text", "Vital signs")
+                        put("item", vitalsSubItems)
+                    })
+                }
+
+                // danger-signs
+                if (input.dangerSigns.isNotEmpty()) {
+                    put(JSONObject().apply {
+                        put("linkId", "danger-signs")
+                        put("text", "Danger signs present")
+                        val answers = JSONArray()
+                        for (opt in input.dangerSigns) {
+                            answers.put(JSONObject().apply {
+                                put("valueCoding", JSONObject().apply {
+                                    put("system", opt.system)
+                                    put("code", opt.code)
+                                    put("display", opt.display)
+                                })
+                            })
+                        }
+                        put("answer", answers)
+                    })
+                }
+
+                // notes
+                if (!input.notes.isNullOrBlank()) {
+                    put(JSONObject().apply {
+                        put("linkId", "notes")
+                        put("text", "Notes")
+                        put("answer", JSONArray().apply {
+                            put(JSONObject().apply {
+                                put("valueString", input.notes)
+                            })
+                        })
+                    })
+                }
+            }
+
+            val qrJson = JSONObject().apply {
+                put("resourceType", "QuestionnaireResponse")
+                put("questionnaire", "http://example.org/fhir/Questionnaire/anc-contact")
+                put("status", "completed")
+                put("subject", JSONObject().apply {
+                    put("reference", "Patient/$patientId")
+                })
+                if (encRef != null) {
+                    put("encounter", JSONObject().apply {
+                        put("reference", encRef)
+                    })
+                }
+                put("authored", Instant.now().toString())
+                put("item", qrItems)
+            }
+
+            val qrReq = Request.Builder()
+                .url("$baseUrl/QuestionnaireResponse")
+                .header("Content-Type", "application/fhir+json")
+                .post(qrJson.toString().toRequestBody(jsonMediaType))
+                .build()
+            client.newCall(qrReq).execute()
+
+            val createdVisit = AncVisit(
+                id = encounterId.ifBlank { "visit-${System.currentTimeMillis()}" },
+                encounterId = encounterId.ifBlank { null },
+                date = input.visitDate,
+                gestationalAgeWeeks = input.gestationalAgeWeeks,
+                weightKg = input.weightKg,
+                systolicBp = input.systolicBp,
+                diastolicBp = input.diastolicBp,
+                hemoglobin = null,
+                dangerSigns = input.dangerSigns.map { it.display },
+                notes = input.notes
+            )
+            Result.success(createdVisit)
+        } catch (e: Exception) {
+            Log.e("FhirService", "Error in recordVisit", e)
+            Result.failure(e)
+        }
+    }
+
+    private fun hasLoincCode(codeObj: JSONObject?, targetCode: String): Boolean {
+        if (codeObj == null) return false
+        val codings = codeObj.optJSONArray("coding") ?: return false
+        for (i in 0 until codings.length()) {
+            val c = codings.getJSONObject(i)
+            val code = c.optString("code")
+            if (code == targetCode) return true
+        }
+        return false
+    }
+
+    private data class EncounterData(val id: String, val date: String)
+    private data class ObservationData(
+        val id: String,
+        val encounterRef: String?,
+        val date: String,
+        val weight: Double?,
+        val systolicBp: Int?,
+        val diastolicBp: Int?,
+        val hemoglobin: Double?,
+        val gestationalAge: Int?
+    )
+    private data class QrData(
+        val id: String,
+        val encounterRef: String?,
+        val authored: String,
+        val visitDate: String,
+        val gestationalAge: Int?,
+        val weight: Double?,
+        val systolicBp: Int?,
+        val diastolicBp: Int?,
+        val dangerSigns: List<String>,
+        val notes: String?
+    )
+}
