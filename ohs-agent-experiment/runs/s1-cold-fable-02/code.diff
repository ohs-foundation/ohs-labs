+package com.example.ancapp.data
+
+import androidx.room.TypeConverter
+import java.time.LocalDate
+
+class Converters {
+  // ISO-8601 strings so date columns sort correctly in SQL.
+  @TypeConverter
+  fun localDateToString(date: LocalDate): String = date.toString()
+
+  @TypeConverter
+  fun stringToLocalDate(value: String): LocalDate = LocalDate.parse(value)
+
+  @TypeConverter
+  fun dangerSignsToString(signs: Set<DangerSign>): String =
+    signs.joinToString(",") { it.name }
+
+  @TypeConverter
+  fun stringToDangerSigns(value: String): Set<DangerSign> =
+    if (value.isEmpty()) emptySet()
+    else value.split(",").map { DangerSign.valueOf(it) }.toSet()
+}
