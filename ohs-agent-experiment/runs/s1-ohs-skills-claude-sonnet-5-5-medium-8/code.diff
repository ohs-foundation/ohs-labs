+import dev.ohs.fhir.engine.sync.CurrentSyncJobStatus
+import dev.ohs.fhir.engine.sync.Sync
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.catch
+import kotlinx.coroutines.flow.transformWhile
+import kotlinx.coroutines.launch
+import kotlinx.serialization.json.Json
+
+private val json = Json { explicitNulls = false; encodeDefaults = false }
+
+private fun CurrentSyncJobStatus.isFinal() =
+  this is CurrentSyncJobStatus.Succeeded || this is CurrentSyncJobStatus.Failed || this is CurrentSyncJobStatus.Cancelled
+
+class SyncViewModel(app: Application) : AndroidViewModel(app) {
+  val engine = FhirEngineProvider.getInstance(app)
+  val status = MutableStateFlow("Waiting to sync")
+  /** Bumped whenever local data changes, so screens reload. */
+  val version = MutableStateFlow(0)
+  private var job: Job? = null
+
+  init { syncNow() }
+
+  fun syncNow() {
+    if (job?.isActive == true) return
+    job = viewModelScope.launch {
+      Sync.oneTimeSync<AppSyncWorker>(getApplication())
+        .transformWhile { emit(it); !it.isFinal() }
+        .catch { status.value = "Sync status unknown" }
+        .collect {
+          status.value = when (it) {
+            is CurrentSyncJobStatus.Running -> "Syncing…"
+            is CurrentSyncJobStatus.Succeeded -> { version.value++; "Synced" }
+            is CurrentSyncJobStatus.Failed -> "Sync failed, will try again later"
+            else -> status.value
+          }
+        }
+    }
+  }
+}
 
 class MainActivity : ComponentActivity() {
   override fun onCreate(savedInstanceState: Bundle?) {
     super.onCreate(savedInstanceState)
-    setContent { MaterialTheme { Surface { Text("Hello") } } }
+    setContent { MaterialTheme { App() } }
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun App() {
+  val vm: SyncViewModel = viewModel()
+  val nav = rememberNavController()
+  val status by vm.status.collectAsState()
+  val version by vm.version.collectAsState()
+
+  NavHost(nav, startDestination = "register") {
+    composable("register") {
+      val rows by produceState(emptyList(), version) { value = loadRegister(vm.engine) }
+      Scaffold(topBar = { TopAppBar(title = { Text("ANC Register") }) }) { pad ->
+        Column(Modifier.padding(pad).padding(16.dp)) {
+          Text(status, style = MaterialTheme.typography.labelMedium)
+          Button(onClick = vm::syncNow) { Text("Sync now") }
+          LazyColumn(verticalArrangement = Arrangement.spacedBy(12.dp)) {
+            items(rows) { r ->
+              Column(Modifier.fillMaxWidth().clickable { nav.navigate("patient/${r.id}") }.padding(vertical = 4.dp)) {
+                Text(r.name, style = MaterialTheme.typography.titleMedium)
+                Text("Age ${r.age ?: "?"} · Due ${r.due} · ${r.weeks} weeks")
+              }
+            }
+          }
+        }
+      }
+    }
+    composable("patient/{id}") { entry ->
+      val id = entry.arguments!!.getString("id")!!
+      val name by produceState(id) { value = loadPatientName(vm.engine, id) }
+      val visits by produceState(emptyList(), version) { value = loadVisits(vm.engine, id) }
+      Scaffold(topBar = { TopAppBar(title = { Text(name) }) }) { pad ->
+        Column(Modifier.padding(pad).padding(16.dp)) {
+          Button(onClick = { nav.navigate("visit/$id") }) { Text("Record new ANC visit") }
+          LazyColumn(verticalArrangement = Arrangement.spacedBy(12.dp)) {
+            items(visits) { v ->
+              Column {
+                Text(v.date, style = MaterialTheme.typography.titleMedium)
+                Text("Weight: ${v.weight?.let { "$it kg" } ?: "-"} · BP: ${v.bp ?: "-"}")
+                v.hb?.let { Text("Hb: $it g/dL") }
+                v.ga?.let { Text("Gestational age: $it weeks") }
+                v.danger?.let { Text("Danger signs: $it") }
+                v.notes?.let { Text("Notes: $it") }
+              }
+            }
+          }
+        }
+      }
+    }
+    // Own destination so each visit gets a fresh form view-model (stale-form trap).
+    composable("visit/{id}") { entry ->
+      val id = entry.arguments!!.getString("id")!!
+      val scope = rememberCoroutineScope()
+      val q by produceState<String?>(null) {
+        value = runCatching { json.encodeToString(vm.engine.get<dev.ohs.fhir.model.r4.Questionnaire>("anc-contact")) }.getOrNull()
+      }
+      val form = q
+      if (form == null) {
+        Text("Visit form not synced yet. Connect to the server and sync.", Modifier.padding(32.dp))
+      } else {
+        Questionnaire(
+          questionnaireJson = form,
+          onSubmit = { getResponse ->
+            scope.launch {
+              try {
+                saveVisit(vm.engine, id, getResponse())
+                vm.version.value++
+                vm.syncNow()
+                nav.popBackStack()
+              } catch (e: CancellationException) {
+                // validation failed; form shows errors
+              }
+            }
+          },
+          onCancel = { nav.popBackStack() },
+        )
+      }
+    }
   }
 }
