+package com.example.ancapp.data
+
+import java.time.LocalDate
+
+data class PatientItem(
+    val id: String,
+    val name: String,
+    val birthDate: String?,
+    val age: Int?,
+    val estimatedDueDate: LocalDate?,
+    val estimatedDueDateString: String?,
+    val weeksOfPregnancy: Int?,
+    val daysRemainingInWeek: Int? = null,
+) {
+    val weeksOfPregnancyDisplay: String
+        get() = when {
+            weeksOfPregnancy == null -> "Not available"
+            daysRemainingInWeek != null && daysRemainingInWeek > 0 -> "$weeksOfPregnancy weeks, $daysRemainingInWeek days"
+            else -> "$weeksOfPregnancy weeks"
+        }
+}
+
+data class AncVisitItem(
+    val encounterId: String,
+    val date: String,
+    val weight: String?,
+    val bloodPressure: String?,
+    val hemoglobin: String?,
+    val gestationalAge: String? = null,
+    val dangerSigns: List<String> = emptyList(),
+    val notes: String? = null,
+)
diff --git a/app/src/main/java/com/example/ancapp/data/AncRepository.kt b/app/src/main/java/com/example/ancapp/data/AncRepository.kt
new file mode 100644
index 0000000..138177d
--- /dev/null
+++ b/app/src/main/java/com/example/ancapp/data/AncRepository.kt
@@ -0,0 +1,532 @@
+package com.example.ancapp.data
+
+import android.content.Context
+import android.util.Log
+import androidx.work.ExistingWorkPolicy
+import com.example.ancapp.sync.AppSyncWorker
+import com.ionspin.kotlin.bignum.decimal.BigDecimal
+import dev.ohs.fhir.engine.FhirEngineProvider
+import dev.ohs.fhir.engine.get
+import dev.ohs.fhir.engine.search.ReferenceClientParam
+import dev.ohs.fhir.engine.search.Search
+import dev.ohs.fhir.engine.sync.CurrentSyncJobStatus
+import dev.ohs.fhir.engine.sync.Sync
+import dev.ohs.fhir.model.r4.Canonical
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.CodeableConcept
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.DateTime
+import dev.ohs.fhir.model.r4.Decimal
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Enumeration
+import dev.ohs.fhir.model.r4.FhirDateTime
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Patient
+import dev.ohs.fhir.model.r4.Period as FhirPeriod
+import dev.ohs.fhir.model.r4.Quantity
+import dev.ohs.fhir.model.r4.Questionnaire
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import dev.ohs.fhir.model.r4.Reference
+import dev.ohs.fhir.model.r4.String as FhirString
+import dev.ohs.fhir.model.r4.Uri
+import dev.ohs.fhir.model.r4.terminologies.ResourceType
+import kotlinx.coroutines.flow.first
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import java.time.LocalDate
+import java.time.Period
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+
+class AncRepository(private val context: Context) {
+
+    private val engine = FhirEngineProvider.getInstance(context.applicationContext)
+
+    private val json = Json {
+        explicitNulls = false
+        encodeDefaults = false
+    }
+
+    suspend fun sync(): Boolean {
+        return try {
+            val terminal = Sync.oneTimeSync<AppSyncWorker>(context.applicationContext).first {
+                it is CurrentSyncJobStatus.Succeeded ||
+                        it is CurrentSyncJobStatus.Failed ||
+                        it is CurrentSyncJobStatus.Cancelled
+            }
+            terminal is CurrentSyncJobStatus.Succeeded
+        } catch (e: Exception) {
+            Log.e("AncRepository", "Sync failed", e)
+            false
+        }
+    }
+
+    suspend fun getPatients(): List<PatientItem> {
+        val patients = engine.search<Patient>(Search(ResourceType.Patient)).map { it.resource }
+        val patientItems = patients.map { patient ->
+            val patientId = patient.id.orEmpty()
+            val observations = engine.search<Observation>(
+                Search(ResourceType.Observation).apply {
+                    filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+                }
+            ).map { it.resource }
+
+            buildPatientItem(patient, observations)
+        }
+
+        // Sorted by due date (soonest first)
+        return patientItems.sortedWith(compareBy(nullsLast()) { it.estimatedDueDate })
+    }
+
+    suspend fun getPatient(patientId: String): PatientItem? {
+        return try {
+            val patient = engine.get<Patient>(patientId)
+            val observations = engine.search<Observation>(
+                Search(ResourceType.Observation).apply {
+                    filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+                }
+            ).map { it.resource }
+            buildPatientItem(patient, observations)
+        } catch (e: Exception) {
+            Log.e("AncRepository", "Failed to get patient $patientId", e)
+            null
+        }
+    }
+
+    private fun buildPatientItem(patient: Patient, observations: List<Observation>): PatientItem {
+        val patientId = patient.id.orEmpty()
+
+        // Name
+        val nameObj = patient.name.firstOrNull()
+        val given = nameObj?.given?.mapNotNull { it.value }?.joinToString(" ").orEmpty()
+        val family = nameObj?.family?.value.orEmpty()
+        val fullName = "$given $family".trim().ifEmpty { "Patient $patientId" }
+
+        // Date of birth & age
+        val dob = patient.birthDate?.value?.toString()
+        val age = dob?.let {
+            try {
+                val parsed = LocalDate.parse(it.substringBefore("T"))
+                Period.between(parsed, LocalDate.now()).years
+            } catch (e: Exception) {
+                null
+            }
+        }
+
+        // Estimated due date observation (LOINC 11778-8)
+        val eddObs = observations.firstOrNull { obs ->
+            obs.code.coding.any { it.code?.value == "11778-8" } ||
+                    obs.code.text?.value?.contains("due date", ignoreCase = true) == true
+        }
+
+        val eddString = eddObs?.value?.asDateTime()?.value?.value?.toString()
+            ?: eddObs?.effective?.asDateTime()?.value?.value?.toString()
+
+        val dueDate = eddString?.let {
+            try {
+                LocalDate.parse(it.substringBefore("T"))
+            } catch (e: Exception) {
+                null
+            }
+        }
+
+        // Pregnancy calculation: standard gestation is 40 weeks (280 days).
+        // LMP = EDD - 280 days
+        // Days pregnant = today - LMP
+        val (weeks, days) = if (dueDate != null) {
+            val lmp = dueDate.minusDays(280)
+            val daysPregnant = ChronoUnit.DAYS.between(lmp, LocalDate.now())
+            if (daysPregnant >= 0) {
+                Pair((daysPregnant / 7).toInt(), (daysPregnant % 7).toInt())
+            } else {
+                Pair(null, null)
+            }
+        } else {
+            Pair(null, null)
+        }
+
+        return PatientItem(
+            id = patientId,
+            name = fullName,
+            birthDate = dob,
+            age = age,
+            estimatedDueDate = dueDate,
+            estimatedDueDateString = dueDate?.toString() ?: eddString,
+            weeksOfPregnancy = weeks,
+            daysRemainingInWeek = days,
+        )
+    }
+
+    suspend fun getVisits(patientId: String): List<AncVisitItem> {
+        val encounters = engine.search<Encounter>(
+            Search(ResourceType.Encounter).apply {
+                filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+            }
+        ).map { it.resource }
+
+        val observations = engine.search<Observation>(
+            Search(ResourceType.Observation).apply {
+                filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+            }
+        ).map { it.resource }
+
+        val visits = encounters.map { encounter ->
+            val encId = encounter.id.orEmpty()
+            val visitDate = encounter.period?.start?.value?.toString()?.substringBefore("T")
+                ?: encounter.period?.end?.value?.toString()?.substringBefore("T")
+                ?: ""
+
+            val linkedObs = observations.filter { obs ->
+                val ref = obs.encounter?.reference?.value
+                ref == "Encounter/$encId" || ref == encId ||
+                        (ref == null && obs.effective?.asDateTime()?.value?.value?.toString()?.substringBefore("T") == visitDate)
+            }
+
+            // Weight (LOINC 29463-7)
+            val weightObs = linkedObs.firstOrNull { obs ->
+                obs.code.coding.any { it.code?.value == "29463-7" } ||
+                        obs.code.text?.value?.contains("weight", ignoreCase = true) == true
+            }
+            val weightVal = weightObs?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+            val weightUnit = weightObs?.value?.asQuantity()?.value?.unit?.value ?: "kg"
+            val weightFormatted = weightVal?.let { "$it $weightUnit" }
+
+            // Blood pressure (LOINC 85354-9)
+            val bpObs = linkedObs.firstOrNull { obs ->
+                obs.code.coding.any { it.code?.value == "85354-9" } ||
+                        obs.code.text?.value?.contains("blood pressure", ignoreCase = true) == true
+            }
+            val sysVal = bpObs?.component?.firstOrNull { comp ->
+                comp.code.coding.any { it.code?.value == "8480-6" }
+            }?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+
+            val diaVal = bpObs?.component?.firstOrNull { comp ->
+                comp.code.coding.any { it.code?.value == "8462-4" }
+            }?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+
+            val bpFormatted = if (sysVal != null && diaVal != null) {
+                "$sysVal/$diaVal mmHg"
+            } else if (sysVal != null) {
+                "$sysVal mmHg"
+            } else null
+
+            // Hemoglobin (LOINC 718-7)
+            val hbObs = linkedObs.firstOrNull { obs ->
+                obs.code.coding.any { it.code?.value == "718-7" } ||
+                        obs.code.text?.value?.contains("hemoglobin", ignoreCase = true) == true
+            }
+            val hbVal = hbObs?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+            val hbUnit = hbObs?.value?.asQuantity()?.value?.unit?.value ?: "g/dL"
+            val hbFormatted = hbVal?.let { "$it $hbUnit" }
+
+            // Gestational age (LOINC 18185-9)
+            val gaObs = linkedObs.firstOrNull { obs ->
+                obs.code.coding.any { it.code?.value == "18185-9" } ||
+                        obs.code.text?.value?.contains("gestational age", ignoreCase = true) == true
+            }
+            val gaVal = gaObs?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+                ?: gaObs?.value?.asInteger()?.value?.value?.toString()
+            val gaFormatted = gaVal?.let { "$it weeks" }
+
+            // Danger signs
+            val dangerObs = linkedObs.firstOrNull { obs ->
+                obs.code.text?.value?.contains("danger signs", ignoreCase = true) == true
+            }
+            val dangerSignsList = dangerObs?.value?.asString()?.value?.value
+                ?.split(",")?.map { it.trim() }?.filter { it.isNotEmpty() }
+                ?: emptyList()
+
+            // Notes
+            val notesObs = linkedObs.firstOrNull { obs ->
+                obs.code.text?.value?.contains("notes", ignoreCase = true) == true
+            }
+            val notesVal = notesObs?.value?.asString()?.value?.value
+
+            AncVisitItem(
+                encounterId = encId,
+                date = visitDate,
+                weight = weightFormatted,
+                bloodPressure = bpFormatted,
+                hemoglobin = hbFormatted,
+                gestationalAge = gaFormatted,
+                dangerSigns = dangerSignsList,
+                notes = notesVal,
+            )
+        }
+
+        // Sort latest visit first
+        return visits.sortedByDescending { it.date }
+    }
+
+    suspend fun getQuestionnaireJson(): String {
+        return try {
+            val q = engine.get<Questionnaire>("anc-contact")
+            json.encodeToString(q)
+        } catch (e: Exception) {
+            Log.w("AncRepository", "Could not get Questionnaire from engine, using asset fallback", e)
+            context.assets.open("anc-contact.json").bufferedReader().use { it.readText() }
+        }
+    }
+
+    suspend fun saveVisit(patientId: String, response: QuestionnaireResponse) {
+        val answers = mutableMapOf<String, MutableList<QuestionnaireResponse.Item.Answer>>()
+        fun collect(items: List<QuestionnaireResponse.Item>) {
+            items.forEach { item ->
+                item.linkId.value?.let { answers.getOrPut(it) { mutableListOf() }.addAll(item.answer) }
+                collect(item.item)
+                item.answer.forEach { collect(it.item) }
+            }
+        }
+        collect(response.item)
+
+        // visit-date
+        val visitDate = answers["visit-date"]?.firstOrNull()?.value?.asDate()?.value?.value?.toString()
+            ?: answers["visit-date"]?.firstOrNull()?.value?.asDateTime()?.value?.value?.toString()?.substringBefore("T")
+            ?: LocalDate.now().toString()
+
+        // gestational-age
+        val gestationalAgeInt = answers["gestational-age"]?.firstOrNull()?.value?.asInteger()?.value?.value
+            ?: answers["gestational-age"]?.firstOrNull()?.value?.asDecimal()?.value?.value?.toString()?.toIntOrNull()
+
+        // weight
+        val weightDecimal = answers["weight"]?.firstOrNull()?.value?.asDecimal()?.value?.value
+            ?: answers["weight"]?.firstOrNull()?.value?.asQuantity()?.value?.value?.value
+
+        // bp-systolic
+        val systolicInt = answers["bp-systolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+
+        // bp-diastolic
+        val diastolicInt = answers["bp-diastolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+
+        // danger-signs
+        val dangerSigns = answers["danger-signs"].orEmpty().mapNotNull { ans ->
+            ans.value?.asCoding()?.value?.let { coding ->
+                coding.display?.value ?: coding.code?.value
+            } ?: ans.value?.asString()?.value?.value
+        }
+
+        // notes
+        val notes = answers["notes"]?.firstOrNull()?.value?.asString()?.value?.value
+
+        val encounterId = UUID.randomUUID().toString()
+
+        val encounter = Encounter(
+            id = encounterId,
+            status = Enumeration(value = Encounter.EncounterStatus.Finished),
+            `class` = Coding(
+                system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"),
+                code = Code(value = "AMB"),
+                display = FhirString(value = "ambulatory")
+            ),
+            type = listOf(
+                CodeableConcept(
+                    text = FhirString(value = "Antenatal care contact")
+                )
+            ),
+            subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+            period = FhirPeriod(
+                start = DateTime(value = FhirDateTime.fromString(visitDate)),
+                end = DateTime(value = FhirDateTime.fromString(visitDate))
+            )
+        )
+
+        val weightObs = weightDecimal?.let { w ->
+            Observation(
+                id = UUID.randomUUID().toString(),
+                status = Enumeration(value = Observation.ObservationStatus.Final),
+                category = listOf(
+                    CodeableConcept(
+                        coding = listOf(
+                            Coding(
+                                system = Uri(value = "http://terminology.hl7.org/CodeSystem/observation-category"),
+                                code = Code(value = "vital-signs"),
+                                display = FhirString(value = "Vital Signs")
+                            )
+                        )
+                    )
+                ),
+                code = CodeableConcept(
+                    coding = listOf(
+                        Coding(
+                            system = Uri(value = "http://loinc.org"),
+                            code = Code(value = "29463-7"),
+                            display = FhirString(value = "Body weight")
+                        )
+                    ),
+                    text = FhirString(value = "Body weight")
+                ),
+                subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+                encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")),
+                effective = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(visitDate))),
+                value = Observation.Value.Quantity(
+                    Quantity(
+                        value = Decimal(value = w),
+                        unit = FhirString(value = "kg"),
+                        system = Uri(value = "http://unitsofmeasure.org"),
+                        code = Code(value = "kg")
+                    )
+                )
+            )
+        }
+
+        val bpObs = if (systolicInt != null || diastolicInt != null) {
+            Observation(
+                id = UUID.randomUUID().toString(),
+                status = Enumeration(value = Observation.ObservationStatus.Final),
+                category = listOf(
+                    CodeableConcept(
+                        coding = listOf(
+                            Coding(
+                                system = Uri(value = "http://terminology.hl7.org/CodeSystem/observation-category"),
+                                code = Code(value = "vital-signs"),
+                                display = FhirString(value = "Vital Signs")
+                            )
+                        )
+                    )
+                ),
+                code = CodeableConcept(
+                    coding = listOf(
+                        Coding(
+                            system = Uri(value = "http://loinc.org"),
+                            code = Code(value = "85354-9"),
+                            display = FhirString(value = "Blood pressure panel with all children optional")
+                        )
+                    ),
+                    text = FhirString(value = "Blood pressure")
+                ),
+                subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+                encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")),
+                effective = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(visitDate))),
+                component = listOfNotNull(
+                    systolicInt?.let { sys ->
+                        Observation.Component(
+                            code = CodeableConcept(
+                                coding = listOf(
+                                    Coding(
+                                        system = Uri(value = "http://loinc.org"),
+                                        code = Code(value = "8480-6"),
+                                        display = FhirString(value = "Systolic blood pressure")
+                                    )
+                                )
+                            ),
+                            value = Observation.Component.Value.Quantity(
+                                Quantity(
+                                    value = Decimal(value = BigDecimal.fromInt(sys)),
+                                    unit = FhirString(value = "mmHg"),
+                                    system = Uri(value = "http://unitsofmeasure.org"),
+                                    code = Code(value = "mm[Hg]")
+                                )
+                            )
+                        )
+                    },
+                    diastolicInt?.let { dia ->
+                        Observation.Component(
+                            code = CodeableConcept(
+                                coding = listOf(
+                                    Coding(
+                                        system = Uri(value = "http://loinc.org"),
+                                        code = Code(value = "8462-4"),
+                                        display = FhirString(value = "Diastolic blood pressure")
+                                    )
+                                )
+                            ),
+                            value = Observation.Component.Value.Quantity(
+                                Quantity(
+                                    value = Decimal(value = BigDecimal.fromInt(dia)),
+                                    unit = FhirString(value = "mmHg"),
+                                    system = Uri(value = "http://unitsofmeasure.org"),
+                                    code = Code(value = "mm[Hg]")
+                                )
+                            )
+                        )
+                    }
+                )
+            )
+        } else null
+
+        val gaObs = gestationalAgeInt?.let { ga ->
+            Observation(
+                id = UUID.randomUUID().toString(),
+                status = Enumeration(value = Observation.ObservationStatus.Final),
+                code = CodeableConcept(
+                    coding = listOf(
+                        Coding(
+                            system = Uri(value = "http://loinc.org"),
+                            code = Code(value = "18185-9"),
+                            display = FhirString(value = "Gestational age")
+                        )
+                    ),
+                    text = FhirString(value = "Gestational age")
+                ),
+                subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+                encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")),
+                effective = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(visitDate))),
+                value = Observation.Value.Quantity(
+                    Quantity(
+                        value = Decimal(value = BigDecimal.fromInt(ga)),
+                        unit = FhirString(value = "wk"),
+                        system = Uri(value = "http://unitsofmeasure.org"),
+                        code = Code(value = "wk")
+                    )
+                )
+            )
+        }
+
+        val dangerObs = if (dangerSigns.isNotEmpty()) {
+            Observation(
+                id = UUID.randomUUID().toString(),
+                status = Enumeration(value = Observation.ObservationStatus.Final),
+                code = CodeableConcept(
+                    text = FhirString(value = "Danger signs")
+                ),
+                subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+                encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")),
+                effective = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(visitDate))),
+                value = Observation.Value.String(FhirString(value = dangerSigns.joinToString(", ")))
+            )
+        } else null
+
+        val notesObs = if (!notes.isNullOrBlank()) {
+            Observation(
+                id = UUID.randomUUID().toString(),
+                status = Enumeration(value = Observation.ObservationStatus.Final),
+                code = CodeableConcept(
+                    text = FhirString(value = "Clinical notes")
+                ),
+                subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+                encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")),
+                effective = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(visitDate))),
+                value = Observation.Value.String(FhirString(value = notes))
+            )
+        } else null
+
+        val completedResponse = response.toBuilder().apply {
+            id = UUID.randomUUID().toString()
+            status = Enumeration(value = QuestionnaireResponse.QuestionnaireResponseStatus.Completed)
+            subject = Reference(reference = FhirString(value = "Patient/$patientId")).toBuilder()
+            questionnaire = Canonical(value = "http://example.org/fhir/Questionnaire/anc-contact").toBuilder()
+        }.build()
+
+        val resources = listOfNotNull(
+            encounter,
+            weightObs,
+            bpObs,
+            gaObs,
+            dangerObs,
+            notesObs,
+            completedResponse,
+        )
+
+        engine.create(*resources.toTypedArray())
+
+        // Trigger sync behind in-flight sync
+        try {
+            Sync.oneTimeSync<AppSyncWorker>(
+                context.applicationContext,
+                existingWorkPolicy = ExistingWorkPolicy.APPEND_OR_REPLACE,
+            )
+        } catch (e: Exception) {
+            Log.e("AncRepository", "Failed to enqueue upload sync", e)
+        }
+    }
+}
