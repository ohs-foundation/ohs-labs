+package com.example.ancapp.ui.register
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.example.ancapp.data.AncRepository
+import com.example.ancapp.domain.Gestation
+import com.example.ancapp.domain.ageOn
+import kotlinx.coroutines.flow.SharingStarted
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.flow.stateIn
+import java.time.LocalDate
+
+data class RegisterEntry(
+  val patientId: Long,
+  val name: String,
+  val age: Int,
+  val estimatedDueDate: LocalDate,
+  val gestationLabel: String,
+  val gestationProgress: Float,
+)
+
+data class RegisterUiState(
+  val entries: List<RegisterEntry> = emptyList(),
+  val isLoading: Boolean = true,
+)
+
+class RegisterViewModel(repository: AncRepository) : ViewModel() {
+
+  val uiState: StateFlow<RegisterUiState> = repository.observeRegister()
+    .map { patients ->
+      val today = LocalDate.now()
+      RegisterUiState(
+        // The DAO already sorts by due date; keep that order.
+        entries = patients.map { patient ->
+          RegisterEntry(
+            patientId = patient.id,
+            name = patient.name,
+            age = ageOn(patient.dateOfBirth, today),
+            estimatedDueDate = patient.estimatedDueDate,
+            gestationLabel = Gestation.format(patient.estimatedDueDate, today),
+            gestationProgress = Gestation.progressOn(patient.estimatedDueDate, today),
+          )
+        },
+        isLoading = false,
+      )
+    }
+    .stateIn(
+      scope = viewModelScope,
+      started = SharingStarted.WhileSubscribed(5_000),
+      initialValue = RegisterUiState(),
+    )
+}
