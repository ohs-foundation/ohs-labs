+@OptIn(ExperimentalMaterial3Api::class, ExperimentalLayoutApi::class)
+@Composable
+fun RecordVisitScreen(
+    patient: PatientInfo,
+    dangerSignOptions: List<DangerSignOption>,
+    isSaving: Boolean,
+    saveErrorMessage: String?,
+    onBack: () -> Unit,
+    onSaveVisit: (
+        visitDate: String,
+        gestationalAgeWeeks: Int?,
+        weightKg: Double?,
+        systolicBp: Int?,
+        diastolicBp: Int?,
+        dangerSigns: List<DangerSignOption>,
+        notes: String?
+    ) -> Unit
+) {
+    val today = remember { LocalDate.now() }
+    var visitDate by remember { mutableStateOf(today.toString()) }
+    var gestationalAgeText by remember {
+        mutableStateOf(patient.gestationalAgeWeeks?.toString() ?: "")
+    }
+    var weightText by remember { mutableStateOf("") }
+    var systolicBpText by remember { mutableStateOf("") }
+    var diastolicBpText by remember { mutableStateOf("") }
+
+    // Danger signs state: Set of selected codes
