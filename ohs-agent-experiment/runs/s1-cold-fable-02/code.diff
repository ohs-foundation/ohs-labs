+package com.example.ancapp.data
+
+import androidx.room.Dao
+import androidx.room.Insert
+import androidx.room.Query
+import kotlinx.coroutines.flow.Flow
+
+@Dao
+interface AncDao {
+  @Query("SELECT * FROM patients ORDER BY dueDate ASC, name ASC")
+  fun patientsByDueDate(): Flow<List<Patient>>
+
+  @Query("SELECT * FROM patients WHERE id = :id")
+  fun patient(id: Long): Flow<Patient?>
+
+  @Query("SELECT * FROM visits WHERE patientId = :patientId ORDER BY date DESC, id DESC")
+  fun visitsForPatient(patientId: Long): Flow<List<Visit>>
+
+  @Insert
+  suspend fun insertVisit(visit: Visit): Long
+}
