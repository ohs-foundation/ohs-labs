@@ -0,0 +1,19 @@
+package com.example.ancapp
+
+import java.time.LocalDate
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class DatesTest {
+  @Test fun gestationalAge() {
+    val edd = LocalDate.parse("2026-12-05")
+    assertEquals(40, gaWeeksOn(edd, edd))
+    assertEquals(23, gaWeeksOn(edd, LocalDate.parse("2026-08-10"))) // 117 days before EDD
+  }
+
+  @Test fun age() {
+    val dob = LocalDate.parse("1996-04-12")
+    assertEquals(30, ageOn(dob, LocalDate.parse("2026-10-13")))
+    assertEquals(29, ageOn(dob, LocalDate.parse("2026-04-11")))
+  }
+}
