+package com.example.ancapp.ui
+
+import android.app.Application
+import androidx.lifecycle.AndroidViewModel
+import androidx.lifecycle.viewModelScope
+import com.example.ancapp.data.AncRepository
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+
+class RecordVisitViewModel(app: Application) : AndroidViewModel(app) {
+  private val repository = AncRepository(app)
+
+  private val _questionnaireJson = MutableStateFlow<String?>(null)
+  val questionnaireJson = _questionnaireJson.asStateFlow()
+
+  fun loadQuestionnaire() {
+    viewModelScope.launch {
+      try {
+        _questionnaireJson.value = repository.getQuestionnaireJson()
+      } catch (e: Exception) {
+        _questionnaireJson.value = AncRepository.BUNDLED_ANC_QUESTIONNAIRE_JSON
+      }
+    }
+  }
+
+  suspend fun saveVisit(patientId: String, response: QuestionnaireResponse) {
+    repository.saveNewVisit(patientId, response)
+  }
+}
