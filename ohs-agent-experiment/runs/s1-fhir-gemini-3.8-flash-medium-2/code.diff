+package com.example.ancapp.data
+
+import java.time.LocalDate
+import java.time.Period
+import java.time.temporal.ChronoUnit
+
+data class PatientInfo(
+    val id: String,
+    val fullName: String,
+    val birthDate: LocalDate?,
+    val edd: LocalDate?,
+    val phone: String? = null,
+    val identifier: String? = null
+) {
+    val age: Int?
+        get() {
+            val dob = birthDate ?: return null
+            return Period.between(dob, LocalDate.now()).years
+        }
+
+    val gestationalAgeWeeks: Int?
+        get() {
+            val due = edd ?: return null
+            // Standard obstetrics: LMP = EDD - 280 days (40 weeks)
+            val lmp = due.minusDays(280)
+            val today = LocalDate.now()
+            val days = ChronoUnit.DAYS.between(lmp, today)
+            return (days / 7).toInt()
+        }
+}
+
+data class AncVisit(
+    val id: String,
+    val date: LocalDate?,
+    val dateString: String,
+    val weightKg: Double? = null,
+    val systolicBp: Int? = null,
+    val diastolicBp: Int? = null,
+    val hemoglobin: Double? = null,
+    val gestationalAgeWeeks: Int? = null,
+    val dangerSigns: List<String> = emptyList(),
+    val notes: String? = null
+) {
+    val bpDisplay: String?
+        get() {
+            return if (systolicBp != null && diastolicBp != null) {
+                "$systolicBp/$diastolicBp mmHg"
+            } else if (systolicBp != null) {
+                "$systolicBp mmHg"
+            } else {
+                null
+            }
+        }
+
+    val weightDisplay: String?
+        get() = weightKg?.let { "$it kg" }
+
+    val hemoglobinDisplay: String?
+        get() = hemoglobin?.let { "$it g/dL" }
+
+    val gestationalAgeDisplay: String?
+        get() = gestationalAgeWeeks?.let { "$it weeks" }
+}
+
+data class DangerSignOption(
+    val code: String,
+    val display: String
+)
diff --git a/app/src/main/java/com/example/ancapp/ui/AncViewModel.kt b/app/src/main/java/com/example/ancapp/ui/AncViewModel.kt
