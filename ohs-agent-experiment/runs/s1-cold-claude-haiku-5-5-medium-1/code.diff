+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun VisitFormScreen(patient: Patient, onSave: (Visit) -> Unit, onCancel: () -> Unit) {
+  val today = LocalDate.now()
+  var date by rememberSaveable { mutableStateOf(today.toString()) }
+  var weeks by rememberSaveable { mutableStateOf(patient.gestationalWeeksOn(today).toString()) }
+  var weight by rememberSaveable { mutableStateOf("") }
+  var systolic by rememberSaveable { mutableStateOf("") }
+  var diastolic by rememberSaveable { mutableStateOf("") }
+  var signs by remember { mutableStateOf(emptySet<DangerSign>()) }
+  var notes by rememberSaveable { mutableStateOf("") }
+
+  val parsedDate = date.toDateOrNull()
+  val parsedWeeks = weeks.toIntOrNull()?.takeIf { it in 1..44 }
+  val parsedWeight = weight.toDoubleOrNull()?.takeIf { it in 20.0..250.0 }
+  val parsedSystolic = systolic.toIntOrNull()?.takeIf { it in 50..300 }
+  val parsedDiastolic = diastolic.toIntOrNull()?.takeIf { it in 30..200 }
+  val visit = if (
+    parsedDate != null && parsedWeeks != null && parsedWeight != null &&
+    parsedSystolic != null && parsedDiastolic != null
+  ) {
+    Visit(
+      patientId = patient.id,
+      date = parsedDate,
+      gestationWeeks = parsedWeeks,
+      weightKg = parsedWeight,
+      systolic = parsedSystolic,
+      diastolic = parsedDiastolic,
+      hemoglobin = null,
+      dangerSigns = signs,
+      notes = notes.trim(),
+    )
+  } else {
+    null
+  }
+
+  Scaffold(
+    topBar = {
+      TopAppBar(
+        title = { Text("New visit · ${patient.name}") },
+        navigationIcon = {
+          IconButton(onClick = onCancel) { Icon(Icons.AutoMirrored.Filled.ArrowBack, "Back") }
+        },
+      )
+    },
+  ) { padding ->
+    Column(
+      Modifier
+        .padding(padding)
+        .padding(16.dp)
+        .verticalScroll(rememberScrollState()),
+      verticalArrangement = Arrangement.spacedBy(12.dp),
+    ) {
+      FormField(
+        label = "Visit date (YYYY-MM-DD)",
+        value = date,
+        onValueChange = { date = it },
+        isError = date.isNotBlank() && parsedDate == null,
+        keyboardType = KeyboardType.Text,
+      )
+      FormField(
+        label = "Gestational age (weeks)",
+        value = weeks,
+        onValueChange = { weeks = it },
+        isError = weeks.isNotBlank() && parsedWeeks == null,
+      )
+      FormField(
+        label = "Weight (kg)",
+        value = weight,
+        onValueChange = { weight = it },
+        isError = weight.isNotBlank() && parsedWeight == null,
+      )
+      Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+        FormField(
+          label = "Systolic (mmHg)",
+          value = systolic,
+          onValueChange = { systolic = it },
+          isError = systolic.isNotBlank() && parsedSystolic == null,
+          modifier = Modifier.weight(1f),
+        )
+        FormField(
+          label = "Diastolic (mmHg)",
+          value = diastolic,
+          onValueChange = { diastolic = it },
+          isError = diastolic.isNotBlank() && parsedDiastolic == null,
+          modifier = Modifier.weight(1f),
+        )
+      }
+
+      Text("Danger signs", style = MaterialTheme.typography.titleSmall)
+      CheckRow("None", checked = signs.isEmpty()) { signs = emptySet() }
+      DangerSign.entries.forEach { sign ->
+        CheckRow(sign.label, checked = sign in signs) {
+          signs = if (sign in signs) signs - sign else signs + sign
+        }
+      }
+
+      OutlinedTextField(
+        value = notes,
+        onValueChange = { notes = it },
+        label = { Text("Notes") },
+        modifier = Modifier.fillMaxWidth(),
+        minLines = 3,
+      )
+
+      Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+        OutlinedButton(onClick = onCancel) { Text("Cancel") }
+        Button(enabled = visit != null, onClick = { visit?.let(onSave) }) { Text("Save visit") }
+      }
+    }
+  }
+}
+
+@Composable
+fun FormField(
+  label: String,
+  value: String,
+  onValueChange: (String) -> Unit,
+  isError: Boolean,
+  modifier: Modifier = Modifier.fillMaxWidth(),
+  keyboardType: KeyboardType = KeyboardType.Decimal,
+) {
+  OutlinedTextField(
+    value = value,
+    onValueChange = onValueChange,
+    label = { Text(label) },
+    isError = isError,
+    singleLine = true,
+    keyboardOptions = KeyboardOptions(keyboardType = keyboardType),
+    modifier = modifier,
+  )
+}
+
+@Composable
+fun CheckRow(label: String, checked: Boolean, onToggle: () -> Unit) {
+  Row(
+    Modifier
+      .fillMaxWidth()
+      .toggleable(value = checked, role = Role.Checkbox, onValueChange = { onToggle() }),
+    verticalAlignment = Alignment.CenterVertically,
+  ) {
+    Checkbox(checked = checked, onCheckedChange = null)
+    Text(label)
+  }
+}
+
+private fun String.toDateOrNull(): LocalDate? = runCatching { LocalDate.parse(this) }.getOrNull()
