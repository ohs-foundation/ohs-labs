+++ b/app/src/main/java/com/example/ancapp/data/AncRepository.kt
@@ -0,0 +1,516 @@
+package com.example.ancapp.data
+
+import android.content.Context
+import com.ionspin.kotlin.bignum.decimal.BigDecimal
+import dev.ohs.fhir.engine.FhirEngineProvider
+import dev.ohs.fhir.engine.get
+import dev.ohs.fhir.engine.search.ReferenceClientParam
+import dev.ohs.fhir.engine.search.Search
+import dev.ohs.fhir.model.r4.Canonical
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.CodeableConcept
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.DateTime
+import dev.ohs.fhir.model.r4.Decimal
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Enumeration
+import dev.ohs.fhir.model.r4.FhirDateTime
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Patient
+import dev.ohs.fhir.model.r4.Period
+import dev.ohs.fhir.model.r4.Quantity
+import dev.ohs.fhir.model.r4.Questionnaire
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import dev.ohs.fhir.model.r4.Reference
+import dev.ohs.fhir.model.r4.Resource
+import dev.ohs.fhir.model.r4.String as FhirString
+import dev.ohs.fhir.model.r4.Uri
+import dev.ohs.fhir.model.r4.terminologies.ResourceType
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import java.time.LocalDate
+import java.time.Period as JavaPeriod
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+
+data class PatientItem(
+  val id: String,
+  val name: String,
+  val age: Int?,
+  val estimatedDueDate: LocalDate?,
+  val gestationalAgeWeeks: Int?,
+  val birthDate: String?,
+)
+
+data class VisitItem(
+  val encounterId: String,
+  val date: String,
+  val weight: String?,
+  val bloodPressure: String?,
+  val hemoglobin: String?,
+  val gestationalAge: String? = null,
+  val dangerSigns: List<String> = emptyList(),
+  val notes: String? = null,
+)
+
+class AncRepository(private val context: Context) {
+  private val engine = FhirEngineProvider.getInstance(context)
+
+  private val fhirJson = Json {
+    explicitNulls = false
+    encodeDefaults = false
+    ignoreUnknownKeys = true
+  }
+
+  suspend fun getPatients(): List<PatientItem> {
+    val patients = engine.search<Patient>(Search(ResourceType.Patient)).map { it.resource }
+    val allObservations = engine.search<Observation>(Search(ResourceType.Observation)).map { it.resource }
+
+    // Group observations by patient id
+    val obsByPatient = allObservations.groupBy { obs ->
+      obs.subject?.reference?.value?.substringAfter("/") ?: ""
+    }
+
+    val today = LocalDate.now()
+
+    val patientItems = patients.map { patient ->
+      val patientId = patient.id ?: ""
+      val nameElem = patient.name.firstOrNull()
+      val name = listOfNotNull(
+        nameElem?.given?.mapNotNull { it.value }?.joinToString(" ")?.ifBlank { null },
+        nameElem?.family?.value,
+      ).joinToString(" ").ifBlank { patientId }
+
+      val dobStr = patient.birthDate?.value?.toString()
+      val dob = dobStr?.let { runCatching { LocalDate.parse(it) }.getOrNull() }
+      val age = dob?.let { JavaPeriod.between(it, today).years }
+
+      val patientObs = obsByPatient[patientId].orEmpty()
+
+      // Find EDD observation: LOINC 11778-8
+      val eddObs = patientObs.firstOrNull { obs ->
+        obs.code.coding.any { it.code?.value == "11778-8" }
+      }
+      val edd = eddObs?.let { extractObservationDate(it) }
+
+      // Gestational age in weeks: EDD - 280 days = LMP, weeks = (today - LMP) / 7
+      val gaWeeks = edd?.let {
+        val lmp = it.minusDays(280)
+        val days = ChronoUnit.DAYS.between(lmp, today)
+        (days / 7).toInt().coerceAtLeast(0)
+      }
+
+      PatientItem(
+        id = patientId,
+        name = name,
+        age = age,
+        estimatedDueDate = edd,
+        gestationalAgeWeeks = gaWeeks,
+        birthDate = dobStr,
+      )
+    }
+
+    // Sorted by due date (soonest first)
+    return patientItems.sortedWith(compareBy(nullsLast()) { it.estimatedDueDate })
+  }
+
+  suspend fun getPatient(patientId: String): PatientItem? {
+    return getPatients().firstOrNull { it.id == patientId }
+  }
+
+  suspend fun getPastVisits(patientId: String): List<VisitItem> {
+    val encounters = engine.search<Encounter>(
+      Search(ResourceType.Encounter).apply {
+        filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+      }
+    ).map { it.resource }
+
+    val observations = engine.search<Observation>(
+      Search(ResourceType.Observation).apply {
+        filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+      }
+    ).map { it.resource }
+
+    // Group observations by encounter ID
+    val obsByEncounter = observations.groupBy { obs ->
+      obs.encounter?.reference?.value?.substringAfter("/") ?: ""
+    }
+
+    val visitItems = encounters.map { encounter ->
+      val encId = encounter.id ?: ""
+      val encObs = obsByEncounter[encId].orEmpty()
+
+      // Visit Date
+      val date = encounter.period?.start?.value?.toString()
+        ?: encObs.firstOrNull()?.let { extractObservationDate(it)?.toString() }
+        ?: "Unknown date"
+
+      // Weight: LOINC 29463-7
+      val weightObs = encObs.firstOrNull { obs ->
+        obs.code.coding.any { it.code?.value == "29463-7" }
+      }
+      val weight = weightObs?.let { obs ->
+        val q = obs.value?.asQuantity()?.value
+        val num = q?.value?.value?.toPlainString()
+        val unit = q?.unit?.value ?: "kg"
+        if (num != null) "$num $unit" else null
+      }
+
+      // Blood Pressure: LOINC 85354-9 (or has BP components 8480-6 / 8462-4)
+      val bpObs = encObs.firstOrNull { obs ->
+        obs.code.coding.any { it.code?.value == "85354-9" } ||
+          obs.component.any { c -> c.code.coding.any { it.code?.value == "8480-6" } }
+      }
+      val bloodPressure = bpObs?.let { obs ->
+        val systolic = obs.component.firstOrNull { c ->
+          c.code.coding.any { it.code?.value == "8480-6" }
+        }?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+
+        val diastolic = obs.component.firstOrNull { c ->
+          c.code.coding.any { it.code?.value == "8462-4" }
+        }?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+
+        if (systolic != null && diastolic != null) {
+          "$systolic/$diastolic mmHg"
+        } else if (systolic != null) {
+          "$systolic mmHg"
+        } else null
+      }
+
+      // Hemoglobin: LOINC 718-7
+      val hbObs = encObs.firstOrNull { obs ->
+        obs.code.coding.any { it.code?.value == "718-7" }
+      }
+      val hemoglobin = hbObs?.let { obs ->
+        val q = obs.value?.asQuantity()?.value
+        val num = q?.value?.value?.toPlainString()
+        val unit = q?.unit?.value ?: "g/dL"
+        if (num != null) "$num $unit" else null
+      }
+
+      // Gestational age: LOINC 18185-9
+      val gaObs = encObs.firstOrNull { obs ->
+        obs.code.coding.any { it.code?.value == "18185-9" }
+      }
+      val gestationalAge = gaObs?.let { obs ->
+        val q = obs.value?.asQuantity()?.value
+        val num = q?.value?.value?.toPlainString()
+        if (num != null) "$num weeks" else null
+      }
+
+      // Danger signs
+      val dangerObs = encObs.firstOrNull { obs ->
+        obs.code.coding.any { it.code?.value == "danger-signs" }
+      }
+      val dangerSigns = dangerObs?.value?.asString()?.value?.value
+        ?.split(",")?.map { it.trim() }?.filter { it.isNotBlank() } ?: emptyList()
+
+      // Notes
+      val notes = encounter.reasonCode.firstOrNull()?.text?.value
+
+      VisitItem(
+        encounterId = encId,
+        date = date.substringBefore("T"),
+        weight = weight,
+        bloodPressure = bloodPressure,
+        hemoglobin = hemoglobin,
+        gestationalAge = gestationalAge,
+        dangerSigns = dangerSigns,
+        notes = notes,
+      )
+    }
+
+    return visitItems.sortedByDescending { it.date }
+  }
+
+  suspend fun getQuestionnaireJson(): String {
+    try {
+      val q = engine.get<Questionnaire>("anc-contact")
+      return fhirJson.encodeToString(q)
+    } catch (e: Exception) {
+      return context.assets.open("questionnaires/anc-contact.json")
+        .bufferedReader()
+        .use { it.readText() }
+    }
+  }
+
+  suspend fun saveVisit(patientId: String, response: QuestionnaireResponse) {
+    val answers = mutableMapOf<String, MutableList<QuestionnaireResponse.Item.Answer>>()
+    fun collect(items: List<QuestionnaireResponse.Item>) {
+      items.forEach { item ->
+        item.linkId.value?.let { answers.getOrPut(it) { mutableListOf() }.addAll(item.answer) }
+        collect(item.item)
+        item.answer.forEach { collect(it.item) }
+      }
+    }
+    collect(response.item)
+
+    // Extract fields
+    val visitDateStr = extractAnswerDate(answers["visit-date"]?.firstOrNull()) ?: LocalDate.now().toString()
+    val gaWeeks = extractAnswerInteger(answers["gestational-age"]?.firstOrNull())
+    val weightVal = extractAnswerDecimal(answers["vitals.weight"]?.firstOrNull() ?: answers["weight"]?.firstOrNull())
+    val systolicVal = extractAnswerInteger(answers["vitals.bp-systolic"]?.firstOrNull() ?: answers["bp-systolic"]?.firstOrNull())
+    val diastolicVal = extractAnswerInteger(answers["vitals.bp-diastolic"]?.firstOrNull() ?: answers["bp-diastolic"]?.firstOrNull())
+
+    val dangerSignsAnswers = answers["danger-signs"].orEmpty().mapNotNull { answer ->
+      answer.value?.asCoding()?.value?.display?.value
+        ?: answer.value?.asCoding()?.value?.code?.value
+        ?: answer.value?.asString()?.value?.value
+    }.filter { !it.equals("none", ignoreCase = true) }
+
+    val notesText = answers["notes"]?.firstOrNull()?.value?.asString()?.value?.value
+
+    val encounterId = UUID.randomUUID().toString()
+    val fhirVisitDateTime = FhirDateTime.fromString(visitDateStr)
+
+    val resourcesToCreate = mutableListOf<Resource>()
+
+    // 1. Encounter
+    val ancEncounter = Encounter(
+      id = encounterId,
+      status = Enumeration(value = Encounter.EncounterStatus.Finished),
+      `class` = Coding(
+        system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"),
+        code = Code(value = "AMB"),
+        display = FhirString(value = "ambulatory"),
+      ),
+      type = listOf(
+        CodeableConcept(
+          text = FhirString(value = "Antenatal care contact"),
+        ),
+      ),
+      subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+      period = Period(
+        start = DateTime(value = fhirVisitDateTime),
+        end = DateTime(value = fhirVisitDateTime),
+      ),
+      reasonCode = if (!notesText.isNullOrBlank()) listOf(CodeableConcept(text = FhirString(value = notesText))) else emptyList(),
+    )
+    resourcesToCreate.add(ancEncounter)
+
+    // 2. Weight observation
+    if (weightVal != null) {
+      val weightObs = Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        category = listOf(
+          CodeableConcept(
+            coding = listOf(
+              Coding(
+                system = Uri(value = "http://terminology.hl7.org/CodeSystem/observation-category"),
+                code = Code(value = "vital-signs"),
+                display = FhirString(value = "Vital Signs"),
+              ),
+            ),
+          ),
+        ),
+        code = CodeableConcept(
+          coding = listOf(
+            Coding(
+              system = Uri(value = "http://loinc.org"),
+              code = Code(value = "29463-7"),
+              display = FhirString(value = "Body weight"),
+            ),
+          ),
+          text = FhirString(value = "Body weight"),
+        ),
+        subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+        encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")),
+        effective = Observation.Effective.DateTime(DateTime(value = fhirVisitDateTime)),
+        value = Observation.Value.Quantity(
+          Quantity(
+            value = Decimal(value = weightVal),
+            unit = FhirString(value = "kg"),
+            system = Uri(value = "http://unitsofmeasure.org"),
+            code = Code(value = "kg"),
+          ),
+        ),
+      )
+      resourcesToCreate.add(weightObs)
+    }
+
+    // 3. Blood Pressure observation
+    if (systolicVal != null || diastolicVal != null) {
+      val components = mutableListOf<Observation.Component>()
+      if (systolicVal != null) {
+        components.add(
+          Observation.Component(
+            code = CodeableConcept(
+              coding = listOf(
+                Coding(
+                  system = Uri(value = "http://loinc.org"),
+                  code = Code(value = "8480-6"),
+                  display = FhirString(value = "Systolic blood pressure"),
+                ),
+              ),
+            ),
+            value = Observation.Component.Value.Quantity(
+              Quantity(
+                value = Decimal(value = BigDecimal.fromInt(systolicVal)),
+                unit = FhirString(value = "mmHg"),
+                system = Uri(value = "http://unitsofmeasure.org"),
+                code = Code(value = "mm[Hg]"),
+              ),
+            ),
+          ),
+        )
+      }
+      if (diastolicVal != null) {
+        components.add(
+          Observation.Component(
+            code = CodeableConcept(
+              coding = listOf(
+                Coding(
+                  system = Uri(value = "http://loinc.org"),
+                  code = Code(value = "8462-4"),
+                  display = FhirString(value = "Diastolic blood pressure"),
+                ),
+              ),
+            ),
+            value = Observation.Component.Value.Quantity(
+              Quantity(
+                value = Decimal(value = BigDecimal.fromInt(diastolicVal)),
+                unit = FhirString(value = "mmHg"),
+                system = Uri(value = "http://unitsofmeasure.org"),
+                code = Code(value = "mm[Hg]"),
+              ),
+            ),
+          ),
+        )
+      }
+
+      val bpObs = Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        category = listOf(
+          CodeableConcept(
+            coding = listOf(
+              Coding(
+                system = Uri(value = "http://terminology.hl7.org/CodeSystem/observation-category"),
+                code = Code(value = "vital-signs"),
+                display = FhirString(value = "Vital Signs"),
+              ),
+            ),
+          ),
+        ),
+        code = CodeableConcept(
+          coding = listOf(
+            Coding(
+              system = Uri(value = "http://loinc.org"),
+              code = Code(value = "85354-9"),
+              display = FhirString(value = "Blood pressure panel with all children optional"),
+            ),
+          ),
+          text = FhirString(value = "Blood pressure"),
+        ),
+        subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+        encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")),
+        effective = Observation.Effective.DateTime(DateTime(value = fhirVisitDateTime)),
+        component = components,
+      )
+      resourcesToCreate.add(bpObs)
+    }
+
+    // 4. Gestational age observation (if entered)
+    if (gaWeeks != null) {
+      val gaObs = Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        code = CodeableConcept(
+          coding = listOf(
+            Coding(
+              system = Uri(value = "http://loinc.org"),
+              code = Code(value = "18185-9"),
+              display = FhirString(value = "Gestational age"),
+            ),
+          ),
+          text = FhirString(value = "Gestational age"),
+        ),
+        subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+        encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")),
+        effective = Observation.Effective.DateTime(DateTime(value = fhirVisitDateTime)),
+        value = Observation.Value.Quantity(
+          Quantity(
+            value = Decimal(value = BigDecimal.fromInt(gaWeeks)),
+            unit = FhirString(value = "weeks"),
+            system = Uri(value = "http://unitsofmeasure.org"),
+            code = Code(value = "wk"),
+          ),
+        ),
+      )
+      resourcesToCreate.add(gaObs)
+    }
+
+    // 5. Danger signs observation (if entered)
+    if (dangerSignsAnswers.isNotEmpty()) {
+      val dangerObs = Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        code = CodeableConcept(
+          coding = listOf(
+            Coding(
+              system = Uri(value = "urn:example:anc-danger-signs"),
+              code = Code(value = "danger-signs"),
+              display = FhirString(value = "Danger signs present"),
+            ),
+          ),
+          text = FhirString(value = "Danger signs present"),
+        ),
+        subject = Reference(reference = FhirString(value = "Patient/$patientId")),
+        encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")),
+        effective = Observation.Effective.DateTime(DateTime(value = fhirVisitDateTime)),
+        value = Observation.Value.String(FhirString(value = dangerSignsAnswers.joinToString(", "))),
+      )
+      resourcesToCreate.add(dangerObs)
+    }
+
+    // 6. QuestionnaireResponse
+    val completedResponse = response.toBuilder().apply {
+      id = UUID.randomUUID().toString()
+      status = Enumeration(value = QuestionnaireResponse.QuestionnaireResponseStatus.Completed)
+      subject = Reference(reference = FhirString(value = "Patient/$patientId")).toBuilder()
+      encounter = Reference(reference = FhirString(value = "Encounter/$encounterId")).toBuilder()
+      questionnaire = Canonical(value = "http://example.org/fhir/Questionnaire/anc-contact").toBuilder()
+    }.build()
+    resourcesToCreate.add(completedResponse)
+
+    // Persist all resources
+    engine.create(*resourcesToCreate.toTypedArray())
+  }
+
+  private fun extractObservationDate(obs: Observation): LocalDate? {
+    val dtStr = obs.value?.asDateTime()?.value?.value?.toString()
+    if (dtStr != null) {
+      runCatching { return LocalDate.parse(dtStr.substringBefore("T")) }
+    }
+    val effStr = obs.effective?.asDateTime()?.value?.value?.toString()
+    if (effStr != null) {
+      runCatching { return LocalDate.parse(effStr.substringBefore("T")) }
+    }
+    return null
+  }
+
+  private fun extractAnswerDate(answer: QuestionnaireResponse.Item.Answer?): String? {
+    if (answer == null) return null
+    answer.value?.asDate()?.value?.value?.toString()?.let { return it }
+    answer.value?.asDateTime()?.value?.value?.toString()?.let { return it.substringBefore("T") }
+    answer.value?.asString()?.value?.value?.let { return it.substringBefore("T") }
+    return null
+  }
+
+  private fun extractAnswerInteger(answer: QuestionnaireResponse.Item.Answer?): Int? {
+    if (answer == null) return null
+    answer.value?.asInteger()?.value?.value?.let { return it }
+    answer.value?.asDecimal()?.value?.value?.let { return it.intValue() }
+    answer.value?.asString()?.value?.value?.toIntOrNull()?.let { return it }
+    return null
+  }
+
+  private fun extractAnswerDecimal(answer: QuestionnaireResponse.Item.Answer?): BigDecimal? {
+    if (answer == null) return null
+    answer.value?.asDecimal()?.value?.value?.let { return it }
+    answer.value?.asInteger()?.value?.value?.let { return BigDecimal.fromInt(it) }
+    answer.value?.asString()?.value?.value?.let { runCatching { BigDecimal.parseString(it) }.getOrNull() }?.let { return it }
+    return null
+  }
+}
