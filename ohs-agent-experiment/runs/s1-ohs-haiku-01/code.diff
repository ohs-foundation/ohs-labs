+package com.example.ancapp.viewmodel
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.example.ancapp.data.AncRepository
+import com.example.ancapp.data.PatientEntity
+import com.example.ancapp.data.PatientWithVisits
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+import java.time.LocalDate
+
+class AncViewModel(private val repository: AncRepository) : ViewModel() {
+  private val _patients = MutableStateFlow<List<PatientEntity>>(emptyList())
+  val patients: StateFlow<List<PatientEntity>> = _patients.asStateFlow()
+
+  private val _selectedPatient = MutableStateFlow<PatientWithVisits?>(null)
+  val selectedPatient: StateFlow<PatientWithVisits?> = _selectedPatient.asStateFlow()
+
+  private val _isLoading = MutableStateFlow(false)
+  val isLoading: StateFlow<Boolean> = _isLoading.asStateFlow()
+
+  init {
+    loadPatients()
+    syncPatientsFromServer()
+  }
+
+  private fun loadPatients() {
+    viewModelScope.launch {
+      repository.getAllPatientsFlow().collect { patientList ->
+        _patients.value = patientList.sortedBy { it.estimatedDueDate }
+      }
+    }
+  }
+
+  fun syncPatientsFromServer() {
+    viewModelScope.launch {
+      _isLoading.value = true
+      repository.syncPatients()
+      _isLoading.value = false
+    }
+  }
+
+  fun selectPatient(patientId: String) {
+    viewModelScope.launch {
+      val patientWithVisits = repository.getPatientWithVisits(patientId)
+      _selectedPatient.value = patientWithVisits
+    }
+  }
+
+  fun recordAncVisit(
+    patientId: String,
+    visitDate: LocalDate,
+    gestationalAgeWeeks: Int,
+    weightKg: Double,
+    systolicBp: Int,
+    diastolicBp: Int,
+    hemoglobinGdl: Double? = null,
+    notes: String = "",
+    dangerSigns: List<String> = emptyList()
+  ) {
+    viewModelScope.launch {
+      repository.recordAncVisit(
+        patientId = patientId,
+        visitDate = visitDate,
+        gestationalAgeWeeks = gestationalAgeWeeks,
+        weightKg = weightKg,
+        systolicBp = systolicBp,
+        diastolicBp = diastolicBp,
+        hemoglobinGdl = hemoglobinGdl,
+        notes = notes,
+        dangerSigns = dangerSigns
+      )
+      selectPatient(patientId)
+    }
+  }
+
+  fun clearSelection() {
+    _selectedPatient.value = null
+  }
+}
