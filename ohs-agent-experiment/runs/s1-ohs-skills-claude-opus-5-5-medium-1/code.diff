+private const val LOINC = "http://loinc.org"
+private const val EDD = "11778-8"
+private const val WEIGHT = "29463-7"
+private const val BP_PANEL = "85354-9"
+private const val SYSTOLIC = "8480-6"
+private const val DIASTOLIC = "8462-4"
+private const val HB = "718-7"
+private const val GEST_AGE = "18185-9"
+private const val QUESTIONNAIRE_ID = "anc-contact"
+
+private val json = Json { explicitNulls = false; encodeDefaults = false; ignoreUnknownKeys = true }
+
+data class RegisterRow(val id: String, val name: String, val age: Int?, val edd: LocalDate, val weeks: Long)
+
+data class Visit(val date: String, val weight: String?, val bp: String?, val hb: String?)
+
+// ---- data ----
+
+private fun engine(context: Context) = FhirEngineProvider.getInstance(context.applicationContext)
+
+private fun Observation.code() = code.coding.firstOrNull { it.system?.value == LOINC }?.code?.value
+
+private fun Observation.quantity() = value?.asQuantity()?.value?.value?.value?.toPlainString()
+
+private fun Observation.component(code: String) =
+  component.firstOrNull { c -> c.code.coding.any { it.code?.value == code } }
+    ?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+
+private fun String.date() = LocalDate.parse(substringBefore("T"))
+
+private fun Patient.displayName() =
+  name.firstOrNull().let { n -> listOfNotNull(n?.given?.mapNotNull { it.value }?.joinToString(" "), n?.family?.value).joinToString(" ") }
+
+suspend fun loadRegister(engine: FhirEngine): List<RegisterRow> {
+  val today = LocalDate.now()
+  // Latest EDD per patient.
+  val edds = engine.search<Observation>(Search(ResourceType.Observation)).map { it.resource }
+    .filter { it.code() == EDD }
+    .mapNotNull { o ->
+      val pid = o.subject?.reference?.value?.substringAfter("/") ?: return@mapNotNull null
+      val edd = o.value?.asDateTime()?.value?.value?.toString()?.date() ?: return@mapNotNull null
+      pid to edd
+    }
+    .groupBy({ it.first }, { it.second }).mapValues { it.value.max() }
+  return engine.search<Patient>(Search(ResourceType.Patient)).map { it.resource }
+    .mapNotNull { p ->
+      val edd = edds[p.id] ?: return@mapNotNull null
+      // ponytail: "currently pregnant" = has an EDD no more than 2 weeks past; add a delivery outcome check when one is recorded
+      if (edd.isBefore(today.minusWeeks(2))) return@mapNotNull null
+      val age = p.birthDate?.value?.toString()?.date()?.let { JPeriod.between(it, today).years }
+      RegisterRow(p.id!!, p.displayName(), age, edd, (280 - ChronoUnit.DAYS.between(today, edd)) / 7)
+    }
+    .sortedBy { it.edd }
+}
+
+suspend fun loadVisits(engine: FhirEngine, patientId: String): Pair<String, List<Visit>> {
+  val patient = engine.get<Patient>(patientId)
+  val subject: Search.() -> Unit = { filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" }) }
+  val obs = engine.search<Observation>(Search(ResourceType.Observation).apply(subject)).map { it.resource }
+    .groupBy { it.encounter?.reference?.value?.substringAfter("/") }
+  val visits = engine.search<Encounter>(Search(ResourceType.Encounter).apply(subject)).map { it.resource }
+    .map { e ->
+      val o = obs[e.id].orEmpty()
+      val bp = o.firstOrNull { it.code() == BP_PANEL }
+      Visit(
+        date = e.period?.start?.value?.toString()?.substringBefore("T") ?: "?",
+        weight = o.firstOrNull { it.code() == WEIGHT }?.quantity(),
+        bp = bp?.let { "${it.component(SYSTOLIC) ?: "?"}/${it.component(DIASTOLIC) ?: "?"}" },
+        hb = o.firstOrNull { it.code() == HB }?.quantity(),
+      )
+    }
+    .sortedByDescending { it.date }
+  return patient.displayName() to visits
+}
+
+private fun concept(code: String, display: String) =
+  CodeableConcept(
+    coding = listOf(Coding(system = Uri(value = LOINC), code = Code(value = code), display = FhirString(value = display))),
+    text = FhirString(value = display),
+  )
+
+private fun quantity(v: BigDecimal, unit: String, ucum: String) =
+  Quantity(value = Decimal(value = v), unit = FhirString(value = unit), system = Uri(value = "http://unitsofmeasure.org"), code = Code(value = ucum))
+
+suspend fun saveVisit(engine: FhirEngine, patientId: String, response: QuestionnaireResponse) {
+  val answers = mutableMapOf<String, MutableList<QuestionnaireResponse.Item.Answer>>()
+  fun collect(items: List<QuestionnaireResponse.Item>) {
+    items.forEach { item ->
+      item.linkId.value?.let { answers.getOrPut(it) { mutableListOf() }.addAll(item.answer) }
+      collect(item.item)
+      item.answer.forEach { collect(it.item) }
+    }
+  }
+  collect(response.item)
+  fun first(id: String) = answers[id]?.firstOrNull()?.value
+
+  val date = first("visit-date")?.asDate()?.value?.value?.toString() ?: LocalDate.now().toString()
+  val ga = first("gestational-age")?.asInteger()?.value?.value
+  val weight = first("weight")?.asDecimal()?.value?.value
+  val sys = first("bp-systolic")?.asInteger()?.value?.value
+  val dia = first("bp-diastolic")?.asInteger()?.value?.value
+
+  val patientRef = Reference(reference = FhirString(value = "Patient/$patientId"))
+  val encounterId = UUID.randomUUID().toString()
+  val encounterRef = Reference(reference = FhirString(value = "Encounter/$encounterId"))
+  val when_ = DateTime(value = FhirDateTime.fromString(date))
+  val encounter = Encounter(
+    id = encounterId,
+    status = Enumeration(value = Encounter.EncounterStatus.Finished),
+    `class` = Coding(
+      system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"),
+      code = Code(value = "AMB"),
+      display = FhirString(value = "ambulatory"),
+    ),
+    type = listOf(CodeableConcept(text = FhirString(value = "Antenatal care contact"))),
+    subject = patientRef,
+    period = Period(start = when_, end = when_),
+  )
+  fun obs(code: CodeableConcept, value: Observation.Value? = null, components: List<Observation.Component> = emptyList()) =
+    Observation(
+      id = UUID.randomUUID().toString(),
+      status = Enumeration(value = Observation.ObservationStatus.Final),
+      code = code,
+      subject = patientRef,
+      encounter = encounterRef,
+      effective = Observation.Effective.DateTime(when_),
+      value = value,
+      component = components,
+    )
+  fun bpComponent(code: String, display: String, v: Int) =
+    Observation.Component(
+      code = concept(code, display),
+      value = Observation.Component.Value.Quantity(quantity(BigDecimal.fromInt(v), "mmHg", "mm[Hg]")),
+    )
+
+  val observations = listOfNotNull(
+    weight?.let { obs(concept(WEIGHT, "Body weight"), Observation.Value.Quantity(quantity(it, "kg", "kg"))) },
+    ga?.let { obs(concept(GEST_AGE, "Gestational age"), Observation.Value.Quantity(quantity(BigDecimal.fromInt(it), "weeks", "wk"))) },
+    if (sys != null || dia != null) {
+      obs(
+        concept(BP_PANEL, "Blood pressure"),
+        components = listOfNotNull(
+          sys?.let { bpComponent(SYSTOLIC, "Systolic blood pressure", it) },
+          dia?.let { bpComponent(DIASTOLIC, "Diastolic blood pressure", it) },
+        ),
+      )
+    } else null,
+  )
+  // Danger signs and notes live in the QuestionnaireResponse, linked to the encounter.
+  val qr = response.toBuilder().apply {
+    id = UUID.randomUUID().toString()
+    status = Enumeration(value = QuestionnaireResponse.QuestionnaireResponseStatus.Completed)
+    subject = patientRef.toBuilder()
+    this.encounter = encounterRef.toBuilder()
+    questionnaire = Canonical(value = "http://example.org/fhir/Questionnaire/anc-contact").toBuilder()
+  }.build()
+  engine.create(encounter, *observations.toTypedArray(), qr)
+}
+
+private suspend fun sync(context: Context, policy: ExistingWorkPolicy = ExistingWorkPolicy.KEEP) =
+  Sync.oneTimeSync<AppSyncWorker>(context.applicationContext, existingWorkPolicy = policy).first {
+    it is CurrentSyncJobStatus.Succeeded || it is CurrentSyncJobStatus.Failed || it is CurrentSyncJobStatus.Cancelled
+  } is CurrentSyncJobStatus.Succeeded
