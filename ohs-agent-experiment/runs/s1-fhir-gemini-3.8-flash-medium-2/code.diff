@@ -0,0 +1,197 @@
+package com.example.ancapp.ui
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.example.ancapp.data.AncRepository
+import com.example.ancapp.data.AncVisit
+import com.example.ancapp.data.DangerSignOption
+import com.example.ancapp.data.PatientInfo
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+
+sealed interface CurrentScreen {
+    data object Register : CurrentScreen
+    data class PatientDetail(val patient: PatientInfo) : CurrentScreen
+    data class RecordVisit(val patient: PatientInfo) : CurrentScreen
+}
+
+data class AncUiState(
+    val currentScreen: CurrentScreen = CurrentScreen.Register,
+    val patients: List<PatientInfo> = emptyList(),
+    val isPatientsLoading: Boolean = false,
+    val patientsError: String? = null,
+    val selectedPatient: PatientInfo? = null,
+    val visits: List<AncVisit> = emptyList(),
+    val isVisitsLoading: Boolean = false,
+    val visitsError: String? = null,
+    val dangerSignOptions: List<DangerSignOption> = emptyList(),
+    val isSavingVisit: Boolean = false,
+    val saveVisitError: String? = null
+)
+
+class AncViewModel(
+    private val repository: AncRepository = AncRepository()
+) : ViewModel() {
+
+    private val _uiState = MutableStateFlow(AncUiState())
+    val uiState: StateFlow<AncUiState> = _uiState.asStateFlow()
+
+    init {
+        loadPatients()
+        loadDangerSigns()
+    }
+
+    fun loadPatients(forceRefresh: Boolean = false) {
+        viewModelScope.launch {
+            _uiState.update { it.copy(isPatientsLoading = true, patientsError = null) }
+            try {
+                val list = repository.getPatients(forceRefresh = forceRefresh)
+                _uiState.update {
+                    it.copy(
+                        patients = list,
+                        isPatientsLoading = false,
+                        patientsError = null
+                    )
+                }
+            } catch (e: Exception) {
+                _uiState.update {
+                    it.copy(
+                        isPatientsLoading = false,
+                        patientsError = e.message ?: "Failed to load patients"
+                    )
+                }
+            }
+        }
+    }
+
+    private fun loadDangerSigns() {
+        viewModelScope.launch {
+            val options = repository.getDangerSignOptions()
+            _uiState.update { it.copy(dangerSignOptions = options) }
+        }
+    }
+
+    fun selectPatient(patient: PatientInfo) {
+        _uiState.update {
+            it.copy(
+                selectedPatient = patient,
+                currentScreen = CurrentScreen.PatientDetail(patient),
+                visits = emptyList(),
+                visitsError = null
+            )
+        }
+        loadVisits(patient.id)
+    }
+
+    fun loadVisits(patientId: String) {
+        viewModelScope.launch {
+            _uiState.update { it.copy(isVisitsLoading = true, visitsError = null) }
+            try {
+                val visits = repository.getVisitsForPatient(patientId)
+                _uiState.update {
+                    it.copy(
+                        visits = visits,
+                        isVisitsLoading = false,
+                        visitsError = null
+                    )
+                }
+            } catch (e: Exception) {
+                _uiState.update {
+                    it.copy(
+                        isVisitsLoading = false,
+                        visitsError = e.message ?: "Failed to load visits"
+                    )
+                }
+            }
+        }
+    }
+
+    fun openRecordVisit() {
+        val patient = _uiState.value.selectedPatient ?: return
+        _uiState.update {
+            it.copy(
+                currentScreen = CurrentScreen.RecordVisit(patient),
+                saveVisitError = null
+            )
+        }
+    }
+
+    fun navigateBack(): Boolean {
+        val current = _uiState.value.currentScreen
+        return when (current) {
+            is CurrentScreen.RecordVisit -> {
+                _uiState.update {
+                    it.copy(
+                        currentScreen = CurrentScreen.PatientDetail(current.patient),
+                        saveVisitError = null
+                    )
+                }
+                true
+            }
+            is CurrentScreen.PatientDetail -> {
+                _uiState.update {
+                    it.copy(
+                        currentScreen = CurrentScreen.Register,
+                        selectedPatient = null
+                    )
+                }
+                true
+            }
+            is CurrentScreen.Register -> false
+        }
+    }
+
+    fun saveVisit(
+        visitDate: String,
+        gestationalAgeWeeks: Int?,
+        weightKg: Double?,
+        systolicBp: Int?,
+        diastolicBp: Int?,
+        dangerSigns: List<DangerSignOption>,
+        notes: String?
+    ) {
+        val patient = _uiState.value.selectedPatient ?: return
+        viewModelScope.launch {
+            _uiState.update { it.copy(isSavingVisit = true, saveVisitError = null) }
+            val result = repository.saveVisit(
+                patientId = patient.id,
+                visitDate = visitDate,
+                gestationalAgeWeeks = gestationalAgeWeeks,
+                weightKg = weightKg,
+                systolicBp = systolicBp,
+                diastolicBp = diastolicBp,
+                dangerSigns = dangerSigns,
+                notes = notes
+            )
+            result.fold(
+                onSuccess = {
+                    // Refresh visits from server so new visit is included
+                    val updatedVisits = try {
+                        repository.getVisitsForPatient(patient.id)
+                    } catch (_: Exception) {
+                        _uiState.value.visits
+                    }
+                    _uiState.update {
+                        it.copy(
+                            isSavingVisit = false,
+                            saveVisitError = null,
+                            visits = updatedVisits,
+                            currentScreen = CurrentScreen.PatientDetail(patient)
+                        )
+                    }
+                },
+                onFailure = { err ->
+                    _uiState.update {
+                        it.copy(
+                            isSavingVisit = false,
+                            saveVisitError = err.message ?: "Failed to save visit"
+                        )
+                    }
+                }
+            )
+        }
+    }
+}
