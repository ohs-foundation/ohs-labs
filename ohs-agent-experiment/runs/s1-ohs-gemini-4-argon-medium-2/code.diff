+        patientDetail = detail,
+        isSyncing = uiState.isSyncing,
+        onBack = { ancViewModel.navigateBack() },
+        onRecordNewVisit = { ancViewModel.openNewVisitForm(screen.patientId) },
+      )
+    }
+
+    is Screen.NewVisit -> {
+      val patientName =
