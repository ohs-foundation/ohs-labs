+
+@Composable
+fun VisitCard(v: Visit) {
+  Card(Modifier.fillMaxWidth()) {
+    Column(Modifier.padding(12.dp)) {
+      Text("${v.date} · ${v.gestationWeeks} weeks", style = MaterialTheme.typography.titleSmall)
+      Text(
+        "Weight ${v.weightKg} kg · BP ${v.systolic}/${v.diastolic} mmHg" +
+          (v.hemoglobin?.let { " · Hb $it g/dL" } ?: ""),
+      )
+      if (v.dangerSigns.isNotEmpty()) {
+        Text(
+          "Danger signs: ${v.dangerSigns.joinToString { it.label }}",
+          color = MaterialTheme.colorScheme.error,
+        )
+      }
+      if (v.notes.isNotBlank()) Text(v.notes)
+    }
+  }
+}
