+@Composable
+fun App() {
+  var patient by remember { mutableStateOf<Patient?>(null) }
+  var recording by remember { mutableStateOf(false) }
+  val p = patient
+  when {
+    p == null -> RegisterScreen(onOpen = { patient = it })
+    recording -> {
+      BackHandler { recording = false }
+      VisitFormScreen(p, onDone = { recording = false })
+    }
+    else -> {
+      BackHandler { patient = null }
+      PatientScreen(p, onBack = { patient = null }, onRecord = { recording = true })
+    }
+  }
+}
+
+/** Loads [block] once per [key], exposing loading / error / retry state. */
+@Composable
+fun <T> rememberLoad(key: Any?, block: suspend () -> T): Triple<T?, String?, () -> Unit> {
+  var attempt by remember { mutableIntStateOf(0) }
+  var data by remember(key) { mutableStateOf<T?>(null) }
+  var error by remember(key) { mutableStateOf<String?>(null) }
+  LaunchedEffect(key, attempt) {
+    error = null
+    runCatching { block() }.onSuccess { data = it }.onFailure { error = it.message ?: it.toString() }
+  }
+  return Triple(data, error, { attempt++ })
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun Screen(title: String, onBack: (() -> Unit)? = null, fab: @Composable () -> Unit = {}, content: @Composable (PaddingValues) -> Unit) {
