+package com.example.ancapp
+
+import com.ionspin.kotlin.bignum.decimal.BigDecimal
+import dev.ohs.fhir.model.r4.Canonical
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.CodeableConcept
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.DateTime
+import dev.ohs.fhir.model.r4.Decimal
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Enumeration
+import dev.ohs.fhir.model.r4.FhirDateTime
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Period
+import dev.ohs.fhir.model.r4.Quantity
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import dev.ohs.fhir.model.r4.Reference
+import dev.ohs.fhir.model.r4.Uri
+import dev.ohs.fhir.model.r4.String as FhirString
+import java.net.HttpURLConnection
+import java.net.URL
+import java.time.LocalDate
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonElement
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.contentOrNull
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+
+// ponytail: direct HAPI REST, no FHIR Engine sync. No local cache, so the app needs the server to be reachable.
+private const val BASE = "http://10.0.2.2:8080/fhir"
+private const val QUESTIONNAIRE_URL = "http://example.org/fhir/Questionnaire/anc-contact"
+private const val LOINC_EDD = "11778-8"
+private const val LOINC_WEIGHT = "29463-7"
+private const val LOINC_BP_PANEL = "85354-9"
+private const val LOINC_SYSTOLIC = "8480-6"
+private const val LOINC_DIASTOLIC = "8462-4"
+private const val LOINC_HB = "718-7"
+
+private val json = Json { explicitNulls = false; encodeDefaults = false }
+
+data class PatientRow(val id: String, val name: String, val age: Int, val dueDate: LocalDate)
+
+data class VisitRow(val date: String, val weight: String?, val bp: String?, val hb: String?)
+
+// Reads: pregnant patients (anyone with an EDD on file), patient detail, and visit history.
+
+suspend fun loadPregnantPatients(): List<PatientRow> {
+  val due = dueDates()
+  return getJson("Patient?_count=200").resources()
+    .mapNotNull { p -> due[p.at("id")]?.let { toRow(p, it) } }
+    .sortedBy { it.dueDate }
+}
+
+suspend fun loadPatient(id: String): PatientRow {
+  val due = dueDates()[id] ?: error("No due date on file for this patient")
+  return toRow(getJson("Patient/$id"), due)
+}
+
+suspend fun loadVisits(patientId: String): List<VisitRow> {
+  val encounters = getJson("Encounter?subject=Patient/$patientId&_count=200").resources()
+  val obsByEncounter = getJson("Observation?subject=Patient/$patientId&_count=500")
+    .resources()
+    .groupBy { it.at("encounter", "reference") }
+  return encounters
+    .sortedByDescending { it.at("period", "start").orEmpty() }
+    .map { enc ->
+      val obs = obsByEncounter["Encounter/${enc.at("id")}"].orEmpty()
+      VisitRow(
+        date = enc.at("period", "start").orEmpty(),
+        weight = obs.firstOrNull { it.hasCode(LOINC_WEIGHT) }?.let { "${it.at("valueQuantity", "value")} kg" },
+        bp = obs.firstOrNull { it.hasCode(LOINC_BP_PANEL) }?.let {
+          "${it.component(LOINC_SYSTOLIC)}/${it.component(LOINC_DIASTOLIC)}"
+        },
+        hb = obs.firstOrNull { it.hasCode(LOINC_HB) }?.let {
+          "${it.at("valueQuantity", "value")} ${it.at("valueQuantity", "unit")}"
+        },
+      )
+    }
+}
+
+// Write: one visit = Encounter + weight/BP Observations + the form's QuestionnaireResponse.
+// ponytail: sequential PUTs, not a transaction Bundle; a failure partway can leave a partial visit.
+suspend fun saveVisit(patientId: String, response: QuestionnaireResponse) = withContext(Dispatchers.IO) {
+  val answers = response.answers()
+  val date = answers["visit-date"]?.value?.asDate()?.value?.value?.toString()
+    ?: error("Visit date missing")
+  val weight = answers["weight"]?.value?.asDecimal()?.value?.value?.toPlainString()
+  val systolic = answers["bp-systolic"]?.value?.asInteger()?.value?.value?.toString()
+  val diastolic = answers["bp-diastolic"]?.value?.asInteger()?.value?.value?.toString()
+
+  val patient = Reference(reference = FhirString(value = "Patient/$patientId"))
+  val encounterId = newId()
+  val encounterRef = Reference(reference = FhirString(value = "Encounter/$encounterId"))
+
+  val encounterResource = Encounter(
+    id = encounterId,
+    status = Enumeration(value = Encounter.EncounterStatus.Finished),
+    `class` = Coding(
+      system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"),
+      code = Code(value = "AMB"),
+      display = FhirString(value = "ambulatory"),
+    ),
+    type = listOf(CodeableConcept(text = FhirString(value = "Antenatal care contact"))),
+    subject = patient,
+    period = Period(start = DateTime(value = FhirDateTime.fromString(date))),
+  )
+  put("Encounter/$encounterId", json.encodeToString(encounterResource))
+
+  if (weight != null) {
+    val obs = vitalSign(date, patient, encounterRef, LOINC_WEIGHT, "Body weight",
+      value = Observation.Value.Quantity(quantity(weight, "kg")))
+    put("Observation/${obs.id}", json.encodeToString(obs))
+  }
+  if (systolic != null && diastolic != null) {
+    val obs = vitalSign(date, patient, encounterRef, LOINC_BP_PANEL, "Blood pressure",
+      components = listOf(
+        bpComponent(LOINC_SYSTOLIC, "Systolic blood pressure", systolic),
+        bpComponent(LOINC_DIASTOLIC, "Diastolic blood pressure", diastolic),
+      ))
+    put("Observation/${obs.id}", json.encodeToString(obs))
+  }
+
+  val qrId = newId()
+  val saved = response.toBuilder().apply {
+    id = qrId
+    status = Enumeration(value = QuestionnaireResponse.QuestionnaireResponseStatus.Completed)
+    subject = patient.toBuilder()
+    encounter = encounterRef.toBuilder()
+    questionnaire = Canonical(value = QUESTIONNAIRE_URL).toBuilder()
+  }.build()
+  put("QuestionnaireResponse/$qrId", json.encodeToString(saved))
+}
+
+suspend fun fetchQuestionnaireJson(): String = withContext(Dispatchers.IO) {
+  request("GET", "Questionnaire/anc-contact")
+}
+
+// Helpers
+
+private suspend fun dueDates(): Map<String, LocalDate> = getJson(
+  "Observation?code=$LOINC_EDD&_count=500",
+).resources()
+  .sortedBy { it.at("effectiveDateTime").orEmpty() } // later estimates overwrite earlier ones in toMap
+  .mapNotNull { o ->
+    val pid = o.at("subject", "reference")?.removePrefix("Patient/")
+    val due = o.at("valueDateTime")?.substringBefore("T")
+    if (pid == null || due == null) null else pid to LocalDate.parse(due)
+  }
+  .toMap()
+
+private fun toRow(p: JsonObject, due: LocalDate): PatientRow {
+  val name = p["name"]?.jsonArray?.firstOrNull()?.jsonObject
+  val fullName = listOfNotNull(
+    name?.get("given")?.jsonArray?.firstOrNull()?.jsonPrimitive?.content,
+    name?.get("family")?.jsonPrimitive?.content,
+  ).joinToString(" ")
+  val age = ChronoUnit.YEARS.between(LocalDate.parse(p.at("birthDate").orEmpty()), LocalDate.now()).toInt()
+  return PatientRow(id = p.at("id").orEmpty(), name = fullName, age = age, dueDate = due)
+}
+
+// Walks nested groups and answer items; first answer per linkId wins.
+private fun QuestionnaireResponse.answers(): Map<String, QuestionnaireResponse.Item.Answer> {
+  val out = mutableMapOf<String, QuestionnaireResponse.Item.Answer>()
+  fun walk(items: List<QuestionnaireResponse.Item>) {
+    items.forEach { item ->
+      item.linkId.value?.let { id -> item.answer.firstOrNull()?.let { out[id] = it } }
+      walk(item.item)
+      item.answer.forEach { walk(it.item) }
+    }
+  }
+  walk(item)
+  return out
+}
+
+private fun vitalSign(
+  date: String,
+  patient: Reference,
+  encounter: Reference,
+  loinc: String,
+  display: String,
+  value: Observation.Value? = null,
+  components: List<Observation.Component> = emptyList(),
+) = Observation(
+  id = newId(),
+  status = Enumeration(value = Observation.ObservationStatus.Final),
+  category = listOf(
+    CodeableConcept(
+      coding = listOf(
+        Coding(
+          system = Uri(value = "http://terminology.hl7.org/CodeSystem/observation-category"),
+          code = Code(value = "vital-signs"),
+        )
+      )
+    )
+  ),
+  code = loincConcept(loinc, display),
+  subject = patient,
+  encounter = encounter,
+  effective = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(date))),
+  value = value,
+  component = components,
+)
+
+private fun bpComponent(loinc: String, display: String, mmHg: String) = Observation.Component(
+  code = loincConcept(loinc, display),
+  value = Observation.Component.Value.Quantity(quantity(mmHg, "mmHg", code = "mm[Hg]")),
+)
+
+private fun loincConcept(code: String, display: String) = CodeableConcept(
+  coding = listOf(
+    Coding(
+      system = Uri(value = "http://loinc.org"),
+      code = Code(value = code),
+      display = FhirString(value = display),
+    )
+  ),
+  text = FhirString(value = display),
+)
+
+private fun quantity(value: String, unit: String, code: String = unit) = Quantity(
+  value = Decimal(value = BigDecimal.parseString(value)),
+  unit = FhirString(value = unit),
+  system = Uri(value = "http://unitsofmeasure.org"),
+  code = Code(value = code),
+)
+
+private fun newId() = UUID.randomUUID().toString()
+
+private fun JsonObject.resources(): List<JsonObject> =
+  (this["entry"]?.jsonArray ?: emptyList()).map { it.jsonObject["resource"]!!.jsonObject }
+
+private fun JsonObject.hasCode(code: String) =
+  this["code"]?.jsonObject?.get("coding")?.jsonArray?.any { it.at("code") == code } == true
+
+private fun JsonObject.component(code: String): String? =
+  this["component"]?.jsonArray?.firstOrNull { (it as JsonObject).hasCode(code) }?.at("valueQuantity", "value")
+
+// Walks a chain of object keys; returns the primitive's text or null.
+private fun JsonElement?.at(vararg keys: String): String? {
+  var cur: JsonElement? = this
+  for (k in keys) cur = (cur as? JsonObject)?.get(k)
+  return (cur as? JsonPrimitive)?.contentOrNull
+}
+
+private suspend fun getJson(path: String): JsonObject = withContext(Dispatchers.IO) {
+  Json.parseToJsonElement(request("GET", path)).jsonObject
+}
+
+private suspend fun put(path: String, body: String) = withContext(Dispatchers.IO) {
+  request("PUT", path, body)
+}
+
+private fun request(method: String, path: String, body: String? = null): String {
+  val conn = URL("$BASE/$path").openConnection() as HttpURLConnection
+  conn.requestMethod = method
+  conn.setRequestProperty("Accept", "application/fhir+json")
+  if (body != null) {
+    conn.doOutput = true
+    conn.setRequestProperty("Content-Type", "application/fhir+json")
+    conn.outputStream.use { it.write(body.toByteArray()) }
+  }
+  val code = conn.responseCode
+  val text = (if (code < 400) conn.inputStream else conn.errorStream).bufferedReader().use { it.readText() }
+  check(code < 400) { "HTTP $code from server: ${text.take(300)}" }
+  return text
+}
