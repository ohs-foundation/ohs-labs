+import java.time.LocalDate
+import java.time.format.DateTimeFormatter
+import java.util.Calendar
+
+@OptIn(ExperimentalMaterial3Api::class, ExperimentalLayoutApi::class)
+@Composable
+fun NewVisitScreen(
+    patient: PatientItem?,
+    questionnaire: QuestionnaireModel?,
+    isSaving: Boolean,
+    saveError: String?,
+    onBackClick: () -> Unit,
+    onSaveVisit: (AncVisitInput) -> Unit
+) {
+    val context = LocalContext.current
+    val initialDate = remember {
+        LocalDate.now().format(DateTimeFormatter.ofPattern("yyyy-MM-dd"))
+    }
+
+    var visitDate by remember { mutableStateOf(initialDate) }
+    var gestationalAge by remember {
+        mutableStateOf(patient?.gestationalWeeks?.toString() ?: "")
+    }
+    var weight by remember { mutableStateOf("") }
+    var systolicBp by remember { mutableStateOf("") }
+    var diastolicBp by remember { mutableStateOf("") }
+    var notes by remember { mutableStateOf("") }
+    var dateError by remember { mutableStateOf<String?>(null) }
+
+    // Resolve danger sign options from Questionnaire or fallback to standard anc-contact options
+    val dangerSignOptions = remember(questionnaire) {
+        val fromQ = questionnaire?.items
+            ?.firstOrNull { it.linkId == "danger-signs" }
+            ?.answerOptions
+        if (!fromQ.isNullOrEmpty()) {
+            fromQ
+        } else {
+            listOf(
+                DangerSignOption("none", "None"),
+                DangerSignOption("vaginal-bleeding", "Vaginal bleeding"),
+                DangerSignOption("severe-headache", "Severe headache"),
+                DangerSignOption("blurred-vision", "Blurred vision"),
+                DangerSignOption("fever", "Fever")
+            )
+        }
+    }
+
+    val selectedSigns = remember {
+        mutableStateListOf<String>("none")
+    }
+
+    val scrollState = rememberScrollState()
+
+    Scaffold(
+        topBar = {
+            TopAppBar(
+                title = {
+                    Column {
+                        Text(
+                            text = "Record ANC Visit",
+                            fontWeight = FontWeight.Bold
+                        )
+                        if (patient != null) {
+                            Text(
+                                text = patient.name,
+                                style = MaterialTheme.typography.bodySmall,
+                                color = MaterialTheme.colorScheme.onPrimaryContainer.copy(alpha = 0.8f)
+                            )
+                        }
+                    }
+                },
+                navigationIcon = {
+                    IconButton(onClick = onBackClick) {
+                        Icon(
+                            imageVector = Icons.AutoMirrored.Filled.ArrowBack,
+                            contentDescription = "Back"
+                        )
+                    }
+                },
+                colors = TopAppBarDefaults.topAppBarColors(
+                    containerColor = MaterialTheme.colorScheme.primaryContainer,
+                    titleContentColor = MaterialTheme.colorScheme.onPrimaryContainer
+                )
+            )
+        }
+    ) { padding ->
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(padding)
+                .verticalScroll(scrollState)
+                .padding(16.dp),
+            verticalArrangement = Arrangement.spacedBy(16.dp)
+        ) {
+            if (saveError != null) {
+                Card(
+                    modifier = Modifier.fillMaxWidth(),
+                    colors = CardDefaults.cardColors(
+                        containerColor = MaterialTheme.colorScheme.errorContainer
+                    )
+                ) {
+                    Column(modifier = Modifier.padding(12.dp)) {
+                        Text(
+                            text = "Save Failed",
+                            style = MaterialTheme.typography.titleSmall,
+                            fontWeight = FontWeight.Bold,
+                            color = MaterialTheme.colorScheme.onErrorContainer
+                        )
+                        Text(
+                            text = saveError,
+                            style = MaterialTheme.typography.bodySmall,
+                            color = MaterialTheme.colorScheme.onErrorContainer
+                        )
+                    }
+                }
+            }
+
+            // Section 1: Visit Details
+            Card(
+                modifier = Modifier.fillMaxWidth(),
+                colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),
+                elevation = CardDefaults.cardElevation(defaultElevation = 2.dp)
+            ) {
+                Column(modifier = Modifier.padding(16.dp)) {
+                    Row(verticalAlignment = Alignment.CenterVertically) {
+                        Icon(
+                            imageVector = Icons.Default.CalendarMonth,
+                            contentDescription = null,
+                            tint = MaterialTheme.colorScheme.primary
+                        )
+                        Spacer(modifier = Modifier.width(8.dp))
+                        Text(
+                            text = "Visit Details",
+                            style = MaterialTheme.typography.titleMedium,
+                            fontWeight = FontWeight.Bold
+                        )
+                    }
+
+                    Spacer(modifier = Modifier.height(12.dp))
+
+                    // Visit date
+                    OutlinedTextField(
+                        value = visitDate,
+                        onValueChange = {
+                            visitDate = it
+                            dateError = null
+                        },
+                        label = { Text("Visit Date (YYYY-MM-DD) *") },
+                        isError = dateError != null,
+                        supportingText = { dateError?.let { Text(it) } },
+                        modifier = Modifier.fillMaxWidth(),
+                        trailingIcon = {
+                            IconButton(onClick = {
+                                val c = Calendar.getInstance()
+                                try {
+                                    val parsed = LocalDate.parse(visitDate)
+                                    c.set(parsed.year, parsed.monthValue - 1, parsed.dayOfMonth)
+                                } catch (_: Exception) {}
+                                DatePickerDialog(
+                                    context,
+                                    { _, year, month, dayOfMonth ->
+                                        val m = month + 1
+                                        visitDate = "%04d-%02d-%02d".format(year, m, dayOfMonth)
+                                    },
+                                    c.get(Calendar.YEAR),
+                                    c.get(Calendar.MONTH),
+                                    c.get(Calendar.DAY_OF_MONTH)
+                                ).show()
+                            }) {
+                                Icon(Icons.Default.CalendarMonth, contentDescription = "Pick Date")
+                            }
+                        }
+                    )
+
+                    Spacer(modifier = Modifier.height(8.dp))
+
+                    // Gestational age in weeks
+                    OutlinedTextField(
+                        value = gestationalAge,
+                        onValueChange = { gestationalAge = it.filter { char -> char.isDigit() } },
+                        label = { Text("Gestational Age (weeks)") },
+                        keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+                        modifier = Modifier.fillMaxWidth(),
+                        leadingIcon = {
+                            Icon(Icons.Default.PregnantWoman, contentDescription = null)
+                        }
+                    )
+                }
+            }
+
+            // Section 2: Vital Signs
+            Card(
+                modifier = Modifier.fillMaxWidth(),
+                colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),
+                elevation = CardDefaults.cardElevation(defaultElevation = 2.dp)
+            ) {
+                Column(modifier = Modifier.padding(16.dp)) {
+                    Row(verticalAlignment = Alignment.CenterVertically) {
+                        Icon(
+                            imageVector = Icons.Default.Favorite,
+                            contentDescription = null,
+                            tint = MaterialTheme.colorScheme.primary
+                        )
+                        Spacer(modifier = Modifier.width(8.dp))
+                        Text(
+                            text = "Vital Signs",
+                            style = MaterialTheme.typography.titleMedium,
+                            fontWeight = FontWeight.Bold
+                        )
+                    }
+
+                    Spacer(modifier = Modifier.height(12.dp))
+
+                    // Weight (kg)
+                    OutlinedTextField(
+                        value = weight,
+                        onValueChange = { weight = it.filter { c -> c.isDigit() || c == '.' } },
+                        label = { Text("Weight (kg)") },
+                        keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Decimal),
+                        modifier = Modifier.fillMaxWidth(),
+                        leadingIcon = {
+                            Icon(Icons.Default.MonitorWeight, contentDescription = null)
+                        }
+                    )
+
+                    Spacer(modifier = Modifier.height(12.dp))
+
+                    // Blood pressure: Systolic & Diastolic
+                    Row(
+                        modifier = Modifier.fillMaxWidth(),
+                        horizontalArrangement = Arrangement.spacedBy(8.dp)
+                    ) {
+                        OutlinedTextField(
+                            value = systolicBp,
+                            onValueChange = { systolicBp = it.filter { c -> c.isDigit() } },
+                            label = { Text("Systolic (mmHg)") },
+                            keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+                            modifier = Modifier.weight(1f)
+                        )
+                        OutlinedTextField(
+                            value = diastolicBp,
+                            onValueChange = { diastolicBp = it.filter { c -> c.isDigit() } },
+                            label = { Text("Diastolic (mmHg)") },
+                            keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+                            modifier = Modifier.weight(1f)
+                        )
+                    }
+                }
+            }
+
+            // Section 3: Danger Signs Present
+            Card(
+                modifier = Modifier.fillMaxWidth(),
+                colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),
+                elevation = CardDefaults.cardElevation(defaultElevation = 2.dp)
+            ) {
+                Column(modifier = Modifier.padding(16.dp)) {
+                    Row(verticalAlignment = Alignment.CenterVertically) {
+                        Icon(
+                            imageVector = Icons.Default.Warning,
+                            contentDescription = null,
+                            tint = MaterialTheme.colorScheme.primary
+                        )
+                        Spacer(modifier = Modifier.width(8.dp))
+                        Text(
+                            text = "Danger Signs Present",
+                            style = MaterialTheme.typography.titleMedium,
+                            fontWeight = FontWeight.Bold
+                        )
+                    }
+
+                    Spacer(modifier = Modifier.height(6.dp))
+                    Text(
+                        text = "Select all danger signs present (multiple allowed):",
+                        style = MaterialTheme.typography.bodySmall,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant
+                    )
+
+                    Spacer(modifier = Modifier.height(10.dp))
+
+                    FlowRow(
+                        modifier = Modifier.fillMaxWidth(),
+                        horizontalArrangement = Arrangement.spacedBy(8.dp),
+                        verticalArrangement = Arrangement.spacedBy(8.dp)
+                    ) {
+                        dangerSignOptions.forEach { option ->
+                            val isSelected = selectedSigns.contains(option.code)
+                            FilterChip(
+                                selected = isSelected,
+                                onClick = {
+                                    if (option.code == "none") {
+                                        selectedSigns.clear()
+                                        selectedSigns.add("none")
+                                    } else {
+                                        selectedSigns.remove("none")
+                                        if (isSelected) {
+                                            selectedSigns.remove(option.code)
+                                            if (selectedSigns.isEmpty()) {
+                                                selectedSigns.add("none")
+                                            }
+                                        } else {
+                                            selectedSigns.add(option.code)
+                                        }
+                                    }
+                                },
+                                label = { Text(option.display) },
+                                leadingIcon = if (isSelected) {
+                                    {
+                                        Icon(
+                                            imageVector = Icons.Default.Check,
+                                            contentDescription = null,
+                                            modifier = Modifier.size(16.dp)
+                                        )
+                                    }
+                                } else null,
+                                colors = FilterChipDefaults.filterChipColors(
+                                    selectedContainerColor = if (option.code != "none") {
+                                        MaterialTheme.colorScheme.errorContainer
+                                    } else {
+                                        MaterialTheme.colorScheme.primaryContainer
+                                    },
+                                    selectedLabelColor = if (option.code != "none") {
+                                        MaterialTheme.colorScheme.onErrorContainer
+                                    } else {
+                                        MaterialTheme.colorScheme.onPrimaryContainer
+                                    }
+                                )
+                            )
+                        }
+                    }
+                }
+            }
+
+            // Section 4: Notes
+            Card(
+                modifier = Modifier.fillMaxWidth(),
+                colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),
+                elevation = CardDefaults.cardElevation(defaultElevation = 2.dp)
+            ) {
+                Column(modifier = Modifier.padding(16.dp)) {
+                    Row(verticalAlignment = Alignment.CenterVertically) {
+                        Icon(
+                            imageVector = Icons.AutoMirrored.Filled.Notes,
+                            contentDescription = null,
+                            tint = MaterialTheme.colorScheme.primary
+                        )
+                        Spacer(modifier = Modifier.width(8.dp))
+                        Text(
+                            text = "Free-text Notes",
+                            style = MaterialTheme.typography.titleMedium,
+                            fontWeight = FontWeight.Bold
+                        )
+                    }
+
+                    Spacer(modifier = Modifier.height(12.dp))
+
+                    OutlinedTextField(
+                        value = notes,
+                        onValueChange = { notes = it },
+                        label = { Text("Clinical notes & observations") },
+                        modifier = Modifier.fillMaxWidth(),
+                        minLines = 3,
+                        maxLines = 6
+                    )
+                }
+            }
+
+            Spacer(modifier = Modifier.height(8.dp))
+
+            // Save Visit Button
+            Button(
+                onClick = {
+                    if (visitDate.isBlank()) {
+                        dateError = "Visit date is required"
+                        return@Button
+                    }
+                    try {
+                        LocalDate.parse(visitDate)
+                    } catch (e: Exception) {
+                        dateError = "Please enter date as YYYY-MM-DD"
+                        return@Button
+                    }
+
+                    val selectedOptions = dangerSignOptions.filter {
+                        selectedSigns.contains(it.code)
+                    }
+
+                    val input = AncVisitInput(
+                        visitDate = visitDate.trim(),
+                        gestationalAgeWeeks = gestationalAge.toIntOrNull(),
+                        weightKg = weight.toDoubleOrNull(),
+                        systolicBp = systolicBp.toIntOrNull(),
+                        diastolicBp = diastolicBp.toIntOrNull(),
+                        dangerSigns = selectedOptions,
+                        notes = notes.trim().takeIf { it.isNotBlank() }
+                    )
+                    onSaveVisit(input)
+                },
+                enabled = !isSaving,
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .height(54.dp),
+                shape = RoundedCornerShape(12.dp)
+            ) {
+                if (isSaving) {
+                    CircularProgressIndicator(
+                        modifier = Modifier.size(24.dp),
+                        color = MaterialTheme.colorScheme.onPrimary,
+                        strokeWidth = 2.5.dp
+                    )
+                    Spacer(modifier = Modifier.width(8.dp))
+                    Text("Saving Visit...")
+                } else {
+                    Icon(Icons.Default.Save, contentDescription = null)
+                    Spacer(modifier = Modifier.width(8.dp))
+                    Text("Save ANC Visit", fontWeight = FontWeight.Bold)
+                }
+            }
+
+            Spacer(modifier = Modifier.height(32.dp))
+        }
+    }
+}
