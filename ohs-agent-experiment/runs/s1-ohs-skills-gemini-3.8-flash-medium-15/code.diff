--- /dev/null
+++ b/app/src/main/java/com/example/ancapp/ui/viewmodels/SyncViewModel.kt
@@ -0,0 +1,65 @@
+package com.example.ancapp.ui.viewmodels
+
+import android.app.Application
+import androidx.lifecycle.AndroidViewModel
+import androidx.lifecycle.viewModelScope
+import com.example.ancapp.sync.AppSyncWorker
+import dev.ohs.fhir.engine.sync.CurrentSyncJobStatus
+import dev.ohs.fhir.engine.sync.Sync
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.catch
+import kotlinx.coroutines.flow.transformWhile
+import kotlinx.coroutines.launch
+
+private fun CurrentSyncJobStatus.isFinal() =
+  this is CurrentSyncJobStatus.Succeeded ||
+    this is CurrentSyncJobStatus.Failed ||
+    this is CurrentSyncJobStatus.Cancelled
+
+class SyncViewModel(app: Application) : AndroidViewModel(app) {
+  private val _syncState = MutableStateFlow<String?>("Idle")
+  val syncState: StateFlow<String?> = _syncState.asStateFlow()
+
+  private val _isSyncing = MutableStateFlow(false)
+  val isSyncing: StateFlow<Boolean> = _isSyncing.asStateFlow()
+
+  private var syncJob: Job? = null
+
+  fun syncNow(onComplete: (() -> Unit)? = null) {
+    if (syncJob?.isActive == true) return
+    syncJob = viewModelScope.launch {
+      _isSyncing.value = true
+      var ran = false
+      Sync.oneTimeSync<AppSyncWorker>(getApplication())
+        .transformWhile { emit(it); !it.isFinal() }
+        .catch {
+          _syncState.value = "Sync status unknown"
+          _isSyncing.value = false
+        }
+        .collect { status ->
+          _syncState.value = when (status) {
+            is CurrentSyncJobStatus.Enqueued ->
+              if (ran) "Waiting to retry" else "Waiting to sync"
+            is CurrentSyncJobStatus.Running -> {
+              ran = true
+              "Syncing…"
+            }
+            is CurrentSyncJobStatus.Succeeded -> {
+              _isSyncing.value = false
+              onComplete?.invoke()
+              "Synced"
+            }
+            is CurrentSyncJobStatus.Failed -> {
+              _isSyncing.value = false
+              "Sync failed, will try again later"
+            }
+            else -> _syncState.value
+          }
+        }
+      _isSyncing.value = false
+    }
+  }
+}
