+
+@Composable
+fun App(db: Db) {
+  var patients by remember { mutableStateOf(db.patients()) }
+  var selected by remember { mutableStateOf<Patient?>(null) }
+  var adding by remember { mutableStateOf(false) }
+  var visits by remember { mutableStateOf(emptyList<Visit>()) }
+
+  fun reload() { selected?.let { visits = db.visits(it.id) } }
+
+  val p = selected
+  BackHandler(enabled = p != null) { if (adding) adding = false else selected = null }
+  when {
+    p == null -> Register(patients) { selected = it; visits = db.visits(it.id) }
+    adding -> VisitForm(p, onBack = { adding = false }) { db.addVisit(p.id, it); reload(); adding = false }
+    else -> Detail(p, visits, onBack = { selected = null }, onAdd = { adding = true })
+  }
+}
