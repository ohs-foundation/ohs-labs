+package com.example.ancapp.data
+
+import android.content.Context
+import androidx.room.Database
+import androidx.room.Room
+import androidx.room.RoomDatabase
+import androidx.room.TypeConverters
+import androidx.sqlite.db.SupportSQLiteDatabase
+
+@Database(entities = [Patient::class, Visit::class], version = 1, exportSchema = false)
+@TypeConverters(Converters::class)
+abstract class AncDatabase : RoomDatabase() {
+  abstract fun ancDao(): AncDao
+
+  companion object {
+    @Volatile private var instance: AncDatabase? = null
+
+    fun get(context: Context): AncDatabase =
+      instance ?: synchronized(this) {
+        instance ?: Room.databaseBuilder(
+          context.applicationContext,
+          AncDatabase::class.java,
+          "anc.db",
+        )
+          .addCallback(SeedCallback)
+          .build()
+          .also { instance = it }
+      }
+  }
+
+  // Pre-existing clinic records, inserted once when the database file is first created.
+  private object SeedCallback : Callback() {
+    override fun onCreate(db: SupportSQLiteDatabase) {
+      db.execSQL(
+        "INSERT INTO patients (id, name, dateOfBirth, dueDate) VALUES " +
+          "(1, 'Emily Carter', '1996-04-12', '2026-12-05'), " +
+          "(2, 'Sarah Mitchell', '1990-11-02', '2027-01-20'), " +
+          "(3, 'Grace Thompson', '2001-07-30', '2026-10-15')"
+      )
+      // Gestational weeks derived from each visit date vs. the 280-day term ending at the due date.
+      db.execSQL(
+        "INSERT INTO visits (patientId, date, gestationalWeeks, weightKg, systolic, diastolic, hemoglobin, dangerSigns, notes) VALUES " +
+          "(1, '2026-08-10', 23, 68.5, 118, 76, 11.8, '', ''), " +
+          "(2, '2026-08-12', 17, 61.2, 110, 70, 12.4, '', ''), " +
+          "(3, '2026-08-05', 29, 72.0, 128, 84, 10.2, '', '')"
+      )
+    }
+  }
+}
