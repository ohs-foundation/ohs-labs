+package com.example.ancapp.data
+
+import androidx.room.Dao
+import androidx.room.Delete
+import androidx.room.Insert
+import androidx.room.Query
+import androidx.room.Transaction
+import kotlinx.coroutines.flow.Flow
+
+@Dao
+interface PatientDao {
+  @Insert
+  suspend fun insertPatient(patient: PatientEntity)
+
+  @Query("SELECT * FROM patients ORDER BY estimatedDueDate ASC")
+  fun getAllPatientsFlow(): Flow<List<PatientEntity>>
+
+  @Query("SELECT * FROM patients WHERE id = :patientId")
+  suspend fun getPatientById(patientId: String): PatientEntity?
+
+  @Transaction
+  @Query("SELECT * FROM patients WHERE id = :patientId")
+  suspend fun getPatientWithVisits(patientId: String): PatientWithVisits?
+
+  @Query("DELETE FROM patients")
+  suspend fun deleteAll()
+}
+
+@Dao
+interface AncVisitDao {
+  @Insert
+  suspend fun insertVisit(visit: AncVisitEntity): Long
+
+  @Query("SELECT * FROM anc_visits WHERE patientId = :patientId ORDER BY visitDate DESC")
+  suspend fun getVisitsByPatient(patientId: String): List<AncVisitEntity>
+
+  @Transaction
+  @Query("SELECT * FROM anc_visits WHERE id = :visitId")
+  suspend fun getVisitWithSigns(visitId: Long): AncVisitWithSigns?
+
+  @Delete
+  suspend fun deleteVisit(visit: AncVisitEntity)
+}
+
+@Dao
+interface DangerSignDao {
+  @Insert
+  suspend fun insertDangerSign(sign: DangerSignEntity)
+
+  @Query("SELECT * FROM danger_signs WHERE visitId = :visitId")
+  suspend fun getDangerSignsByVisit(visitId: Long): List<DangerSignEntity>
+
+  @Query("DELETE FROM danger_signs WHERE visitId = :visitId")
+  suspend fun deleteDangerSignsByVisit(visitId: Long)
+}
