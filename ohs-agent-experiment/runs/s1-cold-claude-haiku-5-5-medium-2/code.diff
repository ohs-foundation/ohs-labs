+}
+
+// Due date = LMP + 280 days, so days left until due maps straight to pregnancy days.
+fun gestationalDays(dueDate: LocalDate, on: LocalDate): Long = 280 - ChronoUnit.DAYS.between(on, dueDate)
+
+fun gestationalLabel(dueDate: LocalDate, on: LocalDate): String {
+  val days = gestationalDays(dueDate, on)
+  return "${days / 7}w ${days % 7}d"
+}
+
+fun ageOn(dob: LocalDate, on: LocalDate): Int = Period.between(dob, on).years
+
+@Composable
+fun AncApp(db: AncDatabase) {
+  var selectedId by rememberSaveable { mutableStateOf<Long?>(null) }
+  var formOpen by rememberSaveable { mutableStateOf(false) }
+  var version by remember { mutableIntStateOf(0) } // bumped after each save to reload from the DB
+
+  val patients = remember(version) { db.patients() }
+  val selected = patients.firstOrNull { it.id == selectedId }
+
+  BackHandler(enabled = selected != null) {
+    if (formOpen) formOpen = false else selectedId = null
+  }
+
+  when {
+    selected == null -> PatientList(patients) { selectedId = it.id }
+    formOpen -> VisitForm(
+      db,
+      selected,
+      onSaved = { version++; formOpen = false },
+      onCancel = { formOpen = false },
+    )
+    else -> PatientDetail(
+      db,
+      selected,
+      version,
+      onBack = { selectedId = null },
+      onRecord = { formOpen = true },
+    )
+  }
+}
+
+@Composable
+fun PatientList(patients: List<Patient>, onOpen: (Patient) -> Unit) {
+  val today = LocalDate.now()
+  Scaffold(topBar = { TopAppBar(title = { Text("Pregnant patients") }) }) { pad ->
+    LazyColumn(
+      modifier = Modifier.padding(pad),
+      contentPadding = PaddingValues(16.dp),
+      verticalArrangement = Arrangement.spacedBy(8.dp),
+    ) {
+      items(patients, key = { it.id }) { p ->
+        Card(onClick = { onOpen(p) }, modifier = Modifier.fillMaxWidth()) {
+          Column(Modifier.padding(16.dp)) {
+            Text(p.name, style = MaterialTheme.typography.titleMedium)
+            Text("Age ${ageOn(p.dob, today)} · Due ${p.dueDate} · ${gestationalLabel(p.dueDate, today)}")
+          }
+        }
+      }
+    }
   }
 }
+
+@Composable
+fun PatientDetail(db: AncDatabase, patient: Patient, version: Int, onBack: () -> Unit, onRecord: () -> Unit) {
+  val visits = remember(patient.id, version) { db.visits(patient.id) }
+  val today = LocalDate.now()
+  Scaffold(
+    topBar = {
+      TopAppBar(
+        title = { Text(patient.name) },
+        navigationIcon = {
+          IconButton(onClick = onBack) { Icon(Icons.AutoMirrored.Filled.ArrowBack, "Back") }
+        },
+      )
+    },
+    floatingActionButton = {
+      ExtendedFloatingActionButton(
+        onClick = onRecord,
+        icon = { Icon(Icons.Default.Add, null) },
+        text = { Text("Record visit") },
+      )
+    },
+  ) { pad ->
+    LazyColumn(
+      modifier = Modifier.padding(pad),
+      contentPadding = PaddingValues(start = 16.dp, top = 16.dp, end = 16.dp, bottom = 96.dp),
+      verticalArrangement = Arrangement.spacedBy(8.dp),
+    ) {
+      item {
+        Text("Age ${ageOn(patient.dob, today)} · Due ${patient.dueDate} · ${gestationalLabel(patient.dueDate, today)}")
+        Text("ANC visits", style = MaterialTheme.typography.titleMedium, modifier = Modifier.padding(top = 16.dp))
+      }
+      items(visits, key = { it.id }) { VisitCard(it) }
+    }
+  }
+}
+
+@Composable
+fun VisitCard(v: Visit) {
+  Card(modifier = Modifier.fillMaxWidth()) {
+    Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(4.dp)) {
+      Text("${v.date} · ${v.gaWeeks} weeks", style = MaterialTheme.typography.titleSmall)
+      Text(
+        "Weight ${v.weightKg} kg · BP ${v.systolic}/${v.diastolic} mmHg" +
+          (v.hemoglobin?.let { " · Hb $it g/dL" } ?: ""),
+      )
+      Text("Danger signs: " + if (v.dangerSigns.isEmpty()) "none" else v.dangerSigns.joinToString { it.label })
+      if (v.notes.isNotBlank()) Text(v.notes, style = MaterialTheme.typography.bodySmall)
+    }
+  }
+}
+
+@OptIn(ExperimentalLayoutApi::class)
+@Composable
+fun VisitForm(db: AncDatabase, patient: Patient, onSaved: () -> Unit, onCancel: () -> Unit) {
+  val today = LocalDate.now()
+  var date by rememberSaveable { mutableStateOf(today.toString()) }
+  var ga by rememberSaveable { mutableStateOf((gestationalDays(patient.dueDate, today) / 7).toString()) }
+  var weight by rememberSaveable { mutableStateOf("") }
+  var sys by rememberSaveable { mutableStateOf("") }
+  var dia by rememberSaveable { mutableStateOf("") }
+  var hb by rememberSaveable { mutableStateOf("") }
+  var notes by rememberSaveable { mutableStateOf("") }
+  val signs = rememberSaveable(
+    saver = listSaver(save = { it.toList() }, restore = { it.toMutableStateList() }),
+  ) { mutableStateListOf<DangerSign>() }
+  var attempted by remember { mutableStateOf(false) }
+
+  val dateV = runCatching { LocalDate.parse(date) }.getOrNull()
+  val gaV = ga.toIntOrNull()?.takeIf { it in 1..44 }
+  val weightV = weight.toDoubleOrNull()?.takeIf { it in 1.0..300.0 }
+  val sysV = sys.toIntOrNull()?.takeIf { it in 50..300 }
+  val diaV = dia.toIntOrNull()?.takeIf { it in 30..200 }
+  val hbV = hb.toDoubleOrNull()?.takeIf { it in 1.0..30.0 }
+  val hbBad = hb.isNotBlank() && hbV == null
+
+  Scaffold(
+    topBar = {
+      TopAppBar(
+        title = { Text("New visit") },
+        navigationIcon = {
+          IconButton(onClick = onCancel) { Icon(Icons.AutoMirrored.Filled.ArrowBack, "Cancel") }
+        },
+      )
+    },
+  ) { pad ->
+    Column(
+      modifier = Modifier.padding(pad).padding(16.dp).verticalScroll(rememberScrollState()),
+      verticalArrangement = Arrangement.spacedBy(12.dp),
+    ) {
+      Text(patient.name, style = MaterialTheme.typography.titleMedium)
+      Field("Visit date (yyyy-mm-dd)", date, { date = it }, attempted && dateV == null)
+      Field("Gestational age (weeks)", ga, { ga = it }, attempted && gaV == null, KeyboardType.Number)
+      Field("Weight (kg)", weight, { weight = it }, attempted && weightV == null, KeyboardType.Decimal)
+      Field("Systolic BP (mmHg)", sys, { sys = it }, attempted && sysV == null, KeyboardType.Number)
+      Field("Diastolic BP (mmHg)", dia, { dia = it }, attempted && diaV == null, KeyboardType.Number)
+      Field("Hemoglobin (g/dL, optional)", hb, { hb = it }, attempted && hbBad, KeyboardType.Decimal)
+
+      Text("Danger signs", style = MaterialTheme.typography.titleSmall)
+      FlowRow(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+        FilterChip(selected = signs.isEmpty(), onClick = { signs.clear() }, label = { Text("None") })
+        DangerSign.entries.forEach { s ->
+          FilterChip(
+            selected = s in signs,
+            onClick = { if (s in signs) signs.remove(s) else signs.add(s) },
+            label = { Text(s.label) },
+          )
+        }
+      }
+
+      OutlinedTextField(
+        value = notes,
+        onValueChange = { notes = it },
+        label = { Text("Notes") },
+        minLines = 3,
+        modifier = Modifier.fillMaxWidth(),
+      )
+
+      Button(
+        onClick = {
+          attempted = true
+          if (dateV != null && gaV != null && weightV != null && sysV != null && diaV != null && !hbBad) {
+            db.addVisit(
+              Visit(0, patient.id, dateV, gaV, weightV, sysV, diaV, hbV, signs.toSet(), notes.trim()),
+            )
+            onSaved()
+          }
+        },
+        modifier = Modifier.fillMaxWidth(),
+      ) { Text("Save visit") }
+    }
+  }
+}
+
+@Composable
+fun Field(
+  label: String,
+  value: String,
+  onChange: (String) -> Unit,
+  error: Boolean,
+  keyboard: KeyboardType = KeyboardType.Text,
+) = OutlinedTextField(
+  value = value,
+  onValueChange = onChange,
+  label = { Text(label) },
+  singleLine = true,
+  isError = error,
+  keyboardOptions = KeyboardOptions(keyboardType = keyboard),
+  modifier = Modifier.fillMaxWidth(),
+)
