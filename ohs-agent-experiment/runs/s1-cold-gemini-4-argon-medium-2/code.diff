+package com.example.ancapp.ui.theme
+
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.lightColorScheme
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.graphics.Color
+
+val ClinicTealPrimary = Color(0xFF0F6B6E)
+val ClinicTealOnPrimary = Color(0xFFFFFFFF)
+val ClinicTealContainer = Color(0xFFD6F3F3)
+val ClinicTealOnContainer = Color(0xFF002021)
+
+val ClinicRoseSecondary = Color(0xFF8C4A60)
+val ClinicRoseOnSecondary = Color(0xFFFFFFFF)
+val ClinicRoseContainer = Color(0xFFFFD9E2)
+val ClinicRoseOnContainer = Color(0xFF3A071D)
+
+val ClinicAmberWarning = Color(0xFFB45309)
+val ClinicAmberContainer = Color(0xFFFEF3C7)
+val ClinicDangerRed = Color(0xFFB91C1C)
+val ClinicDangerContainer = Color(0xFFFEE2E2)
+val ClinicSuccessGreen = Color(0xFF15803D)
+val ClinicSuccessContainer = Color(0xFFDCFCE7)
+
+val ClinicBackground = Color(0xFFF6F9F9)
+val ClinicSurface = Color(0xFFFFFFFF)
+val ClinicSurfaceVariant = Color(0xFFEEF3F3)
+
+private val LightColorScheme =
+  lightColorScheme(
+    primary = ClinicTealPrimary,
+    onPrimary = ClinicTealOnPrimary,
+    primaryContainer = ClinicTealContainer,
+    onPrimaryContainer = ClinicTealOnContainer,
+    secondary = ClinicRoseSecondary,
+    onSecondary = ClinicRoseOnSecondary,
+    secondaryContainer = ClinicRoseContainer,
+    onSecondaryContainer = ClinicRoseOnContainer,
+    error = ClinicDangerRed,
+    errorContainer = ClinicDangerContainer,
+    background = ClinicBackground,
+    surface = ClinicSurface,
+    surfaceVariant = ClinicSurfaceVariant,
+  )
+
+@Composable
+fun AncAppTheme(content: @Composable () -> Unit) {
+  MaterialTheme(
+    colorScheme = LightColorScheme,
+    content = content,
+  )
+}
