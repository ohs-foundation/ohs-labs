+        navigationIcon = {
+          IconButton(onClick = onBack) {
+            Icon(Icons.AutoMirrored.Filled.ArrowBack, contentDescription = "Back")
+          }
+        },
+      )
+    },
+    bottomBar = {
+      Surface(tonalElevation = 3.dp) {
+        Button(
+          onClick = viewModel::save,
+          enabled = !viewModel.isSaving,
+          modifier = Modifier
+            .fillMaxWidth()
+            // Lifts the button above the keyboard, and above the gesture bar otherwise.
+            .imePadding()
+            .navigationBarsPadding()
+            .padding(16.dp)
+            .heightIn(min = 52.dp),
+        ) { Text(if (viewModel.isSaving) "Saving…" else "Save visit") }
+      }
+    },
+  ) { padding ->
+    Column(
+      modifier = Modifier
+        .fillMaxSize()
+        .padding(padding)
+        .verticalScroll(rememberScrollState())
+        .padding(horizontal = 16.dp, vertical = 8.dp),
+      verticalArrangement = Arrangement.spacedBy(16.dp),
+    ) {
+      DateField(
+        date = form.visitDate,
+        error = errors.visitDate,
+        onClick = { showDatePicker = true },
+      )
+
+      NumberField(
+        value = form.gestationalAgeWeeks,
+        onValueChange = viewModel::onGestationalAgeChange,
+        label = "Gestational age (weeks)",
+        error = errors.gestationalAgeWeeks,
+        keyboardType = KeyboardType.Number,
+      )
+
+      NumberField(
+        value = form.weightKg,
+        onValueChange = viewModel::onWeightChange,
+        label = "Weight (kg)",
+        error = errors.weightKg,
+        keyboardType = KeyboardType.Decimal,
+      )
+
+      SectionLabel("Blood pressure (mmHg)")
+      Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
+        NumberField(
+          value = form.systolic,
+          onValueChange = viewModel::onSystolicChange,
+          label = "Systolic",
+          error = errors.systolic,
+          keyboardType = KeyboardType.Number,
+          modifier = Modifier.weight(1f),
+        )
+        NumberField(
+          value = form.diastolic,
+          onValueChange = viewModel::onDiastolicChange,
+          label = "Diastolic",
+          error = errors.diastolic,
+          keyboardType = KeyboardType.Number,
+          modifier = Modifier.weight(1f),
+        )
+      }
+
+      HorizontalDivider()
+
+      SectionLabel("Danger signs")
+      FlowRow(
+        modifier = Modifier.fillMaxWidth(),
+        horizontalArrangement = Arrangement.spacedBy(8.dp),
+        verticalArrangement = Arrangement.spacedBy(4.dp),
+      ) {
+        FilterChip(
+          selected = form.dangerSigns.isEmpty(),
+          onClick = viewModel::onNoDangerSigns,
+          label = { Text("None") },
+        )
+        DangerSign.entries.forEach { sign ->
+          FilterChip(
+            selected = sign in form.dangerSigns,
+            onClick = { viewModel.onDangerSignToggle(sign) },
+            label = { Text(sign.label) },
+          )
+        }
+      }
+
+      HorizontalDivider()
+
+      OutlinedTextField(
+        value = form.notes,
+        onValueChange = viewModel::onNotesChange,
+        label = { Text("Notes") },
+        placeholder = { Text("Anything else worth recording") },
+        minLines = 3,
+        keyboardOptions = KeyboardOptions(imeAction = ImeAction.Default),
+        modifier = Modifier.fillMaxWidth(),
+      )
+    }
+  }
+
+  if (showDatePicker) {
+    VisitDatePickerDialog(
+      initialDate = form.visitDate,
+      onDismiss = { showDatePicker = false },
+      onDateSelected = {
+        viewModel.onVisitDateChange(it)
+        showDatePicker = false
+      },
+    )
+  }
+}
+
+@Composable
+private fun SectionLabel(text: String) {
+  Text(
+    text = text,
+    style = MaterialTheme.typography.titleSmall,
+    color = MaterialTheme.colorScheme.onSurfaceVariant,
+  )
+}
+
+@Composable
+private fun DateField(date: LocalDate, error: String?, onClick: () -> Unit) {
+  Box {
+    OutlinedTextField(
+      value = date.formatLong(),
+      onValueChange = {},
+      readOnly = true,
+      label = { Text("Visit date") },
+      isError = error != null,
+      supportingText = error?.let { { Text(it) } },
+      trailingIcon = { Icon(Icons.Filled.DateRange, contentDescription = null) },
+      modifier = Modifier.fillMaxWidth(),
+    )
+    // Overlay sits on top of the read-only field and turns any tap into "open the picker".
+    Box(modifier = Modifier.matchParentSize().clickable(onClick = onClick))
+  }
+}
+
+@Composable
+private fun NumberField(
+  value: String,
+  onValueChange: (String) -> Unit,
+  label: String,
+  error: String?,
+  keyboardType: KeyboardType,
+  modifier: Modifier = Modifier,
+) {
+  OutlinedTextField(
+    value = value,
+    onValueChange = onValueChange,
+    label = { Text(label) },
+    singleLine = true,
+    isError = error != null,
+    supportingText = error?.let { { Text(it) } },
+    keyboardOptions = KeyboardOptions(keyboardType = keyboardType, imeAction = ImeAction.Next),
+    modifier = modifier.fillMaxWidth(),
+  )
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+private fun VisitDatePickerDialog(
+  initialDate: LocalDate,
+  onDismiss: () -> Unit,
+  onDateSelected: (LocalDate) -> Unit,
+) {
+  val todayUtcMillis = remember { LocalDate.now().toEpochDay() * MILLIS_PER_DAY }
+  val state = rememberDatePickerState(
+    initialSelectedDateMillis = initialDate.toEpochDay() * MILLIS_PER_DAY,
+    selectableDates = remember(todayUtcMillis) {
+      object : SelectableDates {
+        // A visit cannot have happened in the future.
+        override fun isSelectableDate(utcTimeMillis: Long) = utcTimeMillis <= todayUtcMillis
+        override fun isSelectableYear(year: Int) = year <= LocalDate.now().year
+      }
+    },
+  )
+
+  DatePickerDialog(
+    onDismissRequest = onDismiss,
+    confirmButton = {
+      TextButton(
+        onClick = {
+          state.selectedDateMillis?.let { millis ->
+            onDateSelected(
+              java.time.Instant.ofEpochMilli(millis).atZone(ZoneOffset.UTC).toLocalDate()
+            )
+          }
+        },
+        enabled = state.selectedDateMillis != null,
+      ) { Text("OK") }
+    },
+    dismissButton = { TextButton(onClick = onDismiss) { Text("Cancel") } },
+  ) { DatePicker(state = state) }
+}
+
+private const val MILLIS_PER_DAY = 86_400_000L
