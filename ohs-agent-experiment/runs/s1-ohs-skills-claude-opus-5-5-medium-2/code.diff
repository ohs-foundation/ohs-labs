+package com.example.ancapp
+
+import android.app.Application
+import android.content.Context
+import android.util.Log
+import androidx.work.ExistingWorkPolicy
+import androidx.work.WorkerParameters
+import dev.ohs.fhir.datacapture.DataCapture
+import dev.ohs.fhir.engine.FhirEngineConfiguration
+import dev.ohs.fhir.engine.FhirEngineProvider
+import dev.ohs.fhir.engine.ServerConfiguration
+import dev.ohs.fhir.engine.sync.AcceptLocalConflictResolver
+import dev.ohs.fhir.engine.sync.CurrentSyncJobStatus
+import dev.ohs.fhir.engine.sync.FhirSyncWorker
+import dev.ohs.fhir.engine.sync.Sync
+import dev.ohs.fhir.engine.sync.download.ResourceParamsBasedDownloadWorkManager
+import dev.ohs.fhir.engine.sync.upload.HttpCreateMethod
+import dev.ohs.fhir.engine.sync.upload.HttpUpdateMethod
+import dev.ohs.fhir.engine.sync.upload.UploadStrategy
+import dev.ohs.fhir.model.r4.terminologies.ResourceType
+import kotlinx.coroutines.MainScope
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.launch
+
+class AncApp : Application() {
+  /** Bumped after every finished sync so screens reload from the local DB. */
+  val syncCount = MutableStateFlow(0)
+  private val scope = MainScope()
+
+  override fun onCreate() {
+    super.onCreate()
+    FhirEngineProvider.init(
+      FhirEngineConfiguration(serverConfiguration = ServerConfiguration(baseUrl = "http://10.0.2.2:8080/fhir/")),
+      this,
+    )
+    DataCapture.initialize(this)
+    sync(ExistingWorkPolicy.KEEP)
+  }
+
+  fun sync(policy: ExistingWorkPolicy) =
+    scope.launch {
+      val end = Sync.oneTimeSync<AppSyncWorker>(this@AncApp, existingWorkPolicy = policy).first {
+        it is CurrentSyncJobStatus.Succeeded || it is CurrentSyncJobStatus.Failed || it is CurrentSyncJobStatus.Cancelled
+      }
+      Log.i("AncApp", "sync finished: $end")
+      syncCount.value++
+    }
+}
+
+class AppSyncWorker(context: Context, params: WorkerParameters) : FhirSyncWorker(context, params) {
+  override fun getFhirEngine() = FhirEngineProvider.getInstance(applicationContext)
+
+  override fun getDownloadWorkManager() =
+    ResourceParamsBasedDownloadWorkManager(
+      syncParams =
+        listOf(
+            ResourceType.Patient,
+            ResourceType.Encounter,
+            ResourceType.Observation,
+            ResourceType.Questionnaire,
+            ResourceType.QuestionnaireResponse,
+          )
+          .associateWith { emptyMap() },
+      context = Watermarks(applicationContext),
+    )
+
+  override fun getConflictResolver() = AcceptLocalConflictResolver
+
+  override fun getUploadStrategy() =
+    UploadStrategy.forIndividualRequest(HttpCreateMethod.PUT, HttpUpdateMethod.PATCH, squash = true)
+}
+
+private class Watermarks(private val context: Context) : ResourceParamsBasedDownloadWorkManager.TimestampContext {
+  private val prefs get() = context.getSharedPreferences("sync_timestamps", Context.MODE_PRIVATE)
+
+  override suspend fun saveLastUpdatedTimestamp(resourceType: ResourceType, timestamp: String?) {
+    prefs.edit().putString(resourceType.name, timestamp).apply()
+  }
+
+  override suspend fun getLasUpdateTimestamp(resourceType: ResourceType): String? =
+    prefs.getString(resourceType.name, null)
+}
diff --git a/app/src/main/java/com/example/ancapp/AncData.kt b/app/src/main/java/com/example/ancapp/AncData.kt
