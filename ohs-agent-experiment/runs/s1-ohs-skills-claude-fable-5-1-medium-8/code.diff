@@ -0,0 +1,181 @@
+package com.example.ancapp
+
+import android.app.Application
+import androidx.lifecycle.AndroidViewModel
+import androidx.lifecycle.viewModelScope
+import com.ionspin.kotlin.bignum.decimal.BigDecimal
+import dev.ohs.fhir.engine.get
+import dev.ohs.fhir.engine.search.ReferenceClientParam
+import dev.ohs.fhir.engine.search.Search
+import dev.ohs.fhir.engine.sync.CurrentSyncJobStatus
+import dev.ohs.fhir.engine.sync.Sync
+import dev.ohs.fhir.model.r4.Code
+import dev.ohs.fhir.model.r4.CodeableConcept
+import dev.ohs.fhir.model.r4.Coding
+import dev.ohs.fhir.model.r4.DateTime
+import dev.ohs.fhir.model.r4.Decimal
+import dev.ohs.fhir.model.r4.Encounter
+import dev.ohs.fhir.model.r4.Enumeration
+import dev.ohs.fhir.model.r4.FhirDateTime
+import dev.ohs.fhir.model.r4.Observation
+import dev.ohs.fhir.model.r4.Patient
+import dev.ohs.fhir.model.r4.Period
+import dev.ohs.fhir.model.r4.Quantity
+import dev.ohs.fhir.model.r4.Questionnaire
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import dev.ohs.fhir.model.r4.Reference
+import dev.ohs.fhir.model.r4.Resource
+import dev.ohs.fhir.model.r4.Uri
+import dev.ohs.fhir.model.r4.String as FhirString
+import dev.ohs.fhir.model.r4.terminologies.ResourceType
+import java.time.LocalDate
+import java.time.temporal.ChronoUnit
+import java.util.UUID
+import kotlin.time.Duration.Companion.minutes
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.catch
+import kotlinx.coroutines.flow.firstOrNull
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withTimeoutOrNull
+import kotlinx.serialization.json.Json
+
+const val LOINC = "http://loinc.org"
+const val UCUM = "http://unitsofmeasure.org"
+const val WEIGHT = "29463-7"
+const val BP_PANEL = "85354-9"
+const val SYSTOLIC = "8480-6"
+const val DIASTOLIC = "8462-4"
+const val HB = "718-7"
+const val EDD = "11778-8"
+
+data class PatientRow(val id: String, val name: String, val age: Int, val dueDate: LocalDate?, val weeks: Long?)
+data class Visit(val date: String, val weight: String?, val bp: String?, val hb: String?)
+
+val fhirJson = Json { explicitNulls = false; encodeDefaults = false }
+
+class AncViewModel(app: Application) : AndroidViewModel(app) {
+  private val engine = dev.ohs.fhir.engine.FhirEngineProvider.getInstance(app)
+  val patients = MutableStateFlow<List<PatientRow>>(emptyList())
+  val syncState = MutableStateFlow("Syncing…")
+
+  init { viewModelScope.launch { loadPatients(); sync() } }
+
+  private suspend fun sync() {
+    val status = withTimeoutOrNull(5.minutes) {
+      Sync.oneTimeSync<AppSyncWorker>(getApplication()).catch { }.firstOrNull {
+        it is CurrentSyncJobStatus.Succeeded || it is CurrentSyncJobStatus.Failed || it is CurrentSyncJobStatus.Cancelled
+      }
+    }
+    syncState.value = if (status is CurrentSyncJobStatus.Succeeded) "Synced" else "Sync failed, showing local data"
+    loadPatients()
+  }
+
+  private suspend fun loadPatients() {
+    val today = LocalDate.now()
+    val edds = engine.search<Observation>(Search(ResourceType.Observation)).map { it.resource }
+      .filter { it.loinc() == EDD }
+      .groupBy { it.subject?.reference?.value?.substringAfter("/") }
+      .mapValues { (_, obs) -> obs.mapNotNull { it.value?.asDateTime()?.value?.value?.toString()?.let(::parseDate) }.maxOrNull() }
+    patients.value = engine.search<Patient>(Search(ResourceType.Patient)).map { it.resource }.map { p ->
+      val id = p.id ?: ""
+      val n = p.name.firstOrNull()
+      val dob = p.birthDate?.value?.toString()?.let(::parseDate)
+      val edd = edds[id]
+      PatientRow(
+        id = id,
+        name = listOfNotNull(n?.given?.mapNotNull { it.value }?.joinToString(" "), n?.family?.value).joinToString(" "),
+        age = dob?.let { ChronoUnit.YEARS.between(it, today).toInt() } ?: 0,
+        dueDate = edd,
+        weeks = edd?.let { 40 - ChronoUnit.DAYS.between(today, it) / 7 },
+      )
+    }.sortedWith(compareBy(nullsLast()) { it.dueDate })
+  }
+
+  suspend fun visits(patientId: String): List<Visit> {
+    val obs = engine.search<Observation>(Search(ResourceType.Observation).apply {
+      filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+    }).map { it.resource }.groupBy { it.encounter?.reference?.value?.substringAfter("/") }
+    return engine.search<Encounter>(Search(ResourceType.Encounter).apply {
+      filter(ReferenceClientParam("subject"), { value = "Patient/$patientId" })
+    }).map { it.resource }.map { e ->
+      val o = obs[e.id].orEmpty()
+      val bp = o.firstOrNull { it.loinc() == BP_PANEL }
+      fun comp(code: String) = bp?.component?.firstOrNull { c -> c.code.coding.any { it.code?.value == code } }
+        ?.value?.asQuantity()?.value?.value?.value?.toPlainString()
+      Visit(
+        date = e.period?.start?.value?.toString()?.substringBefore("T") ?: "",
+        weight = o.firstOrNull { it.loinc() == WEIGHT }?.quantity()?.let { "$it kg" },
+        bp = comp(SYSTOLIC)?.let { s -> "$s/${comp(DIASTOLIC)} mmHg" },
+        hb = o.firstOrNull { it.loinc() == HB }?.quantity()?.let { "$it g/dL" },
+      )
+    }.sortedByDescending { it.date }
+  }
+
+  suspend fun questionnaireJson(): String = fhirJson.encodeToString(engine.get<Questionnaire>("anc-contact"))
+
+  suspend fun saveVisit(patientId: String, response: QuestionnaireResponse) {
+    val answers = mutableMapOf<String, List<QuestionnaireResponse.Item.Answer>>()
+    fun collect(items: List<QuestionnaireResponse.Item>) {
+      items.forEach { item ->
+        item.linkId.value?.let { answers[it] = item.answer }
+        collect(item.item)
+        item.answer.forEach { collect(it.item) }
+      }
+    }
+    collect(response.item)
+    val date = answers["visit-date"]?.firstOrNull()?.value?.asDate()?.value?.value?.toString() ?: LocalDate.now().toString()
+    val weight = answers["weight"]?.firstOrNull()?.value?.asDecimal()?.value?.value
+    val sys = answers["bp-systolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+    val dia = answers["bp-diastolic"]?.firstOrNull()?.value?.asInteger()?.value?.value
+
+    val encId = UUID.randomUUID().toString()
+    val subject = Reference(reference = FhirString(value = "Patient/$patientId"))
+    val encRef = Reference(reference = FhirString(value = "Encounter/$encId"))
+    val when_ = Observation.Effective.DateTime(DateTime(value = FhirDateTime.fromString(date)))
+    fun obs(code: String, display: String, value: Observation.Value?, component: List<Observation.Component> = emptyList()) =
+      Observation(
+        id = UUID.randomUUID().toString(),
+        status = Enumeration(value = Observation.ObservationStatus.Final),
+        code = concept(code, display),
+        subject = subject, encounter = encRef, effective = when_,
+        value = value, component = component,
+      )
+    val resources = mutableListOf<Resource>(
+      Encounter(
+        id = encId,
+        status = Enumeration(value = Encounter.EncounterStatus.Finished),
+        `class` = Coding(system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"), code = Code(value = "AMB"), display = FhirString(value = "ambulatory")),
+        type = listOf(CodeableConcept(text = FhirString(value = "Antenatal care contact"))),
+        subject = subject,
+        period = Period(start = DateTime(value = FhirDateTime.fromString(date)), end = DateTime(value = FhirDateTime.fromString(date))),
+      ),
+      response.toBuilder().apply {
+        id = UUID.randomUUID().toString()
+        status = Enumeration(value = QuestionnaireResponse.QuestionnaireResponseStatus.Completed)
+        this.subject = subject.toBuilder()
+        this.encounter = encRef.toBuilder()
+        questionnaire = dev.ohs.fhir.model.r4.Canonical(value = "http://example.org/fhir/Questionnaire/anc-contact").toBuilder()
+      }.build(),
+    )
+    weight?.let { resources += obs(WEIGHT, "Body weight", Observation.Value.Quantity(qty(it, "kg", "kg"))) }
+    if (sys != null && dia != null) resources += obs(
+      BP_PANEL, "Blood pressure", null,
+      listOf(
+        Observation.Component(code = concept(SYSTOLIC, "Systolic blood pressure"), value = Observation.Component.Value.Quantity(qty(BigDecimal.fromInt(sys), "mmHg", "mm[Hg]"))),
+        Observation.Component(code = concept(DIASTOLIC, "Diastolic blood pressure"), value = Observation.Component.Value.Quantity(qty(BigDecimal.fromInt(dia), "mmHg", "mm[Hg]"))),
+      ),
+    )
+    engine.create(*resources.toTypedArray())
+    viewModelScope.launch { sync() }
+  }
+}
+
+private fun parseDate(s: String) = runCatching { LocalDate.parse(s.substringBefore("T")) }.getOrNull()
+private fun Observation.loinc() = code.coding.firstOrNull { it.system?.value == LOINC }?.code?.value
+private fun Observation.quantity() = value?.asQuantity()?.value?.value?.value?.toPlainString()
+private fun concept(code: String, display: String) = CodeableConcept(
+  coding = listOf(Coding(system = Uri(value = LOINC), code = Code(value = code), display = FhirString(value = display))),
+  text = FhirString(value = display),
+)
+private fun qty(v: BigDecimal, unit: String, code: String) =
+  Quantity(value = Decimal(value = v), unit = FhirString(value = unit), system = Uri(value = UCUM), code = Code(value = code))
