+package com.example.ancapp.ui
+
+import android.app.Application
+import androidx.lifecycle.AndroidViewModel
+import com.example.ancapp.data.AncDatabaseHelper
+import com.example.ancapp.model.AncVisit
+import com.example.ancapp.model.PatientWithVisits
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+
+sealed interface Screen {
+  data object Register : Screen
+  data class PatientDetail(val patientId: Long) : Screen
+  data class RecordVisit(val patientId: Long) : Screen
+}
+
+data class AncUiState(
+  val patients: List<PatientWithVisits> = emptyList(),
+  val currentScreen: Screen = Screen.Register,
+  val lastSavedMessage: String? = null
+) {
+  fun selectedPatient(patientId: Long): PatientWithVisits? =
+    patients.find { it.patient.id == patientId }
+}
+
+class AncViewModel(application: Application) : AndroidViewModel(application) {
+  private val dbHelper = AncDatabaseHelper.getInstance(application)
+
+  private val _uiState = MutableStateFlow(AncUiState())
+  val uiState: StateFlow<AncUiState> = _uiState.asStateFlow()
+
+  init {
+    refreshPatients()
+  }
+
+  fun refreshPatients() {
+    val allPatients = dbHelper.getAllPatientsSortedByDueDate()
+    _uiState.update { it.copy(patients = allPatients) }
+  }
+
+  fun openPatientDetail(patientId: Long) {
+    _uiState.update {
+      it.copy(
+        currentScreen = Screen.PatientDetail(patientId),
+        lastSavedMessage = null
+      )
+    }
+  }
+
+  fun openRecordVisit(patientId: Long) {
+    _uiState.update {
+      it.copy(
+        currentScreen = Screen.RecordVisit(patientId),
+        lastSavedMessage = null
+      )
+    }
+  }
+
+  fun navigateBack(): Boolean {
+    val current = _uiState.value.currentScreen
+    return when (current) {
+      is Screen.RecordVisit -> {
+        _uiState.update { it.copy(currentScreen = Screen.PatientDetail(current.patientId)) }
+        true
+      }
+      is Screen.PatientDetail -> {
+        _uiState.update {
+          it.copy(
+            currentScreen = Screen.Register,
+            lastSavedMessage = null
+          )
+        }
+        true
+      }
+      Screen.Register -> false
+    }
+  }
+
+  fun clearMessage() {
+    _uiState.update { it.copy(lastSavedMessage = null) }
+  }
+
+  fun saveVisit(visit: AncVisit) {
+    dbHelper.insertVisit(visit)
+    val updatedPatients = dbHelper.getAllPatientsSortedByDueDate()
+    _uiState.update {
+      it.copy(
+        patients = updatedPatients,
+        currentScreen = Screen.PatientDetail(visit.patientId),
+        lastSavedMessage = "Visit on ${visit.visitDate} recorded."
+      )
+    }
+  }
+}
