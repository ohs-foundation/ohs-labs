+
+/** Tiny loader: runs [load] on IO, exposes result or error; [reload] re-runs. */
+@Composable
+fun <T> rememberLoaded(vararg keys: Any?, load: () -> T): Triple<T?, String?, () -> Unit> {
+  var result by remember(*keys) { mutableStateOf<T?>(null) }
+  var error by remember(*keys) { mutableStateOf<String?>(null) }
+  var tick by remember(*keys) { mutableIntStateOf(0) }
+  LaunchedEffect(tick, *keys) {
+    result = null; error = null
+    try { result = withContext(Dispatchers.IO) { load() } } catch (e: Exception) { error = e.message ?: e.toString() }
+  }
+  return Triple(result, error, { tick++ })
+}
+
+@Composable
+fun App() {
+  var patient by remember { mutableStateOf<Patient?>(null) }
+  var recording by remember { mutableStateOf(false) }
+  val p = patient
+  when {
+    p == null -> RegisterScreen { patient = it }
+    recording -> VisitFormScreen(p, onDone = { recording = false })
+    else -> DetailScreen(p, onBack = { patient = null }, onRecord = { recording = true })
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun RegisterScreen(onSelect: (Patient) -> Unit) {
+  val (patients, error, reload) = rememberLoaded { loadPatients() }
+  Scaffold(topBar = { TopAppBar(title = { Text("ANC Register") }) }) { pad ->
+    Box(Modifier.padding(pad).fillMaxSize()) {
+      when {
+        error != null -> ErrorView(error, reload)
+        patients == null -> CircularProgressIndicator(Modifier.align(androidx.compose.ui.Alignment.Center))
+        else -> LazyColumn {
+          items(patients) { pt ->
+            ListItem(
+              modifier = Modifier.clickable { onSelect(pt) },
+              headlineContent = { Text(pt.name) },
+              supportingContent = {
+                Text("Age ${pt.age ?: "?"} · EDD ${pt.edd ?: "unknown"} · ${pt.weeks?.let { "$it weeks" } ?: "GA unknown"}")
+              },
+            )
+            HorizontalDivider()
+          }
+        }
+      }
+    }
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun DetailScreen(p: Patient, onBack: () -> Unit, onRecord: () -> Unit) {
+  BackHandler(onBack = onBack)
+  val (visits, error, reload) = rememberLoaded(p.id) { loadVisits(p.id) }
+  Scaffold(
+    topBar = { TopAppBar(title = { Text(p.name) }, navigationIcon = { TextButton(onClick = onBack) { Text("Back") } }) },
+    floatingActionButton = { ExtendedFloatingActionButton(onClick = onRecord) { Text("New visit") } },
+  ) { pad ->
+    Box(Modifier.padding(pad).fillMaxSize()) {
+      when {
+        error != null -> ErrorView(error, reload)
+        visits == null -> CircularProgressIndicator(Modifier.align(androidx.compose.ui.Alignment.Center))
+        visits.isEmpty() -> Text("No visits recorded", Modifier.padding(16.dp))
+        else -> LazyColumn {
+          item { Text("Age ${p.age ?: "?"} · EDD ${p.edd ?: "unknown"} · ${p.weeks ?: "?"} weeks", Modifier.padding(16.dp)) }
+          items(visits) { v ->
+            ListItem(
+              headlineContent = { Text(v.date) },
+              supportingContent = {
+                val bp = if (v.systolic != null || v.diastolic != null) "BP ${v.systolic?.fmt() ?: "?"}/${v.diastolic?.fmt() ?: "?"}" else null
+                Text(listOfNotNull(v.weight?.let { "Weight ${it.fmt()} kg" }, bp, v.hb?.let { "Hb ${it.fmt()} g/dL" })
+                  .ifEmpty { listOf("No measurements") }.joinToString(" · "))
+              },
+            )
+            HorizontalDivider()
+          }
+        }
+      }
+    }
+  }
+}
+
+private fun Double.fmt() = if (this % 1.0 == 0.0) toLong().toString() else toString()
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun VisitFormScreen(p: Patient, onDone: () -> Unit) {
+  BackHandler(onBack = onDone)
+  val (q, error, reload) = rememberLoaded { loadQuestionnaire() }
+  val answers = remember { mutableStateMapOf<String, Any>("visit-date" to LocalDate.now().toString()) }
+  var saving by remember { mutableStateOf(false) }
+  var saveError by remember { mutableStateOf<String?>(null) }
+  val scope = rememberCoroutineScope()
+  val snackbar = remember { SnackbarHostState() }
+
+  val validation = q?.let { validate(it.getJSONArray("item"), answers) } ?: emptyMap()
+
+  Scaffold(
+    topBar = { TopAppBar(title = { Text(q?.optString("title")?.ifEmpty { null } ?: "ANC visit") }, navigationIcon = { TextButton(onClick = onDone) { Text("Cancel") } }) },
+    snackbarHost = { SnackbarHost(snackbar) },
+  ) { pad ->
+    Box(Modifier.padding(pad).fillMaxSize()) {
+      when {
+        error != null -> ErrorView(error, reload)
+        q == null -> CircularProgressIndicator(Modifier.align(androidx.compose.ui.Alignment.Center))
+        else -> Column(Modifier.verticalScroll(rememberScrollState()).imePadding().navigationBarsPadding().padding(16.dp)) {
+          Text(p.name, style = MaterialTheme.typography.titleMedium)
+          QuestionnaireItems(q.getJSONArray("item"), answers, validation)
+          saveError?.let { Text(it, color = MaterialTheme.colorScheme.error, modifier = Modifier.padding(vertical = 8.dp)) }
+          Button(
+            enabled = !saving && validation.isEmpty(),
+            modifier = Modifier.fillMaxWidth().padding(top = 16.dp),
+            onClick = {
+              saving = true; saveError = null
+              scope.launch {
+                try {
+                  withContext(Dispatchers.IO) { saveVisit(p.id, q, answers.toMap()) }
+                  onDone()
+                } catch (e: Exception) { saveError = "Save failed: ${e.message}"; saving = false }
+              }
+            },
+          ) { Text(if (saving) "Saving…" else "Save visit") }
+        }
+      }
+    }
+  }
+}
+
+/** linkId -> error message for invalid/missing answers. */
+fun validate(items: JSONArray, answers: Map<String, Any>): Map<String, String> {
+  val errs = mutableMapOf<String, String>()
+  for (q in items.objs()) {
+    val id = q.getString("linkId")
+    val v = (answers[id] as? String)?.trim().orEmpty()
+    when (q.getString("type")) {
+      "group" -> errs += validate(q.getJSONArray("item"), answers)
+      "date" -> if (v.isNotEmpty()) try { LocalDate.parse(v) } catch (e: DateTimeParseException) { errs[id] = "Use YYYY-MM-DD" }
+      "integer" -> if (v.isNotEmpty() && v.toIntOrNull() == null) errs[id] = "Whole number required"
+      "decimal" -> if (v.isNotEmpty() && v.toDoubleOrNull() == null) errs[id] = "Number required"
+    }
+    if (q.optBoolean("required") && v.isEmpty() && q.getString("type") != "choice") errs[id] = "Required"
+  }
+  return errs
+}
+
+@Composable
+fun QuestionnaireItems(items: JSONArray, answers: MutableMap<String, Any>, errors: Map<String, String>) {
+  for (q in items.objs()) {
+    val id = q.getString("linkId")
+    val label = q.optString("text") + if (q.optBoolean("required")) " *" else ""
+    when (val type = q.getString("type")) {
+      "group" -> {
+        Text(q.optString("text"), style = MaterialTheme.typography.titleSmall, modifier = Modifier.padding(top = 16.dp))
+        QuestionnaireItems(q.getJSONArray("item"), answers, errors)
+      }
+      "choice" -> {
+        Text(label, style = MaterialTheme.typography.titleSmall, modifier = Modifier.padding(top = 16.dp))
+        @Suppress("UNCHECKED_CAST")
+        val selected = answers[id] as? Set<String> ?: emptySet()
+        for (opt in q.getJSONArray("answerOption").objs().map { it.getJSONObject("valueCoding") }) {
+          val code = opt.getString("code")
+          Row(Modifier.fillMaxWidth().clickable {
+            answers[id] = when {
+              code in selected -> selected - code
+              code == "none" || !q.optBoolean("repeats") -> setOf(code)
+              else -> selected - "none" + code
+            }
+          }, verticalAlignment = androidx.compose.ui.Alignment.CenterVertically) {
+            Checkbox(checked = code in selected, onCheckedChange = null)
+            Text(opt.optString("display", code), Modifier.padding(start = 8.dp))
+          }
+        }
+      }
+      else -> OutlinedTextField(
+        value = answers[id] as? String ?: "",
+        onValueChange = { answers[id] = it },
+        label = { Text(label) },
+        isError = id in errors,
+        supportingText = errors[id]?.let { { Text(it) } },
+        placeholder = if (type == "date") { { Text("YYYY-MM-DD") } } else null,
+        singleLine = type != "text",
+        minLines = if (type == "text") 3 else 1,
+        keyboardOptions = KeyboardOptions(keyboardType = when (type) { "integer" -> KeyboardType.Number; "decimal" -> KeyboardType.Decimal; else -> KeyboardType.Text }),
+        modifier = Modifier.fillMaxWidth().padding(top = 8.dp),
+      )
+    }
+  }
+}
+
+@Composable
+fun ErrorView(message: String, retry: () -> Unit) {
+  Column(Modifier.padding(16.dp)) {
+    Text("Could not reach the FHIR server", style = MaterialTheme.typography.titleMedium)
+    Text(message, Modifier.padding(vertical = 8.dp))
+    Button(onClick = retry) { Text("Retry") }
   }
 }
