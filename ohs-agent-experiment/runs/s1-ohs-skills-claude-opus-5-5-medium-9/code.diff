+// ---- Data access ----
+
+const val LOINC = "http://loinc.org"
+const val EDD = "11778-8"
+const val WEIGHT = "29463-7"
+const val BP = "85354-9"
+const val SYSTOLIC = "8480-6"
+const val DIASTOLIC = "8462-4"
+const val HB = "718-7"
+
+data class PatientRow(val id: String, val name: String, val age: Int?, val dueDate: LocalDate?, val weeks: Long?)
+
+data class Visit(val date: String, val weight: String?, val bp: String?, val hb: String?)
+
+private fun Observation.loinc() = code.coding.firstOrNull { it.system?.value == LOINC }?.code?.value
+
+private fun Observation.qty() = value?.asQuantity()?.value?.value?.value?.toPlainString()
+
+private fun Observation.Component.qty() = value?.asQuantity()?.value?.value?.value?.toPlainString()
+
+private fun ref(r: Reference?) = r?.reference?.value?.substringAfter("/")
+
+private fun parseDate(s: String?) = s?.let { runCatching { LocalDate.parse(it.substringBefore("T")) }.getOrNull() }
+
+fun Patient.displayName(): String {
+  val n = name.firstOrNull()
+  return listOfNotNull(n?.given?.mapNotNull { it.value }?.joinToString(" "), n?.family?.value).joinToString(" ")
+}
+
+suspend fun FhirEngine.loadRegister(today: LocalDate = LocalDate.now()): List<PatientRow> {
+  val edds = search<Observation>(Search(ResourceType.Observation)).map { it.resource }
+    .filter { it.loinc() == EDD }
+    .groupBy { ref(it.subject) }
+    .mapValues { (_, obs) ->
+      obs.mapNotNull { parseDate(it.value?.asDateTime()?.value?.value?.toString()) }.maxOrNull()
+    }
+  return search<Patient>(Search(ResourceType.Patient)).map { it.resource }
+    .filter { it.active?.value != false }
+    .map { p ->
+      val due = edds[p.id]
+      PatientRow(
+        id = p.id!!,
+        name = p.displayName(),
+        age = parseDate(p.birthDate?.value?.toString())?.let { ChronoUnit.YEARS.between(it, today).toInt() },
+        dueDate = due,
+        // Naegele: conception-dated pregnancy is 280 days at EDD.
+        weeks = due?.let { (280 - ChronoUnit.DAYS.between(today, it)) / 7 },
+      )
+    }
+    .sortedWith(compareBy(nullsLast()) { it.dueDate })
+}
+
+suspend fun FhirEngine.loadVisits(patientId: String): List<Visit> {
+  val obsByEnc = search<Observation>(Search(ResourceType.Observation)).map { it.resource }
+    .filter { ref(it.subject) == patientId }
+    .groupBy { ref(it.encounter) }
+  return search<Encounter>(Search(ResourceType.Encounter)).map { it.resource }
+    .filter { ref(it.subject) == patientId }
+    .map { e ->
+      val obs = obsByEnc[e.id].orEmpty()
+      val bp = obs.firstOrNull { it.loinc() == BP }?.let { o ->
+        val s = o.component.firstOrNull { c -> c.code.coding.any { it.code?.value == SYSTOLIC } }?.qty()
+        val d = o.component.firstOrNull { c -> c.code.coding.any { it.code?.value == DIASTOLIC } }?.qty()
+        if (s != null || d != null) "${s ?: "?"}/${d ?: "?"}" else null
+      }
+      Visit(
+        date = e.period?.start?.value?.toString()?.substringBefore("T") ?: "",
+        weight = obs.firstOrNull { it.loinc() == WEIGHT }?.qty(),
+        bp = bp,
+        hb = obs.firstOrNull { it.loinc() == HB }?.qty(),
+      )
+    }
+    .sortedByDescending { it.date }
+}
+
+suspend fun FhirEngine.questionnaireJson(): String? =
+  runCatching { fhirJson.encodeToString(get<Questionnaire>("anc-contact")) }.getOrNull()
+
+private fun loincConcept(code: String, display: String) = CodeableConcept(
+  coding = listOf(Coding(system = Uri(value = LOINC), code = Code(value = code), display = FhirString(value = display))),
+  text = FhirString(value = display),
+)
+
+private fun quantity(v: BigDecimal, unit: String, ucum: String) = Quantity(
+  value = Decimal(value = v),
+  unit = FhirString(value = unit),
+  system = Uri(value = "http://unitsofmeasure.org"),
+  code = Code(value = ucum),
+)
+
+/** Persists the form as QuestionnaireResponse + Encounter + weight/BP Observations, matching the server's existing shape. */
+suspend fun FhirEngine.saveVisit(patientId: String, response: QuestionnaireResponse) {
+  val answers = mutableMapOf<String, MutableList<QuestionnaireResponse.Item.Answer>>()
+  fun collect(items: List<QuestionnaireResponse.Item>) {
+    items.forEach { item ->
+      item.linkId.value?.let { answers.getOrPut(it) { mutableListOf() }.addAll(item.answer) }
+      collect(item.item)
+      item.answer.forEach { collect(it.item) }
+    }
+  }
+  collect(response.item)
+  fun first(id: String) = answers[id]?.firstOrNull()?.value
+
+  val date = first("visit-date")?.asDate()?.value?.value?.toString() ?: LocalDate.now().toString()
+  val weight = first("weight")?.asDecimal()?.value?.value
+  val sys = first("bp-systolic")?.asInteger()?.value?.value
+  val dia = first("bp-diastolic")?.asInteger()?.value?.value
+
+  val patientRef = Reference(reference = FhirString(value = "Patient/$patientId"))
+  val encId = UUID.randomUUID().toString()
+  val encRef = Reference(reference = FhirString(value = "Encounter/$encId"))
+  val when_ = DateTime(value = FhirDateTime.fromString(date))
+  val effective = Observation.Effective.DateTime(when_)
+  val vitalSigns = CodeableConcept(
+    coding = listOf(
+      Coding(
+        system = Uri(value = "http://terminology.hl7.org/CodeSystem/observation-category"),
+        code = Code(value = "vital-signs"),
+        display = FhirString(value = "Vital Signs"),
+      )
+    )
+  )
+  fun obs(code: CodeableConcept, value: Observation.Value?, components: List<Observation.Component> = emptyList()) =
+    Observation(
+      id = UUID.randomUUID().toString(),
+      status = Enumeration(value = Observation.ObservationStatus.Final),
+      category = listOf(vitalSigns),
+      code = code,
+      subject = patientRef,
+      encounter = encRef,
+      effective = effective,
+      value = value,
+      component = components,
+    )
+
+  val resources = buildList {
+    add(
+      Encounter(
+        id = encId,
+        status = Enumeration(value = Encounter.EncounterStatus.Finished),
+        `class` = Coding(
+          system = Uri(value = "http://terminology.hl7.org/CodeSystem/v3-ActCode"),
+          code = Code(value = "AMB"),
+          display = FhirString(value = "ambulatory"),
+        ),
+        type = listOf(CodeableConcept(text = FhirString(value = "Antenatal care contact"))),
+        subject = patientRef,
+        period = Period(start = when_, end = when_),
+      )
+    )
+    if (weight != null) {
+      add(obs(loincConcept(WEIGHT, "Body weight"), Observation.Value.Quantity(quantity(weight, "kg", "kg"))))
+    }
+    if (sys != null || dia != null) {
+      val comps = listOfNotNull(
+        sys?.let { Observation.Component(code = loincConcept(SYSTOLIC, "Systolic blood pressure"), value = Observation.Component.Value.Quantity(quantity(BigDecimal.fromInt(it), "mmHg", "mm[Hg]"))) },
+        dia?.let { Observation.Component(code = loincConcept(DIASTOLIC, "Diastolic blood pressure"), value = Observation.Component.Value.Quantity(quantity(BigDecimal.fromInt(it), "mmHg", "mm[Hg]"))) },
+      )
+      add(obs(loincConcept(BP, "Blood pressure"), null, comps))
+    }
+    // Gestational age, danger signs and notes live in the QuestionnaireResponse.
+    add(
+      response.toBuilder().apply {
+        id = UUID.randomUUID().toString()
+        status = Enumeration(value = QuestionnaireResponse.QuestionnaireResponseStatus.Completed)
+        subject = patientRef.toBuilder()
+        encounter = encRef.toBuilder()
+        questionnaire = Canonical(value = "http://example.org/fhir/Questionnaire/anc-contact").toBuilder()
+      }.build()
+    )
+  }
+  create(*resources.toTypedArray())
+}
