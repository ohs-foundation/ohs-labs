+package com.example.ancapp
+
+import android.content.Context
+import org.json.JSONArray
+import org.json.JSONObject
+import java.time.LocalDate
+import java.time.temporal.ChronoUnit
+
+data class Patient(val id: Int, val name: String, val dob: LocalDate, val dueDate: LocalDate) {
+  fun age(today: LocalDate) = ChronoUnit.YEARS.between(dob, today).toInt()
+  // 40 weeks at the due date
+  fun weeks(today: LocalDate) = (280 - ChronoUnit.DAYS.between(today, dueDate).toInt()) / 7
+}
+
+data class Visit(
+  val patientId: Int, val date: LocalDate, val weeks: Int, val weightKg: Double,
+  val systolic: Int, val diastolic: Int, val hb: Double? = null,
+  val dangerSigns: List<String> = emptyList(), val notes: String = "",
+)
+
+// ponytail: patients are fixed seed data (no registration requirement); add a table if the clinic needs to add patients.
+val patients = listOf(
+  Patient(1, "Emily Carter", LocalDate.of(1996, 4, 12), LocalDate.of(2026, 12, 5)),
+  Patient(2, "Sarah Mitchell", LocalDate.of(1990, 11, 2), LocalDate.of(2027, 1, 20)),
+  Patient(3, "Grace Thompson", LocalDate.of(2001, 7, 30), LocalDate.of(2026, 10, 15)),
+)
+
+private fun seed(id: Int, d: String, w: Int, kg: Double, s: Int, di: Int, hb: Double) =
+  Visit(id, LocalDate.parse(d), w, kg, s, di, hb)
+
+private val seedVisits = listOf(
+  seed(1, "2026-08-10", 21, 68.5, 118, 76, 11.8),
+  seed(2, "2026-08-12", 16, 61.2, 110, 70, 12.4),
+  seed(3, "2026-08-05", 30, 72.0, 128, 84, 10.2),
+)
+
+/** Visits persisted as a JSON array in SharedPreferences; seeded on first run. */
+class VisitStore(context: Context) {
+  private val prefs = context.getSharedPreferences("anc", Context.MODE_PRIVATE)
+
+  fun load(): List<Visit> {
+    val raw = prefs.getString("visits", null) ?: return seedVisits.also { save(it) }
+    val a = JSONArray(raw)
+    return (0 until a.length()).map { i ->
+      val o = a.getJSONObject(i)
+      Visit(
+        o.getInt("p"), LocalDate.parse(o.getString("d")), o.getInt("w"), o.getDouble("kg"),
+        o.getInt("s"), o.getInt("di"), if (o.has("hb")) o.getDouble("hb") else null,
+        o.getJSONArray("ds").let { d -> (0 until d.length()).map(d::getString) }, o.getString("n"),
+      )
+    }
+  }
+
+  fun save(visits: List<Visit>) {
+    val a = JSONArray()
+    visits.forEach {
+      a.put(JSONObject().put("p", it.patientId).put("d", it.date.toString()).put("w", it.weeks)
+        .put("kg", it.weightKg).put("s", it.systolic).put("di", it.diastolic)
+        .apply { it.hb?.let { h -> put("hb", h) } }
+        .put("ds", JSONArray(it.dangerSigns)).put("n", it.notes))
+    }
+    prefs.edit().putString("visits", a.toString()).commit()
+  }
+}
