+package com.example.ancapp.data
+
+import androidx.room.withTransaction
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+
+class AncRepository(
+  private val database: AncDatabase,
+  private val dao: AncDao = database.ancDao(),
+) {
+
+  private val seedLock = Mutex()
+
+  fun observeRegister(): Flow<List<Patient>> = dao.observeRegister()
+
+  fun observePatient(patientId: Long): Flow<Patient?> = dao.observePatient(patientId)
+
+  fun observeVisits(patientId: Long): Flow<List<AncVisit>> = dao.observeVisits(patientId)
+
+  suspend fun recordVisit(visit: AncVisit): Long = dao.insertVisit(visit)
+
+  /** Writes the clinic's existing records on first run. A no-op afterwards. */
+  suspend fun ensureSeeded() = seedLock.withLock {
+    database.withTransaction {
+      if (dao.patientCount() > 0) return@withTransaction
+      SeedData.patientsWithVisits().forEach { (patient, visitFor) ->
+        val patientId = dao.insertPatient(patient)
+        dao.insertVisit(visitFor(patientId))
+      }
+    }
+  }
+}
