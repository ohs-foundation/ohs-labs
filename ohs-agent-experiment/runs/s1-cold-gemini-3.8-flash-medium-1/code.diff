+package com.example.ancapp.model
+
+import org.json.JSONArray
+import org.json.JSONObject
+import java.time.LocalDate
+import java.time.format.DateTimeFormatter
+
+object DangerSigns {
+    const val NONE = "None"
+    const val VAGINAL_BLEEDING = "Vaginal bleeding"
+    const val SEVERE_HEADACHE = "Severe headache"
+    const val BLURRED_VISION = "Blurred vision"
+    const val FEVER = "Fever"
+
+    val ALL = listOf(
+        NONE,
+        VAGINAL_BLEEDING,
+        SEVERE_HEADACHE,
+        BLURRED_VISION,
+        FEVER
+    )
+}
+
+data class AncVisit(
+    val id: String,
+    val patientId: String,
+    val date: String, // Format: YYYY-MM-DD
+    val gestationalAgeWeeks: Int,
+    val weightKg: Double,
+    val systolicBp: Int,
+    val diastolicBp: Int,
+    val hemoglobin: Double? = null, // g/dL, optional
+    val dangerSigns: List<String> = listOf(DangerSigns.NONE),
+    val notes: String = ""
+) {
+    val bloodPressureDisplay: String
+        get() = "$systolicBp/$diastolicBp mmHg"
+
+    val weightDisplay: String
+        get() = "$weightKg kg"
+
+    val hemoglobinDisplay: String?
+        get() = hemoglobin?.let { "$it g/dL" }
+
+    fun getFormattedDate(): String {
+        return try {
+            val d = LocalDate.parse(date)
+            d.format(DateTimeFormatter.ofPattern("MMM d, yyyy"))
+        } catch (_: Exception) {
+            date
+        }
+    }
+
+    val hasCriticalDangerSigns: Boolean
+        get() = dangerSigns.any { it != DangerSigns.NONE }
+
+    fun toJson(): JSONObject {
+        return JSONObject().apply {
+            put("id", id)
+            put("patientId", patientId)
+            put("date", date)
+            put("gestationalAgeWeeks", gestationalAgeWeeks)
+            put("weightKg", weightKg)
+            put("systolicBp", systolicBp)
+            put("diastolicBp", diastolicBp)
+            if (hemoglobin != null) {
+                put("hemoglobin", hemoglobin)
+            } else {
+                put("hemoglobin", JSONObject.NULL)
+            }
+            val signsArray = JSONArray()
+            dangerSigns.forEach { signsArray.put(it) }
+            put("dangerSigns", signsArray)
+            put("notes", notes)
+        }
+    }
+
+    companion object {
+        fun fromJson(json: JSONObject): AncVisit {
+            val signsList = mutableListOf<String>()
+            val signsArray = json.optJSONArray("dangerSigns")
+            if (signsArray != null) {
+                for (i in 0 until signsArray.length()) {
+                    signsList.add(signsArray.getString(i))
+                }
+            }
+            if (signsList.isEmpty()) {
+                signsList.add(DangerSigns.NONE)
+            }
+
+            val hb = if (json.has("hemoglobin") && !json.isNull("hemoglobin")) {
+                json.getDouble("hemoglobin")
+            } else {
+                null
+            }
+
+            return AncVisit(
+                id = json.getString("id"),
+                patientId = json.getString("patientId"),
+                date = json.getString("date"),
+                gestationalAgeWeeks = json.getInt("gestationalAgeWeeks"),
+                weightKg = json.getDouble("weightKg"),
+                systolicBp = json.getInt("systolicBp"),
+                diastolicBp = json.getInt("diastolicBp"),
+                hemoglobin = hb,
+                dangerSigns = signsList,
+                notes = json.optString("notes", "")
+            )
+        }
+    }
+}
