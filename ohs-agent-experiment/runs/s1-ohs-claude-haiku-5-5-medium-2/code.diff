+@Composable
+fun AncApp() {
+  var patient by remember { mutableStateOf<PregnantPatient?>(null) }
+  var recording by remember { mutableStateOf(false) }
+  val selected = patient
+  when {
+    selected == null -> RegisterScreen(onOpen = { patient = it })
+    recording -> RecordVisitScreen(selected, onDone = { recording = false })
+    else -> PatientScreen(selected, onBack = { patient = null }, onRecord = { recording = true })
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun RegisterScreen(onOpen: (PregnantPatient) -> Unit) {
+  val state by produceState<Result<List<PregnantPatient>>?>(null) {
+    value = runCatching { fetchPregnantPatients() }
+  }
+  Scaffold(topBar = { TopAppBar(title = { Text("Pregnant patients") }) }) { pad ->
+    val result = state
+    when {
+      result == null -> CenteredBox(pad) { CircularProgressIndicator() }
+      result.isFailure -> CenteredBox(pad) {
+        Text("Could not load patients: ${result.exceptionOrNull()?.message}")
+      }
+      result.getOrThrow().isEmpty() -> CenteredBox(pad) { Text("No pregnant patients on file.") }
+      else -> LazyColumn(
+        modifier = Modifier.padding(pad),
+        contentPadding = PaddingValues(16.dp),
+        verticalArrangement = Arrangement.spacedBy(8.dp),
+      ) {
+        items(result.getOrThrow()) { p ->
+          Card(modifier = Modifier.fillMaxWidth().clickable { onOpen(p) }) {
+            Column(Modifier.padding(16.dp)) {
+              Text(p.name, style = MaterialTheme.typography.titleMedium)
+              Text(
+                "Age ${p.age ?: "?"} · Due ${p.dueDate} · ${p.weeks} weeks",
+                style = MaterialTheme.typography.bodyMedium,
+              )
+            }
+          }
+        }
+      }
+    }
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun PatientScreen(patient: PregnantPatient, onBack: () -> Unit, onRecord: () -> Unit) {
+  val state by produceState<Result<List<Visit>>?>(null, patient.id) {
+    value = runCatching { fetchVisits(patient.id) }
+  }
+  BackHandler(onBack = onBack)
+  Scaffold(
+    topBar = {
+      TopAppBar(
+        title = { Text(patient.name) },
+        navigationIcon = {
+          IconButton(onClick = onBack) { Icon(Icons.AutoMirrored.Filled.ArrowBack, "Back") }
+        },
+      )
+    },
+    floatingActionButton = {
+      ExtendedFloatingActionButton(
+        onClick = onRecord,
+        icon = { Icon(Icons.Default.Add, null) },
+        text = { Text("Record visit") },
+      )
+    },
+  ) { pad ->
+    val result = state
+    when {
+      result == null -> CenteredBox(pad) { CircularProgressIndicator() }
+      result.isFailure -> CenteredBox(pad) {
+        Text("Could not load visits: ${result.exceptionOrNull()?.message}")
+      }
+      else -> LazyColumn(
+        modifier = Modifier.padding(pad),
+        contentPadding = PaddingValues(16.dp),
+        verticalArrangement = Arrangement.spacedBy(8.dp),
+      ) {
+        item {
+          Text(
+            "Age ${patient.age ?: "?"} · Due ${patient.dueDate} · ${patient.weeks} weeks",
+            style = MaterialTheme.typography.bodyLarge,
+          )
+          Spacer(Modifier.height(8.dp))
+          Text("Past ANC visits", style = MaterialTheme.typography.titleSmall)
+        }
+        val visits = result.getOrThrow()
+        if (visits.isEmpty()) item { Text("No visits recorded yet.") }
+        items(visits) { v ->
+          Card(modifier = Modifier.fillMaxWidth()) {
+            Column(Modifier.padding(16.dp)) {
+              Text(v.date.toString(), style = MaterialTheme.typography.titleMedium)
+              Text(
+                listOfNotNull(
+                  v.weight?.let { "Weight ${"%.1f".format(it)} kg" },
+                  if (v.systolic != null && v.diastolic != null) "BP ${v.systolic}/${v.diastolic} mmHg" else null,
+                  v.hb?.let { "Hb ${"%.1f".format(it)} g/dL" },
+                  v.weeks?.let { "$it weeks" },
+                ).joinToString(" · ").ifEmpty { "No measurements" },
+                style = MaterialTheme.typography.bodyMedium,
+              )
+              if (v.dangerSigns.isNotEmpty()) {
+                Text("Danger signs: ${v.dangerSigns.joinToString()}", style = MaterialTheme.typography.bodyMedium)
+              }
+              v.notes?.let { Text(it, style = MaterialTheme.typography.bodySmall) }
+            }
+          }
+        }
+      }
+    }
+  }
+}
