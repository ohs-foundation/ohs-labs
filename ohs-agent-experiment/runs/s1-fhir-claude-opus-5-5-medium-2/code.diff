+        actions = { action() },
+      )
+    },
+    floatingActionButton = fab,
+  ) { padding -> content(Modifier.padding(padding).fillMaxSize()) }
+}
+
+/** Runs [load] off the main thread; shows a spinner, then [content] or an error with Retry. */
+@Composable
+private fun <T> Loading(key: Any?, modifier: Modifier, load: () -> T, content: @Composable (T) -> Unit) {
+  var attempt by remember { mutableIntStateOf(0) }
+  var result by remember(key, attempt) { mutableStateOf<Result<T>?>(null) }
+  LaunchedEffect(key, attempt) { result = withContext(Dispatchers.IO) { runCatching(load) } }
+  val r = result
+  when {
+    r == null -> Box(modifier, Alignment.Center) { CircularProgressIndicator() }
+    r.isSuccess -> content(r.getOrThrow())
+    else -> Column(modifier.padding(24.dp), Arrangement.Center, Alignment.CenterHorizontally) {
+      Text("Could not reach the FHIR server.\n${r.exceptionOrNull()?.message}")
+      Button({ attempt++ }, Modifier.padding(top = 16.dp)) { Text("Retry") }
+    }
+  }
+}
