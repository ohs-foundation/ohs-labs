+package com.example.ancapp
+
+import android.app.Application
+import dev.ohs.fhir.datacapture.DataCapture
+import dev.ohs.fhir.engine.FhirEngineConfiguration
+import dev.ohs.fhir.engine.FhirEngineProvider
+import dev.ohs.fhir.engine.ServerConfiguration
+
+class AncApplication : Application() {
+  override fun onCreate() {
+    super.onCreate()
+
+    // Initialize DataCapture before any form is shown
+    DataCapture.initialize(this)
+
+    // Initialize FHIR Engine
+    FhirEngineProvider.init(
+      FhirEngineConfiguration(
+        serverConfiguration = ServerConfiguration(
+          baseUrl = "http://10.0.2.2:8080/fhir/",
+        ),
+      ),
+      this,
+    )
+    // Call getInstance immediately after init as required by FhirEngineProvider
+    FhirEngineProvider.getInstance(this)
+  }
+}
