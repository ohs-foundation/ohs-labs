+// Renders the server's anc-contact Questionnaire items; answers are keyed by linkId.
+@Composable
+private fun VisitForm(patient: Patient, items: List<QuestionItem>, onSaved: () -> Unit) {
+  val texts = remember { mutableStateMapOf("visit-date" to LocalDate.now().toString()) }
+  val picks = remember { mutableStateMapOf<String, Set<Coding>>() }
+  var error by remember { mutableStateOf<String?>(null) }
+  var saving by remember { mutableStateOf(false) }
+  val scope = rememberCoroutineScope()
+
+  Column(
+    Modifier.fillMaxSize().verticalScroll(rememberScrollState()).padding(16.dp),
+    verticalArrangement = Arrangement.spacedBy(12.dp),
+  ) {
+    Text(patient.name, style = MaterialTheme.typography.titleMedium)
+    items.forEach { item ->
+      if (item.type == "choice") {
+        ChoiceField(item, picks)
+      } else {
+        val label = if (item.type == "date") "${item.text} (YYYY-MM-DD)" else item.text
+        OutlinedTextField(
+          value = texts[item.linkId].orEmpty(),
+          onValueChange = { texts[item.linkId] = it },
+          label = { Text(if (item.required) "$label *" else label) },
+          keyboardOptions = KeyboardOptions(
+            keyboardType = when (item.type) {
+              "integer" -> KeyboardType.Number
+              "decimal" -> KeyboardType.Decimal
+              else -> KeyboardType.Text
+            },
+          ),
+          singleLine = item.type != "text",
+          minLines = if (item.type == "text") 3 else 1,
+          modifier = Modifier.fillMaxWidth(),
+        )
+      }
+    }
+    error?.let { Text(it, color = MaterialTheme.colorScheme.error) }
+    Button(
+      enabled = !saving,
+      onClick = {
+        saving = true
+        error = null
+        scope.launch {
+          runCatching {
+            val visit = parseVisit(items, texts, picks)
+            withContext(Dispatchers.IO) { saveVisit(patient.id, visit) }
+          }.onSuccess {
+            onSaved()
+          }.onFailure {
+            error = it.message ?: "Save failed"
+            saving = false
+          }
+        }
+      },
+      modifier = Modifier.fillMaxWidth(),
+    ) { Text("Save visit") }
+  }
+}
+
+@Composable
+private fun ChoiceField(item: QuestionItem, picks: SnapshotStateMap<String, Set<Coding>>) {
+  val selected = picks[item.linkId].orEmpty()
+  Column {
+    Text(item.text, style = MaterialTheme.typography.titleSmall)
+    item.options.forEach { option ->
+      val checked = option in selected
+      Row(
+        Modifier.fillMaxWidth().clickable {
+          picks[item.linkId] = if (checked) selected - option else selected + option
+        },
+        verticalAlignment = Alignment.CenterVertically,
+      ) {
+        Checkbox(checked = checked, onCheckedChange = null)
+        Text(option.display)
+      }
+    }
+  }
+}
+
+private fun parseVisit(
+  items: List<QuestionItem>,
+  texts: Map<String, String>,
+  picks: Map<String, Set<Coding>>,
+): VisitInput {
+  fun <T> field(id: String, parse: (String) -> T?): T {
+    val label = items.first { it.linkId == id }.text
+    return texts[id]?.trim()?.takeIf { it.isNotEmpty() }?.let(parse)
+      ?: error("$label is missing or invalid")
   }
+  return VisitInput(
+    date = field("visit-date") { runCatching { LocalDate.parse(it) }.getOrNull() },
+    gestationalWeeks = field("gestational-age") { it.toIntOrNull() },
+    weightKg = field("weight") { it.toDoubleOrNull() },
+    systolic = field("bp-systolic") { it.toIntOrNull() },
+    diastolic = field("bp-diastolic") { it.toIntOrNull() },
+    dangerSigns = picks["danger-signs"].orEmpty().toList(),
+    notes = texts["notes"]?.trim().orEmpty(),
+  )
 }
