+private val SIGNS = listOf("Vaginal bleeding", "Severe headache", "Blurred vision", "Fever")
 
 class MainActivity : ComponentActivity() {
   override fun onCreate(savedInstanceState: Bundle?) {
     super.onCreate(savedInstanceState)
-    setContent { MaterialTheme { Surface { Text("Hello") } } }
+    val store = VisitStore(this)
+    setContent { MaterialTheme { Surface { App(store) } } }
+  }
+}
+
+@Composable
+fun App(store: VisitStore) {
+  var visits by remember { mutableStateOf(store.load()) }
+  var selected by rememberSaveable { mutableStateOf<Int?>(null) }
+  var adding by rememberSaveable { mutableStateOf(false) }
+  val patient = patients.find { it.id == selected }
+
+  BackHandler(enabled = patient != null) { if (adding) adding = false else selected = null }
+
+  when {
+    patient == null -> Register { selected = it }
+    adding -> VisitForm(patient, onCancel = { adding = false }) { v ->
+      visits = visits + v
+      store.save(visits)
+      adding = false
+    }
+    else -> Detail(patient, visits.filter { it.patientId == patient.id }.sortedByDescending { it.date },
+      onBack = { selected = null }, onAdd = { adding = true })
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun Register(onOpen: (Int) -> Unit) {
+  val today = LocalDate.now()
+  Scaffold(topBar = { TopAppBar(title = { Text("ANC Register") }) }) { pad ->
+    LazyColumn(Modifier.padding(pad)) {
+      items(patients.sortedBy { it.dueDate }) { p ->
+        ListItem(
+          modifier = Modifier.clickable { onOpen(p.id) },
+          headlineContent = { Text(p.name) },
+          supportingContent = { Text("Age ${p.age(today)} · Due ${p.dueDate} · ${p.weeks(today)} weeks") },
+        )
+        HorizontalDivider()
+      }
+    }
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun Detail(p: Patient, visits: List<Visit>, onBack: () -> Unit, onAdd: () -> Unit) {
+  Scaffold(
+    topBar = {
+      TopAppBar(title = { Text(p.name) },
+        navigationIcon = { IconButton(onBack) { Icon(Icons.AutoMirrored.Filled.ArrowBack, "Back") } })
+    },
+    floatingActionButton = { ExtendedFloatingActionButton(onClick = onAdd, icon = { Icon(Icons.Default.Add, null) }, text = { Text("New visit") }) },
+  ) { pad ->
+    LazyColumn(Modifier.padding(pad), contentPadding = PaddingValues(16.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+      if (visits.isEmpty()) item { Text("No visits recorded") }
+      items(visits) { v ->
+        Card(Modifier.fillMaxWidth()) {
+          Column(Modifier.padding(12.dp)) {
+            Text("${v.date} · ${v.weeks} weeks", style = MaterialTheme.typography.titleMedium)
+            Text("Weight: ${v.weightKg} kg")
+            Text("BP: ${v.systolic}/${v.diastolic} mmHg")
+            v.hb?.let { Text("Hb: $it g/dL") }
+            if (v.dangerSigns.isNotEmpty()) Text("Danger signs: ${v.dangerSigns.joinToString()}", color = MaterialTheme.colorScheme.error)
+            if (v.notes.isNotBlank()) Text("Notes: ${v.notes}")
+          }
+        }
+      }
+    }
+  }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun VisitForm(p: Patient, onCancel: () -> Unit, onSave: (Visit) -> Unit) {
+  val today = LocalDate.now()
+  var date by rememberSaveable { mutableStateOf(today.toString()) }
+  var weeks by rememberSaveable { mutableStateOf(p.weeks(today).toString()) }
+  var kg by rememberSaveable { mutableStateOf("") }
+  var sys by rememberSaveable { mutableStateOf("") }
+  var dia by rememberSaveable { mutableStateOf("") }
+  var notes by rememberSaveable { mutableStateOf("") }
+  var signsCsv by rememberSaveable { mutableStateOf("") }
+  val signs = signsCsv.split(",").filter { it.isNotEmpty() }.toSet()
+  var tried by rememberSaveable { mutableStateOf(false) }
+
+  val d = runCatching { LocalDate.parse(date) }.getOrNull()
+  val w = weeks.toIntOrNull()?.takeIf { it in 1..45 }
+  val kgV = kg.toDoubleOrNull()?.takeIf { it in 20.0..300.0 }
+  val s = sys.toIntOrNull()?.takeIf { it in 50..300 }
+  val di = dia.toIntOrNull()?.takeIf { it in 30..200 }
+  val valid = d != null && w != null && kgV != null && s != null && di != null
+
+  @Composable
+  fun field(label: String, v: String, bad: Boolean, num: Boolean = true, mod: Modifier = Modifier.fillMaxWidth(), set: (String) -> Unit) =
+    OutlinedTextField(v, set, mod, label = { Text(label) }, isError = tried && bad, singleLine = num,
+      keyboardOptions = KeyboardOptions(keyboardType = if (num) KeyboardType.Decimal else KeyboardType.Text))
+
+  Scaffold(topBar = { TopAppBar(title = { Text("New visit – ${p.name}") },
+    navigationIcon = { IconButton(onCancel) { Icon(Icons.AutoMirrored.Filled.ArrowBack, "Back") } }) }) { pad ->
+    Column(Modifier.padding(pad).padding(16.dp).verticalScroll(rememberScrollState()), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+      field("Visit date (yyyy-MM-dd)", date, d == null) { date = it }
+      field("Gestational age (weeks)", weeks, w == null) { weeks = it }
+      field("Weight (kg)", kg, kgV == null) { kg = it }
+      Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+        field("Systolic (mmHg)", sys, s == null, mod = Modifier.weight(1f)) { sys = it }
+        field("Diastolic (mmHg)", dia, di == null, mod = Modifier.weight(1f)) { dia = it }
+      }
+      Text("Danger signs", style = MaterialTheme.typography.titleSmall)
+      Row(verticalAlignment = androidx.compose.ui.Alignment.CenterVertically) {
+        Checkbox(signs.isEmpty(), { signsCsv = "" }); Text("None")
+      }
+      SIGNS.forEach { sg ->
+        Row(verticalAlignment = androidx.compose.ui.Alignment.CenterVertically) {
+          Checkbox(sg in signs, { signsCsv = (if (it) signs + sg else signs - sg).joinToString(",") }); Text(sg)
+        }
+      }
+      field("Notes", notes, false, num = false) { notes = it }
+      Button({
+        tried = true
+        if (valid) onSave(Visit(p.id, d!!, w!!, kgV!!, s!!, di!!, null, SIGNS.filter { it in signs }, notes.trim()))
+      }, Modifier.fillMaxWidth()) { Text("Save visit") }
+    }
   }
 }
