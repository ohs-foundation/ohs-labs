+package com.example.ancapp.ui
+
+import android.widget.Toast
+import androidx.compose.foundation.background
+import androidx.compose.foundation.layout.*
+import androidx.compose.material.icons.Icons
+import androidx.compose.material.icons.automirrored.filled.ArrowBack
+import androidx.compose.material3.*
+import androidx.compose.runtime.*
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.text.font.FontWeight
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.unit.sp
+import com.example.ancapp.data.FhirRepository
+import com.example.ancapp.model.PatientItem
+import dev.ohs.fhir.datacapture.Questionnaire
+import dev.ohs.fhir.datacapture.QuestionnaireConfig
+import dev.ohs.fhir.model.r4.QuestionnaireResponse
+import kotlinx.coroutines.launch
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun RecordVisitScreen(
+  patient: PatientItem,
+  questionnaireJson: String,
+  repository: FhirRepository,
+  onVisitSaved: () -> Unit,
+  onCancelClick: () -> Unit
+) {
+  val context = LocalContext.current
+  val coroutineScope = rememberCoroutineScope()
+  var isSaving by remember { mutableStateOf(false) }
+  var errorMessage by remember { mutableStateOf<String?>(null) }
+
+  Scaffold(
+    topBar = {
+      TopAppBar(
+        title = {
+          Column {
+            Text(
+              text = "Record ANC Visit",
+              fontWeight = FontWeight.Bold,
+              fontSize = 18.sp
+            )
+            Text(
+              text = patient.name,
+              style = MaterialTheme.typography.bodySmall,
+              color = MaterialTheme.colorScheme.onPrimaryContainer
+            )
+          }
+        },
+        navigationIcon = {
+          IconButton(onClick = onCancelClick, enabled = !isSaving) {
+            Icon(
+              imageVector = Icons.AutoMirrored.Filled.ArrowBack,
+              contentDescription = "Cancel and go back"
+            )
+          }
+        },
+        colors = TopAppBarDefaults.topAppBarColors(
+          containerColor = MaterialTheme.colorScheme.primaryContainer,
+          titleContentColor = MaterialTheme.colorScheme.onPrimaryContainer
+        )
+      )
+    }
+  ) { paddingValues ->
+    Box(
+      modifier = Modifier
+        .fillMaxSize()
+        .padding(paddingValues)
+    ) {
+      if (questionnaireJson.isBlank()) {
+        Box(
+          modifier = Modifier.fillMaxSize(),
+          contentAlignment = Alignment.Center
+        ) {
+          CircularProgressIndicator()
+        }
+      } else {
+        Questionnaire(
+          questionnaireJson = questionnaireJson,
+          config = QuestionnaireConfig(
+            showSubmitButton = true,
+            showCancelButton = true,
+            submitButtonText = "Save Visit"
+          ),
+          onSubmit = { getQuestionnaireResponse ->
+            coroutineScope.launch {
+              try {
+                isSaving = true
+                errorMessage = null
+                val response = getQuestionnaireResponse()
+                val result = repository.saveNewVisit(patient.id, response)
+                if (result.isSuccess) {
+                  Toast.makeText(context, "ANC Visit recorded successfully!", Toast.LENGTH_SHORT).show()
+                  onVisitSaved()
+                } else {
+                  val err = result.exceptionOrNull()?.message ?: "Failed to save visit"
+                  errorMessage = err
+                  Toast.makeText(context, "Error: $err", Toast.LENGTH_LONG).show()
+                }
+              } catch (e: Exception) {
+                errorMessage = e.message ?: "Failed to process questionnaire"
+                Toast.makeText(context, "Error: ${e.message}", Toast.LENGTH_LONG).show()
+              } finally {
+                isSaving = false
+              }
+            }
+          },
+          onCancel = onCancelClick
+        )
+      }
+
+      if (isSaving) {
+        Box(
+          modifier = Modifier
+            .fillMaxSize()
+            .background(MaterialTheme.colorScheme.scrim.copy(alpha = 0.32f)),
+          contentAlignment = Alignment.Center
+        ) {
+          Card(
+            shape = MaterialTheme.shapes.medium,
+            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)
+          ) {
+            Row(
+              modifier = Modifier.padding(24.dp),
+              verticalAlignment = Alignment.CenterVertically,
+              horizontalArrangement = Arrangement.spacedBy(16.dp)
+            ) {
+              CircularProgressIndicator(modifier = Modifier.size(32.dp))
+              Text("Saving visit to FHIR server...")
+            }
+          }
+        }
+      }
+    }
+  }
+}
