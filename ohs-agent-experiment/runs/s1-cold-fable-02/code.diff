+package com.example.ancapp.ui
+
+import java.time.LocalDate
+import java.time.Period
+import java.time.format.DateTimeFormatter
+import java.time.temporal.ChronoUnit
+
+private val dateFormatter: DateTimeFormatter = DateTimeFormatter.ofPattern("dd MMM yyyy")
+
+fun LocalDate.display(): String = format(dateFormatter)
+
+fun ageInYears(dateOfBirth: LocalDate, on: LocalDate = LocalDate.now()): Int =
+  Period.between(dateOfBirth, on).years
+
+/** Completed weeks of pregnancy, assuming a 280-day term ending at [dueDate]. */
+fun gestationalWeeks(dueDate: LocalDate, on: LocalDate = LocalDate.now()): Int {
+  val gestationDays = 280 - ChronoUnit.DAYS.between(on, dueDate)
+  return (gestationDays / 7).toInt().coerceAtLeast(0)
+}
