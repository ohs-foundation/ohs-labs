+          }
+
+          // Bottom padding so FAB does not cover content
+          item {
+            Spacer(modifier = Modifier.height(72.dp))
+          }
+        }
+      }
+    }
+  }
+}
+
+@OptIn(ExperimentalLayoutApi::class)
+@Composable
+fun VisitCard(
+  visit: VisitItem,
+  dateFormatter: DateTimeFormatter,
+) {
+  val formattedDate = try {
+    LocalDate.parse(visit.date.substringBefore("T")).format(dateFormatter)
+  } catch (_: Exception) {
+    visit.date.ifBlank { "Unknown date" }
+  }
+
+  Card(
+    modifier = Modifier.fillMaxWidth(),
+    elevation = CardDefaults.cardElevation(defaultElevation = 2.dp),
+    colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),
+  ) {
+    Column(modifier = Modifier.padding(16.dp)) {
+      Row(
+        modifier = Modifier.fillMaxWidth(),
+        horizontalArrangement = Arrangement.SpaceBetween,
+        verticalAlignment = Alignment.CenterVertically,
+      ) {
+        Row(verticalAlignment = Alignment.CenterVertically) {
+          Icon(
+            imageVector = Icons.Default.CalendarMonth,
+            contentDescription = null,
+            tint = MaterialTheme.colorScheme.primary,
+            modifier = Modifier.size(20.dp),
+          )
+          Spacer(modifier = Modifier.width(8.dp))
+          Text(
+            text = formattedDate,
+            style = MaterialTheme.typography.titleMedium,
+            fontWeight = FontWeight.Bold,
+          )
+        }
+
+        if (visit.gestationalAgeWeeks != null) {
+          Surface(
+            color = MaterialTheme.colorScheme.tertiaryContainer,
+            shape = MaterialTheme.shapes.small,
+          ) {
+            Text(
+              text = "${visit.gestationalAgeWeeks} wks GA",
+              style = MaterialTheme.typography.labelMedium,
+              color = MaterialTheme.colorScheme.onTertiaryContainer,
+              modifier = Modifier.padding(horizontal = 8.dp, vertical = 2.dp),
+            )
+          }
+        }
+      }
+
+      HorizontalDivider(
+        modifier = Modifier.padding(vertical = 10.dp),
+        color = DividerDefaults.color.copy(alpha = 0.5f),
+      )
+
+      // Vital Signs
+      Row(
+        modifier = Modifier.fillMaxWidth(),
+        horizontalArrangement = Arrangement.SpaceBetween,
+      ) {
+        // Weight
+        Column(modifier = Modifier.weight(1f)) {
+          Text(
+            text = "Weight",
+            style = MaterialTheme.typography.labelSmall,
+            color = MaterialTheme.colorScheme.outline,
+          )
+          Text(
+            text = visit.weight ?: "—",
+            style = MaterialTheme.typography.bodyLarge,
+            fontWeight = FontWeight.Medium,
+          )
+        }
+
+        // Blood Pressure
+        Column(modifier = Modifier.weight(1.2f)) {
+          Text(
+            text = "Blood Pressure",
+            style = MaterialTheme.typography.labelSmall,
+            color = MaterialTheme.colorScheme.outline,
+          )
+          Text(
+            text = visit.bloodPressure ?: "—",
+            style = MaterialTheme.typography.bodyLarge,
+            fontWeight = FontWeight.Medium,
+          )
+        }
+
+        // Hemoglobin
+        Column(modifier = Modifier.weight(1.1f)) {
+          Text(
+            text = "Hemoglobin",
+            style = MaterialTheme.typography.labelSmall,
+            color = MaterialTheme.colorScheme.outline,
+          )
+          Text(
+            text = visit.hemoglobin ?: "—",
+            style = MaterialTheme.typography.bodyLarge,
+            fontWeight = FontWeight.Medium,
+          )
+        }
+      }
+
+      // Danger signs (if recorded)
+      if (visit.dangerSigns.isNotEmpty()) {
+        Spacer(modifier = Modifier.height(10.dp))
+        Row(verticalAlignment = Alignment.CenterVertically) {
+          val hasDanger = visit.dangerSigns.any { !it.equals("None", ignoreCase = true) }
+          Icon(
+            imageVector = Icons.Default.Warning,
+            contentDescription = null,
+            tint = if (hasDanger) MaterialTheme.colorScheme.error else MaterialTheme.colorScheme.primary,
+            modifier = Modifier.size(16.dp),
+          )
+          Spacer(modifier = Modifier.width(6.dp))
+          Text(
+            text = "Danger signs: ${visit.dangerSigns.joinToString(", ")}",
+            style = MaterialTheme.typography.bodyMedium,
+            color = if (hasDanger) MaterialTheme.colorScheme.error else MaterialTheme.colorScheme.onSurfaceVariant,
+            fontWeight = if (hasDanger) FontWeight.SemiBold else FontWeight.Normal,
+          )
+        }
+      }
+
+      // Notes (if recorded)
+      if (!visit.notes.isNullOrBlank()) {
+        Spacer(modifier = Modifier.height(8.dp))
+        Text(
+          text = "Notes: ${visit.notes}",
+          style = MaterialTheme.typography.bodyMedium,
+          color = MaterialTheme.colorScheme.onSurfaceVariant,
+        )
+      }
+    }
+  }
+}
