+package com.example.ancapp
+
+data class PatientSummary(
+    val id: String,
+    val identifier: String?,
+    val name: String,
+    val birthDate: String,
+    val age: Int,
+    val estimatedDueDate: String,
+    val currentGestationalWeeks: Int,
+    val phone: String?,
+    val lastVisitDate: String?,
+    val lastWeightKg: Double?,
+    val lastBpSystolic: Int?,
+    val lastBpDiastolic: Int?,
+    val lastHbGdL: Double?
+)
+
+data class AncVisit(
+    val id: String,
+    val date: String,
+    val gestationalAgeWeeks: Int?,
+    val weightKg: Double?,
+    val bpSystolic: Int?,
+    val bpDiastolic: Int?,
+    val hemoglobinGdL: Double?,
+    val dangerSigns: List<String>,
+    val notes: String?
+)
+
+data class QuestionnaireOption(
+    val system: String,
+    val code: String,
+    val display: String
+)
+
+data class QuestionnaireItemSpec(
+    val linkId: String,
+    val text: String,
+    val type: String,
+    val required: Boolean = false,
+    val repeats: Boolean = false,
+    val options: List<QuestionnaireOption> = emptyList(),
+    val children: List<QuestionnaireItemSpec> = emptyList()
+)
+
+data class AncQuestionnaire(
+    val id: String,
+    val url: String,
+    val title: String,
+    val items: List<QuestionnaireItemSpec>
+)
+
+data class NewVisitInput(
+    val visitDate: String,
+    val gestationalAgeWeeks: Int?,
+    val weightKg: Double?,
+    val bpSystolic: Int?,
+    val bpDiastolic: Int?,
+    val selectedDangerSigns: List<QuestionnaireOption>,
+    val notes: String?
+)
