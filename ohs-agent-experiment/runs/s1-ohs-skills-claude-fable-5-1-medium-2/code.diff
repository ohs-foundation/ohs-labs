+                        back()
+                      } catch (_: CancellationException) { /* form shows validation errors */ }
+                    }
+                  },
+                  onCancel = back,
+                )
+              }
+            }
+          }
+        }
+      }
+    }
+  }
+}
+
+/** New ViewModelStoreOwner per form session so the Questionnaire view-model starts blank each time. */
+@Composable
+private fun FreshViewModelStore(content: @Composable () -> Unit) {
+  val owner = remember { object : ViewModelStoreOwner { override val viewModelStore = ViewModelStore() } }
+  DisposableEffect(owner) { onDispose { owner.viewModelStore.clear() } }
+  CompositionLocalProvider(LocalViewModelStoreOwner provides owner) { content() }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+private fun Page(title: String, content: @Composable () -> Unit) {
+  Scaffold(topBar = { TopAppBar(title = { Text(title) }) }) { pad ->
+    Column(Modifier.padding(pad).fillMaxSize()) { content() }
+  }
+}
+
+@Composable
+private fun Loading() = CircularProgressIndicator(Modifier.padding(32.dp))
+
+@Composable
+private fun Row2(title: String, sub: String, onClick: (() -> Unit)? = null) {
+  Column(Modifier.fillMaxWidth().then(if (onClick != null) Modifier.clickable(onClick = onClick) else Modifier).padding(16.dp)) {
+    Text(title, style = MaterialTheme.typography.titleMedium)
+    Text(sub, style = MaterialTheme.typography.bodyMedium)
   }
+  HorizontalDivider()
 }
