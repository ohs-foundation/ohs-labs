+    topBar = {
+      TopAppBar(
+        title = { Text(title) },
+        navigationIcon = { if (onBack != null) TextButton(onClick = onBack) { Text("‹ Back") } },
+      )
+    },
+    floatingActionButton = fab,
+    content = content,
+  )
+}
+
+@Composable
+fun LoadState(error: String?, retry: () -> Unit, padding: PaddingValues) {
+  Box(Modifier.fillMaxSize().padding(padding), contentAlignment = Alignment.Center) {
+    if (error == null) CircularProgressIndicator()
+    else Column(horizontalAlignment = Alignment.CenterHorizontally, modifier = Modifier.padding(24.dp)) {
+      Text("Could not reach the FHIR server", style = MaterialTheme.typography.titleMedium)
+      Text(error, style = MaterialTheme.typography.bodySmall)
+      Button(onClick = retry, modifier = Modifier.padding(top = 12.dp)) { Text("Retry") }
+    }
+  }
+}
