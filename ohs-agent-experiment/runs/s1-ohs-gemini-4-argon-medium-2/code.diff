+package com.example.ancapp
+
+data class PatientSummary(
+  val id: String,
+  val name: String,
+  val birthDate: String,
+  val ageYears: Int,
+  val estimatedDueDate: String,
+  val currentWeeksOfPregnancy: Int,
+  val identifier: String? = null,
+  val phone: String? = null,
+)
+
+data class AncVisit(
+  val id: String,
+  val date: String,
+  val weight: String? = null,
+  val bloodPressure: String? = null,
+  val hemoglobin: String? = null,
+  val gestationalAgeWeeks: Int? = null,
+  val dangerSigns: List<String> = emptyList(),
+  val notes: String? = null,
+)
+
+data class PatientDetail(
+  val patient: PatientSummary,
+  val visits: List<AncVisit>,
+)
